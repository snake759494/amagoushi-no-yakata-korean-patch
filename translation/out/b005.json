{
"2898": [
"「안 쓰는 것 같은데요.",
"어떻습니까, 츠바키 씨?」"
],
"2899": [
"「저기, 뒤쪽에 있는 우물...」"
],
"2900": [
"「우물?",
"그거 뚜껑 덮여 있잖아?」"
],
"2901": [
"「그럼 안 쓰는 거군요」"
],
"2902": [
"「아~ 예전에 어떤 애가",
"들여다보다 빠질 뻔해서",
"위험하다고 막아 버렸어」"
],
"2903": [
"「뭐, 원래부터 거의",
"장식 같은 거였으니까」"
],
"2904": [
"「그럼",
"뚜껑도 안 열린단 말입니까」"
],
"2905": [
"「일단 못으로 박아",
"뒀을 텐데 말이지」"
],
"2906": [
"「응, 그런데 틈이 벌어져서",
"안쪽이 보였는데, 뭔가",
"떨어져 있는 것 같았어」"
],
"2907": [
"「뭔가라니 뭡니까?」"
],
"2908": [
"「나뭇잎이라도 쌓였겠지?」"
],
"2909": [
"「어두워서 잘 안 보였지만",
"그런 느낌은 아니었는데",
"말이야...」"
],
"2910": [
"「그럼 보러 가 봅시다」"
],
"2911": [
"선선히 그렇게 말하고",
"히오리는 내 팔을 잡아끌었다."
],
"2912": [
"「나, 나도 가는 거야...?」"
],
"2913": [
"「잠깐 들여다보기만",
"하면 되잖습니까」"
],
"2914": [
"「그건 그렇지만...」"
],
"2915": [
"「아, 츠바키 씨.",
"손전등 좀 빌리겠습니다」"
],
"2916": [
"「뒷문 옆에 걸려 있어」"
],
"2917": [
"「아아아... 괜한 말을",
"하는 게 아니었는데...」"
],
"2918": [
"「아, 돌아왔다.",
"어디 갔었어?」"
],
"2919": [
"「갑자기 없어져서",
"깜짝 놀랐잖아」"
],
"2920": [
"「아아, 미안합니다.",
"잠깐 우물에 좀...」"
],
"2921": [
"「그래서, 뭐 있었냐?」"
],
"2922": [
"「사람이, 죽어 있었습니다」"
],
"2923": [
"히오리의 말에 모두가 술렁였다.",
"쯧, 하고 혀 차는 소리가 들렸다.",
"쿠라이시 씨였다."
],
"2924": [
"「트... 틀림없나요...?",
"혹시 뭘 잘못 보신 건...」"
],
"2925": [
"「틀림없는 사람 시체예요.",
"...우물에 내려간 건 제가",
"아니라 나고 씨지만요」"
],
"2926": [
"「정말이냐, 꼬마?」"
],
"2927": [
"「사, 사람이었어요...",
"남자였고... 그, 그런데...」"
],
"2928": [
"「그런데 뭐?」"
],
"2929": [
"「어디 누군지를 모르겠어요.",
"일단 휴대폰으로 사진도",
"찍어 오게 했습니다만...」"
],
"2930": [
"「그러니까 뜸 들이지 마!」"
],
"2931": [
"히오리는 송구한 표정을 지으며",
"여자들 쪽을 흘끗 살폈다."
],
"2932": [
"「...얼굴이, 뭉개져 있어요」"
],
"2933": [
"「뭐...?」"
],
"2934": [
"「알아볼 수가 없단 말이죠」"
],
"2935": [
"「볼 수 있나, 그 사진」"
],
"2936": [
"「네!?",
"아, 네, 저... 그래도",
"봐도 누군지는 모를 텐데...」"
],
"2937": [
"「됐으니까 꺼내」"
],
"2938": [
"「네, 넵!!」"
],
"2939": [
"허둥지둥 휴대폰을 꺼내",
"쿠라이시 씨에게 내밀었다."
],
"2940": [
"「...그냥 넘겨줘 봤자",
"사진을 어떻게 띄우는지",
"알 리가 없잖냐」"
],
"2941": [
"「제, 제가 띄워요!?」"
],
"2942": [
"「...그렇게 끔찍해?」"
],
"2943": [
"「솔직히 안 보는 게",
"나을지도 모를 정도예요」"
],
"2944": [
"「음, 그럼 여자분들은",
"안 보는 게 좋겠네」"
],
"2945": [
"「...사양할게」"
],
"2946": [
"「보여 줘」"
],
"2947": [
"「언니!?」"
],
"2948": [
"「일단」"
],
"2949": [
"「...쓰러지진 마세요.",
"나고 씨, 이리 주세요.",
"제가 띄울 테니」"
],
"2950": [
"「응, 여기」"
],
"2951": [
"한순간의 망설임도 없이 넘겼다.",
"왠지 츠바키 군이 어이없다는",
"표정을 지은 것 같다..."
],
"2952": [
"「...보시죠」"
],
"2953": [
"재빨리 사진을 띄우고, 히오리는",
"먼저 쿠라이시 씨에게 건넸다."
],
"2954": [
"화면을 본 순간,",
"안 그래도 험악하던 얼굴이",
"더욱 일그러졌다."
],
"2955": [
"「...어?",
"이거 사람 얼굴이야...?」"
],
"2956": [
"옆에서 들여다본 나스 씨는",
"오히려 눈을 동그랗게 떴다."
],
"2957": [
"「뭐, 뭐야 그게...",
"어떻게 돼 있는데...?」"
],
"2958": [
"「어떻냐니, 뭐랄까",
"석류 같은...」"
],
"2959": [
"「비유하지 마아앗!?",
"게다가 먹을 걸로 하지 마!",
"못 먹게 되잖아!!」"
],
"2960": [
"「그치만 어떻냐니까...」"
],
"2961": [
"「네 눈으로 봐」"
],
"2962": [
"「우왓!」"
],
"2963": [
"휙 하고 휴대폰을 던져 받고",
"츠바키 군은 곁눈질하듯",
"살그머니 화면을 봤다."
],
"2964": [
"「이... 이건...",
"응, 누군지...」"
],
"2965": [
"「모르겠죠」"
],
"2966": [
"「과, 관두는 게 좋을걸?",
"이건 좀, 진짜로...」"
],
"2967": [
"「...난 모른다.",
"분명 말렸다?」"
],
"2968": [
"꿈쩍 않는 시즈나에게 마지못해",
"츠바키 군이 휴대폰을 건넸다."
],
"2969": [
"「...안 되겠다」"
],
"2970": [
"몇 초간 말없이 화면을 보던",
"시즈나는 눈을 감고 탁 하고",
"휴대폰을 닫아 버렸다."
],
"2971": [
"「어, 언니 괜찮아!?」"
],
"2972": [
"「...힘들어」"
],
"2973": [
"「그러니까 말했잖아...」"
],
"2974": [
"「누군지 모르겠어」"
],
"2975": [
"「아마 아는 사람이라도",
"못 알아볼 거예요」"
],
"2976": [
"「그렇겠지...」"
],
"2977": [
"「저기...",
"저는 안 봐도 될까요」"
],
"2978": [
"「관둬, 제발.",
"보자마자 쓰러질 거야」"
],
"2979": [
"「...오빠, 이거...",
"우물에 내려가서 직접 봤어?」"
],
"2980": [
"「생각나게 하지 마...」"
],
"2981": [
"「아~... 이건 진짜",
"동정한다, 나고무」"
],
"2982": [
"「...그래서, 결국 이거 누구?」"
],
"2983": [
"「그러니까 봐도 모른다고",
"방금 결론 났잖아!?」"
],
"2984": [
"「응, 그러니까 정체는 몰라도",
"언제 어디서 온 누굴까 해서」"
],
"2985": [
"「봐, 우리 여기에",
"다 모여 있고, 마다라이 씨는",
"식당에 있고...」"
],
"2986": [
"「...그야, 너...」"
],
"2987": [
"「...그치만 어젯밤에 누가",
"한 사람 더 있었잖아...」"
],
"2988": [
"「아, 아아, 그렇네!",
"온실이랑 주차장... 어라?」"
],
"2989": [
"「그건 틀림없는 사실이지만,",
"그럼... 이 사람을 우물에",
"던져 넣은 범인은 누굽니까?」"
],
"2990": [
"「...어, 저기,",
"그럼 아직 또 다른...」"
],
"2991": [
"「그렇구나!",
"어젯밤 소동을 일으킨 게",
"한 명뿐이란 법은 없지!」"
],
"2992": [
"「정체 모를 짓 하는 놈을",
"막 늘리지 좀 마!?」"
],
"2993": [
"「...뭐, 그쪽이 낫다고도",
"할 수 있지만」"
],
"2994": [
"「왜!?",
"그런 놈이 여럿이면...」"
],
"2995": [
"「없으면 말이다,",
"남는 건 우리밖에 없어」"
],
"2996": [
"가장 싫은 가능성을 지적당해",
"츠바키 군은 새파래졌다."
],
"2997": [
"어젯밤엔 분명 누군가 더 있었다.",
"하지만 그 사람은 못 찾았고..."
],
"2998": [
"（...대신 한 사람 몫의",
"시체가 더 나와 버렸다...）"
],
"2999": [
"（그건... 대체...）"
],
"3000": [
"「...그 사람은」"
],
"3001": [
"「그 사람?」"
],
"3002": [
"「오빠가 봤다는,",
"정원에서 죽어 있던 사람」"
],
"3003": [
"「앗...",
"그, 그렇지, 나고무가 처음에",
"누가 죽은 걸 봤잖아!」"
],
"3004": [
"「그게 이 우물 속 놈",
"아니야!?」"
],
"3005": [
"「그게... 그럼 대체",
"언제 우물로...?」"
],
"3006": [
"「...문제는 거기겠죠」"
],
"3007": [
"「나고 씨가 넘어지고",
"저희가 뒤를 보러 갈 때까지",
"몇 분도 안 됐을 테니까요」"
],
"3008": [
"「그때는...",
"다들 거실에 계셨던 걸로",
"아는데요...」"
],
"3009": [
"「그래, 대본 읽을 때잖아.",
"다 거실에 있었으니까 역시",
"우물로 옮긴 놈이 따로...」"
],
"3010": [
"「아니, 난 목욕 중이었는데」"
],
"3011": [
"「...그러고 보니 목욕하고",
"막 나오셨었죠, 나스 씨」"
],
"3012": [
"「바깥 폭풍이 굉장하니까",
"잠깐 보고 올까 하고",
"복도에서 말을 꺼내서...」"
],
"3013": [
"「응, 그래서 뒷문 열어 보니",
"나고무 군이 쓰러져 있었지」"
],
"3014": [
"「...왜 그래?」"
],
"3015": [
"「역시 바보야, 이 사람...」"
],
"3016": [
"「저기... 그래도 반대로...",
"자기가 했으면 굳이",
"말 안 할 것 같은데요...」"
],
"3017": [
"「그렇, 죠...?",
"보통이라면... 네...」"
],
"3018": [
"「응? 뭐가?」"
],
"3019": [
"「당신 뇌는 근육 말고 딴 걸",
"움직이면 자폭이라도 해!?」"
],
"3020": [
"「자기만 알리바이가 없단 걸",
"잘도 태연하게 말하네!!」"
],
"3021": [
"「...알리바이?」"
],
"3022": [
"「얘가 시체 보고 나서",
"우리가 달려갈 때까지",
"시체 옮길 수 있던 건 당신뿐!」"
],
"3023": [
"「응?",
"무리야, 목욕 중이었는걸」"
],
"3024": [
"「그-러-니-까!!」"
],
"3025": [
"「아~ 됐다, 내버려 둬.",
"이해 못 한다, 이 녀석」"
],
"3026": [
"「못 해 먹겠군, 정말...」"
],
"3027": [
"어깨를 으쓱하더니 쿠라이시 씨는",
"성큼성큼 문 쪽으로 걸어갔다."
],
"3028": [
"「...어디 가시는데요?」"
],
"3029": [
"「방에 돌아간다.",
"이런 우중충한 데 못 있겠다」"
],
"3030": [
"「저기, 그래도...",
"혼자 계시는 건 위험하지",
"않을까요...?」"
],
"3031": [
"「얼굴 맞대고 있는 내내",
"모두를 그런 눈으로 보며",
"지내는 건 사양이다」"
],
"3032": [
"「밥도 안 먹겠다는 거야?」"
],
"3033": [
"「쿠, 쿠라이시 씨...」"
],
"3034": [
"더는 들을 생각 없다는 듯",
"쿠라이시 씨는 거실을 나갔다."
],
"3035": [
"지금까지보다 더 무거운 침묵이",
"내려앉았다..."
],
"3036": [
"「불편하다는",
"기분은 알겠지만...」"
],
"3037": [
"「그래,",
"정체 모를 놈이 하나 있으니",
"그놈이 제일 수상하잖아...」"
],
"3038": [
"「누굴까」"
],
"3039": [
"「주차장 놈이랑 범인이",
"같은 놈 아니냐」"
],
"3040": [
"「그중 누군가는 시쿠라 씨",
"일지도 모르잖아?」"
],
"3041": [
"그렇지...",
"정체 모를 존재가 실제로",
"몇 명인지조차 모르는 거야."
],
"3042": [
"「젠장...!",
"왜 이런 일이...」"
],
"3043": [
"「...그, 그래도...",
"무서울 거야, 누가 했는지",
"모르는 거니까...」"
],
"3044": [
"나는 히오리가 아니라는 걸",
"알고 있지만..."
],
"3045": [
"그렇게 말해도 분명 둘 다",
"거짓말 안 한다는 증거가 없다고",
"할 테고..."
],
"3046": [
"「어떻게든 데리러 올 때까지",
"스스로 지킬 수밖에",
"없다는 걸까요...」"
],
"3047": [
"「...으음...」"
],
"3048": [
"「좋아, 어떻게든 내려갈 길이",
"없는지 찾아보고 올게!」"
],
"3049": [
"「하아?",
"또 무모한 짓을... 야 잠깐!」"
],
"3050": [
"「지나갈 수 있을 것 같으면",
"부르러 돌아올 테니까!」"
],
"3051": [
"「올 테니까는 무슨!!",
"당신 같은 걸어다니는",
"야생 왕국이 아니라고, 우린!!」"
],
"3052": [
"「무리하지 마세요!",
"나스 씨~!」"
],
"3053": [
"「...가 버렸다」"
],
"3054": [
"「가끔은 남의 말 좀 들어라",
"저 아저씨는...」"
],
"3055": [
"「쫓아갔다간 우리 몸이",
"위험하잖아...」"
],
"3056": [
"「지나갈 길이 있으면 횡재",
"정도로 생각할 수밖에 없지」"
],
"3057": [
"「그렇네...」"
],
"3058": [
"「어쩔 수 없지, 정말.",
"라디오라도 들어 둬야겠다」"
],
"3059": [
"「어디로 갈까...」"
],
"3060": [
"...이제 곧 밤이구나.",
"여전히 날씨가 나빠서 낮부터",
"어두우니 잘 모르겠지만."
],
"3061": [
"（일기예보는 어떨까...",
"오락실에 가 보자）"
],
"3062": [
"「...아, 벌써 시간이 이렇네」"
],
"3063": [
"「응? 아, 미안.",
"슬슬 저녁 시간인가」"
],
"3064": [
"「그러게.",
"그럼 난 준비하고 갈게」"
],
"3065": [
"「응, 그럼 이따 봐」"
],
"3066": [
"...오락실에 가 볼까.",
"라디오가 있으니 누가",
"내려와 있을지도."
],
"3067": [
"「...이제 됐어?",
"슬슬 시간 됐잖아」"
],
"3068": [
"「아, 정말이네.",
"미안, 그럼 이만」"
],
"3069": [
"「응~」"
],
"3070": [
"（...이 시간이면 오락실에",
"가면 누가 오려나...）"
],
"3071": [
"「응? 왜?」"
],
"3072": [
"「뉴스 시간」"
],
"3073": [
"「아, 라디오?",
"그러고 보니 벌써 그렇네」"
],
"3074": [
"「그럼 나 오락실 가서",
"라디오 듣고 올게」"
],
"3075": [
"「나도 금방 갈게」"
],
"3076": [
"「응, 그럼 이따 봐」"
],
"3077": [
"시즈나의 방을 나와",
"오락실로 향했다..."
],
"3078": [
"「...시간」"
],
"3079": [
"「응? 시간?",
"아... 미안, 벌써 이렇게 됐네」"
],
"3080": [
"「음, 고마워.",
"그럼 또 봐」"
],
"3081": [
"「...응」"
],
"3082": [
"（...이 시간이면 라디오에서",
"일기예보 하려나...）"
],
"3083": [
"오락실로 가자."
],
"3084": [
"「...어머, 죄송해요.",
"벌써 시간이 이렇게 됐네요」"
],
"3085": [
"「네? 아, 정말이네.",
"슬슬 다들 1층에 있으려나」"
],
"3086": [
"「저 잠깐 오락실 보고 올게요.",
"라디오도 들어 봐야 하고」"
],
"3087": [
"「네, 저도 곧 갈게요」"
],
"3088": [
"「그럼 이따 봬요」"
],
"3089": [
"（누가 와 있으려나...）"
],
"3090": [
"「...저기,",
"이제 괜찮으신가요?」"
],
"3091": [
"「아, 네.",
"죄송해요, 실례했습니다」"
],
"3092": [
"「아뇨...」"
],
"3093": [
"어떡하지.",
"시계를 보니 꽤 늦었으니까",
"오락실이라도 들여다볼까."
],
"3094": [
"（누가 와 있으려나...）"
],
"3095": [
"「아차, 이런.",
"슬슬 뉴스 하지 않냐」"
],
"3096": [
"「네? 아, 라디오요?」"
],
"3097": [
"「그래, 들어 둬라.",
"무슨 진전이 있을지 모르니」"
],
"3098": [
"「...별 변화 없으면",
"나한텐 보고 안 해도 된다」"
],
"3099": [
"「네, 알겠습니다.",
"그럼 실례하겠습니다」"
],
"3100": [
"쿠라이시 씨의 방을 나와",
"오락실로 향했다..."
],
"3101": [
"「...오, 슬슬",
"뉴스 시간 아니냐?」"
],
"3102": [
"「아, 그럴지도」"
],
"3103": [
"츠바키 군은 라디오로 달려가",
"전원을 켰다."
],
"3104": [
"「우왓...!」"
],
"3105": [
"「한층 더 심하네,",
"잡음이...」"
],
"3106": [
"「이거 시끄럽네.",
"들리게 될 때까지",
"이걸로...」"
],
"3107": [
"츠바키 군은 데크 옆에 있던",
"헤드폰을 쓰고 소리를 껐다."
],
"3108": [
"「한동안 너희 목소리 안 들리니까",
"대답 안 해도 신경 쓰지 마」"
],
"3109": [
"「아, 응」"
],
"3110": [
"「...이제 됐지」"
],
"3111": [
"퉁명스럽게 그렇게 말하고",
"츠바키 군은 슬렁슬렁",
"라디오 쪽으로 걸어갔다."
],
"3112": [
"（그러고 보니 벌써",
"그런 시간이었나...）"
],
"3113": [
"평소보다 심한 잡음에",
"츠바키 군은 옆의 헤드폰을",
"쓰면서 혀를 찼다."
],
"3114": [
"「...뭔가 다른 정보 있으면",
"알려 줄 테니 걱정 마」"
],
"3115": [
"고개를 끄덕였지만, 아마",
"츠바키 군에겐 안 들렸겠지..."
],
"3116": [
"「...슬슬 실례하겠습니다」"
],
"3117": [
"눈앞에서 문이 닫혔다.",
"역시 수상하게 여기는",
"모양이네..."
],
"3118": [
"（...어쩔 수 없나.",
"시간도 이러니 슬슬",
"오락실에 가 보자...）"
],
"3119": [
"「아, 슬슬",
"라디오 하려나」"
],
"3120": [
"「그렇네요.",
"전 이 책 정리하면 바로",
"갈 테니 먼저 가 계세요」"
],
"3121": [
"「응, 알았어」"
],
"3122": [
"서재를 나와 오락실로 향했다."
],
"3123": [
"（...그러고 보니...）"
],
"3124": [
"시체는 마다라이 씨만이",
"아니었지..."
],
"3125": [
"（어젯밤 정원에서 본 사람은",
"어디로 사라진 걸까）"
],
"3126": [
"「...안 들리네요.",
"좀 피곤해서 실례할게요」"
],
"3127": [
"라디오와의 씨름에 지쳤는지",
"츠바키 군은 퉁명스럽게 말하고",
"방을 나갔다."
],
"3128": [
"（...슬슬",
"다른 사람들이 올지도）"
],
"3129": [
"나는 이대로 여기",
"있어야지..."
],
"3130": [
"돌아본다"
],
"3131": [
"신경 쓰지 않는다"
],
"3132": [
"왠지 복도가 소란스럽네.",
"쿵쾅거리는 발소리도 나고..."
],
"3133": [
"「이야~ 혼났다 혼났어!」"
],
"3134": [
"「아, 나고 씨」"
],
"3135": [
"「히오리...",
"나스 씨, 돌아오셨군요」"
],
"3136": [
"소란스럽다 했더니 나스 씨가",
"돌아온 소리였구나."
],
"3137": [
"「응, 비가 또 심해져서",
"허겁지겁 뛰어왔어」"
],
"3138": [
"「아아, 벼랑은 정말 무너졌어.",
"그건 좀 걸어서 넘을 수",
"없겠더라」"
],
"3139": [
"「정말 보고 오셨군요...」"
],
"3140": [
"「참, 무모하다니까」"
],
"3141": [
"「그리고 차도 봤어.",
"길가에서 한참 들어간 풀숲",
"안쪽에 처박힌 거랑...」"
],
"3142": [
"「네에!?",
"왜 그렇게 된 거예요!?」"
],
"3143": [
"「어라?",
"네가 그런 거 아니었어?」"
],
"3144": [
"「전 그렇게 이상하게... 아니,",
"그거 파란 경차였어요?」"
],
"3145": [
"「아니, 파란 경차는 더 앞에",
"멀쩡히 서 있었어.",
"풀숲 건 회색 보통 차」"
],
"3146": [
"「그리고 백미러에",
"악마 같은 이상한 인형",
"장식이 매달려 있었어」"
],
"3147": [
"「그건 제 차가 아니에요.",
"제 건 경차 쪽이에요」"
],
"3148": [
"「뭐야, 그랬어?」"
],
"3149": [
"「그런 섬뜩한 걸 달고",
"나고 씨는 운전 못 하겠죠」"
],
"3150": [
"「무서워서 운전은커녕!",
"뭐예요, 그 악마는...」"
],
"3151": [
"「뿔 나고 세모 꼬리에",
"박쥐 날개 달린 새까만 거」"
],
"3152": [
"「...임프인가」"
],
"3153": [
"「그게 뭔데?」"
],
"3154": [
"「나쁜 마법사가 불러내는",
"사역마 취급으로 판타지에",
"자주 나와요」"
],
"3155": [
"「흐음, 그렇구나.",
"특이한 걸 달고 다니는 차네」"
],
"3156": [
"「그런데 왜 그런 데에",
"차만 두고 간 걸까?」"
],
"3157": [
"「...그 근처에 사람은",
"없었던 거죠?」"
],
"3158": [
"「아무도 없었어.",
"벼랑이 무너지기 전에 걸어서",
"산을 내려갔나」"
],
"3159": [
"「왜 차를 버려두고",
"걸어서 돌아가요...」"
],
"3160": [
"「...이상하네」"
],
"3161": [
"「무너진 곳, 어디쯤입니까?」"
],
"3162": [
"「통행금지 간판보다",
"한참 저쪽이었어」"
],
"3163": [
"「통행금지 간판이라니, 나스 씨",
"왜 그걸 무시하고 더 앞까지",
"가 버리는 거예요!?」"
],
"3164": [
"「일단 누구 없어요~ 하고",
"불러 봤는데",
"대답이 없어서 말이야」"
],
"3165": [
"「사람 있으면 산 아래에 연락",
"부탁할까 해서 찾다 보니",
"벼랑까지 가 버렸어」"
],
"3166": [
"「...잠깐만요.",
"그럼 그 통행금지 간판은",
"대체 누가 둔 겁니까」"
],
"3167": [
"「글쎄?",
"둔 사람은 벌써 산을",
"내려가 버렸을지도」"
],
"3168": [
"「어? 어라, 그래도...",
"산을 내려가려면 무너진 곳",
"너머로 가야 하잖아요...」"
],
"3169": [
"「그렇죠.",
"애초에 무너진 곳보다",
"이쪽에 없으면...」"
],
"3170": [
"「...간판을 세우는 것도",
"못 했을 거 아닙니까」"
],
"3171": [
"「그치만 이쪽에 있는 건",
"우리뿐 아니었어?」"
],
"3172": [
"「그렇죠」"
],
"3173": [
"「그리고...",
"주차장에서 펑크 낸 사람...」"
],
"3174": [
"「아, 맞다.",
"한 명 더 있었지」"
],
"3175": [
"「...그럼 그 사람이 간판이나",
"펑크로 우리를 무너진 곳에",
"못 가게 하려는 거야?」"
],
"3176": [
"「왜 그런 에두른 방법으로",
"주의를 줍니까...」"
],
"3177": [
"「게다가 펑크 소동은",
"붕괴 뉴스보다 먼저였어요」"
],
"3178": [
"「그렇지...",
"그렇다는 건 통행금지",
"간판이라는 것도...」"
],
"3179": [
"「벼랑 붕괴와 관계없이",
"저희를 붙잡아 두고 싶던",
"누군가의 짓일까요...」"
],
"3180": [
"「어...?",
"그럼 그 간판은 가짜?」"
],
"3181": [
"「그렇다고 봅니다.",
"이쪽에 갇힌 사람만",
"세울 수 있으니까요」"
],
"3182": [
"역시...",
"어떻게든 모두를 이 저택에",
"가둬 두고 싶은 사람이 있어."
],
"3183": [
"「그래서 실제로 무너진 건",
"어디쯤이었습니까?」"
],
"3184": [
"「음~...",
"뭐였지, 낙석 주의 표지판이",
"서 있는 곳 조금 너머」"
],
"3185": [
"「...저기, 그런 표지판은",
"일정 간격으로 여럿 있어서",
"잘 모르겠는데요」"
],
"3186": [
"「그랬나?",
"뭐, 낙석 정도가 아니지.",
"길이 완전히 무너져 없었으니」"
],
"3187": [
"「그럴 수가...",
"복구엔 얼마나 걸려요...」"
],
"3188": [
"「비가 그치지 않는 한",
"위험해서 못 다가가겠죠」"
],
"3189": [
"「아아, 관두는 게 좋아.",
"한 발 올렸을 뿐인데",
"발밑에서 돌이 우수수 떨어졌어」"
],
"3190": [
"「무서운 짓 좀 하지 마세요!」"
],
"3191": [
"「아, 뭔가 시끌벅적하다",
"했더니 역시 나스 씨였네」"
],
"3192": [
"문이 열리고, 쌍둥이와 미사사기",
"씨가 조심스레 얼굴을 내밀었다."
],
"3193": [
"나스 씨가 돌아온 소리를 듣고",
"2층에서 내려온 모양이다."
],
"3194": [
"「밖에 나가셨어요?",
"비에 꽤 젖으신 것",
"같은데요...」"
],
"3195": [
"「응, 벼랑 보고 왔는데",
"시쿠라 씨는 못 찾았어」"
],
"3196": [
"「네에!?",
"또 위험한 짓 하시고...」"
],
"3197": [
"「...무너졌어?」"
],
"3198": [
"「아쉽게도 무너졌어.",
"딴 내려갈 길 없으려나?」"
],
"3199": [
"「봐주세요.",
"안 무너졌어도 굴러떨어지는 게",
"고작일 텐데요」"
],
"3200": [
"「...왜 이런 데",
"모여 있냐, 너희...」"
],
"3201": [
"「어라, 쿠라이시 씨.",
"마음이 바뀌셨습니까?」"
],
"3202": [
"「안 바뀌었다.",
"보조 열쇠 생각이 났을 뿐이야」"
],
"3203": [
"「아, 여기의...」"
],
"3204": [
"미사사기 씨의 시선이 유리장 속에",
"표본처럼 늘어선 열쇠로 향했다."
],
"3205": [
"「모든 방 열쇠가 있다는 게",
"생각나서 말이지」"
],
"3206": [
"「문 잠그고 틀어박혀 봤자",
"여기 보조 열쇠가 있으면",
"의미 없잖아」"
],
"3207": [
"「뭐, 그건 그렇네요」"
],
"3208": [
"「...꼭",
"혼자 계셔야겠어요?」"
],
"3209": [
"걱정스러운 얼굴로",
"미사사기 씨가 장을 열었다."
],
"3210": [
"「그렇다고 했잖아.",
"자, 열었으면 꺼내 줘」"
],
"3211": [
"망설이면서도 미사사기 씨는",
"쿠라이시 씨가 내민 손에",
"보조 열쇠를 올려놓았다."
],
"3212": [
"「고맙군.",
"그럼 간다」"
],
"3213": [
"「저기... 방 열쇠는",
"각자 갖고 있는 게 나아요?」"
],
"3214": [
"「만약을 위해 그게",
"나을지도 모르겠네요」"
],
"3215": [
"「난 자기 전에 가져온",
"운동 기구를 문 앞에",
"밀어 둘 거라 괜찮은데」"
],
"3216": [
"「그, 그건 저희로선",
"도저히 무리인데요...」"
],
"3217": [
"「...우리도 그렇게 할래?」"
],
"3218": [
"결국 나스 씨 말고 모두가",
"자기 방 보조 열쇠를",
"직접 갖고 있기로 했다."
],
"3219": [
"「...저기, 죄송해요.",
"저 왠지 속이 안 좋아서",
"이만...」"
],
"3220": [
"열쇠를 꼭 쥐고",
"미사사기 씨는 서둘러",
"오락실을 나갔다."
],
"3221": [
"「...또 무서워졌나 봐」"
],
"3222": [
"「뭐, 무리도 아니죠.",
"그리 기분 좋은 상황은",
"아니니까요」"
],
"3223": [
"「나도 목욕하고 방에 갈게.",
"그럼」"
],
"3224": [
"나스 씨도 떠나고",
"왠지 무거운 침묵이 흘렀다."
],
"3225": [
"「저기... 그래도 뭐라도",
"먹는 게 좋을 것 같아서",
"내려왔는데...」"
],
"3226": [
"「다들 어떻게 하실래요?」"
],
"3227": [
"「그러고 보니 아침도 걸렀네요.",
"나고 씨, 배고프세요?」"
],
"3228": [
"「응, 역시 좀」"
],
"3229": [
"「그럼 뭐 좀 만들까」"
],
"3230": [
"「그럼 저도 돕겠습니다」"
],
"3231": [
"「...나도 도울게」"
],
"3232": [
"「나고 씨, 어쩌실래요?」"
],
"3233": [
"「아, 그럼 나도 갈래」"
],
"3234": [
"결국 우르르 부엌으로 옮겼다."
],
"3235": [
"「그랬나?",
"뭐, 낙석 정도가 아니지.",
"길이 완전히 무너졌는걸」"
],
"3236": [
"「응, 잠깐 무너졌다는",
"벼랑을 보러 갔었어」"
],
"3237": [
"「아쉽게도 무너졌어.",
"좀 내려가긴 어렵겠더라」"
],
"3238": [
"「...나고 씨도",
"밖에 나갔어요?」"
],
"3239": [
"「왠지 머리가 젖었는데요」"
],
"3240": [
"「아, 응.",
"그게...」"
],
"3241": [
"「안 쓰는 것 같은데요.",
"뚜껑 덮여 있었잖아요」"
],
"3242": [
"「뭔가라니 뭡니까?",
"나뭇잎이라도 쌓인 거",
"아닙니까」"
],
"3243": [
"「응? 어디 가?」"
],
"3244": [
"「네, 금방 올게요.",
"손전등 뒤에 있었죠?」"
],
"3245": [
"「뒷문 옆에 걸려 있었던",
"것 같은데요...」"
],
"3246": [
"「아, 돌아왔다」"
],
"3247": [
"「어디 갔었어요?」"
],
"3248": [
"「...뭐 떨어져 있었어?」"
],
"3249": [
"히오리의 말에 모두가 술렁였다.",
"쯧, 하고 혀 차는 소리가 들렸다."
],
"3250": [
"「쿠라이시 씨...」"
],
"3251": [
"「어라, 언제 오셨어요...?」"
],
"3252": [
"「틀림없는 거냐, 그거」"
],
"3253": [
"나스 씨의 의문은 무시하고",
"쿠라이시 씨는 씁쓸하게 물었다."
],
"3254": [
"「그런데 뭐?」"
],
"3255": [
"「...그렇게 끔찍해?」"
],
"3256": [
"한순간의 망설임도 없이 넘겼다.",
"왠지 스즈나가 어이없다는",
"표정을 지은 것 같다..."
],
"3257": [
"「뭐, 뭐야 그게...",
"어떻게 돼 있는데...?」"
],
"3258": [
"「비유 안 해도 돼, 하지 마!」"
],
"3259": [
"「어? 아니, 그래도 이거...」"
],
"3260": [
"「...정말 괜찮아?」"
],
"3261": [
"꿈쩍 않는 시즈나에게",
"머뭇거리며 나스 씨가 건넸다."
],
"3262": [
"「그러니까 말했잖아」"
],
"3263": [
"「관둬, 제발.",
"보자마자 쓰러질라」"
],
"3264": [
"「그러니까 지금 봐도 모른다고",
"말하던 참이잖아」"
],
"3265": [
"「정체 모를 사람을",
"막 늘리지 좀 마」"
],
"3266": [
"「왜!?",
"그런 사람이 여럿이면...」"
],
"3267": [
"가장 싫은 가능성을 지적당해",
"스즈나는 새파래졌다."
],
"3268": [
"「오빠가 봤다는,",
"정원에서 죽어 있던 사람」"
],
"3269": [
"「아, 맞다!",
"오빠가 누가 정원에 쓰러진 걸",
"봤다고 했잖아!」"
],
"3270": [
"「그게 이 우물 속 사람",
"아니야?」"
],
"3271": [
"「응, 대본 읽을 때잖아.",
"다 거실에 있었으니까 역시",
"우물로 옮긴 사람이 따로...」"
],
"3272": [
"「저기... 그래도 반대로...",
"자기가 했으면 굳이",
"말 안 할 것 같은데요...」"
],
"3273": [
"「뭐가, 가 아니지.",
"자기만 알리바이가 없다고",
"잘도 태연히 말하는군」"
],
"3274": [
"「나고 씨가 시체 보고 나서",
"저희가 달려갈 때까지",
"옮길 수 있던 건 나스 씨뿐」"
],
"3275": [
"「아니, 저기, 그러니까」"
],
"3276": [
"「못 해 먹겠군, 정말.",
"어이, 거기 열쇠 좀 줘」"
],
"3277": [
"「보조 열쇠 말이다.",
"난 애초에 그걸 가지러",
"내려온 거야」"
],
"3278": [
"「아, 이거...」"
],
"3279": [
"「난 자기 전에 가져온",
"운동 기구를 문 앞에",
"밀어 둘 거라 괜찮은데」"
],
"3280": [
"오락실에 나스 씨가 기세 좋게",
"뛰어 들어왔다."
],
"3281": [
"「정말 무너졌더라~!",
"그건 걸어서 넘는 것도",
"무리겠던데」"
],
"3282": [
"「정말 보고 오셨습니까.",
"무모한 분이네...」"
],
"3283": [
"「...그, 그거 제 차가",
"아닌데요...」"
],
"3284": [
"「아무도 없었어.",
"벼랑이 무너지기 전에 걸어서",
"산을 내려갔나」"
],
"3285": [
"「그래서 어디쯤 무너졌습니까?」"
],
"3286": [
"「그거 참...",
"복구는 언제쯤 될까요」"
],
"3287": [
"왠지 점점 절망적인 상황이",
"되어 가는 것 같은..."
],
"3288": [
"나스 씨가 돌아온 소리를 듣고",
"2층에서 내려온 모양이다."
],
"3289": [
"「응, 벼랑 보고 왔는데",
"걸어선 못 넘겠더라」"
],
"3290": [
"「아하하, 넘을 수 있는지",
"시험해 보진 않았지만」"
],
"3291": [
"「당연하죠」"
],
"3292": [
"「한 발 올렸을 뿐인데 발밑에서",
"돌이 우수수 떨어지더라고」"
],
"3293": [
"「해 볼 마음 가득이잖아」"
],
"3294": [
"「참아 주신 것만으로",
"다행이라 칩시다...」"
],
"3295": [
"「...쿠라이시 씨」"
],
"3296": [
"불쑥 시즈나가 조용히 중얼거려",
"문득 그쪽을 보니..."
],
"3297": [
"「저기... 그래도 뭐라도",
"먹는 게 좋을 것 같아서",
"내려왔는데요...」"
],
"3298": [
"「기모노 씨, 요리할 줄 알아?」"
],
"3299": [
"「할 줄 알죠.",
"평소에 직접 해 먹거든요」"
],
"3300": [
"「오빠는」"
],
"3301": [
"「어, 아, 나는...",
"별로...」"
],
"3302": [
"「후후, 괜찮아.",
"우리끼리 할 수 있으니까」"
],
"3303": [
"「나고 씨, 어쩌실래요?",
"여기서 기다리실래요?」"
],
"3304": [
"「아, 나도 갈래」"
],
"3305": [
"히오리네는 적당한 재료를 골라",
"샌드위치를 만들어 주었다."
],
"3306": [
"「히오리, 손재주 좋네...」"
],
"3307": [
"「그렇습니까?",
"나고 씨는 직접 밥 해 먹고",
"그러진 않나요?」"
],
"3308": [
"「별로 안 해.",
"하는 게 좋겠다고",
"생각은 하는데...」"
],
"3309": [
"「오빠, 혼자 살아?」"
],
"3310": [
"「응, 일단은」"
],
"3311": [
"「그러면서 요리를 전혀 안 하면",
"식비가 장난 아니겠네요」"
],
"3312": [
"「그래서 월말이 되면 할 수 없이",
"의욕을 내 보긴 하는데」"
],
"3313": [
"웃음을 샀다..."
],
"3314": [
"뒤에서 무슨 소리가 난 것 같은."
],
"3315": [
"「...!?」"
],
"3316": [
"「뭡니까, 방금 그 소리?」"
],
"3317": [
"「현관 쪽에서",
"났지...?」"
],
"3318": [
"「보고 오죠」"
],
"3319": [
"「어, 자, 잠깐만!」"
],
"3320": [
"「오?」"
],
"3321": [
"「앗, 나스 씨!",
"괜찮으세요!?」"
],
"3322": [
"「응?",
"괜찮냐니 뭐가?」"
],
"3323": [
"「뭐냐니, 방금...」"
],
"3324": [
"「...아무것도 안 보이네요」"
],
"3325": [
"「무슨 일 있었어?」"
],
"3326": [
"「저기, 그게 뭔가",
"엄청난 소리가...」"
],
"3327": [
"「아~ 소리?",
"미안 미안, 시끄러웠어?」"
],
"3328": [
"「뭐, 뭘 하신 거예요!?」"
],
"3329": [
"「아하하, 신경 쓰지 마.",
"잠깐 시험해 봤을 뿐이니까」"
],
"3330": [
"「그럼 잘 자~!」"
],
"3331": [
"「어, 저기, 나스 씨!?」"
],
"3332": [
"「...가 버렸다」"
],
"3333": [
"「뭐였을까요?」"
],
"3334": [
"「궁금... 하지만",
"물어보면 엄청",
"피곤할 것 같으니 잊을래」"
],
"3335": [
"「그게 제일 현명하겠네요.",
"언젠가 현장과 마주칠 것",
"같은 기분도 듭니다만」"
],
"3336": [
"「말하지 마~!",
"나 그런 거 진짜로",
"마주쳐 버린단 말이야~!」"
],
"3337": [
"「네네,",
"잊읍시다 잊어요」"
],
"3338": [
"「그럼",
"얼른 밥이나 먹읍시다」"
],
"3339": [
"「......씨」"
],
"3340": [
"「...나고 씨...?」"
],
"3341": [
"「...응......」"
],
"3342": [
"쏴아아, 하는 익숙한 소리.",
"귀에 거슬리는 물소리가",
"조금씩 또렷이 울려 온다."
],
"3343": [
"눈꺼풀 너머가 희미하게 밝다.",
"어깨를 흔드는 감촉."
],
"3344": [
"「......히오리?」"
],
"3345": [
"「아침입니다.",
"일어나실 수 있겠어요?」"
],
"3346": [
"「아... 응...」"
],
"3347": [
"아직 멍한 머리를 흔들며",
"느릿느릿 일어났다."
],
"3348": [
"낯선 방의 벽을 보는 사이",
"겨우 어젯밤 일이 떠올랐다."
],
"3349": [
"「...아!",
"츠바키 군은!?」"
],
"3350": [
"「앙? 일어났냐?」"
],
"3351": [
"창가의 사람 그림자가 돌아봤다.",
"...한순간 누군지 몰랐다."
],
"3352": [
"딱딱한 셔츠 단추를 풀고",
"가볍게 걸쳤을 뿐인 차림에",
"넘겼던 머리도 다 내려와 있다."
],
"3353": [
"안 어울리는 멋 안경은 바닥에",
"흩어진 화투 위에 던져져 있었다."
],
"3354": [
"멍하니 있는 나를 보고 츠바키",
"군은 쑥스러운 듯 어깨를 으쓱했다."
],
"3355": [
"「...뭐냐, 그 낯짝은?",
"아쉽게도 살아남았다」"
],
"3356": [
"「다행이다...」"
],
"3357": [
"「진부하네.",
"애드리브가 없잖아」"
],
"3358": [
"「그치만...",
"달리 아무것도 생각 안 나」"
],
"3359": [
"「...어쩔 수 없지.",
"그걸로 봐주마」"
],
"3360": [
"「...고맙다」"
],
"3361": [
"「응, 다행이야.",
"좋은 아침, 츠바키 군」"
],
"3362": [
"「네네,",
"좋은 아침」"
],
"3363": [
"츠바키 군은 셔츠 단추를 채우며",
"바닥에 둔 안경을 주웠다."
],
"3364": [
"「쓰시게요?」"
],
"3365": [
"「너무 들떠서",
"범인 놈을 자극해도 좀」"
],
"3366": [
"「게다가 목숨 건 더럽게 비싼",
"수업료를 냈으니까...」"
],
"3367": [
"「...본전은 뽑겠습니다.",
"나갈 때까지 저는 집사입니다」"
],
"3368": [
"익살스레 인사하는 츠바키 군에",
"나와 히오리는 마주 보고 웃었다."
],
"3369": [
"「그 기운이면 괜찮겠네요.",
"자, 정리할까요」"
],
"3370": [
"히오리는 흩어져 있던",
"화투를 주워 모았다."
],
"3371": [
"「...실례지만」"
],
"3372": [
"「저 사람, 프로 도박꾼이나",
"뭐 그런 건가요」"
],
"3373": [
"「...졌구나」"
],
"3374": [
"「너무 강해요」"
],
"3375": [
"「분해 보이네...」"
],
"3376": [
"「친구들 사이에선 진 적이",
"없었는데 말입니다, 네」"
],
"3377": [
"「...장난이 아니야,",
"뭐야 그 패 운은?",
"인간이 아니라고, 저 남자」"
],
"3378": [
"「아무것도 안 걸어서 다행이네」"
],
"3379": [
"「...왜 말이 없어」"
],
"3380": [
"「묻지 마」"
],
"3381": [
"얼마나 졌을까...",
"엄청 궁금했지만",
"무서워서 못 물어봤다..."
],
"3382": [
"「하암...",
"역시 잠이 부족하네요」"
],
"3383": [
"「둘 다 좀 쉬는 게 어때?",
"난 아까까지 잤지만...」"
],
"3384": [
"「나고 씨도",
"남 말 할 처지 아니에요」"
],
"3385": [
"「충분히 졸려 보이십니다」"
],
"3386": [
"「그, 그런가」"
],
"3387": [
"「뭐, 쉬는 게 좋은 건",
"확실하겠죠」"
],
"3388": [
"「점심까진 느긋하게 있을까요.",
"밝을 땐 다른 사람도 깨어",
"있으니 괜찮겠죠」"
],
"3389": [
"「그렇네요...」"
],
"3390": [
"「응, 그럼 잘 자」"
],
"3391": [
"「네, 안녕히 주무세요」"
