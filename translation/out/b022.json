{
"11680": [
"「그런 건가요...」"
],
"11681": [
"「고양이가 썼어도,",
"재밌으면 그만이야」"
],
"11682": [
"정말 고양이가 썼다면,",
"그게 제일 재밌을 것 같다."
],
"11683": [
"「다카토 엔지로 책",
"읽어 보셨어요?」"
],
"11684": [
"「꽤 예전에 몇 권 읽었는데,",
"어느 건지까진 기억 안 나」"
],
"11685": [
"「일단 내 배역 이름 나오는 게",
"어느 건지 찾아보긴 했다.",
"...『무슨무슨 꽃』이란 거다」"
],
"11686": [
"「영화로도 나왔는데 말이지,",
"요즘 젊은 놈들은 모르나 보더라」"
],
"11687": [
"「영화로 나온 건 어느 거예요?」"
],
"11688": [
"「분명 『종루관 살인』이랑,",
"...그리고 뭐였더라.",
"다른 것도 있었는데」"
],
"11689": [
"「텔레비전 거랑 연극 거랑",
"뒤섞였을지도",
"모르겠구먼」"
],
"11690": [
"「꽤 영상화됐네요」"
],
"11691": [
"「뭐, 10년도 더 전이지만」"
],
"11692": [
"「저기, 마다라이 씨",
"말인데요...」"
],
"11693": [
"「구제불능 아저씨였지만,",
"뭐 죽일 것까진 없잖냐」"
],
"11694": [
"「그렇죠...」"
],
"11695": [
"「...여기 있는 사람 중에",
"마다라이 씨랑 제일 친했던 건",
"누굴까요?」"
],
"11696": [
"「없지, 그런 놈은」"
],
"11697": [
"「어, 없어요?」"
],
"11698": [
"「얼굴 아는 놈은 많다만.",
"나오지도 않은 연극 뒤풀이에도",
"멋대로 오는 아저씨니까」"
],
"11699": [
"「안 나왔다니 저기,",
"상관없는데 뒤풀이에",
"오는 거예요?」"
],
"11700": [
"「어디서 듣고 공짜 술",
"마시러 오는 거다, 그 녀석은」"
],
"11701": [
"「그러곤 연출가니 각본가니",
"붙잡고 자기를 팔기 시작하지」"
],
"11702": [
"「요전에도 분명 그랬다.",
"작은 가게 통째로 빌려 떠들었는데",
"출연자 말고도 축하하러 왔었지」"
],
"11703": [
"「나도 모르는 놈이 몇 있었는데,",
"어느새 그 아저씨도 끼어들어서",
"섞여 있더라」"
],
"11704": [
"「대부분 돌아간 시간이",
"돼서도 계속 마셔 대고,",
"거의 끝까지 있었을...」"
],
"11705": [
"「...?",
"왜 그러세요?」"
],
"11706": [
"「그때, 분명 시쿠라가",
"같이 있었지...」"
],
"11707": [
"「네!?",
"시쿠라 씨라면 그,",
"시쿠라 긴지 씨요?」"
],
"11708": [
"「그래, 비디오 영화 일이었는데",
"촬영 중엔 출연 장면이 달라서",
"못 봤지만 뒤풀이엔...」"
],
"11709": [
"「...잠깐, 그 밖에도...」"
],
"11710": [
"쿠라이시 씨는 미간을 찌푸리고",
"무언가 생각에 잠겼다."
],
"11711": [
"숨죽이고 그 모습을 지켜본다."
],
"11712": [
"「꼬맹아, 이건 내 착각일지도",
"모르겠는데...」"
],
"11713": [
"「아뇨, 저기 뭔가 떠오르셨으면",
"알려 주세요!」"
],
"11714": [
"「...그때 말이지,",
"그 연극 뒤풀이 때...」"
],
"11715": [
"「지금 여기 모인 면면이",
"전원 모여 있었다」"
],
"11716": [
"「...네...?」"
],
"11717": [
"「네!?",
"전원이라니 히오리나 나스 씨도",
"다 있었다는 거예요!?」"
],
"11718": [
"「그 기모노는 틀림없이 있었던",
"것 같은데 출연자는 아니었지」"
],
"11719": [
"「츠바키는 차림이 지금이랑 딴판인데",
"출연한 건 확실했을 거고」"
],
"11720": [
"「지금 생각하면 그 근육도, 그땐",
"무대 뒤 소품 담당인 줄 알았는데",
"그런 체형은 흔치 않으니까」"
],
"11721": [
"「미사사기 씨도, 시즈나 짱네도요?」"
],
"11722": [
"「미사사기는 틀림없다,",
"출연자 중 하나였으니까」"
],
"11723": [
"「쌍둥이는 한쪽뿐이다.",
"나랑 출연이 안 겹쳐서",
"어느 쪽인지는 기억 안 나」"
],
"11724": [
"「그, 그럼, 그건...",
"그건 이, 이 사건이랑, 저기",
"뭔가 과, 관계가...」"
],
"11725": [
"「나도,",
"그게 이 사건이랑 관계있는지",
"없는지 알 턱이 없다」"
],
"11726": [
"「죄, 죄송해요,",
"그렇죠...」"
],
"11727": [
"「내 착각일지도 모르고",
"기억이 맞아도 그냥 우연일지도",
"모르지」"
],
"11728": [
"「다만...",
"좀 신경 쓰인다는 것뿐이다」"
],
"11729": [
"「...신경 쓰이네요.",
"그렇, 네요...」"
],
"11730": [
"「그렇지.",
"다들 배우라는 거 말곤 아무",
"접점도 없다고 생각했으니」"
],
"11731": [
"「그렇다고 그 뒤풀이에서",
"무슨 일이 있었냐 하면,",
"딱히 아무 일도 없었고...」"
],
"11732": [
"「아무것도...",
"싸움이라든가 다툼 같은 건",
"전혀 없었던 거군요」"
],
"11733": [
"「마다라이가 멋대로 끼는 건",
"늘 있는 일이었고」"
],
"11734": [
"「그때만의 특별히 별난 일",
"같은 건 없었을 거다」"
],
"11735": [
"「뭐, 정말 전원 있었는지는",
"솔직히 단언 못 하니까.",
"다른 놈한테도 물어봐라」"
],
"11736": [
"「그럴게요.",
"그거, 무슨 작품이었어요?」"
],
"11737": [
"「...『백야』다.",
"흰 밤이라 쓰고 백야」"
],
"11738": [
"「백야...」"
],
"11739": [
"「너 뭔가 잡은 거 있냐?」"
],
"11740": [
"「마다라이가 언제 죽었는지",
"같은 얘기 말이다」"
],
"11741": [
"「살해된 시간은 몰라요.",
"특정할 방법이 없으니까...」"
],
"11742": [
"「11시 넘어서부터 1시쯤",
"까지라는 대략적인 상태에서",
"바뀐 게 없어요」"
],
"11743": [
"「...할 수 없구먼,",
"하나만 더 알려 주지」"
],
"11744": [
"「11시 반 가까이까진",
"틀림없이 살아 있었다」"
],
"11745": [
"「네에!?」"
],
"11746": [
"「아아, 말해 두지만 만난 건 아니다.",
"테라스에서 담배 피울 때",
"목소리가 들렸을 뿐이야」"
],
"11747": [
"「목소리가...?」"
],
"11748": [
"「마다라이의 그, 예의 바보 웃음이",
"식당 쪽에서 들렸다」"
],
"11749": [
"「저쪽도 창문 열어 뒀던 모양인데,",
"그 뒤 바로 닫았는지",
"그걸로 끝이었지만」"
],
"11750": [
"「...저기, 마다라이 씨는",
"아무도 없어도 혼자 크게",
"웃거나 하나요」"
],
"11751": [
"「아무리 마다라이가 혼잣말",
"많은 놈이라도 그건...」"
],
"11752": [
"「그럼...누군가,",
"마다라이 씨 말고도....」"
],
"11753": [
"「...쳇,",
"나도 얼빠졌구먼」"
],
"11754": [
"「누가 있었단 거다,",
"마다라이랑 같이...」"
],
"11755": [
"（마다라이 씨와 함께 있던 게",
"이 저택의 누군가라면...）"
],
"11756": [
"그 알리바이 표 안에는,",
"틀림없이 거짓말이 섞여 있다..."
],
"11757": [
"「그, 정확한 시간",
"아세요?」"
],
"11758": [
"「그런 걸 똑똑히",
"기억할 리가 있냐」"
],
"11759": [
"「다만, 시계 보니 11시 반이라",
"한 대 더 피울까 해서",
"세 대째에 불 붙였지」"
],
"11760": [
"「마다라이 웃음소리가 들린 건",
"그보다 몇 분 전이다.",
"5분이나, 좀 더 짧을지도」"
],
"11761": [
"「...저기,",
"츠바키 군 말인데요...」"
],
"11762": [
"「흥...",
"쉽게 방에서 나오니까 그렇지」"
],
"11763": [
"「스스로 나갔다고",
"생각하세요?」"
],
"11764": [
"「억지로 지하까지 끌고 가면",
"좀 더 소리가 났겠지」"
],
"11765": [
"「네, 뭐...확실히」"
],
"11766": [
"「근데, 언제부터 지하에 있었는지",
"잘 모르겠어요」"
],
"11767": [
"「그날 아침, 다들 꽤",
"일찍부터 일어나 있었달까",
"소란스러웠는데요」"
],
"11768": [
"「츠바키가 지하에 내려간 시간이",
"그렇게 중요하냐?」"
],
"11769": [
"「아뇨, 사망 추정 시각은",
"부서진 시계 덕에 확실하니까",
"그렇게까진...」"
],
"11770": [
"「그러냐...」"
],
"11771": [
"「...아니 잠깐.",
"지하에 내려오자마자 시계가",
"박살 난 건 아닐 거 아냐」"
],
"11772": [
"「아, 네, 그야",
"그렇죠...」"
],
"11773": [
"「그렇구나, 그럼 츠바키 군이 더",
"전부터 지하에 있었다면 시계 시각은",
"죽은 시간보다 더 늦을지도...」"
],
"11774": [
"「...곤란하구먼」"
],
"11775": [
"「괜한 말 하지 말 걸 싶어서",
"그런다, 정말」"
],
"11776": [
"「네? 저기, 뭐가...」"
],
"11777": [
"「없었어, 지하엔.",
"적어도 4시 전엔",
"아무도 없었다」"
],
"11778": [
"「네!?",
"저기, 쿠라이시 씨,",
"그걸 어떻게 아세요...」"
],
"11779": [
"「쳇...",
"물을 것도 없잖냐, 그 시간에",
"내가 지하에 없었으면 어찌 알아」"
],
"11780": [
"「계, 계셨어요!?",
"네, 하지만, 쭉 방에 있었다고」"
],
"11781": [
"「지하에 시체가 굴러다니는데",
"누가 사실대로 말하겠냐,",
"의심받을 게 뻔하잖아」"
],
"11782": [
"「...하아...」"
],
"11783": [
"「새벽에 술 가지러 갔다.",
"그땐 아무도 없었고,",
"별다른 낌새도 없었다」"
],
"11784": [
"「...그러니까, 바닥에 페인트가",
"흘러 있다거나...」"
],
"11785": [
"「안 그랬다」"
],
"11786": [
"「그렇군요...",
"그게, 딱 4시쯤",
"이었어요?」"
],
"11787": [
"「아니...",
"지하에 내려간 게 딱 4시쯤이고",
"한동안 거기 있었으니...」"
],
"11788": [
"「...아아, 그거다.",
"내가 올라오니 마침 나스가",
"우당탕 뛰어서 현관을 나가더라」"
],
"11789": [
"「아, 그럼 지하에서 나온 건",
"4시 15분쯤이네요」"
],
"11790": [
"「그 뒤 부엌에 들렀다가,",
"방에 돌아간 건 4시 반 넘어서나",
"좀 더 뒤다」"
],
"11791": [
"그렇다면, 츠바키 군이 지하실에",
"온 건 쿠라이시 씨가 나간 뒤,",
"4시 20분쯤인가..."
],
"11792": [
"「그건 중요해요」"
],
"11793": [
"「그러냐?",
"근데, 츠바키 녀석이 죽은 시간은",
"거의 알려진 거 아니었냐?」"
],
"11794": [
"「네, 부서진 시계 때문에",
"그 시간 근처라는 건",
"알지만요...」"
],
"11795": [
"「그래도 설마, 지하에 내려온",
"순간 시계가 부서진 건",
"아닐 테니까요」"
],
"11796": [
"「...뭐, 그야 그렇지」"
],
"11797": [
"「히오리네가 복도에서 떠들 때",
"아무도 츠바키 군을 못 봤다면",
"더 전에 내려갔을 거고」"
],
"11798": [
"「한밤중부터 지하에 있었다면,",
"시계가 부서진 시간과 사망 시각은",
"생각보다 떨어져 있을지도」"
],
"11799": [
"「...근데, 하룻밤 방치했다가",
"아침이 돼서 궤짝에 넣었다는",
"것도 이상하고...」"
],
"11800": [
"「.....었다」"
],
"11801": [
"「새벽에 아가씨들이",
"떠들던 시간보다 전엔,",
"지하에 아무도 없었다」"
],
"11802": [
"「....네...」"
],
"11803": [
"「네에!?",
"저기, 쿠라이시 씨, 어떻게...」"
],
"11804": [
"「다른 놈한텐 말하지 마라.",
"넌 섣불리 내 짓이라고",
"떠들진 않겠지만...」"
],
"11805": [
"「...다른 놈들은,",
"내가 그날 아침 지하에 있었다 들으면",
"무슨 말을 할지 몰라」"
],
"11806": [
"「계셨어요!?",
"지하실에!?」"
],
"11807": [
"「술이 떨어졌다고, 술이.",
"지하에 와인 있잖냐」"
],
"11808": [
"「아, 아아...",
"그럼 그걸 가지러?」"
],
"11809": [
"「그래, 4시쯤이었지.",
"그땐 지하에 츠바키도 누구도",
"없었다」"
],
"11810": [
"「...바닥에 페인트가",
"흘러 있지도 않았어요?」"
],
"11811": [
"「아무것도.",
"조용하더라」"
],
"11812": [
"「그게 딱 4시쯤",
"이었어요?」"
],
"11813": [
"「아니, 지하에 내려간 게",
"그쯤이었으니까」"
],
"11814": [
"「지하실 나온 건 더 뒤다.",
"꽤 오래 와인 라벨을",
"보고 있었으니까」"
],
"11815": [
"「그럼, 지하에서 나온 건",
"4시 15분쯤이네요」"
],
"11816": [
"「그 뒤, 부엌에 들렀다가",
"방에 돌아간 게 4시 반 넘어선가」"
],
"11817": [
"「아니, 좀 더 뒤려나.",
"40분은 됐을지도 모르지」"
],
"11818": [
"즉 츠바키 군이 지하실에 온 건",
"쿠라이시 씨가 떠난 4시 15분쯤",
"보다 뒤라는 건가..."
],
"11819": [
"「나스 씨 일로...」"
],
"11820": [
"「내가 할 수 있는 얘긴 이제",
"거의 다 했다」"
],
"11821": [
"「그나저나, 뭐...",
"뭐랄까, 그런 떠들썩한 녀석이",
"없으니 허전하구먼」"
],
"11822": [
"「저기, 스즈나 짱",
"말인데요...」"
],
"11823": [
"「...저기...?」"
],
"11824": [
"「이봐, 꼬맹아.",
"그건 틀림없이",
"동생 쪽이라고 보냐?」"
],
"11825": [
"「아니, 설마 싶긴 하다만.",
"아마 지나친 생각이겠지」"
],
"11826": [
"「네, 네에...",
"시즈나 짱이 그렇게",
"울면서 착란했는데...」"
],
"11827": [
"「...그 시즈나는,",
"천재라고까지 불리는",
"여배우다만」"
],
"11828": [
"「설마 싶긴 하다만」"
],
"11829": [
"「저기...",
"시즈나 짱 일로...」"
],
"11830": [
"「...아가씨 말이냐」"
],
"11831": [
"「그건...」"
],
"11832": [
"「...아니, 아마 내가",
"괜히 신경 쓰는 거겠지」"
],
"11833": [
"「네?",
"저기, 뭐든 좋으니까",
"신경 쓰이는 게 있으면...」"
],
"11834": [
"「헛소리라고 생각해라」"
],
"11835": [
"「그건...",
"그 죽어 있던 쪽이 정말",
"언니 쪽이라고 보냐?」"
],
"11836": [
"「...네?」"
],
"11837": [
"「언니 쪽은 마음만 먹으면",
"아무도 모르게 동생 흉내 낼",
"정도의 여배우였으니까...」"
],
"11838": [
"「바보, 진지하게 듣지 마라.",
"아무리 그래도, 그건 아니겠지」"
],
"11839": [
"「그, 그렇죠...」"
],
"11840": [
"「저기...",
"나구모 씨가 우물에서 죽어 있던",
"사람이라고 보세요...?」"
],
"11841": [
"「...가능성은 있다만.",
"근데 나구모 역이라면 왜",
"얼굴을 뭉개야 하지?」"
],
"11842": [
"「모르겠어요...」"
],
"11843": [
"「얼굴을 뭉갠다는 건,",
"누군지 알아보지 못하게",
"하려는 거겠지」"
],
"11844": [
"「즉, 우리 중에 그 녀석",
"낯짝 보면 누군지 짐작 가는",
"인간이 있었단 거겠지」"
],
"11845": [
"「짐작이 간다...는 건",
"시쿠라 씨인가요...?」"
],
"11846": [
"「그렇다고 단언은 못 한다.",
"다만, 시쿠라라면 확실히 여기",
"놈들은 얼굴 보면 대개 안다」"
],
"11847": [
"「...문제는, 시쿠라라면",
"왜 얼굴을 못 알아보게",
"만들 필요가 있었냐는 거다」"
],
"11848": [
"「...그렇네요.",
"왜 시쿠라 씨라는 걸",
"알리고 싶지 않았는지...」"
],
"11849": [
"「모르겠구먼」"
],
"11850": [
"「시쿠라 긴지 씨라는 분과는",
"친하셨어요?」"
],
"11851": [
"「친할 정도는 아니었다.",
"자주 마주치고 나이가 비슷해서",
"얘기할 일은 많았다만」"
],
"11852": [
"「몇 살이세요?」"
],
"11853": [
"「시쿠라는 막 마흔이었던가.",
"분명 나보다 한 살 아래니까」"
],
"11854": [
"「근데 뭐...",
"일 말곤 교류는 없었다.",
"괴짜였으니까」"
],
"11855": [
"「괴짜요?」"
],
"11856": [
"「뭐랄까, 유령이니",
"저주니 하는 기분 나쁜 얘길",
"좋아하는 놈이었거든」"
],
"11857": [
"「유, 유령...」"
],
"11858": [
"「오컬트라고 하나?",
"그런 얘기 마니아였지」"
],
"11859": [
"...나도 별로 친해질 수",
"없을 것 같은 사람이다..."
],
"11860": [
"「쿠라이시 씨, 이케우치 리나 씨란",
"이름 들어 보셨어요?」"
],
"11861": [
"「이케우치...?",
"아니, 모른다」"
],
"11862": [
"「최근에 자살했다는",
"아이돌이라던데요」"
],
"11863": [
"「...그 뉴스는 뭔가로",
"본 것 같구먼」"
],
"11864": [
"「투신이었지, 아마.",
"그게 뭔가 관계있냐?」"
],
"11865": [
"「아뇨, 아직 모르겠지만요」"
],
"11866": [
"「흐응...",
"뭐, 관계없는 것 같으면 너무",
"들쑤시지 마라」"
],
"11867": [
"「저기, 사토에 미도리 씨라고",
"아세요?」"
],
"11868": [
"「사토에...",
"누구였더라, 어디서",
"들은 이름인데」"
],
"11869": [
"「꽤 옛날",
"아이돌인데...」"
],
"11870": [
"「저기...?」"
],
"11871": [
"「아아...",
"혹시 그건가」"
],
"11872": [
"「뭔데요?」"
],
"11873": [
"「옛날에, 아는 배우가",
"손댄 계집애가 그런 이름",
"이었던 것 같거든」"
],
"11874": [
"「주간지가 냄새 맡고",
"소동이 날 뻔했는데」"
],
"11875": [
"「여자 쪽이 물러나듯",
"모습을 감춰 버렸지」"
],
"11876": [
"「왜 갑자기요?」"
],
"11877": [
"「아무래도 아이가 생겨서",
"그랬던 모양이더라」"
],
"11878": [
"「아이가?",
"그럼, 그 사람은",
"혼자 키워서...?」"
],
"11879": [
"「그럴지도 모른다고",
"상대 남자도 찾으려고",
"했었는데 말이지」"
],
"11880": [
"「어째선지 갑자기",
"그 여자 얘기를 딱",
"안 하게 돼 버렸지」"
],
"11881": [
"「...안 태어난",
"걸까요...」"
],
"11882": [
"「나도 그런가 했는데",
"아닌 모양이더라」"
],
"11883": [
"「한참 뒤에 그때 태어난",
"애가 여자애였던 것 같은",
"말을 흘렸으니까」"
],
"11884": [
"「뭐, 옛날 얘기다.",
"그 손버릇 나쁜 남자도",
"몇 년 전에 가 버렸고」"
],
"11885": [
"「미사사기 씨가 옛날에 아이돌",
"이었던 거 아셨어요?」"
],
"11886": [
"「아이돌?",
"그 멍한 녀석이?」"
],
"11887": [
"「어느새 여배우로",
"전향했대요」"
],
"11888": [
"「흐응...」"
],
"11889": [
"「지금 지방에서 조촐하게 연기하는",
"정도니, 처음부터 아이돌이 되려고",
"된 건 아니었을지도 모르지」"
],
"11890": [
"「연기가 하고 싶어서",
"그만뒀다는 건가요?」"
],
"11891": [
"「그런 거 아니냐?",
"어쩌면 소속사랑",
"다퉜을지도 모르고...」"
],
"11892": [
"「네? 왜요?」"
],
"11893": [
"「실력에 비해 별로",
"눈에 띄는 일을 안 하니까」"
],
"11894": [
"「소속사 뜻을 거슬러서",
"작은 일만 받고",
"있는 건지도 모르지」"
],
"11895": [
"「그런 일이",
"정말 있어요?」"
],
"11896": [
"「그야 있지.",
"이 바닥엔 별일이 다 있다」"
],
"11897": [
"「뭐, 미사사기는 연기만",
"할 수 있으면 행복하단 얼굴이니",
"별로 괴롭진 않은 거 아니냐」"
],
"11898": [
"「르로이 백작이란 사람",
"아세요?」"
],
"11899": [
"「르로이?",
"옛날에 무슨 영화가 있었는데...」"
],
"11900": [
"「아아, 오컬트 영화였을 거다」"
],
"11901": [
"「오컬트...」"
],
"11902": [
"「그게 왜?」"
],
"11903": [
"「아뇨, 저기,",
"서재에 책이 있어서...」"
],
"11904": [
"「헤에, 실존 인물이었냐?",
"엘리자베스 바토리 같은",
"거였나...」"
],
"11905": [
"「누구예요, 그게?」"
],
"11906": [
"「응? 모르냐?",
"그러고 보니 요즘 책엔 이름",
"읽는 법이 달랐던가」"
],
"11907": [
"「중세 루마니아인가 어디 귀족인데",
"마을 처녀를 납치해 그 생피로",
"목욕하던 여자라...」"
],
"11908": [
"「으아아, 됐어요!",
"그런 사람이면 자세히",
"설명 안 해 주셔도요!!」"
],
"11909": [
"「사양 마라」"
],
"11910": [
"「사양 안 해요~!!」"
],
"11911": [
"「기타하야미 료스케 아세요?",
"다카토 엔지로의...」"
],
"11912": [
"「아, 그 일 안 하는 명탐정.",
"내가 조수였으면 한 대 칠 법한",
"성격이었지」"
],
"11913": [
"「실제로 곁에 있으면,",
"틀림없이 친다」"
],
"11914": [
"어지간히 일을 안 하나 보다.",
"료스케란 사람..."
],
"11915": [
"「히오리 료 기억하세요?",
"저기, 여기 있는 쪽 말고",
"소설에 나오는 쪽이요」"
],
"11916": [
"「왓슨이지.",
"일단, 소설가라는",
"설정이었던가」"
],
"11917": [
"「...근데, 왜 그런",
"이상한 놈이랑 어울리는지 원」"
],
"11918": [
"「이상한 놈이라면 료스케요?」"
],
"11919": [
"「그 말고 누가 있냐.",
"어떻게 참는지 진심으로 신기하다」"
],
"11920": [
"「...그렇게 심해요?」"
],
"11921": [
"「료스케랑 어울려서 좋은 게",
"있다면, 심심하지 않은 것 정도밖에",
"생각이 안 나는구먼」"
],
"11922": [
"「대신, 수명도 팍팍",
"깎일 것 같다만...」"
],
"11923": [
"「...어쩐지 알 것 같아요」"
],
"11924": [
"「다카토 씨 소설에,",
"진노 경감이란 사람",
"나오잖아요」"
],
"11925": [
"「그 시리즈에 나오는 것 중엔",
"유일하게 제정신인 인간일지도」"
],
"11926": [
"「유일하게요...」"
],
"11927": [
"「내가 정말 그놈들을 만난다면",
"같이 술 마실 수 있을 건",
"그 아저씨뿐이다」"
],
"11928": [
"「그 아저씨 나오는 얘기라면,",
"『저주받은 문신』이 재밌다」"
],
"11929": [
"「왠지 제목이 무서워",
"보이는데요」"
],
"11930": [
"「다카토 책은 전부 그런",
"제목뿐이잖냐」"
],
"11931": [
"「...그것도 그렇네요」"
],
"11932": [
"「뭐, 시간 나면 읽어 봐라」"
],
"11933": [
"「나미즈미 슌지란 사람 기억하세요?",
"다카토 씨 소설에 나오는데요」"
],
"11934": [
"「나미즈미...?",
"있었나, 그런 놈?",
"전혀 기억 안 난다」"
],
"11935": [
"「그렇군요...」"
],
"11936": [
"「다카토 씨 소설에 나오는",
"마다라이 씨는 시게오 씨란",
"이름이네요」"
],
"11937": [
"「응?",
"아아, 『검은 고양이의 독』 말이냐」"
],
"11938": [
"「그런 이름이었나,",
"잘 기억 안 난다」"
],
"11939": [
"별로 관심이 없는 것 같다."
],
"11940": [
"「구로조노 다쓰야 아세요?」"
],
"11941": [
"「누구냐 그건? 모른다」"
],
"11942": [
"「다카토 씨 소설에 나온",
"사람인데요」"
],
"11943": [
"「뭐야, 소설이냐.",
"기억 안 나는구먼,",
"안 읽었을지도 모르지」"
],
"11944": [
"「고오리 미즈에란 사람",
"아세요?」"
],
"11945": [
"「미즈에...?",
"어디서 들은 이름인데.",
"누구였더라」"
],
"11946": [
"「다카토 씨의...」"
],
"11947": [
"「아아!",
"그 취향 나쁜 여자!」"
],
"11948": [
"「취향이요?」"
],
"11949": [
"「료스케한테 반한 여자잖냐.",
"평범하게 살아도 몹쓸",
"남자한테 걸릴 것 같구먼」"
],
"11950": [
"쿠라이시 씨의 료스케 평가는",
"대체 얼마나 낮은 거지..."
],
"11951": [
"「『도깨비의 밀실』에 나오는",
"사에키 노인 기억하세요?」"
],
"11952": [
"「그 얘긴 읽은 것 같은데,",
"기억이 안 나는구먼...」"
],
"11953": [
"「음, 아카오 미쓰키란 사람이",
"나오는 얘기 기억하세요?",
"다카토 씨 소설인데」"
],
"11954": [
"「아카오?",
"어떤 놈이었지?」"
],
"11955": [
"「화가예요, 아마」"
],
"11956": [
"「화가라면, 뭔가",
"사신 그림 나오는 거였나?」"
],
"11957": [
"「아, 아마 그거예요...」"
],
"11958": [
"「...겁먹을 만큼 무서운 얘긴",
"아니다, 말해 두지만」"
],
"11959": [
"「다키 주자부로란 사람 나오는",
"다카토 씨 소설 기억하세요?」"
],
"11960": [
"「다키 주자부로라...?",
"아니, 좀 기억에 없다」"
],
"11961": [
"「오코노기라는 이름의",
"골동품상 나오는 얘기인데...」"
],
"11962": [
"「다카토 거냐?",
"제목이 뭐였더라...」"
],
"11963": [
"「뭔가 으스스한 얘기",
"아니었냐, 그거?」"
],
"11964": [
"「으스스!?」"
],
"11965": [
"「...뭐, 꼬맹이는",
"안 읽는 게 좋을 법한 얘기",
"였던 것 같구먼」"
],
"11966": [
"「...그럴게요...」"
],
"11967": [
"「『호반의 저택』에 나오는 쪽",
"나스 씨란 사람은...」"
],
"11968": [
"「...그거 말이냐.",
"하필이면 나스라니...」"
],
"11969": [
"「하필이면요?」"
],
"11970": [
"「안 닮아도 정도가 있지.",
"뭐, 이름만 빌린 거고",
"배역은 상관없다 쳐도」"
],
"11971": [
"「그렇게 안 닮았어요?」"
],
"11972": [
"「적어도 그쪽 나스는",
"아령만 들면 기분 좋아지는",
"이상한 놈은 아니었다」"
],
"11973": [
"...그런 사람은 좀처럼",
"없을 것 같다..."
],
"11974": [
"「도모에라는 여자가",
"나오는 얘기 있잖아요」"
],
"11975": [
"「『잊지 못할 섬』이냐?",
"다카토 엔지로의」"
],
"11976": [
"「네, 그거요」"
],
"11977": [
"「그건 꽤 옛날에",
"영화로도 나왔지.",
"그것도 몇 번이나」"
],
"11978": [
"「그랬어요?」"
],
"11979": [
"「제일 최근 건 꽤 새 거다.",
"아마 꼬맹이가 애였을 때쯤이지」"
],
"11980": [
"「세토우치 섬에서 촬영한 장면은",
"꽤 예뻤는데,",
"어찌 됐든 캐스팅이 말이지」"
],
"11981": [
"「안 어울렸어요?」"
],
"11982": [
"「도모에 역이, 그 무렵 인기가",
"오르던 신인 여배우였는데,",
"이게 발연기라...」"
],
"11983": [
"「그렇게 안 그래도 어려운 역을",
"얼굴만 예쁜 여배우가 어찌 해.",
"아까운 짓 했지」"
],
"11984": [
"「다카토 씨 소설 쪽",
"미사사기 씨 나오는 얘기 기억하세요?」"
],
"11985": [
"「...제목이 뭐였지?」"
],
"11986": [
"「『우리 안의 여자』예요」"
],
"11987": [
"「아아, 그거...」"
],
"11988": [
"「지하 감옥에서 여자가 죽는 장면은",
"기억나는데, 세세한 건",
"거의 기억이 없구먼」"
],
"11989": [
"「음, 쿠라이시 씨 이름의",
"캐릭터가 나오는 『꺼림칙한 꽃』",
"이라는 얘기인데요...」"
],
"11990": [
"「내가 나오는 거냐.",
"근데 금방 죽어 버리지」"
],
"11991": [
"「금방 죽어요?」"
],
"11992": [
"「첫머리에 잠깐 나오고",
"그 뒤론 쭉 시체다」"
],
"11993": [
"「그렇군요...」"
],
"11994": [
"「다카토 씨 소설에도 여배우가",
"나오죠, 기누타 유리라고」"
],
"11995": [
"「기누타 유리라...",
"옛날에 비슷한 이름 여배우가",
"진짜 있었지」"
],
"11996": [
"「나보다 옛날 배우고,",
"아마 벌써 죽었을 거다.",
"어쩌면 모델일지도」"
],
"11997": [
"「와, 그럴지도 모르겠네요」"
],
"11998": [
"「소설 쪽에서 츠바키란 이름의",
"사람이 나오는 얘기인데요」"
],
"11999": [
"「『종루관 살인』이지.",
"그 얘긴 텔레비전에서 했었지」"
],
"12000": [
"「개편기 특집이었나.",
"2시간 반쯤 되는 거」"
],
"12001": [
"「그것도 진짜 별장 같은 걸",
"빌려서 촬영했지.",
"저택 안 장면은」"
],
"12002": [
"「다만, 종루만 딱 맞는 게",
"없어서, 어느 미션계",
"학교까지 가서 찍었다」"
],
"12003": [
"「꽤 손이",
"많이 갔네요」"
],
"12004": [
"「드라마니 영화니 하는 건",
"뭐, 대개 그 정도 손은",
"들어가는 법이다」"
],
"12005": [
"「흐응...",
"힘드네요」"
],
"12006": [
"「시노노메 다키란 사람 기억하세요?",
"『그림 속의 죽음』이란 얘기의」"
],
"12007": [
"「『그림 속의 죽음』은 다카토지.",
"음, 별로 인상에 없구먼」"
],
"12008": [
"「『악마의 화원』에 나오는",
"시즈나 짱네는...」"
],
"12009": [
"「아아, 쌍둥이 말이냐.",
"그러고 보니 전에 드라마로 했을 땐",
"그 쌍둥이는 1인 2역이었지」"
],
"12010": [
"「대개 그렇다만.",
"그렇게 딱 이미지에 맞는 쌍둥이",
"배우는 좀처럼 없으니까」"
],
"12011": [
"「그렇죠」"
],
"12012": [
"「다카토 씨 소설에 우쓰로이 가라는",
"일족이 나오는 얘기가 있는데요」"
],
"12013": [
"「우쓰로이라는 이상한 이름은",
"들은 기억이 있다」"
],
"12014": [
"「뭔가 일족이 픽픽 죽어 나가는",
"오컬트 같은 얘기 아니냐?」"
],
"12015": [
"「그, 그래요」"
],
"12016": [
"「일일이 겁먹지 마라, 너도.",
"오컬트라 해도 진짜 유령이니",
"뭐니 하는 건 안 나온다」"
],
"12017": [
"「아, 그래요...」"
],
"12018": [
"「원령인지 뭔지의 짓으로",
"꾸몄을 뿐이다」"
],
"12019": [
"「...충분히 무서워요」"
],
"12020": [
"「철저하게 글렀구먼, 너」"
],
"12021": [
"「네...」"
],
"12022": [
"「유모 할머니가 있는 집은",
"요즘 흔치 않죠」"
],
"12023": [
"「그야 좀처럼 없겠지.",
"지금도 가끔 있긴 하다만,",
"그런 집에서 자란 놈」"
],
"12024": [
"「아는 분 중에 계세요?」"
],
"12025": [
"「이 바닥엔 가끔 네가 왜 여기",
"싶은 집안 놈이 섞여 있거든...」"
],
"12026": [
"「뭐, 나랑은 전혀",
"인연 없는 얘기다만」"
],
"12027": [
"「저도 없어요...」"
],
"12028": [
"「저기...",
"모자 장수 말인데요...」"
],
"12029": [
"「...흥.",
"이제 와서 모자 장수 따윈",
"아무 관계도 없어 보인다만」"
],
"12030": [
"「없다고 보세요?」"
],
"12031": [
"「이 사건, 아무리 봐도",
"계획적이니까」"
],
"12032": [
"「모자 장수가 범인이라면 굳이",
"스스로 이름 대고 우리를",
"불러 모을 필요는 없잖냐」"
],
"12033": [
"「그럼 처음부터 전부",
"범인 손바닥 위라는 거다.",
"열받는 얘기지만」"
],
"12034": [
"「쿠라이시 씨 방",
"이름 기억하세요?」"
],
"12035": [
"「내 방이라면 분명,",
"모방 살인의 원조 같은 얘기를",
"쓴 놈이라지」"
],
"12036": [
"「그렇게 들었다.",
"승려인지 주교인지,",
"그런 제목이라더라」"
],
"12037": [
"「주교...」"
],
"12038": [
"「아이세 미키 짱이란 애",
"아세요?」"
],
"12039": [
"「아이세?",
"어디서 들은 것도 같은데",
"누구냐?」"
],
"12040": [
"「요즘 엄청 인기 있는",
"아이돌인데요」"
],
"12041": [
"「아아, 아이돌이냐.",
"그럼 거의 모른다」"
],
"12042": [
"「비슷한 게 너무 많아서",
"뭐가 뭔지 모르겠다」"
],
"12043": [
"「어이, 내 나이면 몰라도",
"네가 동의하면 어쩌냐」"
],
"12044": [
"「사람 얼굴이랑 이름 외우는 게",
"서툴러서요...」"
],
"12045": [
"「아이돌 이전의",
"문제잖냐」"
],
"12046": [
"쓴웃음을 사 버렸다..."
],
"12047": [
"「기사라기 유리코 씨",
"아시죠?」"
],
"12048": [
"「여배우 말이냐?",
"그야 당연히 알지」"
],
"12049": [
"「몇 번 베인 적도",
"있고 말이지」"
],
"12050": [
"「칼싸움 연기로 말이다?」"
],
"12051": [
"「아, 네, 그건",
"알고 있는데요...」"
],
"12052": [
"「그만큼 칼싸움 연기 잘하는 여배우는",
"이제 찾아볼 수가 없지」"
],
"12053": [
"쿠라이시 씨는 조금 씁쓸한 투로",
"말하며 눈을 가늘게 떴다."
],
"12054": [
"「나루세 기미야스란 사람 아세요?」"
],
"12055": [
"「누구냐 그건?",
"들어 본 적 없다」"
],
"12056": [
"「저기, 마리안느란",
"히로인이 나오는 얘기",
"아세요?」"
],
"12057": [
"「...혹시 그,",
"닭살 돋는 낯간지러운",
"연애물 말이냐?」"
],
"12058": [
"「아마 그거예요」"
],
"12059": [
"「옛날에 영화로도 나와서",
"두 편쯤 본 적 있다만」"
],
"12060": [
"「여자들은 좋아하나,",
"난 보다가 중간에",
"도망치고 싶어지던데」"
],
"12061": [
"정말 질색이라는 듯",
"한숨을 내쉬었다..."
],
"12062": [
"「해리 키드먼이란",
"탐정 아세요?」"
],
"12063": [
"「...?",
"들어 본 적 없다, 소설이냐?」"
],
"12064": [
"「흐응...",
"난 모른다, 그런 놈」"
],
"12065": [
"역시 그다지 유명한 탐정은",
"아닌가 보다..."
],
"12066": [
"「진짜 집사",
"본 적 있으세요?」"
],
"12067": [
"「그건 없지,",
"그런 부자는 아는 사람도 없고」"
],
"12068": [
"「지금도 갈 데 가면",
"있을지도 모르지만」"
],
"12069": [
"「그래도 뭐, 아마",
"여기 집사보다는",
"침착하지 않겠냐?」"
],
"12070": [
"그야...",
"츠바키 군 같은 집사는",
"좀처럼 없겠지."
],
"12071": [
"「쿠라이시 씨는 형제가",
"있으세요?」"
],
"12072": [
"「형이랑 동생이 있다.",
"둘 다 착실한 회사원이다」"
],
"12073": [
"「나뿐이다, 이런 건달 같은",
"장사 하는 건」"
],
"12074": [
"「꼬맹이도 앞으로 어쩔지",
"모르지만, 부모 너무 울리지 마라」"
],
"12075": [
"「...아아, 그러고 보니」"
],
"12076": [
"「어젯밤엔 내가 위험하다더니",
"보다시피 멀쩡하다.",
"아무 일도 없었고」"
],
"12077": [
"「아, 네, 네에...」"
],
"12078": [
"「뭐, 쓸데없는 걱정이었겠지.",
"너무 무리하지 마라」"
],
"12079": [
"「...그렇지.",
"너 분명 어젯밤에도 내가",
"위험하다고 했다만」"
],
"12080": [
"「네, 아, 죄송해요」"
],
"12081": [
"「그때마다 딴 놈이 뻗으니",
"나까지 기분 나쁘잖냐.",
"적당히 헛소리는 그만둬라」"
],
"12082": [
"「네....」"
],
"12083": [
"「...아아, 그래.",
"너 또 나한테 위험하다고",
"했었지, 어젯밤」"
],
"12084": [
"「.....네.",
"죄송해요....」"
],
"12085": [
"「흥...",
"미덥지 못하구먼」"
],
"12086": [
"아쉽네요"
],
"12087": [
"그게 아니라"
],
"12088": [
"딱히 필요 없어요"
],
"12089": [
"저는 무서워요"
],
"12090": [
"그렇군요"
],
"12091": [
"저도 싫어해요"
],
"12092": [
"정말 그냥 길 잃었어요"
],
"12093": [
"추리가 안 돼요"
],
"12094": [
"이제 좀 봐주세요"
],
"12095": [
"가장 최근 작품은?"
],
"12096": [
"진짜 예명은?"
],
"12097": [
"「마다라이 씨, 저기...」"
],
"12098": [
"「응? 뭐야 자넨가.",
"사인이라면 나중에 해 주게」"
],
"12099": [
"「아, 아뇨, 저기,",
"그게 아니라」"
],
"12100": [
"「호오, 그럼 사진인가.",
"공교롭게도 난 휴대폰 촬영은",
"사양하고 있네만」"
],
"12101": [
"「그, 그러세요",
"아쉽네요...」"
],
"12102": [
"딱히 필요 없는데,",
"필요 없다고 하면 화낼 것",
"같단 말이지, 이 사람."
],
"12103": [
"「하하하, 그런가.",
"응응, 그렇고말고」"
],
"12104": [
"「뭐, 여기서 만난 인연도 있으니,",
"다음 기회가 있으면 특별히",
"챙겨 주도록 하지」"
],
"12105": [
"「뭐, 나도 바쁜 몸이라,",
"몇 시간씩이나 해 줄 순",
"없지만, 사진 정도는 말이야」"
],
"12106": [
"「그래그래, 색지도 잊지 말고",
"준비해 두게, 좌우명을 곁들여",
"써 주도록 하지」"
],
"12107": [
"「가, 감사합니다...」"
],
"12108": [
"「뭘, 팬이 있어야",
"먹고사는 게 우리들이니까.",
"하하하하하...」"
],
"12109": [
"...노골적으로 기분이",
"좋아져 버렸다."
],
"12110": [
"정말 사인이랑 사진 받으러",
"안 가면 호출당할 것 같다."
],
"12111": [
"「저기, 그게 아니라요.",
"사진도 아닌데요」"
],
"12112": [
"「뭐?",
"그럼 무슨 용건인가?」"
],
"12113": [
"「나 같은 배우를 앞에 두고",
"다른 용건이 있을 리가...」"
],
"12114": [
"...그 자신감은 대체 어디서",
"솟아나는 걸까..."
],
"12115": [
"어떤 의미로는 좀 부러운 사람",
"일지도 모른다."
],
"12116": [
"「...딱히 필요 없어요」"
],
"12117": [
"「뭐, 뭐야, 아닌가!?",
"헷갈리게 하는구먼 자넨!!」"
],
"12118": [
"（...그렇게 헷갈리는",
"말투였나...）"
],
"12119": [
"「정말이지 요즘 팬들은",
"예의를 모르는 자가 많아 곤란해!」"
],
"12120": [
"「아아, 한탄스러운 일이야.",
"내가 명작 『무지개 사랑』에",
"나올 땐 좀 더 조신하게...」"
],
"12121": [
"쑥스러움을 감추려는 건지 뭔지,",
"혼자 계속 떠든다."
],
"12122": [
"일단, 솔직하게 속마음을",
"말하지 않는 게 좋겠다, 이 사람."
],
"12123": [
"「저기, 그래서...」"
],
"12124": [
"「음, 정말 잘도 오는구먼.",
"뭐, 야외 촬영은 아니니,",
"날씨 기다릴 일은 없지만」"
],
"12125": [
"「그래도 이렇게 계속 오면",
"기분이 가라앉아서...응?",
"뭐야, 아직 있었나, 자네」"
],
"12126": [
"이 사람은 혹시, 아무도 말 안 걸어도",
"혼자 떠드는 걸까."
],
"12127": [
"「어떻게 생각하나, 이 날씨?",
"일단 폭풍우 치는 밤이란 설정이니",
"환영해야 하겠지만...」"
],
"12128": [
"「우오옷!?」"
],
"12129": [
"「왓!?」"
],
"12130": [
"「바, 방금 건 가까웠던",
"거 아닌가, 응」"
],
"12131": [
"「아, 딱히 무서운 건",
"아니네만, 나는, 응」"
],
"12132": [
"「저는 무서워요...」"
],
"12133": [
"「응? 그런가?",
"하하하, 어쩔 수 없구먼」"
],
"12134": [
"「저런 건 그저 자연현상",
"아닌가, 곤란한 친구로군」"
],
"12135": [
"자기도 엄청 놀랐으면서",
"약삭빠른 사람이다..."
],
"12136": [
"「나 같은 베테랑쯤 되면",
"폭우 속 촬영 따윈 드문 일도",
"아니거든, 응」"
],
"12137": [
"「아, 그러세요」"
],
"12138": [
"「당연하지 않나,",
"애도 아니고!」"
],
"12139": [
"「저런 걸 무서워해서야",
"배우 노릇 못 하네, 자네」"
],
"12140": [
"「그런 건가요」"
],
"12141": [
"「그런 거고말고.",
"뭐, 아마추어는",
"모르겠지만」"
],
"12142": [
"어떻게 반응해야 할지",
"곤란하다..."
],
"12143": [
"「저도 싫어하긴 하는데...」"
],
"12144": [
"「싫어해, 응, 그래그래",
"싫어하는 거야 무서운 게 아니라」"
],
"12145": [
"「나는 섬세하니까,",
"저렇게 시끄러운 소리를 내는",
"건 도무지 좋아할 수가 없어」"
],
"12146": [
"「그렇고말고, 천둥 따윈",
"무섭지도 아무렇지도 않고말고」"
],
"12147": [
"들으면 들을수록 변명으로밖에",
"안 들리는 건 왜일까..."
],
"12148": [
"「저, 저기요...」"
],
"12149": [
"「...오오, 그렇지!",
"자넨 분명 처음에 뒤뜰에",
"쓰러져 있었다지」"
],
"12150": [
"「네? 그, 그런데요」"
],
"12151": [
"「게다가 그 뒤, 시체를 봤다느니",
"뭐니 떠들었지」"
],
"12152": [
"「...후훙,",
"과연 그렇구먼...」"
],
"12153": [
"「저기, 그게 왜요?」"
],
"12154": [
"「아니아니 숨기지 않아도 되네,",
"다른 사람들한텐 비밀로 해 주지」"
],
"12155": [
"「뭐, 뭘요!?」"
],
"12156": [
"「그 대신, 모든 걸 꿰뚫어 본",
"나한테만은 진실을",
"말해 주게나, 자네」"
],
"12157": [
"「진실이요?」"
],
"12158": [
"「어라라?",
"이제 와서 시치미 뗄 건가?」"
],
"12159": [
"「뭐, 걱정할 건 없네.",
"특수한 역을 받은 건",
"자네만이 아니거든」"
],
"12160": [
"「실은 나도 내 방에",
"비밀이 있으니까, 뭐,",
"피차일반이란 거지」"
],
"12161": [
"「그러니까, 무슨 얘기...」"
],
"12162": [
"「난 다 꿰뚫어 보고 있네, 자네」"
],
"12163": [
"「자네 행동은 너무 극적이야.",
"우연히 길을 잃어 여기 도착했고,",
"게다가 시체를 봤다니...」"
],
"12164": [
"「그런 건 대본이 있다고밖에",
"생각할 수 없어, 아니 있고말고!",
"그게 틀림없어!」"
],
"12165": [
"「...네에!?」"
],
"12166": [
"「후후후, 너무나 뛰어난 통찰력에",
"놀라움을 감출 수 없나 보군」"
]
}