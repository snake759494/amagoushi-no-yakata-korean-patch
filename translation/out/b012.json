{
"6739": [
"(눈이 핑핑 돈다...)"
],
"6740": [
"(...더는 못 서겠어...)"
],
"6741": [
"(...날이 밝았네...)"
],
"6742": [
"밤이 가고 어스레한 아침이 왔다.",
"이제 괜찮으려나."
],
"6743": [
"같은 자세로 가만히 있느라",
"뻐근해진 다리와 허리를 펴고",
"몸을 일으킨다."
],
"6744": [
"(놀라지 않게, 들키기 전에",
"얼른 여기서 벗어나자...)"
],
"6745": [
"살금살금 복도 모퉁이를 돌아",
"계단 쪽으로 돌아간다..."
],
"6746": [
"기가 막힌 타이밍에",
"등 뒤에서 문 열리는 소리가 났다."
],
"6747": [
"「언니~」"
],
"6748": [
"(아, 스즈나구나...)"
],
"6749": [
"「언니 좀~.",
"참... 잠버릇 나쁘다니까」"
],
"6750": [
"「언...」"
],
"6751": [
"갑자기 스즈나의",
"목소리가 뚝 끊겼다."
],
"6752": [
"(무슨 일이지...?)"
],
"6753": [
"「으...",
"꺄아아아아아아악!!」"
],
"6754": [
"온몸을 쥐어짜는 듯한 비명에",
"흠칫 놀랐다."
],
"6755": [
"「무, 무슨 일이야!?",
"스즈나!?」"
],
"6756": [
"허겁지겁 되돌아가",
"시즈나의 방으로 뛰어든다."
],
"6757": [
"「...어...」"
],
"6758": [
"「언니!!",
"싫어, 언니이이!!」"
],
"6759": [
"순간, 무슨 상황인지 몰랐다.",
"내 발치에서 스즈나가",
"반쯤 미쳐 울부짖고 있다."
],
"6760": [
"그 안쪽에... 있는 건..."
],
"6761": [
"(......거짓말...)"
],
"6762": [
"(그치만... 그럴 리가...)"
],
"6763": [
"「...나고 씨!?」"
],
"6764": [
"「...히...오리...」"
],
"6765": [
"「저... 저거...」"
],
"6766": [
"「저거... 시즈나, 맞아?」"
],
"6767": [
"「...응?",
"시즈나...」"
],
"6768": [
"「시끄러워!!」"
],
"6769": [
"「앗...!?」"
],
"6770": [
"멍하니 서 있다가",
"있는 힘껏 떠밀렸다."
],
"6771": [
"「이런...",
"스즈나 씨, 잠깐만...」"
],
"6772": [
"「시끄러, 나가!!",
"언니 만지지 마!!」"
],
"6773": [
"스즈나가 흐느끼면서",
"내 몸을 힘껏 밀어",
"방 밖으로 내보내려 했다."
],
"6774": [
"「알겠어요, 나갈게요.",
"나갈 테니까...」"
],
"6775": [
"「나고 씨, 자요.",
"걸을 수 있겠어요?」"
],
"6776": [
"「......어, 응」"
],
"6777": [
"걷는다기보다 질질 끌려가는",
"거나 다름없는 꼴로 방을 나왔다."
],
"6778": [
"「나가, 빨리!",
"언니...!!」"
],
"6779": [
"눈앞에서 문이 닫혔다.",
"안에서는 끊임없이 울부짖는",
"소리가 들려온다..."
],
"6780": [
"「...당분간은 가만히",
"두는 수밖에 없겠죠」"
],
"6781": [
"정신을 차려 보니 나와 히오리",
"말고도 누군가 있는 듯했다."
],
"6782": [
"나는 그저 머리가 어질하고",
"숨이 막혀서, 어디든 앉고 싶다는",
"생각밖에 할 수 없었다..."
],
"6783": [
"「...!」"
],
"6784": [
"나가 볼까 생각한 순간",
"눈앞의 문이 열렸다."
],
"6785": [
"(스즈나...!)"
],
"6786": [
"(다행이다, 무사했어...",
"...살았구나...)"
],
"6787": [
"이제 안심하고 잘 수 있겠다...",
"갑자기 나가면 놀랄 테니까",
"간 다음에 나가야지."
],
"6788": [
"아무래도 옆방 시즈나를",
"깨우러 가는 모양이다."
],
"6789": [
"「언니 좀~.",
"참.. 잠버릇 나쁘다니까」"
],
"6790": [
"「언...」"
],
"6791": [
"「...읏!?」"
],
"6792": [
"엄청난 비명에 순간 움찔해서",
"굳어 버렸다."
],
"6793": [
"「어, 언니!?",
"언니, 왜...!?」"
],
"6794": [
"「무.. 무슨 일이야!?」"
],
"6795": [
"보통 일이 아니다...",
"숨어 있던 것도 잊고 창고에서",
"뛰쳐나가 시즈나 방으로 달려갔다."
],
"6796": [
"「언니이이!!",
"왜, 왜 이래!?」"
],
"6797": [
"「스즈나...」"
],
"6798": [
"그리고...",
"처참한 광경에 얼어붙었다."
],
"6799": [
"새빨간 핏빛과, 숨 막힐 듯한",
"피 냄새."
],
"6800": [
"(...뭐야, 이거...)"
],
"6801": [
"(시즈나...?",
"...저게...?)"
],
"6802": [
"(...설마...)"
],
"6803": [
"「――나고 씨!」"
],
"6804": [
"아득하게 정신이 멀어지려는데",
"무언가가 나를 붙잡아 주었다."
],
"6805": [
"「나고 씨?",
"괜찮아요?」"
],
"6806": [
"「...히오리」"
],
"6807": [
"「...저... 저거...」"
],
"6808": [
"「어... 째서...」"
],
"6809": [
"「...시...즈나...」"
],
"6810": [
"「나가!!」"
],
"6811": [
"「앗...",
"스즈나 씨인가요?」"
],
"6812": [
"「언니 만지지 마!!",
"다들 나가라고!!」"
],
"6813": [
"스즈나가 반쯤 미쳐 고함치는",
"소리가 멀리서 들린다."
],
"6814": [
"벽도 천장도 물속에 있는 것처럼",
"일렁일렁 흔들렸다."
],
"6815": [
"「나, 나갈게요 나가요.",
"손 안 댈 테니까...」"
],
"6816": [
"「나가...!!",
"언니이...!!」"
],
"6817": [
"「당분간 가만히",
"두는 게 좋지 않을까...」"
],
"6818": [
"「그렇겠죠...」"
],
"6819": [
"어느새 히오리 말고도",
"다른 사람 목소리가 들린다."
],
"6820": [
"(...앉고 싶어...)"
],
"6821": [
"눈이 돌고 숨이 막힌다.",
"어디 앉든지 눕든지 하고 싶다."
],
"6822": [
"휘청이며 주저앉으려는데",
"누가 팔을 잡아 일으켜 주었다."
],
"6823": [
"「...더는 못 서겠어...」"
],
"6824": [
"누군가 대답한 것 같기도 하다.",
"그 뒤로는 왠지 몸이 가벼워져서",
"어딘가로 흔들리며 실려 갔다..."
],
"6825": [
"「...그렇게",
"풀 죽지 마세요」"
],
"6826": [
"「나고 씨 탓이 아니잖아요.",
"애초에 처음 당신을",
"부추긴 건 저였고요」"
],
"6827": [
"「어..」"
],
"6828": [
"「모방 살인일지도 모른다고",
"말을 꺼낸 것도 저고요.",
"괜히 책임 느끼는 거라면..」"
],
"6829": [
"「그.. 그런 건 아니야.",
"내가 이것저것 조사하고",
"움직이는 건 전부...」"
],
"6830": [
"「...무서워서, 니까」"
],
"6831": [
"「그러고 보니 처음에도",
"그렇게 말했었죠...」"
],
"6832": [
"「그래도 저희를 구할 수",
"있을지도 모른다고,",
"그렇게도 말해 줬잖아요」"
],
"6833": [
"「...그렇긴 한데...",
"구할 수 있으면 좋겠다고",
"생각은 했지만...」"
],
"6834": [
"「...실패해 버렸는걸」"
],
"6835": [
"「그러니까 그게 당신만의",
"탓이 아니라니까요」"
],
"6836": [
"「저를 포함해서 다른 사람들은",
"허둥대기만 했지 아무것도",
"안 한 거나 마찬가지니까요」"
],
"6837": [
"「그치만 히오리네는 나 같은",
"외부인이랑 입장이 다르잖아..」"
],
"6838": [
"「그러니까 더 죽기 살기로",
"매달려야 하는 거겠지만요」"
],
"6839": [
"「...뭔가 마비되는 걸까요.",
"뭘 생각하려 해도 정신 차리면",
"생각이 툭 끊겨 있는 느낌이라..」"
],
"6840": [
"「아.. 그거 알아.",
"뭘 생각하려 하면 무서운 상황이란",
"게 떠올라서 싫은 거야...」"
],
"6841": [
"「그래서 정신 차리면 머리가",
"멋대로 딴생각을 하고 있고...",
"자주 그래, 그런 거」"
],
"6842": [
"「...그런 건가요.",
"현실도피라는 건가」"
],
"6843": [
"「...이런 때가 돼서야 처음으로",
"제가 의외로 배짱이 없다는 걸",
"뼈저리게 느끼네요...」"
],
"6844": [
"「...히오리가 나보다",
"훨씬 침착하다고 생각하는데」"
],
"6845": [
"「전 감정 표현이 나고 씨만큼",
"솔직하지 못할 뿐이에요」"
],
"6846": [
"「무서워하면서도 어떻게든",
"해 보려는 당신 쪽이",
"훨씬 배짱 있는 거라고요」"
],
"6847": [
"「그런 말 처음 들어」"
],
"6848": [
"「그래요?",
"아, 평소엔 알기 어려운가」"
],
"6849": [
"「어지간한 역경이 아니면",
"모르는 건지도요」"
],
"6850": [
"「하긴 이런 상황은",
"태어나서 처음이긴 해」"
],
"6851": [
"「...전 두 번째인데도",
"이 꼴이니까요」"
],
"6852": [
"「그런...」"
],
"6853": [
"「말했잖아요.",
"우리 할아버지가 머리 위로",
"물건이 떨어져서 죽었다고」"
],
"6854": [
"「...일단은 사고였을 거라는",
"걸로 끝나 버렸지만요」"
],
"6855": [
"「아.. 아니라고 생각해...?」"
],
"6856": [
"「저는요...",
"아마 저 혼자뿐이겠지만」"
],
"6857": [
"「뭐, 당시엔 꼬맹이였으니",
"그냥 착각일지도 모르죠」"
],
"6858": [
"「그래도, 뭐...",
"기묘한 사건을 몇 번 겪든",
"이 꼴이라는 건...」"
],
"6859": [
"「...전 어지간히 명탐정이란 거엔",
"안 맞는 모양이에요」"
],
"6860": [
"「...나.. 나도",
"맞는다고는 생각 안 하지만...」"
],
"6861": [
"「그래도...」"
],
"6862": [
"「어.. 어떻게든 하고 싶어.",
"빨리 끝내고 싶어...」"
],
"6863": [
"「...저도 그래요.",
"안 맞는 나름대로 어떻게든...」"
],
"6864": [
"「아무튼 이제 시간이 없으니",
"초조하네요...」"
],
"6865": [
"「...내일, 이었지」"
],
"6866": [
"「원래대로면 촬영 끝나는 날이」"
],
"6867": [
"「네, 맞아요」"
],
"6868": [
"「그럼 이제...",
"타임리미트구나...」"
],
"6869": [
"「어쩔 생각일까요.",
"데리러 올 사람이 거의 확실히",
"안 온다는 건 알 텐데」"
],
"6870": [
"「그렇다고 이제 와서 범인이",
"예정을 바꾸거나 할까」"
],
"6871": [
"「안 바꾸겠죠.",
"지금까지도 처음 계획한 걸",
"그냥 계속하는 느낌이었으니」"
],
"6872": [
"「...그렇, 겠지.",
"어떻게든 안 하면 이젠...」"
],
"6873": [
"「...못 나가겠죠.",
"이 저택에서...」"
],
"6874": [
"「...생각해 보자.",
"범인도 이만큼이나",
"일을 저질렀으니까...」"
],
"6875": [
"「분명히...",
"분명히 어딘가에 뭔가",
"단서를 남겼을 거야」"
],
"6876": [
"「...그렇네요.",
"저지른 일이 많아질수록",
"흔적도 많이 남는 법이고...」"
],
"6877": [
"「응... 아, 맞다.",
"사진은? 벌써 찍었어?」"
],
"6878": [
"「아, 죄송하지만",
"휴대폰 빌려 썼어요」"
],
"6879": [
"「그렇구나.",
"괜찮아, 한 휴대폰에 전부",
"들어 있는 게 낫지」"
],
"6880": [
"「...나, 좀 더",
"조사하면서 생각해 볼게」"
],
"6881": [
"「네...",
"그럼 저는...」"
],
"6882": [
"「히오리는 평소처럼 서재에 있어.",
"무슨 일 있으면 바로 알릴게」"
],
"6883": [
"「게다가...",
"이제 와서 갑자기 딴 행동하면",
"범인도 수를 바꿀지 몰라」"
],
"6884": [
"「...그럴지도 모르겠네요.",
"그건 그것대로 곤란하고...」"
],
"6885": [
"「응, 그러니까 서재에 있어」"
],
"6886": [
"「알겠어요.",
"저기, 그 표는 어쩔까요?」"
],
"6887": [
"「아, 그것도 만들어야지.",
"기준으로 삼을 건...」"
],
"6888": [
"「큰 시계가 울린 시간이겠지」"
],
"6889": [
"「그것밖에 없겠죠」"
],
"6890": [
"「...음,",
"스즈나가 일어난 시간?」"
],
"6891": [
"「그건 정확히 몇 시인지",
"모르잖아요」"
],
"6892": [
"「그, 그렇구나.",
"그럼...」"
],
"6893": [
"「언제일까?",
"쌍둥이가 방에 돌아간",
"시간쯤일까?」"
],
"6894": [
"「그보다 이상한 일이",
"있었잖아요」"
],
"6895": [
"「어?",
"아, 그렇구나...」"
],
"6896": [
"「다만 문제는 아까 얘기론",
"다들 자고 있었던 모양이라」"
],
"6897": [
"「그렇다니까...」"
],
"6898": [
"「그래도 그 시계가 사건이랑",
"관계 있는 건 확실할 거야」"
],
"6899": [
"「그렇죠.",
"뭘 위해 울린 건지",
"짐작해 봐야겠죠」"
],
"6900": [
"「응.",
"어떻게든 생각해 볼게」"
],
"6901": [
"「모르겠으면",
"서재로 물어보러 갈게」"
],
"6902": [
"「알겠어요.",
"조심하세요, 나고 씨」"
],
"6903": [
"「히오리도」"
],
"6904": [
"「네, 그럼 이따 봬요」"
],
"6905": [
"그렇게 말하고 히오리는 소파에서",
"일어나 거실을 나갔다."
],
"6906": [
"(왠지 호기로운 소리를",
"해 버렸는데...)"
],
"6907": [
"...이제 하루밖에 없다.",
"내일이 되면 모든 게 지금처럼",
"굴러간다는 보장이 없으니까."
],
"6908": [
"정말로 살아서 나가고 싶다면",
"한시라도 빨리 어떻게든..."
],
"6909": [
"(...어쩌지)"
],
"6910": [
"무작정 돌아다녀 봤자",
"소용없을 테고..."
],
"6911": [
"(일단 2층으로...",
"쌍둥이 방 쪽에 가 보자)"
],
"6912": [
"아까는 쓰러지는 바람에",
"주위를 볼 여유도 없었으니까."
],
"6913": [
"(...울고 있어...)"
],
"6914": [
"시즈나 방 앞까지 오자",
"문 너머에서 비통한 흐느낌이",
"들려왔다."
],
"6915": [
"(시즈나 방에",
"틀어박혀 버렸구나...)"
],
"6916": [
"...이대로 가만히",
"두는 게 좋겠지."
],
"6917": [
"(스즈나 방은...)"
],
"6918": [
"문이 열려 있는 것 같다.",
"미안하지만 잠깐 들어가 보자."
],
"6919": [
"바로 옆방이니까 방 구조는",
"거의 같을 텐데."
],
"6920": [
"물건엔 되도록 손대지 않으며",
"베란다 쪽으로 다가간다."
],
"6921": [
"밖은 여전히 비가 온다.",
"베란다가 꽤 넓어서",
"비에 안 젖은 부분도 많지만."
],
"6922": [
"(...딱히 아무것도 없네)"
],
"6923": [
"(...저쪽이",
"시즈나 방...)"
],
"6924": [
"베란다를 나누는 문 앞까지 가서",
"손잡이를 움직여 봤다."
],
"6925": [
"(역시 안 열리네...)"
],
"6926": [
"경첩이 완전히 녹슬었으니까.",
"여길 지나 시즈나 방으로",
"가는 건 무리야."
],
"6927": [
"(그럼 베란다를 지나가려면",
"반대쪽에서 오는 수밖에",
"없다는 건가...)"
],
"6928": [
"손잡이는 움직이는데 문은",
"전혀 열리지 않는다."
],
"6929": [
"(자물쇠는... 없는데.",
"왜 안 움직이지?)"
],
"6930": [
"(뭐가 끼어 있는 것도",
"아닌데... 앗!)"
],
"6931": [
"경첩이 녹슬어 있어...",
"그래서 문이 꿈쩍도 안 하는구나."
],
"6932": [
"그럼 어떻게 해도 이 문은",
"안 열리는 거야..."
],
"6933": [
"(이쪽 방에서 베란다를",
"지나 시즈나 방으로",
"가는 건 무리구나)"
],
"6934": [
"베란다에 나가는 바람에",
"비에 조금 젖어 버렸다."
],
"6935": [
"방 안을 적시지 않게",
"조심하며 돌아온다."
],
"6936": [
"(...어쩌지)"
],
"6937": [
"다른 곳도 보러 가 볼까.."
],
"6938": [
"「...어떻게 했어야",
"좋았을까요」"
],
"6939": [
"「뭐가 뭔지도 모르는 새에",
"줄줄이 사람이 죽어 나가고...」"
],
"6940": [
"「...처음엔 그래도 어떻게든",
"범인을 밝혀내든 뭐든",
"할 수 없을까 하고...」"
],
"6941": [
"「...생각하려 했던",
"것 같은데요...」"
],
"6942": [
"「그래도 뭘 떠올리기도 전에",
"일이 너무 빨리 진행돼서...」"
],
"6943": [
"「...도중부터는 그냥 멍하니",
"있기만 했던 것 같네요...」"
],
"6944": [
"「정말... 어떻게 했어야",
"좋았을까...」"
],
"6945": [
"「현장을 그렇게 이상하게",
"만들었으니 그만큼 꼬리도",
"잡기 쉬웠을 텐데 말이죠」"
],
"6946": [
"「온실에 놓여 있던 소품 같은 건",
"일종의 예고 같은 거였을",
"거라고 생각하고요」"
],
"6947": [
"「그거나 시체에 이상한 짓을 한",
"의미를 알았으면, 뭔가 손쓸",
"방법이 있었을 것 같아?」"
],
"6948": [
"「그럴지도요.",
"이제 와서는 확인할",
"방법도 없지만요...」"
],
"6949": [
"「히오리는 뭔가 생각했던",
"거 있었어...?」"
],
"6950": [
"「저는... 아무래도",
"엉뚱한 것만",
"신경 쓰여서요」"
],
"6951": [
"「어떤?」"
],
"6952": [
"「...아뇨, 제 건",
"추리소설을 너무 읽은 탓이겠죠」"
],
"6953": [
"「실제로 다른 사람들한테선",
"그럴지도 모른다는 의견이",
"전혀 안 나왔으니까...」"
],
"6954": [
"그렇게 말하며 히오리는 천천히",
"소파에서 일어났다."
],
"6955": [
"「...그럼 전 서재에",
"있을게요...」"
],
"6956": [
"「아... 응」"
],
"6957": [
"...서재.",
"그러고 보니 히오리는 줄곧 서재에서",
"뭔가 골똘히 생각하고 있었다."
],
"6958": [
"(뭐가 신경 쓰였던 걸까?)"
],
"6959": [
"(...분명 처음 서재에",
"갔을 때도 뭔가...)"
],
"6960": [
"「나고 씨는 여기 책 아직",
"안 읽어 봤던가요」"
],
"6961": [
"「아, 응.",
"원서가 많은 것 같아서",
"책등만 훑어봤나」"
],
"6962": [
"「그게 왜?」"
],
"6963": [
"「아뇨, 됐어요.",
"저도 꽤 지쳤나 보네요...」"
],
"6964": [
"「아무래도 자꾸 나쁜 쪽으로만",
"머리가 돌아가는 것 같아요」"
],
"6965": [
"(...난 책엔 손도",
"안 댔지만...)"
],
"6966": [
"(서재에 있는 책 중에 뭔가",
"신경 쓰이는 게 있었나..?)"
],
"6967": [
"...그래도 이제...",
"그게 뭔지 안다 해도",
"늦은 건지도 모르지만..."
],
"6968": [
"원래대로라면 내일 촬영이",
"끝날 예정이었으니까."
],
"6969": [
"(그래도...)"
],
"6970": [
"(지금 이 상황에서 내일이",
"오면... 우리는...)"
],
"6971": [
"(...대체 어떻게 되는 걸까)"
],
"6972": [
"...왠지 한기가 들어",
"몸을 떨었다."
],
"6973": [
"갑자기 넓은 방에 혼자 있는 게",
"무서워졌다..."
],
"6974": [
"(아, 거실이구나, 여기...)"
],
"6975": [
"나는 누워 있었고, 말소리가 들려서",
"그래서... 눈을 뜨니 옆에."
],
"6976": [
"「...히오리...」"
],
"6977": [
"「아, 정신 들었네요.",
"다행이다...」"
],
"6978": [
"떨어져 있던 사람들이",
"일제히 이쪽을 본다."
],
"6979": [
"「야, 일어났구나」"
],
"6980": [
"나스 씨다..."
],
"6981": [
"「이제 괜찮으세요?」"
],
"6982": [
"걱정스레 봐 주는 건",
"미사사기 씨고, 그리고..."
],
"6983": [
"「칠칠맞은 꼬맹이 같으니」"
],
"6984": [
"쿠라이시 씨까지 있다..."
],
"6985": [
"(...그런데...)"
],
"6986": [
"츠바키 군과 마다라이 씨...",
"그리고 쌍둥이가 없다."
],
"6987": [
"...꿈이 아니었구나.",
"나도 모르게 다시 눈을 감는다."
],
"6988": [
"「나고 씨...",
"역시 몸이 안 좋아요?」"
],
"6989": [
"「괜찮아, 일어날게...」"
],
"6990": [
"마음을 굳게 먹고 이번엔 눈을 뜸과",
"동시에 천천히 몸을 일으켰다."
],
"6991": [
"「무리 안 해도 돼요」"
],
"6992": [
"「...괜찮아...」"
],
"6993": [
"「뭐, 그런 느긋한 소리",
"할 때도 아니지」"
],
"6994": [
"「음, 어떻게 할 거야?」"
],
"6995": [
"「어떻고 자시고가 어딨어.",
"누가 한 짓이야, 그건?」"
],
"6996": [
"「누구냐니, 그건...」"
],
"6997": [
"「범인 아냐?」"
],
"6998": [
"「...넌 입 다물고 있어」"
],
"6999": [
"「왜 나고 씨가",
"사과해요」"
],
"7000": [
"「그치만...」"
],
"7001": [
"「그래, 우리가 지금 살아 있는 건",
"나고무 군 덕분일지도 모르잖아」"
],
"7002": [
"「여기 와서 뭔가 실수했나",
"본데, 네가 사과해 봤자",
"소용없잖냐」"
],
"7003": [
"「그래도, 저기...",
"대체 왜 시즈나 씨가...」"
],
"7004": [
"「왜보다",
"누가냐가 문제잖아」"
],
"7005": [
"「그건 그렇네요」"
],
"7006": [
"「누가, 언제, 어떻게.",
"애초에 어디로 방에",
"들어갔는지...」"
],
"7007": [
"「열쇠는 갖고 갔을 거 아냐.",
"그럼 베란다 아니겠어?」"
],
"7008": [
"「그러고 보니...",
"베란다 문에는 자물쇠가",
"없었어요」"
],
"7009": [
"「베란다에도 없어요?",
"창문에 없는 건 알았지만」"
],
"7010": [
"「그럼 거기로는 드나들기",
"자유였던 거네요」"
],
"7011": [
"「그 애, 언제 죽은 거야?",
"어젯밤인가?」"
],
"7012": [
"「어젯밤엔 나, 꽤 일찍",
"자 버렸거든」"
],
"7013": [
"「설마 시계가 울렸을 때도",
"자고 있었냐, 너」"
],
"7014": [
"「시계? 그게 뭔데?」"
],
"7015": [
"「속 편한 놈이구만...",
"그게 몇 시쯤이었지, 3시 넘었나」"
],
"7016": [
"「3시 넘었어요.",
"다시 맞춰 놔서 기억해요」"
],
"7017": [
"「시계 소리는 저도 들었어요.",
"시간은 안 봤지만...」"
],
"7018": [
"「꼬맹이, 넌?」"
],
"7019": [
"「저도 들었고...",
"히오리가 시계 고친 건",
"제가 증언할 수 있어요...」"
],
"7020": [
"「그런 게 갑자기 울리는 게",
"이상하잖아」"
],
"7021": [
"「뭔가 관계 있는 거 아냐?",
"아가씨가 죽은 거랑」"
],
"7022": [
"「...그렇네요...」"
],
"7023": [
"「그치만 무슨 관계가?」"
],
"7024": [
"「거기까진 모르지만",
"무관하진 않겠지」"
],
"7025": [
"「어쩌면",
"그때 돌아가신 건지도",
"모르겠네요...」"
],
"7026": [
"「그럴 가능성이 높겠지.",
"참고로 난 방에서 안 나갔어.",
"...당신은 어때?」"
],
"7027": [
"「저, 저도...",
"어젯밤엔 계속 방에 있었어요」"
],
"7028": [
"「...뭐, 그렇겠지.",
"알리바이 물어봐야 의미 없군」"
],
"7029": [
"「...그래서, 꼬맹이」"
],
"7030": [
"「네 추리대로라면",
"우린 여기까지 다 노려졌어.",
"어젯밤은 쌍둥이 아가씨고」"
],
"7031": [
"「그럼 안 노려진 건",
"이제 세 명뿐이잖아」"
],
"7032": [
"「어라? 세 명?",
"나고무 군도 들어가?」"
],
"7033": [
"「안 넣을 순 없잖냐.",
"여기 있는 이상」"
],
"7034": [
"「나고 씨는 우연히",
"길을 잃고 들어온 것뿐이잖아요」"
],
"7035": [
"「확인한 건 아니잖아.",
"길을 잃었다고 하는 건",
"본인뿐이잖냐」"
],
"7036": [
"「그, 그런, 그치만...」"
],
"7037": [
"「애초에, 듣기 싫은 말이지만",
"쌍둥이는 한 명 더 살아 있고요」"
],
"7038": [
"「...아, 그런가.",
"뺄 수는 없겠군」"
],
"7039": [
"「음, 그치만 우리도",
"살아 있는데」"
],
"7040": [
"「우린 한 번",
"노려졌잖냐?」"
],
"7041": [
"「...어, 그렇구나.",
"그럼 그래서 제외되는 거야?」"
],
"7042": [
"「뭐, 이론상으론 그렇죠」"
],
"7043": [
"「자, 잠깐 히오리!",
"내가 꼭 맞다는 보장은",
"없잖아!」"
],
"7044": [
"「실제로 실패했으니까!",
"지금까지 것도 정말 맞았는지",
"어떤지 모른다고!!」"
],
"7045": [
"「...흥.",
"결국 여기 있는 전원 혐의가",
"안 풀린 채라는 거냐」"
],
"7046": [
"「없는 사람도 있어요」"
],
"7047": [
"「누군데?」"
],
"7048": [
"「나구모 씨요」"
],
"7049": [
"「나구모 씨라면",
"걸어서 산을 내려간",
"거 아니었어?」"
],
"7050": [
"「내려가기 전에 애초에",
"오지도 않았는데요...」"
],
"7051": [
"「살았는지 죽었는지도",
"모르겠군, 그 녀석만큼은」"
],
"7052": [
"「꼬맹이가 진짜 나구모가 아니란",
"증거도 없단 말이지...」"
],
"7053": [
"「저 아니에요!",
"진짜 아니라니까요!!」"
],
"7054": [
"「나도 나구모 씨 아니야?」"
],
"7055": [
"「...그건 보면 알아」"
],
"7056": [
"「저기...",
"얘기가 별로 진전이 없는..」"
],
"7057": [
"「...언니 죽인 거, 누구야」"
],
"7058": [
"깜짝 놀라 문 쪽을 보니",
"눈빛이 이상한 스즈나가",
"비틀거리며 서 있었다."
],
"7059": [
"「...있잖아, 누구야?」"
],
"7060": [
"「스, 스즈나 씨...」"
],
"7061": [
"「누구냐고 묻잖아!?",
"누구냐고, 응!?」"
],
"7062": [
"「돌려줘, 언니!",
"응, 누가 죽였어!?」"
],
"7063": [
"「앗...!?」"
],
"7064": [
"갑자기 소리 지르던 스즈나가",
"닥치는 대로 우리를",
"때리기 시작했다."
],
"7065": [
"「스즈나 씨!",
"진정해요... 무리겠지」"
],
"7066": [
"「오, 옮기는 게 좋을까?」"
],
"7067": [
"「방에라도 처넣어!",
"진정할 때까지 위태로워서",
"못 봐주겠다」"
],
"7068": [
"「놔!",
"언니 돌려내!!」"
],
"7069": [
"「내, 내가 뺏은 거 아니야.",
"착하지, 날뛰지 마」"
],
"7070": [
"「싫어!!",
"언니 돌려내!!」"
],
"7071": [
"「언니이이...!!」"
],
"7072": [
"날뛰는 스즈나를 나스 씨가",
"둘러메고 방으로 데려갔다."
],
"7073": [
"「동정은 하지만 지금으로선",
"우리가 해 줄 수 있는 게",
"없잖아」"
],
"7074": [
"「..그, 그렇죠...」"
],
"7075": [
"어째서...",
"그런 일이..."
],
"7076": [
"(왜 시즈나가...?)"
],
"7077": [
"「...울지 마세요」"
],
"7078": [
"「...하여간.",
"너 혼자 전부 짊어지고 있는",
"것도 아니잖아」"
],
"7079": [
"「얘기가 안 되겠군.",
"나도 들어간다」"
],
"7080": [
"쿠라이시 씨도 나가고,",
"미사사기 씨는 멋쩍게 고개를 숙였다."
],
"7081": [
"「...어라?",
"뭔가 줄지 않았어?」"
],
"7082": [
"「방으로 돌아갔어요」"
],
"7083": [
"「그렇구나...",
"다들 어떻게 할 거야?」"
],
"7084": [
"「일단 해산하는 게",
"좋겠네요」"
],
"7085": [
"「다들 진정이 안 되는",
"것 같으니」"
],
"7086": [
"「으음...",
"그럼 나도 방에 있을게」"
],
"7087": [
"「...저도... 저기」"
],
"7088": [
"「아, 괜찮아요.",
"먼저 가세요」"
],
"7089": [
"「죄송해요...」"
],
"7090": [
"...결국 거실에는",
"나와 히오리만 남았다."
],
"7091": [
"걱정스레 봐 주는 건",
"미사사기 씨고..."
],
"7092": [
"...그게 다였다.",
"방에 있는 건 그게 다다."
],
"7093": [
"「...뭐, 누워 있을",
"기분도 아니겠지만요」"
],
"7094": [
"「어떻게 하면 좋죠.",
"이런...」"
],
"7095": [
"미사사기 씨는 당혹한 목소리로",
"두 손을 꼭 쥔다."
],
"7096": [
"「누... 누가 범인인 거죠?",
"이제 남은 사람은...」"
],
"7097": [
"「거의 없어요...」"
],
"7098": [
"「그래, 우리가 살아난 건",
"나고무 군 덕분일지도 모르잖아」"
],
"7099": [
"「모르겠네요.",
"왜인지도,",
"어떻게인지도」"
],
"7100": [
"「그렇지.",
"그 애들 열쇠 갖고 갔는데",
"어떻게 방에 들어갔을까」"
],
"7101": [
"「저, 저기...",
"베란다가 아닐까 싶어요」"
],
"7102": [
"「저희 방 베란다 문에는",
"자물쇠가 없으니까요...」"
],
"7103": [
"「언제였을까요?",
"시즈나 씨가 죽은 건」"
],
"7104": [
"「저기... 어젯밤 갑자기...",
"시계가 울린 건 뭔가...」"
],
"7105": [
"「그게 잘 모르겠어요.",
"뭘 위해 울린 건지」"
],
"7106": [
"「그래도 사건이랑 아무 관계도",
"없다는 건...」"
],
"7107": [
"「그건 없겠죠.",
"의미 없이 울릴 리가 없고」"
],
"7108": [
"「나스 씨, 그 소리가 울리는데도",
"자고 있었어요...?」"
],
"7109": [
"「난 한번 잠들면",
"안 깨거든」"
],
"7110": [
"「그 뒤로 안 울렸는데",
"멈춰 주신 건...」"
],
"7111": [
"「저예요」"
],
"7112": [
"「그, 그래요.",
"그건 제가 증언할 수 있어요」"
],
"7113": [
"「그렇다고 알리바이는",
"안 되지만요」"
],
"7114": [
"「...그렇지...」"
],
"7115": [
"「저, 저는...",
"어젯밤 계속 방에 있었어요」"
],
"7116": [
"「나도 어젯밤엔 꽤",
"일찍 자 버렸거든」"
],
"7117": [
"「...없네.",
"알리바이 있는 사람은」"
],
"7118": [
"「없네요.",
"나구모 씨까지 포함해서」"
],
"7119": [
"「그 사람은 살았는지 죽었는지",
"조차 모르니까요」"
],
"7120": [
"「그.. 그렇지...",
"그럼...」"
],
"7121": [
"「옮기는 게 좋을까?",
"방으로...」"
],
"7122": [
"「재우는 게 좋겠어요...」"
],
"7123": [
"「일단 해산하는 게",
"좋겠네요...」"
],
"7124": [
"미사사기 씨는 손으로 눈가를",
"누르며 거실을 뛰쳐나갔다."
],
"7125": [
"「그렇구나...",
"그럼 나도 방에 있을게」"
],
"7126": [
"떨어져 있던 사람들이",
"이쪽을 본다."
],
"7127": [
"그게 다였다.",
"처음 여기서 눈떴을 때에 비하면",
"이렇게나 적다니..."
],
"7128": [
"「어... 어떻게 하면",
"좋을까요...?」"
],
"7129": [
"「어떻고 자시고가 어딨어.",
"누가 한 짓이야, 그건?」"
],
"7130": [
"「언제 죽은 거야?",
"어젯밤인가?」"
],
"7131": [
"「그건 확실하겠죠.",
"저녁 먹을 때까진 살아 있었으니」"
],
"7132": [
"「왜, 시계가 울렸었지.",
"그게 몇 시쯤이었지, 3시 넘었나」"
],
"7133": [
"「그 뒤로 안 울린 건",
"누가 멈춰 주신 건가요...?」"
],
"7134": [
"「아, 아마...」"
],
"7135": [
"「어쩌면",
"그때 돌아가신 건지도",
"모르겠네요」"
],
"7136": [
"「그럴 가능성이 높겠지.",
"난 계속 방에 있었는데",
"당신은 어때?」"
],
"7137": [
"「만약 네 추리대로라면",
"우린 여기까지 다 노려졌어.",
"어젯밤은 쌍둥이 아가씨고」"
],
"7138": [
"「그럼 안 노려진 건",
"이제 세 명뿐이잖아」"
],
"7139": [
"「...아니, 쌍둥이 한쪽을",
"넣으면 네 명인가...」"
],
"7140": [
"「누구야」"
],
"7141": [
"「나구모인가...",
"살았는지 죽었는지도",
"모르겠군, 그 녀석만큼은」"
],
"7142": [
"「꼬맹이가 진짜 나구모가 아니란",
"증거도 없단 말이지..」"
],
"7143": [
"「저, 전 아니에요!",
"진짜 아니에요!」"
],
"7144": [
"「쳇...",
"얘기가 도무지 진전이 없네...」"
],
"7145": [
"「할 수 없지...",
"이 녀석 방에 처넣고",
"난 그대로 방에 간다!」"
],
"7146": [
"날뛰는 스즈나를 쿠라이시 씨가",
"둘러메고 방으로 데려갔다."
],
"7147": [
"어째서...",
"왜 이런 일이..."
],
"7148": [
"누가 시즈나한테",
"그런 끔찍한 짓을..."
],
"7149": [
"「일단 해산하는 게",
"좋겠네요」"
],
"7150": [
"걱정스레 다가와 준 건",
"미사사기 씨다."
],
"7151": [
"그 밖에는... 아무도 없다."
],
"7152": [
"(처음 여기서 눈떴을 때는",
"그렇게 많았는데...)"
],
"7153": [
"나스 씨도, 츠바키 군도...",
"다들 없어져 버렸어."
],
"7154": [
"(미사사기 씨...)"
],
"7155": [
"우리를 의심하는 걸까...?",
"하긴, 이제 살아 있는 사람이",
"거의 안 남았으니 무리도 아니지."
],
"7156": [
"「할 수 없죠,",
"방으로 데려갑시다」"
],
"7157": [
"「네, 네!",
"날뛰지 마요, 스즈나 씨...」"
],
"7158": [
"「싫어!",
"언니 돌려줘!!」"
],
"7159": [
"몸이 움직이지 않았다.",
"눈앞의 일이 도무지 현실로",
"느껴지지 않았다."
],
"7160": [
"「나고 씨, 됐으니까 앉아요.",
"거기서 기다리고 있어요!」"
],
"7161": [
"「어... 아, 응」"
],
"7162": [
"히오리의 말에",
"털썩 주저앉는다."
],
"7163": [
"이게 다 뭘까...",
"이젠 어디까지가 진짜인지조차",
"잘 모르겠다..."
],
"7164": [
"「......나고 씨?」"
],
"7165": [
"「아이 참...",
"또 울고 있네...」"
],
"7166": [
"「......어」"
],
"7167": [
"정신을 차려 보니",
"히오리가 돌아와 있었다."
],
"7168": [
"「미사사기 씨는...?」"
],
"7169": [
"「속이 안 좋다면서",
"방으로 돌아갔어요」"
],
"7170": [
"「그렇구나...」"
],
"7171": [
"일단 어디로 갈까..?"
],
"7172": [
"「아, 벌써 시간이 이렇게..」"
],
"7173": [
"「...비가... 꽤 약해졌어」"
],
"7174": [
"오락실 창을 때리는 빗방울은",
"물이라기보다 안개 같았다."
],
"7175": [
"「야, 드디어 그칠 것 같네요」"
],
"7176": [
"바로 뒤로 다가온 히오리가",
"얼굴을 활짝 편다."
],
"7177": [
"「응.",
"이대로 개면 좋겠다」"
],
"7178": [
"「그러게요.",
"이걸로 길만 안 무너졌으면..」"
],
"7179": [
"산사태 탓에, 원래라면",
"내일 오기로 했던 마중이",
"제때 올 수 있을지..."
],
"7180": [
"적어도 누군가의 소속사 사람이",
"산 위에 사람들이 고립됐다고",
"경찰에라도 알렸으면 좋겠는데..."
],
"7181": [
"「복구 작업, 어떨까...」"
],
"7182": [
"잘 안 들리는 라디오를 켜 본다."
],
"7183": [
"겨우 알아들을 만한 뉴스를 잡아",
"귀를 기울이고 있으니..."
],
"7184": [
"「...복구 작업은 하고",
"있나 보네요...」"
],
"7185": [
"「정말이다...",
"드디어 작업을 할 수",
"있게 됐구나...」"
],
"7186": [
"「아, 날씨도 회복되고",
"있대!」"
],
"7187": [
"「아무래도 그쳐 줄 것 같네요.",
"이러면 머잖아 복구되려나」"
],
"7188": [
"「응, 다행이다...」"
],
"7189": [
"오랜만의 좋은 소식이었다.",
"비 그치는 게 이렇게 기쁘다니,",
"초등학교 소풍 전날 이후 처음일지도."
],
"7190": [
"「자, 밥이나 해 볼까요」"
],
"7191": [
"「그러자, 배 좀 고프다」"
],
"7192": [
"「그거 다행이네요.",
"그럼 대충 뭐 좀 만들죠」"
],
"7193": [
"「파스타가 있었는데",
"그걸로 괜찮을까요」"
],
"7194": [
"「아, 아니.",
"겸사겸사 다른 얘기도 들었고」"
],
"7195": [
"「그럼 밥이나 해 볼까요」"
],
"7196": [
"「괜찮아?",
"무리 안 해도...」"
],
"7197": [
"「이제 괜찮아요.",
"게다가 뭐라도 하는 게",
"마음이 편하니까요」"
],
"7198": [
"「...그렇구나」"
],
"7199": [
"그런 건지도 모른다.",
"내가 이리저리 돌아다니는 것도",
"분명 같은 이유일 테니까..."
],
"7200": [
"「...비, 꽤 약해졌네」"
],
"7201": [
"우드데크로 나가는 유리문 곁으로",
"가서 밖을 보니, 비는 이미",
"안개처럼 가늘어져 있었다."
],
"7202": [
"「드디어 그칠 것 같아",
"보이잖아요」"
],
"7203": [
"「응, 다행이다.",
"저게 효과 있었나」"
],
"7204": [
"매달린 채로 있는",
"테루테루보즈를 가리킨다."
],
"7205": [
"시간은 걸렸지만 효과가 있었던",
"건지도 모른다."
],
"7206": [
"「그럴지도 모르겠네요.",
"남은 건 산사태인가...」"
],
"7207": [
"비가 그쳐도 길이 막힌",
"채로는 지나갈 수 없다."
],
"7208": [
"「그래도 비가 그치면",
"복구 작업은 할 수 있잖아」"
],
"7209": [
"「그렇죠.",
"내일까지는 그치려나요」"
],
"7210": [
"분명 이대로 개어 줄 거야.",
"그렇게 믿을 수밖에 없다..."
],
"7211": [
"거실에 들어가 우드데크 쪽으로",
"다가가 본다."
],
"7212": [
"「비가 많이 약해졌어...」"
],
"7213": [
"쉴 새 없이 유리창을 타고 흐르던",
"물줄기는 끊기고, 안개를 뿜은",
"듯한 무늬로 바뀌어 있었다."
],
"7214": [
"「곧 그쳐 줄 것 같네요」"
],
"7215": [
"처마 밑에서는 나스 씨의",
"테루테루보즈가 흔들리고 있었다."
],
"7216": [
"(드디어 효과가 있었나...)"
],
"7217": [
"만든 사람만큼이나 느긋한",
"녀석이었는지도 모른다."
],
"7218": [
"「남은 건 산사태 쪽이네요」"
],
"7219": [
"「그래도 비만 그치면",
"복구 작업은 할 수",
"있게 될 테니까」"
],
"7220": [
"「그렇겠죠.",
"뭐, 이 정도면 비 쪽은",
"이제 걱정 없을 것 같지만요」"
],
"7221": [
"「왜 그래요?",
"뭔가 석연치 않은",
"얼굴인데요」"
],
"7222": [
"「음...",
"뭔가 잊은 것 같은",
"기분이... 아, 맞다!」"
],
"7223": [
"「우물 있잖아,",
"온실 근처에」"
],
"7224": [
"「네, 그게 왜요?」"
],
"7225": [
"「그거 지금은 안 쓰는",
"거지?」"
],
"7226": [
"「안 썼을 거예요,",
"뚜껑도 닫혀 있잖아요」"
],
"7227": [
"「그런데 틈이 벌어져 있어서.",
"안에 뭐가 떨어져 있는 것 같았어」"
],
"7228": [
"「어두워서 잘 안 보였는데",
"꽤 큰... 나뭇잎 같은 건",
"아니었던 것 같아」"
],
"7229": [
"「호오...?",
"잠깐 보러 가 볼까요」"
],
"7230": [
"「엥? 지금?」"
],
"7231": [
"「그치만 궁금하잖아요」"
],
"7232": [
"「그야 궁금하긴 한데」"
],
"7233": [
"「그렇죠?",
"그럼 가죠」"
],
"7234": [
"그렇게 말하며 히오리는 당연하다는",
"듯이 내 팔을 잡아끈다."
],
"7235": [
"「왜 나까지!?」"
],
"7236": [
"「말 꺼낸 건 나고 씨",
"잖아요」"
],
"7237": [
"「그건 그렇지만!",
"아니 난 딱히 그렇게까지는」"
],
"7238": [
