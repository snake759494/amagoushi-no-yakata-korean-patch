 ],
 "18087": [
  "「아, 으, 응」"
 ],
 "18088": [
  "「...역시, 됐어」"
 ],
 "18089": [
  "대체 뭘까...?"
 ],
 "18090": [
  "괜찮아"
 ],
 "18091": [
  "너도 가늘잖아"
 ],
 "18092": [
  "자주 들어"
 ],
 "18093": [
  "읽어 본다"
 ],
 "18094": [
  "연기해 본다"
 ],
 "18095": [
  "역시 무리"
 ],
 "18096": [
  "안 기뻐"
 ],
 "18097": [
  "좀 기뻐"
 ],
 "18098": [
  "익숙해"
 ],
 "18099": [
  "「음, 스즈나?」"
 ],
 "18100": [
  "대본을 들고 서성이던",
  "스즈나는 내 목소리에 빙글",
  "돌아봐 주었다."
 ],
 "18101": [
  "「아, 오빠구나.",
