 ],
 "18043": [
  "「...그... 그렇구나」"
 ],
 "18044": [
  "「울지 마」"
 ],
 "18045": [
  "「어, 아니, 안 울어」"
 ],
 "18046": [
  "「나, 화난 거 아니야」"
 ],
 "18047": [
  "「괴롭히긴 하지만」"
 ],
 "18048": [
  "「오빠」"
 ],
 "18049": [
  "「정말로 기모노 씨가",
  "범인이 아니라고 생각하면",
  "추리를 다시 하는 게 좋아」"
 ],
 "18050": [
  "「안 그러면, 나 말고도",
  "기모노 씨는 점점 다른 사람한테",
  "의심만 받게 될 거야」"
 ],
 "18051": [
  "「...나 말고, 라는 건",
  "시즈나는 아직 의심하는 거야」"
 ],
 "18052": [
  "「응.",
  "기모노 씨만은 아니지만」"
 ],
 "18053": [
  "「...히오리는...",
  "히오리는 범인이 아니야...」"
 ],
 "18054": [
  "「그건 치사해」"
 ],
 "18055": [
  "「오빠는, 내가 위험하다고",
