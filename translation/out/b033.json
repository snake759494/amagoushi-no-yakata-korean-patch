 ],
 "18129": [
  "「...저기,",
  "설마, 그걸...」"
 ],
 "18130": [
  "「나구모 씨 역 해 줘」"
 ],
 "18131": [
  "「에에에에에!?」"
 ],
 "18132": [
  "「나, 난 연기 같은 거",
