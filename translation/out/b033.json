 ],
 "18115": [
  "「...그, 그런가...」"
 ],
 "18116": [
  "「좋잖아, 인기 많지?」"
 ],
 "18117": [
  "「뭐!?",
  "설마, 전혀 그렇지 않아」"
 ],
 "18118": [
  "「아니, 그럴 리 없어.",
  "오빠 분명, 자각 못 할 뿐이야」"
 ],
 "18119": [
  "「그치만 짚이는 데가 없는걸?」"
 ],
 "18120": [
  "「주변에, 툭하면 금방",
