 ],
 "18104": [
  "「아하하, 괜찮아.",
  "보기보단 끈질기거든」"
 ],
 "18105": [
  "「아, 왠지 알 것 같아」"
 ],
 "18106": [
  "「알 것 같다니?」"
 ],
 "18107": [
  "「괜히 험한 꼴은 다 당하는데,",
