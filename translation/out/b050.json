 "25117": [
  "「저기 있잖아, 낮에 말했지?",
  "시즈나 짱이 위험하다고...」"
 ],
 "25118": [
  "「아니, 응이라니」"
 ],
 "25119": [
  "「언니가 위험하다는 거,",
  "확실한 거야?」"
 ],
 "25120": [
  "「이게 증거다, 라고 할 순",
  "없지만...」"
 ],
 "25121": [
  "「나는 노려지는 게 시즈나 짱",
  "이라고 생각해」"
 ],
 "25122": [
  "「그렇게 말해도...",
  "그럼, 어떻게 하면 되는데?」"
 ],
 "25123": [
  "「일단, 안 자고 깨어 있는",
  "게 좋다는 거야?」"
 ],
 "25124": [
  "「....안 자」"
 ],
 "25125": [
  "「응, 그게 좋겠어.",
  "그렇다면...」"
 ],
 "25126": [
  "「저번엔, 틀렸어」"
 ],
 "25127": [
  "「아, 그, 그렇긴 한데」"
 ],
 "25128": [
  "「저번 게 틀렸다는 건",
  "뭔가 근본적으로 착각하고 있는",
  "거 아니야?」"
 ],
 "25129": [
  "「아니, 그걸 다시 생각해",
  "봤으니까 이번에야말로...」"
 ],
 "25130": [
  "「이번에야말로, 라...」"
 ],
 "25131": [
  "꽤나 신용을 못 얻고 있다...",
  "당연한가, 한 번 틀렸으니",
  "말이야..."
 ],
 "25132": [
  "「아, 가자.",
  "그럼 잘 자, 오빠」"
 ],
 "25133": [
  "거의 상대도 안 해 줬다.",
  "당연하다지만 괴롭다..."
 ],
 "25134": [
  "「어라? 나고 씨,",
  "아직 거기 계셨습니까?」"
 ],
 "25135": [
  "「어? 아, 히오리」"
 ],
 "25136": [
  "「무슨 일 있으십니까?",
  "어려운 얼굴을 하시고」"
 ],
 "25137": [
  "「아니, 아무것도...",
  "잠깐 생각 좀 하고 있었을 뿐」"
 ],
 "25138": [
  "「굳이 복도에서 하실 건",
  "없잖습니까...」"
 ],
 "25139": [
  "「너무 깊이 생각하지 마시고",
  "제대로 쉬세요」"
 ],
 "25140": [
  "「으, 응.",
  "알고 있어...」"
 ],
 "25141": [
  "미련이 남는 기분인 채로",
  "일단 방으로 돌아간다."
 ],
 "25142": [
  "「응... 잘 자」"
 ],
 "25143": [
  "...일단 침대에 눕긴",
  "했지만."
 ],
 "25144": [
  "(역시, 이대로는",
  "위험하겠지...)"
 ],
 "25145": [
  "「...또?」"
 ],
 "25146": [
  "「또, 또라니...",
  "분명 저번엔 틀렸지만,",
  "이번에야말로 정말로...」"
 ],
 "25147": [
  "「자신 없어 보여」"
 ],
 "25148": [
  "「뭐야, 진짜 자신 없는 거야?",
  "그렇게 중요한 일인데」"
 ],
 "25149": [
  "「응, 이제 자자.",
  "그럼, 잘 자」"
 ],
 "25150": [
  "쌍둥이는 그렇게 말하고 방으로",
  "돌아갔다."
 ],
 "25151": [
  "(그렇겠지...)"
 ],
 "25152": [
  "(한 번 크게 틀렸으니",
  "믿을 수가 없겠지...)"
 ],
 "25153": [
  "「어라, 나고 씨?",
  "아직 거기 계셨습니까」"
 ],
 "25154": [
  "「생각하시는 건 좋지만,",
  "복도 한가운데는 아니잖습니까」"
 ],
 "25155": [
  "「으, 응, 이제 돌아갈게」"
 ],
 "25156": [
  "「그럼 됐습니다만.",
  "쉬셔야 합니다?」"
 ],
 "25157": [
  "「응...",
  "오늘은 이제 잘게」"
 ],
 "25158": [
  "일단 히오리와 함께 방으로 돌아간다."
 ],
 "25159": [
  "「그럼, 안녕히 주무세요」"
 ],
 "25160": [
  "침대에 누우니, 피곤한 데다",
  "고민까지 겹쳐 몸이 이제 좀 쉬라고",
  "비명을 지르는 게 느껴졌다."
 ],
 "25161": [
  "그래도 역시 신경이 쓰여서,",
  "어떻게든 내 추리를 다시 한 번",
  "되새기려 하고 만다."
 ],
 "25162": [
  "(...정말로,",
  "모르겠게 됐어...)"
 ],
 "25163": [
  "이번에야말로 쌍둥이가 위험하다고",
  "생각했는데, 아닐지도..."
 ],
 "25164": [
  "(...안 되겠다, 자신 없어)"
 ],
 "25165": [
  "오늘은 이제 틀렸다...",
  "뭘 생각해도, 머리가 제대로",
  "돌아갈 것 같지 않다."
 ],
 "25166": [
  "쉬는 게 좋겠다.",
  "안 그러면, 변변한 생각이 떠오르지",
  "않는다..."
 ],
 "25167": [
  "(한번 자고,",
  "머리를 맑게 하자...)"
 ],
 "25168": [
  "침대에 누워, 아무 생각도 안 하도록",
  "눈을 감는다."
 ],
 "25169": [
  "(...생각하면 안 돼)"
 ],
 "25170": [
  "(아무 생각 말고, 아침까지...)"
 ],
 "25171": [
  "「...몇 번째더라」"
 ],
 "25172": [
  "「어, 어어, 그건...」"
 ],
 "25173": [
  "「이제 아웃」"
 ],
 "25174": [
  "「아, 아웃?」"
 ],
 "25175": [
  "「못 믿겠다는 거야.",
  "너무 많이 틀렸잖아, 아무리 그래도」"
 ],
 "25176": [
  "「반성해」"
 ],
 "25177": [
  "「아, 기다려, 언니」"
 ],
 "25178": [
  "시즈나 짱네는 냉큼",
  "가 버렸다."
 ],
 "25179": [
  "「...어라?",
  "나고 씨 뭐 하십니까?」"
 ],
 "25180": [
  "「뭡니까, 그 울 것 같은 얼굴은.",
  "누구한테 괴롭힘이라도 당하셨습니까?」"
 ],
 "25181": [
  "「아, 아니, 그런",
  "건 아니고...」"
 ]
}