"5756": [
"완전히 잠이 깨 버렸다.",
"어쩔 수 없으니 이대로",
"일어나기로 할까."
],
"5757": [
"(...그나저나...)"
],
"5758": [
"신칸센은 대체 뭐였을까...."
],
"5759": [
"방에 돌아와서 벗은 겉옷을",
"던져 두고 침대로 파고든다."
],
"5760": [
"(아... 겉옷, 바닥에 떨어졌다...)"
],
"5761": [
"침대 끝에 둔다는 게,",
"미끄러져 바닥에 떨어졌다."
],
"5762": [
"「네네, 주워 드릴 테니까",
"주무세요」"
],
"5763": [
"「어... 아, 히오리...」"
],
"5764": [
"「수고 많으셨어요.",
"안녕히 주무세요, 나고 씨」"
],
"5765": [
"「잘 자....」"
],
"5766": [
"(또 천둥....?)"
],
"5767": [
"눈을 비비며 고개를 돌려",
"시계 쪽을 본다."
],
"5768": [
"「.....으악」"
],
"5769": [
"점심이 문제가 아니다.",
"완전히 푹 자 버린 모양이다."
],
"5770": [
"겸사겸사 창문 쪽도 봤지만,",
"번개는 보이지 않았다."
],
"5771": [
"(멀리서 쳤나, 천둥은...)"
],
"5772": [
"덕분에 잠이 깼지만,",
"오히려 잘됐는지도."
],
"5773": [
"더 자다간 밤이 될 것 같다.",
"얼른 일어나자."
],
"5774": [
"(어디 보자, 겉옷... 아, 있다)"
],
"5775": [
"침대 발치에 개어져 있던",
"겉옷을 걸친다."
],
"5776": [
"자기 전에 히오리랑 뭔가",
"얘기한 것 같기도 한데."
],
"5777": [
"(잘 기억이 안 나...)"
],
"5778": [
"(어디 보자...)"
],
"5779": [
"(...벌써 라디오에서",
"뉴스 하려나...)"
],
"5780": [
"「...아, 슬슬",
"언니한테 전화해야겠다」"
],
"5781": [
"「벌써 시간도 됐으니,",
"저녁 어떻게 할지 물어봐야지」"
],
"5782": [
"「우와, 정말이네.",
"벌써 그런 시간인가」"
],
"5783": [
"「그럼, 실례했어.",
"나도 1층에 내려가 볼게」"
],
"5784": [
"「응, 그럼 안녕」"
],
"5785": [
"오락실로 가자...."
],
"5786": [
"「저기, 벌써 해 지고 있어.",
"이제 됐지?」"
],
"5787": [
"「아, 미안.",
"그럼..」"
],
"5788": [
"(오락실에서 라디오",
"들어 보자...)"
],
"5789": [
"「...슬슬일지도」"
],
"5790": [
"절묘한 타이밍에 전화가 울리고,",
"시즈나가 받으러 간다."
],
"5791": [
"「...스즈?」"
],
"5792": [
"「응... 응, 먹을래.",
"...응, 괜찮아....」"
],
"5793": [
"(스즈나한테서 온 건가...)"
],
"5794": [
"그러고 보니 슬슬 저녁때다.",
"오락실로 가는 게 좋겠지."
],
"5795": [
"전화를 끊은 시즈나가",
"이쪽으로 돌아온다."
],
"5796": [
"「벌써 1층에 내려가?」"
],
"5797": [
"「스즈가 오면」"
],
"5798": [
"「그렇구나, 그럼 나 먼저",
"오락실 가서 뉴스 듣고 있을게」"
],
"5799": [
"팔랑팔랑 손을 흔드는 시즈나의",
"배웅을 받으며 방을 나선다."
],
"5800": [
"(일단",
"오락실이다...)"
],
"5801": [
"갑자기 전화가 울리기 시작하자,",
"시즈나는 말없이 그쪽으로 간다."
],
"5802": [
"「응... 응, 알았어」"
],
"5803": [
"수화기를 들고 통화하면서,",
"팔랑팔랑 내게 손을 흔들었다.",
"아마 돌아가라는 뜻이겠지."
],
"5804": [
"「아, 응.",
"또 봐...」"
],
"5805": [
"그러고 보니 슬슬 저녁때인가.",
"오락실로 가자...."
],
"5806": [
"「...아, 저기 이치야나기 씨.",
"슬슬 라디오에서 뉴스가",
"시작하지 않아요?」"
],
"5807": [
"「아, 정말이네요.",
"그럼 저 들으러 갈게요」"
],
"5808": [
"「미사사기 씨는...」"
],
"5809": [
"「미안해요, 저는...」"
],
"5810": [
"「아뇨, 괜찮아요.",
"그럼 무슨 일 있으면 알릴게요」"
],
"5811": [
"「네, 고마워요」"
],
"5812": [
"(...역시 이제",
"방에서 나가는 게 무섭나...)"
],
"5813": [
"방에 들여서 얘기하게 해 주는",
"만큼은 나를 믿어 주는 건지도",
"모르지만...."
],
"5814": [
"「...이제 됐을까요?",
"몸이 좀 안 좋아서...」"
],
"5815": [
"「아, 네.",
"죄송했습니다」"
],
"5816": [
"「그럼...」"
],
"5817": [
"방을 나와 시계를 보니,",
"벌써 뉴스 시작할 시간이었다.",
"오락실로 가자."
],
"5818": [
"「...이런, 시간 됐다 꼬마」"
],
"5819": [
"「네? 아, 뉴스 말이죠」"
],
"5820": [
"「그래, 날씨가 좋아질 것 같다든가",
"길이 복구될 것 같다든가, 뭔가",
"좋은 얘기 있으면 알려 줘라」"
],
"5821": [
"「네, 알겠습니다.",
"그럼...」"
],
"5822": [
"(...정말로 좋은 뉴스를",
"들을 수 있으면 좋겠는데...)"
],
"5823": [
"일단 오락실로 가야지."
],
"5824": [
"「...아~, 왠지 배고프다",
"했더니 벌써 저녁이네」"
],
"5825": [
"「우와, 정말이다.",
"슬슬 오락실에 가 볼까」"
],
"5826": [
"「거기 라디오는 어때?",
"내 건 거의 안 들려」"
],
"5827": [
"「여전히 잡음은 심한데",
"못 알아들을 정도는 아냐」"
],
"5828": [
"「그렇구나, 그럼 뭔가 있으면",
"바로 알려 줘」"
],
"5829": [
"「응, 알았어.",
"그럼, 실례했어」"
],
"5830": [
"「네~, 언제든 오세요」"
],
"5831": [
"「...이제 되셨습니까.",
"슬슬 해도 지는데요」"
],
"5832": [
"「아, 응.",
"미안, 실례했어」"
],
"5833": [
"츠바키 군은 말없이 인사하고",
"문을 닫았다."
],
"5834": [
"(이 시간이면 이제",
"라디오 들으러 가는 게 좋겠다)"
],
"5835": [
"「그러고 보니 나고무 군,",
"근력 운동 언제부터 할 거야?」"
],
"5836": [
"「네!?」"
],
"5837": [
"「더 단련하겠다고",
"했었잖아」"
],
"5838": [
"「어, 저기, 그건」"
],
"5839": [
"...그랬던가.",
"좀 더 단련하는 게 좋겠다는",
"생각은 하고 있지만."
],
"5840": [
"혹시 나스 씨 방에서",
"뻗었을 때라도",
"뭔가 지껄였나, 내가."
],
"5841": [
"「언제든 가르쳐 줄게.",
"뭣하면 지금 할래?」"
],
"5842": [
"「아, 아뇨!",
"저, 지금은, 그게... 맞다,",
"뉴스 들으러 가야 해서!」"
],
"5843": [
"「아, 벌써 그런 시간인가.",
"날씨가 좋아지면 좋겠네」"
],
"5844": [
"「그, 그러네요.",
"좋아질 것 같으면 또",
"연락드릴게요...」"
],
"5845": [
"「응, 부탁해.",
"그럼 또 봐」"
],
"5846": [
"「네! 실례했습니다!」"
],
"5847": [
"...큰일 날 뻔했다."
],
"5848": [
"그래도 정말 이제 오락실에",
"가는 게 좋을 시간이다."
],
"5849": [
"「...음, 이제 됐을까.",
"스쿼트 하던 중이었거든」"
],
"5850": [
"「아, 네, 죄송해요.",
"실례했습니다」"
],
"5851": [
"「응, 그럼 또 봐」"
],
"5852": [
"...방에 있는 내내",
"트레이닝하고 있는 걸까."
],
"5853": [
"할 일이 있는 편이 지금 상황에선",
"마음은 편할 것 같지만."
],
"5854": [
"(아, 벌써 이런 시간인가.",
"오락실에 가자...)"
],
"5855": [
"「...좀 어둑하네요.",
"해가 지기 시작했나 봐요」"
],
"5856": [
"「그러네,",
"이제 뉴스 시작할 시간이니",
"오락실 갈까」"
],
"5857": [
"「먼저 가 계세요.",
"이 책 정리하고 금방 갈게요」"
],
"5858": [
"오락실에 오자마자 라디오를",
"켜고 뉴스를 기다린다."
],
"5859": [
"곧 시작됐지만, 처음에는",
"국회가 어떻다는 둥 지금은 솔직히",
"아무래도 좋은 얘기가 이어졌다."
],
"5860": [
"(오늘은 그나마 낫네...)"
],
"5861": [
"그래도 소리만큼은 평소만큼",
"심한 잡음 없이 그럭저럭 들린다."
],
"5862": [
"그렇다고 해서 기쁜 소식까지",
"들려오느냐 하면,",
"전혀 그렇지 않았다...."
],
"5863": [
"「...안 되나...」"
],
"5864": [
"한숨을 쉬고 있으니 다른 사람들이",
"방에 들어왔지만, 내 모습을 보고",
"하나같이 체념한 표정이 된다."
],
"5865": [
"「...안 되는 거야」"
],
"5866": [
"「응....",
"이 날씨로 무너진 길도 아직",
"복구 안 된 것 같아」"
],
"5867": [
"「언제 그치려나, 이거.",
"이제 좀 그만했으면 좋겠어」"
],
"5868": [
"「이렇게 긴 비면, 여기저기서",
"큰일이 났을 텐데",
"말이죠」"
],
"5869": [
"「그렇겠지...」"
],
"5870": [
"그러고 보니 원래 아르바이트하러",
"갈 예정이던 펜션도, 이 날씨면",
"엄청 한가했을지도."
],
"5871": [
"지금 상황이랑 어느 쪽이 낫냐고",
"물으면, 당연히 한가한 쪽이",
"낫겠지만."
],
"5872": [
"「....왜 그래?」"
],
"5873": [
"「심심해」"
],
"5874": [
"열릴 기미가 없는 문을 보며",
"시즈나가 중얼거린다."
],
"5875": [
"「만담하는 사람들이",
"없으니까」"
],
"5876": [
"「아아...」"
],
"5877": [
"(나스 씨랑 츠바키 군",
"얘기인가...)"
],
"5878": [
"확실히 있기만 해도 떠들썩한",
"사람이 없다는 건,",
"그것만으로 쓸쓸하다...."
],
"5879": [
"「어쩔 수 없잖아.",
"이런 상황이고, 돌아다니는 것도",
"무섭고...」"
],
"5880": [
"「오빠도 무서워?」"
],
"5881": [
"「뭐!?",
"무, 무섭지, 당연히!」"
],
"5882": [
"「그렇게 힘주어 말 안 해도」"
],
"5883": [
"「그치만 무섭잖아!",
"스즈나네는 안 무서워?」"
],
"5884": [
"「그야 무섭지만...",
"우리는 늘 둘이 같이 있으니까,",
"방에서 나오는 정도는...」"
],
"5885": [
"「한쪽이 범인만 아니면 괜찮아」"
],
"5886": [
"「언니!",
"내가 범인일 리가 없잖아!」"
],
"5887": [
"「알아」"
],
"5888": [
"「...근데, 나밖에 모르니까」"
],
"5889": [
"「그야 그렇죠, 다들",
"마찬가지일 거예요」"
],
"5890": [
"「히오리...」"
],
"5891": [
"「우리도 서로 범인이 아니라고",
"생각하는 건 우리뿐일 테니까요」"
],
"5892": [
"「왜 그렇게 생각하는데?」"
],
"5893": [
"「우리 말입니까?",
"마다라이 씨가 돌아가신 밤에",
"같이 있었거든요」"
],
"5894": [
"「계속?」"
],
"5895": [
"「응, 계속 같이 있었어.",
"마다라이 씨가 살해당한",
"한밤중엔 이미 방에...」"
],
"5896": [
"「마다라이 씨가 한밤중에 죽은 건",
"어떻게 알았더라?」"
],
"5897": [
"「그건...」"
],
"5898": [
"「어젯밤이야?",
"오늘 새벽 같은 게 아니고?」"
],
"5899": [
"「...히오리가...」"
],
"5900": [
"「뭐, 제가 사실을 말하는지",
"여기선 확인할 수 없죠.",
"의심하려면 얼마든지 의심해요」"
],
"5901": [
"「그런데도 오빠는 지금까지",
"전혀 의심 안 했던 거네」"
],
"5902": [
"「어, 아, 그치만, 저기,",
"봐, 시즈나도 그때",
"히오리는 거짓말 안 한다고」"
],
"5903": [
"「거봐요, 좋은 사람이죠?」"
],
"5904": [
"「뭐야!",
"왜 웃는 건데, 둘 다!」"
],
"5905": [
"「오빠는 말이야」"
],
"5906": [
"「이름 그대로인 사람이네」"
],
"5907": [
"「...무슨 뜻이야?」"
],
"5908": [
"「있어 주면 마음이 놓인다고요.",
"엄청나게 평범한 사람이라서」"
],
"5909": [
"「칭찬하는 거야...?」"
],
"5910": [
"「물론 그렇죠」"
],
"5911": [
"그럼 왜 그런 희귀한 생물을",
"보는 듯한 얼굴인 걸까...."
],
"5912": [
"훗 하고 그렇게 말하고,",
"시즈나는 문으로 향했다."
],
"5913": [
"「그냥 그렇게 생각할 수",
"있었으면 좋았을 텐데...」"
],
"5914": [
"잠시 망설이다가,",
"스즈나는 결국 아무 말 없이",
"고개를 숙이고 언니를 따라갔다."
],
"5915": [
"「방금 그거, 무슨 뜻일까.",
"그냥 생각할 수 있었으면...」"
],
"5916": [
"「하는 말을 순순히 믿을 수",
"있으면 좋겠다는 뜻이겠죠」"
],
"5917": [
"「어쩔 수 없어요.",
"아까도 말했듯이...」"
],
"5918": [
"「거짓말 안 한다고 믿을 수 있는 건",
"서로 계속 같이 있었던",
"상대뿐이니까요」"
],
"5919": [
"「....그렇구나」"
],
"5920": [
"나 역시 쌍둥이가 범인이 아니라고",
"단언할 만한 확신은",
"아직 아무것도 없으니까...."
],
"5921": [
"「배고프세요?」"
],
"5922": [
"「응? 아니, 아직...」"
],
"5923": [
"「그럼 조금 더 기다렸다가",
"만들러 갈까요」"
],
"5924": [
"지금 바로 부엌에 가면,",
"또 얼굴을 마주치게 된다."
],
"5925": [
"그건 왠지",
"어색할 것 같았다."
],
"5926": [
"(....이상해)"
],
"5927": [
"어째서 이런 싫은 일에",
"신경을 써야 하는 걸까."
],
"5928": [
"이런 거 빨리 끝나면 좋겠는데.",
"분명 범인 말고는 모두",
"그렇게 생각할 텐데...."
],
"5929": [
"「들리면 좋겠는데...」"
],
"5930": [
"일단 평소처럼",
"라디오를 켜 본다."
],
"5931": [
"비교적 알아듣기 쉬운 상태였지만,",
"일기 예보가 아니었다."
],
"5932": [
"「바겐세일 광고 같은 건",
"아무래도 좋다니까...」"
],
"5933": [
"이런 산속에 갇힌 상태로",
"그런 걸 들어 봤자 소용없다."
],
"5934": [
"「나고 씨, 어때요?」"
],
"5935": [
"「일기 예보가 안 잡혀~」"
],
"5936": [
"「놓쳐 버렸을까요?",
"아직일 텐데...」"
],
"5937": [
"「응....",
"여기가 뉴스인 것 같으니까,",
"잠깐 기다려 볼까」"
],
"5938": [
"「...어라?",
"나고 씨, 밖에 나갔었어요?」"
],
"5939": [
"「머리가 젖어 있는데요」"
],
"5940": [
"「아, 그러고 보니...」"
],
"5941": [
"「저기, 뒤쪽 우물 말인데",
"지금은 안 쓰지?」"
],
"5942": [
"「우물?",
"글쎄요, 안 쓰는 것 같은데",
"그게 왜요?」"
],
"5943": [
"「아, 오빠네...",
"어디 갔었어?」"
],
"5944": [
"오락실로 돌아오니, 없는 사이에",
"내려와 있었던 모양인 쌍둥이가",
"라디오를 듣고 있었다."
],
"5945": [
"「밖에, 나갔어?」"
],
"5946": [
"「네, 잠깐 우물에요」"
],
"5947": [
"「우물?",
"왜 그런 데를?」"
],
"5948": [
"「...무슨 일 있었구나」"
],
"5949": [
"「얼굴이 새파래」"
],
"5950": [
"「아... 응...」"
],
"5951": [
"「이번엔 뭔데?」"
],
"5952": [
"히오리의 말에, 쌍둥이는 순간",
"창백해져 서로 얼굴을 마주 봤다."
],
"5953": [
"「또...?",
"트, 틀림없는 거야?」"
],
"5954": [
"「응.. 사람이었어...」"
],
"5955": [
"「...누구」"
],
"5956": [
"「그걸 모르겠어요.",
"일단 휴대폰으로 사진도",
"찍어 오시긴 했는데...」"
],
"5957": [
"「우물에 떨어져 얼굴 부딪친",
"정도의 얘기가 아니야...?」"
],
"5958": [
"「그렇게 심해?",
"언니, 안 보는 게...」"
],
"5959": [
"「괜찮으니까, 보여 줘」"
],
"5960": [
"「상태가 상태라서요,",
"날짜를 특정하긴 어려울",
"거예요」"
],
"5961": [
"「게다가, 저기, 첫날에",
"우리 말고도 누가 있었고...」"
],
"5962": [
"「모르는 사이에 우물에 떨어뜨려진",
"게 아니라면 말이지」"
],
"5963": [
"「근데, 언제 우물에",
"떨어진 걸까」"
],
"5964": [
"「그때는 다들 거실에 모여서",
"대본 읽고 있었잖아?」"
],
"5965": [
"「그치만 그렇다면 나스 씨",
"차에 독이 든 게 이상하잖아!」"
],
"5966": [
"「어, 잠깐만...",
"그럼, 우리 말고도",
"누가 있을지 모른다는 거야?」"
],
"5967": [
"「어딘가 계속 숨어 있는",
"모르는 사람이 있을지도...?」"
],
"5968": [
"「....일지도」"
],
"5969": [
"「그런, 그만해!",
"소름 끼치잖아, 그런 거...」"
],
"5970": [
"「근데, 누가 숨어 있다면",
"다른 사람은 범인이 아니야」"
],
"5971": [
"「....그렇긴, 한데...」"
],
"5972": [
"「...안 오시네」"
],
"5973": [
"모두 입을 다물고 있자, 갑자기",
"시즈나가 문 쪽을 보며 말했다."
],
"5974": [
"「우리 말고는, 아무도」"
],
"5975": [
"「아아... 그러네...」"
],
"5976": [
"「뭐, 너무 돌아다니는 것도",
"위험하니까요...」"
],
"5977": [
"「그럼, 우리는",
"우리 몫만 하면 되겠네」"
],
"5978": [
"「네, 우린 알아서 할게요」"
],
"5979": [
"「응, 먼저 갈게」"
],
"5980": [
"「아, 날씨 말인데...",
"역시 안 되는 것 같아」"
],
"5981": [
"「그렇습니까.",
"뭐, 어쩔 수 없죠」"
],
"5982": [
"「응... 그럼 안녕」"
],
"5983": [
"쌍둥이가 나가자, 히오리는 내선",
"전화를 들고 다른 사람들에게",
"우물 일을 보고했다."
],
"5984": [
"(...다들 점점",
"뿔뿔이 흩어져 가네...)"
],
"5985": [
"식사 정도는 같이 했었는데,",
"그것마저 일부러 피하게",
"되어 버렸다."
],
"5986": [
"(왠지, 이제...)"
],
"5987": [
"(아직 살아 있는 사람들조차",
"같은 저택에 있다는 게",
"믿기지 않게 돼...)"
],
"5988": [
"「밥, 뭘로 할까요」"
],
"5989": [
"쌍둥이가 사라지고 나서, 히오리가",
"일부러 느긋한 말투로 말한다."
],
"5990": [
"「뭔가 담백한 게",
"낫겠죠?」"
],
"5991": [
"「담백한 거?」"
],
"5992": [
"「우동이 있었던 것 같아요,",
"진공 포장된 거요」"
],
"5993": [
"「아, 그거 좋다」"
],
"5994": [
"「그럼 그렇게 하죠」"
],
"5995": [
"부엌으로 향한다."
],
"5996": [
"..........",
"......"
],
"5997": [
"(응.......)"
],
"5998": [
"멍하니 안개가 낀 듯",
"흐릿하던 생각이 점점 맑아져",
"간다."
],
"5999": [
"(....아침....)"
],
"6000": [
"(...별로 잔 것",
"같지가 않은데...)"
],
"6001": [
"요즘은 늘 눈을 떠도",
"충분히 잔 것 같지가 않다."
],
"6002": [
"신경이 곤두서 있어서, 자도",
"피로가 안 풀리는 건지도...."
],
"6003": [
"그래도 이대로 계속 침대에서",
"안 나갈 수는 없다."
],
"6004": [
"...방에서 나가기 싫다는",
"사람들 마음은 정말 잘 알지만."
],
"6005": [
"나는 어느 쪽인가 하면,",
"혼자 있는 게 더 외롭고 무섭다."
],
"6006": [
"(...히오리가",
"걱정할 테고...)"
],
"6007": [
"옆 침대에 히오리는 이미 없다.",
"아마 서재에 있겠지."
],
"6008": [
"졸린 눈을 비비며 일어나서",
"몸단장을 했다...."
],
"6009": [
"(이제 밖이 밝겠지...)"
],
"6010": [
"(...날이 밝으면,",
"이제 괜찮으려나...)"
],
"6011": [
"밤새 아무도 안 왔고.",
"문 앞에 버티고 앉아 있으면",
"방에 들어올 방법이 없겠지."
],
"6012": [
"(밝아졌으니,",
"이제 괜찮겠지...)"
],
"6013": [
"「하아... 졸려...」"
],
"6014": [
"쓰러지듯 침대에 뛰어들어",
"이불 속으로 파고든다."
],
"6015": [
"베개에 얼굴을 파묻은",
"채로 스르르 잠이 들었다."
],
"6016": [
"「......라고!」"
],
"6017": [
"「....., ....」"
],
"6018": [
"(....음...)"
],
"6019": [
"「...라니까, ...이고,",
"몸이 둔해져서...」"
],
"6020": [
"(....시끄러워...)"
],
"6021": [
"(나스 씨 목소리...?)"
],
"6022": [
"「...니까, 등 근육이...」"
],
"6023": [
"(나스 씨다.",
"틀림없이 나스 씨야...)"
],
"6024": [
"큰 목소리로 복도에서 근육 얘기는",
"나스 씨 말고는 있을 수 없다."
],
"6025": [
"(뭐야 진짜...)"
],
"6026": [
"「하하, ...잖아!」"
],
"6027": [
"(그러니까 목소리 크다고요,",
"나스 씨...)"
],
"6028": [
"「...프테라노돈이...」"
],
"6029": [
"「프테라노돈!?」"
],
"6030": [
"너무나 이상한 단어가 들려와서",
"그만 일어나 버렸다."
],
"6031": [
"「.., .......?」"
],
"6032": [
"(이 목소리는...",
"...히오리인가?)"
],
"6033": [
"「...잖아?",
"그래서.. 전자레인지...」"
],
"6034": [
"「위험하니까 그만두시라니까요!」"
],
"6035": [
"무슨 얘기를 하는 걸까...."
],
"6036": [
"히오리가 당황한 걸 보면,",
"또 엄청 알 수 없는 소리를",
"하고 있는 거겠지."
],
"6037": [
"「...려나?」"
],
"6038": [
"「...라니까요! 자!」"
],
"6039": [
"(아, 방으로 돌아갔다...)"
],
"6040": [
"아니, 히오리가 돌려보낸 건가.",
"겨우 조용해졌다...."
],
"6041": [
"(...잠이 깨 버렸어...)"
],
"6042": [
"아무래도 다시 푹 자는 건",
"무리일 것 같다...."
],
"6043": [
"(...할 수 없지, 일어나자...)"
],
"6044": [
"...왜 프테라노돈 때문에",
"깨야 하는 걸까."
],
"6045": [
"왠지 답답해져서",
"몸을 뒤척였다."
],
"6046": [
"(목마르다...)"
],
"6047": [
"(...지금 몇 시지...)"
],
"6048": [
"다시 한번 뒤척여서, 벽에",
"걸려 있을 시계를 본다."
],
"6049": [
"「.......어」"
],
"6050": [
"나도 모르게 일어나서,",
"더듬더듬 안경을 찾아 썼다."
],
"6051": [
"「....점심이 문제가 아니잖아」"
],
"6052": [
"벌써 저녁이 다 됐다.",
"그러니 목도 마르지...."
],
"6053": [
"당연하다는 듯 옆 침대에는",
"히오리가 이미 없다."
],
"6054": [
"더 자다간 쓰러진 거",
"아니냐는 소리 듣겠다."
],
"6055": [
"「먼저 어디로 갈까..」"
],
"6056": [
"히오리는 이제 서재에서",
"나왔으려나."
],
"6057": [
"(......)"
],
"6058": [
"「그렇구나, 그럼 나 먼저",
"1층에 내려가 있을게」"
],
"6059": [
"「...어머, 벌써 이런 시간이네」"
],
"6060": [
"「아, 정말이네요.",
"그럼 저, 슬슬 1층에",
"내려갈게요」"
],
"6061": [
"(...역시 이제 방에서",
"나가는 게 무섭나)"
],
"6062": [
"일단 1층으로 내려갈까."
],
"6063": [
"「우와, 정말이다.",
"슬슬 내려가 볼까」"
],
"6064": [
"「오우, 히오리한테 안부 전해~」"
],
"6065": [
"히오리는 이제 서재에서",
"나왔으려나...."
],
"6066": [
"(이 시간이면 이제",
"1층에 가는 게 좋겠지)"
],
"6067": [
"「아, 아뇨!",
"저, 지금은, 그게...",
"저 슬슬 가 봐야 해서」"
],
"6068": [
"「아, 벌써 그런 시간인가」"
],
"6069": [
"「그래.",
"그럼 또 봐」"
],
"6070": [
"「...그러고 보니 말이야」"
],
"6071": [
"「오늘 쓰일 예정인 책은",
"벌써 알아냈어?」"
],
"6072": [
"「아, 일단은...",
"오늘 건 『우리 속의 여자』가",
"아닐까 싶은데요」"
],
"6073": [
"「그렇다는 건, 미사사기 씨?」"
],
"6074": [
"「미사사기 씨라...",
"근데 우리 속이라니, 모방하기",
"어려워 보이는 얘기네」"
],
"6075": [
"「이 저택에 우리 같은 게",
"어디 있어?」"
],
"6076": [
"「우리나 감옥 같은 건",
"안 보이더라고요」"
],
"6077": [
"「흐음?",
"그럼 어쩔 생각일까」"
],
"6078": [
"「...츠바키 군 때는",
"궤짝이 관 대신이었지」"
],
"6079": [
"「...네...」"
],
"6080": [
"「어딘가 그런 식으로 대신할",
"만한 장소가 있다면",
"막아 두지 않으면 위험하겠네」"
],
"6081": [
"「그, 그렇긴 한데,",
"막는다니...」"
],
"6082": [
"「막을 거면 도와줄게?",
"그래, 그 옷장 같은 걸",
"들고 가서...」"
],
"6083": [
"「아뇨, 저기, 아직까진",
"그런 장소를 못 찾아서요」"
],
"6084": [
"안 말리면 당장이라도 들어 올릴",
"기세였다...."
],
"6085": [
"「그래?",
"내가 도울 일이 있으면",
"말해 줘?」"
],
"6086": [
"「더 이상 누구도",
"죽지 않았으면 좋겠으니까...」"
],
"6087": [
"「응? 아, 미안!",
"츠바키 군 일로",
"탓하는 건 아니야?」"
],
"6088": [
"「나고무 군 덕분에 나는",
"이상한 차를 안 마셨으니까」"
],
"6089": [
"「...네」"
],
"6090": [
"「그러고 보니, 그 차",
"그대로 놔뒀네」"
],
"6091": [
"「아니, 안 마시게",
"메모랑 같이 놔뒀으니까",
"괜찮지만」"
],
"6092": [
"「...제가 맡아 둘까요?」"
],
"6093": [
"「옮겨도 되려나」"
],
"6094": [
"「음, 곤란할지도 모르면",
"조심할 테니까 괜찮아」"
],
"6095": [
"「저기, 정말로",
"조심하세요?」"
],
"6096": [
"「그래, 알고 있어」"
],
"6097": [
"「모처럼 살았으니까.",
"어이없이 죽거나 하진 않아」"
],
"6098": [
"「...네!」"
],
"6099": [
"「아, 죄송해요.",
"슬슬 내려가 봐야...」"
],
"6100": [
"「이런, 벌써 그런 시간인가.",
"날씨가 좋아지면 좋겠네」"
],
"6101": [
"「응, 같이 돌아가자」"
],
"6102": [
"「네, 꼭이요.",
"그럼 실례하겠습니다」"
],
"6103": [
"「그래, 다른 사람들한테도 안부를」"
],
"6104": [
"「그러네,",
"벌써 밤이구나...」"
],
"6105": [
"「자, 슬슬",
"가 볼까요」"
],
"6106": [
"「....아」"
],
"6107": [
"「저기, 히오리...」"
],
"6108": [
"「아, 아아, 죄송해요.",
"뭔데요?」"
],
"6109": [
"넋이 나간 듯한 모습이던",
"히오리가 황급히 걸음을 멈춘다."
],
"6110": [
"「응, 그게...」"
],
"6111": [
"「오락실도",
"잠가 두는 게 좋을까?」"
],
"6112": [
"「오락실...」"
],
"6113": [
"「뭔가 이상한 흔적이 있었고.",
"상관없을지도 모르지만」"
],
"6114": [
"「...그렇군요.",
"어떻게 할까요」"
],
"6115": [
"「라디오나 여벌 열쇠를",
"못 쓰게 되면",
"곤란하려나」"
],
"6116": [
"「다른 사람들한테는 되도록",
"들어가지 말라고 말해",
"두면 되려나」"
],
"6117": [
"아직 꽤 멍한 상태다....",
"아까까지는 나보다 훨씬",
"침착해 보였는데."
],
"6118": [
"(이제야 점점 실감이",
"나기 시작한 건지도...)"
],
"6119": [
"나도 처음 마다라이 씨가 죽었을 때",
"제대로 실감이 난 건,",
"생각해 보면 식당을 나온 뒤였다."
],
"6120": [
"(그런 걸까.",
"눈앞에서 죽어 있는 걸",
"보고 있을 때보다...)"
],
"6121": [
"(...거기서 한 발짝 떨어져",
"기억 속에서 곱씹기 시작하면",
"갑자기... 여러 가지가...)"
],
"6122": [
"쿠라이시 씨 방에서 본 광경이",
"머릿속에 유난히 선명히 떠올랐다."
],
"6123": [
"무서워서 떨쳐 내고 싶지만",
"왠지 그러면 쿠라이시 씨에게",
"미안한 것 같아 어쩔 줄 모른다."
],
"6124": [
"「...가죠」"
],
"6125": [
"혼잣말처럼 툭 중얼거리고,",
"히오리는 거실로 향했다."
],
"6126": [
"거실로 돌아오자 히오리는 지친",
"듯이 소파에 주저앉았다."
],
"6127": [
"아까까지는 무리를 해서라도",
"짓고 있던 평소 같은 표정조차",
"이제 보이지 않는다."
],
"6128": [
"「...괜찮아?」"
],
"6129": [
"「아니...",
"역시 좀 버겁네요」"
],
"6130": [
"힘없이 미소 지으며,",
"어깨를 으쓱한다."
],
"6131": [
"「어릴 때부터 알던",
"배우분이라 그런지...」"
],
"6132": [
"「칼 맞는 역의 명배우였으니,",
"일생일대의 명연기 아닌가 하는",
"바보 같은 생각을 해 버려서...」"
],
"6133": [
"「...그럴 리가 없지만요.",
"몇 번을 봐도 연기 같은 게...」"
],
"6134": [
"...그렇겠지.",
"나한테는 며칠 전 처음",
"만난 사람이지만, 히오리는...."
],
"6135": [
"(예전부터 알던 사람이고,",
"배우로서도 대선배고)"
],
"6136": [
"(...오늘은 아무도",
"안 죽었다고",
"생각했으니까 더욱...)"
],
"6137": [
"「아, 죄송해요.",
"괜찮아요,",
"그런 얼굴 하지 마세요」"
],
"6138": [
"「...그치만...」"
],
"6139": [
"「괜찮다니까요.",
"그냥 잠깐, 이런저런 게",
"생각났을 뿐이에요」"
],
"6140": [
"「앉아 있어.",
"전화는 내가 할게」"
],
"6141": [
"「됐으니까, 기다리고 있어」"
],
"6142": [
"「...죄송해요」"
],
"6143": [
"역시 힘든지, 순순히",
"물러나 소파에 몸을 묻는다."
