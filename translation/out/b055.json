{
"27232": [
"「네? 저기...",
"그런 건가요?」"
],
"27233": [
"「그건 저도 몰랐네요.",
"그렇군요...」"
],
"27234": [
"어라, 미사사기 씨가 했던 말과는",
"다른 건가...?"
],
"27235": [
"「...그래서, 저기...",
"그게 사건과 어떤 식으로",
"이어지는 거죠?」"
],
"27236": [
"「네? 그, 그건...」"
],
"27237": [
"「다카토 엔지로 말인가요?」"
],
"27238": [
"「알고 계셨군요....",
"그래요, 히오리 씨는 다카토",
"엔지로의 친손자예요」"
],
"27239": [
"「소, 손자!?」"
],
"27240": [
"「어머...",
"관계까지는 모르셨나요?」"
],
"27241": [
"「아, 네....",
"너무 잘 알길래 뭔가 관계가",
"있지 않나 생각했을 뿐이라...」"
],
"27242": [
"「그래도 히오리는 범인이",
"아니에요!?」"
],
"27243": [
"「어떻게 그렇게 단언하시죠?」"
],
"27244": [
"「저한테는 히오리 씨야말로",
"누구보다 수상하게 보여요」"
],
"27245": [
"「그가 범인 아닌가요?」"
],
"27246": [
"「...그건 있을 수 없어요.",
"마다라이 씨가 살해된 밤,",
"히오리는 식당에 안 갔어요」"
],
"27247": [
"「아뇨, 식당은커녕 어디에도요.",
"계속 같은 곳에 있었으니까...」"
],
"27248": [
"「저와 같은 방에요.",
"밤새 함께였어요, 확실해요」"
],
"27249": [
"「하지만...",
"주무시고 계셨잖아요?」"
],
"27250": [
"「아주 얕게요.",
"서로 작은 소리에도",
"잠이 깨는 상태였어요」"
],
"27251": [
"「히오리는 그날 밤,",
"마다라이 씨가 죽은 시간엔",
"절대 방을 나가지 않았어요」"
],
"27252": [
"「그리고 미사사기 씨.",
"당신은 그날 밤 부엌에",
"마실 걸 가지러 갔다고 했죠」"
],
"27253": [
"「네, 우유를 받아서",
"바로 방에 돌아갔는데요...?」"
],
"27254": [
"「하지만 방에 돌아가 한밤중이",
"되자 방을 빠져나왔잖아요」"
],
"27255": [
"「아뇨, 그 후엔 바로",
"약을 먹고 쉬었어요」"
],
"27256": [
"「...왜 빠져나왔다고",
"생각하시는 거죠?」"
],
"27257": [
"「그건...",
"마다라이 씨가 살해된 건",
"그 후일 테니까...」"
],
"27258": [
"「그야 그렇겠지만,",
"저는 아니에요」"
],
"27259": [
"「게다가 제가 빠져나올 수",
"있다면 다른 사람이어도",
"되는 거 아닌가요?」"
],
"27260": [
"...그야 그렇지.",
"무슨 소릴 하는 거야, 난...?"
],
"27261": [
"「그 후 자기 방이 아니라",
"마다라이 씨 방으로 가신",
"거 아닌가요?」"
],
"27262": [
"「어머, 그런...",
"곧장 제 방으로 돌아갔어요」"
],
"27263": [
"「누가 제가 마다라이 씨 방에",
"가는 모습이라도 봤다고",
"말하던가요?」"
],
"27264": [
"「그렇죠?",
"가지 않았으니까요」"
],
"27265": [
"그렇지, 방에 갔다는 증거는",
"아무것도 없잖아..."
],
"27266": [
"왜 이런 식으로 생각했더라?",
"헷갈리기 시작했다..."
],
"27267": [
"「방에 돌아갔다는 건",
"거짓말이죠」"
],
"27268": [
"「거짓말?",
"어째서 거짓말이라는 거죠?」"
],
"27269": [
"「당신 증언에는 결정적으로",
"이상한 점이 있어요」"
],
"27270": [
"「...이상하다...?",
"그저 방에 돌아갔다는",
"것뿐인 이야기인데요?」"
],
"27271": [
"「그게 어째서 이상하다고",
"단정할 수 있는 거죠?」"
],
"27272": [
"「미사사기 씨, 당신이",
"증언대로 바로 방에",
"돌아갔다면...」"
],
"27273": [
"「그때 당신도",
"목격했을 거예요」"
],
"27274": [
"「...목격?」"
],
"27275": [
"「네, 이걸...」"
],
"27276": [
"「...저기, 그건",
"테루테루보즈 인형이죠?」"
],
"27277": [
"「그게... 뭐 어쨌다는 거죠?」"
],
"27278": [
"「네, 저기, 그러니까」"
],
"27279": [
"「제가 뭔가 이상한 말을",
"했다고 하시지",
"않았나요?」"
],
"27280": [
"「하지만 저는 이치야나기 씨와",
"테루테루보즈에 관한 이야기를",
"한 기억이 없는데요」"
],
"27281": [
"「말한 기억도 없는 걸",
"이상하다고 하셔도 곤란해요」"
],
"27282": [
"「...테루테루보즈...?」"
],
"27283": [
"「저기, 무슨 말씀인지",
"전혀 모르겠는데요...」"
],
"27284": [
"「모르는 건, 당신이",
"사실은 방에 돌아가지",
"않았기 때문이에요」"
],
"27285": [
"「당신은 이렇게 말했죠.",
"11시 넘어 방을 나와 부엌으로",
"내려갔다...」"
],
"27286": [
"「네, 그때 스즈나 씨를",
"만났는데요...?」"
],
"27287": [
"「그리고 15분쯤 뒤에",
"부엌을 나와 방에 돌아갔다고」"
],
"27288": [
"「정말인가요?」"
],
"27289": [
"「정말이에요.",
"틀림없어요」"
],
"27290": [
"「...역시,",
"당신이 범인이군요」"
],
"27291": [
"「무... 무슨 말씀을",
"하시는 거죠...?」"
],
"27292": [
"「그것만...",
"그 거짓말만 없었다면...」"
],
"27293": [
"「거짓말...?」"
],
"27294": [
"「미사사기 씨,",
"당신은 거짓말을 하고 있어요」"
],
"27295": [
"「그날 밤의 진짜 행동은",
"이랬던 거죠?」"
],
"27296": [
"「...23시 25분경.",
"당신의 원래 증언으론 부엌에서",
"방으로 돌아갔다는 시간이에요」"
],
"27297": [
"「하지만 그게 거짓말이었어.",
"당신은 방에 돌아가지 않았어」"
],
"27298": [
"「식당에서 마다라이 씨를",
"만나고 있었던 거죠」"
],
"27299": [
"「어... 어째서 그렇다고...」"
],
"27300": [
"「나스 씨가 만든 테루테루보즈는",
"크기도 큰 데다 수건으로 만들어서",
"잘못 볼 리가 없어요」"
],
"27301": [
"「미사사기 씨도 물론",
"본 적이 있으시죠?」"
],
"27302": [
"「네...",
"거실 테라스에 매달아",
"둔 거잖아요...?」"
],
"27303": [
"「맞아요, 하지만...",
"처음부터 테라스에 매달려",
"있던 게 아니에요」"
],
"27304": [
"「이건 마다라이 씨가 살해된 밤,",
"아주 짧은 시간이었지만",
"2층 난간에 걸려 있었어요」"
],
"27305": [
"「아주 짧은 시간...",
"23시 15분부터 30분경까지의",
"잠깐 동안이었죠」"
],
"27306": [
"「그런데 미사사기 씨.",
"당신이 방으로 돌아가려 했다는",
"23시 25분경에는...」"
],
"27307": [
"「테루테루보즈가 아직",
"틀림없이 2층 난간에",
"있었어요」"
],
"27308": [
"「그런데 당신은",
"테루테루보즈에 대해",
"한마디도 안 했어요」"
],
"27309": [
"「지금까지 계속 테라스에",
"있던 거라고 생각하고",
"있었잖아요」"
],
"27310": [
"「당신은 거기에 테루테루보즈가",
"있었던 걸 몰랐어요.",
"즉――」"
],
"27311": [
"「23시 25분 이후의",
"당신 증언은 사실이 아니야」"
],
"27312": [
"「......당신만」"
],
"27313": [
"「당신만 없었다면",
"전부 잘 풀렸을 텐데...」"
],
"27314": [
"「미... 미사사기 씨...!?」"
],
"27315": [
"「왜 온 거야...",
"이런 곳에...」"
],
"27316": [
"「운 나쁜 사람....",
"나랑 똑같네」"
],
"27317": [
"자조로 가득한 눈을 가늘게 뜨며",
"미사사기 씨가 내게 다가왔다."
],
"27318": [
"「저, 저기... 잠깐만...」"
],
"27319": [
"생각보다 먼저 뒷걸음질 치며",
"어떻게든 도망치려 한다."
],
"27320": [
"「...포기해」"
],
"27321": [
"「네!?",
"시, 시, 싫어요!!」"
],
"27322": [
"「저기, 누구 얘기를",
"하고 있었죠...?」"
],
"27323": [
"「이야기 흐름을",
"잘 모르겠는데요?」"
],
"27324": [
"「...저기, 그게 뭐죠?」"
],
"27325": [
"「네? ...그러니까...」"
],
"27326": [
"고개를 갸웃하는 모습에",
"내가 내민 걸 다시 봤다."
],
"27327": [
"...왜 이걸 꺼냈더라."
],
"27328": [
"「뭔가, 그러니까",
"증거품 같은 게 있나",
"생각했는데요...」"
],
"27329": [
"「...아니었나요?」"
],
"27330": [
"「죄, 죄송해요, 저기...」"
],
"27331": [
"「...네?",
"저기, 무슨 뜻이죠?」"
],
"27332": [
"고개를 갸웃하는 미사사기 씨에",
"불안해져 표를 다시 봤다."
],
"27333": [
"「그러니까 사건 당시",
"여러분의 행동에 관한",
"이야기 아니었나요...?」"
],
"27334": [
"「아...",
"그, 그렇죠...」"
],
"27335": [
"「그 장소 말인가요?」"
],
"27336": [
"「네, 아, 어라?」"
],
"27337": [
"「저기...",
"방금 이야기에서",
"왜 거기가...?」"
],
"27338": [
"「...아, 그러니까」"
],
"27339": [
"「이치야나기 씨...",
"피곤하신 거",
"아닌가요?」"
],
"27340": [
"「어쩐지 하시는 말씀이",
"앞뒤가 안 맞아요.",
"몸이 안 좋은 거 아닌지...」"
],
"27341": [
"「그... 그런",
"걸까요...?」"
],
"27342": [
"「분명 신경이 지치신 거예요.",
"그래서 제가 범인이라는 끔찍한",
"망상에 사로잡히신 거죠」"
],
"27343": [
"「...망상...」"
],
"27344": [
"「방에 돌아가서",
"쉬시는 게 좋겠어요」"
],
"27345": [
"「가엾게도...",
"어지간히 궁지에",
"몰리셨나 봐요」"
],
"27346": [
"...그런 걸지도....",
"어떻게든 여기서 벗어나고 싶어서",
"이상해진 걸지도..."
],
"27347": [
"「...죄송해요...",
"제가 좀 이상한가 봐요...」"
],
"27348": [
"「아뇨, 무리도 아니죠.",
"이제 아무 생각 말고",
"푹 누워 계세요」"
],
"27349": [
"「네....",
"죄송합니다, 실례했어요...」"
],
"27350": [
"밖은 비가 왔으니까"
],
"27351": [
"페인트가 쏟아졌으니까"
],
"27352": [
"방에 있었다는 것"
],
"27353": [
"거실에 있었다는 것"
],
"27354": [
"전부"
],
"27355": [
"3일째 밤"
],
"27356": [
"4일째 밤"
],
"27357": [
"4일째 아침"
],
"27358": [
"밤 아직 이른 시간"
],
"27359": [
"새벽 1시 넘어"
],
"27360": [
"새벽 3시경"
],
"27361": [
"살해 시 소리를 지우려고"
],
"27362": [
"모두를 깨우려 했다"
],
"27363": [
"살해 시각을 헷갈리지 않게"
],
"27364": [
"계속 시즈나 방에 있었다"
],
"27365": [
"베란다를 지나갔다"
],
"27366": [
"발자국이 남지 않았다"
],
"27367": [
"문이 녹슬어 안 열린다"
],
"27368": [
"...기묘한 침묵이 이어졌다."
],
"27369": [
"미사사기 씨는 아무 말 없이",
"가만히 내 얼굴을 마주 본다."
],
"27370": [
"어느새 그 당혹스러운 듯한,",
"곤란한 듯한 표정이 사라져 있었다."
],
"27371": [
"「그래서...?」"
],
"27372": [
"「이야기는 그걸로 끝?",
"아니면 마다라이 씨 외의 사건도",
"제가 했다고 하실 건가요」"
],
"27373": [
"「...저는...",
"당신 짓이라고 생각해요」"
],
"27374": [
"「츠바키 군 때도 당신은",
"이상한 증언을 했어요」"
],
"27375": [
"「아침에 스즈나가 소란 피우는",
"소리가 들렸다고 했죠」"
],
"27376": [
"「언니한테 무슨 짓 했냐고,",
"그런 말을 했다고요」"
],
"27377": [
"「확실히 스즈나는 그런 말을",
"했다고 해요」"
],
"27378": [
"「하지만 미사사기 씨.",
"당신이 방에 있었다면",
"그걸 들었을 리가 없어요」"
],
"27379": [
"「무슨 뜻... 이죠?」"
],
"27380": [
"「왜냐하면 스즈나가 그런",
"말을 한 장소는...」"
],
"27381": [
"「...2층이 아니에요.",
"1층에서였거든요」"
],
"27382": [
"「『언니한테 무슨 짓 했어』...",
"그건 히오리에게 한 말이에요」"
],
"27383": [
"「잠결에 창고에 있던 시즈나를",
"옮기던 히오리와 마주쳐서",
"놀라서 한 말이었죠」"
],
"27384": [
"「히오리가 바로 스즈나에게 설명했고",
"2층에 올라갔을 땐 스즈나도 이미",
"납득하고 고맙다고 했대요」"
],
"27385": [
"「미사사기 씨, 그날 아침 당신이",
"방에 있었다는 건 거짓말이에요.",
"즉...」"
],
"27386": [
"「그날 아침의 움직임은",
"실제로 이랬던 거죠」"
],
"27387": [
"「...그날 아침,",
"당신은 지하에 있었죠」"
],
"27388": [
"「츠바키 군을 죽이고,",
"시체를 궤짝에 밀어 넣고,",
"그 후로도 한동안」"
],
"27389": [
"「그런...",
"제가 계속 지하에 있었다고",
"하시는 건가요?」"
],
"27390": [
"「네, 그래요.",
"그렇지 않으면 스즈나와 히오리의",
