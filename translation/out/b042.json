"22949": [
"(왜 갑자기 울린 걸까.",
"보러 가는 게 좋을까...)"
],
"22950": [
"하지만 여길 떠났다가 미사사기 씨에게",
"무슨 일이 생기면 농담이 아니다.",
"오히려 가만히 있는 게 나을지도."
],
"22951": [
"(...그래도 신경 쓰여...)"
],
"22952": [
"(시계 쪽이 사건과 관련",
"있을지도 모르고...)"
],
"22953": [
"살그머니 나가서 복도 모퉁이까지 가서",
"상황을 살펴볼까..."
],
"22954": [
"어중간한 위치에서 망설이며",
"복도를 오른쪽, 왼쪽 분주히 살핀다."
],
"22955": [
"(아... 누가 있어...!)"
],
"22956": [
"발소리가 들린다.",
"게다가 다가오는 것",
"같다..."
],
"22957": [
"(어, 어떡하지?",
"누구지..?)"
],
"22958": [
"(이대로면 마주칠 텐데",
"음...)"
],
"22959": [
"「...누, 누구야!?」"
],
"22960": [
"「나고 씨예요?」"
],
"22961": [
"「히오리...?」"
],
"22962": [
"익숙한 목소리에 안도한 나머지",
"온몸에서 힘이 빠졌다."
],
"22963": [
"「뭐야...",
"히오리구나...」"
],
"22964": [
"「뭐 하고 있는 거예요,",
"이런 데서?」"
],
"22965": [
"「히오리야말로...",
"혹시 시계 보러 갔었어?」"
],
"22966": [
"「네, 갑자기 울리길래",
"무슨 일인가 싶어서요」"
],
"22967": [
"「어땠어?」"
],
"22968": [
"「8시가 돼 있었어요」"
],
"22969": [
"「시간이 틀어져 있었어요.",
"바늘이 8시를 가리키고 있었죠」"
],
"22970": [
"「당연히 울리게 해 놨더군요.",
"시간이 어긋난 건 낡아서 틀어진",
"것일지도 모르지만...」"
],
"22971": [
"「그래서 당신은 뭐 하는 거예요」"
],
"22972": [
"「어, 저기...",
"거기... 빈방이...」"
],
"22973": [
"「빈방?",
"아무도 없잖아요, 그 방은」"
],
"22974": [
"「그게, 있었다니까!",
"갑자기 안에서 열려서...」"
],
"22975": [
"「...그, 그런데 아무도",
"안 나왔는데...」"
],
"22976": [
"내 얘기를 듣고 히오리는 의아한 듯",
"눈살을 찌푸렸다."
],
"22977": [
"「나고 씨가 있는 걸 알아채서",
"방에서 안 나왔다는",
"걸까요?」"
],
"22978": [
"「...그럴지도」"
],
"22979": [
"「뭐, 좀 봐 볼까요」"
],
"22980": [
"「에에에!?」"
],
"22981": [
"「그치만 내버려 둘 수는",
"없잖아요」"
],
"22982": [
"「그.. 야, 뭐...」"
],
"22983": [
"「그래도 위험해,",
"아직 누가 있을지도...」"
],
"22984": [
"「그러니 더 내버려 둘 수 없죠.",
"괜찮아요, 들여다보기만 할게요」"
],
"22985": [
"「나고 씨는 뒤에서",
"아무도 안 오는지 지켜봐 주세요」"
],
"22986": [
"히오리는 벽에 몸을 붙이면서",
"살짝 열린 문을 살며시 열어 본다."
],
"22987": [
"「...어때...?」"
],
"22988": [
"「어두워서 잘 안 보이는데",
"아무래도 베란다가 열려",
"있는 것 같네요...」"
],
"22989": [
"「베란다?」"
],
"22990": [
"듣고 보니 비바람 소리가",
"유난히 크게 들린다."
],
"22991": [
"「여기선 잘",
"안 보이네...」"
],
"22992": [
"「드, 들어가면 안 돼!",
"아직 누가 숨어 있을지도 모르고",
"그야말로 베란다에 있을지도..」"
],
"22993": [
"「...발을 들이는 건",
"위험할까요」"
],
"22994": [
"「무조건 위험하다니까!",
"조사하려면 날이 밝고 나서가",
"좋겠어!」"
],
"22995": [
"「그렇네요.",
"여긴 닫아 둘까요」"
],
"22996": [
"그렇게 말하며 히오리는 물러나",
"빈방 문을 닫았다."
]
}