{
"22478": [
"「어느 쪽이요?」"
],
"22479": [
"「응, 그러니까...」"
],
"22480": [
"「이렇다고 생각해」"
],
"22481": [
"「어디 보자...",
"이건 무슨 순서예요?」"
],
"22482": [
"「사건이 일어난 해의 순서야.",
"작중에서 사건이 발생한 연대순」"
],
"22483": [
"「연대순이요.",
"과연...」"
],
"22484": [
"「음, 『검은 고양이』가 쇼와 11년,",
"『종루』가... 쇼와 12년이고",
"『호반』이 같은 쇼와 12년 연말인가」"
],
"22485": [
"「그리고 『꺼림칙한 꽃』이...」"
],
"22486": [
"「아, 그건 이야기가 시작된 건",
"쇼와 35년이지만」"
],
"22487": [
"「사건 자체는 20년 전",
"당주의 변사부터니까,",
"쇼와 15년이 시작이지」"
],
"22488": [
"「? 왜 그래?」"
],
"22489": [
"「아뇨, 실은 『꺼림칙한 꽃』은",
"지금 팬들 사이에선 마지막 사건이라고",
"불리거든요」"
],
"22490": [
"「이걸 마지막으로",
"료스케 시리즈는",
"안 썼으니까요」"
],
"22491": [
"「어라, 그럼 이 순서",
"틀린 건가」"
],
"22492": [
"「아뇨, 전 이게",
"맞다고 생각해요」"
],
"22493": [
"「어쨌든 다카토 엔지로 본인은",
"마지막 사건이란 생각은",
"눈곱만큼도 없었으니까요」"
],
"22494": [
"「마지막 사건이란 광고 문구는",
"문고판으로 시리즈가 복간됐을 때",
"띠지에 붙어 있던 문장이에요」"
],
"22495": [
"「그때는 다카토 본인이 이미",
"세상을 떠난 뒤였으니까요」"
],
"22496": [
"「그럼 출판사가 그런 광고",
"문구로 판 것뿐이구나」"
],
"22497": [
"「그런 거죠.",
"다만 별로 알려져 있진",
"않지만요...」"
],
"22498": [
"「쓸 예정이었던",
"진짜 마지막 사건이란 건",
"결국 존재하지 않아요」"
],
"22499": [
"「쓰기 전에 세상을 떠난 거야?」"
],
"22500": [
"「범인은 알고 있을까,",
"그... 다카토 씨 본인은",
"마지막일 생각이 없었단 걸」"
],
"22501": [
"「알고 있을 거예요.",
"일부러 이 시리즈를",
"모방 소재로 삼을 정도니까」"
],
"22502": [
"「그럼 『꽃』이 쇼와 15년,",
"다음이 쇼와 24년 『악마』고...」"
],
"22503": [
"「마지막이 『우리 안의 여자』",
"쇼와 30년이네요」"
],
"22504": [
"「순서는 이렇다고 생각하는데」"
],
"22505": [
"「사건이 발생한 연대",
"순서라는 거죠」"
],
"22506": [
"「이렇지 않을까」"
],
"22507": [
"「어디 보자, 이건...",
"아아, 책 발매 순서란 거군요」"
],
"22508": [
"「『검은 고양이』가 쇼와 12년이고,",
"『종루』가 쇼와 14년,",
"다음 『악마』가 쇼와 25년 6월」"
],
"22509": [
"「『호반』이 같은 25년 10월,",
"『우리』가 32년이고 『꽃』이 38년",
"...이네요」"
],
"22510": [
"「순서는 이걸로...」"
],
"22511": [
"「발매 순서라는 거군요」"
],
"22512": [
"「『검은 고양이』 다음이 『종루』,",
"그다음이 『호반』, 『악마』...」"
],
"22513": [
"「...아아, 그렇군요.",
"알겠어요, 사건의 연대순이란",
"거군요」"
],
"22514": [
"「응, 『검은 고양이』 사건 발생이",
"쇼와 11년이라고 적혀 있잖아.",
"그리고 『종루』가 쇼와 12년」"
],
"22515": [
"「『호반』은... 아, 이거다.",
"『쇼와 12년 연말...』이라는",
"서술이 있어」"
],
"22516": [
"「다음이 쇼와 24년 『악마』고",
"그다음이 『우리 안의 여자』 30년,",
"마지막이 쇼와 35년 『꽃』이라」"
],
"22517": [
"「응, 이게 맞는 것 같아」"
],
"22518": [
"「순서는 이걸로 될까」"
],
"22519": [
"「작중 사건의 연대순이죠」"
],
"22520": [
"「순서는 이런가...」"
],
"22521": [
"「이걸로 괜찮아요?」"
],
"22522": [
"「응, 괜찮은 것 같아」"
],
"22523": [
"「어라, 여기 있는 사람과",
"같은 이름의 캐릭터가 안 나오는",
"책이 섞여 있는데요...」"
],
"22524": [
"「...아, 그렇구나.",
"저는 나오네요」"
],
"22525": [
"「이렇지 않을까?」"
],
"22526": [
"「이 순서대로 노려진다는",
"거죠?」"
],
"22527": [
"「응, 난 그렇게 생각하는데」"
],
"22528": [
"「그럼 어디...」"
],
"22529": [
"「어라, 나고 씨",
"이러면 목록이 절반밖에",
"안 채워졌는데요?」"
],
"22530": [
"「응, 거기를 모르겠어서.",
"누구를 암시하는 건지...」"
],
"22531": [
"「어떡할래요?",
"다시 한번 생각해 볼래요?」"
],
"22532": [
"「그러게...」"
],
"22533": [
"「응, 거기를 모르겠어서.",
"뭘 암시하는 건지...」"
],
"22534": [
"「그럼",
"오늘 노려지는 건...」"
],
"22535": [
"「오늘은 저란 말이에요?」"
],
"22536": [
"「그렇게 될 것 같아.",
"그러니까 밤엔 조심해야 해」"
],
"22537": [
"「츠바키 씨가 위험하다고요?」"
],
"22538": [
"「오늘은 쿠라이시 씨가 위험하단",
"거군요」"
],
"22539": [
"「응, 그렇게 생각해...」"
],
"22540": [
"「나스 씨인가요, 오늘은」"
],
"22541": [
"「오늘 노려지는 건",
"미사사기 씨란 거군요」"
],
"22542": [
"「난 그렇게 될 것 같아」"
],
"22543": [
"「오늘은 시즈나 씨가 위험하단",
"얘기가 되네요」"
],
"22544": [
"「스즈나 씨가 오늘은 위험하단",
"거예요?」"
],
"22545": [
"「그런 것 같아...」"
],
"22546": [
"「나구모 씨... 요?」"
],
"22547": [
"「나열하니까 그렇게 돼 버렸어」"
],
"22548": [
"「그리고 책은 이거, 라」"
],
"22549": [
"「이건 모방에 쓰일",
"소품이 있을 것 같네요」"
],
"22550": [
"「모방에 쓰일 것 같은 물건은",
"어쨌든 있는 대로 전부",
"숨겨 버리는 게 좋겠지」"
],
"22551": [
"「숨겨져 있으면 범인도",
"자기 행동을 읽히고 있다는 걸",
"알 테고...」"
],
"22552": [
"「...오히려 자극하는",
"꼴이 될 것 같기도 하지만요」"
],
"22553": [
"「그, 그건 좀 무섭지만",
"그렇다고 위험할지도 모르는 걸",
"내버려 둘 수도 없잖아」"
],
"22554": [
"「그렇죠.",
"할 수 있는 건 해 둬야죠」"
],
"22555": [
"「숨길 물건 짐작이 가면",
"그걸 찾아내야겠네」"
],
"22556": [
"「...그,",
"물건 찾기 말인데요」"
],
"22557": [
"「응?」"
],
"22558": [
"「맡겨도 될까요」"
],
"22559": [
"「...아아, 그렇구나.",
"둘이서 돌아다니면",
"역시 혼자보다 눈에 띄나」"
],
"22560": [
"「너무 자극하지 않게",
"몰래 하는 게 좋겠지」"
],
"22561": [
"「네, 도저히 혼자선 곤란할",
"때는 도울 테니까",
"바로 부르러 오세요」"
],
"22562": [
"「『종루관 살인』이라면",
"지하실 열리지 않는 관에서 시체가",
"나오는 얘기죠」"
],
"22563": [
"「분명 이상한 지팡이로 맞아",
"죽었던가」"
],
"22564": [
"「왠지 마법사가 들 법한",
"묘한 모양의 나무 지팡이였죠」"
],
"22565": [
"「그럼 쓰일 것 같은 건",
"관이랑 지팡이려나」"
],
"22566": [
"「그나저나 『호반의 저택』이라.",
"이건 골치 아프네」"
],
"22567": [
"「시체 곁에 반드시 이상한 게",
"떨어져 있는 얘기라서요」"
],
"22568": [
"「와인 잔에 각설탕과",
"은 머들러가 들어 있다든가...」"
],
"22569": [
"「체스 말과 다트 화살이",
"벽난로 위에 놓여 있다든가」"
],
"22570": [
"「그러고 보니 뭔가 이것저것",
"적혀 있었던 것 같은데...」"
],
"22571": [
"「유난히 소품이 많은",
"얘기거든요」"
],
"22572": [
"「...그 밖에는?」"
],
"22573": [
"「음, 그리고...",
"깃펜에 촛대고,",
"그리고...」"
],
"22574": [
"「가죽 쿠션에",
"코르크 따개도 있었던가」"
],
"22575": [
"「열 개쯤 되네...",
"작은 물건뿐이라 범인이 직접",
"가져올 수도 있겠고...」"
],
"22576": [
"「어쨌든 눈에 띄는 건",
"전부 숨겨 볼게」"
],
"22577": [
"「방금 말한 걸 다 숨긴다 해도",
"방심 안 하는 게 좋겠죠.",
"어디에나 있는 물건이니까요」"
],
"22578": [
"「그러게, 조심할게」"
],
"22579": [
"「『꺼림칙한 꽃』이라면",
"우선 장미려나」"
],
"22580": [
"「아아, 줄거리에 적혀 있네.",
"장미 꽃다발인가...」"
],
"22581": [
"「그리고 신경 쓰이는 건",
"흉기네요.",
"사살이거든요...」"
],
"22582": [
"「사살이면 총이지?」"
],
"22583": [
"「꼭 권총이 아니더라도",
"쏴 죽일 수 있는 무기라면",
"어딘가 있을지도 몰라요」"
],
"22584": [
"「왠지 이것저것 흉흉한 게",
"장식돼 있으니까요」"
],
"22585": [
"「『악마의 화원』이라면...",
"어쨌든 도끼네요」"
],
"22586": [
"「그렇지.",
"줄거리에도 대놓고",
"적혀 있고」"
],
"22587": [
"「『우리 안의 여자』라면...",
"하얀 양산, 이려나?」"
],
"22588": [
"「그런 것 같네.",
"그 밖에 이거다 싶은 물건",
"나와?」"
],
"22589": [
"「아뇨, 기억에 없어요.",
"아무리 이 저택이라도 지하 감옥",
"같은 건 없고요」"
],
"22590": [
"「『검은 고양이의 독』은...",
"마다라이 씨가 나오는 얘기죠」"
],
"22591": [
"「이게 또 쓰인다면",
"쓰일 만한 건 뭘까요」"
],
"22592": [
"「생각 안 나?」"
],
"22593": [
"「글쎄요.",
"검은 고양이는 이미 온실에 나왔고,",
"마다라이 씨 시체는 그랬으니」"
],
"22594": [
"「함께 실린 『백사 살인 사건』",
"쪽일까요?」"
],
"22595": [
"「...그, 그렇다는 건 뱀?」"
],
"22596": [
"「뱀인데,",
"새하얀 녀석뿐이에요.",
"게다가 머리가 둘인」"
],
"22597": [
"「저택 안에 있으면 싫어!」"
],
"22598": [
"「뭐, 설마 없지 않을까요」"
],
"22599": [
"「『미움받는 비결』이네요.",
"이건 항아리려나」"
],
"22600": [
"「두 개 나오나 봐.",
"비싼 항아리랑 이상한 모양 항아리?」"
],
"22601": [
"「그렇네요, 그 두 개겠죠」"
],
"22602": [
"「『고요한 살의』는",
"일본도라는 얘기가",
"되려나요?」"
],
"22603": [
"「무기는 이것저것 있지만",
"일본도는 아무래도 없을 것",
"같은데...」"
],
"22604": [
"「그렇죠.",
"그래도 온천은 더더욱",
"어쩔 도리가 없겠죠」"
],
"22605": [
"「음...",
"쓸 만한 게 있는지 없는지",
"찾아볼게」"
],
"22606": [
"「『고양이와 첫눈』이라면",
"그대로 고양이랑 눈이려나요」"
],
"22607": [
"「눈은 안 내리지만",
"고양이는 어떤 고양이?」"
],
"22608": [
"「샴고양이였을 거예요, 아마」"
],
"22609": [
"「온실 건 검은 고양이고...",
"음, 찾아볼게」"
],
"22610": [
"「『회색 가면』은",
"보이는 그대로네요」"
],
"22611": [
"「가면이지」"
],
"22612": [
"「『사신의 낫』이라면",
"검은 망토려나요」"
],
"22613": [
"「사신이라, 이 저택에 뭔가",
"그런 그림이나 장식이",
"있을까」"
],
"22614": [
"「글쎄요,",
"있을지도 모르죠」"
],
"22615": [
"「『작은 새를 기르는 여자』네요.",
"이건 단편집인데...」"
],
"22616": [
"「...아아, 그래도 모방에",
"쓸 만한 건 표제작의",
"작은 새 정도네요」"
],
"22617": [
"「작은 새라...",
"못 찾을지도 모르지만",
"찾아볼게」"
],
"22618": [
"「『인형은 웃는다』라면",
"일본 인형인데요...」"
],
"22619": [
"「일본 인형은",
"본 기억이 없는데」"
],
"22620": [
"「현장에 남겨진",
"『저주받아라』라는 메시지 쪽도",
"좀 막을 방법이 없네요」"
],
"22621": [
"「그러게, 종이랑 필기구 같은 건",
"저택에서 다 숨겨도 범인이",
"갖고 있을 테고...」"
],
"22622": [
"「...아, 그래도 흉기는 송곳이네」"
],
"22623": [
"「그건 어딘가 있을 것 같네요」"
],
"22624": [
"「『항아리 속 수수께끼』... 는",
"커다란 항아리가 되려나요」"
],
"22625": [
"「항아리는 왠지 잔뜩",
"있을 것 같은데...",
"일단 큰 거겠네」"
],
"22626": [
"「이 경우엔 어떻게 되지.",
"『잊지 못할 섬』이란 얘기면」"
],
"22627": [
"「편지라는 건 소품으로서는",
"어떨까요」"
],
"22628": [
"「오히려 세토 내해의 인상이",
"강한 얘기거든요」"
],
"22629": [
"「세토 내해... 라면",
"그림이나 사진 같은 거?」"
],
"22630": [
"「그리고 지도 같은 거겠죠」"
],
"22631": [
"「『양초와 사과』라면",
"그대로네요」"
],
"22632": [
"「양초랑 사과, 만 있으면 돼?」"
],
"22633": [
"「그 밖에 이거다 싶은 건",
"안 나왔던 것 같아요」"
],
"22634": [
"「『일곱 장의 그림 패』라면",
"트럼프겠죠」"
],
"22635": [
"「그렇겠지.",
"트럼프가 오락실에",
"있었던가?」"
],
"22636": [
"「아아, 그러고 보니",
"본 기억이 없네요」"
],
"22637": [
"「음...",
"그래도 관련된 게 있을지도",
"모르니까 찾아볼게」"
],
"22638": [
"「『벚나무 아래에』니까",
"그대로 벚꽃이 되려나요」"
],
"22639": [
"「진짜는 아무래도 안 폈을",
"테고 그림 같은 건가?」"
],
"22640": [
"「그렇겠죠.",
"아니면 벚꽃 무늬가 들어간",
"뭔가라든가...」"
],
"22641": [
"「...백골은 상관없겠지」"
],
"22642": [
"「그런 게 저택 안에",
"있으면 싫잖아요」"
],
"22643": [
"「『그림 속의 죽음』이요」"
],
"22644": [
"「이건 어떤 그림이야?」"
],
"22645": [
"「여자의 잘린 머리 그림이에요」"
],
"22646": [
"「....그, 그런 그림이",
"있으려나...」"
],
"22647": [
"「이 저택에선 본 적 없는데요」"
],
"22648": [
"별로 찾고 싶지도 않지만",
"찾아볼 수밖에 없겠지..."
],
"22649": [
"「『시계』는 그대로",
"시계면 되는 건가.",
"왠지 잔뜩 있을 것 같은데」"
],
"22650": [
"「작중에 나오는 건",
"괘종시계예요.",
"벽에 거는 거」"
],
"22651": [
"「그렇구나, 그럼 탁상시계 같은 건",
"상관없구나」"
],
"22652": [
"「『이미 죽어 있던 남자』는",
"배 위에서 일어난 사건이거든요」"
],
"22653": [
"「배라...」"
],
"22654": [
"「어디 보자...",
"이 책은 모방에 쓰일 것 같은",
"소품이 좀 떠오르질 않네요」"
],
"22655": [
"「모방 살인이 아닐지도",
"모른다는 거예요?」"
],
"22656": [
"「그런 것 같아.",
"이번엔 시체에 아무것도",
"안 하지 않을까」"
],
"22657": [
"「원작 상황에 맞추기만 한다면",
"마다라이 씨처럼 특수한 게",
"아니면 아무것도 안 하지 않을까?」"
],
"22658": [
"「모방 살인을 하는 게 목적이",
"아니라면 일부러 품 드는 짓은",
"안 하려나...」"
],
"22659": [
"「아니, 억지로라도 모방 살인으로",
"만들지도 모르지만」"
],
"22660": [
"「억지로라니...?」"
],
"22661": [
"「꼭 뭔가 물건을 써서 한다고는",
"할 수 없지 않을까」"
],
"22662": [
"「예를 들면 현장이 실내라든가",
"실외라든가, 흉기만 같다든가」"
],
"22663": [
"「아아, 그러면 소품은",
"상관없다는 얘기가 되네요」"
],
"22664": [
"「그렇지?」"
],
"22665": [
"「...어라?",
"이건 다카토 엔지로의",
"책이 아닌데요?」"
],
"22666": [
"「응, 그렇긴 한데",
"꼭 다카토 씨 작품만",
"쓴다고는 할 수 없잖아」"
],
"22667": [
"「그럴지도 모르지만",
"왜 이 책이에요?」"
],
"22668": [
"「이것도 추리물이고,",
"현장을 비슷한 상황으로 만드는 건",
"가능하지 않을까」"
],
"22669": [
"「하아, 그렇군요...」"
],
"22670": [
"「모방하기 쉬워 보이지 않아?」"
],
"22671": [
"「그런가요...?",
"아니, 모방하기 쉽단 이유로",
"상관없어 보이는 책을 쓸까요」"
],
"22672": [
"「...이상한가」"
],
"22673": [
"「왠지 논리가 이상하지 않아요?」"
],
"22674": [
"「음, 그런가...」"
],
"22675": [
"「그런데 오늘 칸에 들어간 책,",
"다카토와도 추리소설과도 상관없어",
"보이는데, 이게 맞는 거예요?」"
],
"22676": [
"「응, 그치만...」"
],
"22677": [
"「꼭 추리소설이 쓰인다고는",
"할 수 없지 않을까」"
],
"22678": [
"「그야 꼭 추리물이란",
"증거는 없지만...」"
],
"22679": [
"「그렇지?",
"범인이 거기에 집착하는지",
"어떤지 모르잖아」"
],
"22680": [
"「오히려 추리물이 틀림없다고",
"단정하는 게 더 위험할",
"것 같거든」"
],
"22681": [
"「뭐, 확실히」"
],
"22682": [
"「모방할 상황은 만들기 쉬울",
"것 같지 않아?」"
],
"22683": [
"「그런가요?",
"그래도...」"
],
"22684": [
"「뭔가 이상해?」"
],
"22685": [
"「모방하기 쉽다고 하면,",
"마다라이 씨 그건 꽤나",
"손이 많이 갔잖아요」"
],
"22686": [
"「모방하기 쉬운지로 따져서",
"고른다면, 애초에 그 얘기 자체가",
"안 골라졌을 것 같은데요」"
],
"22687": [
"「아.. 그렇구나...」"
],
"22688": [
"「역시 뭔가 다르지 않아요?」"
],
"22689": [
"「그런가, 이상한가.",
"음...」"
],
"22690": [
"「그런데 왜 이 책",
"인 거예요...?」"
],
"22691": [
"「다카토 작품도 아니고",
"상관없어 보이는데",
"무슨 근거로요?」"
],
"22692": [
"「...감」"
],
"22693": [
"「그, 그것뿐이에요?」"
],
"22694": [
"「그치만 다른 들어갈 만한 책이",
"생각 안 나는걸」"
],
"22695": [
"「아니, 그래도 근거고",
"뭐고 없는 건 곤란하죠」"
],
"22696": [
"「이걸로 오늘 노려질지도 모른다고",
"해 봤자 들은 사람은 아마",
"납득 못 할 거예요」"
],
"22697": [
"「...그, 그렇겠지.",
"음...」"
],
"22698": [
"「범인이 꼭 다카토 씨 책만",
"쓴다고는 할 수 없잖아」"
],
"22699": [
"「그야 그 부분은 단정 안 하는 게",
"좋겠다고 생각하지만...」"
],
"22700": [
"「굳이 이 저택에서 사건을 일으킨",
"것도 관계있다고 생각하거든」"
],
"22701": [
"「그러니까 이 서재에 있는 책은",
"언뜻 전혀 상관없어 보여도",
"무시하지 않는 게 좋을 거야」"
],
"22702": [
"「...그래서, 저기...",
"왜 마리안느예요...?」"
],
"22703": [
"「등장인물이 닮지 않았어?」"
],
"22704": [
"「어...",
"닮, 았나요...?」"
],
"22705": [
"「난 닮았다고 생각하는데」"
],
"22706": [
"왠지 굉장히 복잡한 표정을",
"짓게 만들어 버렸다..."
],
"22707": [
"「음, 그러니까요.",
"닮았는지 아닌지는 둘째 치고",
"범인이, 그....」"
],
"22708": [
"「그런 이유로 이런 상황에 쓸",
"책을 고를 것 같진 않은데요...」"
],
"22709": [
"「왜냐니, 틀림없어」"
],
"22710": [
"「트, 틀림없다고요」"
],
"22711": [
"「무조건 이거라니까.",
"달리 생각할 수 없잖아?」"
],
"22712": [
"「...그, 런가요...?」"
],
"22713": [
"「응, 무조건 그래」"
],
"22714": [
"「왜 난감한 듯한",
"얼굴을 하고 있어?」"
],
"22715": [
"「아니...",
"죄송해요, 전 왜 이게 틀림없는지",
"짐작도 안 가서요」"
],
"22716": [
"「...그러니까요, 범인이 그,",
"이 상황에서 이 책을 고른다는 게",
"영 상상이 안 간달까...」"
],
"22717": [
"「...이상하다고 생각 안 해요?」"
],
"22718": [
"「뭐, 뭐어...",
"왠지 좀 상황에서",
"동떨어진 느낌은 들어」"
],
"22719": [
"「좀이 아니라니까요」"
],
"22720": [
"「맞다, 이거",
"다른 사람들한테도 알리는 게",
"좋을까?」"
],
"22721": [
"「아뇨...",
"누가 범인인지 판단이 된",
"건 아니니까요」"
],
"22722": [
"「말한다면 오늘 노려지는 사람한테",
"위험하다고 알리기만 하는 게",
"좋지 않을까요」"
],
"22723": [
"「아아, 그렇구나...」"
],
"22724": [
"이 안에 범인이나 그 공범이",
"없다고는 할 수 없었지.."
],
"22725": [
"「그럼 말한다면",
"노려질 것 같은 사람한테만 하자」"
],
"22726": [
"「...내가 말해서",
"믿어 줄까.",
"히오리가 낫지 않아?」"
],
"22727": [
"「아뇨...",
"나고 씨 쪽이",
"적합해요」"
],
"22728": [
"「저보단 당신이",
"경계를 덜 받을 테니까요」"
],
"22729": [
"「...그런가.",
"다른 사람이 보기엔",
"별 차이 없지 않아?」"
],
"22730": [
"「아뇨, 전 원래부터",
"수상쩍게 여겨지는 일이",
"많거든요」"
],
"22731": [
"「...그건 그,",
"옷차림 탓 아닐까...」"
],
"22732": [
"「그럴지도 모르지만",
"이제 와서 생각난 듯이",
"갈아입는 것도 부자연스럽죠」"
],
"22733": [
"「그것도 그렇네.",
"음, 그럼 믿어 줄지",
"모르겠지만 내가 말할게」"
],
"22734": [
"「네, 혹시 밤새 지키자든가",
"하는 얘기가 되면 불러 주세요.",
"저도 함께할 테니까요」"
],
"22735": [
"「응, 고마워.",
"어쩌면",
"같이 있어 달라고 할지도」"
],
"22736": [
"「어쩌면이 아니라도",
"된다니까요.",
"혼자서 무리하지 마세요」"
],
"22737": [
"「그래도 범인을 너무 자극하면",
"역시 곤란하다고...」"
],
"22738": [
"「말했잖아요.",
"당신만은 죽게 두지 않는다고」"
],
"22739": [
"「무슨 일이 있어도",
"나고 씨만은 죽게 두지 않아요.",
"만일의 때엔 제가 지킬게요」"
],
"22740": [
"「그러니까 나고 씨는 마음껏",
"범인의 허를 찔러 주세요」"
],
"22741": [
"「뭐, 뭐야 갑자기...",
"주인공 방패가 돼서 죽는",
"조연 같은 소리 하지 마!」"
],
"22742": [
"「...들켰나요」"
],
"22743": [
"「한번 말해 보고 싶었거든요.",
"최종화 직전에 죽을 녀석 대사」"
],
"22744": [
"「너 말이야!",
"놀래키지 마, 진짜인 줄",
"알 뻔했잖아~!!」"
],
"22745": [
"「괜찮아요.",
"지키겠다는 건",
"거짓말이 아니니까요」"
],
"22746": [
"「지, 지키겠다니, 그치만",
"그럼 히오리가 위험...」"
],
"22747": [
"「전 이래 봬도 단련했거든요,",
"웬만한 험한 일은 괜찮아요」"
],
"22748": [
"「믿어 달라니까요」"
],
"22749": [
"「미, 믿어.",
"아무리 봐도 나보다 세 보이고」"
],
"22750": [
"「그럼 그걸로 됐잖아요.",
"위험할 것 같으면 절 불러 주세요」"
],
"22751": [
"「...알았어.",
"위험할 것 같으면 말할게」"
],
"22752": [
"「네, 부탁해요」"
],
"22753": [
"「그래도 아까 그 파일",
"확인하는 것도 도와줘」"
],
"22754": [
"「난 잘 모르니까,",
"만약을 위해 파일은 매일 여기서",
"확인하기로 할게」"
],
"22755": [
"「그렇네요,",
"누가 노려지고 쓰일 책이",
"뭔지만큼은...」"
],
"22756": [
"「다시 편집하든",
"안 하든",
"일단은 확인하죠」"
],
"22757": [
"「그게 안전하겠지」"
],
"22758": [
"「난 읽는 게 느리고",
"전부 꼼꼼히 읽을",
"시간은 없을 테니까」"
],
"22759": [
"「전 한 번씩 다 읽었으니",
"물어보면 대답할 수 있는 것도",
"있을 거예요」"
],
"22760": [
"「그럼 히오리는 그거 읽어 둬」"
],
"22761": [
"「네, 알겠습니다」"
],
"22762": [
"「...이건 역시",
"다시 생각하는 게 낫지 않아요?」"
],
"22763": [
"「저는 그렇다 쳐도, 노려지는 사람에게",
"충고해도 들어 줄 것",
"같지 않고요...」"
],
"22764": [
"「그것도 그렇네...」"
],
"22765": [
"「.....안 되겠다.",
"모르겠어졌어」"
],
"22766": [
"「좀 막혀 버렸나 보네요」"
],
"22767": [
"「음...",
"이건 일단 두고 다른 것부터",
"할까...」"
],
"22768": [
"「그게 나을지도",
"모르겠네요」"
],
"22769": [
"「미안, 그럼 잠깐",
"그렇게 할게...」"
],
"22770": [
"「네, 무슨 일 있으면",
"또 오세요.",
"전 계속 여기 있을 테니까요」"
],
"22771": [
"「...어렵네, 이거」"
],
"22772": [
"「연달아 이것저것",
"너무 많이 생각했나 보네요」"
],
"22773": [
"「그런가.",
"그것도 있지만...」"
],
"22774": [
"「실제로 표를 만들어 보니",
"채우려면 판단 재료가",
"좀 더 필요한 느낌이야」"
],
"22775": [
"「아아, 그건 확실히",
"그렇네요」"
],
"22776": [
"「그럼 일단 두고",
"나중에 다시 볼래요?」"
],
"22777": [
"「그게 좋겠다」"
],
"22778": [
"「알겠어요.",
"그럼 다시 볼 준비가 되면",
"서재로 오세요」"
],
