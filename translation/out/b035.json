{
"18683": [
"「아~, 그런 거 아냐?」"
],
"18684": [
"「난 평소에 요리 같은 건 거의",
"안 해서 잘 모르지만」"
],
"18685": [
"「어, 그래?」"
],
"18686": [
"「언니는 꽤 좋아하니까",
"그냥 다 맡겨 버려」"
],
"18687": [
"「흐음」"
],
"18688": [
"「응접실에 들어가 본 적 있어?」"
],
"18689": [
"「응, 왔을 때 들여다봤어.",
"무슨 방인가 싶어서」"
],
"18690": [
"「근데 별거 없어서",
"금방 나왔지만」"
],
"18691": [
"「오락실에는 이것저것",
"많이 있더라」"
],
"18692": [
"「그러게,",
"언니가 다트를 만져 보고 싶은",
"눈치였는데...」"
],
"18693": [
"「해 봤어?」"
],
"18694": [
"「아니, 말렸어.",
"언니 사실 운동신경이 없어서",
"엉뚱한 데 던질 것 같거든」"
],
"18695": [
"「비싼 것만 있는 것 같던데",
"괜히 망가뜨리면 무섭잖아」"
],
"18696": [
"「서재 안 본 적 있어?",
"엄청 대단해」"
],
"18697": [
"「아, 봤어 봤어.",
"어려워 보이는 책만 있어서",
"현기증 날 것 같더라...」"
],
"18698": [
"「잘 보니까 평범한 주간지가",
"섞인 책장도 있었어」"
],
"18699": [
"「나머지는 거의 외국 책 같아.",
"영어는 아닌 것 같았지만」"
],
"18700": [
"「그런 건 못 읽어」"
],
"18701": [
"「나도...」"
],
"18702": [
"「창고 안 들여다본 적 있어?」"
],
"18703": [
"「언니가 뒤적거리고 있길래",
"말리러 갔을 때...」"
],
"18704": [
"「왜 저렇게 이상한 데만",
"들어가고 싶어 하는지 몰라」"
],
"18705": [
"「...평소에도 그래?」"
],
"18706": [
"「방송국 미술 창고나",
"대도구 통로에 들어갔다가",
"헤맨 게 몇 번인지 몰라」"
],
"18707": [
"취미인가, 이상한 데 숨어드는 게."
],
"18708": [
"「이 저택 방들은 다",
"호화롭고 굉장하네」"
],
"18709": [
"「굉장하긴 한데, 평소에 혼자",
"쓰기엔 좀 너무 넓어」"
],
"18710": [
"「난 이거 반만 해도 돼,",
"너무 넓으면 안정이 안 돼」"
],
"18711": [
"「아, 나도...」"
],
"18712": [
"「우리 둘 다 가난뱅이 체질이네.",
"어쩔 수 없지만」"
],
"18713": [
"「2층 저쪽에 하나만",
"분위기가 다른 방이 있지?」"
],
"18714": [
"「무슨 열리지 않는 방 같은 거?",
"이 집 사람이 쓰는 방이겠지,",
"난 들어가 본 적 없는데」"
],
"18715": [
"「아마 그렇지 않을까」"
],
"18716": [
"「흐응, 그럼 괜히",
"안 들어가는 게 좋겠네」"
],
"18717": [
"「바로 저기 헛간이 있는데",
"본 적 있어?」"
],
"18718": [
"「아, 이 방 밖에 있는 거?",
"열어 봤는데 그냥 창고",
"같던데」"
],
"18719": [
"「이 소동이 나기 전에",
"지하실에 내려가 본 적 있어?」"
],
"18720": [
"「응, 첫날에.",
"보일러가 있다고 쓰는 법을",
"배웠어」"
],
"18721": [
"「나머진 창고뿐이라고",
"들어서 돌아다니진 않았지만」"
],
"18722": [
"「그렇구나.",
"쓰는 법 가르쳐 준 게",
"츠바키 군이야?」"
],
"18723": [
"「응, 맞아, 집사 씨」"
],
"18724": [
"「지하에 미로 같은 게",
"있었어」"
],
"18725": [
"「그런 게 있어!?",
"대체 무슨 저택이야, 여기...」"
],
"18726": [
"「그냥 평범한 별장은",
"아니었던 것 같아」"
],
"18727": [
"「있잖아, 그 지하 미로에",
"누가 숨어 있거나 하진 않겠지?」"
],
"18728": [
"「이, 일단 내가 본 범위엔",
"아무도 없었는데...」"
],
"18729": [
"정말 누가 있으면 어쩌지..."
],
"18730": [
"「응, 있지.",
"우물이 왜?」"
],
"18731": [
"「그거 이제 안 쓰는",
"걸까」"
],
"18732": [
"「그렇지 않을까?",
"뚜껑도 덮여 있고」"
],
"18733": [
"「그렇지...」"
],
"18734": [
"「방 이름에 관한",
"얘기인데」"
],
"18735": [
"「아, 전부 작가 이름",
"이라던데」"
],
"18736": [
"「언니가 이것저것",
"설명해 줬는데,",
"잘 모르겠더라」"
],
"18737": [
"「흐응?",
"시즈나는 잘 아는구나」"
],
"18738": [
"「뭐, 언니는 추리 작가는",
"대충 다 아니까」"
],
"18739": [
"「...그러고 보니",
"나랑 언니 방 이름이",
"사실 같은 사람이라 했어」"
],
"18740": [
"「어? 같은 사람?」"
],
"18741": [
"「같은 작가의 다른",
"필명이라나 뭐라나」"
],
"18742": [
"「자세한 건 잘 모르니까",
"언니한테 물어봐.",
"자기 방 작가 얘기 해 달라고」"
],
"18743": [
"「응, 알았어.",
"고마워」"
],
"18744": [
"「지하실에 있던 궤짝",
"말인데...」"
],
"18745": [
"「...집사 씨가",
"들어 있던 거?」"
],
"18746": [
"「그거, 사건 전에 만지거나",
"열어 본 적 있어?」"
],
"18747": [
"「아니, 없어.",
"원래부터 거기 있었는지도",
"잘 기억 안 나」"
],
"18748": [
"「나스 씨가...",
"마셔 버린 차 말인데...」"
],
"18749": [
"「나, 첫날에 같은 걸",
"마셨어...」"
],
"18750": [
"「그랬어?」"
],
"18751": [
"「응, 냉장고에 잔뜩 있어서.",
"물론 아무렇지도 않았지만」"
],
"18752": [
"「처음부터 냉장고에 이상한 차가",
"있던 건 아니지 않을까?",
"안 그럼 누가 마실지 모르잖아」"
],
"18753": [
"「저기, 독약 말인데...」"
],
"18754": [
"「독은 비겁해!",
"그런 건 어쩔 도리가 없잖아?」"
],
"18755": [
"「뭐, 나스 씨를 어떻게",
"해 보려면 다른 방법이",
"없었을지도 모르지만」"
],
"18756": [
"「...다른 방법...」"
],
"18757": [
"「목 조르거나 찌르거나 하면",
"반격당해서 범인이 질 것 같잖아」"
],
"18758": [
"「그렇겠지...",
"평범하게 공격해도 안 먹힐",
"것 같기도 하고...」"
],
"18759": [
"「그렇다고 독은 너무해.",
"왠지... 왠지 분해...」"
],
"18760": [
"「쿠라이시 씨 방에",
"장미 그림이 놓여 있었어」"
],
"18761": [
"「...놓여 있었다니,",
"원래 벽에 걸려 있던 거랑",
"다른 게 있었다는 거야?」"
],
"18762": [
"「응, 벽에 걸린 그림은",
"그대로였고 다른 그림이었어」"
],
"18763": [
"「흐응...?",
"어디 있던 그림일까」"
],
"18764": [
"「응접실 거 아니냐던데.",
"본 기억 없어?」"
],
"18765": [
"「음~, 기억 안 나.",
"어디에 뭐가 걸려 있었는지",
"그렇게 유심히 안 봤거든」"
],
"18766": [
"「있잖아...",
"쿠라이시 씨 때 흉기가",
"화살이었는데...」"
],
"18767": [
"「...왜 굳이 그런",
"특이한 걸 썼을까?」"
],
"18768": [
"「난 활 같은 거 못 당겨.",
"촬영 때 만져 봤는데",
"엄청난 힘이 필요하더라」"
],
"18769": [
"「초보자가 바로 당길 수",
"있는 게 아니야, 그거」"
],
"18770": [
"「그 테루테루보즈 말이야,",
"처음엔 2층 뚫린 복도에",
"있었다던데, 봤어?」"
],
"18771": [
"「그랬다더라.",
"언니가 그러던데」"
],
"18772": [
"「내가 방에 돌아가서 잔 뒤",
"얘기라서 직접은 못 봤어」"
],
"18773": [
"「아, 그렇겠구나」"
],
"18774": [
"「미사사기 씨는 봤지 않을까?",
"내가 방에 돌아갈 때 마침",
"방에서 나가시던데」"
],
"18775": [
"「...아~, 근데",
"화장실이었으면 못 봤으려나」"
],
"18776": [
"「아니, 부엌에 내려갔던",
"것 같아」"
],
"18777": [
"「흐응, 그렇구나」"
],
"18778": [
"「온실에 『복수』라고 적힌",
"종이가 있었잖아, 그거",
"언제 놓였을까」"
],
"18779": [
"「우리, 오고 나서 저택 안을",
"좀 돌아다녔거든...」"
],
"18780": [
"「그때 온실도 들여다봤는데",
"그런 건 없었어」"
],
"18781": [
"「그게 몇 시쯤이야?」"
],
"18782": [
"「아마 1시쯤이었을 거야」"
],
"18783": [
"「다른 사람들은 와 있었어?」"
],
"18784": [
"「아니...",
"아, 집사 씨는 있었어」"
],
"18785": [
"「벌써 그 차림으로",
"『어서 오십시오』라더라」"
],
"18786": [
"「집사로서 맞이한 거야?」"
],
"18787": [
"「응, 맞아.",
"벌써 카메라 돌아가냐고",
"물어본 게 기억나」"
],
"18788": [
"「온실에 있던 검은 고양이",
"장식품 말인데」"
],
"18789": [
"「아, 그거...」"
],
"18790": [
"「그거 보통 어디에 쓰는 거야?",
"그냥 장식품?」"
],
"18791": [
"「그렇지 않을까,",
"잘 모르겠지만」"
],
"18792": [
"「달리 쓸 데도 없어 보이니",
"그렇겠지」"
],
"18793": [
"「근데 이 저택에 원래",
"있던 것치고는 싸구려 같아」"
],
"18794": [
"「응, 나도 그렇게 생각해」"
],
"18795": [
"「여기 전화는 내선밖에",
"못 쓰지?」"
],
"18796": [
"「그런가 봐.",
"뭐, 일일이 옆방 안 가도",
"되니까 편하긴 하지만」"
],
"18797": [
"「옆방이면 시즈나?」"
],
"18798": [
"「응, 휴대폰도 안 되니까",
"내선 없었으면 언니 깰 때까지",
"문 두드려야 했을 거야」"
],
"18799": [
"「잠버릇이 나빠?」"
],
"18800": [
"「...뭐랄까",
"날마다 달라」"
],
"18801": [
"어떤 잠버릇이길래..."
],
"18802": [
"「오락실 라디오",
"직접 만져 본 적 있어?」"
],
"18803": [
"「그러고 보니 없네.",
"음악은 내 MD로 들으니까」"
],
"18804": [
"「응접실에 좀 이상한 가면이",
"걸려 있잖아」"
],
"18805": [
"「가면?",
"아, 뭔가 있었던 것 같은데",
"응접실이었나, 그거」"
],
"18806": [
"「응, 5개쯤 있어」"
],
"18807": [
"「...아~, 있었다 있었다.",
"어디 민예품 같은 거」"
],
"18808": [
"「그게 왜?」"
],
"18809": [
"「좀 무섭지 않아?」"
],
"18810": [
"「...오빠는",
"무서운 게 너무 많아」"
],
"18811": [
"그런가..."
],
"18812": [
"「현관홀에 있는",
"큰 시계 굉장하지」"
],
"18813": [
"「그거 얼마나 오래 돌아갔을까,",
"백 년은 거뜬히 갈 것 같아」"
],
"18814": [
"「골동품 같으니까",
"돌아갈지도 모르지」"
],
"18815": [
"「좋겠다, 그건 멋있어.",
"근데 우리 집엔 둘 데가 없어」"
],
"18816": [
"「우리 집도...」"
],
"18817": [
"「온실에 놓여 있던 방울은",
"무슨 장식일까」"
],
"18818": [
"「크리스마스트리 같은 데",
"다는 거 아냐?」"
],
"18819": [
"「역시 그렇지.",
"요즘에도 팔려나」"
],
"18820": [
"「그런 싸구려 장식은",
"천 원 숍 가면 널렸어」"
],
"18821": [
"「온실에 긴 못이",
"놓여 있었잖아?」"
],
"18822": [
"「못?",
"아, 그거」"
],
"18823": [
"「대못이라는 거지?」"
],
"18824": [
"「그런 걸 어디서 구해",
"오는 걸까.",
"이 집엔 원래 없었지?」"
],
"18825": [
"「없지 않을까, 아마」"
],
"18826": [
"「온실에 하늘하늘한 긴 장갑이",
"놓여 있었는데...」"
],
"18827": [
"「하늘하늘?",
"예복용 같은 거?」"
],
"18828": [
"「그런 것 같은데,",
"맞으려나」"
],
"18829": [
"「음~, 나도 그런 거",
"쓸 일이 없어서 모르겠어」"
],
"18830": [
"「그렇지.",
"평소에 쓸 만한 디자인은",
"아니었으니까」"
],
"18831": [
"「이번엔 손도끼가 놓여 있었어",
"온실에...」"
],
"18832": [
"「도끼?",
"싫다, 살벌하네」"
],
"18833": [
"「언제 갖다 놓는 걸까,",
"역시 한밤중인가?」"
],
"18834": [
"「그렇지 않을까.",
"낮엔 누가 볼지 모르니까」"
],
"18835": [
"「...온실에서 지키고 있으면",
"잡을 수 있지 않을까」"
],
"18836": [
"「그건 아무래도 경계할",
"테니까, 지키고 있으면",
"안 오지 않을까」"
],
"18837": [
"「그럴까」"
],
"18838": [
"「그치만... 온실에 집착하다가",
"범행이 들키면...」"
],
"18839": [
"「...나머지를 실행 못 하나.",
"그렇네...」"
],
"18840": [
"「...『복수』라고",
"할 정도니까...」"
],
"18841": [
"「온실에 작은 울타리가",
"놓여 있었는데...」"
],
"18842": [
"「울타리? 무슨?」"
],
"18843": [
"「잘 모르겠지만,",
"장식이나 원예용이나 그런 거」"
],
"18844": [
"「원예라...",
"관심 없거든, 가드닝 같은 거」"
],
"18845": [
"「나스 씨가 가져온",
"덤벨 알아?」"
],
"18846": [
"「아~, 엄청 많던데」"
],
"18847": [
"「일부러 집에서 가져오다니",
"대단하지」"
],
"18848": [
"「...그 사람 분명",
"그거 뺏으면 죽을걸」"
],
"18849": [
"「주, 죽는다고?」"
],
"18850": [
"「금단 증상 같은 걸로」"
],
"18851": [
"...있을 법해서 무섭다."
],
"18852": [
"「마다라이 씨 방에 있던",
"이상한 모양 지팡이 알아?」"
],
"18853": [
"「지팡이?",
"...아, 알아」"
],
"18854": [
"「언니가 구경했었어.",
"모양만 특이하지",
"평범한 지팡이였나 봐」"
],
"18855": [
"「응, 쓰기는 불편해 보이지만」"
],
"18856": [
"「실용품은 아니지 않을까?",
"장식용인지 뭔지 모르지만」"
],
"18857": [
"「그럴지도」"
],
"18858": [
"「이 저택엔 그림이 많이",
"걸려 있지」"
],
"18859": [
"「그러게.",
"그린 사람이 같은 것 같던데",
"모으시는 걸까」"
],
"18860": [
"「어? 전부?」"
],
"18861": [
"「응, 구석에 조그맣게",
"같은 사인이 있었거든」"
],
"18862": [
"「근데 잘 그리긴 했는데",
"처음 보는 그림뿐이야.",
"무명인 사람 건가」"
],
"18863": [
"「그렇지 않을까?",
"예쁘긴 하지만」"
],
"18864": [
"「응, 난 좋아」"
],
"18865": [
"「밖에 있는 차는 나스 씨랑",
"마다라이 씨 거지?」"
],
"18866": [
"「그럴 텐데?",
"엄청 오래돼 보이는 쪽이",
"마다라이 씨 거겠지」"
],
"18867": [
"「오래돼 보이는...",
"응, 그렇지」"
],
"18868": [
"「그건 그거대로 대단해.",
"사실 물건 같은 걸 꽤",
"아끼는 사람이었나」"
],
"18869": [
"안 그러면 못 타겠지,",
"저렇게 될 때까지..."
],
"18870": [
"「지하에 말이야, 뱀이 잔뜩",
"있었어...」"
],
"18871": [
"「진짜!?」"
],
"18872": [
"「어, 왜?",
"스즈나도 싫어해?」"
],
"18873": [
"「난 싫어하는데,",
"언니가...",
"키우고 싶어 해서 곤란해...」"
],
"18874": [
"시즈나한테는 자세한 장소를",
"알려 주지 말아야겠다."
],
"18875": [
"「스즈나는",
"평소에 컵라면 같은 거 먹어?",
"여기 잔뜩 있던데」"
],
"18876": [
"「음~, 좋아하는데 피부에 나빠서",
"잘 안 먹으려고 해」"
],
"18877": [
"배우는 힘들구나."
],
"18878": [
"「창고에 석궁이",
"있었는데...」"
],
"18879": [
"「석궁?",
"뭐야 그게, 살벌하네」"
],
"18880": [
"「어디 숨겨 두는 게",
"낫지 않아, 그거?」"
],
"18881": [
"「그렇지.",
"조심할게」"
],
"18882": [
"「복도에 내놓은",
"가구 있잖아?」"
],
"18883": [
"「어?",
"뭐야 그게, 그런 게 있었어?」"
],
"18884": [
"「아, 몰랐구나」"
],
"18885": [
"「못 봤어.",
"왜 그렇게 된 거야?」"
],
"18886": [
"「나스 씨가 운동 기구",
"들여놓는 데 방해된다고",
"방에서 빼 버렸대」"
],
"18887": [
"「...대체 얼마나 큰 걸",
"들여온 거야...」"
],
"18888": [
"「수면제 먹어 본 적 있어?」"
],
"18889": [
"「전에 딱 한 번",
"먹어 본 적 있는데...」"
],
"18890": [
"「너무 잘 들어서 무서웠어.",
"난 약발이 잘 받거든」"
],
"18891": [
"「말랐으니까 보통보다 적게",
"먹어야 하는 거 아냐?」"
],
"18892": [
"「그렇다니까.",
"적힌 대로 먹으면",
"너무 세, 곤란해」"
],
"18893": [
"「지하 방에",
"마리모가 있었는데」"
],
"18894": [
"「어머?",
"우리 언니가 좋아해서",
"집에서도 키워」"
],
"18895": [
"「솔직히 귀여운지 어떤지",
"잘 모르겠어.",
"동그랗기만 하잖아」"
],
"18896": [
"「뭐, 그렇지...」"
],
"18897": [
"「오히려 마리모한테 말 거는",
"언니가 더 재밌어」"
],
"18898": [
"...그건 좀 보고 싶다."
],
"18899": [
"「붉은 카메오라고 알아...?」"
],
"18900": [
"「그거 괴담 쪽 얘기?」"
],
"18901": [
"「괴담 아닌 쪽도 있어?」"
],
"18902": [
"「...뭐, 그렇지.",
"지금은 이제 없을 테지만」"
],
"18903": [
"「근데 난 그런 거 준다고",
"해도 절대 안 받아」"
],
"18904": [
"「그야 그렇지,",
"저주받는다며?」"
],
"18905": [
"「음~, 뭐 그렇지...」"
],
"18906": [
"...왠지 말끝을 흐리네."
],
"18907": [
"「온실 안쪽에서 이걸 찾았어」"
],
"18908": [
"「카세트?",
"뭐가 들어 있었어?」"
],
"18909": [
"「유리 깨지는 소리」"
],
"18910": [
"「...아, 그거구나.",
"흐응, 테이프였구나...」"
],
"18911": [
"「근데 왜 테이프일까.",
"MD도 CD도 아니고」"
],
"18912": [
"「어? 글쎄...",
"왜일까」"
],
"18913": [
"MD 같은 게 없었던 걸까."
],
"18914": [
"「오락실 데크 안에",
"검은 카세트테이프가 있었어」"
],
"18915": [
"「테이프?",
"뭐가 녹음돼 있어?」"
],
"18916": [
"「산사태 뉴스가",
"들어 있었어...」"
],
"18917": [
"「뉴스라니 설마,",
"우리가 들은 그거?」"
],
"18918": [
"「아니, 그게",
"우리가 들은 거랑 내용이",
"좀 달라」"
],
"18919": [
"「어? 어어?",
"무슨 소리야?」"
],
"18920": [
"「사고 현장이나",
"피해 내용이 다르니까",
"가짜가 아닌가 싶어서...」"
],
"18921": [
"「혹시",
"범인 짓이라는...거야?」"
],
"18922": [
"「그런 것 같다고",
"생각해」"
],
"18923": [
"「...라기보다, 그거 말고는",
"그런 걸 녹음한 테이프가",
"있을 이유가 생각 안 나」"
],
"18924": [
"「창고에 있던 석궁의",
"화살만 없어졌는데...」"
],
"18925": [
"「어? 뭐야 그게?",
"뭔가 위험한 거 아냐, 그거」"
],
"18926": [
"「나도 불길한 예감이 드는데",
"어떻게 해야 할지...」"
],
"18927": [
"「어쩌고 자시고, 쐈으면",
"어딘가에 화살이 박혀 있을",
"테니까 찾을 수밖에 없잖아」"
],
"18928": [
"「창고에 석궁이 있는데,",
"화살이 없어졌어...」"
],
"18929": [
"「...그거,",
"쿠라이시 씨의... 그거?」"
],
"18930": [
"「그런 것 같아.",
"달리 활이나 화살은 안 보이고」"
],
"18931": [
"「그거 원래 창고에 있던 거야?",
"범인이 가져와서 숨긴 게 아니라」"
],
"18932": [
"「액자 같은 데 들어 있어서",
"원래 장식품이었던 것 같아」"
],
"18933": [
"「...그럼 원래 있던 건가 봐.",
"이 집 여기저기 무기가 있고」"
],
"18934": [
"「이거 본 적 없어?」"
],
"18935": [
"「...만년필?",
"어디서 본 것 같은데",
"어디였더라...」"
],
"18936": [
"「적어도 우리 건 아니야.",
"언니 취향도 아니고」"
],
"18937": [
"스즈나는 누구 건지까지는",
"기억 못 하는 것 같다."
],
"18938": [
"「...뭐야 이거?",
"장난감치곤 투박하고,",
"부품치곤 조잡한 것 같고」"
],
"18939": [
"「그냥 잡동사니 아냐?」"
],
"18940": [
"「그럴까」"
],
"18941": [
"「그치만 어디 쓰는 건지",
"전혀 모르겠잖아」"
],
"18942": [
"「음~...",
"그렇긴 하지...」"
],
"18943": [
"「어느 거...?」"
],
"18944": [
"「음~?",
"뭘까, 난 꽃 이름 같은 건",
"하나도 모르거든...」"
],
"18945": [
"「역시 이것만으론",
"아는 사람 적겠지」"
],
"18946": [
"「그럴 거야.",
"참고로 언니도 하나도 몰라」"
],
"18947": [
"「근데 이거 왜 땅바닥에",
"떨어져 있어?」"
],
"18948": [
"「놓여 있었어,",
"온실의, 그...」"
],
"18949": [
"「뭐!?",
"거기에? 그 『복수』 어쩌고...」"
],
"18950": [
"「응, 맞아...」"
],
"18951": [
"「...왠지 그 얘기 들으니까",
"갑자기 섬뜩해 보여」"
],
"18952": [
"「...그렇지」"
],
"18953": [
"「임프라는 거 알아?",
"작은 악마 같은 거",
"라던데」"
],
"18954": [
"「하아? 뭐야 그게?」"
],
"18955": [
"「전혀 몰라?」"
],
"18956": [
"「그런 징그러울 것 같은 건",
"모르는데...」"
],
"18957": [
"「그런 거라면",
"나보다 언니가 더 잘 알아」"
],
"18958": [
"「단, 그런 얘기 꺼내면",
"무서운 얘기가 빠짐없이",
"잔뜩 따라올 거야」"
],
"18959": [
"「...안 따라와도 되는데...」"
],
"18960": [
"「무리.",
"언니는 사람 놀래키고",
"겁주는 게 취미거든」"
],
"18961": [
"「있잖아, 방 열쇠에",
"알파벳이 새겨져 있지 않아?」"
],
"18962": [
"「아, 새겨져 있어.",
"어디 보자... 『N』이야」"
],
"18963": [
"「N이구나, 고마워」"
],
"18964": [
"「오빠도 암호?」"
],
"18965": [
"「응, 신경 쓰여서.",
"스즈나는 풀었어?」"
],
"18966": [
"「설마.",
"난 전혀 모르겠어」"
],
"18967": [
"「언니는 신나서",
"순식간에 풀었지만」"
],
"18968": [
"「순식간에...」"
],
"18969": [
"「특기 분야니까.",
"뭐, 오빠도 힘내」"
],
"18970": [
"「스즈나 휴대폰은 어떤 거야?」"
],
"18971": [
"「내 건 좀 구형이야.",
"벌써 2년쯤 썼으니까」"
],
"18972": [
"「슬슬 바꾸고 싶은데",
"언니가 물건을 오래 써서」"
],
"18973": [
"「같이 안 하면 못 바꿔?」"
],
"18974": [
"「커플폰이 아니게 되면",
"삐지거든, 언니가」"
],
"18975": [
"좀 귀엽다고 생각해 버렸다."
],
"18976": [
"「스즈나네는",
"택시 타고 왔지?」"
],
"18977": [
"「응, 뭐.",
"중간부터지만」"
],
"18978": [
"「중간?」"
],
"18979": [
"「언니가",
"꼭 케이블카를 타고",
"싶다고 떼써서」"
],
"18980": [
"「케이블카...",
"아, 그러고 보니 산길",
"중간에 역을 본 것 같아」"
],
"18981": [
"「아마 우리가 택시",
"탄 데가 거기일 거야」"
],
"18982": [
"「전화번호부로 근처 택시 회사",
"찾아서 불러 뒀거든」"
],
"18983": [
"「그럼 기차역 쪽에서",
"누굴 만나거나 하진 않았어?」"
],
"18984": [
"「그렇네, 역에서 버스로",
"케이블카 타는 데까지 갔으니까」"
],
"18985": [
"「아니, 난 소스파.",
"언니가 아무리 노려봐도",
"이것만은 양보 못 해」"
],
"18986": [
"「노려봐?」"
],
"18987": [
"「언니는 육수파거든.",
"20년 싸워서 이것만은",
"양보 안 했어」"
],
"18988": [
"계속 싸우고 있는 건가..."
],
"18989": [
"「손으로 반죽한 햄버그",
"만들 줄 알아?」"
],
"18990": [
"「하아?",
"뭐, 못 만들 건",
"없지만...」"
],
"18991": [
"「근데 언니한테",
"부탁하는 건 관두는 게 좋아」"
],
"18992": [
"「그런 장난치기 딱 좋은 요리,",
"안에 뭐가 숨겨져서",
"나올지 몰라」"
],
"18993": [
"...장난치기 딱 좋은 요리라니."
],
"18994": [
"「스즈나,",
"아게다시 두부 좋아해?」"
],
"18995": [
"「아게다시?",
"음~, 굳이 따지자면",
"두부는 히야얏코가 좋아」"
],
"18996": [
"「...두부 먹고 싶어졌잖아」"
],
"18997": [
"「미, 미안.",
"무사히 돌아가면 언젠가",
"대접할게」"
],
"18998": [
"「진짜지?",
"약속이야?」"
],
"18999": [
"「스즈나는",
"담배 안 피우지?」"
],
"19000": [
"「...질렸어」"
],
"19001": [
"「그것만큼 언니가",
"쓸데없는 짓 하기 쉬운",
"물건도 없거든...」"
],
"19002": [
"「내용물이 전부 담배 초콜릿으로",
"바뀐 건 그나마 나았어」"
],
"19003": [
"「전부 타르 50밀리짜리",
"말도 안 되는 담배로",
"바꿔 놨을 땐 울 뻔했어...」"
],
"19004": [
"「...저기...",
"그건 시즈나 딴에는",
"담배 끊으라는 뜻으로...?」"
],
"19005": [
"「아니, 끊으니까",
"아쉬워했으니 아닐 거야」"
],
"19006": [
"순수하게 장난치고 싶었을",
"뿐인 건가..."
],
"19007": [
"「응, 하나 받았어.",
"맛있었어」"
],
"19008": [
"「...거의 다",
"언니가 마셨지만」"
],
"19009": [
"「있잖아...",
"접이식 사다리 좋아해?」"
],
"19010": [
"「너도야?」"
],
"19011": [
"「언니가",
"엄청 좋아하는데...」"
],
"19012": [
"「가끔 넋 놓고 바라보는데",
"어디가 좋은지 모르겠어...」"
],
"19013": [
"나도 모르겠다..."
],
"19014": [
"「스즈나, 양산 써?」"
],
"19015": [
"「야, 양산?」"
],
"19016": [
"「어~, 난...",
"별로 안 쓰는... 것 같아」"
],
"19017": [
"「저기, 내가 뭔가",
"이상한 걸 물었나...」"
],
"19018": [
"「아니, 알아,",
"햇볕에 타는 거 신경 쓰는 게",
"좋다는 건」"
],
"19019": [
"「그래서 촬영 있을 땐 되도록",
"쓰는데, 평소에까지 그런",
"거추장스러운... 어, 그...」"
],
"19020": [
"「벼, 별로 안 쓸 거면",
"안 써도 된다고 봐...?」"
],
"19021": [
"「그, 그래?",
"이상하지 않아?」"
],
"19022": [
"「...여자가 돼서",
"너무 털털하다고 생각 안 해?」"
],
"19023": [
"「안 해, 그런 거.",
"우리 누나도 안 쓰는걸」"
],
"19024": [
"「뭐야, 그래?」"
],
"19025": [
"「그렇지,",
"안 쓰는 사람도 많이",
"있지?」"
],
"19026": [
"「누가 뭐라고 했어?」"
],
"19027": [
"「...소속사 사장님이",
"잔소리가 심해...」"
],
"19028": [
"「히, 힘들겠다」"
],
"19029": [
"배우니까 신경 좀 쓰라고",
"혼나거나 하나 보다."
],
"19030": [
"「부엌 같은 데서",
"와인 잔 본 기억 없어?」"
],
"19031": [
"「와인 잔?」"
],
"19032": [
"「아~, 없었어.",
"찾아봤는데 없어서",
"그냥 컵 썼...」"
],
"19033": [
"「스, 스즈나?」"
],
"19034": [
"「...저기, 설마",
"어디 다른 데 있었어?」"
],
"19035": [
"「응, 2층 창고에」"
],
"19036": [
"「그건, 저기,",
"금방 찾을 만한 데야?」"
],
"19037": [
"「아니, 선반 안에",
"상자에 들어 있어서",
"얼핏 봐서는...」"
],
"19038": [
"「...애매하네.",
"아니, 그래도...」"
],
"19039": [
"「창고는 언니도",
"봤을 테니까...」"
],
"19040": [
"「뭐가?",
"뭐 곤란한 일이라도?」"
],
"19041": [
"「있는데 없었다고",
"말해 버렸으니까,",
"벌이 올지도...」"
],
"19042": [
"「...아, 아니, 괜찮아.",
"신경 쓰지 마...」"
],
"19043": [
"왠지 고생스러워 보인다..."
],
"19044": [
"「스즈나,",
"히오리 전부터 알았어?」"
],
"19045": [
"「아~...",
"언니는 몇 번 같은 드라마에",
"나온 적 있나 본데」"
],
"19046": [
"「스즈나는 처음 만나는구나」"
],
"19047": [
"「? 왜 그래?",
"뭔가 이상한 뜸이...」"
],
"19048": [
"「아~, 아니, 그게, 그 사람",
"무슨 사극에서 본 것 같은데",
"기억이 안 나서」"
],
"19049": [
"「뭐였더라...",
"양아치 같은 역을",
"했었는데」"
],
"19050": [
"「양아치...」"
],
"19051": [
"「응, 야쿠자 똘마니라나?",
"그런 녀석이었는데, 포졸한테",
"덤볐다가 나가떨어졌어」"
],
"19052": [
"「그, 그렇구나」"
],
"19053": [
"「근데 실물은",
"엄청 느긋한 사람이네」"
],
"19054": [
"「마다라이 씨 말인데...」"
],
"19055": [
"「난 싫어」"
],
"19056": [
"「어? 아, 그래...?」"
],
"19057": [
"「눈빛이 음흉하잖아.",
"성희롱이야 성희롱」"
],
"19058": [
"어지간히 싫은 모양이다."
],
"19059": [
"「츠바키 군은 배역이랑",
"원래 성격이 꽤 다른가 봐」"
],
"19060": [
"「아~, 드문 거 아냐?",
"그런 딱딱해 보이는 역」"
],
"19061": [
"「요전에 드라마에서 봤을 땐",
"학원물 불량아 역이었거든」"
],
"19062": [
"「아, 어울릴 것 같아」"
],
"19063": [
"「좋겠다~, 드라마...」"
],
"19064": [
"부러운 모양이다..."
],
"19065": [
"「나스 씨는...",
"평소엔 평범하게 배우 하시나」"
],
"19066": [
"「그야 하고 있지 않겠어?",
"상상은 안 가지만」"
],
"19067": [
"「역시...?」"
],
"19068": [
"「그치만 애초에 왜 배우가",
"됐는지 수수께끼잖아, 그 사람」"
],
"19069": [
"「내가 그 체격이었으면",
"망설임 없이 프로레슬러 됐을걸」"
],
"19070": [
"그런데 배우를 하는 걸 보면",
"역시 연기를 좋아해서일까."
],
"19071": [
"「쿠라이시 씨는 엄청",
"베테랑이야?」"
],
"19072": [
"「그야 당연히, 연극계의 보물이지!",
"멋있지~?」"
],
"19073": [
"「조, 좋아하는구나」"
],
"19074": [
"「그치만 멋있잖아!",
"검술 연기가 엄청 잘한대」"
],
"19075": [
"「흐응...",
"대단한 사람이구나」"
],
"19076": [
"「그렇다니까, 너도 존경해」"
],
"19077": [
"「그러니까, 시즈나...",
"가 언니 맞지?」"
],
"19078": [
"「응, 내가 동생.",
"뭐 나이는 같지만」"
],
"19079": [
"「쌍둥이니까.",
"몇 살이더라?」"
],
"19080": [
"「스무 살」"
],
"19081": [
"「...근데 왠지",
"언니는 몇 살인지 모르겠다는",
"말을 자주 듣더라...」"
],
"19082": [
"「흐응?",
"왜일까」"
],
"19083": [
"「아마... 취미라든가,",
"이것저것...」"
],
"19084": [
"「뭐, 좀 특이하긴 한데",
"저래 봬도 천재야」"
],
"19085": [
"「천재라면 연기력 말이지?」"
],
"19086": [
"「맞아, 그렇게 멍한",
"얼굴로 막상 무대에 서면",
"싹 변한다니까」"
],
"19087": [
"「헤에...」"
],
"19088": [
"「말해 두는데,",
"찝쩍대지 마」"
],
"19089": [
"「아, 안 해 안 해」"
],
"19090": [
"「스즈나네는",
"이 근처가 고향이야?」"
],
"19091": [
"「음~, 가깝다곤 못 해도",
"뭐 이 근처지」"
],
"19092": [
"「같은 현 안쯤?」"
],
"19093": [
"「그렇지.",
"산 하나 너머니까」"
],
"19094": [
"「꼬, 꽤 멀다...」"
],
"19095": [
"「오히려 간사이에 가깝지,",
"우리 본가는」"
],
"19096": [
"「실제로 외가 쪽 시골은 효고고」"
],
"19097": [
"「미사사기 씨는",
"평소에도 늘 그래?」"
],
"19098": [
"「언제 만나도 그런",
"느낌인데?」"
],
"19099": [
"「그렇구나, 원래 그렇구나...」"
],
"19100": [
"「상냥하고 좋은 사람이잖아」"
],
"19101": [
"「...좀 천연이지만」"
],
"19102": [
"역시 그렇게 생각하는구나..."
],
"19103": [
"「나구모 씨라는 사람,",
"안 오네...」"
],
"19104": [
"「....오빠 말이야」"
],
"19105": [
"「진짜 나구모 씨 아니야?」"
],
"19106": [
"「뭐!?",
"아, 아니야, 진짜로!」"
],
"19107": [
"「음~, 뭐 배우로는",
"안 보이지만...」"
],
"19108": [
"「응, 아니야 아니야.",
"평범한 대학생」"
],
"19109": [
"「뭐, 평범해 보이지도 않지만」"
],
"19110": [
"「...저기, 그건",
"무슨...」"
],
"19111": [
"「너 자각 없어?」"
],
"19112": [
"나, 평범하지 않은 건가..."
],
"19113": [
"「스즈나는 모자 장수라는",
"사람은 잘 몰라?」"
],
"19114": [
"「세상에 소문난 정도밖에",
"몰라」"
],
"19115": [
"「근데 수상하지.",
"왜 정체를 숨기는 걸까」"
],
"19116": [
"「...왜일까?」"
],
"19117": [
"「절대 수상해.",
"분명 무슨 비밀이 있는 거야」"
],
"19118": [
"「비밀이라니?」"
],
"19119": [
"「...그건 모르겠지만」"
],
"19120": [
"「그래도 수상하잖아~!」"
],
"19121": [
"「스즈나는 다카토 엔지로를",
"전부터 알았어?」"
],
"19122": [
"「이름만.",
"언니가 좋아하거든」"
],
"19123": [
"「그래서 집에 책이 있어서",
"내 역이 나오는 것만",
"읽어 봤는데...」"
],
"19124": [
"「무슨 얘기야?」"
],
"19125": [
"「어~... 그게,",
"『악마』가 붙어 있던 거밖에",
"기억 안 나」"
],
"19126": [
"「이번 연극이랑은 딱히",
"관계없는 것 같았고」"
],
"19127": [
"「흐응...",
"원작에서 따온 건",
"이름뿐이라는 건가」"
],
"19128": [
"「그런가 봐」"
],
"19129": [
"「저기, 있잖아...",
"마다라이 씨 말인데...」"
],
"19130": [
"「방에서 나가서 그런 데서",
"죽어 있다니...」"
],
"19131": [
"「설마 살해당할 거라곤",
"꿈에도 생각 못 했겠지.",
"진심으로...」"
],
"19132": [
"「츠바키 군에 대해 뭔가...",
"기억나는 거 없어?」"
],
"19133": [
"「...집사 씨 말이구나」"
],
"19134": [
"「딱히 기억에 걸리는",
"건 없는데...」"
],
"19135": [
"「왜 방에서 나갔을까",
"하는 건 신경 쓰여」"
],
"19136": [
"「그렇게 아침 일찍 지하실에",
"볼일이라니 이상하잖아」"
],
"19137": [
"「볼일이 있어서 내려갔다면",
"범인은 그걸 어떻게",
"알았냐는 게 되지 않아?」"
],
"19138": [
"「아, 그렇구나.",
"그럼 불려 나갔나?」"
],
"19139": [
"「어떻게 불러내면 될지는",
"모르겠지만」"
],
"19140": [
"「음~...",
"시간이 시간이니까」"
],
"19141": [
"「근데 말만 잘하면",
"집사라는 입장은 다른 사람보다",
"불러내기 쉬울지도」"
],
"19142": [
"「입장?」"
],
"19143": [
"「보일러가 고장 났다거나",
"열쇠가 안 열린다거나 하면",
"집사한테 말하는 게 자연스럽잖아」"
],
"19144": [
"「아, 확실히...",
"그런 일이면 나라도 일단",
"츠바키 군한테 말하겠다」"
],
"19145": [
"「다만 왜 이런 새벽에",
"하고 의심 안 하고 방을 나섰는지",
"모르겠지만」"
],
"19146": [
"「새벽인 건 잠이 안 왔다고",
"하면 무리도 아니니까",
"이상하게 안 여기지 않을까」"
],
"19147": [
"「오히려 열쇠나 보일러 같은",
"꾀어낼 구실이 거짓말이라고",
"들키지 않게 하는 쪽이...」"
],
"19148": [
"「...우리한텐",
"그쪽이 오히려 쉬워」"
],
"19149": [
"「그럴듯한 구실만",
"생각해 내면",
"나머진 연기만 하면 되니까」"
],
"19150": [
"「그렇구나...",
"그렇겠지...」"
],
"19151": [
"「이만한 걸 계획한 범인이면",
"구실 정도는 처음부터",
"생각해 뒀을지도 몰라」"
],
"19152": [
"「...나스 씨 얘기",
"말인데...」"
],
"19153": [
"「조금만 더...",
"남의 말을 들으셨으면 좋았을걸」"
],
"19154": [
"「...응...」"
],
"19155": [
"「문 잠그라고 다들",
"그렇게 말했는데...」"
],
"19156": [
"「그게...",
"쿠라이시 씨 일인데...」"
],
"19157": [
"「...마음이 무거워」"
],
"19158": [
"「돌아가신 것도 충격이긴",
"한데... 뭐랄까...」"
],
"19159": [
"「...그렇게 경계했는데도",
"소용없었다니...」"
],
"19160": [
"（...그렇구나...）"
],
"19161": [
"（가장 경계하던 사람이 그렇게",
"돼 버렸으니까...）"
],
"19162": [
"자기도 이제 뭘 해도 소용없을지",
"모른다는 기분이 드는 거겠지."
],
"19163": [
"（...어떻게 해야 하지...）"
],
"19164": [
"「나구모 씨 말인데...」"
],
"19165": [
"「기분 나쁜 얘기지만, 역시",
"나구모 씨 수상하지 않아?」"
],
"19166": [
"「...스즈나는",
"그렇게 생각해?」"
],
"19167": [
"「오빠는?」"
],
"19168": [
"「난 솔직히 아직 모르겠어.",
"어쩌면 우물 속에서 죽은 사람이",
"그 사람일지도 모르고...」"
],
"19169": [
"「아, 그렇구나.",
"죽어서 못 온 거라는",
"것도 있겠네」"
],
"19170": [
"「근데 그러면 주차장 녀석은",
"누구냐는 얘기가 되잖아」"
],
"19171": [
"「주차장 쪽이 나구모 씨라고",
"해도 우물 속 사람은 누구...」"
],
"19172": [
"「그거야말로 오빠처럼",
"길을 잃었다가 우연히 범인을",
"본 사람 아냐?」"
],
"19173": [
"「오빠도 처음에 맞고",
"기절했었잖아?」"
],
"19174": [
"「어, 응, 뭐」"
],
"19175": [
"「오빠 경우엔",
"순순히 기절해서 살았지만",
"우물 사람은 저항했을지도」"
],
"19176": [
"「그래서...",
"어쩔 수 없이 살해당했다...?」"
],
"19177": [
"「그런 것 같아.",
"실제로 오빠 쪽은",
"살았잖아?」"
],
"19178": [
"「그러니까 오빠가 정원에서",
"걸려 넘어진 사람이 우물 속",
"사람이고, 관계없는 사람이고...」"
],
"19179": [
"「...나구모 역의 누군가는",
"살아서 어딘가 숨어 있을 거야」"
],
"19180": [
"「...스즈나, 저기,",
"그 나구모 씨 역의 사람이...」"
],
"19181": [
"스즈나는 순간 흠칫하더니",
"어색하게 말끝을 흐렸다."
],
"19182": [
"「...나구모 씨라고 해서",
"얼버무리는 건 비겁하지」"
],
"19183": [
"「괜찮아.",
"그래, 내가 의심하는 건",
"...시쿠라 씨야」"
],
"19184": [
"「그치만...",
"나구모 씨 역은 아무리 봐도",
"그 사람밖에 없잖아?」"
],
"19185": [
"「다키 프로고, 이 타이밍에",
"같은 산속에 있었다던데」"
],
"19186": [
"「전혀 관계없는데 우연히",
"같은 곳에 있다가 행방불명",
"되는 일이 있을 것 같아?」"
],
"19187": [
"「그건...",
"우연치고는 좀...",
"싶긴 하지만...」"
],
"19188": [
"「그렇지...",
"그럼 나구모 씨 역이라면",
"왜 안 오시냐는 거잖아」"
],
"19189": [
"「...난 사실 벌써",
"진작 와서 계속 숨어 있는",
"거라고밖에 생각 안 돼...」"
],
"19190": [
"스즈나가 의심하는 것도 당연하고",
"있을 수 있는 일이라고 생각한다."
],
"19191": [
"（만약 그렇다면...）"
],
"19192": [
"（...우물 속 사람은",
"왜 이런 곳에 있었던 거지...?）"
],
"19193": [
"아무래도 수수께끼가 남는다."
],
"19194": [
"「스즈나는 시쿠라 긴지 씨라는",
"사람 알아?」"
],
"19195": [
"「시쿠라 씨라...",
"몇 번 얼굴은 봤을 텐데",
"별로 얘기해 본 적은 없어」"
],
"19196": [
"「그렇구나.",
"배우로서 아는 정도?」"
],
"19197": [
"「...라기보다, 언니가",
"만난 적이 있어서 얘기로만",
"듣고 아는 느낌」"
],
"19198": [
"「있잖아...",
"이케우치 리나 씨라고 알아?」"
],
"19199": [
"「뭐?",
"아니, 그야 같은 소속사였으니까",
"알지만...」"
],
"19200": [
"「왜 갑자기?",
"저기, 일단 말해 두는데",
"이미 세상 떠났어?」"
],
"19201": [
"「아, 응, 그건 알아.",
"서재에 있던 주간지에서 봤어」"
],
"19202": [
"「...아, 그런 거구나」"
],
"19203": [
"「있잖아, 그 기사 헛소문이야」"
],
"19204": [
"「헛소문!?",
"헛소문이라니... 오디션에",
"떨어져서 자살했다는 게...?」"
],
"19205": [
"「아니, 그건 사실인데",
"떨어진 이유가 모자 장수가",
"참견해서라는 부분」"
],
"19206": [
"「그 오디션, 모자 장수는",
"아무 관계도 없었거든」"
],
"19207": [
"「어...?",
"그럼 왜 그런 얘기가 됐어?」"
],
"19208": [
"「모자 장수 눈에 들었다고",
"하면 주목받으니까겠지」"
],
"19209": [
"「어? 그럼...",
"일부러 헛소문을 퍼뜨렸다고?」"
],
"19210": [
"「오디션 주최 측이 일부러",
"퍼뜨린 소문이었나 봐」"
],
"19211": [
"「우리 사장님이 어디서 듣고",
"길길이 화내는 걸 우연히",
"옆에 있다가 들었거든」"
],
"19212": [
"「그래...?",
"그치만 모자 장수가 모른다고",
"하면 금방 들통날 일을...」"
],
"19213": [
"「그치만 모자 장수는 전혀 사람들",
"앞에 안 나오고, 코멘트 낸 적도",
"없는걸」"
]
}