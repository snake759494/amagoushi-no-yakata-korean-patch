],
"13611": [
"「방 열쇠에 알파벳이",
"새겨져 있을 텐데요...」"
],
"13612": [
"「네, 있어요.",
"아주 작게지만요」"
],
"13613": [
"「제 건 『B』네요」"
],
"13614": [
"「B군요,",
"감사합니다」"
],
"13615": [
"「이건",
"무슨 표시일까요?」"
],
"13616": [
"「방 이름과도 대응하지",
"않는 것 같고,",
"같은 글자인 방도 있고요」"
],
"13617": [
"「뭔가, 암호래요」"
],
"13618": [
"「암호, 라고요...?」"
],
"13619": [
"「그건, 저, 풀어도",
"괜찮은 걸까요」"
],
"13620": [
"「그치만 암호에는 비밀이",
"적혀 있는 거 아닌가요?」"
],
"13621": [
"「알아 버려서, 그,",
"닌자나 스파이 같은 사람이",
"쫓아오는 일은...」"
],
"13622": [
"「아, 안 그래요.",
"그런 일 없으니까요」"
],
"13623": [
"뭔가 엄청난 오해와 착각이",
"있는 것 같은데, 어디서부터",
"정정해야 할지 모르겠다...."
],
"13624": [
"「하다못해 휴대폰이 터지면",
"좀 더 안심될 텐데요」"
],
"13625": [
"「...그렇네요...」"
],
"13626": [
"「저, 미안해요,",
"제 휴대폰 때문에 다들",
"놀라게 해서...」"
],
"13627": [
"「네? 그런 건",
"이제 괜찮아요」"
],
"13628": [
"「음,",
"미사사기 씨 휴대폰은",
"어떤 거예요?」"
],
"13629": [
"「평소 알람을 써서",
"전원을 계속 켜 둬요」"
],
"13630": [
"「약 먹는 시간이었죠」"
],
"13631": [
"「네.",
"꽃가루 알레르기 약을...」"
],
"13632": [
"「먹어 두지 않으면 도저히",
"여러분 앞에 나설 수 있는",
"상태가 아니게 돼요」"
],
"13633": [
"괴롭다고는 들었지만,",
"미사사기 씨는 꽤 심한가 보다."
],
"13634": [
"「비교적 최근에 바꿨는데,",
"아직 모르는 기능이 많아서...」"
],
"13635": [
"「일단 타이머로 쓸 수 있는",
"걸로 해 달라고 했더니",
"뭔가 너무 많아서 곤란했어요」"
],
"13636": [
"「요즘 휴대폰은",
"대부분 알람 기능이 있죠」"
],
"13637": [
"「그런가 봐요.",
"다른 건 딱히 필요 없다고",
"말했는데...」"
],
"13638": [
"「...오히려 그런 건",
"요즘엔 없다고 하더라고요」"
],
"13639": [
"하긴 카메라나 인터넷이나",
"다 달린 게 보통이니까...."
],
"13640": [
"「미사사기 씨는 택시로",
"오신 게 아니었죠」"
],
"13641": [
"「네, 사무소 차로",
"데려다 주셨어요」"
],
"13642": [
"「도쿄에서요?」"
],
"13643": [
"「마침 간사이 쪽에 일이",
"있는 분이 계셔서",
"같이 가자고 해 주셨어요」"
],
"13644": [
"「그랬군요.",
"그분은 바로 돌아가셨",
"나요?」"
],
"13645": [
"「네, 제가 도착했을 땐 이미",
"비가 내리기 시작해서...」"
],
"13646": [
"「길이 험해지기 전에",
"내려가겠다고 하시고",
"바로 돌아가셨어요」"
],
"13647": [
"「아, 그럼 제가 산에 들어온",
"쯤이었으려나...」"
],
"13648": [
"「어머, 그럼 어딘가에서",
"스쳐 지나갔을지도",
"모르겠네요」"
],
"13649": [
"...어두워진 뒤로는",
"다른 차를 못 봤으니,",
"스쳤다면 산기슭 근처려나."
],
"13650": [
"「아카시야키 좋아하세요?」"
],
"13651": [
"「아카시야키...?」"
],
"13652": [
"「저, 그건 어떤",
"음식인가요?」"
],
"13653": [
"「음, 먹는 거... 맞죠?」"
],
"13654": [
"「저, 다코야키랑 같은데",
"소스 대신 국물에 찍어",
"먹는 걸 아카시야키라고...」"
],
"13655": [
"「어머!",
"그랬어요?」"
],
"13656": [
"「...다른 거였다니.",
