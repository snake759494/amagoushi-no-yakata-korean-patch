],
"13699": [
"「아, 저기, 빌리고 싶다든가",
"그런 게 아니에요」"
],
"13700": [
"「어머, 아니었어요?",
"미안해요, 제가 또",
"지레짐작을...」"
],
"13701": [
"「아뇨, 저야말로」"
],
"13702": [
"하얀 우산이었으면 정말로 빌려야",
"하는 처지가 될 뻔했다.",
"색이 달라서 다행이다...."
],
"13703": [
"「부엌 같은 데서 와인잔",
"보신 적 없어요?」"
],
"13704": [
"「와인잔...",
"어머, 그러고 보니",
"찬장엔 없었네요」"
],
"13705": [
"「칵테일잔이나",
"브랜디잔은 있었는데」"
],
"13706": [
"「그렇군요,",
"감사합니다」"
],
"13707": [
"「여기 주인분은",
"와인을 싫어하시나 봐요」"
],
"13708": [
"「그래도 지하에 놔두지",
"않았던가요?」"
],
"13709": [
"「어머, 그랬죠.",
"그럼 분명",
"와인잔을 싫어하시는 거네요」"
],
"13710": [
"「식기에도 사람마다",
"호불호가 있으니까요」"
],
"13711": [
"「예를 들면 저희 할아버지는",
"굽 달린 잔은 전부",
"싫어하세요」"
],
"13712": [
"「그런 건 부자연스럽다고",
"우기셔서,",
"저희 집엔 하나도 없어요」"
],
"13713": [
"별의별 취향이",
"다 있구나...."
],
"13714": [
"「미사사기 씨는 히오리를",
"전부터 아셨어요?」"
],
"13715": [
"「아뇨, 공교롭게도",
"히오리 씨는 잘 몰라요」"
],
"13716": [
"「몇 번 뵌 적은",
"있을 텐데요...」"
],
"13717": [
"「사람 이름을 외우는 게",
"서툴러서요」"
],
"13718": [
"「마다라이 씨는, 저...",
"배우 중에선 베테랑인가요?」"
],
"13719": [
"「네, 그래요.",
"아역 시절부터 지금까지 쭉",
"연기 한길이시래요...」"
],
"13720": [
"「하지만 오랫동안 히트작을",
"못 만났다고 본인이",
"말씀하셨어요」"
],
"13721": [
"「네, 저, 그건",
"전부터 아는 사이라 얘기해",
"보신 적 있다는 거예요?」"
],
"13722": [
"「네, 가끔 같은 무대에서",
"뵙는 정도지만요」"
],
"13723": [
"혹시 만나는 사람마다",
"같은 푸념을 하는 건가...."
],
"13724": [
"「음, 츠바키 군 말인데...」"
],
"13725": [
"「부지런하고 예의 바른",
"집사분이죠」"
],
"13726": [
"「그렇죠.",
"아주 정중하잖아요」"
],
"13727": [
"가끔 뭔가 흐트러지지만."
],
"13728": [
"「저희 집에도 유모라면",
"있지만요...」"
],
"13729": [
"「집사는 없었어요」"
],
"13730": [
"미사사기 씨네 집은 대체...."
],
"13731": [
"「음...",
"나스 씨는 전부터",
"아셨어요?」"
],
"13732": [
"「아뇨, 별로 얘기해 본 적은",
"없었는데요...」"
],
"13733": [
"「...그, 개성적인 분이네요」"
],
"13734": [
"「쿠라이시 씨와는 전부터",
"아는 사이세요?」"
],
"13735": [
"「그렇죠, 몇 번 다른 일로",
"함께 일한 적이 있어요」"
],
"13736": [
"「요즘은 큰 역할은 별로",
"안 하시는 것 같아서, 뵐",
"기회가 없었지만요」"
],
"13737": [
"「좀 더 젊으셨을 땐",
"영화에서도 중요한 역할을",
"맡으신 적도 있어요」"
],
"13738": [
"「시즈나 짱은",
"미사사기 씨가 보기에 어때요?",
"연기라든가...」"
],
"13739": [
"「아주 잘해요.",
"부러워요」"
],
"13740": [
"「그렇게요?」"
],
"13741": [
"「네, 그분은 분명",
"배우가 되려고 태어난",
"거나 마찬가지일 거예요...」"
],
"13742": [
"「...와...」"
],
"13743": [
"그렇게 잘하는구나, 시즈나 짱.",
"평소엔 전혀 그렇게 안 보이는데",
"대단하네...."
],
"13744": [
"「스즈나 짱이랑 같은 연극에",
"나오신 적 있어요?」"
],
"13745": [
"「아뇨, 시즈나 씨와는 함께한",
"적이 있지만요...」"
],
"13746": [
"「동생분도 연기를 하셨다니",
"몰랐어요」"
],
"13747": [
"「쌍둥이였다는 것도",
"여기 와서 처음 알았을 정도예요」"
],
"13748": [
"「똑같은 얼굴의 아가씨가 한 명 더",
"계셔서 정말 깜짝 놀랐어요」"
],
"13749": [
"한쪽만 알고 있었다면 더더욱",
"놀랐겠지...."
],
"13750": [
"「미사사기 씨는 평소에 어떤",
"일을 하세요?」"
],
"13751": [
"「평소엔 지방 무대",
"일이 많아요」"
],
"13752": [
"「지방이요?」"
],
"13753": [
"「네, 오사카나 나고야나,",
"얼마 전까진 도호쿠에 갔었어요」"
],
"13754": [
"「나구모 씨...",
"안 오는 것 같네요」"
],
"13755": [
"「네, 무사하시면",
"좋겠는데요...」"
],
"13756": [
"「모자 장수라는 사람 평판은",
"전부터 알고 계셨어요?」"
],
"13757": [
"「네, 이것저것...」"
],
"13758": [
"「의뢰를 받아 쓰는 게 아니라",
"다 쓴 작품을 영화사에",
"판다든가...」"
],
"13759": [
"「아, 그리고 여러 사람의",
"공동 필명이라든가...」"
],
"13760": [
"「그 사람들만 아는 비밀",
"암호나 코드네임이 있다든가」"
],
"13761": [
"「어, 어떤 소문이에요」"
],
"13762": [
"「그리고...",
"각본을 쓰기 전에 폭포를 맞는",
"의식을 치르신다든가」"
],
"13763": [
"소문에 이상한 살이 붙었겠지만",
"전부 사실이라면 꽤 유쾌한",
"집단이겠네...."
],
"13764": [
"「미사사기 씨는 다카토 노부지로라는",
"작가 작품 읽어 보셨어요?」"
],
"13765": [
"「아뇨, 부끄럽지만 별로",
"읽어 본 적이 없어요」"
],
"13766": [
"「하지만 예전에 영화로 된 건",
"몇 편 봤어요」"
],
"13767": [
"「영화는 멋졌어요.",
"영상이 아주 독특한 분위기라」"
],
"13768": [
"「...다만,",
"조금 무서웠지만요」"
],
"13769": [
"「으...",
"무서워요...?」"
],
"13770": [
"「원래 그런",
"으스스한",
"작풍의 분이시잖아요?」"
],
"13771": [
"「그래서",
"저는 좀 서툴러서...」"
],
"13772": [
"「하하, 저도 그런 거",
"꽤 못 봐요...」"
],
"13773": [
"「저, 마다라이 씨에 대해서...」"
],
"13774": [
"「무슨 이야기를 하면....",
"저, 더는 아무것도... 모를",
"것 같은데요...」"
],
"13775": [
"「아, 저, 죄송해요.",
"그럼 뭔가 떠오른 게",
"있으면 알려 주세요」"
],
"13776": [
"「......누가...」"
],
"13777": [
"「누가 그런 끔찍한 짓을...",
"했다고 생각하세요...?」"
],
"13778": [
"「저도... 모르겠어요」"
],
"13779": [
"「.....그렇군요」"
],
"13780": [
"「츠바키 군에 대해서...",
"뭔가, 그...」"
],
"13781": [
"「...가엾어요...」"
],
"13782": [
"「아직 젊은데...",
"모든 게 이제부터였을 텐데」"
],
"13783": [
"「...미안해요.",
"도움이 될 만한 건 저는 아무것도",
"모르는 것 같아요...」"
],
"13784": [
"「아, 네... 죄송해요」"
],
"13785": [
"「저... 나스 씨에 대한",
"건데요...」"
],
"13786": [
"「아, 아아, 나스 씨...",
"나스 씨는....」"
],
"13787": [
"「뭔가 눈치챈 거라도",
"있으세요?」"
],
"13788": [
"「아뇨, 그런 게 아니에요.",
"미안해요...」"
],
"13789": [
"「왠지 아직 믿기지 않아서.",
"나스 씨가 이제... 그...」"
],
"13790": [
"그렇게 튼튼해 보이던 사람이었으니.",
"나도 아직 믿기지 않는다...."
],
"13791": [
"「쿠라이시 씨에 대해서, 저...」"
],
"13792": [
"「....그때...」"
],
"13793": [
"「처음에 쿠라이시 씨가 방에",
"틀어박히겠다고 했을 때, 더...",
"강하게 말렸어야 했어요...」"
],
"13794": [
"「혼자 계시는 건 위험하다고",
"말렸더라면...」"
],
"13795": [
"「...저, 저기,",
"스즈나 짱의....」"
],
"13796": [
"미사사기 씨는 숨을 삼키더니 새파래져서",
"고개를 숙여 버렸다."
],
"13797": [
"「죄송해요!",
"괘, 괜찮으세요?」"
],
"13798": [
"「...미안해요...",
"떠올라, 버려서...」"
],
"13799": [
"「봐주실 수 있을까요...?",
"저, 그... 말할 수 있을 것...」"
],
"13800": [
"「네, 네!",
"죄송했어요!」"
],
"13801": [
"안절부절못하며 미사사기 씨의 안색이",
"돌아오길 기다리는 처지가 됐다...."
],
"13802": [
"「음...",
"시즈나 짱에, 대해서...」"
],
"13803": [
"「...시즈나 씨...」"
],
"13804": [
"이름을 꺼내자마자 미사사기 씨는",
"입을 막고 고개를 숙여 버렸다."
],
"13805": [
"「저, 죄송해요!",
"미사사기 씨, 괜찮으세요!?」"
],
"13806": [
"「미... 미안해요...",
"아직, 건드리지 말아... 그...」"
],
"13807": [
"「...아무래도...",
"떠올라 버려서...」"
],
"13808": [
"「네, 네!",
"그만둘게요, 죄송했어요!」"
],
"13809": [
"미사사기 씨는 한동안 괴로운 듯",
"숨을 고르고 있었다...."
],
"13810": [
"「저, 나구모 씨...",
"어쩌면 우물 안에서 죽어 있던",
"사람이 그 사람일지도 모르는데...」"
],
"13811": [
"「...설마",
"벌써 돌아가셨을 줄은...」"
],
"13812": [
"「...그분은...",
"계속 우물 안에",
"계셨던 걸까요...?」"
],
"13813": [
"「...모르겠어요.",
"첫날 밤 제가 뒤뜰에서 본 사람과",
"옷차림은 같은데요」"
],
"13814": [
"「그런데 분명 그때는...",
"그... 이미...」"
],
"13815": [
"「네, 네.",
"죽은 것처럼 보였어요」"
],
"13816": [
"「그럼 그 뒤에",
"누군가가 우물에...?」"
],
"13817": [
"「대체 누가...?」"
],
"13818": [
"「그야 범인이겠죠",
"하고 생각하지만...」"
],
"13819": [
"「...그럼 역시",
"이 저택에는 아직 누군가...」"
],
"13820": [
"「우리가 모르는 누군가가",
"있을지도 모른다는 건가요...?」"
],
"13821": [
"그건 무서우니까 싫지만,",
"그게 아니면 이 안의 누군가가",
"범인이라는 얘기가 되니까...."
],
"13822": [
"「미사사기 씨는 시쿠라 긴지라는",
"사람을 아세요?」"
],
"13823": [
"「네, 몇 번 일로",
"함께한 적이 있어요」"
],
"13824": [
"「다만, 그...",
"이야기가 좀 안 맞아서...",
"그리 친하진 않았지만요」"
],
"13825": [
"「이야기...?」"
],
"13826": [
"「...전에 무대에서 함께한",
"적이 있어요.",
"그게 오컬트물이라...」"
],
"13827": [
"「뭐라더라, 옛날에 실존했던",
"백작으로, 저주받은 일족의",
"이야기였는데요」"
],
"13828": [
"「아, 저, 그, 이야기 내용은",
"자세히 안 하셔도 돼요」"
],
"13829": [
"「네, 저, 저도...",
"그다지 자세히 말하고 싶은",
"내용은 아니라서...」"
],
"13830": [
"「...그런데 시쿠라 씨는 반대로",
"그런 걸 굉장히 좋아하시는",
"것 같아서...」"
],
"13831": [
"「...그, 그렇군요」"
],
"13832": [
"「신나서 설명해 주세요.",
"저, 죄송하지만",
"그런 걸 못 견뎌서... 그...」"
],
"13833": [
"「그건... 곤란하겠네요...」"
],
"13834": [
"「네, 저, 나쁜 분은",
"아니라고 생각해요?」"
],
"13835": [
"「저, 이케우치 리나 씨라고",
"아세요?」"
],
"13836": [
"「음, 젊은 아이돌인데...」"
],
"13837": [
"「...얼마 전에 돌아가신 분?」"
],
"13838": [
"「아, 네.",
"그 사람이에요」"
],
"13839": [
"「그분이...",
"왜요?」"
],
"13840": [
"「아뇨, 그게...",
"서재 책장에 사망 기사가 실린",
"잡지가 있어서 왜일까 하고...」"
],
"13841": [
"「...어머, 그래요...」"
],
"13842": [
"「...가엾네요,",
"아직 젊은데...」"
],
"13843": [
"「부모님은...",
"얼마나 슬퍼하고",
"계실까요...」"
],
"13844": [
"「...아, 네」"
],
"13845": [
"「아직 열여덟 살이었는데.",
"앞으로 어떤 어른이 될지",
"분명 기대하셨을 거예요」"
],
"13846": [
"「어떻게 성장해서",
"어떤 무대에 서고",
"어떤 배우가 될지...」"
],
"13847": [
"「분명...",
"보고 싶으셨... 겠죠」"
],
"13848": [
"「...불쌍해라」"
],
"13849": [
"「...저, 미사사기 씨",
"혹시 친하셨어요?」"
],
"13850": [
"「네...?」"
],
"13851": [
"「그, 리나 씨랑요」"
],
"13852": [
"「.....아뇨」"
],
"13853": [
"「저는... 아쉽게도",
"일로 함께한",
"적도 없고...」"
],
"13854": [
"「...만난 적은",
"없어요」"
],
"13855": [
"「다만...",
"무대는 몇 번",
"본 적이 있어서...」"
],
"13856": [
"「아무리 작은 역이라도",
"연기가 즐거워 못 견디겠다는",
"그런 얼굴이라...」"
],
"13857": [
"「웃지 마세요?",
"저, 리나 씨가...」"
],
"13858": [
"「...제 젊은 시절과",
"조금 닮은 것 같은",
"기분이 들었어요」"
],
"13859": [
"「아, 그래서」"
],
"13860": [
"왠지 유난히",
"슬퍼 보이는 건가...."
],
"13861": [
"「미사사기 씨, 사토에 미도리",
"씨라고 아세요?」"
],
"13862": [
"「네... 음,",
"꽤 옛날 아이돌",
"이라는데요...」"
],
"13863": [
"「...옛날... 네, 네",
"그렇죠...」"
],
"13864": [
"「꽤 옛날 분이에요.",
"저, 그게 왜요?」"
],
"13865": [
"왠지 엄청나게 화제를",
"돌리고 싶어 하는 것 같다...."
],
"13866": [
"「...저, 미사사기 씨",
"옛날에 아이돌이셨군요」"
],
"13867": [
"「네!?",
"아, 저, 그런, 그건",
"아주 옛날의, 과거의, 음」"
],
"13868": [
"「...맞아요...」"
],
"13869": [
"（엄청 부끄러워한다...",
"건드리지 않는 게 좋은 과거인가...）"
],
"13870": [
"「르로이 백작이라는 사람",
"아세요?」"
],
"13871": [
"「네, 이름은...",
"연극 소재로 꽤",
"쓰이는 분이라서...」"
],
"13872": [
"「이야깃거리로 삼기 좋은",
"여러 전설을 갖고 계신",
"것 같아서...」"
],
"13873": [
"「...저, 그런데 저는...",
"그렇게 자세히는...」"
],
"13874": [
"「.....무서워서요」"
],
"13875": [
"「네, 아, 그래요?",
"저, 저도 그건 질색이라...」"
],
"13876": [
"「아, 그럼 자세한 이야기는",
"안 해도 될까요?」"
],
"13877": [
"「괜찮아요, 네」"
],
"13878": [
"...둘 다 안도한 얼굴을",
"하고 말았다."
],
"13879": [
"「기타하야미 료스케 아세요?",
"다카토 씨 소설에 나오는」"
],
"13880": [
"「네, 명탐정이죠.",
"옛날 영화에선 자주 미남 배우가",
"연기하셨어요」"
],
"13881": [
"「...그런데 그렇게 일을 안 하고",
"어떻게 탐정 사무소를 유지",
"하시는 걸까요...」"
],
"13882": [
"왠지 얼굴은 몰라도 성격에 문제가",
"있을 것 같은 캐릭터다...."
],
"13883": [
"「원작의 히오리 료라고",
"아세요?」"
],
"13884": [
"「다카토 씨 이야기에 나오는",
"히오리 씨요?」"
],
"13885": [
"「저도 원작은 별로...",
"영화에서도 꽤 여러 분이",
"연기하셨던 것 같고요」"
],
"13886": [
"「그래요?",
"외모 묘사가 적은 걸까,",
"원작에서도」"
],
"13887": [
"「원작은 그 히오리 씨의 1인칭",
"이니까 적지 않을까요?」"
],
"13888": [
"「다카토 씨 책에 나오는",
"진노 경부 아세요?」"
],
"13889": [
"「네, 영화로 봤어요.",
"중후하고 멋진 분 같더라고요」"
],
"13890": [
"「...그런데 은근히 어려운",
"역할 아닐까요」"
],
"13891": [
"「겉보기엔 냉정한 태도를 안 잃지만",
"속에 뜨거운 걸 품은 사람이에요」"
],
"13892": [
"「그런 성격을 눈에 보이게",
"표현하기는 어렵다고 봐요」"
],
"13893": [
"「오...",
"확실히 어려워 보이네요」"
],
"13894": [
"「제가 본 영화에선 다들",
"잘 연기하셨어요」"
],
"13895": [
"「그렇군요.",
"그럼 잘하는 사람이 뽑혔나 봐요」"
],
"13896": [
"「그런 것 같아요.",
"그분 역이 안 살면 작품 전체가",
"왠지 밋밋해지니까요」"
],
"13897": [
"그렇구나.",
"조연 같지만 중요한 역이구나..."
],
"13898": [
"「다카토 씨 소설에 나오는",
"하즈미 슌지라는 사람 아세요?」"
],
"13899": [
"「...글쎄요...",
"잘 기억 안 나네요」"
],
"13900": [
"「원작은 별로 안",
"읽어서요...」"
],
"13901": [
"「다카토 씨 소설에 나오는",
"마다라이 씨는 시게오라는",
"이름이네요」"
],
"13902": [
"「어머, 그래요?",
"시게오 씨...」"
],
"13903": [
"「어머?",
"그런데 마다라이 씨 본명은 분명",
"유키... 뭐라는 분 아니던가...」"
],
"13904": [
"「아, 아뇨, 이쪽 마다라이 씨",
"말고 다카토 씨 소설의...」"
],
"13905": [
"「...아, 그렇죠.",
"미안해요, 헷갈렸어요」"
],
"13906": [
"미사사기 씨는 쑥스러운 듯",
"눈을 피했다."
],
"13907": [
"「쿠로조노 타츠야라는 사람",
"아세요?」"
],
"13908": [
"「음... 누구신지?」"
],
"13909": [
"「아, 소설에 나오는 사람이에요.",
"다카토 노부지로의...」"
],
"13910": [
"「어머, 그랬군요.",
"미안하지만 모르겠어요」"
],
"13911": [
"「다카토 씨 소설에 나오는",
"후루오리 미즈에라고 모르세요?」"
],
"13912": [
"「미즈에... 씨?",
"어머, 이름은 어디서 들은",
"것 같은데요...」"
],
"13913": [
"「...아, 맞다.",
"옛날에 드라마로 봤어요」"
],
"13914": [
"「드라마로 나왔었군요」"
],
"13915": [
"「네, 하지만...",
"누가 연기한 역이었는지",
"잊어버렸어요」"
],
"13916": [
"「꽤 오래됐나요?」"
],
"13917": [
"「아마 제가 어릴 때",
"작품일 거예요」"
],
"13918": [
"...그건 오래됐을 것 같지만,",
"솔직히 말하면 혼날 것 같다."
],
"13919": [
"「저기, 다카토 씨 이야기에",
"나오는 사에키 노인 아세요?」"
],
"13920": [
"「사에키?",
"저희 집 정원사 말인가요?」"
],
"13921": [
"「어머, 아니에요?",
"나이에 비해 아주 정정한 분인데」"
],
"13922": [
"「그, 그래요...」"
],
"13923": [
"「아키오 미츠키라는 이름",
"들어 보셨어요?」"
],
"13924": [
"「아키오 씨요?",
"저희 매니저랑 같은 이름",
"인데요...」"
],
"13925": [
"「어머, 그런데 성이 아키오",
"씨네요」"
],
"13926": [
"「그럼 다르겠네요.",
"잘 모르는 것 같아요...」"
],
"13927": [
"「다키시게 사부로라는 이름 아세요?」"
],
"13928": [
"「다키시게 씨요?」"
],
"13929": [
"「...음...",
"사무소에도 없고, 이웃도 아니고",
"저희 집 하녀도 아니고...」"
],
"13930": [
"「...모르는 분 같아요」"
],
"13931": [
"하녀가 있구나...."
],
"13932": [
"「오코노기라는 이름",
"들어 보셨어요?」"
],
"13933": [
"「아, 그... 그 이름엔...",
"왠지 무서운 추억이...」"
],
"13934": [
"「옛날에 드라마로 봤어요.",
"뭔가 굉장히 섬뜩한 이야기",
"였던 것 같은데요...」"
],
"13935": [
"「아, 저, 그래요.",
"그럼 그만둬요, 네」"
],
"13936": [
"「그... 그래 주시겠어요?」"
],
"13937": [
"「네, 기꺼이!」"
],
"13938": [
"「소설에 나오는 쪽 나스 씨는",
"마코토 씨라고 하네요」"
],
"13939": [
"「...네?",
"저, 나스 씨라면,",
"여기 나스 씨가 아니라?」"
],
"13940": [
"「네, 그 원작 쪽이요」"
],
"13941": [
"「어머, 그래요.",
"'마'까지는 똑같네요」"
],
"13942": [
"「아뇨, 여기 나스 씨 본명이랑요.",
"마사루 씨... 어머, 마모루 씨",
"였던가요?」"
],
"13943": [
"'마'로 시작한다는 것만 기억하나 보다."
],
"13944": [
"「『잊지 못할 섬』에 나오는",
"도모에라는 사람 아세요?」"
],
"13945": [
"「...도모에 씨요?」"
],
"13946": [
"「음, 아는 사람 중에 도모에 씨는",
"여러 명 있는데요」"
],
"13947": [
"「아, 아뇨, 저기」"
],
"13948": [
"「우선 저희 사무소 사장님 부인,",
"그리고 친구인 배우,",
"또 친척 아주머니랑...」"
],
"13949": [
"「아, 맞다.",
"아는 집 고양이도",
"도모에였어요」"
],
"13950": [
"일단 다카토 씨 이야기에 나오는",
"도모에는 모르는 것 같다...."
],
"13951": [
"「다카토 씨 책에 나오는",
"미사사기 씨는 가오리 씨군요」"
],
"13952": [
"「...불쌍한 사람」"
],
"13953": [
"「아뇨...",
"제 배역 이름이니까 일단",
"읽었는데요」"
],
"13954": [
"「가오리 씨라는 사람이",
"아주 불쌍한 사람",
"이었어서...」"
],
"13955": [
"「...아, 그래도",
"이번 연극과는 딱히 관계가",
"없어 보였어요」"
],
"13956": [
"「내용은 전혀 연결되는 게",
"없군요」"
],
"13957": [
"「그런 것 같았어요」"
],
"13958": [
"「원작 쪽 쿠라이시 씨는",
"조지 씨라고 하죠」"
],
"13959": [
"「원작?",
"아, 다카토 씨 쪽 말인가요?」"
],
"13960": [
"「네, 그쪽이요」"
],
"13961": [
"「...어떤 이야기였더라.",
"왠지 영화나 드라마로 본",
"것 같긴 한데요」"
],
"13962": [
"「뭔가 밀실물이었어요」"
],
"13963": [
"「어머, 그래요.",
"어려울 것 같아요...」"
],
"13964": [
"이야기 자체는 별로",
"기억 못 하는 것 같다."
],
"13965": [
"「다카토 씨 쪽에도 기누타 유리라는",
"배우가 나오죠」"
],
"13966": [
"「기누타 씨...?",
"어떤 분이었더라」"
],
"13967": [
"「좀 들어 본 기억이",
"없는데요...」"
],
"13968": [
"왠지 실존 배우와 착각하고",
"있는 듯한 기색이...."
],
"13969": [
"「다카토 씨 책에 나오는 츠바키 군은",
"집사가 아니죠」"
],
"13970": [
"「아, 그러고 보니...",
"아니었죠, 분명」"
],
"13971": [
"「영화를 옛날에 봤을 텐데",
"기억 못 했네요」"
],
"13972": [
"「영화요?」"
],
"13973": [
"「네, 꽤 오래된 거지만요.",
"아주 독특한 분위기의 예쁜 영상",
"이었던 건 기억하는데...」"
],
"13974": [
"「와...",
"그럼 작품이 좋았나 보네요」"
],
"13975": [
"「네, 아마...」"
],
"13976": [
"기억이 좀 흐릿한 것 같다."
],
"13977": [
"「다카토 씨 책에 나오는",
"시노노메 다키라는 사람 아세요?」"
],
"13978": [
"「시노노메...",
"아뇨, 그분은 모르겠어요」"
],
"13979": [
"「시노노메 씨라고 하면 낮",
"요리 방송에 나오시는 분밖에",
"안 떠올라요」"
],
"13980": [
"「요리...」"
],
"13981": [
"그 사람은 틀림없이 아무 관계도",
"없을 거야...."
],
"13982": [
"「다카토 씨 책에 나오는",
"쌍둥이 기억하세요?」"
],
"13983": [
"「시즈나 씨네요?",
"네, 일단... 그 이야기는",
"드라마로 봤으니까요」"
],
"13984": [
"「그런데 여기 시즈나 씨네와는",
"별로 안 닮았던 걸로",
"기억하는데요」"
],
"13985": [
"「네, 드라마에서 본 쪽은",
"왠지 사이가 나빠서」"
],
"13986": [
"「오...",
"여기 쌍둥이는 사이좋죠」"
],
"13987": [
"「네, 정말로.",
"흐뭇하네요」"
],
"13988": [
"「다카토 씨 책에서 우로이 가문이라는",
"일족이 나오는 이야기 아세요?」"
],
"13989": [
"「아, 그건...",
"왠지 읽어 본 것 같은데」"
],
"13990": [
"「...그런데 굉장히 무서운",
"이야기였던 것 같아요」"
],
"13991": [
"「...무, 무서운...」"
],
"13992": [
"「저, 저주라든가 그런 제목",
"아니었나요?」"
],
"13993": [
"「맞아요...」"
],
"13994": [
"「저, 이 이야기는...",
"그만두지 않을래요...?」"
],
"13995": [
"「그래요, 꼭 그래요」"
],
"13996": [
"「저, 미사사기 씨...",
"유모라는 건...」"
],
"13997": [
"「제 유모요?",
"아주 상냥한 분이에요」"
],
"13998": [
"「저도 친정을 나오고 나서",
"오랫동안 못 만났어요.",
"잘 지내고 있을까요...」"
],
"13999": [
"「꽤 연세가 있으세요?」"
],
"14000": [
"「그렇죠.",
"제가 어릴 때부터 할멈이었으니까요」"
],
"14001": [
"「...음, 그때부터",
"전혀 안 변했다는 건가요...?」"
],
"14002": [
"「맞아요.",
"본인은 이 나이가 되면 나이 먹는",
"것도 잊는다고 하더라고요」"
],
"14003": [
"...진짜로 잊었을 것 같다.",
"대체 몇 살인 걸까."
],
"14004": [
"「여기에 다들 초대한 게",
"정말 모자 장수라고 생각하세요?」"
],
"14005": [
"「네, 그치만...",
"초대장이 왔잖아요, 제대로」"
],
"14006": [
"「다른 누군가가 모자 장수 이름을",
"써서 속였을 가능성은",
"없을까요?」"
],
"14007": [
"「...그런 건",
"생각도 못 했어요...」"
],
"14008": [
"「아, 하지만... 그렇네요,",
"있을 수 없는 이야기는...」"
],
"14009": [
"「아닌가요」"
],
"14010": [
"「네, 모르겠지만.",
"절대 아니라고는... 저로선",
"말 못 하겠어요...」"
],
"14011": [
"「저, 죄송한데",
"쿠라이시 씨에 대해서...」"
],
"14012": [
"「네...",
"저, 아직 뭔가...?」"
],
"14013": [
"「아뇨, 하나만요.",
"미사사기 씨가 아침 일찍 보셨을",
"때 말인데요...」"
],
"14014": [
"「쿠라이시 씨는 화장실에 들어가던",
"참이었나요?",
"나오던 게 아니라」"
],
"14015": [
"「들어가시던 참이었어요.",
"그래서 저를 눈치채지",
"못하신 게 아닐까요...」"
],
"14016": [
"「미사사기 씨 방 이름이",
"뭐였죠?」"
],
"14017": [
"「제 방은 애거사예요.",
"미스터리의 여왕이라 불린",
"분의 이름이죠」"
],
"14018": [
"「여왕이요?」"
],
"14019": [
"「라고 해도 실은 저도",
"책보다 영화로 본 게",
"더 많지만요」"
],
"14020": [
"「아, 그건 저도요」"
],
"14021": [
"...그렇기는커녕 실은",
"영화도 엄청 유명한 것밖에",
"안 봤지만."
],
"14022": [
"「아이세 미키 짱이라고",
"아세요?」"
],
"14023": [
"「...아이세 씨...",
"네, 이름은 알아요」"
],
"14024": [
"「분명 그분이 나온 영화도",
"모자 장수 씨의 추천이",
"있어서였다던가...」"
],
"14025": [
"「오디션이",
"있었다죠」"
],
"14026": [
"「그렇게 들었어요.",
"그런데...」"
],
"14027": [
"「...?",
"저, 뭔가...」"
],
"14028": [
"「그, 아이세 씨가",
"왜요?」"
],
"14029": [
"「아, 아뇨,",
"제 선배가 팬인 것 같아서",
"그냥 물어봤을 뿐이에요」"
],
"14030": [
"「그래요...",
"귀여운 분이니까요」"
],
"14031": [
"「이치야나기 씨도 좋아하세요?」"
],
"14032": [
"「실은 저는 별로",
"몰라요.",
"영화도 아직 안 봤고」"
],
"14033": [
"「...저도요.",
"별로 볼 마음이...」"
],
"14034": [
"「아, 그...",
"요즘 젊은 사람이라면 재밌을까",
"싶기는 한데요」"
],
"14035": [
"「미안해요,",
"분명 제 안목이 낡은 거겠죠」"
],
"14036": [
"미사사기 씨 연배에겐 별로",
"재미있어 보이지 않았다는",
"건가...?"
],
"14037": [
"「기사라기 유리코 씨",
"아시죠?」"
],
"14038": [
"「네, 물론이죠.",
"대선배인걸요」"
],
"14039": [
"「아직 신인이었을 때",
"자주 꾸중을 들었어요」"
],
"14040": [
"「꾸중을 들으셨어요?」"
],
"14041": [
"「후훗,",
"괴롭힘당한 건",
"아니에요?」"
],
"14042": [
"「빨리 제 몫을 하도록",
"엄하게 가르쳐 주셨다는",
"뜻이에요」"
],
"14043": [
"「게다가 연기를 떠나면",
"굉장히 잘 챙겨 주는 상냥한",
"언니 같은 분이었어요」"
],
"14044": [
"「그러고 보니 요 한동안",
"뵐 기회가 별로 없어서",
"아쉬워요」"
],
"14045": [
"「네, 큰 영화 일로",
"계속 촬영지에 계셨나 봐요」"
],
"14046": [
"영화 일은 오래",
"걸릴 것 같으니까."
