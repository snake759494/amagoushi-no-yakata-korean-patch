 ],
 "20537": [
  "「그래, 밖이랑 연결됐으면",
  "편했을 텐데...」"
 ],
 "20538": [
  "「...그러고 보니...」"
 ],
 "20539": [
  "「마다라이 아저씨 방에서",
  "전화가 울렸었지...」"
 ],
 "20540": [
  "「어? 그게 언제?」"
 ],
 "20541": [
  "「죽기 전이지, 당연히.",
  "첫날 밤이야」"
 ],
 "20542": [
  "「분명 내가 방 나와서 화장실",
  "가기 전이었을 거야」"
 ],
 "20543": [
  "「...그거, 누가 건",
  "거였을까...」"
 ],
 "20544": [
  "「누구긴,",
  "그날 밤 아저씨랑 통화했다고",
  "아무도 안 나선 걸 보면...」"
 ],
 "20545": [
  "「....범인?」"
 ],
 "20546": [
  "「아니겠냐」"
 ],
 "20547": [
  "마다라이 씨는 그 내선 전화로",
  "불려 나가 식당에 간 걸까..."
 ],
 "20548": [
  "「어, 잠깐만.",
  "내선은 저택 안에서가 아니면",
