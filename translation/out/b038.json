 "20781": [
  "「그런 거 좋아할 것 같은 사람",
  "짚이는 데 있어?」"
 ],
 "20782": [
  "「음, 글쎄...",
  "난 싫진 않은데 장식할 정도는",
  "아니고...」"
 ],
 "20783": [
  "「근데 그런 걸 장식한다면",
  "젊은 녀석 아냐?",
  "아저씨는 안 달지, 보통」"
 ],
 "20784": [
  "「뭐, 젊어도 여자는 별로",
  "안 달 것 같지만」"
 ],
 "20785": [
  "「임프를 특별히 좋아하는 놈은",
  "아는 사람 중에도 없고」"
 ],
 "20786": [
  "「뭐, 내가 아는 사람 중에도",
  "없지만...」"
 ],
 "20787": [
  "「저기, 방 열쇠에",
  "알파벳이 새겨져 있는",
  "것 같은데...」"
 ],
 "20788": [
  "「뭐야, 너도 하고 싶냐?」"
 ],
 "20789": [
  "「알고 말한 거 아니었냐?",
  "그거, 지금 주인이 장난으로 만든",
  "암호로 돼 있거든」"
 ],
 "20790": [
  "「암호라니 어떤?」"
 ],
 "20791": [
  "「뭔가, 올바른 글자를",
  "올바른 순서로 늘어놓으면",
  "의미 있는 말이 된대」"
 ],
 "20792": [
  "「올바른.. 순서는 그렇다 쳐도",
  "올바른 글자라니...?」"
 ],
 "20793": [
  "「관계있는 건 여덟 글자뿐이래.",
  "가짜가 섞여 있다는 거지」"
 ],
 "20794": [
  "「여덟 글자를 골라야 하는구나」"
 ],
 "20795": [
  "「그런가 봐.",
  "어디 보자, 잠깐 기다려",
  "푸는 데 힌트가 있으니까」"
 ],
 "20796": [
  "그렇게 말하며 츠바키 군은",
  "윗옷 안주머니를 뒤졌다."
 ],
 "20797": [
  "「츠바키 군은 벌써 풀었어?」"
 ],
 "20798": [
  "「분해서 답도 안 들었으니까",
  "나한테 물어도 모른다」"
 ],
 "20799": [
  "「아, 이거다 이거.",
  "읽어 줄 테니까 풀고 싶으면",
  "메모해 둬」"
 ],
 "20800": [
  "「아, 잠깐만」"
 ],
 "20801": [
  "허둥지둥 수첩을 꺼내",
  "펜을 든다."
 ],
 "20802": [
  "「됐냐, 읽는다?」"
 ],
 "20803": [
  "「열쇠에 숨은 짐승을 찾아라」"
 ],
 "20804": [
  "「그 이름의 처음과 끝은 여왕」"
 ],
 "20805": [
  "「둘이서 하나는 비극을 버려라",
  "실은 하나라면 박사를 골라라」"
 ],
 "20806": [
  "「마술사와 창시자를 쫓는 건 비숍」"
 ],
 "20807": [
  "「세계에서 가장 유명한 남자는",
  "세계에서 가장 유명한 곰 뒤에 있다」"
 ],
 "20808": [
  "「...이상이야」"
 ],
 "20809": [
  "「전혀 모르겠어...」"
 ],
 "20810": [
  "「그렇지!?",
  "역시 그렇지!?」"
 ],
 "20811": [
  "「근데, 뭔가...",
  "방 이름의 의미를 알면",
  "엄청 쉽다더라」"
 ],
 "20812": [
  "「적어도 간단히 푼",
  "녀석들은 그렇게 말해」"
 ],
 "20813": [
  "「...쉽다라...」"
 ],
 "20814": [
  "「아, 맞다.",
  "그리고 알파벳이 새겨진",
  "열쇠는 2층 열쇠뿐이야」"
 ],
 "20815": [
  "「단, 2층이라도 창고 열쇠엔",
