 ],
 "20565": [
  "「마음대로 조절할 수 있어?」"
 ],
 "20566": [
  "「누구나 할 수 있지.",
  "시계 옆면에 달린 손잡이",
  "만지기만 하면 되니까」"
 ],
 "20567": [
  "「...만지지 마」"
 ],
 "20568": [
  "「안 만져 안 만져」"
 ],
 "20569": [
  "「온실에 놓여 있던 벨 말인데,",
  "츠바키 군 본 적 없어?」"
 ],
 "20570": [
  "「없어, 그런 거.",
  "이 저택에 있던 건 아닐걸」"
 ],
 "20571": [
  "「그치, 왠지 싸 보이고」"
 ],
 "20572": [
  "「아무리 봐도 장난감이고.",
  "범인이 가져왔겠지,",
  "준비성 한번 좋네」"
 ],
 "20573": [
  "「온실에 긴 못이 놓여",
  "있었는데...」"
 ],
 "20574": [
  "「못~?」"
 ],
 "20575": [
  "「이만큼 커다란 거.",
  "대못이라는 건가 봐」"
 ],
 "20576": [
  "「...짚 인형은?」"
 ],
 "20577": [
  "「그, 그건 없었어」"
 ],
 "20578": [
  "「흐응?",
  "왜 못만 있는 걸까.",
  "충분히 기분 나쁘지만」"
 ],
 "20579": [
  "「온실에 하얀 장갑이 있었어.",
