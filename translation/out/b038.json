 ],
 "20816": [
  "「고마워.",
  "2층의, 사람 방뿐이구나」"
 ],
 "20817": [
  "「오, 힘내라.",
  "아, 근데 풀어도 알려 주지 마?",
  "나도 아직 생각 중이니까」"
 ],
 "20818": [
  "「...아, 맞다.",
  "츠바키 군 방 열쇠 글자는?」"
 ],
 "20819": [
  "「아차, 미안.",
  "깜빡할 뻔했다」"
 ],
 "20820": [
  "「내 건『T』야」"
 ],
 "20821": [
  "「T구나, 고마워」"
 ],
 "20822": [
  "「츠바키 군 휴대폰 어떤 거야?」"
 ],
 "20823": [
  "「음, 막 바꾼 거라",
  "아직 사용법을 제대로",
  "못 익혔어」"
 ],
 "20824": [
  "「전에 쓰던 거, 깜빡 떨어뜨려서",
  "액정 깨 먹었거든」"
 ],
 "20825": [
  "「그럼 최신 거야?」"
 ],
 "20826": [
  "「그런 비싼 걸 사겠냐.",
  "포인트로 공짜 되는",
  "한 세대 전 거야」"
 ],
 "20827": [
  "「아, 그러고 보니",
  "나도 기종 바꿀 때 그랬어」"
 ],
 "20828": [
  "「근데 최신이든",
  "뭐든 전파가 안 닿으면",
  "의미가 없단 말이지...」"
 ],
 "20829": [
  "「츠바키 군은 여기까지",
  "택시로 왔었나」"
 ],
 "20830": [
  "「그런데?」"
 ],
 "20831": [
  "「역에서 누구 만나거나",
  "하진 않았어?",
  "택시 기다릴 때라든가」"
 ],
 "20832": [
  "「아, 나 좀",
  "일찍 왔으니까」"
 ],
 "20833": [
  "「도착한 것도 제일 먼저고",
  "아무도 못 만났어」"
 ],
 "20834": [
  "「왜 눈을 피해?」"
 ],
 "20835": [
  "「이상하게...」"
