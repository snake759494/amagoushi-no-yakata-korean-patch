  "히오리랑 시즈나는",
  "익숙해지면 괜찮다던데」"
 ],
 "20486": [
  "「결국 익숙해질 만큼",
  "읽어야 한다는 거네」"
 ],
 "20487": [
  "「봐줘라...」"
 ],
 "20488": [
  "「저기...",
  "나스 씨가 마신 차 말인데」"
 ],
 "20489": [
  "「...그거 말이지.",
  "부엌에 있던 거잖아」"
 ],
 "20490": [
  "「응, 냉장고에」"
 ],
 "20491": [
  "「상자째 있던 걸",
  "내가 냉장고에 쑤셔 넣었어」"
 ],
 "20492": [
  "「첫날에.",
  "오자마자」"
 ],
 "20493": [
  "「그랬구나...",
  "그 전엔 상자에 들어 있었어?」"
 ],
 "20494": [
  "「그래, 내가 뜯었어」"
 ],
 "20495": [
  "그렇다면, 그 전에 독이",
  "들어 있었을 가능성은",
  "거의 없겠네..."
 ],
 "20496": [
  "「...저기.",
  "독약 말인데...」"
 ],
 "20497": [
  "「그거 말이지...",
  "이상하지 않냐?」"
 ],
 "20498": [
  "「왜 처음부터 전원한테",
  "독을 안 먹인 거야?」"
 ],
 "20499": [
  "「독을 갖고 있었으면",
  "이런 수고할 필요 없잖아」"
 ],
 "20500": [
  "아마 범인은...",
  "그냥 전원을 죽이고 싶은 게",
  "아니라 다른 의도가 있겠지..."
 ],
 "20501": [
  "「쿠라이시 씨 방에 장미 그림이",
  "놓여 있었는데 말이야...」"
 ],
 "20502": [
  "「장미 그림?」"
 ],
 "20503": [
  "「응, 쿠라이시 씨 방",
  "벽엔 다른 그림이 걸려 있어서",
  "딴 데서 가져온 것 같아」"
 ],
 "20504": [
  "「장미라면...",
  "응접실에 있던 건가」"
 ],
 "20505": [
  "「응접실...」"
 ],
 "20506": [
  "「아니, 확실하겐 말 못 하지만",
  "분명 그랬던 것 같아」"
 ],
 "20507": [
  "「그렇구나, 고마워」"
 ],
 "20508": [
  "「저기...",
  "쿠라이시 씨가 맞은 화살 말인데...」"
 ],
 "20509": [
  "「...이 저택, 여기저기",
  "무기가 있으니까...」"
 ],
 "20510": [
  "「대부분은 장식일 텐데",
  "어딘가에 진짜 쏠 수 있는",
  "활도 있었을지 모르지...」"
 ],
 "20511": [
  "「저택 안에 있었을",
  "가능성은 있구나」"
 ],
 "20512": [
  "「있을 거라고 봐」"
 ],
 "20513": [
  "「저기... 도끼 말이야,",
  "벽에 장식돼 있던 거지」"
 ],
 "20514": [
  "「확실히 장식돼 있었지...",
  "그건 기억나는데, 언제",
  "가져갔는지는 모르겠어」"
 ],
 "20515": [
  "「그 테루테루보즈,",
  "효과 있을까」"
 ],
 "20516": [
  "「글쎄...",
  "만든 녀석이 태평하니까",
  "있을지도」"
 ],
 "20517": [
  "「그런 문제야?」"
 ],
 "20518": [
  "「쓸데없이 크고.",
  "뭐, 이상한 데 안 매단",
  "것만 해도 다행이지만...」"
 ],
 "20519": [
  "「그 바보, 처음엔 그걸 2층",
  "뚫린 데다 매달아 놨었다니까」"
 ],
 "20520": [
  "「화장실 가려고 방 나왔더니",
