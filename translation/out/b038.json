 ],
 "20549": [
  "「그야 이 저택엔",
  "애초에 밖에서 전화가 안...」"
 ],
 "20550": [
  "「그럼.. 저기...",
  "역시 저택 안에 누군가...」"
 ],
 "20551": [
  "「젠장, 그렇게",
  "돼 버리는 건가...」"
 ],
 "20552": [
  "...범인인지, 그 동료인지",
  "모르겠지만 거짓말하는 사람이",
  "역시 있는 거야..."
 ],
 "20553": [
  "「그래, 맞아」"
 ],
 "20554": [
  "「화장실이든 지하든",
  "저택 안이면 어디든 달려 있어」"
 ],
 "20555": [
  "「...안 달려 있던 시절에",
  "지하실에 반나절 갇힌",
  "주인이 있었거든」"
 ],
 "20556": [
  "「그랬구나...」"
 ],
 "20557": [
  "「오락실 라디오는",
  "원래 그렇게 음질이 나빠?」"
 ],
 "20558": [
  "「원래도 심하지만,",
  "이 비 때문에 최악이야」"
 ],
 "20559": [
  "「뭐, 이런 산속이니까」"
 ],
 "20560": [
  "「혹시 텔레비전은",
  "있어도 안 나오려나」"
 ],
 "20561": [
  "「그럴지도.",
  "텔레비전은 원래 없어서,",
  "모르겠지만」"
 ],
 "20562": [
  "「1층 큰 시계 말이야,",
  "소리 안 나게",
  "조절한 거 츠바키 군이야?」"
 ],
 "20563": [
  "「그래, 마다라이 아저씨가",
