 ],
 "20580": [
  "「길고 하늘하늘한 게 뭐야?",
  "레이스라도 달렸냐?」"
 ],
 "20581": [
  "「뭔가, 그런 느낌.",
  "여자 거 같은데」"
 ],
 "20582": [
  "「흐응...?",
  "웨딩드레스 같은 거 입을 때",
  "끼는 그런 거?」"
 ],
 "20583": [
  "「아, 맞아 맞아」"
 ],
 "20584": [
  "「...그런 거라면",
  "어쩌면 창고 어딘가에",
  "있었을지도...」"
 ],
 "20585": [
  "「어? 이 저택에 있었어?」"
 ],
 "20586": [
  "「예복 몇 벌이 옷장 안에",
  "들어 있는 채였던 게 있었다던데",
  "말이야...」"
 ],
 "20587": [
  "「...평소엔 안 입고, 손님 올 때",
  "방해되니까 창고에 넣어 뒀다고",
  "들은 적이 있거든」"
 ],
 "20588": [
  "「아, 근데 온실에 있던 장갑",
  "꽤 새것 같았는데...」"
 ],
 "20589": [
  "「앙? 그럼 아닌가」"
 ],
 "20590": [
  "역시 범인이 가져온",
  "걸까..."
 ],
 "20591": [
  "「온실에 도끼가 있었어...",
  "이만한 손도끼지만」"
 ],
 "20592": [
  "「손도끼라니, 흉흉하네.",
  "뭐, 오락실 그것도 흉흉하지만」"
 ],
 "20593": [
  "「그, 그렇게 크진 않았어」"
 ],
 "20594": [
  "「그야 그렇겠지.",
  "그런 걸 짊어지고 가는 것만도",
  "중노동이라고」"
 ],
 "20595": [
  "「그치...",
  "저기, 작은 도끼 말이야",
  "원래 이 저택에 있었어?」"
 ],
 "20596": [
  "「아니...",
  "난 본 기억 없고,",
  "이 집 물건은 아닐걸」"
 ],
 "20597": [
  "「온실에 이 정도 되는",
  "작은 울타리가 있었는데」"
 ],
 "20598": [
  "「잘 모르겠는데,",
  "뭔가 장식인가?」"
 ],
 "20599": [
  "「장식이라니 뭘 장식해.",
  "울타리면 뭔가 두르는 거겠지」"
 ],
 "20600": [
  "「뭘 둘러?」"
 ],
 "20601": [
  "「그야... 음...",
  "햄스터라든가...?」"
 ],
 "20602": [
  "「햄스터면 틈새로",
  "마음대로 드나들 텐데...」"
 ],
 "20603": [
  "「에~? 그럼 뭐야?",
  "그 크기면 개나 고양이한텐",
  "너무 작지 않냐?」"
 ],
 "20604": [
  "「동물용이 아닌 거 아냐?」"
 ],
 "20605": [
  "「그럼 뭔데,",
  "동물이 아니면 식물이냐?」"
 ],
 "20606": [
  "「...아, 그렇군!",
  "화단 같은 데 있는 거잖아, 그거」"
 ],
 "20607": [
  "「원예용?」"
 ],
 "20608": [
  "「아마 그렇겠지.",
  "그렇다면 원래 온실에 있던",
  "건가...」"
 ],
 "20609": [
  "「아니, 아닐 거야.",
  "여기 온실 화단에 있는 거면",
  "원예용인 줄 바로 알지」"
 ],
 "20610": [
  "「그건 그렇네.",
  "그럼 일부러 가져왔단 건가」"
 ],
 "20611": [
  "「저기...",
  "나스 씨가 가진 덤벨 말인데..」"
 ],
 "20612": [
  "「그건 근육의 개인 물건이다!」"
 ],
 "20613": [
  "「아, 응, 그야...」"
 ],
 "20614": [
  "「여기 비품 아니라고?",
  "덤벨이고 바벨이고 아령이고",
  "상비 안 해 놨으니까」"
 ],
 "20615": [
  "「...있냐고 물어봤어?」"
 ],
 "20616": [
  "「아니, 반대야.",
  "대부분 없으니까 여기도 없을",
  "거라고 생각해서 가져왔대」"
 ],
 "20617": [
  "「자, 잘됐네.",
  "직접 준비해 와서」"
 ],
 "20618": [
  "「그렇게까지 덤벨을 못 놓는",
  "이상한 생물이라는 사실은",
  "아무래도 좋냐, 넌」"
 ],
 "20619": [
  "「아, 그치만, 저기...",
  "나쁜 사람은 아니니까...」"
 ],
 "20620": [
  "「...알아, 그런 건!」"
 ],
 "20621": [
  "「나도 말이야,",
  "더 단련하면 그 정도는...」"
 ],
 "20622": [
  "「응? 저기...」"
 ],
 "20623": [
  "「복근 좀 여덟 개로 갈라졌다고",
  "기고만장하지 말라고, 젠장」"
 ],
 "20624": [
  "「저기, 츠바키 군... 혹시,",
  "몸 단련하고 싶어...?」"
 ],
 "20625": [
  "「...윽,",
  "부러운 거 아니다!?」"
 ],
 "20626": [
  "「아무리 그래도 뇌까지 근육 될",
  "만큼 단련하고 싶진 않다고!?」"
 ],
 "20627": [
  "「게다가 지구력이 아니라 순발력",
  "근육이잖아, 그 녀석 뇌는.",
  "그건 너무 지나쳐, 그건」"
 ],
 "20628": [
  "「그, 그러니까...",
  "뭐야, 그 얼굴은!?」"
 ],
 "20629": [
  "「부러운 거 아니라고",
  "했잖아!?」"
 ],
 "20630": [
  "「너.. 너도 그, 기왕이면",
  "빈약한 것보단 좀",
  "체격 좋은 게 낫잖아」"
 ],
 "20631": [
  "「그야, 뭐...」"
 ],
 "20632": [
  "「그렇지, 남자면 보통이야.",
  "나스는 지나치지만」"
 ],
 "20633": [
  "...왠지 유난히 나스 씨한테",
  "시비를 건다 했더니.",
  "복잡한 심경이 있었나 보다..."
