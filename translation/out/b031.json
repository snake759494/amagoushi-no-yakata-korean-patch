],
"16255": [
"「....왜?」"
],
"16256": [
"「책, 달라」"
],
"16257": [
"「책?」"
],
"16258": [
"「오늘 순서에 있는 거,",
"우리가 나오는 책이랑 다른데」"
],
"16259": [
"「아, 응, 그렇긴 한데",
"늘어놓아 보니까 이렇게 돼서...」"
],
"16260": [
"「....흐응」"
],
"16261": [
"「그래서, 어떻게 할 건데?」"
],
"16262": [
"「이유는 알겠어.",
"구체적인 대책은」"
],
"16263": [
"「아...",
"믿어 주는구나」"
],
"16264": [
"「일단은」"
],
"16265": [
"일단은인가....",
"그래도 뭐, 전혀 못 믿는 것",
"보다는 훨씬 낫지."
],
"16266": [
"「그러니까, 아무래도 범인은",
"모방 살인이라는 걸",
"하고 있는 것 같거든」"
],
"16267": [
"「모방...」"
],
"16268": [
"「마다라이 씨의 그거,",
"뭐였는지 알아?」"
],
"16269": [
"「그거?",
"그러니까, 그건...」"
],
"16270": [
"「...『고양이와 첫눈』이었나」"
],
"16271": [
"「고양이가 틀렸어」"
],
"16272": [
"「어? 어라?」"
],
"16273": [
"「그건 『검은 고양이의 독』 쪽」"
],
"16274": [
"「아, 그렇구나!」"
],
"16275": [
"둘 다 고양이가 들어간 제목이라",
"헷갈렸다...."
],
"16276": [
"「...뭐였더라.",
"『나는 고양이로소이다』...는 아니지」"
],
"16277": [
"「그건 그거대로 모방에",
"쓸 수는 있겠지만, 틀렸어」"
],
"16278": [
"「쓸 수 있었던가!?」"
],
"16279": [
"「커다란 독 안에서",
"익사시키면 될 것 같아」"
],
"16280": [
"「그래도 마다라이 씨 건",
"『검은 고양이의 독』이야」"
],
"16281": [
"「아, 그렇구나.",
"그랬지...」"
],
"16282": [
"「『검은 고양이의 독』이지」"
],
"16283": [
"「정답」"
],
"16284": [
"「제목 제대로 기억했네」"
],
"16285": [
"「온실에 검은 고양이가 있고,",
"마다라이 씨는 그렇게",
"묶여 있었고...」"
],
"16286": [
"「이름도 그렇지.",
"마다라이라는 이름은 『검은 고양이",
"의 독』에 나오는 사람 이름」"
],
"16287": [
"「그게 뭔가 신경 쓰여?」"
],
"16288": [
"「어떻게든 알아채 주길",
"바랐던 걸까」"
],
"16289": [
"「응? 뭘?」"
],
"16290": [
"「이게 모방 살인이라는 걸」"
],
"16291": [
"「아마, 이름도 다르고 고양이도",
"없이 마다라이 씨가 묶여만",
"있었으면 뭘 모방했는지 몰랐을 거야」"
],
"16292": [
"「아아, 그야 그렇겠지」"
],
"16293": [
"「그렇게 보면 뭘 모방한 건지",
"유난히 강조하고 있는 건가.",
"왜일까...?」"
],
"16294": [
"「...이건 소설 얘기지만",
"모방 살인의 이유는 죽일 상대에",
"대한 메시지일 때가 있어」"
],
"16295": [
"「메시지?」"
],
"16296": [
"「예를 들면...",
"옛날에 마리모를 괴롭힌 사람이",
"살해당했다고 치고」"
],
"16297": [
"「왜 마리모...」"
],
"16298": [
"「아무거나 상관없어.",
"그래서 피해자가 마리모를 모방한",
"모습으로 죽어 있으면...」"
],
"16299": [
"「...같이 마리모를 괴롭힌",
"기억이 있는 사람은 무섭잖아.",
"자기한테도 올지 모른다고」"
],
"16300": [
"「마리모를 모방한다는 게 어떤",
"상태... 아니, 뭐 됐어」"
],
"16301": [
"「그러니까 메시지라는 건",
"그 모방의 의미에 공통점이",
"있는 사람들에 대한 협박이라고?」"
],
"16302": [
"「응.",
"우리 경우엔 다카토 작품에서",
"배역명을 딴 배우라는 공통점」"
],
"16303": [
"「모방에 쓰인 것도",
"다카토 작품이니까」"
],
"16304": [
"「그러니까 이 경우 범인은",
"시즈나네 전원을 협박하려고",
"모방을 강조하는 걸까」"
],
"16305": [
"「그것도 있겠지만,",
"뭔가 걸려」"
],
"16306": [
"「걸린다니?」"
],
"16307": [
"「우선, 협박만 할 거면",
"『폭풍 속 산장』만으로 충분해」"
],
"16308": [
"「...깊은 산속 산장에 갇혀서",
"사람이 죽는 것만으로 충분해」"
],
"16309": [
"「아, 그건 그렇네.",
"충분히 무섭지...」"
],
"16310": [
"「그걸 굳이 모방 살인으로 하고",
"게다가 뭘 모방했는지를",
"누가 빨리 알아채게 강조해」"
],
"16311": [
"「실제로 그 의미는 마다라이",
"씨가 살해되기 전에 시즈나가",
"알아챘을 정도였으니까」"
],
"16312": [
"「모방 살인보다 먼저 모방의",
"내용이 공개된 셈이 되는 건가」"
],
"16313": [
"「먼저 공개할 거면",
"레코드로 노래 틀고 인형 10개",
"늘어놓든가 하면 알기 쉬울 텐데」"
],
"16314": [
"「마니아의 혼잣말이니까",
"신경 안 써도 돼」"
],
"16315": [
"「아무튼 범인은 빨리 누군가가",
"『다카토 엔지로』에 도달하게",
"유도하고 있어」"
],
"16316": [
"「그럼, 여기서 문제입니다」"
],
"16317": [
"「무, 문제?」"
],
"16318": [
"「...왜 다카토야?」"
],
"16319": [
"「우리 사이에 『다카토』라는",
"공통점은 받은 대본밖에 없어」"
],
"16320": [
"「그 대본도 모자 장수가 썼다고는",
"이제 생각할 수 없는 상황이고",
"범인이 꾸몄을 가능성이 높아」"
],
"16321": [
"「...그럼 왜 다카토야?",
"마더 구스도 공 튀기기 노래도",
"아닌 다카토를 고른 이유는?」"
],
"16322": [
"「대본만은 진짜일지도",
"몰라」"
],
"16323": [
"「진짜라니, 대본을 쓴 건",
"정말 모자 장수라는 거야?」"
],
"16324": [
"「응, 그걸 범인이 이용하는",
"게 아닐까」"
],
"16325": [
"「...그렇다면 진짜 모자 장수는",
"이미 죽었을 것 같아」"
],
"16326": [
"「지금 여기 모인 건",
"범인이 복수하고 싶은 상대지,",
"모자 장수가 정한 배역이 아니잖아」"
],
"16327": [
"「설마 모자 장수가 정한 배역이",
"우연히 범인의 복수 상대 전원과",
"딱 같았을 리는 없을 테고」"
],
"16328": [
"「그건... 없을 것 같네」"
],
"16329": [
"「만에 하나 우연히 같았대도",
"그럼 역시 범인은 미리 배역을",
"알고 있었다는 얘기고」"
],
"16330": [
"「어느 쪽이든 모자 장수 본인과",
"뭔가 접촉이 없으면 무리야」"
],
"16331": [
"「...그렇구나」"
],
"16332": [
"「그럼 모자 장수는 이미",
"범인한테 살해당했을 것 같지 않아?」"
],
"16333": [
"「모자 장수를 놔두면 사건이",
"드러났을 때 범인이 바로 들통나」"
],
"16334": [
"「그렇게 되겠네...」"
],
"16335": [
"「...모자 장수의 정체가",
"범인이 아닌 한은」"
],
"16336": [
"「시즈나, 모자 장수가 범인일지도",
"모른다고 생각해?」"
],
"16337": [
"「난, 대본 자체를 모자 장수가",
"쓴 게 아니라고 생각해」"
],
"16338": [
"「그렇게 자신 없는 얼굴 안 해도 돼.",
"나랑 오빠 중 누가 맞는지",
"아직 모르는데」"
],
"16339": [
"「...다카토 씨 관계자가",
"있는 걸지도....」"
],
"16340": [
"「역시 그렇게 생각해?」"
],
"16341": [
"「나도 둘 중 하나라고 생각해」"
],
"16342": [
"「둘 중 하나라니...?」"
],
"16343": [
"「사실 다카토 엔지로랑 관계있는",
"사람이 우리 중에 섞여 있고, 범인이",
"제일 죽이고 싶은 게 그 사람이라든가」"
],
"16344": [
"「...아니면",
"범인이 다카토 엔지로 관계자거나,",
"둘 중 하나겠지」"
],
"16345": [
"「범인이...」"
],
"16346": [
"「범인한테 가깝고",
"모방 살인을 떠올리기 쉬운",
"거였을지도 몰라」"
],
"16347": [
"（...사실 한 명은 진짜로",
"다카토 엔지로의 손자인데...）"
],
"16348": [
"지금 그걸 말하면 시즈나는",
"히오리를 의심할지도 몰라."
],
"16349": [
"그러면 계속 같이 있던 나도",
"못 믿게 될지도...."
],
"16350": [
"（아, 그래도 숨겼다가 나중에",
"들키면 더 의심받으려나）"
],
"16351": [
"（나만 말 안 하면",
"괜찮으려나....）"
],
"16352": [
"「...왜 그래?",
"내가 하는 말 뭔가 이상해?」"
],
"16353": [
"「아, 아니...",
"딱히 이상하지 않은 것 같아」"
],
"16354": [
"「...그런 것치곤",
"뭔가 이상한 얼굴이야」"
],
"16355": [
"「어, 이건, 그게,",
"그러니까... 어느 쪽일까",
"생각하고 있었을 뿐이고...」"
],
"16356": [
"「왜 식은땀 흘리는데」"
],
"16357": [
"「엣!?",
"그, 그래...?」"
],
"16358": [
"「아, 그게, 아마...",
"익숙하지 않은 얘기라서",
"긴장한 거 아닐까...」"
],
"16359": [
"「...저기 있잖아.",
"아마... 범인이 다카토 씨",
"관계자는 아닐 거야」"
],
"16360": [
"「그게...",
"사실 진짜 관계자가",
"있긴 있는데...」"
],
"16361": [
"「...기모노 오빠구나」"
],
"16362": [
"「엣!?",
"어떻게 알았어!?」"
],
"16363": [
"「엄청 말하기 어려워",
"보였으니까」"
],
"16364": [
"「오빠가 절대 범인 아니라고",
"믿는 사람이겠구나 싶었어」"
],
"16365": [
"「저기, 그래도 히오리는 정말",
"범인 아니야?",
"난 계속 같이 있었는데...」"
],
"16366": [
"「마다라이 씨가 살해됐을 땐",
"틀림없이 계속 방에 있었고,",
"그리고, 그러니까...」"
],
"16367": [
"「우리 다른 사람은 다 게스트 역이라",
"고양이는 마다라이 씨, 처럼 어느",
"얘기를 가리키면 누군지 예측돼」"
],
"16368": [
"「히오리 료만은 그게 안 돼.",
"혼자만 붕 떠 있어.",
"난 그게....」"
],
"16369": [
"「일부러 띄워진 것 같아」"
],
"16370": [
"「일부러...?」"
],
"16371": [
"「범인이, 말이야」"
],
"16372": [
"「어, 그럼 시즈나는",
"히오리를 의심 안 하는구나?」"
],
"16373": [
"「...아직 몰라」"
],
"16374": [
"「정말 범인이라면",
"그렇게 노골적으로 혼자 튀는",
"짓은 보통 안 할 거야」"
],
"16375": [
"「그, 그렇지.",
"너무 튀어서 진짜 의심받으면",
"꼼짝 못 하게 되니까...」"
],
"16376": [
"「...일단 의심받고 나서",
"의심을 풀어서 용의자 후보에서",
"빠지는 수도 있긴 한데」"
],
"16377": [
"「하지만 그걸 노린 거라면",
"기모노 오빠치고는",
"솜씨가 너무 서툴러」"
],
"16378": [
"「솜씨...?」"
],
"16379": [
"「그 사람, 나랑 같은 수준의",
"미스터리 마니아 같거든」"
],
"16380": [
"「『제일 수상한 놈이 역시 범인』을",
"하고 싶으면 더 처음부터 의심받아야",
"의미 있다는 걸 모를 리 없어」"
],
"16381": [
"「그러기는커녕 마다라이 씨 때는",
"유일하게 오빠랑 알리바이를 서로",
"증언해 줄 수 있는 입장이었잖아」"
],
"16382": [
"「하는 짓이 완전히 반대야.",
"오히려 그때 혼자만 알리바이가",
"없게 해 둬야 할 참인데」"
],
"16383": [
"「...그러니까",
"기모노 오빠는 범인 아니야」"
],
"16384": [
"「그, 그런 거야?」"
],
"16385": [
"「그렇게 나중에 의심이 풀리면",
"더는 의심할 사람 없잖아.",
"한 번 아니라고 판단됐으니까」"
],
"16386": [
"「아아, 뭐",
"그럴지도...」"
],
"16387": [
"「기모노 오빠는 그게 반대야.",
"처음엔 알리바이가 있었는데 그 뒤로",
"점점 수상해지고 있어」"
],
"16388": [
"「...그러니까",
"그런 의미에서 기모노 오빠는",
"범인답지 않아」"
],
"16389": [
"뭔가 엄청난 이유인 것",
"같긴 한데.",
"의심이 풀렸으면 됐나...."
],
"16390": [
"「쿼드 에라트 데몬스트란둠」"
],
"16391": [
"「뭐? 뭐, 뭐라고?」"
],
"16392": [
"「한번 말해 보고 싶었을 뿐」"
],
"16393": [
"왜 쑥스러워하는 걸까.",
"방금 그 주문 같은 건 뭐지...?"
],
"16394": [
"「...난 모르겠어」"
],
"16395": [
"「...뭔가 못 미더워」"
],
"16396": [
"「미안...」"
],
"16397": [
"「그래도 일단 진심인 건",
"알았어」"
],
"16398": [
"「어, 아, 그야 진심이지.",
"농담으로 이런 험한 말 안 해.",
"분명 위험할 테니까...」"
],
"16399": [
"「알았어」"
],
"16400": [
"「...믿어 둘게.",
"밤에도 조심할게」"
],
"16401": [
"「으, 응.",
"고마워」"
],
"16402": [
"「...일단은」"
],
"16403": [
"「믿을게」"
],
"16404": [
"「오빠의 추리,",
"대부분 나랑 같은 것 같아」"
],
"16405": [
"「...게다가 나보다",
"조금 앞서 있는 것 같아」"
],
"16406": [
"「어.. 그, 그런가」"
],
"16407": [
"「여기선 깨끗이 패배를 인정하고..」"
],
"16408": [
"「패배!?」"
],
"16409": [
"「오빠의 경고를 따를게」"
],
"16410": [
"「...고, 고마워」"
],
"16411": [
"언제 승부 얘기가 된 건지",
"잘 모르겠지만...."
],
"16412": [
"「스즈한테도 말해 둘게.",
"내가 말하는 게 나을 거야」"
],
"16413": [
"「그 애한테 갑자기 내 목숨이",
"위험하다고 하면 난동 부려」"
],
"16414": [
"「오빠가 다치면 곤란하고」"
],
"16415": [
"「아.. 알았어....",
"그럼 스즈나 쪽은 맡길게」"
],
"16416": [
"「...그리고...」"
],
"16417": [
"「아, 일단 모방에 쓰일 만한",
"물건은 숨겨 둘게」"
],
"16418": [
"「시즈나네가 직접 돌아다니면",
"여러모로 위험할 테니까」"
],
"16419": [
"「응, 알았어.",
"그럼 나머지는...」"
],
"16420": [
"「그리고.. 또 뭐가 있으려나」"
],
"16421": [
"「응.",
"나는 하나 남았어」"
],
"16422": [
"「걱정해 줘서 고마워」"
],
"16423": [
"「어, 아.. 아니...」"
],
"16424": [
"「그렇게 새빨개지면",
"나까지 부끄럽잖아」"
],
"16425": [
"「그라시아스, 아미고",
"라고 할 걸 그랬어」"
],
"16426": [
"「왜 스페인어...?」"
],
"16427": [
"「취미」"
],
"16428": [
"역시 시즈나는",
"잘 모르겠다...."
],
"16429": [
"「실은 말이야, 사건 얘긴데」"
],
"16430": [
"「...아아, 역시」"
],
"16431": [
"「역시?」"
],
"16432": [
"「어제 스즈한테 둘 다 위험하다고",
"말했잖아」"
],
"16433": [
"「아.. 응.",
"그러니까 오늘 밤은... 시즈나가",
"위험할 것 같은데...」"
],
"16434": [
"「그치만 어젯밤 우리 둘이 같은 방에",
"있었으니까 범인이 누굴 노렸는지는",
"모르잖아」"
],
"16435": [
"「그렇구나, 그것도 그렇네....",
"어쨌든 오늘 밤도 둘 다",
"경계하는 게 좋겠지」"
],
"16436": [
"「나도 그렇게 생각해.",
"일단 어젯밤처럼",
"둘이 같이 있을게」"
],
"16437": [
"「그게 좋겠어.",
"나도 밤이 되면 복도에서 지킬게」"
],
"16438": [
"「...고마워」"
],
"16439": [
"「어, 아, 아니, 그야",
"다 무사한 게 좋으니까」"
],
"16440": [
"「그렇게까지 쑥스러워 안 해도」"
],
"16441": [
"왜냐면, 이렇게 선뜻",
"믿어 주고 고맙다는 말까지 들으면",
"오히려 당황스럽달까."
],
"16442": [
"「...그럼 난 스즈한테",
"그렇게 말해 둘게」"
],
"16443": [
"「아, 응, 그럼",
"조심해」"
],
"16444": [
"「비, 좀처럼 안 그치네」"
],
"16445": [
"「비는 좋아하지만,",
"지금은 빨리 그쳤으면 좋겠어」"
],
"16446": [
"「그러게..」"
],
"16447": [
"「산사태는 무섭지」"
],
"16448": [
"「...그거, 일부러는 아니겠지」"
],
"16449": [
"「일부러?」"
],
"16450": [
"「범인이 무너뜨린 건 아니겠지」"
],
"16451": [
"「그건 아무리 그래도",
"무리일 것 같아」"
],
"16452": [
"「그렇지」"
],
"16453": [
"「온실에 불이 켜져 있는 거",
"눈치 못 챘어?」"
],
"16454": [
"「...커튼 안 열어",
"놨었으니까」"
],
"16455": [
"「...저기, 이상한 걸 묻는데",
"스즈나 짱... 군은,",
"그 차림...」"
],
"16456": [
"「...후후.",
"스즈, 예쁘지」"
],
"16457": [
"「응, 뭐, 그렇지」"
],
"16458": [
"「그 차림이면 거의 아무도",
"눈치 못 채」"
],
"16459": [
"「편리해 편리해」"
],
"16460": [
"배역에서만이 아니라",
"뭔가 이것저것 하고 있을 것 같다...."
],
"16461": [
"「잠결에 걸어 나가는 건",
"뭐랄까, 스트레스 같은 게",
"원인인 걸까」"
],
"16462": [
"「그러고 보니 시험 전날 같은 때",
"자주 한밤중에 걷는대」"
],
"16463": [
"「아, 그럼 역시",
"압박감 같은...」"
],
"16464": [
"「근데 소풍 전날이라든가",
"다음 날 학식 점심이 정어리",
"매실조림일 때도 가끔 걸어」"
],
"16465": [
"그러니까 좋든 나쁘든",
"뭔가 흥분되는 일이 있으면",
"발병한다는 건가...."
],
"16466": [
"「저기, 이거 뭐라고",
"쓰여 있는지 알아?」"
],
"16467": [
"「...괜찮아?」"
],
"16468": [
"「읽어도 돼?",
"정말로?」"
],
"16469": [
"「저기... 왜 그렇게",
"즐거운 얼굴을 하는, 걸까...」"
],
"16470": [
"「읽어 줬으면 좋겠어?」"
],
"16471": [
"「이, 읽을 수 있어...?」"
],
"16472": [
"「...뭐라고 쓰여 있어?」"
],
"16473": [
"「정말 괜찮아?」"
],
"16474": [
"「...무서워?」"
],
"16475": [
"「거기까지 들으면",
"궁금하잖아!」"
],
"16476": [
"「궁금하지」"
],
"16477": [
"일부러 궁금하게 하려고",
"애태운 건가...?"
],
"16478": [
"「저주하고 있어」"
],
"16479": [
"「일족 모두를 저주하고 있어」"
],
"16480": [
"「....라고,",
"쓰, 쓰여 있는 거야...?」"
],
"16481": [
"「나는 일족 전원을 저주한다고」"
],
"16482": [
"「이거, 지하 벽에",
"새겨져 있던 거지」"
],
"16483": [
"「알고 있었어!?」"
],
"16484": [
"「첫날 탐험할 때 발견해서,",
"궁금해서 서재에서 사전 찾았어」"
],
"16485": [
"「이 저택, 옛날엔 외국의 성",
"이었으니까 지하실은 역시",
"감옥이라든가 고문실이라든가」"
],
"16486": [
"「아, 알았어, 이제 됐어!",
"이제 됐으니까 그만해!!」"
],
"16487": [
"「...겁쟁이~」"
],
"16488": [
"시즈나....",
"엄청 즐거워 보인다...."
],
"16489": [
"「묵을 방은",
"처음부터 정해져 있었지」"
],
"16490": [
"「초대장에 쓰여 있었어」"
],
"16491": [
"「밀실이 돼 있지 않을까",
"했는데, 그냥 열렸어」"
],
"16492": [
"「미, 밀실?」"
],
"16493": [
"「응, 밀실」"
],
"16494": [
"왜 그걸 기대하는지",
"잘 모르겠다...."
],
"16495": [
"「나스 씨가 봤다는",
"통행금지 간판 말인데」"
],
"16496": [
"「진짜는 아닌 것 같아.",
"실제로 있었다 해도」"
],
"16497": [
"「실제로... 어?」"
],
"16498": [
"「그치만 그거 본 건",
"나스 씨뿐이잖아」"
],
"16499": [
"「....어..」"
],
"16500": [
"「다른 누구도 정말 놓여",
"있는지 확인하러 안 갔어」"
],
"16501": [
"「그.. 그야...",
"그렇지만...」"
],
"16502": [
"「그래서 보러 가고 싶다고",
"했더니 스즈한테 혼났어」"
],
"16503": [
"「다, 당연하지!」"
],
"16504": [
"「위험하니까 하지 마.",
"비도 안 그쳤으니까",
"또 무너질지도 몰라」"
],
"16505": [
"「그럼 나스 씨를",
"믿을 수밖에 없어」"
],
"16506": [
"「나스 씨가...",
"거짓말하고 있을지도 모른다고",
"생각해...?」"
],
"16507": [
"「...그 사람은...」"
],
"16508": [
"「거짓말한다는",
"기능이 뇌에 탑재 안 된",
"것처럼 보여...」"
],
"16509": [
"「입 다무는 건 가능해도",
"사실과 다른 말 하는 건",
"엄청 서툴 것 같아」"
],
"16510": [
"「...나도 그렇게 생각해」"
],
"16511": [
"「그러니까 일단",
"믿기로 했어」"
],
"16512": [
"「다키 프로 사무소 사람 중에",
"아는 사람 있어?」"
],
"16513": [
"「페이버릿」"
],
"16514": [
"「제일 잘하는 사람이",
"내 목표야」"
],
"16515": [
"「헤에, 그렇구나.",
"여배우?」"
],
"16516": [
"「응, 멋있어」"
],
"16517": [
"「근데 아직 같이 일한 적 없어.",
"해 보고 싶어...」"
],
"16518": [
"「흐응...」"
],
"16519": [
"시즈나가 목표로 하는 사람은",
"어떤 사람일까...."
],
"16520": [
"「스즈메 예능이라는 사무소",
"어떤 곳이야?」"
],
"16521": [
"「...마다라이 씨네?」"
],
"16522": [
"「엄청 옛날부터 있는 사무소야.",
"유명한 배우도 많았고」"
],
"16523": [
"「헤에...?",
"어떤 사람이 있었어?」"
],
"16524": [
"「오빠는 모를 거야.",
"전쟁 전 사람들뿐이라」"
],
"16525": [
"「...그건 모르겠네」"
],
"16526": [
"「시즈나네 사무소는",
"어떤 곳이야?」"
],
"16527": [
"「고양이가 있어」"
],
"16528": [
"「뭐..?」"
],
"16529": [
"「그리고 십자매도 키워」"
],
"16530": [
"「손님용 다과는 벚꽃떡」"
],
"16531": [
"「흐응」"
],
"16532": [
"「상대가 커피 마셔도 벚꽃떡」"
],
"16533": [
"「뭔가 고집이라도 있어?",
"벚꽃떡에...」"
],
"16534": [
"「사장실에 걸린 그림이 평이 나빠」"
],
"16535": [
"「사장이 직접 그렸어」"
],
"16536": [
"「...잘 못 그렸어?」"
],
"16537": [
"「자기 집 애견이라는데",
"갓 태어난 에일리언 같아」"
],
"16538": [
"손님들이 코멘트하기 엄청",
"곤란할 것 같은 사무소네...."
],
"16539": [
"「가면 애호회라고",
"알아?」"
],
"16540": [
"「응.",
"서재에서 회보 봤어」"
],
"16541": [
"「...재밌겠다」"
],
"16542": [
"「들어가고 싶어?」"
],
"16543": [
"「입회 자격은 되니까",
"들어갈 수는 있는데...」"
],
"16544": [
"「체험 입회 같은 게 있으면",
"가 보고 싶을지도」"
],
"16545": [
"「그, 그렇구나...」"
],
"16546": [
"「이상한 음료 시리즈 알아?」"
],
"16547": [
"「...후후후」"
],
"16548": [
"「엄청 좋아해」"
],
"16549": [
"「...좋아하는구나」"
],
"16550": [
"「근데 요즘 히트작이 없어서",
"좀 쓸쓸해...」"
],
"16551": [
"「우리 누나도 올해 건",
"전체적으로 맛없다고",
"그랬었지」"
],
"16552": [
"「응, 맞아.",
"그냥 평범하게 맛없기만 해」"
],
"16553": [
"「펴, 평범하게?」"
],
