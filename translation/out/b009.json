],
"5227": [
"「그... 그렇지...!?",
"나스 씨 좋은 사람이었... 지...?」"
],
"5228": [
"「조, 조금, 별난 사람,",
"이었지만... 이런... 일,",
"당할... 사람은...」"
],
"5229": [
"나 자신도 무슨 말을 하는지",
"모르게 되어, 멈추지 않는",
"눈물을 계속 닦는다."
],
"5230": [
"톡, 하고 작은 손이 이마에 닿아",
"앞머리를 헝클어뜨리듯 쓰다듬었다."
],
"5231": [
"「좋은 사람이었어」"
],
"5232": [
"「...으...」"
],
"5233": [
"「이리 와요, 나고 씨.",
"아래에서 뭐 따뜻한 거라도",
"마십시다」"
],
"5234": [
"「......응」"
],
"5235": [
"「죄송합니다, 나스 씨...」"
],
"5236": [
"그렇게 말하며 히오리는 나스 씨",
"방문을 닫는다."
],
"5237": [
"「며칠만 더 참으시면 됩니다.",
"데리러 오면 같이 돌아가죠」"
],
"5238": [
"「...미안해요.",
"나스 씨, 미안해...」"
],
"5239": [
"「나고 씨 탓도 아닌데",
"사과할 필요 없어요」"
],
"5240": [
"「그치만...」"
],
"5241": [
"「차에 독까지 들어 있었으면",
"어쩔 도리가 없습죠」"
],
"5242": [
"「당신 탓이 아닙니다요.",
"그렇게 풀 죽지 마세요」"
],
"5243": [
"「......응...」"
],
"5244": [
"그래도...",
"구할 방법은 있었을 텐데."
],
"5245": [
"（미안해요...）"
],
"5246": [
"（나스 씨...）"
],
"5247": [
"「여러분, 어떻게 하실래요?」"
],
"5248": [
"「나도 갈래」"
],
"5249": [
"「우유라도 데워요.",
"아직 개봉 안 한 게 냉장고에",
"있었을 거예요」"
],
"5250": [
"「...바보 자식」"
],
"5251": [
"씁쓸한 목소리에 돌아보니, 어느새",
"방에서 나온 듯한 츠바키 군이",
"나스 씨 방 앞에 서 있었다."
],
"5252": [
"「맨날 남의 말을",
"안 들으니까...」"
],
"5253": [
"「어젯밤에도 그렇게",
"태평하게 떠들어 놓고...」"
],
"5254": [
"「츠바키 씨... 어젯밤 나스 씨가",
"방에 간 뒤에 만났나요?」"
],
"5255": [
"「...목욕 간다면서",
"오락실에 얼굴 내밀었을 때",
"본 게 마지막이었어...」"
],
"5256": [
"「그렇습니까...」"
],
"5257": [
"「...저희 아래층 갑니다만",
"츠바키 씨도 오실래요?」"
],
"5258": [
"「난 됐어...」"
],
"5259": [
"고개를 젓더니 츠바키 군은 도망치듯",
"자기 방으로 돌아갔다."
],
"5260": [
"부엌에서 우유를 데워서",
"어쩐지 거실에 모여 마신다."
],
"5261": [
"모두 초췌한 얼굴로,",
"아직 무슨 일이 일어났는지 믿지",
"못해 당황한 분위기였다."
],
"5262": [
"（...나라고...）"
],
"5263": [
"믿을 수 없다...",
"라기보다, 믿고 싶지 않다."
],
"5264": [
"몇 번을 생각해도, 말도 안 된다는",
"생각밖에 들지 않고..."
],
"5265": [
"갑자기 2층으로 달려가, 역시",
"잘못 본 거라는 걸 확인하고",
"싶은 충동에 사로잡힌다."
],
"5266": [
"（...그런다고 해도",
"소용없다는 걸 아는데）"
],
"5267": [
"역시 악몽이 아니었다는 걸",
"깨달을 뿐, 아무것도 바뀌지",
"않는다는 걸 아는데."
],
"5268": [
"（어째서...",
"이렇게 된 거야...）"
],
"5269": [
"언제, 누가 독 같은 걸..."
],
"5270": [
"...누가."
],
"5271": [
"문득, 그런 생각을 하면서",
"방 안의 사람들을 둘러보고 있는",
"나 자신을 깨달았다."
],
"5272": [
"（...의심하고 있는 거야）"
],
"5273": [
"（난... 지금 여기서,",
"함께 있는 사람들을...）"
],
"5274": [
"그건 무척이나 싫은 기분이었다.",
"하지만 어쩌면 나만이 아니라",
"다른 누구든 같은 생각을 하는지도."
],
"5275": [
"（...이제 싫어...）"
],
"5276": [
"（이런 건, 이제...）"
],
"5277": [
"우리 말고 누군가가 이 저택에",
"숨어 있었던 건 틀림없으니까."
],
"5278": [
"분명 여기에 범인은 없는 거야.",
"다들 독 같은 건 몰라.",
"분명 그럴 거야..."
],
"5279": [
"（...결국 잘 모르겠네）"
],
"5280": [
"（물어서 어쩌겠다는 것도",
"생각 안 했지만...）"
],
"5281": [
"모두 입을 다문 채로",
"데운 우유를 홀짝홀짝 마신다."
],
"5282": [
"「...아아, 맞다.",
"쿠라이시 씨한테도 연락해야죠」"
],
"5283": [
"혼잣말처럼 중얼거리고 히오리는 일어나",
"내선 전화를 집어 든다."
],
"5284": [
"쿠라이시 씨는 아직 깨어 있었는지",
"우리 소동에 깼는지",
"바로 전화를 받은 모양이다."
],
"5285": [
"「...날이 밝으려면 아직",
"한참 남았네요...」"
],
"5286": [
"「그러네」"
],
"5287": [
"「쉬시는 게 좋지",
"않겠어요?」"
],
"5288": [
"「...그렇, 네요...」"
],
"5289": [
"고개를 끄덕이면서도 미사사기 씨는",
"바로 자리에서 일어나지 않았다."
],
"5290": [
"「언니, 어떻게 할래?」"
],
"5291": [
"쌍둥이도 어쩐지 자리를 뜨기 힘든지",
"컵을 든 채 소파에 파묻혀 있다."
],
"5292": [
"딸깍, 소리와 함께 수화기를 내려놓은",
"히오리가 돌아왔다."
],
"5293": [
"「전해 뒀습니다요.",
"뭐, 대충 짐작은 하고 계셨던",
"모양입니다만」"
],
"5294": [
"그렇게 소란스러웠는데, 늘 제일",
"떠들썩했을 사람의 목소리만",
"들리지 않았으니까..."
],
"5295": [
"（...아, 정말...）"
],
"5296": [
"（또 울 것 같아...）"
],
"5297": [
"아까보다 조금 진정된 탓인지,",
"눈물이 나는 게 부끄러워 컵을",
"꼭 쥔 채 고개를 숙이고 만다."
],
"5298": [
"「...여러분, 조금이라도",
"쉬어 두는 게 좋습니다요」"
],
"5299": [
"「식기는 치워 둘 테니까",
"돌아가서 주무세요」"
],
"5300": [
"「히오리 씨는요?」"
],
"5301": [
"「전 아직 다 안 마셨으니까",
"조금 더 여기 있겠습니다」"
],
"5302": [
"사양하는 건지, 잘 마음이 안 드는 건지",
"여자들은 망설이며 대답을 미룬다."
],
"5303": [
"「...잘래」"
],
"5304": [
"불쑥, 시즈나가 그렇게 말하고",
"휘청 일어섰다."
],
"5305": [
"「아, 언니...」"
],
"5306": [
"「안녕히 주무세요.",
"스즈나 씨도, 미사사기 씨도요」"
],
"5307": [
"「그런가요...?",
"죄송해요, 그럼...」"
],
"5308": [
"「...미안해요.",
"그럼 먼저 갈게요」"
],
"5309": [
"시즈나를 따라",
"다른 두 사람도 거실을 나갔다."
],
"5310": [
"「...나고 씨는",
"잠이 안 오십니까요」"
],
"5311": [
"「...응.",
"히오리도 먼저 자도 돼」"
],
"5312": [
"「같이 있게 해 주십쇼.",
"어차피 저도 완전히",
"잠이 깨 버렸으니까요」"
],
"5313": [
"「......미안」"
],
"5314": [
"「나고 씨가 사과할 일은",
"없다니까요」"
],
"5315": [
"「솔직히 말하면요,",
"제가 같이 있어 줬으면 하는 겁니다」"
],
"5316": [
"「히오리도 잠이 안 와?」"
],
"5317": [
"「그것도 있습니다만.",
"나고 씨가 지금 이 저택에서",
"제일 멀쩡하니까」"
],
"5318": [
"「있어 주시면",
"안심이 되거든요...」"
],
"5319": [
"「멀쩡해? 내가?」"
],
"5320": [
"「네, 아까도...",
"울었잖습니까.",
"나스 씨 좋은 사람이었는데 하고」"
],
"5321": [
"「아, 그게 어디가...",
"완전 정신없었다고, 나」"
],
"5322": [
"「아뇨, 제일 평범했어요.",
"나고 씨 말고 다른 사람 머리엔",
"이제 멀쩡한 생각이 안 떠오르니까」"
],
"5323": [
"「...저까지 포함해서요」"
],
"5324": [
"「멀쩡한 생각이 아니라니,",
"뭐가...」"
],
"5325": [
"「아아, 내 차례가 아니었구나...",
"하는 겁니다」"
],
"5326": [
"「싫으시죠...",
"사람이 죽었는데 안심하다니",
"제정신이 아니잖습니까」"
],
"5327": [
"「하, 하지만...!」"
],
"5328": [
"뭐라고 말해야 할지",
"당장은 알 수 없었다."
],
"5329": [
"（그랬지...）"
],
"5330": [
"（나랑 히오리는 무서움의 질이",
"전혀 다른 거야...）"
],
"5331": [
"우연히 흘러들어 왔을 뿐인 난",
"범인이 말하는 복수와 아마 무관하지만."
],
"5332": [
"히오리는 어쩌면 다음 표적이",
"자기일지도 모르는 입장이고."
],
"5333": [
"누가 죽으면, 그건 자기가",
"그만큼 살아남았다는 뜻이고."
],
"5334": [
"「하지만 그건...",
"나만 외부인이라서...」"
],
"5335": [
"「만약 같은 입장이었다면",
"나도 분명...」"
],
"5336": [
"「다른 입장이라 좋은 겁니다.",
"나고 씨가 있어 주니까",
"저도 제정신일 수 있어요」"
],
"5337": [
"「아니, 제정신이면 어땠을지",
"떠올릴 수 있다고 할까요...」"
],
"5338": [
"「당신이 싫지 않으시면",
"여기 있어 주세요」"
],
"5339": [
"「욕하셔도",
"괜찮으니까요.",
"나스 씨 대신에」"
],
"5340": [
"「그런 거...」"
],
"5341": [
"「그런 거, 못 해...!",
"히오리는 잘못 없는걸...」"
],
"5342": [
"「이런, 이런 일... 을,",
"만든, 범인이... 나쁜 거야...」"
],
"5343": [
"「아아, 죄송합니다요.",
"또 울려 버렸네」"
],
"5344": [
"「버, 범인이... 범인이",
"제일... 나쁜... 거야...」"
],
"5345": [
"「알고 있어요...",
"알고 있으니까요」"
],
"5346": [
"「이제... 그만...",
"이런 건... 이런...」"
],
"5347": [
"토닥토닥 머리를 쓰다듬어 주자",
"어쩔 도리 없이",
"눈물이 멈추지 않게 된다."
],
"5348": [
"（히오리는 상냥한데...）"
],
"5349": [
"（좋은 녀석인데,",
"어째서 이런...）"
],
"5350": [
"나스 씨가 없어져서 슬프다고."
],
"5351": [
"그런 당연한 것조차",
"떠올리는 데 시간이 걸리는",
"험한 일을 당하는 걸까..."
],
"5352": [
"분명 나보다 훨씬 무섭고",
"괴롭고 뭔가에 화풀이하고 싶을지도",
"모르는데..."
],
"5353": [
"「...미안...」"
],
"5354": [
"「나만 울고 있어서...",
"미안...」"
],
"5355": [
"「괜찮다니까요」"
],
"5356": [
"「그야 웃어 주시는 편이",
"좋은 건 당연합니다만」"
],
"5357": [
"「전 어쩐지 이제...",
"슬프다든가 그런 걸",
"잘 떠올릴 수가 없어요」"
],
"5358": [
"「그러니까 살아서 여길",
"나갈 때까지 안 울 겁니다」"
],
"5359": [
"「나고 씨가 저 대신",
"울고 화내 주세요」"
],
"5360": [
"「안 그러면 평범한 감정이란 걸",
"잊어버릴 것 같으니까...」"
],
"5361": [
"그대로 눈물이 멈출 때까지",
"아무 말 없이 있자..."
],
"5362": [
"...어느새 꾸벅꾸벅",
"졸아 버렸던 모양이다."
],
"5363": [
"「...씨?",
"나고 씨?」"
],
"5364": [
"「...어...」"
],
"5365": [
"「아아, 깨셨습니까?」"
],
"5366": [
"「어... 어라...",
"나, 잤어?」"
],
"5367": [
"「꾸벅꾸벅 조시던뎁쇼」"
],
"5368": [
"「으악, 미안...」"
],
"5369": [
"「괜찮아요, 피곤하시겠죠.",
"주무실 거면 방에 가서",
"주무시는 게 좋습니다요」"
],
"5370": [
"「...아니.",
"이제 날이 밝아 오고 있고」"
],
"5371": [
"창문으로 어렴풋한",
"밝음이 보이고 있었다."
],
"5372": [
"「그렇네요...」"
],
"5373": [
"「...이제 괜찮아.",
"안 울 테니까...」"
],
"5374": [
"「정말 괜찮으십니까요?」"
],
"5375": [
"「응, 이제...",
"꽤 진정됐으니까」"
],
"5376": [
"「...그렇습니까」"
],
"5377": [
"히오리는 어째선지 조금 침울한",
"얼굴로 말끝을 흐린다."
],
"5378": [
"「...왜 그래?」"
],
"5379": [
"「아뇨...",
"나스 씨 방을 잠가 둬야",
"하지 않겠나 해서...」"
],
"5380": [
"「그렇구나, 아직 문이",
"열려 있었지...」"
],
"5381": [
"「...그럼」"
],
"5382": [
"「사진, 찍어 두는 게 좋겠지」"
],
"5383": [
"「...괜찮으시겠습니까」"
],
"5384": [
"「응, 그치만...",
"경찰에 넘길 때 내 휴대폰",
"하나만 주면 되는 게...」"
],
"5385": [
"「...죄송합니다.",
"이렇게 큰일이 될 줄 알았으면",
"처음부터 제 걸로 찍을 걸 그랬네요」"
],
"5386": [
"「그건 어쩔 수 없어.",
"나도 설마...」"
],
"5387": [
"그때는 아직 아무 실감도 없어서",
"이렇게까지 끔찍한 일이 될 줄은",
"상상도 못 했다..."
],
"5388": [
"「...가자」"
],
"5389": [
"「네」"
],
"5390": [
"무거운 몸을 일으켜",
"나스 씨 방으로 향한다."
],
"5391": [
"...빗소리는 여전히",
"끊임없이 이어지고 있는데."
],
"5392": [
"（평소보다 조용한",
"것 같은 기분이 들어...）"
],
"5393": [
"방 안은 아까 봤을 때와 하나도",
"달라지지 않았다."
],
"5394": [
"아주 조금, 역시 뭔가",
"잘못된 게 아닐까 믿고 싶었던",
"마음이 녹듯이 사라져 갔다."
],
"5395": [
"「나고 씨, 밖에서 기다리셔도",
"괜찮습니다요」"
],
"5396": [
"복도에 혼자 있는 것도 싫어서",
"같이 방에 들어가 휴대폰을 건넨다."
],
"5397": [
"「금방 끝나니까요...」"
],
"5398": [
"그렇게 말하며 히오리는 휴대폰",
"카메라를 켠다."
],
"5399": [
"「...나스 씨 말야,",
"돌아가신 건 바로였지」"
],
"5400": [
"「차... 독을 마시고",
"바로...」"
],
"5401": [
"「...네.",
"맥 짚었을 때 아직 체온이",
"있었으니까요...」"
],
"5402": [
"「차 말고, 더 전에 먹은",
"다른 뭔가에 독이 들어 있었을",
"가능성은 없을까」"
],
"5403": [
"「그러면 꽤나",
"지효성이네요...」"
],
"5404": [
"히오리는 한순간 망설이는 표정을",
"지었지만, 곧 나스 씨의",
"얼굴 옆에 무릎을 꿇었다."
],
"5405": [
"「히오리?」"
],
"5406": [
"「...청산 계열인 것 같습니다」"
],
"5407": [
"「아몬드 같은 냄새가",
"나거든요, 그 계열 독은」"
],
"5408": [
"「...아아, 차 쪽도 그렇네.",
"이건 아마 틀림없겠죠」"
],
"5409": [
"「...그렇구나」"
],
"5410": [
"「저기, 미안.",
"왠지... 내가 이상한 소릴",
"꺼내서, 그런...」"
],
"5411": [
"「무슨 말씀을요.",
"실은요, 저도 신경은",
"쓰였던 겁니다」"
],
"5412": [
"「하지만 아까는 도저히",
"거기까지 생각이 안",
"돌아갔으니까요...」"
],
"5413": [
"그래도, 이걸로...",
"나스 씨의 사인은 그 차에 든",
"독이 틀림없는 것 같다..."
],
"5414": [
"「자, 휴대폰 고맙습니다」"
],
"5415": [
"「...가실까요」"
],
"5416": [
"휴대폰을 받아 방을 나온다.",
"이번에야말로 정말로..."
],
"5417": [
"...나스 씨의 방은",
"닫혔다."
],
"5418": [
"（...안녕히 주무세요）"
],
"5419": [
"작게 손을 모은다.",
"빨리 구조가 와서",
"함께 산을 내려갈 수 있기를."
],
"5420": [
"「...히오리, 어떻게 할 거야?",
"또 서재?」"
],
"5421": [
"「네, 책 읽고 있겠습니다.",
"용건 있으시면 언제든",
"불러 주세요」"
],
"5422": [
"「그럼 이따 봬요.",
"너무 무리하진 마시고요」"
],
"5423": [
"「응, 알았어.",
"이따 봐」"
],
"5424": [
"「네, 이따가」"
],
"5425": [
"히오리는 훌쩍 기모노 자락을",
"나부끼며 계단을 내려갔다."
],
"5426": [
"（저 녀석이야말로 전혀",
"안 잔 거 아닐까...）"
],
"5427": [
"태연한 얼굴을 하고 있었지만.",
"잠이 안 오는 건지도 모르겠다..."
],
"5428": [
"「...쿠라이시 씨」"
],
"5429": [
"훌쩍 복도로 나온",
"쿠라이시 씨는 말없이 나스 씨의",
"방문을 바라보았다."
],
"5430": [
"「죽여도 안 죽을 놈이라고",
"생각했는데 말이지」"
],
"5431": [
"「낮에는 완전히",
"평소대로였다며」"
],
"5432": [
"「평소대로였어요.",
"저녁 먹을 때도, 그 후에도」"
],
"5433": [
"「그 후?",
"그러고 보니 몇 번이나 방을",
"들락날락하더군」"
],
"5434": [
"「몇 번이나요?」"
],
"5435": [
"「그래, 뭘 하고 있었는지는",
"모르겠지만」"
],
"5436": [
"「그게 어젯밤",
"몇 시쯤이었나요?」"
],
"5437": [
"「7시 전에 한 번 돌아왔다가",
"15분인가 지나서 우당탕",
"나갔다 싶더니...」"
],
"5438": [
"「또 5분도 안 돼서",
"돌아온 모양이더군」"
],
"5439": [
"「아, 나스 씨는 분명",
"한 번 덤벨 가지러 왔다가",
"또 금방 돌아가서...」"
],
"5440": [
"（어라, 그치만...",
"그건 7시 전이었던 것 같은데）"
],
"5441": [
"（그럼 15분쯤 지나서",
"나갔다가 또 돌아왔다는",
"건...）"
],
"5442": [
"「뭐야?",
"왜 그래?」"
],
"5443": [
"「아뇨, 저기,",
"나스 씨가 5분쯤 만에",
"돌아온 게...」"
],
"5444": [
"「정확히 몇 시쯤이었는지",
"기억하세요?」"
],
"5445": [
"「그땐 7시 넘었지.",
"5분쯤은」"
],
"5446": [
"「쿠라이시 씨, 그때 나스 씨를",
"만나셨어요?」"
],
"5447": [
"「만나진 않았지만",
"그 녀석 방문 소리였던",
"건 확실해」"
],
"5448": [
"「쌍둥이 아가씨라면",
"그 조금 뒤에",
"만났다만」"
],
"5449": [
"「쌍둥이라면",
"두 사람 다요?」"
],
"5450": [
"「아니, 동생 쪽만이다.",
"화장실 앞에서 딱",
"마주쳐 버려서 말이지」"
],
"5451": [
"「스즈나 말인가요」"
],
"5452": [
"「그 말투면 그렇겠지.",
"으아, 깜짝이야~ 하고",
"그러더라고」"
],
"5453": [
"「그 반응은 스즈나",
"같네요」"
],
"5454": [
"「아마도」"
],
"5455": [
"「뭐, 어느 쪽이든",
"독살이면 알리바이 따위",
"별 의미도 없겠지」"
],
"5456": [
"「의미가 있다면",
"죽은 시간보다 언제 독이",
"들어갔느냐, 겠지」"
],
"5457": [
"「그걸 알면",
"고생할 것도 없지만...」"
],
"5458": [
"그렇게 말을 남기고",
"쿠라이시 씨는 다시 훌쩍",
"방으로 돌아갔다."
],
"5459": [
"（언제, 독이...）"
],
"5460": [
"（...그런 걸 특정",
"할 수 있을까...）"
],
"5461": [
"「아, 맞다.",
"알리바이 표...!」"
],
"5462": [
"서재에 가자.",
"히오리가 물어봐 준 얘기도",
"들어야지..."
],
"5463": [
"「어라, 나고 씨.",
"무슨 일이세요?」"
],
"5464": [
"「저기 있잖아, 그거,",
"지금 하는 김에...」"
],
"5465": [
"「...아아, 표 말이군요.",
"그러고 보니 그랬죠」"
],
"5466": [
"「하지만 까다롭네요.",
"나스 씨의 경우 사망 시각은",
"확실합니다만...」"
],
"5467": [
"「응, 독이니까",
"마신 시간엔 범인이 어디 있든",
"상관없는 거지」"
],
"5468": [
"「오히려 독을 넣은 시간이죠.",
"그 기회가 있었던 사람인가...」"
],
"5469": [
"「그렇다면 표의 축으로 할 건",
"확실하네요」"
],
"5470": [
"「음, 그건...」"
],
"5471": [
"「독이 든 차...」"
],
"5472": [
"「네, 그건 저희가 아직",
"오락실에 있을 때 나스 씨가",
"들고 있던 걸 봤으니까요」"
],
"5473": [
"「응, 그랬지」"
],
"5474": [
"「목욕?」"
],
"5475": [
"「아니 뭐, 목욕한다느니",
"뭐니 떠들긴 했습니다만",
"그게 아니라요」"
],
"5476": [
"「어, 아, 그럼...」"
],
"5477": [
"「...덤벨?」"
],
"5478": [
"「왜 그렇게 됩니까.",
"뭐, 그것도 들고 있었지만요」"
],
"5479": [
"「아, 아니지.",
"음...」"
],
"5480": [
"「나스 씨가 부엌에 가서",
"차를 가져갔다는 건",
"확실하니까요」"
],
"5481": [
"「그때 아직 부엌에 있던",
"여자분들이 다 봤고요」"
],
"5482": [
"「그렇지.",
"그 뒤에 또 오락실로 덤벨",
"가지러 돌아와서...」"
],
"5483": [
"「처음 오락실 나간 게",
"아마 6시 반쯤, 차 들고 돌아온",
"게 40분쯤이었던가요」"
],
"5484": [
"「응... 아, 맞다.",
"아까 쿠라이시 씨를 복도에서",
"만났는데 말야」"
],
"5485": [
"「7시 전에 나스 씨가 방에",
"돌아온 소리를 들었대.",
"그런데...」"
],
"5486": [
"「15분인가 지나서 나갔다",
"싶더니 또 5분쯤 만에",
"문소리가 났다는 거야」"
],
"5487": [
"「그럼 나스 씨가 방에",
"돌아간 게 6시 45분쯤이면",
"그때부터 7시쯤까지 방에...」"
],
"5488": [
"「쿠라이시 씨 말로는",
"또 금방 문소리가 난 건",
"7시 조금 넘어서래」"
],
"5489": [
"「...뭐 하러 돌아갔을까요.",
"갈아입을 옷이라도 잊었나...」"
],
"5490": [
"「애초에 그게 정말",
"나스 씨였을까요?」"
],
"5491": [
"「쿠라이시 씨는 문소리를 들었다고",
"했다면, 나스 씨를 만난",
"건 아니란 거죠」"
],
"5492": [
"「...응.",
"만나진 않았대」"
],
"5493": [
"「그 뒤에 화장실 앞에서",
"스즈나랑은 딱",
"마주쳤다지만」"
],
"5494": [
"「그럼 틀림없이 나스 씨라고",
"특정할 순 없는 거군...」"
],
"5495": [
"「...그렇구나.",
"그럼 표도 7시쯤의",
"나스 씨 칸은...」"
],
"5496": [
"「방이 아니라 2층,",
"정도로 적어 두는 게",
"좋으려나」"
],
"5497": [
"「그렇네요.",
"지금으로선 단정 못 하니까」"
],
"5498": [
"「나스 씨가",
"목욕하고 돌아온 건",
"7시 반 조금 전이었나요」"
],
"5499": [
"「응, 그쯤",
"이었던 것 같아」"
],
"5500": [
"「그 뒤엔 바로 방으로",
"돌아갔지」"
],
"5501": [
"「그리고... 시즈나 씨는",
"2층 계단참의",
"긴 의자에 있었죠」"
],
"5502": [
"「7시 넘어서부터",
"한동안 있었다는 얘기였나요」"
],
"5503": [
"「방으로 돌아가는 나스 씨를",
"거기서 만났지」"
],
"5504": [
"「네, 7시 반쯤",
"나스 씨가 돌아왔다고",
"했을 겁니다」"
],
"5505": [
"「시즈나네가 2층에",
"돌아간 게 몇 시쯤이었지」"
],
"5506": [
"「6시 40분은 지났다는",
"얘기였던 것 같습니다요」"
],
"5507": [
"「스즈나 씨는 그 뒤",
"7시 넘어서까지 시즈나 씨 방에",
"있었다는데요」"
],
"5508": [
"「그 뒤에 복도에서",
"쿠라이시 씨를 만난 거구나」"
],
"5509": [
"「츠바키 군은 7시 넘어서까지",
"우리랑 같이 오락실에",
"있었고...」"
],
"5510": [
"「방에 돌아가는 걸",
"시즈나 씨가 봤었죠」"
],
"5511": [
"「...그럼",
"다시 생각해서 정리해 볼게」"
],
"5512": [
"「모르겠으면 또",
"물으러 오세요」"
],
"5513": [
"「응, 고마워.",
"그럼 이따 봐」"
],
"5514": [
"「네, 조심하세요」"
],
"5515": [
"여기 있어도 소용없으니",
"어디 나가 볼까..."
],
"5516": [
"（마침 잘 됐으니",
"이대로 오락실에 가자...）"
],
"5517": [
"「어머...",
"슬슬 1층에",
"내려가 보는 게 좋을까」"
],
"5518": [
"오락실에 와서 라디오를 켜 본다.",
"여전히 잡음이 심해서",
"잘 들리지 않는다."
],
"5519": [
"「...저 애, 효과 없네」"
],
"5520": [
"저 애...",
"첫날 밤에 나스 씨가 매단",
"테루테루보즈 말이겠지."
],
"5521": [
"...이제 효과 없을지도.",
"만들어 준 본인이 이제",
"없어져 버렸으니까."
],
"5522": [
"（그래도, 적어도...）"
],
"5523": [
"우리가 산을 내려갈 수 있게 되면",
"같이 데려가 주고 싶은데."
],
"5524": [
"누구한테 돌려주면 될까..."
],
"5525": [
"「아... 어?」"
],
"5526": [
"「왜 그러세요?",
"멍하니 계시고」"
],
"5527": [
"「아니...",
"저 녀석, 어떻게 하면 좋을까」"
],
"5528": [
"「저 녀석?」"
],
"5529": [
"「테루테루보즈」"
],
"5530": [
"「거실...",
"테라스에 있는 거」"
],
"5531": [
"「...어떻게 하냐니요」"
],
"5532": [
"「나스 씨 수건이잖아.",
"두고 가면 안 될 것 같은데」"
],
"5533": [
"「가져가서 나스 씨",
"소속사 사람한테라도",
"주면 되려나...」"
],
"5534": [
"「아니면 경찰이 올 때까지",
"거기 둬야 하려나」"
],
"5535": [
"「...경찰한테 뭐라고 하고",
"보여 줄 겁니까요」"
],
"5536": [
"「어? 음...」"
],
"5537": [
"「...미안.",
"무슨 소릴 하는 걸까, 나...」"
],
"5538": [
"「예예, 괜찮아요.",
"좀 신경 쓰였던 거죠」"
],
"5539": [
"「응, 왠지 갑자기...」"
],
"5540": [
"「가져갈 사람이 없어져서",
"어떻게 되는 걸까 싶어서...」"
],
"5541": [
"「신경 쓰이시면",
"제가 가져가서 나스 씨",
"소속사 분께라도 드리죠」"
],
"5542": [
"...정말, 무슨 소릴 하는 걸까.",
"왜 갑자기 테루테루보즈 걱정을."
],
"5543": [
"「아...",
"안녕하세요, 여러분...」"
],
"5544": [
"「안녕하세요.",
"몸은 좀 어떠세요?」"
],
"5545": [
"「네, 조금 진정됐어요.",
"저기... 날씨는...」"
],
"5546": [
"「안타깝지만 그다지 좋아질",
"것 같지 않습니다요」"
],
"5547": [
"「...그런가요...」"
],
"5548": [
"그렇구나...",
"나스 씨가 그런 식으로",
"돌아가셨으니까..."
],
"5549": [
"...평범하게 이야기하는 듯한",
"말투였는데..."
],
"5550": [
"（이제... 아무도...）"
],
"5551": [
"（아무도 서로를",
"믿지 않는구나...）"
],
"5552": [
"오락실에 와서 라디오를 켜 본다.",
"여전히 잡음이 심해서",
"잘 들리지 않는다."
],
"5553": [
"「정말이야!?」"
],
"5554": [
"「사, 사람이었어...",
"남자였고... 하, 하지만...」"
],
"5555": [
"「...어쩔 수 없구먼.",
"쓰러지진 마세요?」"
],
"5556": [
"시즈나는 히오리가 내민 휴대폰을",
"별 망설임도 없이 받아 든다."
],
"5557": [
"「괘, 괜찮아?",
"언니...」"
],
"5558": [
"「......무리」"
],
"5559": [
"「스즈는 안 보는 게 좋겠어」"
],
"5560": [
"「...으, 응」"
],
"5561": [
"「저... 저기...",
"그럼 저는...」"
],
"5562": [
"「그만두는 게」"
],
"5563": [
"「저도 그렇게 생각합니다요」"
],
"5564": [
"「...그런가요.",
"그럼... 사양할게요」"
],
"5565": [
"「아마 누가 봐도 거의",
"누군지 모를 거야」"
],
"5566": [
"「그렇죠.",
"적어도 전 아는 사람이었다",
"해도 알아볼 수 있을지...」"
],
"5567": [
"「응, 나도」"
],
"5568": [
"「...자, 오빠」"
],
"5569": [
"내민 휴대폰을 받아서",
"얼른 품에 넣는다."
],
"5570": [
"「...오빠, 용케 기절해서",
"우물에 안 빠졌네...」"
],
"5571": [
"「무서운 소리 하지 마...」"
],
"5572": [
"기절은 안 했지만 패닉에 빠져",
"미끄러질 뻔했던 만큼..."
],
"5573": [
"빠졌으면 틀림없이 기절했을",
"테지만."
],
"5574": [
"「...근데」"
],
"5575": [
"「그 사람, 언제부터",
"우물에 있었을까」"
],
"5576": [
"「어? 글, 글쎄...」"
],
"5577": [
"「상태가 상태니까요,",
"날짜를 특정하는 건",
"어려울 겁니다요」"
],
"5578": [
"「다만, 아무리 전이라도",
"며칠 이내일 것 같습니다만」"
],
"5579": [
"「며칠... 이라는 건",
"우리가 오고 나서란 거야?」"
],
"5580": [
"「오고 나서거나, 오기 직전,",
"그쯤 아니겠습니까」"
],
"5581": [
"「체형은 다르지」"
],
"5582": [
"「체형? 누구랑?」"
],
"5583": [
"「쿠라이시 씨라든가」"
],
"5584": [
"「그치만 그 아저씨",
"계속 방에 틀어박혀 있으니까",
"모르는 새 우물에 빠져도 모르잖아」"
],
"5585": [
"「그렇지만...」"
],
"5586": [
"「응, 머리 모양도 달랐던 것 같아」"
],
"5587": [
"「아, 그, 그렇네!",
"누가 있었잖아, 주차장에서",
"펑크 내고 한 사람이!」"
],
"5588": [
"「그게 이 사람이면",
"역시 한 명 모자라」"
],
"5589": [
"「어느 쪽이든",
"이 사람을 우물 속에",
"던져 넣은 범인이 있겠네요」"
]
}