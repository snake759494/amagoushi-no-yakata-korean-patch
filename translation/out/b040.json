 "21882": [
  "「당신 가끔 혼자서",
  "무모한 짓 하잖습니까」"
 ],
 "21883": [
  "「아, 아니, 음,",
  "괜찮아, 위험한 짓 안 할게」"
 ],
 "21884": [
  "「정말이죠?」"
 ],
 "21885": [
  "「...어쩔 수 없구먼.",
  "겁쟁이인 주제에 고집은 세서」"
 ],
 "21886": [
  "「겁쟁이니까 무섭지 않게",
  "되길 바라는 거잖아」"
 ],
 "21887": [
  "「네네, 알았습니다.",
  "그럼, 조심하세요」"
 ],
 "21888": [
  "「네, 안녕히 주무세요」"
 ],
 "21889": [
  "히오리는 침대에 누웠고,",
  "잠시 후 금세 숨소리를",
  "내기 시작했다."
 ],
 "21890": [
  "...눕자마자 잠들어",
  "버리는 걸 보면, 역시",
  "피곤한 거겠지."
 ],
 "21891": [
  "（...근데 제대로",
  "간파당했네, 나...）"
 ],
 "21892": [
  "하긴 매번 상담하고 그러니까",
  "당연할지도 모르지만."
 ],
 "21893": [
  "（...자...）"
 ],
 "21894": [
  "「일단 갖다주러",
  "가 볼게」"
 ],
 "21895": [
  "「안 열어 줄지도",
  "모르지만...」"
 ],
 "21896": [
  "「그렇네요.",
  "뭐, 혹시 모르니까」"
 ],
 "21897": [
  "저녁을 받아 들고",
  "2층으로 올라갔다..."
 ],
 "21898": [
  "「쿠라이시 씨, 실례합니다~」"
 ],
 "21899": [
  "「어라?",
  "쿠라이시 씨...?」"
 ],
 "21900": [
  "「시끄럽구먼, 무슨 볼일이야!?」"
 ],
 "21901": [
  "「아, 저기, 저녁을...」"
 ],
 "21902": [
  "「먹을 수 있을 리가 있냐!",
  "뭐가 들었는지 모르는데!」"
 ],
 "21903": [
  "...역시나.",
  "이렇게 경계하고 있으니",
  "받아 줄 리가 없나..."
 ],
 "21904": [
  "（...어쩔 수 없지...）"
 ],
 "21905": [
  "「미안, 역시 안 됐어」"
 ],
 "21906": [
  "「그렇습니까...",
  "뭐, 어쩔 수 없죠」"
 ],
 "21907": [
  "「우리끼리 먹어 치웁시다.",
  "나눌 테니 이리 주쇼」"
 ],
 "21908": [
  "들고 온 접시 분량도",
  "우리 접시에 반씩 나눠 담았다."
 ],
 "21909": [
  "「후딱 먹어 치우고",
  "쉽시다요」"
 ],
 "21910": [
  "「...쿠라이시 씨~」"
 ],
 "21911": [
  "「쿠라이시 씨, 저기~...」"
 ],
 "21912": [
  "...대답이 없다.",
  "혹시 몰라 잠시 그 자리에서",
  "기다려 봤지만 아무 소리도 없었다."
 ],
 "21913": [
  "「저녁 가져왔는데요.",
  "히오리가 만들어서, 음...」"
 ],
 "21914": [
  "「...안전한 재료만 골랐으니",
  "괜찮을 거라고... 음...」"
 ],
 "21915": [
  "안 될 것 같다...",
  "어쩔 수 없지, 더 버텨 봐도",
  "열어 주지 않겠지."
 ],
 "21916": [
  "「...역시 안 됐어」"
 ],
 "21917": [
  "「아, 역시 그렇습니까.",
  "뭐, 어쩔 수 없죠」"
 ],
 "21918": [
  "목욕을 마치고 방으로 돌아오니",
  "히오리는 벌써 졸린 듯",
  "침대에 누워 있었다."
 ],
 "21919": [
  "「어서 오세... 하아암...」"
 ],
 "21920": [
  "「먼저 자도 되는데」"
 ],
 "21921": [
  "「당신 내버려 두면 가끔",
  "이상하게 무모한 짓 하잖습니까」"
 ],
 "21922": [
  "「제대로 잠드는 걸 볼 때까진",
  "안심이 안 돼서요...」"
 ],
 "21923": [
  "「...이제 잘게」"
 ],
 "21924": [
  "내가 침대에 들어가자",
  "히오리는 금세 숨소리를 냈다."
 ],
 "21925": [
  "（...그렇게 눈을 떼면",
  "위태로워 보이나...?）"
 ],
 "21926": [
  "...그래도, 뭐.",
  "분명 쿠라이시 씨를 이대로",
  "두는 건 위험한 느낌이 들지만."
 ],
 "21927": [
  "（...어떻게 할까）"
 ],
 "21928": [
  "（아침까지 방 앞에서",
  "지키는 게...）"
 ],
 "21929": [
  "（...역시",
  "이대로는 걱정돼...）"
 ],
 "21930": [
  "소리 나지 않게 이불에서 나와",
  "상의를 걸치고, 살며시 방을",
  "빠져나왔다."
 ],
 "21931": [
  "（...이쯤이면 되려나）"
 ],
 "21932": [
  "쿠라이시 씨 방문 근처에",
  "앉아 벽에 기댔다."
 ],
 "21933": [
  "（좀 춥네...）"
 ],
 "21934": [
  "（...그래도 날이 밝을 때까지만",
  "참으면 되니까...）"
 ],
 "21935": [
  "이대로 가만히 있자.",
  "아무도 오지 않기를 빌며",
  "무릎을 끌어안았다."
 ],
 "21936": [
  "...."
 ],
 "21937": [
  "방금 뭔가 삐걱거리는 듯한",
  "기분 나쁜 소리가..."
 ],
 "21938": [
  "（문소리는 아닌데,",
  "어디서 들린 거지...?）"
 ],
 "21939": [
  "소리 나는 곳을 찾으려 급히 주위를",
  "둘러봤지만 어딘지 모르겠다."
 ],
 "21940": [
  "（또야...!）"
 ],
 "21941": [
  "（왠지 벽 속에서 들린",
  "것 같아...）"
 ],
 "21942": [
  "아무래도 이상한 기척이 느껴져",
  "일단 일어서려고 했다."
 ],
 "21943": [
  "하지만..."
 ],
 "21944": [
  "「으아아악!?」"
 ],
 "21945": [
  "아까보다 요란한 소리가 나는",
  "동시에 저택이 심하게 흔들려",
  "바닥에 나뒹굴고 말았다."
 ],
 "21946": [
  "「아얏...",
  "뭐, 뭐야... 지진...?」"
 ],
 "21947": [
  "간신히 벽 쪽으로 기어가려",
  "했지만, 잔잔한 진동에",
  "몸이 굳어 제대로 못 움직인다."
 ],
 "21948": [
  "「어, 어, 어떡해...",
  "누가...!」"
 ],
 "21949": [
  "분명 지진이야, 아니면 산사태",
  "영향이 이 근처까지 온 거야..."
 ],
 "21950": [
  "점점 심해지는 흔들림에 공포를",
  "느끼며 머리를 감쌌다."
 ]
}