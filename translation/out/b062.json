 ],
 "31619": [
  "...두 손 들었다.",
  "그렇게 얼굴에 드러났나."
 ],
 "31620": [
  "「그치만 난 아니야」"
 ],
 "31621": [
  "「...음, 그래도」"
 ],
 "31622": [
  "「내가 범인이었으면",
  "그런 말 안 해」"
 ],
 "31623": [
  "「그런 말?」"
 ],
 "31624": [
  "「고양이...?」"
 ],
 "31625": [
  "「『고양이는 마다라이 씨』라고.",
