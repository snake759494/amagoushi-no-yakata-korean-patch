 ],
 "31588": [
  "「아아, 뭐야!",
  "그런 거였구나」"
 ],
 "31589": [
  "「그, 그래요...」"
 ],
 "31590": [
  "「그렇구나 그렇구나,",
  "지금부터 가는구나」"
 ],
 "31591": [
  "「...그래서, 누군데?」"
 ],
 "31592": [
  "「......나,",
  "나스 씨...」"
 ],
 "31593": [
  "「...버, 범인 아니...」"
 ],
 "31594": [
  "「아아, 나는 아니야.",
