 ],
 "31630": [
  "닫힌 문 앞에서",
  "한동안 멍하니 서 있었다."
 ],
 "31631": [
  "（...고양이 일도,",
  "부엌에 있던 일도...）"
 ],
 "31632": [
  "전부 이렇게 의심받을 때",
  "반박하려고 일부러 한 것일지도",
  "모르는데..."
 ],
 "31633": [
  "（왠지 지금 모습을 보면",
