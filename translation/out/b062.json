 ],
 "31571": [
  "「대단하다, 나고무 군!",
  "나도 일단 생각은 해 봤는데",
  "전혀 모르겠더라!」"
 ],
 "31572": [
  "「그럼 이제 구조대가 오기만",
  "기다리면 되겠네.",
  "빨리 오면 좋겠다」"
 ],
 "31573": [
  "「아뇨, 저기,",
  "그 범인 말인데요...」"
 ],
 "31574": [
  "「아, 그러고 보니 어떻게 됐어?",
  "어디 붙잡아 뒀어?」"
 ],
 "31575": [
  "「어... 아뇨, 아직...」"
 ],
 "31576": [
  "눈앞에서 웃고 있습니다.",
  "...라니, 뭐야 이 상황."
 ],
 "31577": [
  "「어라, 혹시",
