 ],
 "31595": [
  "「그래서 누군데?",
  "같이 가서 잡을까?」"
 ],
 "31596": [
  "「음, 저기... 다음에 또 올게요」"
 ],
 "31597": [
  "「그래?",
  "힘들 것 같으면",
  "언제든 불러 줘」"
 ],
 "31598": [
  "「네, 실례했습니다...」"
 ],
 "31599": [
  "...저건...",
  "정말 범인이 아닌 건지",
  "엄청나게 만만찮은 건지."
 ],
 "31600": [
  "（이젠 어느 쪽인지",
  "영문을 모르겠어...）"
 ],
 "31601": [
  "뭐가 잘못됐을까.",
  "말을 꺼내는 방식... 같은",
  "문제가 아닌 것 같기도 하고."
 ],
 "31602": [
  "（아, 진짜, 이런 데서",
  "막막해해 봤자 소용없어）"
 ],
 "31603": [
  "터덜터덜 걸으며 아까의",
