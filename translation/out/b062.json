 ],
 "31578": [
  "「그렇구나, 잡으러 가는구나!",
  "그런 건 자신 있어, 맡겨 줘」"
 ],
 "31579": [
  "「그, 그게 아니라...」"
 ],
 "31580": [
  "정말 어디까지 진심으로 하는 말인지",
  "모르겠다..."
 ],
 "31581": [
  "시치미 떼는 것치고는 너무나도",
  "명랑하다고 할까."
 ],
 "31582": [
  "「도망친 게 아니야?」"
 ],
 "31583": [
  "「아니에요,",
  "잡은 것도 도망친 것도",
  "아니고요...」"
 ],
 "31584": [
  "「아...",
  "혹시 죽어 버렸다든가」"
 ],
 "31585": [
  "「아뇨, 살아 있어요」"
 ],
 "31586": [
  "「응? 그럼 왜",
  "안 잡는 거야?」"
 ],
 "31587": [
  "「아, 아직 범인이죠 하고",
