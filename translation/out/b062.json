 ],
 "31611": [
  "「아... 저기 말이야...」"
 ],
 "31612": [
  "「이 사건의, 범인...」"
 ],
 "31613": [
  "「나 아니야」"
 ],
 "31614": [
  "「어... 뭐?」"
 ],
 "31615": [
  "핵심에 닿기도 전에 딱 잘라",
  "부정당해서 내 쪽이 당황하고",
  "말았다."
 ],
 "31616": [
  "「의심하고 있지」"
 ],
 "31617": [
  "「...왜, 왜...」"
 ],
 "31618": [
  "「그렇게 정색한 얼굴로",
