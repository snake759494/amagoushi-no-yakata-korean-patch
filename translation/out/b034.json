 ],
 "18628": [
  "「레벨 90 이상이어도",
  "30분 싸워서 이길까 말까",
  "반반이래」"
 ],
 "18629": [
  "「...저기, 그거",
  "만약 쓰러뜨려 버리면",
  "어떻게 돼...?」"
 ],
 "18630": [
  "「최종 보스 자리에,",
  "사실 보스가 아닌 엄청 약한",
  "대역이 앉아 있대」"
 ],
 "18631": [
  "「난 평범하게만",
  "공략해 봐서",
  "시험은 안 해 봤지만」"
 ],
 "18632": [
  "「...왜 최종 보스를",
  "도중에 쓰러뜨릴 수 있는",
  "설정으로 했을까...」"
 ],
 "18633": [
  "「그게 수수께끼야」"
 ],
 "18634": [
  "「소문으론 무슨 버그로 보스를",
  "불러낼 수 있게 돼 버려서",
  "시나리오 쪽을 바꿨다나」"
 ],
 "18635": [
  "「대응 잘못한 거 아냐, 그거!?」"
 ],
 "18636": [
  "「나도 그렇게 생각하지만,",
  "뭔가 여러 사정이 있었겠지」"
 ],
 "18637": [
  "「그 게임 낸 회사,",
  "그거 하나만 내고 망해서",
  "진상은 영원한 수수께끼고」"
 ],
 "18638": [
  "무슨 일이 있었던 걸까..."
 ],
 "18639": [
  "「...아아, 그",
  "도시 전설 같은 드라마?」"
 ],
 "18640": [
  "「그런 얘기야?」"
 ],
 "18641": [
  "「아니, 내용은 평범한",
  "서스펜스물이라던데」"
 ],
 "18642": [
  "「보면 저주받는다는",
  "소문이 돌아서 난리가...」"
 ],
 "18643": [
  "「아, 아니, 알았어.",
  "이제 됐어, 고마워」"
 ],
 "18644": [
  "「겁쟁이네, 당신...」"
 ],
 "18645": [
  "「이 저택 꽤 오래됐지」"
 ],
 "18646": [
  "「오래된 건 괜찮은데",
  "왜 이렇게 이상한 모양일까」"
 ],
 "18647": [
  "「복도도 엄청 꺾여 있고",
  "되게 비뚤어진 모양 같지 않아?」"
 ],
 "18648": [
  "「그것도 그렇네」"
 ],
 "18649": [
  "「뭐, 언니는 좋아했지만.",
  "뭔가 이상한 걸 좋아하니까」"
 ],
 "18650": [
  "「그 뒤로, 식당에 들어간 적은",
  "없지?」"
 ],
 "18651": [
  "「없어 없어.",
  "닫은 뒤에, 열쇠도 오락실에",
  "돌려놨잖아?」"
 ],
 "18652": [
  "「응, 그렇게 했어」"
 ],
 "18653": [
  "「그럼, 아무도 안 들어간 거 아냐?",
  "일부러 들어가야 할 볼일이",
  "있을 것 같지도 않고」"
 ],
 "18654": [
  "「오락실 말인데,",
  "창문 근처에 뭔가 젖은 자국이",
  "있었는데 뭐라고 생각해?」"
 ],
 "18655": [
  "「창문 근처?",
  "창문 근처라...」"
 ],
 "18656": [
  "「음~, 그 방 창문이",
  "어땠더라.",
  "별로 안 가 봐서 기억 안 나」"
 ],
 "18657": [
  "「저기, 뒤뜰 우물",
  "말인데...」"
 ],
 "18658": [
  "「아~, 우물...",
  "미안하지만 난, 거의 가까이 간",
  "적도 없어서」"
 ],
 "18659": [
  "「...오빠도",
  "용케 그런 데를 들여다봤네」"
 ],
 "18660": [
  "「나도 반쯤 히오리한테",
  "끌려간 거나",
  "마찬가지지만...」"
 ],
 "18661": [
  "「그래도, 결국 안까지",
  "내려간 거잖아?」"
 ],
 "18662": [
  "「그치만, 뭐가 들었는지",
  "모르는 채로 있는 것도 무섭고」"
 ],
 "18663": [
  "「...왜 호러 영화에서",
  "굳이 이상한 소리 난 쪽으로 가서",
  "무덤 파는 사람이 있는지 알겠어」"
 ],
 "18664": [
  "「여기 베란다는 반대편",
  "방까지 쭉 이어져 있지?」"
 ],
 "18665": [
  "「그럴 텐데,",
  "중간 문이 안 열려서 의미 없어」"
 ],
 "18666": [
  "「그렇네.",
  "언제부터 안 열린 걸까」"
 ],
 "18667": [
  "「녹슬었다며?",
  "그럼, 꽤 전부터 아닐까?」"
 ],
 "18668": [
  "「이 집 사람도 안 열리게",
  "된 걸 모를지도」"
 ],
 "18669": [
  "「그렇겠지.",
  "알았으면 고쳤을 테니까」"
 ],
 "18670": [
  "「거실 밖에 있는 테라스",
  "날 맑으면 기분 좋겠다」"
 ],
 "18671": [
  "「그렇겠지.",
  "나스 씨가 엄청 좋다~ 하면서",
  "부러워했어」"
 ],
 "18672": [
  "「자기 집에도 갖고 싶다던데",
  "어떤 집에 사시는 걸까?」"
 ],
 "18673": [
  "「...왠지 스포츠 짐",
  "같은 것밖에 상상이 안 돼...」"
 ],
 "18674": [
  "「어느 프로레슬러의 호화 저택이야」"
 ],
 "18675": [
  "「...근데 나스 씨니까.",
  "자기 집 지하에 링을 세워 놔도",
  "납득해 버릴 것 같아」"
 ],
 "18676": [
  "정말 있을 것 같다..."
 ],
 "18677": [
  "「온실에 들어가 본 적 있어?",
  "소동 일어나기 전 얘기지만」"
 ],
 "18678": [
  "「오자마자 돌아다닐 때",
  "들여다본 정도려나」"
 ],
 "18679": [
  "「별로 관심 없어서",
  "그렇게 자세히는 안 봤어」"
 ],
 "18680": [
  "「그렇구나.",
  "꽃 같은 거 안 좋아해?」"
 ],
 "18681": [
  "「...뭐, 그렇지」"
 ],
 "18682": [
  "「여기 부엌은 넓고",
  "쓰기 편해 보이네」"
 ]
