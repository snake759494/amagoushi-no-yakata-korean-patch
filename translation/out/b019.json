],
"10461": [
"「네, 자살했다는 뉴스는",
"봤지만, 그 전엔 이름도",
"몰랐던 사람이었습니다」"
],
"10462": [
"「사토에 미도리라고 알아?」"
],
"10463": [
"「사토에...라니,",
"그거 본인한테 들은 겁니까?」"
],
"10464": [
"「미사사기 씨의",
"옛날 예명이잖습니까?」"
],
"10465": [
"「어라, 알고서",
"말한 거 아니었습니까?」"
],
"10466": [
"「아니, 이름은",
"본인한테 들은 게 아니라",
"저기 잡지에 실려 있는데」"
],
"10467": [
"「뭐야,",
"그랬던 겁니까」"
],
"10468": [
"「...제가 폭로했다고는",
"말하지 말아 주십쇼?」"
],
"10469": [
"「비밀이야?」"
],
"10470": [
"「저도 우연히 들었습죠,",
"아는 프로듀서가",
"취해서 불어 버렸을 때」"
],
"10471": [
"「허둥지둥 정신 차리고는,",
"본인이 부끄러워하니까 비밀이야",
"라고 했거든요」"
],
"10472": [
"「...그렇구나.",
"곤란한 사람이네, 그 프로듀서」"
],
"10473": [
"「네, 뭐, 이래저래",
"경박한 걸로 유명해서요.",
"나쁜 사람은 아닙니다만」"
],
"10474": [
"「흐음...?」"
],
"10475": [
"「미사사기 씨 말이야,",
"옛날에 아이돌이었대」"
],
"10476": [
"「허어, 가수도 했었다는",
"얘긴 들었습니다만",
"아이돌이었습니까」"
],
"10477": [
"「그런가 봐.",
"꽤 인기 있었대.",
"난 몰랐지만」"
],
"10478": [
"「저도 거기까지는",
"몰랐습니다」"
],
"10479": [
"「미사사기 씨는 여배우가",
"되고 나서부터밖에",
"몰랐으니까요」"
],
"10480": [
"「가수 쪽 사람들은",
"별로 아는 사람 없어?」"
],
"10481": [
"「영화나 연극도 하는 사람이면",
"가끔 만나지만, 아는 사이랄",
"정도의 사람은 없네요」"
],
"10482": [
"「그렇구나.",
"하긴 평소 일하는 곳도",
"다르니까」"
],
"10483": [
"「저기, 르로이 백작이란 사람",
"알아?」"
],
"10484": [
"「아, 그건 알고말고요」"
],
"10485": [
"「그렇게 유명해?」"
],
"10486": [
"「음, 뭐...",
"오컬트 전설로는 마니아들한테",
"꽤 유명하지 않을까요」"
],
"10487": [
"「...무, 무서운 거야?」"
],
"10488": [
"「그 근처에 이것저것 적힌",
"잡지가 몇 권 있었습니다」"
],
"10489": [
"「왠지 여기저기",
"흩어져서 정리가 안 돼 있어서",
"찾기 힘들겠지만요」"
],
"10490": [
"이 서재에서 흩어져 있다니",
"정말 힘들겠다..."
],
"10491": [
"「기타하야미 료스케란 사람,",
"직업이 탐정이야?」"
],
"10492": [
"「네, 그렇습니다.",
"별로 일은 안 하지만요」"
],
"10493": [
"「이, 일을 안 해?」"
],
"10494": [
"「마음에 드는 의뢰만 받는",
"나쁜 버릇이 있어서요」"
],
"10495": [
"「왓슨 역인 히오리가",
"부추겨서 먹고살 정도로는",
"일을 시키지만요, 억지로」"
],
"10496": [
"「...곤란한 사람이네」"
],
"10497": [
"「곤란한 사람입니다.",
"괴짜에 게으름뱅이에,",
"요리도 청소도 못 하고」"
],
"10498": [
"「혹시 전부 히오리가 해?」"
],
"10499": [
"「그렇습니다.",
"덕분에 저도 집안일 전반을",
"척척 하게 됐습죠」"
],
"10500": [
"「응? 왜?」"
],
"10501": [
"「어릴 때부터 읽어 와서,",
"왓슨이란 건 요리랑 청소를",
"못 하면 안 되는 줄 알았거든요」"
],
"10502": [
"「...히오리는 왓슨이",
"되고 싶었던 거야?」"
],
"10503": [
"「명탐정 체질은 아니라서요」"
],
"10504": [
"「근데 초등학교 때 장래 희망에",
"왓슨이라고 썼더니 선생님한테",
"불려 갔었죠...」"
],
"10505": [
"그야 뭐, 일단 진의를 캐물어",
"보고 싶어지겠지..."
],
"10506": [
"「다카토 엔지로 책에 나오는",
"히오리 말이야...」"
],
"10507": [
"「히오리 료 말입니까?」"
],
"10508": [
"「응, 그래」"
],
"10509": [
"「아...히오리는",
"이름도 같은 거야?」"
],
"10510": [
"「아니, 히오리 료란 풀네임이",
"같은 건가 해서」"
],
"10511": [
"「하하, 아닙니다.",
"저는 성이 아니라",
"이름이 히오리입니다」"
],
"10512": [
"「응? 그래?",
"그럼 성은?」"
],
"10513": [
"「...다카토, 입니다」"
],
"10514": [
"「다...」"
],
"10515": [
"「다카토!?",
"그거, 어, 저기, 친척이나 뭐야?」"
],
"10516": [
"「손자입니다, 저는.",
"다카토 엔지로는 제 할아버지라서요」"
],
"10517": [
"「할아버지...라고.",
"다카토 엔지로가...?」"
],
"10518": [
"「네.",
"제가 여기 불린 이유와",
"무슨 관계가 있는진 모르지만요」"
],
"10519": [
"「그거...다들 알아?」"
],
"10520": [
"「아뇨, 평소에 딱히 말하고",
"다니지 않아서 잠자코 있었는데...」"
],
"10521": [
"「아무래도 이런 이상한 일이",
"되고 나니, 말하는 게",
"좋을지 어떨지」"
],
"10522": [
"「...잘은 모르겠지만」"
],
"10523": [
"「전혀 관계없고 우연일지도",
"모르지만, 그래도...」"
],
"10524": [
"「그렇게 생각 안 하는 사람도",
"있을지 모른다, 그렇죠?」"
],
"10525": [
"「그렇거든요.",
"비겁한 얘기일지 모르지만",
"제 입으로 말할 마음은 안 들고」"
],
"10526": [
"「그...그렇지 않아!",
"히오리는 절대 범인이",
"아니니까...」"
],
"10527": [
"「의심받을지도 모르는 얘기를",
"굳이 안 해도...」"
],
"10528": [
"「...고맙습니다, 나고 씨」"
],
"10529": [
"「게다가 범인이 히오리가 손자란 걸",
"알고 불렀는지도",
"아직 모르는 거고」"
],
"10530": [
"「그렇죠.",
"우연치곤 너무 잘 맞는다",
"싶긴 합니다만」"
],
"10531": [
"그건 확실히 그렇지만, 일부러라면",
"대체 무엇 때문에...?"
],
"10532": [
"「진노 경감이란 사람은 료스케 시리즈에",
"꼭 나오는 사람이야?」"
],
"10533": [
"「꼭은 아니지만,",
"고정 캐릭터죠」"
],
"10534": [
"「도쿄 사건에선 거의",
"같이 수사하고...」"
],
"10535": [
"「가끔 경감 쪽에서 상담하러",
"오기도 하고요」"
],
"10536": [
"「흐음...",
"그럼 협조적인 사람이구나」"
],
"10537": [
"「그렇습니다.",
"중후하고 멋진 아저씨예요」"
],
"10538": [
"「나미즈미 슌지란 사람 말인데...」"
],
"10539": [
"「나미즈미?",
"음...아, 『고양이와 첫눈』에",
"나오는 피해자죠」"
],
"10540": [
"「응, 맞아 맞아.",
"그것도 고양이가 나오지?」"
],
"10541": [
"「그러고 보니 그것도 검은 고양이였죠」"
],
"10542": [
"「네, 하지만 마다라이란 사람은",
"『검은 고양이의 독』에만 나옵니다」"
],
"10543": [
"「그렇구나, 그럼 관계없으려나」"
],
"10544": [
"「『검은 고양이의 독』에 나오는 마다라이",
"씨는 시게오란 이름이구나」"
],
"10545": [
"「아, 그런 이름이었죠」"
],
"10546": [
"「저희가 받은 대본엔 성만",
"설정돼 있었습니다만...」"
],
"10547": [
"「그렇구나.",
"그거 어떻게 전망실까지",
"건너간 거야?」"
],
"10548": [
"「말해 버려도 되겠습니까?」"
],
"10549": [
"「반칙이겠지만, 다 읽을",
"시간이 없는걸...난 읽는 게 느리고」"
],
"10550": [
"「그렇군요, 그럼...」"
],
"10551": [
"「그건 말이죠, 계단참 자체는 그렇게",
"폭이 넓지 않습니다.",
"뛰어넘지 못할 것도 없는 정도」"
],
"10552": [
"「뭐야, 그럼 뛰어넘은 것뿐이야?」"
],
"10553": [
"「혼자라면 뛸 수 있지만 시체를 메고",
"뛰는 건 무리겠죠」"
],
"10554": [
"「참고로 현장은 전망실이 아닙니다.",
"칼에 찔려 죽었는데 혈흔이 있던 건",
"피해자 방이에요」"
],
"10555": [
"「어? 그럼 어떻게 건넜어?」"
],
"10556": [
"「어떻게 했을 것 같습니까?」"
],
"10557": [
"「모르겠어」"
],
"10558": [
"「포기가 빠르시네, 나고 씨...」"
],
"10559": [
"「그치만 서툰걸,",
"트릭 같은 거」"
],
"10560": [
"「그럼 힌트입니다.",
"마다라이 시게오의 시체는 두 팔을 위로",
"뻗은 자세로 굳어 있었습니다」"
],
"10561": [
"「그리고 손목과 발목에는 밧줄로",
"묶인 자국이 있었고요」"
],
"10562": [
"「음, 혹시...」"
],
"10563": [
"「던졌어? 시체를」"
],
"10564": [
"「그게 무슨 괴력입니까」"
],
"10565": [
"「그치만 모르겠는걸!」"
],
"10566": [
"「네네, 정답은...」"
],
"10567": [
"「시체를 어떻게 계단참에 걸쳐서",
"그 위를 걸어간 거?」"
],
"10568": [
"「네, 정답.",
"역시 나고 씨군요」"
],
"10569": [
"「어!? 진짜 맞힌 거야?」"
],
"10570": [
"「...놀라면 어쩝니까」"
],
"10571": [
"「아니, 그치만...",
"그래서 어떻게 걸쳤는데?」"
],
"10572": [
"「아, 그건...」"
],
"10573": [
"「먼저 시체의 두 손과 두 발에 밧줄을",
"묶고, 발 쪽 밧줄은 계단참",
"이쪽 편에 고정합니다」"
],
"10574": [
"「아, 계단참에는 일단 떨어지지",
"않게 난간 같은 게 있거든요」"
],
"10575": [
"「그리고 손에 묶은 밧줄을 건너편으로",
"던지고, 난간 사이로 끝에 갈고리를 단",
"지팡이로 끌어당기는 겁니다」"
],
"10576": [
"「그렇게 밧줄을 당겨 시체가",
"계단참 위에 드러눕듯 걸치게 해서",
"그 위를 걸어간 거죠」"
],
"10577": [
"「아, 그렇구나...",
"그래서 시체를 전망실 쪽으로",
"끌어들인 거구나」"
],
"10578": [
"「돌아올 땐 정말 뛰어넘기만",
"한 거였고」"
],
"10579": [
"「그런 겁니다.",
"뭐, 고양이는 제멋대로",
"뛰어넘을 수 있으니까요」"
],
"10580": [
"「실제로 가능할까, 그거」"
],
"10581": [
"「불가능하진 않을지 몰라도",
"꽤 어렵지 않을까요」"
],
"10582": [
"「추리 소설 트릭이란 게",
"그런 게 꽤 많습니다」"
],
"10583": [
"「흐응, 그렇구나...」"
],
"10584": [
"「음, 뭐였더라,",
"쿠로조노란 사람이 나오는 얘기」"
],
"10585": [
"「쿠로조노라면 『회색 가면』일까요」"
],
"10586": [
"「아, 그거다.",
"그 가면은 범인이 쓰는 거야?」"
],
"10587": [
"「그렇습니다.",
"아 근데, 그 후에 시체 옆에도",
"떨어져 있었던가」"
],
"10588": [
"「...그러고 보니 이 저택에도",
"뭔가 이상한 가면이 장식돼 있었죠」"
],
"10589": [
"「어!?",
"과, 관계있을 것 같아!?」"
],
"10590": [
"「글쎄요.",
"일단 같은 이름인 사람은",
"저밖에 안 나옵니다만」"
],
"10591": [
"「히오리는 어디에나 나오니까",
"모르겠네...」"
],
"10592": [
"「음...",
"코오리 미즈에가 누구였지」"
],
"10593": [
"「『코오리가의 악몽』 범인이잖습니까」"
],
"10594": [
"「아, 범인이었구나」"
],
"10595": [
"「이런, 안 읽으셨군요.",
"죄송합니다」"
],
"10596": [
"「괜찮아, 다 읽을 틈도 없고.",
"『코오리가의 악몽』에 여기 있는",
"사람이랑 같은 이름 나왔던가」"
],
"10597": [
"「아뇨, 그건 안 나옵니다.",
"저 말고는」"
],
"10598": [
"「그럼 관계없으려나...」"
],
"10599": [
"「저기, 『도깨비의 밀실』 얘기에",
"사에키란 사람, 이름은 없어?」"
],
"10600": [
"「사에키 노인은...",
"뭐였더라」"
],
"10601": [
"「분명 시체가 발견된 뒤에 이름이",
"나왔는데, 료스케 일행이",
"사에키 노인이라고만 불러서요」"
],
"10602": [
"「흐음, 그렇구나」"
],
"10603": [
"「『사신의 낫』 얘기의 화가 말이야,",
"아키오였던가, 그 사람...」"
],
"10604": [
"「아키오...아, 네네」"
],
"10605": [
"「그 사람 정말 죽었던 거야?」"
],
"10606": [
"「죽은 척하고 사실은",
"범인인가 싶었는데,",
"역시 죽어 있었습니다」"
],
"10607": [
"「보, 복잡하네...」"
],
"10608": [
"「『이름 없는 악마』 얘기의,",
"타키시게란 사람 말인데」"
],
"10609": [
"「이름 없는...음, 무슨 얘기",
"였더라, 그거」"
],
"10610": [
"「누가 감시하는 것 같은",
"기분이 든다는 의뢰로...」"
],
"10611": [
"「아, 히오리 료가 또 백수가",
"돼서 풀 죽어 있는 데서",
"시작하는 거군요」"
],
"10612": [
"「왜 그런 건 기억하는 거야」"
],
"10613": [
"「다카토 팬들 사이에선 참 료스케다운",
"장면으로 유명해서요」"
],
"10614": [
"대체 어떤 명탐정인 거야..."
],
"10615": [
"「오코노기란 골동품상이 나오는 거",
"무슨 얘기였지」"
],
"10616": [
"「오코노기라면, 음...",
"아, 항아리 얘기군요」"
],
"10617": [
"「『항아리 속의 수수께끼』일 겁니다.",
"병적으로 항아리를 좋아하는 범인이",
"나오는 기묘한 얘기였던 것 같은데」"
],
"10618": [
"「으...아, 알았어」"
],
"10619": [
"왠지 무서울 것 같으니,",
"내가 읽으면 잠 못 자겠다..."
],
"10620": [
"「『호숫가의 관』에 나오는 나스 씨는",
"얘기 속에서 죽어?」"
],
"10621": [
"「네, 꽤 초반에.",
"그 얘기의 사건은",
"전부 독살인데...」"
],
"10622": [
"「나스 마코토는 관계자도 아닌데",
"독살에 휘말려서 무차별 살인",
"일지도 모른다는 얘기가 되죠」"
],
"10623": [
"「실은 아닌 거구나?」"
],
"10624": [
"「나중에 가서 나스도",
"사실 다른 피해자와 관계있는",
"놈이었다는 게 밝혀집니다」"
],
"10625": [
"「흐음, 그렇구나...」"
],
"10626": [
"「『잊지 못할 섬』에 나오는",
"토모에란 사람,",
"성은 안 나와?」"
],
"10627": [
"「아뇨, 나옵니다.",
"쿠루시마 토모에가 본명이에요」"
],
"10628": [
"「쿠루시마라...」"
],
"10629": [
"그렇다면 이번에 모인 사람 중엔",
"없겠네..."
],
"10630": [
"「미사사기 씨가 나오는 얘기 말이야,",
"『우리 속의 여자』라는...」"
],
"10631": [
"「아, 흰 양산의 미녀」"
],
"10632": [
"「응, 그거.",
"왜 지하 감옥 같은 데서",
"살해됐던 거야?」"
],
"10633": [
"「그건 말이죠,",
"지하 감옥에 가둔 사람이랑",
"실제로 죽인 사람이 달라요」"
],
"10634": [
"「달라?」"
],
"10635": [
"「가둔 건 미사사기가의 당주로",
"가오리의 아버지입니다」"
],
"10636": [
"「그건 그냥 거기서 반성하라고",
"벌을 준 것뿐이었는데요」"
],
"10637": [
"「그 사이에 죽여 버린",
"사람이 있구나」"
],
"10638": [
"「네, 그렇습니다.",
"범인은 가오리를 편애하던",
"남동생이지만요」"
],
"10639": [
"「누나가 집을 나가려 한다고",
"오해해서, 그렇게는 못 한다며",
"죽여 버리는 겁니다」"
],
"10640": [
"「제목의 『우리 속』이란 건",
"이중의 의미가 있거든요」"
],
"10641": [
"「하나는 말 그대로",
"살해 현장인 지하 감옥인데」"
],
"10642": [
"「다른 하나는?」"
],
"10643": [
"「피해자 미사사기 가오리의 처지입니다.",
"미사사기가라는 명문가에 묶여 무엇 하나",
"자유롭지 못한 신세였거든요」"
],
"10644": [
"「그걸 본인이,",
"우리 속에 있는 것 같은 인생이라고",
"말했었죠」"
],
"10645": [
"「그럼 가오리 씨란 사람은",
"결국 우리에서 못 나온 채",
"죽어 버리는구나...」"
],
"10646": [
"「그렇습니다.",
"비극이죠」"
],
"10647": [
"「음, 쿠라이시 씨랑",
"같은 이름인 사람 나오는 얘기 말이야」"
],
"10648": [
"「『꺼림칙한 꽃』일까요?」"
],
"10649": [
"「응, 그거.",
"꽃은 장미 꽃다발이었지?」"
],
"10650": [
"「그랬죠.",
"그거 사실 피해자가 직접 들고",
"들어간 건데요」"
],
"10651": [
"「어라? 그래?」"
],
"10652": [
"「네, 근데 평소 꽃 같은 걸 살 사람이",
"아니라서 누가 또 있었던 거",
"아니냐는 얘기가 되죠」"
],
"10653": [
"「흐음?",
"아, 그럼 밀실이란 건?」"
],
"10654": [
"「그건 사실 자살입니다.",
"자살인 걸 숨기고 싶었던 제삼자가",
"열쇠만 잠갔던 거죠」"
],
"10655": [
"「흐음, 그런 얘기구나」"
],
"10656": [
"「저기, 키누타 유리란 사람이",
"『오이란은 왜 살해되나』 얘기에서",
"살해되는 여배우야?」"
],
"10657": [
"「네, 그렇습니다.",
"촬영소 세트에서 오이란 차림으로」"
],
"10658": [
"「그 여배우는",
"본명 같은 건 안 나와?」"
]
}