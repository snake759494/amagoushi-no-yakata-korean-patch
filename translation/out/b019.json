],
"10348": [
"「제가 들은 범위에선",
"이 정도였습니다만」"
],
"10349": [
"「...저기,",
"츠바키 군이 살해된 건",
"지하실이지? 아마」"
],
"10350": [
"「방에서 거기까지 옮기는 건",
"고생일 겁니다」"
],
"10351": [
"「계단을 끌고 내려가기만 해도",
"꽤 소리가 날 것 같고요」"
],
"10352": [
"「그렇지.",
"그럼 츠바키 군은 지하실까진",
"자기 발로 갔다는 거네」"
],
"10353": [
"「그렇겠죠.",
"방을 나섰다는 건 범인한테",
"불려 나간 걸까요」"
],
"10354": [
"「뭐, 핑계만 떠올리면",
"여기 있는 건 전부 배우니까요」"
],
"10355": [
"「지하실로 불러낼 핑계라면",
"뭐가 있을까?",
"보일러가 어쨌다든가?」"
],
"10356": [
"「보일러면 궤짝이 있는",
"창고 쪽으로 유도하는 게 오히려",
"번거로워질 것 같은데요」"
],
"10357": [
"「처음부터 창고로 부를 수 있는",
"얘기가 낫지 않겠습니까」"
],
"10358": [
"「그렇구나,",
"그럼 문이 안 열린다든가?」"
],
"10359": [
"「아, 그렇네요.",
"그쪽이 빠르겠군요」"
],
"10360": [
"「그다음은, 왜 그렇게",
"아침 일찍 지하로 내려갔는지",
"변명만 된다면」"
],
"10361": [
"「지하 창고에 있는 거라면",
"궤짝이나 페인트나 항아리 정도」"
],
"10362": [
"「새벽 4시 넘어서부터",
"볼일 있을 물건은 아니네요」"
],
"10363": [
"「음, 그리고...",
"와인이 있지 않았어?」"
],
"10364": [
"「...술이라.",
"그거면 잠이 안 와서라고 하면",
"어떻게든 둘러댈 수 있으려나」"
],
"10365": [
"「여기 있는 사람들이라면",
"그 정도 이유로",
"츠바키 군을 속일 수 있을까?」"
],
"10366": [
"「츠바키 군도 배우니까,",
"연기일지도 모른다고",
"생각할 수도 있지만...」"
],
"10367": [
"「베테랑인 쿠라이시 씨 미사사기 씨,",
"그리고 연기 실력으로 치면",
"시즈나 씨 정도는 충분히 가능하죠」"
],
"10368": [
"「그분들한텐 못 미치지만",
