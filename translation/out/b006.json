 ],
 "3758": [
  "「어? 아, 응, 그렇네」"
 ],
 "3759": [
  "「아, 고마워」"
 ],
 "3760": [
  "그 말만 하고 시즈나는",
  "고양이처럼 스르륵 사라졌다."
 ],
 "3761": [
  "「...신기한 분이군요」"
 ],
 "3762": [
  "「뭔가 독특한 애지」"
 ],
 "3763": [
  "「나고 씨~?",
  "아아, 여기 계셨군요」"
 ],
 "3764": [
  "「히오리.",
  "마침 잘 왔어, 라디오가",
