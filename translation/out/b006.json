 ],
 "3701": [
  "「그런가?」"
 ],
 "3702": [
  "「...아~, 나고무는 그렇겠지」"
 ],
 "3703": [
  "납득당해 버렸다.",
  "이걸로 괜찮은 걸까..."
 ],
 "3704": [
  "「아아, 다행이다.",
  "그렇죠?」"
 ],
 "3705": [
  "「저만 그런 게 아니라서",
  "안심했어요」"
 ],
 "3706": [
  "...뭐, 됐다고 치자."
 ],
 "3707": [
  "「맞아 맞아.",
  "나도 옛날에 랑게르한스섬이",
  "진짜 어딘가 있는 줄 알았어」"
 ],
 "3708": [
  "「아니, 있긴 있습니다.",
