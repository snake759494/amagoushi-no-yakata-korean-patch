 ],
 "3635": [
  "「...배고파지네」"
 ],
 "3636": [
  "「그러네요.",
  "1층에 내려가 볼까요?」"
 ],
 "3637": [
  "「그러자」"
 ],
 "3638": [
  "「아, 나고무 군 먼저 가.",
  "난 빨래 챙겨서 욕실 들렀다",
  "갈 테니까」"
 ],
 "3639": [
  "「네, 그럼 먼저 갈게요」"
 ],
 "3640": [
  "일단 오락실에 가 보자.",
  "누가 라디오 들으러 왔을지도."
 ],
 "3641": [
  "「...이제 됐을까.",
  "밥 먹기 전에 한 세트 더",
  "몸을 움직여 두고 싶거든」"
 ],
 "3642": [
  "「아, 네.",
  "그럼 실례했습니다」"
 ],
 "3643": [
  "「응, 또 봐」"
 ],
 "3644": [
  "그러고 보니 벌써 식사 때네.",
  "다른 사람들도 내려오려나."
 ],
 "3645": [
  "(일단 오락실에 가서",
  "누가 있나 봐야지...)"
 ],
 "3646": [
  "「비가 꽤 세차게 오기",
