 ],
 "3712": [
  "「싫은 범인이네요」"
 ],
 "3713": [
  "「대체 무슨 사건이야!?」"
 ],
 "3714": [
  "이젠 뭐가 뭔지...",
  "그대로 이야기가 샛길로 새서",
  "결국 무슨 얘길 했는지 잊었다."
 ],
 "3715": [
  "「...도와줘~」"
 ],
 "3716": [
  "떠들고 있자 시즈나가",
  "부르러 와서, 다 같이 부엌에",
  "도우러 간다."
 ],
 "3717": [
  "쌍둥이가 만든 건",
