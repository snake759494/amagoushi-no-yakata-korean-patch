 ],
 "3770": [
  "「그렇습니까.",
  "그럼 호의에 기대 볼까요」"
 ],
 "3771": [
  "「응... 아, 맞다.",
  "나중에 물어보려던 게",
  "있었는데, 잊고 있었어」"
 ],
 "3772": [
  "「뭡니까?」"
 ],
 "3773": [
  "「뒤쪽에 있는 우물 말야,",
  "지금 안 쓰는 거였지?」"
 ],
 "3774": [
  "「우물 말입니까?",
