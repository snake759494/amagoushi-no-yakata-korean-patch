 ],
 "3647": [
  "「...정말이네.",
  "또 심해지려나」"
 ],
 "3648": [
  "「라디오 들으러 가 볼까요」"
 ],
 "3649": [
  "「그러자」"
 ],
 "3650": [
  "서재를 나와 오락실로 간다..."
 ],
 "3651": [
  "오락실에 오니 츠바키 군이",
  "잡음투성이 라디오와",
  "씨름하고 있었다."
 ],
 "3652": [
  "「왜 그래?",
  "안 들리게 됐어?」"
 ],
 "3653": [
  "「상태가 나쁜 모양이라...",
  "아 진짜, 젠장!」"
 ],
 "3654": [
  "짜증이 났는지",
  "본래 말투로 소리치며",
  "라디오를 쾅 내리친다."
 ],
 "3655": [
  "「쓸모없네, 정말...」"
 ],
 "3656": [
  "「그래도 일기 예보는",
  "아닌 것 같으니까 괜찮잖아」"
 ],
 "3657": [
  "들려오는 건 떠들썩한",
