 ],
 "3674": [
  "「...태평하구만, 당신은」"
 ],
 "3675": [
  "「나고 씨~,",
  "저녁은 어떻게 하실래요?」"
 ],
 "3676": [
  "「어?",
  "아, 히오리... 아까 시즈나가",
  "만들어 준다고 부엌에 갔어」"
 ],
 "3677": [
  "「어라, 그렇습니까?」"
 ],
 "3678": [
  "「언니 벌써 부엌이야?",
  "나도 도와주고 올게」"
 ],
 "3679": [
  "「아, 그럼 저도...」"
 ],
 "3680": [
  "「괜찮아요, 둘이면.",
