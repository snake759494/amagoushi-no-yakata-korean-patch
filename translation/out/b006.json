 ],
 "3765": [
  "「아아, 정말이네요.",
  "제대로 들리지도 않네...」"
 ],
 "3766": [
  "「지금 바람도 좀 있으니",
  "잠시 기다려 볼까요」"
 ],
 "3767": [
  "「그 수밖에 없나...」"
