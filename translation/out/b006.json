 ],
 "3733": [
  "「...안 되겠나 봐요...」"
 ],
 "3734": [
  "「큰 비구름이 눌러앉아 버린",
  "모양입니다, 운도 없군요」"
 ],
 "3735": [
  "「하아아...",
  "아직 안 그치는구나...」"
 ],
 "3736": [
  "「걸어서 내려가기도 힘들겠네」"
 ],
 "3737": [
  "「그러니까 그런 게 되는 건",
