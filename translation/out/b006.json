 ],
 "3693": [
  "「...그랬던 거예요?」"
 ],
 "3694": [
  "「저는 계속...",
  "실제로 없는 말인 줄 알았어요」"
 ],
 "3695": [
  "「뭡니까, 그게」"
 ],
 "3696": [
  "「어, 그게, 영화에 나오는",
