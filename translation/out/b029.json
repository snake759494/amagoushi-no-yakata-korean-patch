"15280": [
"「네엣!?",
"아, 아뇨... 그게」"
],
"15281": [
"놀랄 일은 아니지.",
"나스 씨도 책 정도는 읽겠지."
],
"15282": [
"...트레이닝하는 틈틈이."
],
"15283": [
"「아... 그럼",
"나스라는 이름의 사람이",
"나오는 책도...?」"
],
"15284": [
"「응, 읽었어.",
"『호반의 저택』이었나」"
],
"15285": [
"「...그런데 다카토 씨 책을",
"읽을 때마다 늘 엄청",
"신경 쓰이는 게 있어」"
],
"15286": [
"「료스케 말이야,",
"운동신경 좋아 보이는데",
"별로 안 단련하나 봐」"
],
"15287": [
"「아깝단 말이지」"
],
"15288": [
"책을 읽어도 그거구나."
],
"15289": [
"「저, 마다라이 씨가 돌아가신",
"밤 일로 좀...」"
],
"15290": [
"「마다라이 씨?」"
],
"15291": [
"「계단 홀에 있던",
"테루테루보즈 들고 1층으로",
"내려가셨죠?」"
],
"15292": [
"「그때 홀 근처에서",
"쿠라이시 씨 못 만나셨어요?」"
],
"15293": [
"「쿠라이시 씨...",
"글쎄, 기억에 없는데.",
"근처에 있었어?」"
],
"15294": [
"「딱 비슷한 시간에",
"거실에서 방으로 돌아가려던",
"참이었을 거예요」"
],
"15295": [
"「그렇구나.",
"난 1층에 내려가서 그대로",
"현관으로 밖에 나갔으니까」"
],
"15296": [
"「네? 밖이요?」"
],
"15297": [
"「창가에 매달기 좋은 데를",
"찾으려고」"
],
"15298": [
"「그래서 거실 쪽으로 가 보니",
"테라스가 딱 좋겠다 싶어서",
"거기 매달고 돌아왔지」"
],
"15299": [
"「그때 밖에서",
"식당 앞을 지나거나...」"
],
"15300": [
"「응, 바로 거실 쪽으로 가서",
"그대로 돌아왔으니까,",
"식당 앞은 안 지났어」"
],
"15301": [
"「아, 그래도 홀로 돌아왔을 때",
"식당 쪽에서 웃음소리가 들렸어」"
],
"15302": [
"「웃음소리요?」"
],
"15303": [
"「하~핫하하, 하는",
"호탕한 웃음 같은 게」"
],
"15304": [
"「그, 그건 마다라이 씨",
"아닌가요...」"
],
"15305": [
"「...하긴 그렇게 웃는",
"사람은 달리 없지.",
"남자 목소리였고」"
],
"15306": [
"「웃음소리를 들은 건",
"방으로 돌아갈 때군요.",
"그럼 11시 반 조금 뒤?」"
],
"15307": [
"「그렇지.",
"10분쯤 뒤였나」"
],
"15308": [
"그렇다면 11시 40분 이후에도",
"마다라이 씨는 살아 있었나."
],
"15309": [
"점점 언제 살해됐는지",
"알 수 없게 됐네..."
],
"15310": [
"「저, 츠바키 군 일로",
"좀...」"
],
"15311": [
"「...츠바키 군...",
"만이 아니란 말이지」"
],
"15312": [
"「그렇잖아, 먼저 마다라이",
"씨도 살해당했잖아?」"
],
"15313": [
"「마다라이 씨와 츠바키 군을 연달아",
"죽일 이유가 대체 뭘까?」"
],
"15314": [
"「그리고...",
"이건 너무 신경 쓰는 건지",
"상관없을지도 모르지만」"
],
"15315": [
"「왜 마다라이 씨가 먼저",
"였을까?」"
],
"15316": [
"「아무 이유도 없는 걸까?",
"제일 먼저 살해당한 게",
"마다라이 씨였던 거」"
],
"15317": [
"「그, 그렇네요...",
"어쩌면 이유가 있을지도」"
],
"15318": [
"있다면 그 이유는",
"뭘까...?"
],
"15319": [
"「쿠라이시 씨",
"일인데요...」"
],
"15320": [
"「...쿠라이시 씨...",
"언제 돌아가셨는지",
"모른단 말이지」"
],
"15321": [
"「네... 네...」"
],
"15322": [
"「계속 방에 틀어박혀 있어서",
"언제부터 돌아가셨던 건지",
"지금으로선...」"
],
"15323": [
"「...그런데 말이야」"
],
"15324": [
"「쿠라이시 씨가 방에 틀어박혀",
"안 나올 거란 걸, 범인이",
"처음부터 알았을 리 없잖아」"
],
"15325": [
"「확신은 못 하죠.",
"그런 행동을 할 사람이 있을지",
"모른다고 예상은 해도」"
],
"15326": [
"「응, 나도 그렇게 생각해.",
"하지만 그렇다면...」"
],
"15327": [
"「쿠라이시 씨가 언제 죽었는지",
"모른다는 건,",
"절반은 우연에 가깝지」"
],
"15328": [
"「...그렇게 되네요.",
"범인이 방을 밀실로 만든",
"탓도 있지만...」"
],
"15329": [
"「그 밀실은 처음부터",
"그럴 예정이었을까」"
],
"15330": [
"「처음부터...?」"
],
"15331": [
"「만약 쿠라이시 씨가 방에",
"틀어박히지 않았더라도",
"범인은 밀실로 만들었을까」"
],
"15332": [
"쿠라이시 씨가 우리처럼",
"방에 박혀 있지 않고 식사 때",
"얼굴을 내밀었다면..."
],
"15333": [
"갑자기 안 나오게 된 시점에",
"무슨 일이 생긴 걸 금방 알았을",
"테니 이렇게 되진 않았겠지."
],
"15334": [
"「...그 경우엔 밀실로 만들",
"의미가 별로 없을 것 같은...」"
],
"15335": [
"「그렇지.",
"범인은 언제 방을 밀실로",
"만들기로 한 걸까?」"
],
"15336": [
"쿠라이시 씨는 언제 죽었나."
],
"15337": [
"범인은 언제 밀실을",
"만들기로 했나."
],
"15338": [
"（...둘 다 모르면",
"그 밀실의 수수께끼는 전부",
"풀 수 없을지도 몰라...）"
],
"15339": [
"「저기...",
"스즈나 짱 일로...」"
],
"15340": [
"「...스즈나 짱인가」"
],
"15341": [
"「자고 있었겠지,",
"스즈나 짱은...」"
],
"15342": [
"「그랬을 거예요.",
"깨어 있었다면 그런 도끼를",
"보고 도망쳤을 테니」"
],
"15343": [
"「그렇겠지.",
"날렵해 보였으니까",
"깨어 있었다면...」"
],
"15344": [
"「...잠든 채로",
"그렇게 됐겠지...」"
],
"15345": [
"「...시즈나 짱",
"말인데요...」"
],
"15346": [
"「시즈나 짱...」"
],
"15347": [
"「...자는 동안",
"습격당한 걸까」"
],
"15348": [
"「네, 아마...」"
],
"15349": [
"「하지만 깨어 있었어도",
"그 가는 팔로는...」"
],
"15350": [
"「아, 그래도 비명 같은 건",
"안 들렸다고 했던가」"
],
"15351": [
"「아무도 못 들은 것 같아요.",
"그런데 그때 마침 큰 시계가",
"울리고 있어서...」"
],
"15352": [
"「그렇구나, 시계가...",
"그럼 그것도 범인 짓인가.",
"소리를 감추려고」"
],
"15353": [
"「그럴지도 몰라요」"
],
"15354": [
"「도끼니까....",
"크기로 봐선 내리치면",
"꽤 큰 소리가 났겠지」"
],
"15355": [
"「나구모 씨랑... 저, 우물",
"속 사람은 같은 사람일까요?」"
],
"15356": [
"「...그럴지도 모르지.",
"달리 올 사람도 없고...」"
],
"15357": [
"「아, 그래도 나고무 군이",
"정원에서 본 사람일 수도 있나」"
],
"15358": [
"「옷차림은 같았지만,",
"그 사람이 나구모 씨고 우물에",
"떨어진 걸지도...」"
],
"15359": [
"「아, 그렇구나.",
"같은 사람일 수도 있겠네」"
],
"15360": [
"「그런데 왜 저택에",
"안 들어왔을까.",
"들어오기 전에 살해됐나?」"
],
"15361": [
"「아...",
"그렇네요」"
],
"15362": [
"「그 사람이 나구모 씨라면",
"도착하자마자 저택에",
"들어오면 됐을 텐데...」"
],
"15363": [
"「각본에도 제대로 등장도",
"대사도 있었고 말이야」"
],
"15364": [
"「히오리 군이 늦게 오는 건",
"그나마 이해가 가는데.",
"등장 부분까지 각본이 없으니」"
],
"15365": [
"「나스 씨, 시쿠라 긴지 씨라는",
"분이랑 친하세요?」"
],
"15366": [
"「친하다고까진 못 하겠네.",
"몇 번 일로 같이 한 적은",
"있지만」"
],
"15367": [
"「별로 얘기해 본 적도",
"없었고」"
],
"15368": [
"그걸로 친했으면 기적이지...",
"나스 씨라면 그럴 법해 무섭지만."
],
"15369": [
"「저, 이케우치 리나 씨라고",
"아세요?」"
],
"15370": [
"「이케우치...?」"
],
"15371": [
"「음, 누구더라.",
"난 사람 이름을 잘 못 외워서」"
],
"15372": [
"「젊은 아이돌인데,",
"얼마 전에 죽었대요...」"
],
"15373": [
"「어, 죽었어?",
"젊은데?",
"그거 안됐네...」"
],
"15374": [
"「...그래도 좀",
"난 기억이 안 나네.",
"왜 죽었대?」"
],
"15375": [
"「...자살이래요」"
],
"15376": [
"「뭐!?",
"어째서 또...」"
],
"15377": [
"「뭔가 오디션에",
"떨어진 게 원인인가 봐요」"
],
"15378": [
"「...그렇구나.",
"젊으면 또 기회도",
"있었을 텐데...」"
],
"15379": [
"「그 오디션에도 모자 장수가",
"관여했다던데",
"모르세요?」"
],
"15380": [
"「.....뭐?」"
],
"15381": [
"「최종 합격자는 모자 장수의",
"의견대로 정해졌다던가...」"
],
"15382": [
"「...아니, 전혀...」"
],
"15383": [
"「그렇군요.",
"그럼 이번에 나스 씨네가 모인",
"이 일과는 전혀 상관없겠네요」"
],
"15384": [
"「...응, 없을 거야」"
],
"15385": [
"「사토에 미도리라는 분",
"모르세요?」"
],
"15386": [
"「사토에... 미도리?",
"음, 어디서 들어 본",
"것 같기도...」"
],
"15387": [
"「누구더라, 꽤",
"옛날 사람 아니야? 가수?」"
],
"15388": [
"「맞아요, 꽤 옛날",
"아이돌이래요」"
],
"15389": [
"「아~, 뭔가 어렴풋이",
"기억나는 것 같아」"
],
"15390": [
"「응, 있었어 있었어.",
"...얼굴은 잊었지만」"
],
"15391": [
"그래도 나스 씨가 기억할 정도면",
"꽤 유명한 사람이었나."
],
"15392": [
"「미사사기 씨가 옛날에",
"아이돌이었대요」"
],
"15393": [
"「응? 미사사기 씨가?",
"그랬어?」"
],
"15394": [
"「우와, 그렇구나...",
"미사사기 씨 미인이니까」"
],
"15395": [
"「...아, 혹시",
"아직 예명 쓰던 시절",
"얘긴가?」"
],
"15396": [
"「옛날엔 무슨 미도리라는",
"예명이었지.",
"지금은 본명인... 뭐더라」"
],
"15397": [
"「나스 씨!?」"
],
"15398": [
"「계속 미사사기 씨라고",
"불러 와서 말이야,",
"이거 곤란하네」"
],
"15399": [
"하하, 하고 별로 곤란하지 않은",
"듯 웃으며 머리를 긁는다.",
"이 사람은 정말..."
],
"15400": [
"「나스 씨, 르로이 백작이라고",
"들어 보셨어요?」"
],
"15401": [
"「페리지오 르로이 백작?",
"응, 아는데」"
],
"15402": [
"「...이름이 바로 나오는 걸 보면",
"꽤 유명한가요...」"
],
"15403": [
"「음, 그렇지도 않은가」"
],
"15404": [
"「꼬챙이 공작이나 질 드 레나",
"엘리자베트 바토리 쪽이",
"더 유명하지 않을까?」"
],
"15405": [
"「저, 그러니까 그건",
"그 사람들이랑 같은 부류,",
"즉 무서운 사람이군요?」"
],
"15406": [
"「그게 잘 모르겠어. 잔혹한",
"흑마술사였다거나, 그건 아내와",
"애인이고 백작은 선인이었다거나」"
],
"15407": [
"「여러 설이 있어서,",
"어느 게 진짜인지",
"확실하지 않아」"
],
"15408": [
"「...그럼 백작 본인은",
"좋은 사람이라도 결국 부인인가",
"무서운 사람이 있었다는...」"
],
"15409": [
"「아니, 그것도 몰라.",
"사실 영지에 역병이 크게 돈 게",
"이상하게 전해졌단 설도 있고」"
],
"15410": [
"「...즉 어떻게 되든",
"평화로운 얘긴 아니네요...」"
],
"15411": [
"「아, 그건 그렇지.",
"어떤 이야기에 인용돼도",
"대개 저주나 악연이 붙으니」"
],
"15412": [
"「저, 기타하야미 료스케라고",
"있잖아요.",
"다카토 씨의...」"
],
"15413": [
"「아, 명탐정?",
"특이한 사람이지, 그 사람」"
],
"15414": [
"「수영이랑 사격이 특기고,",
"운동신경도 좋아 보이는데",
"평소에 거의 안 움직이다니」"
],
"15415": [
"그런 의미인가..."
],
"15416": [
"「다카토 씨 책에 나오는",
"히오리 기억하세요?」"
],
"15417": [
"「히오리 료?",
"응, 기억해.",
"왓슨이지」"
],
"15418": [
"「네, 맞아요.",
"여기 히오리랑은 별로",
"안 닮은 것 같네요」"
],
"15419": [
"「안 닮았지.",
"여기 히오리 군이",
"근육이 훨씬 있어 보이고」"
],
"15420": [
"「저쪽 히오리 군은",
"운동 못할 것 같으니까」"
],
"15421": [
"거기구나.",
"닮고 안 닮고의 기준이..."
],
"15422": [
"「진노 경감 기억하세요?」"
],
"15423": [
"「료스케 시리즈에 나오는 사람?",
"응, 기억해」"
],
"15424": [
"「경찰은 체력이 필요하겠지.",
"진노 경감도 역시 강할까」"
],
"15425": [
"「어, 어음...",
"아마 유도 같은 거...」"
],
"15426": [
"「유도라, 이길 수 있을까」"
],
"15427": [
"왜 싸우는 걸 먼저",
"상정하는 거야, 이 사람은..."
],
"15428": [
"「하즈미 슌지라는 사람 기억해요?」"
],
"15429": [
"「하즈미... 음,",
"살해당하는 사람이었나?」"
],
"15430": [
"「어디 나왔더라,",
"잘 기억 안 나네」"
],
"15431": [
"「『고양이와 첫눈』이라는",
"이야기였던 것 같아요」"
],
"15432": [
"「...아, 생각났다.",
"그러고 보니 그것도 검은 고양이였지」"
],
"15433": [
"의외로 기억하네, 나스 씨.",
"소설 속 사람을 더 잘 기억하는 건",
"왜일까..."
],
"15434": [
"「『검은 고양이의 독』에 나오는",
"마다라이 시게오 씨는...」"
],
"15435": [
"「응? 다카토 노부지로 쪽?」"
],
"15436": [
"「네, 그쪽 마다라이 씨요」"
],
"15437": [
"「아~, 뭔가 불규칙하고 건강 나쁜",
"얼굴이라고 쓰여 있었지」"
],
"15438": [
"...묘하게 닮지 않은 것도 아니네."
],
"15439": [
"「구로조노 다쓰야라는 사람 아세요?」"
],
"15440": [
"「음... 누구더라?",
"어디서 들은 것 같은데...」"
],
"15441": [
"「『회색 가면』이라는",
"이야기에 나오는데요」"
],
"15442": [
"「아~, 다카토 노부지로구나!」"
],
"15443": [
"「그거 읽었던 것 같은데,",
"구로조노란 사람은 인상이 없네」"
],
"15444": [
"「고오리 미즈에라는",
"등장인물이 있는데요...」"
],
"15445": [
"「아, 『고오리가의 악몽』의?」"
],
"15446": [
"「읽으셨어요?」"
],
"15447": [
"「응, 여자치곤 꽤",
"체력 있어 보이는 사람이었어」"
],
"15448": [
"뭔가 편향되게 기억되는",
"것 같은 기분이 든다..."
],
"15449": [
"「『도깨비의 밀실』에 나오는",
"사에키라는 할아버지 말인데요」"
],
"15450": [
"「...아~, 있었지.",
"뭔가 능구렁이 영감이었지」"
],
"15451": [
"「나이에 비해 정정했는데",
"꽤 허무하게",
"죽어 버렸지」"
],
"15452": [
"나스 씨가 정정하다고 할 정도면",
"꽤 튼튼한 사람이었나 보다..."
],
"15453": [
"「『사신의 낫』에 나오는",
"아키오라는 사람은...」"
],
"15454": [
"「그 이야기 분명 한 번",
"드라마로 만들어졌지」"
],
"15455": [
"「아, 그래요?」"
],
"15456": [
"「응, 완성도는 별로",
"였지만」"
],
"15457": [
"「료스케가 좀 너무 말라서,",
"더 근육 있을 것 같은데」"
],
"15458": [
"그러니까 왜 근육..."
],
"15459": [
"「다키 주자부로라는 사람이",
"나오는, 어...」"
],
"15460": [
"「『이름 없는 악마』?」"
],
"15461": [
"「네, 그거요.",
"...나스 씨",
"잘 기억하시네요」"
],
"15462": [
"「그 이야기 재밌어.",
"사건 자체가 아니라",
"료스케네 주변 사정이지만」"
],
"15463": [
"...대체 무슨 이야기야."
],
"15464": [
"「저, 오코노기라는 사람...",
"『항아리 속 수수께끼』에 나와요」"
],
"15465": [
"「오코노기... 오코노기 씨...",
"음, 아, 골동품상이었나」"
],
"15466": [
"「아, 아마 맞아요」"
],
"15467": [
"「그거 좀 으스스한 얘기지」"
],
"15468": [
"「그, 그래요!?」"
],
"15469": [
"「하하, 나고무 군은",
"안 읽는 게 좋을지도」"
],
"15470": [
"「...그럴게요」"
],
"15471": [
"「『호반의 저택』에 나오는 나스 씨는",
"나스 마코토 씨라고 하네요」"
],
"15472": [
"「마코토였나?」"
],
"15473": [
"「네, 아마 그럴 거예요」"
],
"15474": [
"「...아, 그렇구나.",
"내 이름이랑 좀 섞였었네」"
],
"15475": [
"「본인 이름이요?」"
],
"15476": [
"「내 본명.",
"고타니 마모루라고 해」"
],
"15477": [
"「아, 그러세요」"
],
"15478": [
"「뭐, 원작의 나스 마코토는",
"나랑은 전혀 다른 타입이지만」"
],
"15479": [
"「어, 어음, 그러니까",
"별로 안 단련한 사람이란 건가요」"
],
"15480": [
"「맞아, 스포츠는 싫어한다고",
"쓰여 있었지」"
],
"15481": [
"「그리고 편식도 심할 것 같고,",
"몸도 말랐다고」"
],
"15482": [
"「꽤 다르네요」"
],
"15483": [
"「응, 그래도 이번 역할하고는",
"이름 말곤 상관없어 보였어」"
],
"15484": [
"그대로인 역이었다면 나스 씨에겐",
"애초에 안 돌아왔겠지..."
],
"15485": [
"「저, 도모에라는 애가 나오는",
"『잊지 못할 섬』이란 얘기인데요」"
],
"15486": [
"「아, 그건 아름다운 이야기지.",
"몇 번 영상화됐는데, 도모에 역은",
"다들 예쁜 사람이었어」"
],
"15487": [
"「난 영화 2편이 좋아.",
"같은 감독이 료스케 시리즈를",
"몇 편 찍었는데...」"
],
"15488": [
"「『잊지 못할 섬』과 『종루관 살인』이",
"제일 재밌었나.",
"둘 다 DVD 나와 있을 거야」"
],
"15489": [
"「DVD가 있어요?",
"찾아볼까」"
],
"15490": [
"「옛날 작품이라 좀",
"찾기 어려울지도 모르지만",
"재밌어」"
],
"15491": [
"「네, 찾아볼게요」"
],
"15492": [
"「저, 다카토 노부지로 책에",
"나오는 쪽 미사사기 씨 말인데요」"
],
"15493": [
"「음...",
"『우리 속의 여자』의 그 사람?」"
],
"15494": [
"「네, 그 사람이요」"
],
"15495": [
"「그 미사사기 씨는... 응,",
"여기 미사사기 씨랑 그렇게",
"다르지 않네」"
],
"15496": [
"「닮았어요?」"
],
"15497": [
"「응, 분위기 같은 게 왠지.",
"미사사기 씨가 그대로 그 역을",
"해도 위화감 없을 것 같아」"
],
"15498": [
"「쿠라이시 씨가 나오는",
"『꺼림칙한 꽃』이라는",
"이야기인데요...」"
],
"15499": [
"「아, 마지막 사건?」"
],
"15500": [
"「마지막이에요?」"
],
"15501": [
"「이야기 자체는 다른 거랑 같고",
"최종화 분위기도 아니지만,",
"제일 마지막에 쓰인 이야기야」"
],
"15502": [
"「그런데 그거, 사건 자체는",
"전쟁 전부터 시작됐었지」"
],
"15503": [
"「음... 아, 그러고 보니",
"20년 전 사건이 발단이라던가」"
],
"15504": [
"「응, 맞아.",
"20년 전 수수께끼와 현재 사건을",
"한꺼번에 해결하는 이야기」"
],
"15505": [
"그래서 뭔가 두꺼웠구나.",
"긴 이야기 같더라니."
],
"15506": [
"「다카토 씨가 쓴 책에도",
"기누타 유리라는 여배우가",
"나오죠」"
],
"15507": [
"「기누타 유리?",
"어디 나왔더라」"
],
"15508": [
"「『오이란은 왜 살해되나』라는",
"이야기였던 것 같아요」"
],
"15509": [
"「아, 그거구나.",
"그래도 그 사람은 나왔을 때 이미",
"죽어 있었으니까」"
],
"15510": [
"「『종루관 살인』에 나오는",
"츠바키라는 사람은...」"
],
"15511": [
"「응? 다카토 거?」"
],
"15512": [
"「그쪽 츠바키라는 사람은",
"아저씨였어, 아마」"
],
"15513": [
"「나이에 비해 튼튼하다고",
"쓰여 있었는데, 여기 츠바키 군만큼",
"근육은 없지 않을까?」"
],
"15514": [
"그러니까 왜 근육 얘기가 되는 거야..."
],
"15515": [
"「시노노메 다키라는 사람이",
"나오는 이야기 기억하세요?」"
],
"15516": [
"「어, 다카토 거?",
"『그림 속의 죽음』이었나」"
],
"15517": [
"「뭔가 어둡고 수수한",
"이야기였던 것 같은데」"
],
"15518": [
"「수수해요?」"
],
"15519": [
"「응, 도깨비 가면 쓰고 배회하는",
"살인귀나 머리 없는 시체나",
"모방 살인이 나오는 게 아니라서」"
],
"15520": [
"그런 게 안 나오면 수수한 건가.",
"잘 모르겠다..."
],
"15521": [
"「다카토 씨 이야기에 나오는",
"시즈나 짱이랑 스즈나 짱도",
"쌍둥이죠」"
],
"15522": [
"「응, 그럴 거야.",
"거기도 똑 닮은 자매고」"
],
"15523": [
"「그러고 보니...",
"쌍둥이가 나오는 건 그거랑",
"한 권뿐이었네」"
],
"15524": [
"「응, 세쌍둥이가 나오는",
"이야기라면 또 있지만」"
],
"15525": [
"그건 일단 이번엔",
"상관없을 것 같네..."
],
"15526": [
"「다카토 씨 소설 중에",
"우쓰로이 가문이 나오는 게",
"있잖아요」"
],
"15527": [
"「『저주는 죽지 않는다』 말이야?",
"그거 분명 실제 있었던 일이",
"바탕 아니었나」"
],
"15528": [
"「시, 실제라니, 엄청난",
"줄거리였잖아요!?」"
],
"15529": [
"「그래도 쓰야마 30인 살해가",
"바탕이 된 이야기도 있으니까」"
],
"15530": [
"「...그, 그건 그렇지만요」"
],
"15531": [
"「근데 『저주는 죽지 않는다』의",
"바탕은 일본 게 아니야」"
],
"15532": [
"「동유럽인지 중유럽인지의",
"백작 가문이 원조래」"
],
"15533": [
"「동유럽이나 중유럽이면...",
"루마니아 그쪽인가요?」"
],
"15534": [
"「아마 그쪽이겠지. 그런데",
"우쓰로이 가문의 원조가 된 나라는",
"이미 없어졌던 것 같아」"
],
"15535": [
"그럼 만약 실화였다 해도,",
"백작 가문도 나라도 안 남았나..."
],
"15536": [
"「요즘 세상에 유모 할멈이 있는",
"집은 어떤 집일까요?」"
],
"15537": [
"「유모 할멈?",
"어떤 집일까, 그거...」"
],
"15538": [
"「엄청난 부잣집에",
"명문가 같은 걸까?」"
],
"15539": [
"「아마 그럴 거예요」"
],
"15540": [
"「흐음, 좋겠다.",
"한번 살아 보고 싶네, 그런 집」"
],
"15541": [
"「분명 마당도 넓겠지,",
"방에 운동기구 여러 대 놓겠고」"
],
"15542": [
"동경하는 포인트가",
"보통과 다른 것 같다..."
],
"15543": [
"「저기, 나스 씨...",
"정말 모자 장수가 모두를 여기...」"
],
"15544": [
"「모자 장수는 말이야...」"
],
"15545": [
"나스 씨는 웬일로 드물게 어려운",
"얼굴로 생각에 잠겼다."
],
"15546": [
"「저, 무슨 일 있으세요?」"
],
"15547": [
"「있잖아, 나고무 군은",
"모두를 모은 건... 아니,",
"이 사건을 꾸민 건...」"
],
"15548": [
"「...모자 장수라고 생각해?」"
],
"15549": [
"「네, 그건...」"
],
"15550": [
"「저는... 그렇다고 생각해요」"
],
"15551": [
"「그래...?",
"하지만 보통 사람을 죽이려는",
"범인이 필명이라도 이름을 댈까」"
],
"15552": [
"「그러니까...",
"무서운 생각이 드는 거예요」"
],
"15553": [
"「자기도 살아 돌아갈 생각은",
"처음부터 없는 게 아닐까...」"
],
"15554": [
"「...다 죽이고 자기도",
"죽어 버리면, 나중에 들키든",
"상관없다는...?」"
],
"15555": [
"「...네.",
"그런 건 싫지만요...」"
],
"15556": [
"「그렇구나....",
"역시 그런 걸까」"
],
"15557": [
"아직 조금 납득 못 한 얼굴로",
"나스 씨는 팔짱을 끼고",
"고개를 갸웃했다..."
],
"15558": [
"「저는 그렇게 생각 안 해요」"
],
"15559": [
"「정말? 어째서?」"
],
"15560": [
"「나스 씨네가 모자 장수 초대로",
"여기 온 건, 사무소 사람들도",
"다 알고 있잖아요?」"
],
"15561": [
"「만약 모자 장수 본인이 이 사건을",
"꾸민 범인이라면...」"
],
"15562": [
"「이대로 여기 있는 우리를 다",
"죽인다 해도, 불러 모은 게",
"자기란 건 못 숨기잖아요」"
],
"15563": [
"「그야 금방 들키겠지」"
],
"15564": [
"「...그 말은, 이대로 우리가",
"여기서 다 죽어 버리면,",
"모자 장수가 범인이 되는 건가」"
],
"15565": [
"「그건 어려워요, 왜냐면",
"모자 장수는 평범하게 시내에 살아서",
"알리바이 같은 게 있을 테니...」"
],
"15566": [
"「시내에 있다면 말이지」"
],
"15567": [
"「진짜 모자 장수가 여기 있다면?」"
],
"15568": [
"「여기...라니,",
"이 저택에요!?」"
],
"15569": [
"「알리바이 같은 거 없겠지」"
],
"15570": [
"「그야... 없는 정도가 아니라,",
"다 죽어 버리면 누구보다",
"수상하게...」"
],
"15571": [
"「그렇다니까.",
"그런 걸까」"
],
"15572": [
"「어, 저, 그래도...",
"진짜 모자 장수라면 초대장이",
"온 시점에 가짜인 걸 알 텐데」"
],
"15573": [
"「가짜인 건 알아도",
"누구 짓인지는 모르잖아」"
],
"15574": [
"「...그래서 누군지 보러",
"왔을지도 모른다는 거예요?」"
],
"15575": [
"「설마 죽일 생각으로",
"부른 줄은 몰랐으니까」"
],
"15576": [
"「그야 그렇.... 네?」"
],
"15577": [
"「몰랐...으니까, 라니",
"저, 그럼 마치 나스 씨가",
"모자 장수인 것처럼...」"
],
"15578": [
"「어라?",
"아까 그렇게 말 안 했나」"
],
"15579": [
"「그러니까 여기 있다고」"
],
"15580": [
"「에에엣!?",
"그, 그건 예를 든 얘기...」"
],
"15581": [
"「아니, 있는데」"
],
"15582": [
"「나... 나스 씨?",
"나스 씨가 모자 장수...!?」"
],
"15583": [
"「응, 맞아」"
],
"15584": [
"「그래 봤자 난 쓰기만 하고",
"홍보해 주는 건",
"우리 매니저지만」"
],
"15585": [
"「어, 저...",
"그건 물론 다른 사람들은",
"모르는 거죠...」"
],
"15586": [
"「응, 말 안 했어.",
"어쩌다 말할 타이밍을 놓쳐서」"
],
"15587": [
"「나고무 군은 날 의심 안 하는",
"것 같으니까, 뭐 괜찮겠다 싶어서」"
],
"15588": [
"「...아, 네, 뭐」"
],
"15589": [
"「그래도 남한테 말하면 의심받을",
"것 같으니 미안하지만 비밀로 해 줘」"
],
"15590": [
"말해도 안 믿어 주지",
"않을까..."
],
"15591": [
"「그런데 진짜 범인은...",
"처음부터 그럴 생각이었을까.",
"모자 장수를 범인으로 만들려고」"
],
"15592": [
"범인의 속셈은 어떻든, 만약 우리가",
"정말로 다 죽어 버린다면..."
],
"15593": [
"（...범인은 모자 장수였다고",
"하게 될 것 같네...）"
],
"15594": [
"（설령 그게 누명이라도...）"
],
"15595": [
"「...쿠라이시 씨 일로",
"좀...」"
],
"15596": [
"「쿠라이시 씨?」"
],
"15597": [
"「미사사기 씨가 아침 일찍",
"봤다고 하시더라고요」"
]
}