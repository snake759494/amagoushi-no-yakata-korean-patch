 ],
 "21049": [
  "「주변에서도 꽤 떠들썩했으니까,",
  "그래서 기억했나...」"
 ],
 "21050": [
  "「직접은 몰라?」"
 ],
 "21051": [
  "「그래, 모르는 녀석이야」"
 ],
 "21052": [
