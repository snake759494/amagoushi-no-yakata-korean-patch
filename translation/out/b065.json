"32482": [
"「너희가 떠드니까",
"잠이 깨 버렸잖아」"
],
"32483": [
"「무슨 소동이었어?",
"근육이 뭔 사고라도 쳤냐?」"
],
"32484": [
"「사고를 쳤다...라고",
"할까, 그게...」"
],
"32485": [
"「누가 봐도 죽어 있었는데",
"왠지 되살아났어...」"
],
"32486": [
"「...너, 괜찮냐?」"
],
"32487": [
"「거짓말 아니라니까!",
"진짜로 내 눈앞에서 독이 든",
"차를 마셨다고!!」"
],
"32488": [
"「그래서 누가 봐도",
"죽어 있었는데 태연하게",
"되살아났다고!!」"
],
"32489": [
"「멋대로 죽이지 마!?",
"그거 그냥 독이 안",
"들었던 거잖아!?」"
],
"32490": [
"「아무리 근육이라도",
"한 번 죽으면 보통은...」"
],
"32491": [
"「? 츠바키 군?」"
],
"32492": [
"「...아니, 근데",
"그 녀석이면 가슴 근육을",
"움직일 수 있겠다 싶어서...」"
],
"32493": [
"「어, 그러니까 그건",
"자력으로 심장 마사지를",
"해서 살아났다고...」"
],
"32494": [
"「인류가 아니잖아, 그거!?」"
],
"32495": [
"「츠바키 군이",
"말한 거잖아!?」"
],
"32496": [
"「게다가 살아나도",
"뱃속에 독이 남아 있잖아!」"
],
"32497": [
"「어라, 그럼 역시",
"안 들은 거...?」"
],
"32498": [
"「안 듣는 거야, 아마.",
"위가, 그거야, 뭘 먹든",
"프로틴으로 변환하는 거지」"
],
"32499": [
"「펴, 편리하네...」"
],
"32500": [
"「그러니까 뇌까지 근육이",
"되는 거라고!!",
"이제 잘 거야!!」"
],
"32501": [
"츠바키 군은 도망치듯 잰걸음으로",
"떠나갔다..."
],
"32502": [
"「쿠라이시 씨는 방에",
"틀어박힌 채려나?」"
],
"32503": [
"「범인이 독을",
"먹였는데」"
],
"32504": [
"「왠지 살아 있었어」"
],
"32505": [
"「무, 무사해서 다행이지?」"
],
"32506": [
"「진짜라니까!?」"
],
"32507": [
"「거짓말이라곤 안 했어!」"
],
"32508": [
"「더 이상 골치 아픈 얘기",
"듣고 싶지 않다고!!」"
],
"32509": [
"「꿈에 나오면",
"어떻게 책임질 건데」"
],
"32510": [
"「아 진짜...",
"뇌는커녕 내장까지",
"근육이었냐, 그 바보」"
],
"32511": [
"투덜투덜 불평하면서",
"츠바키 군은 가 버렸다."
],
"32512": [
"「내장이 근육이면",
"독이 안 듣는 걸까」"
],
"32513": [
"「그런 문제가 아닌",
"것 같은데요...」"
],
"32514": [
"「뭐, 일단",
"츠바키 씨는 무사하고",
"남은 건 쿠라이시 씨네요」"
],
"32515": [
"「쿠라이시 씨가",
"안 보이는 거야?」"
],
"32516": [
"「아, 나스 씨」"
],
"32517": [
"「그거 걱정이네.",
"좋아, 보러 가 보자!」"
],
"32518": [
"「쿠라이시 씨~!",
"안녕하세요~!」"
],
"32519": [
"「살아 계세요~?",
"열게요~!」"
],
"32520": [
"「나스 씨!?",
"손잡이 빠졌어요!?」"
],
"32521": [
"「이상하네,",
"가볍게 돌렸을 뿐인데」"
],
"32522": [
"「어디가 가볍냐, 이 바보」"
],
"32523": [
"「잠가 뒀는데",
"억지로 돌리니까...」"
],
"32524": [
"「야, 쿠라이시 씨.",
"무사했구나」"
],
"32525": [
"「야, 가 아니야.",
"어쩔 거냐고」"
],
"32526": [
"「이래서야 틀어박힐",
"수가 없잖아」"
],
"32527": [
"「틀어박히긴커녕",
"문을 못 잠그면",
"밤에 위험해서 큰일이에요」"
],
"32528": [
"「어, 그럼...",
"그 옷장이라도 문 앞에",
"놔둘까?」"
],
"32529": [
"「너밖에 못 움직이잖아,",
"그거!?」"
],
"32530": [
"「아, 안전할진 몰라도",
"쿠라이시 씨가 못 나와요...」"
],
"32531": [
"「그렇구나, 곤란하네」"
],
"32532": [
"「너 때문이야, 너」"
],
"32533": [
"「어, 저기, 뭔가",
"쓸 만한 게 없는지",
"찾아올게요」"
],
"32534": [
"「어라, 미사사기 씨?」"
],
"32535": [
"「......밀실이」"
],
"32536": [
"「네? 밀실?」"
],
"32537": [
"「아...",
"아, 아뇨, 아무것도...」"
]
}