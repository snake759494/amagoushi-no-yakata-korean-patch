],
"32149": [
"(여기는...",
"막다른 곳인가)"
],
"32150": [
"(...?",
"바닥에 무슨 얼룩 같은 게",
"있는 것 같은데...)"
],
"32151": [
"희미하게 기분 나쁜 빛을 내는",
"얼룩이 벽 아래에서 번져 있다."
],
"32152": [
"벽 너머에서 흘러온",
"것 같았다."
],
"32153": [
"(이 벽도 열리려나...)"
],
"32154": [
"하지만 열면 분명",
"흔적이 남겠지."
],
"32155": [
"열면 어디로 나갈지",
"확실히 모르는데",
"그건 좀..."
],
"32156": [
"(왠지 무서... 아니,",
"위험할지도 모르니까",
"그만두자...)"
],
"32157": [
"형광 도료가 배어 나오고 있는",
"곳까지 왔다."
],
"32158": [
"뭐지 저건.",
"이상한 색의 얼룩이..."
],
"32159": [
"(페인트?",
"형광 도료 같은데...)"
],
"32160": [
"게다가 저 색은...",
"본 적이 있다..."
],
"32161": [
"「...막다른",
"곳인가...?」"
],
"32162": [
"「아...!!」"
],
"32163": [
"막다른 벽 아래에",
"희미하게 기분 나쁘게 번진",
"얼룩이 있었다."
],
"32164": [
"「이 색...」"
],
"32165": [
"본 적이 있다.",
"깡통이 쓰러져 흘러나왔던",
"형광 도료의 색이다."
],
"32166": [
"(그럼",
"이 벽 너머는...)"
],
"32167": [
"(...지하실이구나)"
],
"32168": [
"도료가 흘러나오는 틈이",
"있다는 건",
"이 벽이 열려서 지나갈 수 있겠지."
],
"32169": [
"(지금은...",
"도료가 흐트러진 부분이 없으니까",
"아무도 안 지나갔구나...)"
],
"32170": [
"마르기 전이든 후든 벽을 움직이면",
"아무래도 흔적이 남을 거다."
],
"32171": [
"눈을 부릅뜨고 살펴봤지만",
"그런 흔적은 없었다."
],
"32172": [
"(...열어 보고 싶지만)"
],
"32173": [
"그러면 벽을 연 흔적이",
"어떻게든 남겠지."
],
"32174": [
"여기가 지나갈 수 있다는 것도,",
"그걸 아는 녀석이 따로",
"있다는 것도 들킨다..."
],
"32175": [
"「...무서우니까 그만두자」"
],
"32176": [
"일단 비밀 통로가 어디로",
"이어지는지 알았으니",
"이대로 두자."
],
"32177": [
"형광 도료가 배어 나오고 있는",
"곳까지 왔다.",
"이 벽 너머는 지하 창고다."
],
"32178": [
"「...비밀 통로였구나」"
],
"32179": [
"왜 이런 게 있는 걸까.",
"어둑하고 무섭고 뭔가 나올 것",
"같고 싫다..."
],
"32180": [
"(어둑하네...)"
],
"32181": [
"이쪽은 지하도다."
],
"32182": [
"안쪽으로 가 보자."
],
"32183": [
"(이쪽은 창고다)"
],
"32184": [
"실내를 둘러보고 벽에 구내전화가",
"달린 걸 보고 안심한다."
],
"32185": [
"드디어 비밀 통로가 아니라",
"저택 안으로 돌아왔다..."
],
"32186": [
"나스 씨다...",
"옆에서 떨떠름한 얼굴은 츠바키 군."
],
"32187": [
"마다라이 씨와 쌍둥이가――없었다."
],
"32188": [
"「그딴 건 은둔형",
"아저씨가 나와 있는 시점에서",
"알고 있어」"
],
"32189": [
"「말대꾸 많은 꼬마로군.",
"알고 있으면 입 다물어」"
],
"32190": [
"「그러니까 그게 누구냐는",
"얘기를 하고 있잖아!!」"
],
"32191": [
"「자자, 그렇게 흥분하지",
"마세요...」"
],
"32192": [
"「이게 진정이 되냐!",
"여기까지 잘 버텨 왔는데",
"대체 뭐야, 저건!?」"
],
"32193": [
"「맞아, 우리가 무사한 건",
"나고무 군 덕분일지도 모르니까」"
],
"32194": [
"「그 애, 언제 살해당한 거야?",
"어젯밤인가?」"
],
"32195": [
"「어젯밤이라...",
"꽤 일찍 자 버렸거든」"
],
"32196": [
"「설마 시계가 울렸을 때도",
"자고 있었냐, 당신...」"
],
"32197": [
"「나고무, 너는?」"
],
"32198": [
"「...나도 들었어.",
"히오리가 시계 고친 건",
"내가 증언할 수 있고...」"
],
"32199": [
"「아무 관계 없는 쪽이",
"더 기분 나쁘잖아」"
],
"32200": [
"「그럴 가능성이 높겠지」"
],
"32201": [
"「...그 밖에 방에서 나간 놈은?」"
],
"32202": [
"「난 계속 안 나갔다」"
],
"32203": [
"「아저씨는 알고 있다니까.",
"나도 안 나갔어」"
],
"32204": [
"「제일 알리바이 없는 건 당신이지」"
],
"32205": [
"「일일이 시끄럽네, 넌.",
"...그래서, 꼬마」"
],
"32206": [
"「꼬마 아니거든.",
"쌍둥이는 하나 더 있잖아」"
],
"32207": [
"「아아...",
"스즈나 씨 말인가요」"
],
"32208": [
"「생각하고 싶진 않지만",
"저거 애초에 정말로",
"스즈나 쪽 맞아?」"
],
"32209": [
"「...아아, 그렇군.",
"그것도 모르겠군」"
],
"32210": [
"「우린 한 번 노려졌었다고,",
"알아!?」"
],
"32211": [
"「너, 이제 와서 무서운 소리 마...」"
],
"32212": [
"「나구모 씨」"
],
"32213": [
"「대체 어디서 끄집어낸 거야",
"그 황당한 기억은!?」"
],
"32214": [
"「나고무가 진짜 나구모가",
"아니란 증거도 없단 말이지...」"
],
"32215": [
"「난 아니라니까!",
"진짜 아니라고!」"
],
"32216": [
"「아니, 의심하는 게 아니라",
"알아볼 방법이 없는 게",
"많다는 얘기를...」"
],
"32217": [
"「너만은 다른 누구도 아니란 게",
"보면 아니까 입 다물어」"
],
"32218": [
"「그러니까 아까부터",
"그 얘기를...!」"
],
"32219": [
"「스즈나...」"
],
"32220": [
"「무리야, 누가 봐도!",
"야, 근육 어떻게 좀 해 봐!!」"
],
"32221": [
"「어, 옮기면 돼?」"
],
"32222": [
"「무리도 아니지만...」"
],
"32223": [
"「동정은 하지만",
"지금 우리가 해 줄 수 있는",
"건 없잖아」"
],
"32224": [
"「...알고 있어」"
],
"32225": [
"어째서...",
"여기까지 전부 잘",
"됐었는데..."
],
"32226": [
"(왜 시즈나만",
"저런...)"
],
"32227": [
"「아 진짜, 궁상맞긴!",
"나고무, 너 몇 살이야!?」"
],
"32228": [
"「그러지 마세요, 츠바키 씨...",
"화내지 말아 주세요...」"
],
"32229": [
"「시끄러워!",
"나라고 소리치고 싶어서",
"이러는 거 아니라고!!」"
],
"32230": [
"「화풀이할 거면 방에서 해.",
"더 짜증나잖아」"
],
"32231": [
"「...젠장!」"
],
"32232": [
"쾅, 소파를 걷어차고",
"츠바키 군은 성큼성큼 거실을 나갔다."
],
"32233": [
"「자자, 나고 씨도",
"진정하세요」"
],
"32234": [
"「으...응...」"
],
"32235": [
"「...참 나.",
"너 혼자 전부 짊어지고",
"있는 게 아니잖아」"
],
"32236": [
"「으음...",
"그럼 나도 방에 있을게」"
],
"32237": [
"(쿠라이시 씨와 마다라이 씨...",
"그리고 쌍둥이가 없다...)"
],
"32238": [
"...꿈이 아니구나.",
"역시 아까 본 그건..."
],
"32239": [
"「...뭐, 태평하게 빈혈",
"일으킬 때가 아니지만」"
],
"32240": [
"「왜냐니, 그게 아니잖아!?",
"대체 누가 한 거야!!」"
],
"32241": [
"「뭔가 일이 틀어진 모양인데,",
"나고무가 사과해 봤자 소용없잖아」"
],
"32242": [
"「왜라기보다",
"누가 했는지 알고 싶은 거지만」"
],
"32243": [
"「방 열쇠는 갖고 계셨을",
"텐데... 아, 하지만...」"
],
"32244": [
"「...근육한테 물어본",
"내가 바보였다...」"
],
"32245": [
"「그건 3시 넘어서였죠.",
"다시 맞춰서 기억해요」"
],
"32246": [
"「나도 들었고...",
"히오리가 시계 고친 건",
"내가 증언할 수 있어...」"
],
"32247": [
"「시계가 울렸어?",
"근데 그거 멈췄던 거 아냐...」"
],
"32248": [
"「그러니까 이상하단",
"얘기를 하는 거잖아!?」"
],
"32249": [
"「그런 게 이유도 없이",
"갑자기 울릴 리가 없잖아」"
],
"32250": [
"「거기까지는 아직...」"
],
"32251": [
"「난 계속 방에 있어서",
"그때도 전후로도 안 나갔어.",
"...그 밖에 방에서 나간 놈은?」"
],
"32252": [
"「나도 자고 있었어」"
],
"32253": [
"「근육은 알고 있다니까.",
"뭐, 알리바이는 없나...」"
],
"32254": [
"「...그래서, 나고무」"
],
"32255": [
"「네 추리대로라면",
"우리는 이미 노려졌었어.",
"어젯밤은 쌍둥이 한쪽이고」"
],
"32256": [
"「그럼 노려지지 않은 건",
"이제 3명밖에 없잖아」"
],
"32257": [
"「왜 나고무야!",
"쌍둥이 하나가 살아 있잖아」"
],
"32258": [
"「이제 와서 뭘 뒤집어엎고",
"있는 거야, 넌!?」"
],
"32259": [
"「그렇구나, 결국 아무도",
"혐의가 안 풀리는구나」"
],
"32260": [
"「납득하지 마!!」"
],
"32261": [
"「아아, 한 명 더 있었지」"
],
"32262": [
"「게다가 살았는지",
"죽었는지조차 모릅니다」"
],
"32263": [
"「얘기가 진전이 없네요」"
],
"32264": [
"「어쨌든 방에...",
"눕히는 게...」"
],
"32265": [
"어째서...",
"왜 시즈나가",
"저런 끔찍한 일을..."
],
"32266": [
"「겨우 일어났냐」"
],
"32267": [
"떨떠름한 얼굴을 한 건",
"츠바키 군이다..."
],
"32268": [
"나스 씨와 마다라이 씨...",
"그리고 쌍둥이가 없었다."
],
"32269": [
"「뭐, 그런 느긋한 소리",
"할 때도 아니지만」"
],
"32270": [
"「저기... 어떻게 하실 거예요?」"
],
"32271": [
"「그걸 알았으면",
"지금 이 꼴이 났겠냐!」"
],
"32272": [
"「밤중에 시계가 울렸지.",
"그게 몇 시쯤이야, 3시 넘었나」"
],
"32273": [
"「난 계속 안 나갔다」"
],
"32274": [
"「...잠깐.",
"3명이면 이상하지 않냐?」"
],
"32275": [
"「꼬마도 머릿수에 들지.",
"안 넣을 수는 없잖아.",
"여기 있는 이상」"
],
"32276": [
"「잠깐, 안 죽은 쪽",
"쌍둥이는 어떻게 되는데?」"
],
"32277": [
"「무리야, 누가 봐도!",
"야, 방으로 데려가자!」"
],
"32278": [
"「어쩔 수 없군...",
"밀어 넣고 난 그대로",
"방에 돌아간다!」"
],
"32279": [
"떨어져 있던 사람들이",
"이쪽을 본다."
],
"32280": [
"걱정스레 봐 주는 건",
"미사사기 씨."
],
"32281": [
"방 안에 있는 건",
"그게 전부였다..."
],
"32282": [
"「츠바키 씨, 그런...」"
],
"32283": [
"「그런, 이 아니잖아!?",
"대체 누가 한 거야!!」"
],
"32284": [
"「...어젯밤 시계 울렸지.",
"그게 몇 시였어?」"
],
"32285": [
"「근데 그 시계랑 무슨 관계가?」"
],
"32286": [
"「난 계속 방에 있어서",
"그때도 전후로도 안 나갔어.",
"...미사사기 씨, 당신은?」"
],
"32287": [
"「저, 저는...",
"어젯밤 내내 방에 있었어요」"
],
"32288": [
"「...뭐, 그렇겠지」"
],
"32289": [
"「근데 나고 씨는 미아예요.",
"관계없잖아요」"
],
"32290": [
"「아아, 그쪽 말인가요.",
"확실히 이론상으론 그렇죠」"
],
"32291": [
"「게다가 살았는지 죽었는지",
"조차 모릅니다」"
],
"32292": [
"「무리야, 누가 봐도!",
"방으로 데려갈 수밖에 없어!!」"
],
"32293": [
"「아 진짜!",
"어차피 말이 안 통해, 얘",
"밀어 넣고 나도 방에 갈 거야!」"
],
"32294": [
"「아, 저기, 도울게요!」"
],
"32295": [
"날뛰는 스즈나를 츠바키 군과",
"미사사기 씨가 데리고 나갔다."
],
"32296": [
"(...왜...)"
],
"32297": [
"왜 이런 끔찍한 일이...",
"시즈나가... 어째서..."
],
"32298": [
"마다라이 씨와 쌍둥이가――없었다."
],
"32299": [
"「야, 잠깐만.",
"그 전에 죽은 게 정말로",
"스즈나 쪽이었어?」"
],
"32300": [
"「흥...",
"뭐, 방도 기모노도 언니",
"쪽 거였다는 얘기지」"
],
"32301": [
"「거기까지 의심하냐...」"
],
"32302": [
"「3명이라는 건",
"히오리 군하고 미사사기 씨,",
"나고무 군?」"
],
"32303": [
"「아아...",
"시즈나 씨 말인가요」"
],
"32304": [
"「시즈나인지 스즈나인지는",
"모르겠다만」"
],
"32305": [
"「어느 쪽인지 확인할",
"방법은 없겠지...」"
],
"32306": [
"「뭐라고...!!」"
],
"32307": [
"「시즈나...」"
],
"32308": [
"「야, 잠깐!",
"진정하라고!!」"
],
"32309": [
"「무리겠네요, 이건...!」"
],
"32310": [
"「야, 근육 어떻게 좀 해!",
"그쪽에서 떼어 내!!」"
],
"32311": [
"「아, 알았어!",
"시즈나, 자, 놔!」"
],
"32312": [
"「우왓!?",
"날뛰지 말라니까!!」"
],
"32313": [
"(왜 스즈나만",
