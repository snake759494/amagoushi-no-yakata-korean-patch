 "25696": [
  "「에에,",
  "그치만 달리 가진 거라곤...」"
 ],
 "25697": [
  "「...이거 아닙니까?」"
 ],
 "25698": [
  "「쐐기 같네」"
 ],
 "25699": [
  "「그렇죠.",
  "근데 6개나 있을 줄이야...」"
 ],
 "25700": [
  "「이거...",
  "우리 둘로는 시간 안에",
  "못 할 것 같은데요」"
 ],
 "25701": [
  "「그, 그래도 그럼 무너...」"
 ],
 "25702": [
  "「아무리 봐도 쐐기로 안 보여요!",
  "도망치는 게 낫다는 거군요」"
 ],
 "25703": [
  "「어, 쐐, 쐐기...",
  "쐐기라면...」"
 ],
 "25704": [
  "「아앗, 이거!?",
  "지하에서 주워서 그대로",
  "가지고 와 버렸는데」"
 ],
 "25705": [
  "「그거...",
  "6개나 있는 겁니까!?」"
 ],
 "25706": [
  "「...있네」"
 ],
 "25707": [
  "「어딘가에 끼워 넣어야",
  "하는 거죠, 이거」"
 ],
 "25708": [
  "크게 옆으로 흔들려서",
  "균형을 잃고 만다."
 ],
 "25709": [
  "「아... 야...」"
 ],
 "25710": [
  "「히오리... 으악!?」"
 ],
 "25711": [
  "고개를 들려는데",
  "바로 눈앞에 뭔가 떨어졌다."
 ],
 "25712": [
  "「으, 으앗...!?」"
 ],
 "25713": [
  "「잡아요!",
  "뜁니다!!」"
 ],
 "25714": [
  "「어... 우왓!?」"
 ],
 "25715": [
  "놀랄 만큼 센 힘에 일으켜졌다.",
  "뭐가 뭔지 모른 채 끌려가는",
  "대로 필사적으로 달린다..."
 ],
 "25716": [
  "「히오리!",
  "히오리!? 어디야!?」"
 ],
 "25717": [
  "흔들리는 계단을 굴러떨어질",
  "뻔하며 뛰어 내려간다."
 ],
 "25718": [
  "「히오... 우와악!?」"
 ],
 "25719": [
  "크게 흔들려 계단을 헛디뎌",
  "두세 칸을 미끄러져 떨어졌다."
 ],
 "25720": [
  "「아파...」"
 ],
 "25721": [
  "「나고 씨!?",
  "괜찮아요?」"
 ],
 "25722": [
  "「허, 허리 부딪쳤어...」"
 ],
 "25723": [
  "「이크」"
 ],
 "25724": [
  "「또, 또 흔들려! 저기,",
  "도망치는 게 낫지 않아!?」"
 ],
 "25725": [
  "「저도 그렇게 생각해요.",
  "이 소리, 보통 일이 아니죠」"
 ],
 "25726": [
  "엄청난 소리와 동시에",
  "바닥이 물결치듯 뒤틀리며 삐걱댄다."
 ],
 "25727": [
  "「처, 처, 천장...",
  "금이...!!」"
 ],
 "25728": [
  "「네, 이건 이제 틀렸어요!",
  "도망칩니다!!」"
 ],
 "25729": [
  "주저앉은 채인 내 팔을 끌고",
  "히오리는 달리기 시작했다."
 ],
 "25730": [
  "「으, 와...!!」"
 ],
 "25731": [
  "「나도 모르겠어!",
  "쐐기라고 해도...」"
 ],
 "25732": [
  "「그럼 도망치는 수밖에",
  "없겠네요」"
 ],
 "25733": [
  "「으, 응!",
  "아, 그래도 다른 사람들...」"
 ],
 "25734": [
  "갑자기 격하게 옆으로 흔들려",
  "발이 걸렸다."
 ],
 "25735": [
  "「아얏...」"
 ],
 "25736": [
  "「괜찮아요?",
  "자, 잡아요」"
 ],
 "25737": [
  "「읏...",
  "바, 발 삔 것 같아」"
 ],
 "25738": [
  "일어서려 하자 발목에 이상한",
  "통증이 와서 제대로 설 수 없었다."
 ],
 "25739": [
  "진동과 함께 머리 위로 먼지가 떨어진다.",
  "벽도 창문도 부르르 떨려 저택 전체가",
  "기이한 불협화음을 내는 것 같다."
 ],
 "25740": [
  "「느긋하게 얘기할 틈은",
  "없어 보이네요...!」"
 ],
 "25741": [
  "「잠깐 기다려요」"
 ],
 "25742": [
  "그렇게 말하더니 히오리는 현관 옆",
  "내선 전화로 달려들었다."
 ],
 "25743": [
  "「...아, 아직 있었습니까!",
  "도망쳐요, 무너집니다!」"
 ],
 "25744": [
  "「네, 빨리요!",
  "저흰 먼저 나갈게요!?」"
 ],
 "25745": [
  "그렇구나, 다른 사람들...",
  "지진 같은 건 줄 알고",
  "아직 방에 있었던 거야..."
 ],
 "25746": [
  "점점 흔들림이 강해진다.",
  "다들 늦지 않을까..."
 ],
 "25747": [
  "「갑니다, 나고 씨!」"
 ],
 "25748": [
  "「어... 우왓!?」"
 ],
 "25749": [
  "히오리가 내 옆에 쪼그려 앉나",
  "싶더니 순식간에",
  "나는 들쳐 업혀 있었다."
 ],
 "25750": [
  "「으, 와...」"
 ],
 "25751": [
  "땅이 가라앉는 듯한 감각이 들었다.",
  "그리고 시야 구석에서 그 대형 시계가",
  "천천히 쓰러지려 하고――"
 ],
 "25752": [
  "「쐐, 쐐기...",
  "아앗, 이거!?」"
 ],
 "25753": [
  "「지하실에서 주운 거!」"
 ],
 "25754": [
  "「...이거 같네요」"
 ],
 "25755": [
  "「이걸 다시 끼우면",
  "된다는 겁니까」"
 ],
 "25756": [
  "「아, 아마... 그래도...」"
 ],
 "25757": [
  "「수가 많네.",
  "우리 둘로는...」"
 ],
 "25758": [
  "「어이, 나고무 군! 히오리 군!」"
 ],
 "25759": [
  "「뭐야, 이게!?",
  "지진이 아니잖아!?」"
 ],
 "25760": [
  "「나스 씨, 츠바키 군!!」"
 ],
 "25761": [
  "「다행이다, 무사했군요」"
 ],
 "25762": [
  "「...쿠라이시 씨는?」"
 ],
 "25763": [
  "「그게, 일단 불렀는데",
  "대답도 안 하더라고」"
 ],
 "25764": [
  "「이건 우리끼리",
  "어떻게든 해야겠네요」"
 ]
}