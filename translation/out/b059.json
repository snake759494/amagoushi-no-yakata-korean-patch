],
"29873": [
"「안 해도 돼,",
"무서우니까!!」"
],
"29874": [
"「무서워서냐고!?」"
],
"29875": [
"「당연히 무섭지!",
"츠바키 군은 안 무서웠어?」"
],
"29876": [
"「...아니, 그야",
"안 무서웠을 리는 없지만」"
],
"29877": [
"「분명히 무섭다고!",
"난 상상만 해도",
"정신이 아득해지는데...」"
],
"29878": [
"「그것도 좀 아닌 것 같은데」"
],
"29879": [
"「...노려지고 있는",
"츠바키 군네는 대체",
"얼마나 무서울지...」"
],
"29880": [
"「뭐랄까,",
"네가 우리 쪽이었으면",
"죽기 전에 앓아누웠겠다」"
],
"29881": [
"「아마 처음 온실에서",
"『복수』라는 걸 봤을 때쯤」"
],
"29882": [
"「너무 빠르잖아, 그건!?",
"아직 무슨 일인지조차",
"모를 때잖아!」"
],
"29883": [
"「그, 그치만 무서워...」"
],
"29884": [
"「...넌 오컬트 계열",
"연극 같은 걸 보여 주면 배우한텐",
"이상적인 관객이겠다」"
],
"29885": [
"「중간에 기절하거나",
"하면 오히려 민폐 아냐?」"
],
"29886": [
"「연극에서까지!?」"
],
"29887": [
"「그치만 연극은",
"자리에 앉아 있어야 하니까",
"도망칠 수 없잖아」"
],
"29888": [
"「그렇구나, 지금 여기서",
"묘하게 돌아다니는 건 도망칠",
"데가 없어서냐」"
],
"29889": [
"「응, 도망칠 수 없으니까",
"어떻게든 안 하면 계속 무섭고」"
],
"29890": [
"「...왜 갑자기 길을",
"잃었는지 알겠다」"
],
"29891": [
"「밤 산속에서",
"혼자 차 안에 있는 게",
"무서워진 거구나」"
],
"29892": [
"「아, 그래도 휘발유가",
"떨어져 가던 것도 사실이야?」"
],
"29893": [
"「알았어 알았어」"
],
"29894": [
"「...이제 곧이네」"
],
"29895": [
"「이제 곧이라니?」"
],
"29896": [
"「촬영 종료... 예정이었던",
"날 말이야」"
],
"29897": [
"「아...",
"응, 그렇네」"
],
"29898": [
"「우리, 정말 돌아갈 수 있을까」"
],
"29899": [
"「도, 돌아가자.",
"모처럼 살았으니까」"
],
"29900": [
"「범인이 마지막의 마지막에",
"뭔가 저지르지 않으면 좋겠는데」"
],
"29901": [
"「...아직 방심은 못 하잖아」"
],
"29902": [
"「...야, 나고무」"
],
"29903": [
"「죽지 마」"
],
"29904": [
"「우리만 살려 놓고",
"자기는 안 돌아오는",
"드라마 같은 짓 하지 마」"
],
"29905": [
"「아, 안 해」"
],
"29906": [
"「여기서 나갈 거면",
"같이가 아니면 의미 없어.",
"너도, 히오리도」"
],
"29907": [
"「...진짜 부탁한다」"
],
"29908": [
"「난 말이야, 그렇게",
"뻔뻔하지도 강하지도 않아」"
],
"29909": [
"「내 인생 하나만으로도",
"벅차다고」"
],
"29910": [
"「네 몫까지 짊어지고",
"살아가라고 해도",
"무리니까」"
],
"29911": [
"「안 그래도...",
"마다라이 아저씨라든가 이미",
"쓸데없이 무거운데」"
],
"29912": [
"「나도 나 하나만으로",
"벅차니까...」"
],
"29913": [
"「같이 돌아가자」"
],
"29914": [
"「...그래」"
],
"29915": [
"「앞으로 딱 하루다.",
"살아남자고」"
],
"29916": [
"앞으로, 하루――"
],
"29917": [
"그건 어쩌면",
"타임 리미트일지도 모른다."
],
"29918": [
"（그때까지 어떻게든",
"범인을 어떻게 하지 않으면...）"
],
"29919": [
"（...못 돌아갈지도 몰라）"
],
"29920": [
"「...이치야나기 님」"
],
"29921": [
"「어? 왜?」"
],
"29922": [
"「이런 걸 여쭙는 건",
"다소 실례일지도 모르겠습니다만」"
],
"29923": [
"「승산은 있으십니까?」"
],
"29924": [
"「...승산?」"
],
"29925": [
"「너, 사실 요행이랑",
"우연만으로 살고 있지 않냐」"
],
"29926": [
"「왜 갑자기",
"본모습으로 돌아가는 건데!?」"
],
"29927": [
"「아, 실례했습니다」"
],
"29928": [
"「시치미를 떼고 계시길래",
"얼마나 천연인가 싶어서요」"
],
"29929": [
"「시치미 떼는 건",
"아닌데...」"
],
"29930": [
"「...진심이십니까」"
],
"29931": [
"「어, 그러니까",
"승산이 뭔데?」"
],
"29932": [
"「범인한테 말이야!」"
],
"29933": [
"「놀라지 마!?",
"내가 왜 살아 있는지",
"신기해지잖아!」"
],
"29934": [
"「...너, 방금",
"왜일까 하고",
"생각하지 않았냐」"
],
"29935": [
"「아, 안 했어?」"
],
"29936": [
"「거짓말도",
"서투르시군요」"
],
"29937": [
"「그치만...",
"정말 승산 같은 거 없고」"
],
"29938": [
"「어느 세상에",
"구한 피해자를 불안에 빠뜨리는",
"명탐정이 있습니까」"
],
"29939": [
"「명탐정이 누군데!?」"
],
"29940": [
"「이치야나기 님 말고 누가",
"계시다고?」"
],
"29941": [
"「왜 내가!?」"
],
"29942": [
"「범인이랑 맞장 뜨는 건",
"이치야나기 님뿐입니다만!?」"
],
"29943": [
"「아니, 히오리도 있는데」"
],
"29944": [
"「그건 세컨드잖아」"
],
"29945": [
"「...됐다.",
"왠지 범인이 불쌍해졌어」"
],
"29946": [
"「그 후에 범인의 단서",
"같은 건 뭔가 있었습니까」"
],
"29947": [
"「...단서라기보다",
"검은 고양이나 벨 같은 거라면",
"잔뜩 있는데...」"
],
"29948": [
"「그런 건",
"보면 압니다」"
],
"29949": [
"「저기, 츠바키 군... 본색이...」"
],
"29950": [
"「정말 괜찮은 겁니까...",
"아직 며칠이나 여기 갇혀",
"있어야 하는데요?」"
],
"29951": [
"「...빨리 돌아가고 싶다」"
],
"29952": [
"「저는 이치야나기 님 덕분에",
"살았을 터입니다만」"
],
"29953": [
"「얘기하면 할수록 불안해지는",
"건 어째서입니까」"
],
"29954": [
"「그런 말 해도",
"살인범을 방해하는 건",
"태어나서 처음이고」"
],
"29955": [
"「나도",
"살인범한테 목숨 노려지는 건",
"태어나서 처음이라고!?」"
],
"29956": [
"「아, 그렇구나」"
],
"29957": [
"「...두통이 오기 시작했다, 야」"
],
"29958": [
"「아, 그런데",
"이치야나기 님?」"
],
"29959": [
"「보아하니 무사하신 것 같은데",
"범인한테서 보복 같은 건",
"당하지 않으셨습니까」"
],
"29960": [
"「그런 일 당했으면",
"나 벌써 죽었어...」"
],
"29961": [
"「반격당하면 죽는다는 건",
"이해하고 계시는군요」"
],
"29962": [
"「그, 그야...」"
],
"29963": [
"「그런데 왜 그렇게",
"위기감이 없으신 겁니까」"
],
"29964": [
"「...없어 보여?」"
],
"29965": [
"「티끌만큼도 없는 걸로밖에",
"안 보입니다만」"
],
"29966": [
"「이래 봬도 한가득",
"있는데」"
],
"29967": [
"「어디쯤에 말입니까」"
],
"29968": [
"「저택 안을 돌아다닐 때도",
"주변을 조심하고 있어」"
],
"29969": [
"「왜 진심으로 놀라는 건데」"
],
"29970": [
"「도저히 그렇게는",
"안 보였어서요」"
],
"29971": [
"「제대로 조심하고 있어.",
"이상한 발소리가 따라오지 않나",
"누가 쳐다보는 느낌은 없나」"
],
"29972": [
"「벽 얼룩이 무서운 모양은 아닌지",
"계단 오르내릴 때마다",
"계단 수가 바뀌지 않았는지...」"
],
"29973": [
"「무슨 학교 괴담이냐",
"그게!?」"
],
"29974": [
"「그치만 무서워...」"
],
"29975": [
"「지금 조심해야 할",
"종류의 공포가 아니잖아,",
"특히 뒤의 두 개!」"
],
"29976": [
"「앞의 건 괜찮구나」"
],
"29977": [
"「발소리나 이상한 시선은",
"당연히 위험하지.",
"범인일지도 모르잖아」"
],
"29978": [
"「이상한 소리 하지 마!?",
"귀신이나 범인 중 하나만으로도",
"충분한데...」"
],
"29979": [
"「지금은 범인으로 해 둬, 범인!",
"그보다 안 나와, 유령 같은 거!」"
],
"29980": [
"「이렇게 딱 봐도",
"나올 것 같은 건물에?」"
],
"29981": [
"「...나온다는 소문이",
"있을 뿐이지 안 나와」"
],
"29982": [
"「소문 있잖아~!」"
],
"29983": [
"「소문뿐이야!",
"난 본 적 없다고!」"
],
"29984": [
"「나, 보면 어떡하지」"
],
"29985": [
"「염불이라도 외워.",
"아, 진짜 피곤해...」"
],
"29986": [
"「...이치야나기 님..",
"아, 진짜 귀찮네」"
],
"29987": [
"「어째 무사히",
"살아 있는 것 같으니",
"괜찮겠지만」"
],
"29988": [
"「너 말이야」"
],
"29989": [
"「무방비하게 돌아다니면",
"제일 위험한 건 자기라는",
"자각... 없지?」"
],
"29990": [
"「위험하다니, 저기,",
"나보다 다른 사람들이」"
],
"29991": [
"「그 다른 사람들을 위해",
"범인 신경을 마구 긁고 있는 게",
"너라는 얘기야!」"
],
"29992": [
"「신경을 긁어...」"
],
"29993": [
"「안 긁었다고 할 셈이냐」"
],
"29994": [
"「...긁고 있겠지」"
],
"29995": [
"「긁고 있다고!",
"내가 범인이면 제일 먼저",
"뒤에서 찔렀을 거야!」"
],
"29996": [
"「찌, 찌르는 거야!?」"
],
"29997": [
"「찌르든 때리든",
"뭐든 상관없어」"
],
"29998": [
"「제발 자각해 주십시오.",
"이쪽 위가 아파",
"오니까 말입죠」"
],
"29999": [
"「말투가 엉망진창이",
"됐어...」"
],
"30000": [
"「네가 쓸데없는 걱정을",
"시키니까 그렇잖아!?」"
],
"30001": [
"「...뭐야?」"
],
"30002": [
"「아, 저기, 미안」"
],
"30003": [
"「...걱정해",
"줬구나...」"
],
"30004": [
"「기, 기분 탓이야」"
],
"30005": [
"「어, 저기, 그치만 방금",
"직접 말했...」"
],
"30006": [
"「기분 탓이라면",
"기분 탓인 거야!",
"잊어, 얼른!!」"
],
"30007": [
"「진짜",
"알다가도 모를 녀석...」"
],
"30008": [
"（츠바키 군만큼은 아닌 것",
"같은데...）"
],
"30009": [
"하지만 말하면 또 혼나니까",
"그만두자."
],
"30010": [
"시스템 정보를 저장하겠습니까?"
],
"30011": [
"『추리』를 종료하겠습니까?"
],
"30012": [
"모리모토 군, 버그 났어!!"
],
"30013": [
"（...궁금하긴 한데",
"역시 무서워...）"
],
"30014": [
"조, 좀 더 여유 있을 때",
"오자, 그게 좋겠어."
],
"30015": [
"식당은 자물쇠가 잠긴 채",
"닫혀 있다..."
],
"30016": [
"（멋대로 들어와서",
"미안해...）"
],
"30017": [
"지하 창고는 그 후로",
"자물쇠를 잠가 닫아 두었다..."
],
"30018": [
"쿠라이시 씨의 방에는",
"자물쇠가 잠겨 있다..."
],
"30019": [
"궤짝 방에는",
"자물쇠가 잠겨 있다..."
],
"30020": [
"시즈나 짱의 방은 자물쇠가 잠긴 채",
"닫혀 있다..."
],
"30021": [
"어디 가 볼까."
],
"30022": [
"（^ω^）"
],
"30023": [
"（현장 사진이나 메모 같은 걸",
"정리하는 게 좋으려나...）"
],
"30024": [
"（그러고 보니 히오리가 현장에서",
"말했던 사인 같은 것도",
"적어 두는 게...）"
],
"30025": [
"휴대폰과 수첩을 보다가",
"문득 형언할 수 없는 공포에",
"사로잡혔다."
],
"30026": [
"（...나는, 진심으로...）"
],
"30027": [
"（진심으로 범인이 누군지",
"생각하려는 걸까...?）"
],
"30028": [
"사람을 죽인 상대를 밝혀내려",
"하다니, 평소의 나라면",
"생각도 못 했을 텐데..."
],
"30029": [
"（내버려 두면",
"더 무서운 일이 될 테고..）"
],
"30030": [
"...그래.",
"추리나 탐정은 체질이 아니지만",
"내버려 두는 게 더 무서워."
],
"30031": [
"그러니까 어떻게든 해서",
"이런 걸 전부 끝내 버리면",
"무서운 것도 끝나고..."
],
"30032": [
"（그래도 탐정 같은 게",
"안 맞는 건 확실하지）"
],
"30033": [
"만약 범인이 누군지 알아도",
"정말 확신이 설 때까지는",
"입 다무는 게 좋겠다."
],
"30034": [
"（게다가 만약 확신이",
"선다 해도...）"
],
"30035": [
"모아 둔 자료가 틀렸기라도",
"하면, 범인에게 발목 잡히는",
"결과가 될 수도 있다."
],
"30036": [
"（특히 이 표...）"
],
"30037": [
"알리바이 표가 이상하게",
"되어 있으면 절대 곤란해.",
"히오리도 주의하라고 했고."
],
"30038": [
"（거짓일지도 모르는 상태로",
"두면 안 된다는 거지）"
],
"30039": [
