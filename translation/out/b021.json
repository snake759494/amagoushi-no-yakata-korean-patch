{
"11160": [
"「난 사무소라기보다",
"영화사 소속이다만」"
],
"11161": [
"「그래요?」"
],
"11162": [
"「요즘 젊은 녀석들은 모르나?",
"옛날엔 영화배우라 하면",
"대개 영화사 전속이었지」"
],
"11163": [
"「그 시절 주연급이던 사람들도",
"꽤 줄어버렸구먼」"
],
"11164": [
"「내킬 때 옛날 영화도",
"가끔은 봐 봐라.",
"옛날 배우는 대단하다고」"
],
"11165": [
"「아, 네.",
"그럴게요」"
],
"11166": [
"「가면 애호회라고",
"아세요?」"
],
"11167": [
"「서재에 회보가 있길래",
"뭔가 싶어서...」"
],
"11168": [
"「흐응...?",
"애호회라...」"
],
"11169": [
"「별의별 취미를 가진",
"놈들이 다 있구먼」"
],
"11170": [
"「신기 비버리지 음료는",
"평소에 사 드세요?」"
],
"11171": [
"「별로 안 사지...",
"멀쩡한 게 있긴 하냐?」"
],
"11172": [
"「저희 누나 말로는",
"기적적으로 맛있는 게",
"몇 개 있대요」"
],
"11173": [
"「기적이 안 일어나면 맛있는 걸",
"못 만드는 회사는 대체 뭐냐」"
],
"11174": [
"「...뭔가 잘못됐네요」"
],
"11175": [
"「왜 안 망하는지 원」"
],
"11176": [
"「그게...",
"일부에 열광적인",
"팬이 있는 것 같아서」"
],
"11177": [
"우리 누나라든가, 대학 선배라든가.",
"왠지 주변에 꽤 있다..."
],
"11178": [
"「그러고 보니 신제품 나오면",
"좋다고 사 오는 젊은 놈들이",
"꽤 있더라...」"
],
"11179": [
"「그건가, 일종의 도박 같은",
"재미가 있는 건가」"
],
"11180": [
"「그럴지도 몰라요」"
],
"11181": [
"「...요즘 젊은 놈들은",
"통 모르겠다...」"
],
"11182": [
"「이번 각본은 어떤 이야기",
"인가요?」"
],
"11183": [
"「이런 초반부만 있어서야",
"무슨 얘긴지 알 수가 없지」"
],
"11184": [
"「아...",
"역시 그렇군요」"
],
"11185": [
"「저기, 『백야』라는 비디오 영화",
"뒤풀이 때 일로 달리 기억나는 거",
"없으세요?」"
],
"11186": [
"「...글쎄다」"
],
"11187": [
"「전에 얘기한 거 말고라면",
"좀 걸리는 게 하나",
"생각나긴 했는데...」"
],
"11188": [
"「막판에 얼굴 내민 놈이,",
"『백야』랑은 상관없는",
"스태프였던 것 같은데...」"
],
"11189": [
"「...『모자 장수를 찾고 있다』는",
"식의 말을 했던 것 같거든」"
],
"11190": [
"「모자 장수...!」"
],
"11191": [
"「그럼, 모자 장수가",
"그 자리에...」"
],
"11192": [
"「똑똑히 들은 건 아니니까",
"틀림없다곤 못 한다」"
],
"11193": [
"「다른 놈들도 있었을 테니",
"물어봐라」"
],
"11194": [
"하지만 그 사람은 아마, 그 자리에",
"모자 장수가 있다고 생각한 거다."
],
"11195": [
"짐작만으로 상관없는 연극 뒤풀이",
"같은 데서 찾아다닐 리 없으니..."
],
"11196": [
"「쿠라이시 씨, 무지개빛 사랑의",
"가교라고 보신 적 있어요?」"
],
"11197": [
"「아, 뭐 당시엔 엄청",
"유행했으니까, 몇 번은 봤지」"
],
"11198": [
"「난 그런 애태우는 얘기는",
"별로 안 좋아하지만」"
],
"11199": [
"애태우는 이야기구나..."
],
"11200": [
"「마작 지옥 전설 아세요?」"
],
"11201": [
"「아아, 그거.",
"1편에서 야쿠자 역 했었지」"
],
"11202": [
"「네, 쿠라이시 씨 나오세요?」"
],
"11203": [
"「나오고 5분 만에 적 야쿠자한테",
"차째로 폭파당하지만」"
],
"11204": [
"「...처절한 역이네요」"
],
"11205": [
"「쿠라이시 씨,",
"『백사 살인사건』이란 얘기",
"읽어 보셨어요?」"
],
"11206": [
"「그게 뭐냐?",
"추리소설이냐?」"
],
"11207": [
"「다카토 엔지로의...」"
],
"11208": [
"「아아, 다카토냐.",
"그건 기억이 없는데,",
"아마 안 읽었을 거다」"
],
"11209": [
"「저기,",
"군소 전기라고",
"아세요?」"
],
"11210": [
"「군소...?」"
],
"11211": [
"「전기라면 전쟁 기록 전기냐?",
"무슨 전기냐 그게」"
],
"11212": [
"「게임이래요.",
"RPG라는 거」"
],
"11213": [
"「아, 딸내미가 자주 하는",
"텔레비전 게임 같은 거냐?」"
],
"11214": [
"「하지만 그런 요상한 제목은",
"들어본 적 없다」"
],
"11215": [
"「새벽의 하얀 장미라는",
"드라마 아세요?」"
],
"11216": [
"「이 바닥에 있으면 싫어도",
"아는 얘기다, 인마」"
],
"11217": [
"「근데 넌 방영하던 때엔",
"아직 꼬맹이였겠구나」"
],
"11218": [
"「쿠라이시 씨, 혹시 출연...」"
],
"11219": [
"「아니, 다행히 안 나왔다」"
],
"11220": [
"「다행히?」"
],
"11221": [
"「거기 나온 배우도 찍은 스태프도",
"업계에 남은 놈이 거의 없고",
"벌써 죽어버린 놈도...」"
],
"11222": [
"「아, 저, 그렇군요.",
"알겠어요」"
],
"11223": [
"왠지 무서운 얘기가 될 뻔했다..."
],
"11224": [
"「이 저택 꽤 오래됐죠」"
],
"11225": [
"「오래됐겠지...」"
],
"11226": [
"「이런 오래된 건물은",
"뭐랄까, 뭔가 나올 것 같지」"
],
"11227": [
"「뭐, 뭔가라니...」"
],
"11228": [
"「그러니까 한밤중에...」"
],
"11229": [
"「으아악!",
"이제 됐어요!!」"
],
"11230": [
"「쿠라이시 씨,",
"첫날 문 닫은 뒤로 식당에는",
"안 들어가셨죠」"
],
"11231": [
"「식당엔 안 들어갔다.",
"먹을 거 가지러 갈 때",
"부엌엔 들어갔지만」"
],
"11232": [
"「그렇죠」"
],
"11233": [
"「저기, 뒤뜰 우물 말인데요」"
],
"11234": [
"「...시체가 있었다는 거냐」"
],
"11235": [
"「네, 저기...",
"들여다보셨어요?」"
],
"11236": [
"「할 리가 있냐,",
"그런 고약한 짓을」"
],
"11237": [
"「그, 그렇죠」"
],
"11238": [
"「쿠라이시 씨 방에도 베란다는",
"없죠?」"
],
"11239": [
"「응? 아아, 없지.",
"건너편 방에만 있는 거잖아,",
"여자들 있는 쪽」"
],
"11240": [
"「그런가 봐요.",
"저희 방에도 없고요」"
],
"11241": [
"「없는 게 속 편하지.",
"그런 게 있으면 다른 방에서",
"이쪽으로 들어올 수 있잖냐」"
],
"11242": [
"「거실 밖에 테라스가",
"있잖아요」"
],
"11243": [
"「있었지.",
"그게 왜?」"
],
"11244": [
"「맑으면 기분 좋겠다",
"싶어서요...」"
],
"11245": [
"「비 와도 나쁘지 않았다.",
"담배 한 대 피우기엔」"
],
"11246": [
"「아, 그러고 보니 첫날 밤",
"거기서 담배 피우셨죠」"
],
"11247": [
"「꽤 운치 있었지.",
"지금은 맑아도 마음이",
"안 놓이겠지만...」"
],
"11248": [
"「여기 온실 굉장하죠」"
],
"11249": [
"「굉장하긴 한데,",
"식물이 너무 많지 않냐.",
"이상하게 자란 것도 있더라」"
],
"11250": [
"「길 잃을 것 같아요」"
],
"11251": [
"「아니, 길 잃는 건 너 정도다」"
],
"11252": [
"나를 대체 어떻게 보는 거야."
],
"11253": [
"「쿠라이시 씨, 부엌에 몇 번",
"들어가셨죠?」"
],
"11254": [
"「그래, 첫날엔...",
"식량 옮긴 뒤론 모른다」"
],
"11255": [
"「그 뒤로는 한 번도요?」"
],
"11256": [
"「안 들어갔다」"
],
"11257": [
"「쿠라이시 씨, 응접실에",
"들어가 보셨어요?」"
],
"11258": [
"「응접실?",
"아니, 들어간 적 없다」"
],
"11259": [
"「오락실엔 이것저것",
"놓여 있죠」"
],
"11260": [
"「그래, 이런 상황만 아니면",
"재밌어 보이는 방인데」"
],
"11261": [
"「다트 좋아하세요?」"
],
"11262": [
"「젊을 땐 꽤 잘했다고」"
],
"11263": [
"「와...",
"전 그런 거 영 젬병이에요」"
],
"11264": [
"「아, 둔해 보이긴 하지, 너」"
],
"11265": [
"「.....네」"
],
"11266": [
"「저기, 서재 말인데요」"
],
"11267": [
"「서재?",
"아, 난 들어간 적 없다」"
],
"11268": [
"「아, 그러세요」"
],
"11269": [
"「저기, 1층 창고 말인데요」"
],
"11270": [
"「창고라니, 너...",
"그런 데까지 일일이 안 봤다」"
],
"11271": [
"「쿠라이시 씨 방은",
"원래 객실일까요」"
],
"11272": [
"「아마 그렇겠지.",
"원래 누가 쓰던 방치곤",
"옷장도 서랍도 텅 비었으니」"
],
"11273": [
"「아무것도 없어요?」"
],
"11274": [
"「성냥도 라이터도 없다.",
"평소엔 어지간히",
"안 쓰는 모양이지」"
],
"11275": [
"「객실로라도 좀 쓴다면",
"수건 같은 거라도 어딘가",
"놓여 있을 법한데」"
],
"11276": [
"「그러게요.",
"이 저택 주인 말고는",
"거의 아무도 안 오나...」"
],
"11277": [
"「2층에 아무도 안 쓰는",
"객실 같지 않은 방이",
"있잖아요」"
],
"11278": [
"「어디 말이냐?",
"2층은 내 방이랑 변소밖에",
"안 들어가 봐서 모른다」"
],
"11279": [
"「2층 안쪽에 있는 광",
"아세요?」"
],
"11280": [
"「아니, 어딨는지도 모른다」"
],
"11281": [
"「시즈나 짱네 방 앞에",
"있는데요」"
],
"11282": [
"「그게 어쨌다고?」"
],
"11283": [
"위치도 모른다면야,",
"물어볼 게 없네..."
],
"11284": [
"「지하실에 내려가신 적",
"있으시죠」"
],
"11285": [
"「술 가지러 갔을 뿐이다.",
"보일러 같은 게 있는 쪽엔",
"안 가서 모른다」"
],
"11286": [
"「설마 싶지만,",
"누가 숨어 있진 않겠지」"
],
"11287": [
"「무서운 말 하지 마세요...」"
],
"11288": [
"「지하실 안쪽에",
"미로가 있었는데",
"알고 계셨어요?」"
],
"11289": [
"「지하 미로라고?",
"그런 게 있었냐」"
],
"11290": [
"「네, 뭔가 미로 같은 게」"
],
"11291": [
"「끝까지 보이는 그대로구먼, 이 집.",
"역시 조만간 뭔가 나온다」"
],
"11292": [
"「아, 안 나와도 돼요!!」"
],
"11293": [
"「마당에 있는 우물,",
"안을 들여다보신 적 있어요?」"
],
"11294": [
"「우물 그거,",
"막아 놓은 거 아니냐?」"
],
"11295": [
"「네, 뚜껑은 덮여 있었어요」"
],
"11296": [
"「있는 건 알았지만,",
"뚜껑 열어서까진 안 봤다」"
],
"11297": [
"「방 이름에",
"관한 건데요...」"
],
"11298": [
"「방 이름?",
"그러고 보니 이 저택 방 이름은",
"전부 추리작가라던가 그랬지」"
],
"11299": [
"「기모노랑 쌍둥이 언니 쪽이",
"뭔가 신나 하더라.",
"그리고 나스도」"
],
"11300": [
"「나스 씨가요?」"
],
"11301": [
"「그 녀석 의외로 책 읽는다.",
"나도 좀 놀랐지」"
],
"11302": [
"「저기, 지하실에 있던 큰",
"궤짝 말인데요...」"
],
"11303": [
"「궤짝?",
"그런 게 있었냐?」"
],
"11304": [
"「...츠바키 군이",
"그 안에 넣어져 있었어요」"
],
"11305": [
"「흐응, 고약한 짓이구먼」"
],
"11306": [
"「있었던 거 기억 안 나세요?」"
],
"11307": [
"「기억 안 난다.",
"지하엔 술 가지러 갔을 뿐이라",
"다른 건 볼일도 없었고」"
],
"11308": [
"「나스 씨가 마셔 버린 차,",
"부엌에 있던 건데 쿠라이시 씨도",
"같은 거 드셨어요?」"
],
"11309": [
"「어떤 거냐?」"
],
"11310": [
"「녹차요.",
"페트병에 든 거」"
],
"11311": [
"「아아, 그거면 안 마셨다.",
"냉장고에 녹차 있는 건 봤지만",
"찬 차는 보리차만 가져왔거든」"
],
"11312": [
"「나스 씨가 먹게 된",
"독약 말인데요...」"
],
"11313": [
"「역시 먼저 식량 챙겨 둔 게",
"정답이었다는 건가」"
],
"11314": [
"「...그럴지도 몰라요」"
],
"11315": [
"「그 녀석 경계심이 없어",
"보였으니까...」"
],
"11316": [
"「저기, 그 커다란 도끼요,",
"쿠라이시 씨는 어디 있던 건지",
"기억하세요?」"
],
"11317": [
"「도끼라...",
"본 기억은 있는데」"
],
"11318": [
"「계속 방에 틀어박혀 있어서,",
"확실히는 기억이 안 나는구먼」"
],
"11319": [
"「그 테루테루보즈,",
"효과 있으면 좋겠네요」"
],
"11320": [
"「...그게 뭐냐」"
],
"11321": [
"「어라?",
"못 보셨어요?」"
],
"11322": [
"「나스 씨가 거실 테라스에",
"매단 커다란 거요」"
],
"11323": [
"「아아, 그거 말이냐.",
"언제 그런 걸 만들었는지」"
],
"11324": [
"「첫날 밤이래요.",
"그러고 보니 쿠라이시 씨, 그때",
"거실에 내려가 계셨는데...」"
],
"11325": [
"「거기서 한 대 피울 땐",
"그런 거 없었다」"
],
"11326": [
"그렇구나, 나스 씨가 테라스에",
"그걸 매단 건 쿠라이시 씨가",
"거실을 나간 뒤인가..."
],
"11327": [
"「온실에 있던 『복수』라고",
"쓰인 종이 말인데요」"
],
"11328": [
"「그게 어쨌다고?」"
],
"11329": [
"「언제부터 있었을까",
"싶어서요...」"
],
"11330": [
"「그럼 나한테 물어도 소용없다,",
"온실엔 그때 처음",
"들어갔으니까」"
],
"11331": [
"「뭐, 여기 와서 저택 안을",
"돌아다닌 놈이 있었을 테니",
"다른 놈들한테 물어봐라」"
],
"11332": [
"「네, 그럴게요」"
],
"11333": [
"「온실에 놓여 있던 검은 고양이",
"말인데요」"
],
"11334": [
"「아아, 그거.",
"마다라이 녀석은 전혀",
"신경도 안 썼지만...」"
],
"11335": [
"「쿠라이시 씨는",
"위험하다고 생각하셨어요?」"
],
"11336": [
"「장난치곤 너무",
"질이 나쁘잖냐」"
],
"11337": [
"「마다라이는 말이지, 불리한 건",
"알아채도 머릿속에서 없던 일로",
"해 버리는 버릇이 있었거든」"
],
"11338": [
"안됐지만, 그렇게밖에 안 보이는",
"언행이 많은 사람이었지..."
],
"11339": [
"「여기 전화는 왜",
"밖이랑 안 통할까요?」"
],
"11340": [
"「부자가 취미로 가진 별장",
"같으니까, 일부러 세상과",
"격리해 둔 거겠지」"
],
"11341": [
"「그래도 외부 연락 수단이",
"하나도 없으면 긴급할 때",
"곤란하잖아요」"
],
"11342": [
"「지금이 딱 그렇지」"
],
"11343": [
"「나도 가끔 휴대폰 보는데",
"역시 전파가 안 닿는단다」"
],
"11344": [
"「제 것도요...」"
],
"11345": [
"「오락실 라디오, 쿠라이시 씨가",
"켜기 전에 누가",
"만진 사람 있었어요?」"
],
"11346": [
"「거기까진....",
"아니, 안 만졌을지도」"
],
"11347": [
"「내가 켰을 땐 스위치가",
"라디오가 아니라 카세트 쪽에",
"가 있었거든」"
],
"11348": [
"「카세트...」"
],
"11349": [
"「굳이 오락실에서 음악 듣던",
"놈은 기억에 없으니까」"
],
"11350": [
"「그 괘종시계 소리,",
"멈춰 있죠」"
],
"11351": [
"「아아, 마다라이가 시끄럽다고",
"불평해서 멈춘 거지, 아마」"
],
"11352": [
"「몇 시였더라.",
"분명 미사사기가 왔을 때",
"일이니까 3시쯤인가」"
],
"11353": [
"「3시요.",
"울리자마자 멈췄어요?」"
],
"11354": [
"「미사사기를 안내한 뒤,",
"집사가 멈추더라」"
],
"11355": [
"「시계보다 마다라이가 더",
"시끄럽다는 얼굴로 말이지」"
],
"11356": [
"...왠지 눈에 선하다."
],
"11357": [
"「온실에 놓여 있던",
"장난감 벨 말인데요」"
],
"11358": [
"「왜 그러냐?」"
],
"11359": [
"「쿠라이시 씨는",
"그게 뭐로 보였어요?",
"범종인지, 벨인지...」"
],
"11360": [
"「...뭐로라...",
"범종이라기보다 그냥 종인가」"
],
"11361": [
"「사람마다 보는 인상이",
"꽤 다르네요」"
],
"11362": [
"「그야 그렇겠지」"
],
"11363": [
"「온실에,",
"긴 못이 놓여 있었어요.",
"대못이라는 거」"
],
"11364": [
"「또 흉흉하구먼...",
"촬영소 소품실엔 꽤",
"굴러다니지만」"
],
"11365": [
"「연극에선 꽤 쓰거든.",
"축시 저주 장면 같은 데」"
],
"11366": [
"「...그런 식으로",
"쓰는 거군요...」"
],
"11367": [
"「온실에 이번엔 장갑이",
"놓여 있었어요.",
"하얀 여성용이었어요」"
],
"11368": [
"「장갑...장갑이라」"
],
"11369": [
"「왜 그러세요?」"
],
"11370": [
"「아니, 미사사기도 쌍둥이도",
"그런 거 안 끼고 있었고...」"
],
"11371": [
"「누군가의 소지품이었던",
"건 아니라는 거네요」"
],
"11372": [
"「온실에 손도끼가 있었어요」"
],
"11373": [
"「손도끼?」"
],
"11374": [
"「이 정도 크기의 도끼요」"
],
"11375": [
"「...그럼 저택 어딘가에",
"있던 걸지도 모르지」"
],
"11376": [
"「아니, 다들 짐이 꽤 있으니",
"못 가져올 크기도 아닌가」"
],
"11377": [
"「그러니까요...」"
],
"11378": [
"「온실에 또 물건이 늘었어요.",
"작은 울타리였는데요」"
],
"11379": [
"「울타리? 뭐 하는 울타리냐?」"
],
"11380": [
"「잘은 모르겠지만",
"원예 같은 데 쓰는 것 같아요」"
],
"11381": [
"「흐응, 그렇군...",
"별로 짐 안 되는 것들뿐이구먼」"
],
"11382": [
"「아령 쓰실 때 있으세요?」"
],
"11383": [
"「없다, 그런 거」"
],
"11384": [
"「그러고 보니 나스가",
"짊어지고 온 모양이더라」"
],
"11385": [
"「방에서 들고 있었어요」"
],
"11386": [
"「그 녀석 아마,",
"단련 그만두면 숨까지",
"멎어서 죽을 거다」"
],
"11387": [
"...갑자기 죽진 않겠지만",
"날뛸 것 같긴 하다..."
],
"11388": [
"「마다라이 씨 방에,",
"이상한 지팡이가 있었어요」"
],
"11389": [
"「뭐랄까, 마법사가",
"들고 있을 법한 모양이요」"
],
"11390": [
"「그게 뭐냐.",
"장식이냐?」"
],
"11391": [
"「보통 지팡이로 쓰기엔",
"좀 불편해 보이던데요」"
],
"11392": [
"「흐응?",
"뭘까」"
],
"11393": [
"「이 저택 여기저기에",
"그림이 걸려 있죠」"
],
"11394": [
"「응?",
"아아, 그러고 보니 이 방에도 있네」"
],
"11395": [
"「별로 신경 안 썼는데,",
"부잣집은 원래 이런 거겠지」"
],
"11396": [
"「주차장 차 말인데요...」"
],
"11397": [
"「아아, 나스랑 마다라이 거지」"
],
"11398": [
"「쿠라이시 씨는 직접",
"운전 안 하세요?」"
],
"11399": [
"「술이나 마시는 거 말곤",
"할 게 없어 보이는 데를",
"직접 운전해서 오겠냐」"
],
"11400": [
"「게다가 안 마셔도",
"강제로 차를 못 쓰게 해 주는",
"부지런한 바보 녀석까지 있고」"
],
"11401": [
"「...그건 범인이 처음부터",
"펑크 낼 생각이었을까요.",
"차가 몇 대 있었든」"
],
"11402": [
"「그야, 무슨 수를 써서라도",
"우릴 여기 가둬 두고 싶은 모양이니",
"차가 있으면 방해됐겠지」"
],
"11403": [
"「지하에, 저기...",
"뱀이 잔뜩 있었어요...」"
],
"11404": [
"「뱀? 어떤 뱀이냐?」"
],
"11405": [
"「뭔가 여러 가지 있었어요」"
],
"11406": [
"「여러 가지는 뭐냐...",
"뭐, 이런 저택 안에 독 있는",
"위험한 놈은 없을 것 같다만」"
],
"11407": [
"「그, 그렇죠?」"
],
"11408": [
"「뭐야, 무섭냐?",
"난 꼬맹이 땐 자주 맨손으로",
"잡아서 휘둘렀는데」"
],
"11409": [
"「휘둘러요...?」"
],
"11410": [
"「생물 보면 일단 만지고",
"괴롭히고 싶은 게 꼬맹이지」"
],
"11411": [
"「넌...",
"그런 타입은 아닌 것 같다만」"
],
"11412": [
"「고, 고양이는 만질 수 있어요」"
],
"11413": [
"「자랑거리냐 그게.",
"...개는?」"
],
"11414": [
"「개에 따라요.",
"어릴 때 쫓아다닌",
"녀석만은 좀...」"
],
"11415": [
"「안 되냐.",
"쫓기다가 물리기라도 했냐?」"
],
"11416": [
"「아뇨, 아마 개는",
"장난칠 생각이었던 것 같고",
"물리진 않았어요」"
],
"11417": [
"「흐응...",
"뭐, 큰 개한테 쫓기면",
"트라우마가 될 수도 있지만」"
],
"11418": [
"「...몰티즈",
"였는데요」"
],
"11419": [
"어이없음을 넘어 불쌍하다는 눈으로",
"쳐다봤다..."
],
"11420": [
"「부엌에 컵라면이 잔뜩",
"있죠」"
],
"11421": [
"「아아, 있었지.",
"야식으로 자주 먹는 게 잔뜩",
"쌓여 있던 거 기억난다」"
],
"11422": [
"「자주 드세요?」"
],
"11423": [
"「손이 안 가니까.",
"요즘은 인스턴트 종류도",
"늘었고...」"
],
"11424": [
"「자판기에서 파는 것도",
"있잖냐, 오뎅이니 죽이니」"
],
"11425": [
"「아, 있죠」"
],
"11426": [
"「꽤 맛있는 것도 있었는데",
"가끔 말도 안 되는 것도 있더라」"
],
"11427": [
"「맛없었다는",
"건가요?」"
],
"11428": [
"「맛이고 뭐고 안 먹었다.",
"생각해 봐라, 캔에 든 텐신항은",
"아무래도 무리가 있잖냐」"
],
"11429": [
"「머, 먹기 힘들겠네요」"
],
"11430": [
"「젊은 놈이 재밌다고 샀는데",
"뜨거워서 손으로 못 든다고",
"곤란해하더라...」"
],
"11431": [
"「누가 생각해 낼까요,",
"그런 이상한 건」"
],
"11432": [
"「그거 분명, 이상한 것만",
"만들기로 유명한 회사의",
"신제품이었다」"
],
"11433": [
"「뭐라더라,",
"신기 음료...가 아니지,",
"사명이 바뀌었던가」"
],
"11434": [
"「신기 비버리지요?」"
],
"11435": [
"「오, 그거다.",
"이상한 건 캔 주스만이",
"아니구먼, 그 회사」"
],
"11436": [
"「석궁 쏘는 법",
"아세요?」"
],
"11437": [
"「알 리가 있냐.",
"설마, 그런 흉흉한 게",
"이 저택에 있냐?」"
],
"11438": [
"「창고에...",
"아, 근데 정말 쏠 수 있는지는",
"모르겠지만요」"
],
"11439": [
"「흥, 장식이면 됐다만.",
"얼른 숨겨 두는 게",
"낫지 않겠냐?」"
],
"11440": [
"「복도에 놓여 있는",
"가구 말인데요...」"
],
"11441": [
"「모르세요?",
"나스 씨가 방해된다고",
"방에서 내놓은 거」"
],
"11442": [
"「뭘 하는 거야, 그 남자는...」"
],
"11443": [
"「쿠라이시 씨는 수면제",
"써 보신 적 있어요?」"
],
"11444": [
"「난 없다.",
"이 바닥엔 꽤 쓰는 놈이",
"있지만」"
],
"11445": [
"「그 녀석도 썼잖냐,",
"어, 미사사기」"
],
"11446": [
"「네, 상용한대요」"
],
"11447": [
"「...이 상황에 용케",
"먹을 생각이 드는구먼」"
],
"11448": [
"「네?",
"이런 상황이니까 오히려",
"평소보다 잠이 안 올 텐데요」"
],
"11449": [
"「난 그쪽이 고맙다.",
"살인자가 배회하는 곳에서",
"푹 자고 싶진 않거든」"
],
"11450": [
"「아, 그렇구나...」"
],
"11451": [
"그것도 그런가.",
"쿠라이시 씨는 특히 경계하니까,",
"더더욱일지도..."
],
"11452": [
"「쿠라이시 씨, 이거 마리모죠」"
],
"11453": [
"「...마리모구먼」"
],
"11454": [
"「내버려 둬도 될까요」"
],
"11455": [
"「어디 있었는지 모르지만 지금까지",
"멀쩡했으면 되지 않겠냐」"
],
"11456": [
"「근데 이렇게 울지도 움직이지도",
"않는 걸 키워서 재밌나」"
],
"11457": [
"「일단 어느 정도",
"자라긴 하지 않나요?」"
],
"11458": [
"「흐응?",
"한없이 커진다면",
"키워 보고 싶네」"
],
"11459": [
"나보다 커지면 꽤",
"무서울 것 같다..."
],
"11460": [
"「저, 저기...",
"붉은 카메오 이야기요...」"
],
"11461": [
"「아, 관심 같은 거 갖지 마라.",
"불러들이게 된다」"
],
"11462": [
"「역시 진짜 이야기예요!?」"
],
"11463": [
"「글쎄다...",
"난 확인해 본 적 없고」"
],
"11464": [
"「꼭 알고 싶다면",
"엮여 본 놈 소개해 줄 수도",
"있다만」"
],
"11465": [
"「어, 엮여 봤다니,",
"실물을 봤다든가...!?」"
],
"11466": [
"「아니, 실물일지도 모르는 걸",
"가졌던 놈의 지인이다」"
],
"11467": [
"「프로듀서인데,",
"그러고 보니 오컬트 특집도 자주",
"담당했었지...」"
],
"11468": [
"「네, 아, 저기, 괘, 괜찮아요,",
"사양할게요!!」"
],
"11469": [
"「그러냐?",
"마음 바뀌면 언제든 말해라」"
],
"11470": [
"안 바뀔 것 같다.",
"아니 바뀌고 싶지 않다."
],
"11471": [
"「온실 안쪽에 이게",
"숨겨져 있었어요」"
],
"11472": [
"「카세트?",
"뭐가 들었냐?」"
],
"11473": [
"「유리 깨지는 소리였어요」"
],
"11474": [
"「...그렇군」"
],
"11475": [
"「어쩐지 뭔가 먹먹한",
"이상한 소리다 했지.",
"효과음이었던 거구먼」"
],
"11476": [
"「이거, 뭔지 아세요?」"
],
"11477": [
"「응? 뭐냐 그건?」"
],
"11478": [
"「지하에 있었는데",
"뭔지 모르겠어요」"
],
"11479": [
"「흐응...",
"뜻을 모르겠구먼」"
],
"11480": [
"역시 모르는구나..."
],
"11481": [
"「응접실에 이상한 가면이",
"걸려 있죠」"
],
"11482": [
"「가면? 뭐냐 그건?」"
],
"11483": [
"「아, 못 보셨어요?」"
],
"11484": [
"「못 봤다, 그런 거.",
"어지간히 기괴한 게 아니면",
"봤어도 기억 못 할지 모르지만」"
],
"11485": [
"꽤 기괴한 가면이었으니까,",
"쿠라이시 씨는 못 본 건가."
],
"11486": [
"「오락실 라디오 데크에",
"이게 들어 있어서...」"
],
"11487": [
"「산사태 뉴스가",
"녹음돼 있었어요」"
],
"11488": [
"「뭐라고...?」"
],
"11489": [
"「그런데 저희가 라디오로",
"들은 뉴스랑 내용이",
"꽤 달라요」"
],
"11490": [
"「...흥, 그렇군.",
"범인의 불발탄이란 거냐」"
],
"11491": [
"「하긴, 그렇게 딱 맞춰서 진짜로",
"벼랑이 무너질 거라곤 못 믿지」"
],
"11492": [
"「그렇겠죠.",
"원래는 이걸 저희한테 들려서",
"속일 생각이었던 거라고...」"
],
"11493": [
"「...잘 모르겠구먼.",
"이 사건 범인, 용의주도한 건지",
"되는대로인 건지」"
],
"11494": [
"「일행 중에 나스 같은",
"비상식적인 근육이 섞였는데」"
],
"11495": [
"「그 바보, 산사태 현장까지",
"보러 갔잖냐.",
"안 무너졌으면 거기서 끝이다」"
],
"11496": [
"「그, 그래도 설마 범인도",
"걸어가는 사람이 있을 줄은",
"몰랐던 거 아닐까요?」"
],
"11497": [
"「...그렇다면 범인은,",
"나스가 그런 남자라는 걸",
"몰랐다는 건가」"
],
"11498": [
"「...그건...」"
],
"11499": [
"「만약, 내가 이 사건의",
"범인이었다면...」"
],
"11500": [
"「그 위험을 없애기 위해서라도",
"마다라이보다 나스부터",
"먼저 처리했을 거다」"
],
"11501": [
"「확실히 나스 씨만 없으면",
"거짓 뉴스만으로도 나머지는",
"여기 붙잡아 둘 수 있을지도...」"
],
"11502": [
"「근데 범인은 그러지 않았다.",
"즉, 나스가 그런 놈이란 걸",
"몰랐거나...」"
],
"11503": [
"「...아니면 마다라이부터 먼저",
"해치워야 할 이유가 있었거나다」"
],
"11504": [
"「마다라이 씨부터요?」"
],
"11505": [
"「누구부터 죽일지 정하는 건",
"범인 쪽이잖냐」"
],
"11506": [
"「자기한테 유리한 순서로",
"하는 게 당연하지」"
],
"11507": [
"「...죽이고 싶을 만큼 미운 상대가",
"어떤 사람인지 모른다는 건",
"이상할 테니까요...」"
],
"11508": [
"「나도 그렇게 생각한다.",
"하지만 마다라이가 먼저여야 할",
"이유는 생각이 안 나는구먼」"
],
"11509": [
"「저기, 이 꽃이 뭔지",
"아시겠어요?」"
],
"11510": [
"「꽃? 뭐냐 이건?」"
],
"11511": [
"「온실의 『복수』 종이 있는 데",
"뜯어서 놓여 있었어요」"
],
"11512": [
"「흐응...?",
"뭐, 아무 의미 없이",
"놓진 않았겠지만...」"
],
"11513": [
"「난 보기만 해선",
"무슨 꽃인지 모르겠다」"
],
"11514": [
"「저기, 임프라고 아세요?",
"뭔가 작은 악마 같은 거",
"라던데요」"
],
"11515": [
"「뭐냐 갑자기?」"
],
"11516": [
"「나스 씨가, 산길 수풀 속에",
"서 있던 차 안에 그런",
"장식이 매달려 있었대요」"
],
"11517": [
"「차에...?",
"대단한 취미구먼 그거」"
],
"11518": [
"「꽤 별난 사람",
"같죠...」"
],
"11519": [
"「...그렇다만,",
"그런 걸 매달 법한 놈이라면",
"짚이는 데가 있다」"
],
"11520": [
"「누구요?」"
],
"11521": [
"「시쿠라다.",
"그 녀석은 그런 기분 나쁜 걸",
"좋다고 모아댔으니까」"
],
"11522": [
"「오컬트 마니아라는 거다.",
"서양이고 일본이고 안 가렸지」"
],
"11523": [
"「저기, 방 열쇠에 뭔가",
"글자가 새겨져 있지 않나요?」"
],
"11524": [
"「글자?」"
],
"11525": [
"「...아아, 이거냐.",
"『A』 같구먼」"
],
"11526": [
"「A네요.",
"감사합니다」"
],
"11527": [
"「뭐냐?",
"그러고 보니 방 이름이랑 전혀",
"상관없는 글자로구먼」"
],
"11528": [
"「다른 방도 그런가 봐요.",
"무슨 암호라던가...」"
],
"11529": [
"「흐응?",
"저택 주인 취미 같은 건가」"
],
"11530": [
"「그럴지도 몰라요」"
],
"11531": [
"「흐응?",
"뭐, 아무래도 좋다만」"
],
"11532": [
"「쿠라이시 씨, 휴대폰",
"가져오셨던가요」"
],
"11533": [
"「갖고는 있다만,",
"안 터진다」"
],
"11534": [
"「뭐, 내 건 사진도 안 찍히는",
"구형이라 더 안 터지는",
"걸지도 모르지만」"
],
"11535": [
"「문자도 안 돼요?」"
],
"11536": [
"「그런 게 달려 있어도",
"어차피 못 익힌다」"
],
"11537": [
"「...딸내미는 달아라 달아라",
"성화다만...」"
],
"11538": [
"쿠라이시 씨는 드물게 곤란한 듯한",
"얼굴로 한숨을 쉬었다."
],
"11539": [
"「쿠라이시 씨는 여기까지",
"택시로 오셨던가요」"
],
"11540": [
"「그래, 역에서」"
],
"11541": [
"「다만 난 전 일 때문에 규슈에",
"있어서 다른 놈들이랑은",
"반대쪽에서 왔지」"
],
"11542": [
"「그러셨어요?」"
],
"11543": [
"「...그래서인가.",
"역 앞 택시 승강장에서도",
"다른 놈은 못 봤다」"
],
"11544": [
"「상행이랑 하행이라, 역에",
"도착한 시간이 달랐겠지」"
],
"11545": [
"「저기, 이상한 걸 묻는데요",
"아카시야키 좋아하세요?」"
],
"11546": [
"「...정말 뜻 모를",
"질문이구나, 너」"
],
"11547": [
"「죄송해요」"
],
"11548": [
"「싫진 않다만,",
"난 보통 다코야키가",
"더 좋다」"
],
"11549": [
"「...그래서, 그게",
"어쨌다고?」"
],
"11550": [
"「아뇨, 저기,",
"딱히 의미는 없어요」"
],
"11551": [
"「뭐냐 그게?",
"이상한 소리 하지 마라,",
"먹고 싶어지잖냐」"
],
"11552": [
"「네, 넷」"
],
"11553": [
"「손반죽 햄버그",
"만드실 줄 아세요?」"
],
"11554": [
"「엉?」"
],
"11555": [
"「아, 아뇨, 딱히 사건이랑은",
"상관없는데요」"
],
"11556": [
"「...있어도 싫다",
"그런 영문 모를 게」"
],
"11557": [
"「공교롭게도 요리는 카레 정도밖에",
"못 만든다」"
],
"11558": [
"「아게다시 두부",
"좋아하세요?」"
],
"11559": [
"「뭐냐, 갑자기?」"
],
"11560": [
"「히오리가 잘 만든다고",
"했거든요」"
],
"11561": [
"「기모노가?",
"손재주 좋구먼, 그 녀석」"
],
"11562": [
"「근데 두부 같은 게",
"여기 있었나?」"
],
"11563": [
"「없는 것 같아요,",
"아쉽게도」"
],
"11564": [
"「쳇...",
"그럼 산 내려가서",
"얻어먹는 수밖에 없구먼」"
],
"11565": [
"「지역 술 가져갈 테니",
"만들라고 전해라」"
],
"11566": [
"「네, 전할게요」"
],
"11567": [
"「쿠라이시 씨는 하루에",
"담배 얼마나 피우세요?」"
],
"11568": [
"「두 갑 정도 아닐까.",
"왜?」"
],
"11569": [
"「저희 부모님이 하루 한 갑쯤",
"피우셔서 다른 사람은",
"어떤가 해서요」"
],
"11570": [
"「한 갑 정도면",
"적은 편이지」"
],
"11571": [
"「그렇군요.",
"그러고 보니 선배 중엔 하루 세 갑",
"피우는 사람도 있어요」"
],
"11572": [
"「세 갑이라...",
"가끔 피워 버리지」"
],
"11573": [
"「대본 막 받아서",
"외우는 중일 때라든가」"
],
"11574": [
"「그럴 땐",
"개비 수가 늘어요?」"
],
"11575": [
"「뭔가 생각하거나",
"집중하고 싶을 때가",
"제일 늘지」"
],
"11576": [
"「지하 와인",
"맛있었어요?」"
],
"11577": [
"「역시 좋은 게",
"놓여 있더라」"
],
"11578": [
"「아직 남았으니까",
"마시고 싶으면 얻어 와라」"
],
"11579": [
"「아, 전 술 못 마셔요」"
],
"11580": [
"「너, 보이는 그대로구나」"
],
"11581": [
"「네, 네에」"
],
"11582": [
"「저기...",
"사다리 좋아하세요?」"
],
"11583": [
"「태어나서 처음",
"들어 본다, 그런 질문」"
],
"11584": [
"「좋다 싫다를",
"논할 물건이",
"아니잖냐...」"
],
"11585": [
"「저도 그렇게 생각은",
"하는데요...」"
],
"11586": [
"근데 왠지 좋아하는 사람이",
"있다는 것 같단 말이지.",
"여기 당주라든가..."
],
"11587": [
"「광에 하얀 양산이 넣어져",
"있었는데요」"
],
"11588": [
"「양산이라...",
"난 우산 자체를 안 좋아해서」"
],
"11589": [
"「맑은 날까지",
"우산 쓰려는 여자 마음은",
"잘 모르겠다」"
],
"11590": [
"「햇볕에 타기 싫어서",
"아닐까요?」"
],
"11591": [
"「이치를 모르는",
"건 아니다」"
],
"11592": [
"「그냥, 귀찮은 걸",
"잘도 한다 싶을 뿐이지.",
"화장 같은 것도 그렇고...」"
],
"11593": [
"「...근데, 마누라한테",
"그렇게 말하면 어이없어하더라」"
],
"11594": [
"쿠라이시 씨 부인은 어떤 사람",
"일까...",
"좀 보고 싶다."
],
"11595": [
"「쿠라이시 씨, 분명",
"와인 가져오셨죠.",
"잔도 가져오셨어요?」"
],
"11596": [
"「잔이라기보다,",
"찻잔이면 빌렸다만」"
],
"11597": [
"「차, 찻잔이요?」"
],
"11598": [
"「한 번 쓴 거였으니까",
"뭐, 안전하겠다 싶어서」"
],
"11599": [
"일단, 여기엔 잔은",
"없는 것 같다."
],
"11600": [
"「쿠라이시 씨, 히오리를",
"전부터 아셨어요?」"
],
"11601": [
"「그 기모노 말이냐?",
"뭐, 이 중에선 자주",
"얼굴 보는 편이지」"
],
"11602": [
"「그렇군요」"
],
"11603": [
"「보다시피 묘하게 붙임성 좋고",
"어째 따라붙기도 하고...」"
],
"11604": [
"「...?",
"왜 그러세요?」"
],
"11605": [
"「그 녀석 말이지, 아마",
"배려하는 게 서툰 거겠지」"
],
"11606": [
"「배려요?」"
],
"11607": [
"「눈치는 빠른 편이다.",
"다만 그 방향이 가끔",
"묘한 데를 향한달까...」"
],
"11608": [
"「아니, 그것만은",
"아닐지도 모르지만」"
],
"11609": [
"「애초에 왜 맨날",
"기모노인지도 모르겠고」"
],
"11610": [
"「방송국이나 대기실에서도",
"그 차림이에요?」"
],
"11611": [
"「처음엔 의상인 줄 알았는데",
"언제 봐도 그렇더라」"
],
"11612": [
"「그런 놈은 누가 봐도",
"괴짜겠지」"
],
"11613": [
"「그, 그렇네요」"
],
"11614": [
"「뭐, 본인은 남의 눈 같은 건",
"신경 안 쓰는 모양이다만」"
],
"11615": [
"「...싫진 않다만",
"그런 어딘가 바보 같은 놈은」"
],
"11616": [
"「요즘 젊은 것들은",
"체면 차리는 착한 애들",
"뿐이라 재미없거든」"
],
"11617": [
"「쿠라이시 씨는 마다라이 씨를",
"잘 아세요?」"
],
"11618": [
"「좋아서 아는 것도",
"아니다만」"
],
"11619": [
"「서로 오래 있다 보니,",
"자주 마주칠 뿐이지」"
],
"11620": [
"「뭐, 경력 긴 것만",
"자랑인 아저씨니까」"
],
"11621": [
"「얘기해도 재미없고",
"관심도 없다」"
],
"11622": [
"사이가 나쁜가 보다..."
],
"11623": [
"「츠바키 군은,",
"전부터 아셨어요?」"
],
"11624": [
"「그래, 좀 전에 무슨",
"드라마 나온 걸 봤으니까」"
],
"11625": [
"「직접은...아니, 한 번 있었나.",
"출연 장면이 달라서 말은 못 했지만",
"같은 비디오 영화에 나왔었지」"
],
"11626": [
"「소질은 있는 것 같다만,",
"좀 너무 힘이 들어갔어, 그건」"
],
"11627": [
"「평소에도 배역 그대로인",
"거 말씀이세요?」"
],
"11628": [
"「뭐, 젊을 땐 이것저것",
"시행착오하는 법이다」"
],
"11629": [
"쿠라이시 씨는 조금 흐뭇한 듯",
"웃음을 참았다."
],
"11630": [
"「나스 씨는 저기...",
"평소에도 저래요?」"
],
"11631": [
"「...뭐, 가끔은 저런 배우가",
"있어도 되지 않겠냐」"
],
"11632": [
"몹시 복잡한 얼굴로,",
"스스로 타이르듯 중얼거린다."
],
"11633": [
"더 캐물으면",
"왠지 내가 혼날 것 같다..."
],
"11634": [
"「저기, 스즈나 짱은...」"
],
"11635": [
"「아, 어느 쪽이냐?",
"동생 쪽이었나?」"
],
"11636": [
"「네」"
],
"11637": [
"「그럼, 입 험한 쪽이구먼」"
],
"11638": [
"「험해요?」"
],
"11639": [
"「딱 부러지게 말하는 성격이겠지.",
"난 싫지 않다만」"
],
"11640": [
"「...근데, 입 안 열면",
"겉보곤 구분이 안 가, 그것들」"
],
"11641": [
"「저도 구분 못 해요...」"
],
"11642": [
"「시즈나 짱은, 여기서 만나기 전에",
"만나 보신 적 있어요?」"
],
"11643": [
"「마주 보고 얘기한 건 아마",
"처음일 거다만...」"
],
"11644": [
"「한 번, 나온 연극을 봐서",
"기억은 하고 있었지.",
"잘했거든, 그 나이에」"
],
"11645": [
"「시즈나 짱, 잘하는군요」"
],
"11646": [
"「그 애는 장래가 기대된다.",
"대단한 여배우가 될지도 몰라」"
],
"11647": [
"「쿠라이시 씨는 평소에 어떤",
"연기에 출연하세요?」"
],
"11648": [
"「엉?",
"어떤 거고 뭐고 난 그냥",
"단역 배우다」"
],
"11649": [
"「단역...?」"
],
"11650": [
"「이름 붙은 역은",
"좀처럼 안 돌아온다는 거지」"
],
"11651": [
"그렇게 말하면서도 쿠라이시 씨는",
"어딘가 자랑스러운 얼굴이었다."
],
"11652": [
"그만큼 자기 일에 자신이나",
"자부심이 있다는 걸까."
],
"11653": [
"「...그래도, 많이",
"출연하셨잖아요」"
],
"11654": [
"「저도 어디선가 본 적 있는",
"분이란 생각이 바로 들었고요」"
],
"11655": [
"「뭐, 수로만 치면」"
],
"11656": [
"「저기, 그게...",
"이런 걸 묻는 건 실례지만」"
],
"11657": [
"「이소마에다」"
],
"11658": [
"「이소마에 다다히코.",
"한 번만 말한다」"
],
"11659": [
"「아, 넷!」"
],
"11660": [
"「...어떻게 아셨어요?",
"제가 이름 물으려던 거...」"
],
"11661": [
"「너, 얼굴에 너무 드러나」"
],
"11662": [
"「....네」"
],
"11663": [
"그렇게 알기 쉬운가",
"나란 사람..."
],
"11664": [
"「미사사기 씨는",
"전부터 아셨어요?」"
],
"11665": [
"「그래, 몇 번 같은 연극에 나왔지」"
],
"11666": [
"「더 떠도 되는 여배우인데,",
"묘하게 조촐한 지방 극장에서만",
"만난단 말이지...」"
],
"11667": [
"「무대 일을 좋아하시나요?」"
],
"11668": [
"「그럴지도.",
"욕심이 없는 건가...」"
],
"11669": [
"쿠라이시 씨는 갸웃거렸다."
],
"11670": [
"「쿠라이시 씨는 나구모 씨가",
"어디 배우인지 아세요?」"
],
"11671": [
"「다키 프로라고 했지.",
"다키 프로의 누군지는 모른다만」"
],
"11672": [
"「뭐, 다키 프로면 대개 아니까",
"네가 나구모가 아닌 건 안다」"
],
"11673": [
"「네, 네.",
"전 아니에요」"
],
"11674": [
"「안다니까」"
],
"11675": [
"「쿠라이시 씨는 모자 장수가",
"누구라고 생각하세요?」"
],
"11676": [
"「글쎄다, 관심 없으니까」"
],
"11677": [
"「없으세요?",
"누군지 모르는데도요?」"
],
"11678": [
"「지금까지 연극은 일단 다 봤는데",
"각본은 재밌으니까」"
],
"11679": [
"「어디 누가 썼든",
"그딴 건 아무래도 좋다」"
]
}