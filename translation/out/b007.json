"4155": [
"「아, 벌써 먹었어요」"
],
"4156": [
"「그래, 식욕은 제대로 있구나.",
"나도 뭐 좀 먹을까...」"
],
"4157": [
"「그럼 저는 이만 가 볼게요.",
"실례했습니다」"
],
"4158": [
"「오우, 그럼 가 봐」"
],
"4159": [
"（일단 히오리한테",
"가 볼까...）"
],
"4160": [
"「왜 그러세요?」"
],
"4161": [
"「아니, 내가",
"보일러 껐나 싶어서」"
],
"4162": [
"「네!?」"
],
"4163": [
"「왠지 끈 기억이...」"
],
"4164": [
"「켜, 켜 둔 채예요?」"
],
"4165": [
"「어땠더라.",
"잠깐 보고 올게」"
],
"4166": [
"「네, 네에, 그럼 저도",
"이만...」"
],
"4167": [
"「응, 미안해.",
"그럼」"
],
"4168": [
"나스 씨는 우당탕 복도를",
"달려가 버렸다..."
],
"4169": [
"（...음.",
"어떡하지...）"
],
"4170": [
"일단 나도 1층으로 내려갈까.",
"다른 사람들도 내려올 시간이고,",
"오락실에라도 가 볼까."
],
"4171": [
"「...아, 아차」"
],
"4172": [
"「보일러 끄는 걸 깜빡한 것 같아.",
"미안, 다녀올게!」"
],
"4173": [
"「어, 아...」"
],
"4174": [
"순식간에 나스 씨는 달려서",
"방을 나가 버렸다."
],
"4175": [
"「...음」"
],
"4176": [
"남의 방에 혼자 있어 봐야 소용없고",
"일단 나가자..."
],
"4177": [
"（어쩌지...",
"일단 1층에 내려가서 다른 사람들",
"일어났는지 찾아볼까...）"
],
"4178": [
"「...슬슬 오락실에",
"가 볼까요」"
],
"4179": [
"「그럼 먼저 가 계세요.",
"저는 이 책 정리하고 갈게요」"
],
"4180": [
"（...으스스하네...）"
],
"4181": [
"땅 밑에 있다고 생각만 해도",
"왠지 위층보다 어두운",
"것 같은 기분이 든다."
],
"4182": [
"「아무도 없, 겠지...」"
],
"4183": [
"스스로에게 확인하듯 중얼거리며",
"살금살금 발을 내딛는다."
],
"4184": [
"당연히 대답 같은 건 없다.",
"음침한 정적이 그저",
"이어질 뿐이다..."
],
"4185": [
"（지하실이란 말은 울림만으로도",
"왠지 무섭단 말이지...）"
],
"4186": [
"왜 이런 곳에 혼자",
"들어와 있는 거지, 나는...?"
],
"4187": [
"쓰윽, 핏기가 가시는 동시에",
"점점 정신이 든다."
],
"4188": [
"「저, 저기... 실례했습니다...」"
],
"4189": [
"역시 돌아가자.",
"얼른 나가서, 1층으로 돌아가서..."
],
"4190": [
"「........?」"
],
"4191": [
"뒷걸음치려던 순간,",
"시야 한구석에 뭔가가 비쳤다."
],
"4192": [
"（...뭔가, 방금...",
"뭔가가 신경 쓰였던 것 같은...）"
],
"4193": [
"뭔지 확실히 안 건 아니다.",
"그저 왠지 시야 구석에 위화감",
"같은 걸 느꼈을 뿐이라..."
],
"4194": [
"（기, 기분 탓일지도...）"
],
"4195": [
"（아마... 기분 탓일 거야,",
"그렇겠지만...）"
],
"4196": [
"「왜!?",
"왜, 츠바키 군의...!!」"
],
"4197": [
"같은 색일 뿐일지도 몰라.",
"츠바키 군 것이 아닐지도 몰라."
],
"4198": [
"그렇다 해도 옷만 무슨 이유로",
"여기 넣어 둔 걸지도 몰라."
],
"4199": [
"「그, 그래도...!!」"
],
"4200": [
"필사적으로 부정하려 하는데."
],
"4201": [
"가장 싫은 생각만이",
"머릿속에서 떠나 주지 않는다."
],
"4202": [
"「그런...!",
"그럴 리 없는, 데...!!」"
],
"4203": [
"무의식중에 발이 뒤로 물러났다.",
"문 모서리에 어깨를 부딪치고",
"구르듯 지하실을 나왔다."
],
"4204": [
"「그럴 리 없다니까...!!」"
],
"4205": [
"「――우왓!?」"
],
"4206": [
"「뭐...」"
],
"4207": [
"계단을 뛰어 올라간 곳에서",
"나스 씨와 부딪쳤다."
],
"4208": [
"「왜, 왜 그러니?",
"얼굴이 새파랗잖아?」"
],
"4209": [
"「츠... 츠바키, 군...」"
],
"4210": [
"「츠바키 군, 이, 아니야... 라고,",
"아니라고...!!」"
],
"4211": [
"「아니라니, 뭐가?",
"츠바키 군이라면 방에도 없어서",
"나도 지금 찾고...」"
],
"4212": [
"「아니니까!",
"그럴 리 없으니까...!!」"
],
"4213": [
"「지, 진정해 진정해.",
"대체 무슨 일이야?",
"지하에 뭐가 있었어?」"
],
"4214": [
"「으....」"
],
"4215": [
"「있구나?",
"알았어, 보고 올게!!」"
],
"4216": [
"「아, 기... 기다려요!!",
"나스 씨!!」"
],
"4217": [
"「아니에요!",
"분명 아닐 거니까...!!",
"츠바키 군이 아니라고요..!!」"
],
"4218": [
"스스로도 영문 모를 소리를",
"하며, 뛰어 내려간",
"나스 씨의 뒤를 쫓는다."
],
"4219": [
"「....?",
"츠바키 군은 안 보이는데」"
],
"4220": [
"「그치만... 아니라니까.",
"같은 색일 뿐이야, 분명...」"
],
"4221": [
"「같은 색? 뭐가?」"
],
"4222": [
"「나고무 군?",
"이봐, 괜찮아?」"
],
"4223": [
"「나고 씨?",
"거기 있어요?」"
],
"4224": [
"「...히오리!!」"
],
"4225": [
"「아아, 여기 있었네.",
"무슨 일이에요, 복도에서 뭔가",
"소란 피우지 않았어요?」"
],
"4226": [
"「아니, 그게 아까부터",
"츠바키 군이 아니라느니, 같은 색",
"이라느니 알 수 없는 소리를 해서」"
],
"4227": [
"「그치만, 그럴 리 없잖아!",
"그렇지, 히오리? 아니지!?」"
],
"4228": [
"「같은 색이라니...」"
],
"4229": [
"「....히오리.....」"
],
"4230": [
"「저거 말인가요」"
],
"4231": [
"좀처럼 없을 만큼 험악해진 히오리의",
"눈이 어디를 보고 있는지..."
],
"4232": [
"여기서 그걸 확인할 수는",
"없어도, 알 수 있었다."
],
"4233": [
"「...으... 응」"
],
"4234": [
"「무슨 얘기야?」"
],
"4235": [
"「나스 씨, 미안하지만...",
"그 궤짝, 열어 봐 주겠어요?」"
],
"4236": [
"「궤짝? 이거?」"
],
"4237": [
"「그거요」"
],
"4238": [
"궤짝 뚜껑이 삐걱이는 소리를 낸다."
],
"4239": [
"「으아아아아악!?」"
],
"4240": [
"「...나고 씨,",
"유감이지만....」"
],
"4241": [
"「...히오리.....」"
],
"4242": [
"올려다보니 히오리는 비통한 얼굴로",
"한숨을 내쉬었다."
],
"4243": [
"「...같은 색일, 뿐.. 이",
"아니네요....」"
],
"4244": [
"「잠... 모, 모두,",
"다른 사람들 불러올게...!」"
],
"4245": [
"「이봐, 누구 없어!!",
"다들, 와 줘~!!」"
],
"4246": [
"소리치며 나스 씨가 계단을",
"뛰어 올라갔다."
],
"4247": [
"「정말로....",
"죽어 버린 거야....?」"
],
"4248": [
"「츠바키 군, 인 거야...?」"
],
"4249": [
"「...네」"
],
"4250": [
"고개를 끄덕이더니 히오리는 천천히",
"궤짝 쪽으로 걸어가기 시작했다."
],
"4251": [
"나는 이제 도망칠 기력도 없이",
"히오리를 따라가서..."
],
"4252": [
"「......츠바키 군...」"
],
"4253": [
"아니라고 믿고 싶었던 현실을",
"보고 말았다..."
],
"4254": [
"다들 모여든 듯한 목소리가",
"등 뒤에서 들렸지만, 거의 귀에",
"들어오지 않는다."
],
"4255": [
"「이봐, 누구...!!",
"누가 좀 와 줘...!!」"
],
"4256": [
"「나스 씨...!?」"
],
"4257": [
"어디선가 나스 씨의 큰 소리가 난다.",
"게다가 왠지 심상치 않은 모양이다."
],
"4258": [
"（그렇게 허둥댈",
"사람이 아닌데...）"
],
"4259": [
"묘하게 불길한 예감이 들어",
"소리 나는 쪽으로 달려갔다."
],
"4260": [
"「나스 씨?",
"거기예요?」"
],
"4261": [
"「아아, 나고무 군이구나!",
"와 줘, 츠바키 군이!!」"
],
"4262": [
"멈춰 설 틈도 없이 나스 씨 손에",
"지하실 안쪽으로 떠밀린다."
],
"4263": [
"「.....!!」"
],
"4264": [
"가장 먼저 눈에 들어온 건",
"츠바키 군이 늘 입고 있던 것과",
"같은 윗옷의 색이었다."
],
"4265": [
"그것은 어째선지 커다란 궤짝",
"안에 담겨 있었고..."
],
"4266": [
"「...츠바키, 군....?」"
],
"4267": [
"...거짓말이다."
],
"4268": [
"가장 먼저 머리에 떠오른 건",
"마음 깊은 곳에서의 부정이었다."
],
"4269": [
"하지만..."
],
"4270": [
"「츠.. 츠바키... 군...」"
],
"4271": [
"「...어, 째서...」"
],
"4272": [
"이미 살아 있지 않다는 건",
"한눈에 알 수 있었다..."
],
"4273": [
"휘청, 풍경이 일그러진 순간",
"뒤에서 누군가 받쳐 주었다."
],
"4274": [
"「괜찮아요?」"
],
"4275": [
"「히오리....」"
],
"4276": [
"「츠... 츠바키 군, 이」"
],
"4277": [
"「알아요,",
"말 안 해도 되니까.",
"서 있을 수 있어요? 새파래요」"
],
"4278": [
"「...괜찮아」"
],
"4279": [
"고개를 끄덕이고 앞을 바로 본 순간."
],
"4280": [
"다시, 처참하게 변한 츠바키 군의",
"모습이 눈에 뛰어든다..."
],
"4281": [
"등 뒤에서 꺄악, 하고 누군가",
"비명을 지른 것이 유난히 먼 일처럼",
"들렸다."
],
"4282": [
"머리는 몹시 어질어질한데,",
"아무리 해도 츠바키 군 쪽에서",
"눈을 뗄 수가 없다..."
],
"4283": [
"「...아무도 없지」"
],
"4284": [
"온실 안은 습기 탓인지 왠지",
"공기가 무겁게 느껴졌다."
],
"4285": [
"조금만 안쪽까지 들어가서,",
"살며시 그 『복수』 종이가 있는",
"근처를 들여다본다..."
],
"4286": [
"누군가가 들어와서 그 못을",
"두고 간 거다..."
],
"4287": [
"（...고양이는, 마다라이 씨――）"
],
"4288": [
"어째선지 시즈나 짱의 말이",
"머리에 떠올랐다."
],
"4289": [
"（검은 고양이...",
"그리고, 벨...）"
],
"4290": [
"（그럼, 저 못은...?）"
],
"4291": [
"이건... 알려야 해.",
"모두에게 알리는 게 좋겠어...!"
],
"4292": [
"허둥지둥 온실을 뛰쳐나와",
"저택으로 달려 돌아갔다."
],
"4293": [
"「이봐, 나고무 군~!!」"
],
"4294": [
"「나스 씨...?」"
],
"4295": [
"저택에 뛰어든 순간, 나스 씨의",
"큰 목소리가 들렸다."
],
"4296": [
"무슨 일일까...",
"평소엔 저렇게 다급한",
"목소리를 낼 사람이 아닌데..."
],
"4297": [
"「나스 씨~?",
"무슨 일이에요~?」"
],
"4298": [
"「아아, 나고무 군!",
"겨우 왔구나!」"
],
"4299": [
"「뭐, 뭔데요?」"
],
"4300": [
"「됐으니까 와 줘!",
"다들 벌써 모여 있어!」"
],
"4301": [
"「네? 저기...」"
],
"4302": [
"다짜고짜 지하실로",
"끌려간다."
],
"4303": [
"「무, 무슨 일이야?",
"다들 모여서...」"
],
"4304": [
"어둡게 가라앉은 얼굴을 한 채",
"히오리는 나를 손짓해 불렀다."
],
"4305": [
"서로 몸을 붙이고 있던",
"쌍둥이와 미사사기 씨는",
"내게 길을 비키듯 벽으로 붙는다."
],
"4306": [
"「당했습니다.",
"유감스럽게도, 말이죠...」"
],
"4307": [
"...그러고 보니.",
"한 명이 모자라다."
],
"4308": [
"방에서 안 나오겠다고 선언한",
"쿠라이시 씨는 그렇다 쳐도..."
],
"4309": [
"（...어째서...）"
],
"4310": [
"（츠바키 군이 없는 걸까...）"
],
"4311": [
"히오리가 안쪽을 가리킨다."
],
"4312": [
"멍한 채로",
"한 걸음, 두 걸음 더...."
],
"4313": [
"...그것만은.",
"그것만은 아니었으면 좋겠다고",
"생각했던 광경이..."
],
"4314": [
"「.....츠바키, 군...」"
],
"4315": [
"...가차 없이 누워 있었다."
],
"4316": [
"（...츠바키 군....）"
],
"4317": [
"분명... 새벽의, 그때...",
"내가 복도에 있었을 때..."
],
"4318": [
"（그때 그게, 그거였구나...）"
],
"4319": [
"（방을 나와서, 그대로 여기로",
"내려온 거야...）"
],
"4320": [
"설마 이런 일이 될 줄은",
"생각도 못 했지만."
],
"4321": [
"만약 내가 그때 말리든가",
"따라가든가 했더라면..."
],
"4322": [
"「.......온실은?」"
],
"4323": [
"툭, 시즈나 짱이 중얼거린 소리에",
"겨우 정신이 들었다."
],
"4324": [
"「어? 온실?」"
],
"4325": [
"「아, 맞다...",
"또 뭔가 이상한 게 늘어난 거",
"아니야...?」"
],
"4326": [
"「아아, 그러고 보니!",
"보러 가는 게 좋겠네」"
],
"4327": [
"「...그럼 일단",
"여기서 나갑시다」"
],
"4328": [
"「츠바키 씨한테는 안됐지만,",
"여기는 잠가 두는 게",
"좋겠죠」"
],
"4329": [
"「그렇... 네요...」"
],
"4330": [
"「어쩔 수 없, 지...",
"...미안해, 집사 씨」"
],
"4331": [
"그렇게 말하고 스즈나 짱은",
"츠바키 군의 유해에 합장한다."
],
"4332": [
"이끌리듯 다른 모두도",
"그것을 따랐다."
],
"4333": [
"「...잘 있어, 츠바키 군.",
"우리가 돌아갈 수 있게 되면",
"데리러 올게」"
],
"4334": [
"「.....바이바이」"
],
"4335": [
"쌍둥이와 미사사기 씨, 그리고 나스",
"씨가 이어서 지하실을 나갔다."
],
"4336": [
"「...나고 씨.",
"이런 일에만 쓰게 해서",
"미안하지만요...」"
],
"4337": [
"「휴대폰 좀 빌려주세요」"
],
"4338": [
"「...아아, 그렇구나」"
],
"4339": [
"「미안해요」"
],
"4340": [
"「...그야,",
"따로따로 찍는 것보다 내 거에",
"담아 두는 게....」"
],
"4341": [
"「네.",
"고마워요, 나고 씨」"
],
"4342": [
"꺼낸 휴대폰을 히오리에게 건네고,",
"나는 벽에 기대듯 몸을 맡기고",
"호흡을 가다듬는다."
],
"4343": [
"모르는 사이에 맥박이 꽤",
"빨라져 있었다..."
],
"4344": [
"（왜...?",
"왜, 이런 일이...）"
],
"4345": [
"「...미안해요, 츠바키 씨.",
"좀 쓸쓸하겠지만,",
"기다려 주세요」"
],
"4346": [
"그렇게 말하고 히오리는 궤짝",
"뚜껑을 조용히 닫았다."
],
"4347": [
"「자, 나고 씨.",
"정말 고마웠어요」"
],
"4348": [
"돌려받은 휴대폰을 기계적으로",
"윗옷 주머니에 넣는다."
],
"4349": [
"「가죠」"
],
"4350": [
"「.......응」"
],
"4351": [
"（미안해, 나...",
"아무것도 못 해서...）"
],
"4352": [
"（...잘 자...）"
],
"4353": [
"히오리가 오락실 열쇠로 지하실을",
"봉쇄하고, 그대로 온실로 향한다."
],
"4354": [
"다른 모두는 벌써 온실 안에",
"들어가서, 그 복수라고 적힌",
"종이 앞에 있었다."
],
"4355": [
"「음...",
"어제 있던 게 뭐였더라」"
],
"4356": [
"「고양이랑 벨」"
],
"4357": [
"「그럼, 저 못은?」"
],
"4358": [
"「없었어」"
],
"4359": [
"「그렇군, 그럼 못이 늘어난 거네」"
],
"4360": [
"「....그러게」"
],
"4361": [
"검은 고양이와 벨 말고도 크고 긴",
"못이 굴러다니고 있었다.",
"대못, 이라는 거겠지."
],
"4362": [
"「나스 씨, 여전히",
"기억 못 하는군요...」"
],
"4363": [
"츠바키 군이 있었다면 틀림없이",
"바보냐고 호통쳤을 거다..."
],
"4364": [
"늘 태평한 나스 씨도 왠지",
"진지한 얼굴로 머리를 긁고 있다."
],
"4365": [
"（고양이는 마다라이 씨...",
"벨은... 츠바키 군...）"
],
"4366": [
"「저기, 이제... 돌아가자.",
"확인했으니까... 응?」"
],
"4367": [
"꺼림칙한 듯",
"스즈나 짱이 애원한다."
],
"4368": [
"반대하는 사람이 있을 리 없었고,",
"우리는 서둘러 저택으로 돌아왔다."
],
"4369": [
"「아, 맞다...",
"또 뭔가 이상한 게 늘어난 거",
"아니야...?」"
],
"4370": [
"「........아」"
],
"4371": [
"「...있었어...」"
],
"4372": [
"「나고 씨, 봤어요?」"
],
"4373": [
"「온실에 갔었어, 나.",
"그래서 모두한테 알리려고",
"돌아왔더니...」"
],
"4374": [
"「그래서 나스 씨가 소리쳐도",
"좀처럼 안 나타났군요」"
],
"4375": [
"「그래서, 이번엔 뭔데요?」"
],
"4376": [
"「못이었어」"
],
"4377": [
"「못?」"
],
"4378": [
"「응, 엄청 길고 큰 거.",
"대못이라고 하나? 그거」"
],
"4379": [
"「대못...",
"왜 그런 게?」"
],
"4380": [
"「모르겠어요, 하지만...」"
],
"4381": [
"「...아직, 계속되는 거군요」"
],
"4382": [
"억양 없는 가느다란 목소리로",
"미사사기 씨가 중얼거렸다..."
],
"4383": [
"「....가자」"
],
"4384": [
"「집사 씨,",
"재워 두자」"
],
"4385": [
"「...그렇죠.",
"좀 쓸쓸하겠지만,",
"어쩔 수 없죠」"
],
"4386": [
"「여기는 잠가서 닫아 두죠」"
],
"4387": [
"「...바이바이.",
"돌아갈 수 있게 되면 같이 가자」"
],
"4388": [
"「....안녕히」"
],
"4389": [
"「...미안해요, 츠바키 씨.",
"비가 그칠 때까지 기다려 줘요」"
],
"4390": [
"「자, 나고 씨.",
"고마웠어요」"
],
"4391": [
"돌려받은 휴대폰을 기계적으로",
"윗옷 주머니에 넣는다."
],
"4392": [
"「가시죠」"
],
"4393": [
"방에 돌아가 쉰다"
],
"4394": [
"조금 더 여기 있는다"
],
"4395": [
"나도 방에 틀어박힌다"
],
"4396": [
"거실로 돌아오자 모두 무겁게",
"입을 다문 채 각자 소파에",
"몸을 묻는다..."
],
"4397": [
"...머릿속이 새하얬다.",
"뭔가 생각하려 해도, 무엇을 어떻게",
"생각해야 할지조차 모를 정도로."
],
"4398": [
"문득 둘러보니",
"다른 사람들도 비슷한 상태인지",
"어딘가 멍한 얼굴을 하고 있다."
],
"4399": [
"（그야... 그렇겠지）"
],
"4400": [
"（그치만, 설마...）"
],
"4401": [
"츠바키 군이, 라고 생각한 순간",
"눈과 코 안쪽이 찡하게 아파 왔다."
],
"4402": [
"（...왜일까）"
],
"4403": [
"（아직 만난 지 얼마 안 됐고...",
"그렇게 많이 얘기한 것도",
"아니었는데...）"
],
"4404": [
"무엇이 그렇게 슬픈지도",
"잘 몰랐다."
],
"4405": [
"어쩌면 츠바키 군이 없는 게",
"슬프다기보다, 내가 이런 곳에",
"있는 게 슬픈 건지도 모른다..."
],
"4406": [
"（...싫다...）"
],
"4407": [
"둘 다 싫다.",
"만난 지 얼마 안 된 사람 때문에",
"울 것 같은 불안정한 나도."
],
"4408": [
"...부조리하게 죽어 버린",
"츠바키 군보다 나 자신을 동정하고",
"있는 것 같은 기분이 드는 것도..."
],
"4409": [
"（하지만, 둘 중",
"하나일 수밖에 없는걸...）"
],
"4410": [
"（왜일까...",
"나는... 어째서...）"
],
"4411": [
"「....집사 씨,",
"언제 돌아가신 거야」"
],
"4412": [
"툭, 침묵을 깬 시즈나 짱의",
"목소리에 퍼뜩 고개를 든다."
],
"4413": [
"주위도 다들 한결같이 멍한",
"얼굴로 그녀를 바라보고 있었다."
],
"4414": [
"「언제...?」"
],
"4415": [
"「그야, 역시...",
"어젯밤 늦게 아니야?」"
],
"4416": [
"「아뇨, 오늘 아침 일찍이겠죠」"
],
"4417": [
"「왜?",
"마다라이 씨 때는...」"
],
"4418": [
"「마다라이 씨 때만큼",
"시간 안 지났다는 건 알았어」"
],
"4419": [
"「...손목시계가...」"
],
"4420": [
"「네, 부서져 있었죠.",
"5시 전을 가리킨 채로」"
],
"4421": [
"「그랬었나요?」"
],
"4422": [
"「네...",
"저도 봤어요...」"
],
"4423": [
"「저녁 5시쯤이라면 아직 멀쩡히",
"살아 있었던 게 확실하고...」"
],
"4424": [
"「그렇게 시간이 안 지난 것도",
"시즈나 씨 말대로예요」"
],
"4425": [
"「음, 그건 그러니까",
"시반 같은 걸로?」"
],
"4426": [
"「그럼 그 손목시계가",
"멈춰 있던 시간이",
"츠바키 군이 죽은 시간?」"
],
"4427": [
"「...아마도. 다만 죽은 순간",
"딱 맞춰 시계가 부서졌는지는",
"확실하지 않지만요」"
],
"4428": [
"「살아 있을 때 부서졌다면",
"유리에 금이 갔으니 풀든가",
"뭘 하든가 했겠지만요」"
],
"4429": [
"「...그러네」"
],
"4430": [
"「새벽 5시 전...",
"나는 아직 자고 있었는데...」"
],
"4431": [
"（...다들 꽤 평범하게",
"일어나서 떠들고 그랬구나...）"
],
"4432": [
"그야 그렇겠지.",
"설마 이런 일이 벌어졌을",
"거라곤 아무도 생각 못 했을 테니..."
],
"4433": [
"（아무도...",
"범인 말고는...）"
],
"4434": [
"「....언니,",
"어떡할래...?」"
],
"4435": [
"「돌아갈래」"
],
"4436": [
"「그래...",
"그럼, 우리는...」"
],
"4437": [
"「저도, 별로...",
"이제 방에서 나오지 않도록",
"할게요...」"
],
"4438": [
"완전히 기가 꺾인 듯한",
"여자들은 도망치듯 방으로",
"돌아갔다."
],
"4439": [
"「...나도 돌아갈까.",
"밖에 못 나가니 아령이라도",
"안 들면 몸이 둔해져서...」"
],
"4440": [
"「안 움직이면 숨까지",
"멈출 것 같네요, 나스 씨는」"
],
"4441": [
"「아니, 정말 그래.",
"숨이 막히지」"
],
"4442": [
"...왠지 대화가 안 맞는다.",
"그래도 그 이상한 대화를 듣고 있자니",
"조금은 마음이 편해졌다..."
],
"4443": [
"「그럼, 나도 돌아갈게」"
],
"4444": [
"「...나고 씨」"
],
"4445": [
"「...그럴게.",
"좀 쉴게...」"
],
"4446": [
"「그래요.",
"저는 서재에 있을 테니까,",
"그럼」"
],
"4447": [
"둘이서 거실을 나와, 나는 그대로",
"방으로 돌아갔다..."
],
"4448": [
"「...조금 더, 여기 있을게」"
],
"4449": [
"「그래요?",
"조심하세요」"
],
"4450": [
"「히오리는? 서재?」"
],
"4451": [
"「네, 밤까지 있을 거예요」"
],
"4452": [
"「그럼, 또 봐」"
],
"4453": [
"히오리는 조금 걱정스러운 듯",
"팔랑, 손을 흔들며 거실을 나갔다."
],
"4454": [
"왠지 아직도 믿기지 않는다."
],
"4455": [
"지하실을 나와 버리니 그건",
"역시 뭔가 잘못된 게 아닐까 하는",
"생각이 든다..."
],
"4456": [
"（....하지만...）"
],
"4457": [
"（잘못된 게 아니었어...）"
],
"4458": [
"게다가 아직 계속된다.",
"온실에 있던 못..."
],
"4459": [
"그건 범인이 아직 계속할 생각",
"이라는 증거겠지..."
],
"4460": [
"（....어떡하지.",
"이제 싫어...）"
],
"4461": [
"（더 이상 아무도",
"죽지 않았으면 좋겠어...）"
],
"4462": [
"...여기서 가만있으면 안 돼.",
"이번에야말로 어떻게든 막아야 해."
],
"4463": [
"하지만, 어떻게....?"
],
"4464": [
"거실로 돌아오긴 했지만, 모두",
"어떻게 해야 할지 모르겠다는",
"분위기로 멍하니 있다."
],
"4465": [
"「...나고 씨,",
"안색이 좀 나아졌네요」"
],
"4466": [
"「아까는 끔찍한 얼굴이었어요」"
],
"4467": [
"「응...",
"꽤 진정됐... 다고 생각해」"
],
"4468": [
"「다행이네요.",
"무리하지 마세요?",
"당신 부상자니까」"
],
"4469": [
"「아아, 잊고 있었어」"
],
"4470": [
"머리 부딪친 일 같은 건",
"아득한 옛날 이야기 같다."
],
"4471": [
"뒤뜰에 잘못 들어가서, 우물 옆에서",
"뭔가에 걸려 넘어져서..."
],
"4472": [
"「.......아」"
],
"4473": [
"「우물...」"
],
"4474": [
"「우물?",
"뒤쪽 우물이 왜요?」"
],
"4475": [
"「그거, 지금은 안 쓰는",
"거였던가?」"
],
"4476": [
"「안 쓰는 것 같던데요.",
"그게 왜요?」"
],
"4477": [
"「왠지 틈이 벌어져 있어서",
"안쪽이 보였는데, 뭔가",
"떨어져 있는 것 같았어」"
],
"4478": [
"「어두워서 잘 안 보였지만,",
"나뭇잎 같은 건 아니었던...」"
],
"4479": [
"「손전등은...",
"분명 뒷문에 있었죠」"
],
"4480": [
"「그럼, 가 볼까요」"
],
"4481": [
"「괘, 괜한 소리를",
"했다...」"
],
"4482": [
"「어디 다녀오셨어요?",
"갑자기 없어져서",
"걱정했잖아요」"
],
"4483": [
"「....뭐가 떨어져 있었어?」"
],
"4484": [
"「응? 뭐가 떨어졌어?」"
],
"4485": [
"「아까 오빠가 말했잖아」"
],
"4486": [
"「으, 응... 그게...」"
],
"4487": [
"히오리의 말에 모두가 술렁인다."
],
"4488": [
"「또...?」"
],
"4489": [
"「하지만?」"
],
"4490": [
"「그러니까 애태우는",
"말투 좀 하지 말라니까!」"
],
"4491": [
"순간 격앙할 뻔했던 스즈나 짱도",
"히오리의 말을 듣고 입을 다문다."
],
"4492": [
"「그러는 게 나을지도",
"모르겠네요」"
],
"4493": [
"「나고 씨 빌려주세요,",
"제가 띄울 테니까」"
],
"4494": [
"「아... 응, 부탁해」"
],
"4495": [
"직접 사진을 띄울 용기가",
"없었기에 안도하며",
"휴대폰을 히오리에게 건넨다."
],
"4496": [
"「고마워요」"
],
"4497": [
"「뭐, 뭐야...?",
"어? 라니 뭔데...」"
],
"4498": [
"「이거...",
"정말 사람 얼굴이야?」"
],
"4499": [
"「...괜찮을까」"
],
"4500": [
"「응, 그럼...",
"안 되겠다 싶으면 바로 그만둬」"
],
"4501": [
"나스 씨치고는 마지못한",
"모습으로 시즈나 짱에게 건넨다."
],
"4502": [
"「역시...」"
],
"4503": [
"「그렇지...",
"이건 좀...」"
],
"4504": [
"「안 보는 게 좋을 것 같아」"
],
"4505": [
"「언니가 이렇게 말한다는",
"건... 안 된다는 거야」"
],
"4506": [
"「...아, 알겠어요.",
"그럼... 그만둘게요」"
],
"4507": [
"「그런데 정말 대체 누굴까?」"
],
"4508": [
"「아니, 그러니까 지금",
"누군지 모른다고...」"
],
"4509": [
"「...아아, 그런 뜻이구나.",
"응, 뭐... 누구려나...」"
],
"4510": [
"「쿠라이시 씨는 아닌 것 같아」"
],
"4511": [
"「그치만, 지금 여기 없는 건",
"쿠라이시 씨뿐이잖아」"
],
"4512": [
"「저기...",
"분명 첫날에, 저희 말고도",
"누가 있다는 얘기를 했던 것 같은데」"
],
"4513": [
"「있어 주는 편이",
"뭐 마음은 편하지만요」"
],
"4514": [
"「왜!?」"
],
"4515": [
"「아아, 맞다!",
"오빠가 처음부터 누가 죽었다고",
"했었잖아!」"
],
"4516": [
"「그게 이... 우물 속",
"사람 아니야?」"
],
"4517": [
"「응, 다들 여기서",
"대본 읽고 있었는걸...」"
],
"4518": [
"「정직한 분이네요...」"
],
"4519": [
"「있잖아요, 나스 씨",
"알리바이 없어요」"
],
"4520": [
"「나고 씨가 시체를 보고 나서",
"우리가 달려올 때까지",
"시체 옮길 수 있던 건 당신뿐이죠」"
],
"4521": [
"「아니, 그러니까...」"
],
"4522": [
"「이, 일단 쿠라이시 씨한테도",
"알려 둘까요」"
],
"4523": [
"「....어떡할래?」"
],
"4524": [
"「나, 이제 돌아가고 싶어...」"
],
"4525": [
"「방으로 돌아가요...」"
],
"4526": [
"여자들은 도망치듯",
"방으로 돌아갔다."
],
"4527": [
"「...자」"
],
"4528": [
"「어쩌실래요?",
"지금 얘기할 수 있겠어요」"
],
"4529": [
"「어...",
"아아, 아까 모두한테 들은 얘기?」"
],
"4530": [
"「네, 그런데 아직",
"안색이 안 좋네요」"
],
"4531": [
"「...괜찮아.",
"말 안 하고 쌓아 두면",
"더 지칠 것 같고」"
],
"4532": [
"「...그렇죠.",
"털어놓는 게 편하려나」"
],
"4533": [
"「그럼 제가 들은 것도",
"얘기할 테니, 또 일람표로",
"만들어 볼까요」"
],
"4534": [
"「음, 그럼",
"전처럼 표의 축으로 삼을 건..」"
],
"4535": [
"「지하실 궤짝?」"
],
"4536": [
"「그건 계속 거기에",
"있었을 테니까,",
"시간은 관계없겠죠」"
],
"4537": [
"「...그렇지.",
"음, 그럼...」"
],
"4538": [
"「츠바키 군 손목시계인가.",
"부서져서 멈춰 있던...」"
],
"4539": [
"「그거겠죠.",
"5시 전이었던가요」"
],
"4540": [
"「...쏟아져 있던 페인트?」"
],
"4541": [
"「아뇨, 그걸로는 시간을",
"알 수 없잖아요」"
],
"4542": [
"「그, 그렇지.",
"음...」"
],
"4543": [
"「응, 4시 40분쯤",
"이었던 것 같아」"
],
"4544": [
"「사진 찍을 때 손목시계도",
"찍어 뒀으니까 확인은",
"할 수 있어요」"
],
"4545": [
"「다만 아까도 말했지만",
"그게 사망 시각이라고는 할 수 없어요」"
]
}