{
"14620": [
"「...아, 아니,",
"그 전에 방 이름을 물어봤던가」"
],
"14621": [
"「방 이름을 묻고 나서",
"방까지 안내받으신 거예요?」"
],
"14622": [
"「응, 맞아 맞아.",
"그랬어」"
],
"14623": [
"「저, 산사태 앞에서",
"봤다는 통행금지 간판",
"말인데요」"
],
"14624": [
"「응, 뭔데?」"
],
"14625": [
"「간판 말고 다른 건",
"뭐 있었어요?」"
],
"14626": [
"「으음...",
"모래주머니가 쌓여 있던 정도?」"
],
"14627": [
"「모래주머니요」"
],
"14628": [
"「그건 아마 물에 담그면",
"부푸는 종류 아닐까」"
],
"14629": [
"「네?",
"그런 게 있어요?」"
],
"14630": [
"「응, 흙을 채우는 건 무거우니까",
"일반 판매용 방재 제품은",
"요즘 그쪽이 많을걸」"
],
"14631": [
"흙을 채운 무거운 자루를 쌓으려면",
"시간이 걸리겠지만, 그런 거라면",
"..."
],
"14632": [
"（가져오는 것도,",
"설치하는 것도 한두 명으로",
"불가능하진 않겠네...）"
],
"14633": [
"「나스 씨는 다키 프로라는",
"소속사 잘 아세요?」"
],
"14634": [
"「다키 프로는 말이야...",
"아아, 맞다!」"
],
"14635": [
"「신인 중에 엄청 체격 좋은",
"애가 한 명 있거든」"
],
"14636": [
"「분명 럭비부 출신이라고",
"했던가」"
],
"14637": [
"「...나스 씨는",
"학창 시절에 뭐 하셨어요?」"
],
"14638": [
"「도서부원이었어」"
],
"14639": [
"「책 나르는 건 꽤",
"체력이 필요하거든」"
],
"14640": [
"많으면 무겁긴 하지, 종이니까.",
"그야 나스 씨 같은 사람이 있으면",
"든든하겠지."
],
"14641": [
"「그래서, 저, 운동은...?」"
],
"14642": [
"「여러 운동부에 시합 때마다",
"불려 다녀서 어느 한 곳에는",
"안 들어갔어」"
],
"14643": [
"그렇구나, 여기저기서 의지해서",
"하나로 못 좁혔던 거구나.",
"나스 씨다운 것 같기도 하다."
],
"14644": [
"「저, 스즈메 예능이라는",
"소속사 말인데요」"
],
"14645": [
"「스즈메...",
"어디였지, 그거?」"
],
"14646": [
"「모르세요?」"
],
"14647": [
"「들어 본 것 같은",
"기분은 드는데.",
"그것도 바로 최근에...」"
],
"14648": [
"「...마다라이 씨의",
"소속사예요...」"
],
"14649": [
"「아~, 그래서구나!",
"맞다, 본인한테 들었지」"
],
"14650": [
"너무 빨리 잊는 거 아닌가...?"
],
"14651": [
"「나스 씨 소속사는",
"어떤 곳이에요?」"
],
"14652": [
"「최근에 근처에 헬스장이",
"생겨서 편해졌...」"
],
"14653": [
"「...아, 혹시",
"위치 얘기가 아닌가」"
],
"14654": [
"「아하하, 그렇구나.",
"그야 그렇겠지」"
],
"14655": [
"「헬스장이 생겨서 기뻤던",
"터라 그만」"
],
"14656": [
"「자, 잘됐네요」"
],
"14657": [
"「응, 근데 후배나",
"매니저를 불러도",
"같이 안 가 주더라」"
],
"14658": [
"「수영장도 넓고",
"기분 좋은데 말이야」"
],
"14659": [
"나스 씨를 따라갈 만한",
"체력을 가진 사람이 없는",
"거겠지..."
],
"14660": [
"「가면... 애호회?",
"루차도르",
"팬클럽 같은 거야?」"
],
"14661": [
"「루... 네?」"
],
"14662": [
"「아, 아니야?",
"그럼 모르겠네」"
],
"14663": [
"「하아, 저...",
"루차도르가 뭐예요?」"
],
"14664": [
"「멕시코의",
"프로레슬러를 말해.",
"마스크맨이 많거든」"
],
"14665": [
"「아, 아아,",
"그렇군요...」"
],
"14666": [
"「후시기 비버리지라고",
"아세요?」"
],
"14667": [
"「아, 어디서 들어 봤는데.",
"뭐였더라」"
],
"14668": [
"「이상한 상품이 많기로",
"유명한 주스 회사예요」"
],
"14669": [
"「...아아, 그거구나!」"
],
"14670": [
"「꽤 전에 한 번 포스터",
"모델을 한 적이 있었지」"
],
"14671": [
"「그래요!?」"
],
"14672": [
"「분명 그 회사에서 처음",
"낸 스포츠 음료라고",
"했던 것 같아」"
],
"14673": [
"「아...",
"마셔 본 적 있어요...」"
],
"14674": [
"「아하하, 그거 맛없지」"
],
"14675": [
"「아, 네.",
"죄송하지만",
"엄청난 맛이었어요」"
],
"14676": [
"「모델 했을 때 답례로",
"1년 치를 받아서",
"곤란했었지...」"
],
"14677": [
"「이, 1년 치요?」"
],
"14678": [
"「응, 365병」"
],
"14679": [
"「그, 그걸 전부",
"마셨어요...?」"
],
"14680": [
"「사무실에서 나눠 주려 했더니",
"다들 도망가 버려서 말이야」"
],
"14681": [
"「...그렇겠죠...」"
],
"14682": [
"「이번 대본은",
"어떤 느낌이에요?」"
],
"14683": [
"「그게 모르겠어.",
"아직 첫 장면밖에 없으니까」"
],
"14684": [
"「그렇구나, 어떤 얘기가 될지도",
"상상이 안 가겠네요」"
],
"14685": [
"「응, 그것도 있는데...」"
],
"14686": [
"「다른 것도 있어요?」"
],
"14687": [
"「제일 모르겠는 건",
"누가 썼을까 하는 거야」"
],
"14688": [
"「글에도 그림체처럼 버릇이",
"있는 법이거든」"
],
"14689": [
"「근데 이것만으론 좀",
"누군지 모르겠어.",
"모르는 사람 같긴 한데」"
],
"14690": [
"「무지개빛 사랑의 다리라는",
"드라마 아세요?」"
],
"14691": [
"「응, 옛날에 본 적 있어.",
"마다라이 씨가 나왔던가」"
],
"14692": [
"「그렇다던데,",
"어떤 얘기인지...」"
],
"14693": [
"「음, 잘 기억 안 나는데",
"사람 찾기 서툰 사람이랑",
"말주변 없는 사람이 나왔던...」"
],
"14694": [
"대체 무슨 얘기야."
],
"14695": [
"（...라기보다 나스 씨의",
"기억법이 너무 애매한 건가...）"
],
"14696": [
"「나스 씨, 『백야』라는",
"비디오 영화 기억하세요?」"
],
"14697": [
"「백야?",
"어떤 거였더라」"
],
"14698": [
"「저도 내용은 모르는데",
"그때 뒤풀이에서 나스 씨를",
"만났다는 얘기를 들어서...」"
],
"14699": [
"「뒤풀이라.",
"나, 친구가 불러서",
"자주 가거든」"
],
"14700": [
"「...가끔 비슷한 곳에서",
"연회를 여러 개 하면 헷갈려서",
"다른 데 끼어 있기도 하고」"
],
"14701": [
"「어, 저, 그럼 혹시",
"『백야』 때도...」"
],
"14702": [
"「...그랬을지도.",
"무슨 얘기 했는지 기억 안 나고」"
],
"14703": [
"새삼 호쾌한 사람이다.",
"보통 불러 준 친구가 안 보이는",
"시점에서 눈치챌 텐데."
],
"14704": [
"（눈치 못 채는 게 나스 씨",
"겠지...）"
],
"14705": [
"「으음, 백야라...」"
],
"14706": [
"「아, 혹시",
"쿠라이시 씨도 있던 거 말인가」"
],
"14707": [
"「그거예요, 아마」"
],
"14708": [
"「그러고 보니 쿠라이시 씨가 있던",
"술자리에 얼굴 내민",
"기억이 있으니까 그건가?」"
],
"14709": [
"「그때...",
"여기 있는 사람들이 다 있었다는",
"것 같은데 기억 안 나세요?」"
],
"14710": [
"「응? 다 있었어?",
"그건 기억 안 나네」"
],
"14711": [
"「마작 지옥 전설이라는 얘기",
"아세요?」"
],
"14712": [
"「마작이라...",
"나, 그거 잘 못하거든」"
],
"14713": [
"「왠지 날면 혼나,",
"버린 패랑 기다리는 패가",
"안 맞는다나 뭐라나」"
],
"14714": [
"「...네?」"
],
"14715": [
"「보통 안 버리는 걸",
"버린대.",
"잘 모르겠지만」"
],
"14716": [
"「음...",
"나스 씨, 혹시 잘하세요?」"
],
"14717": [
"「아아, 응.",
"지진 않는데, 혼나」"
],
"14718": [
"...뭐가 뭔지 모를 방식인데",
"강하다는 건가..."
],
"14719": [
"그야 진 사람은 화나겠지."
],
"14720": [
"「나스 씨, 백사 살인 사건이라는",
"얘기 아세요?」"
],
"14721": [
"「백사...",
"음, 나구모 씨가",
"나오는 거였던가?」"
],
"14722": [
"「아, 그거예요」"
],
"14723": [
"「그렇지.",
"그건 대충 기억하고",
"있었는데...」"
],
"14724": [
"「읽은 게 꽤 옛날이라",
"어떤 얘기였는지 확실히",
"기억이 안 나네」"
],
"14725": [
"그래도 나스 씨, 작품은 읽는구나."
],
"14726": [
"「아메후라시 전기라고",
"아세요?」"
],
"14727": [
"「응? 뭐였지 그거?」"
],
"14728": [
"「게임이래요,",
"RPG...」"
],
"14729": [
"「아아, 우리 매니저가",
"샀는데 15분 만에 포기했다고",
"했던 거 아닌가」"
],
"14730": [
"「시, 15분...」"
],
"14731": [
"「꽤 어렵다나 봐.",
"나는 게임을 안 해서",
"잘 모르지만」"
],
"14732": [
"15분 만에 포기하는 RPG라니.",
"그건 꽤 문제가 있는 거 아닌가..."
],
"14733": [
"「새벽의...",
"아~, 그립다!」"
],
"14734": [
"「나, 딱 한 화",
"나왔거든, 그거」"
],
"14735": [
"「형사가 탐문하러 온",
"아파트에서 일하던 이삿짐센터",
"직원 중 한 명이 나야」"
],
"14736": [
"「그, 그래요...」"
],
"14737": [
"「근데 그거 재방송 안 해서",
"이제 못 볼지도 몰라」"
],
"14738": [
"좀 보고 싶었는데",
"무리인가..."
],
"14739": [
"「이 저택 꽤 오래됐네요.",
"엄청 넓고」"
],
"14740": [
"「응, 넓긴 한데 말이야,",
"운동하려고 하면",
"츠바키 군이 화내더라」"
],
"14741": [
"「...그야 그렇겠죠」"
],
"14742": [
"「밖에 달리러 가려 해도",
"말리고 말이야」"
],
"14743": [
"「위험하다니까요!",
"폭우에 발밑도 안 좋고...」"
],
"14744": [
"「곤란하네」"
],
"14745": [
"...날씨도 곤란하지만",
"나스 씨도 충분히 곤란한 사람이다..."
],
"14746": [
"「식당엔 그 뒤로 들어가 본 적",
"있어요?」"
],
"14747": [
"「식당?",
"지금 잠겨 있지 않았나」"
],
"14748": [
"「네, 잠가 뒀어요」"
],
"14749": [
"「그렇지.",
"나는 안 들어갔어」"
],
"14750": [
"「나스 씨가 마지막으로 오락실에",
"들어간 게 언제예요?」"
],
"14751": [
"「오락실은...",
"아마 나고무 군이 이 방에",
"묵었던 밤일 거야」"
],
"14752": [
"「아아, 그때...」"
],
"14753": [
"「응, 분명 그럴 거야.",
"그 뒤론 안 들어갔어」"
],
"14754": [
"「저...",
"뒤뜰 우물 말인데요...」"
],
"14755": [
"「...그거 왜",
"우물이었을까」"
],
"14756": [
"「아니, 나구모 씨...",
"일지도 모르는 사람의 시체를",
"왜 우물에 넣었나 싶어서」"
],
"14757": [
"「나고무 군한테 들켜서",
"당황했던 걸까」"
],
"14758": [
"「...저도 아직",
"잘 모르겠어요」"
],
"14759": [
"「그렇지」"
],
"14760": [
"「나스 씨 방에도",
"베란다는 없네요」"
],
"14761": [
"「그렇더라.",
"이쪽 방들엔 전부",
"없는 것 같아」"
],
"14762": [
"「네, 저희 방에도 없어요」"
],
"14763": [
"「있으면 턱걸이할 텐데」"
],
"14764": [
"나스 씨 방에만은",
"없는 게 나았던 것 같다..."
],
"14765": [
"「거실 밖 테라스는",
"날이 개면 기분 좋겠네요」"
],
"14766": [
"「응, 그거 좋지.",
"우리 집에도 있으면 좋겠다」"
],
"14767": [
"「나스 씨 집엔",
"마당 같은 거 있어요?」"
],
"14768": [
"「이렇게 넓진 않지만",
"일단 있긴 있어」"
],
"14769": [
"「근데 저렇게 넓은 테라스를",
"만들 정도는 아니야」"
],
"14770": [
"「와...",
"그래도 단독주택이네요」"
],
"14771": [
"「응, 오래됐지만.",
"근데 지하실도 없고 링을 놓을 만큼",
"넓지도 않아서...」"
],
"14772": [
"놓고 싶구나, 링..."
],
"14773": [
"「온실은 그 소동 전에",
"들어가 본 적 있었던가요」"
],
"14774": [
"「온실은 없어.",
"나고무 군이 온 뒤의 소동 때",
"처음 들어갔어」"
],
"14775": [
"「거기 날이 개면",
"사우나처럼 되려나」"
],
"14776": [
"「아, 네, 뭐...",
"꽤 따뜻하지 않을까요」"
],
"14777": [
"「그렇구나, 괜찮을지도...」"
],
"14778": [
"...뭐가..."
],
"14779": [
"「나스 씨, 부엌은",
"얼마나 쓰세요?」"
],
"14780": [
"「부엌?",
"자주 가는데, 냉장고 말고는",
"만져 본 적 없네」"
],
"14781": [
"「아, 그래요?",
"요리는 별로 안 하세요?」"
],
"14782": [
"「창코나베는 자신 있는데,",
"여기서 만들어도 다들",
"먹고 싶어 할 것 같지 않아서」"
],
"14783": [
"「나, 나베 요리는... 그렇죠...」"
],
"14784": [
"「응접실은",
"들여다보셨어요?」"
],
"14785": [
"「봤지, 첫날에.",
"이상한 가면이 있는 방이지?」"
],
"14786": [
"「근데 그거 말고는",
"평범한 방이었어」"
],
"14787": [
"「오락실엔 여러 가지",
"놓여 있네요」"
],
"14788": [
"「으음, 근데 별로",
"내가 잘하는 건 없더라」"
],
"14789": [
"「나스 씨가 잘하는 건...」"
],
"14790": [
"「하다못해 당구라도",
"있었으면」"
],
"14791": [
"「아, 당구요」"
],
"14792": [
"（좀 더, 아무리 생각해도 실내엔",
"없을 법한 걸 말할 줄",
"알았는데...）"
],
"14793": [
"「아니면 볼링이라든가",
"농구 골대라든가」"
],
"14794": [
"（이, 일단 실내긴 한데...",
"둘 다 실내에 있긴 한데...）"
],
"14795": [
"「서재 안은 보셨어요?」"
],
"14796": [
"「응, 봤어.",
"장서가 굉장하지」"
],
"14797": [
"「거의 외서 같더라.",
"일본어 책이 꽂힌 책장은 두세 개",
"정도였나」"
],
"14798": [
"「책장 전부 보셨어요?」"
],
"14799": [
"「책등을 대충 훑어본 정도야.",
"흰 책장에 이상한 게 제일 많았어」"
],
"14800": [
"「이, 이상한 거요?」"
],
"14801": [
"「무슨 책인지 모를 게",
"잔뜩 있었거든.",
"그거 뭘까...」"
],
"14802": [
"（어느 걸까...?",
"나중에 봐 볼까）"
],
"14803": [
"「창고 안은 보신 적",
"있어요?」"
],
"14804": [
"「아~, 있어.",
"첫날에 여기저기 열어",
"봤으니까」"
],
"14805": [
"「...근데 츠바키 군한테",
"들켜서 혼났어」"
],
"14806": [
"「뭐, 뭘 하셨는데요?」"
],
"14807": [
"「무거워 보이는 장식품을",
"들어 본 것뿐인데」"
],
"14808": [
"...그대로 그걸로 몸을",
"단련하기 시작하면 곤란해서 아닐까..."
],
"14809": [
"「나스 씨 방은 다른 사람",
"방이랑 특별히 다르진",
"않은가요」"
],
"14810": [
"「그렇지 않을까?",
"2층은 거의 다 객실이라",
"같은 디자인 같던데」"
],
"14811": [
"「넓죠.",
"호텔 같아요」"
],
"14812": [
"「음, 근데 운동하기엔",
"좀 좁더라」"
],
"14813": [
"「그, 그렇겠죠...」"
],
"14814": [
"「저쪽 복도에 딱 한 방만 느낌이",
"다른 방이 있잖아요」"
],
"14815": [
"「아~, 열리지 않는 방이라는",
"이름이 붙은 거지?」"
],
"14816": [
"「네, 맞아요.",
"들어가 보셨어요?」"
],
"14817": [
"「그게 없어.",
"첫날에 여기저기 들여다보며",
"돌아다녔더니...」"
],
"14818": [
"「어느새 츠바키 군이 뒤에서 계속",
"따라와서 왠지 안내해 줬는데,",
"그 방엔 들어가지 말라고...」"
],
"14819": [
"그건 혹시 안내가 아니라",
"감시하려고 따라다닌 것뿐",
"아닐까..."
],
"14820": [
"「2층 안쪽에도",
"광이 있네요」"
],
"14821": [
"「응? 그래?」"
],
"14822": [
"「응, 몰랐어.",
"뭔가 재밌어 보이는 거 있었어?」"
],
"14823": [
"「아뇨, 평범한 창고",
"같던데요」"
],
"14824": [
"「그렇구나, 아쉽다」"
],
"14825": [
"...뭐가 들어 있기를",
"기대했던 걸까..."
],
"14826": [
"「오래된 저택엔 왜 대개",
"지하실이 있을까요」"
],
"14827": [
"「왜일까?",
"창고인가?」"
],
"14828": [
"「근데 여기 지하실은",
"저택 크기에 비해 좁지」"
],
"14829": [
"「...그러고 보니",
"그런가...?」"
],
"14830": [
"「그게, 지하에 미로",
"같은 게 있어서...」"
],
"14831": [
"「엇!?",
"뭐야 그거, 잠깐 보고 와도 돼?」"
],
"14832": [
"「자, 잠깐만요!」"
],
"14833": [
"「...안 돼?」"
],
"14834": [
"「저, 괴, 괜히 범인한테",
"지하 미로를 저희가 안다는 게",
"들키면 자극할지도...」"
],
"14835": [
"특히 나스 씨의 경우",
"왠지 예상 이상의 대소동으로",
"번질 것 같은 기분이 든다."
],
"14836": [
"「음, 그렇구나.",
"그럼 사건이 해결되고 나서",
"하는 게 좋겠네」"
],
"14837": [
"「네, 그래요」"
],
"14838": [
"사건이 해결되면 한가하게 그런 곳",
"구경하러 갈 상황일지는",
"모르겠지만..."
],
"14839": [
"「아아, 있었지.",
"열어 봤어?」"
],
"14840": [
"「아뇨, 열어 보진 않았는데요」"
],
"14841": [
"「흐응...",
"그거 내려갈 수 있을까」"
],
"14842": [
"「내, 내려가요?」"
],
"14843": [
"「어딘가로 이어져 있거나",
"하지 않을까 해서」"
],
"14844": [
"...그건 우물이 아니라",
"뭔가 다른 것 같은데."
],
"14845": [
"「방 이름",
"말인데요...」"
],
"14846": [
"「아아, 여기 방들은",
"전부 작가 이름이지」"
],
"14847": [
"「어떤 기준으로 붙였는지",
"잘 모르겠지만」"
],
"14848": [
"「기준요?」"
],
"14849": [
"「오락실은 노랗지 않고,",
"히오리 군 방도 빨갛지 않잖아」"
],
"14850": [
"「방 이름이랑 인테리어는",
"딱히 상관없는 걸까」"
],
"14851": [
"「...아마",
"없지 않을까요」"
],
"14852": [
"「그렇지.",
"안 그러면 욕실 구석에",
"늘 할아버지가 앉아 있겠지」"
],
"14853": [
"「그런 욕실 싫어요...」"
],
"14854": [
"「저, 지하실에 있던",
"궤짝 말인데요」"
],
"14855": [
"「그거 말이지...」"
],
"14856": [
"「그 전에 열어 본 적",
"있어요?」"
],
"14857": [
"「으음, 원래 거기 있던 건",
"기억하는데",
"열어 본 적은 없어」"
],
"14858": [
"「쿠라이시 씨 방에",
"장미 그림이 놓여 있었는데요」"
],
"14859": [
"「장미 그림?",
"쿠라이시 씨 방에 걸려 있던",
"거랑은 다른 거?」"
],
"14860": [
"「응접실에 있던 그림",
"같아요」"
],
"14861": [
"「헤에, 응접실이라.",
"그 방은 이상한 가면이 있었다는",
"것밖에 기억 안 나네」"
],
"14862": [
"「쿠라이시 씨의...",
"그 화살, 활로 쏜 걸까요」"
],
"14863": [
"「으음...",
"나도 그렇게 확실히 본 건",
"아니지만...」"
],
"14864": [
"「설령 쿠라이시 씨가 저항 안 했어도",
"손으로 쥐고 그렇게",
"찌르는 건 무리 아닐까」"
],
"14865": [
"「그럼 역시 사살...?」"
],
"14866": [
"「그럴 것 같은데,",
"그러면 이번엔 어디서 어떻게",
"쐈는지가 수수께끼지」"
],
"14867": [
"「그렇죠.",
"창문도 닫혀 있었고,",
"문도 잠겨 있었어요」"
],
"14868": [
"「그것도 있지만,",
"애초에 그렇게 정면에서 이마를",
"꿰뚫으려고 하면...」"
],
"14869": [
"「어지간히 허를 찌르지 않으면",
"보통 피하잖아」"
],
"14870": [
"「아아, 그렇네요」"
],
"14871": [
"「즉 시간 들여 조준할",
"틈은 없었을 거야」"
],
"14872": [
"「쿠라이시 씨가 의식이 없었다면",
"모를까, 자다가 습격당한",
"느낌은 아니었잖아?」"
],
"14873": [
"쿠라이시 씨는 바닥에 쓰러져 있었고",
"옷도 평상복 그대로에, 게다가",
"눈을 뜬 채 죽어 있었다..."
],
"14874": [
"「...그럼 범인은",
"순식간에 조준해서 한 방에",
"이마를 꿰뚫었다는...?」"
],
"14875": [
"「으음...",
"조준이 순식간이었는지까지는",
"모르겠지만」"
],
"14876": [
"「네?",
"무슨...」"
],
"14877": [
"「그때 쿠라이시 씨가",
"어디서 어떤 자세일지",
"알면 미리 겨누고 있을 수 있어」"
],
"14878": [
"「예를 들어 나라면",
"매일 아침 같은 시간에 꼭 스트레칭하니까",
"어느 정도 예상할 수 있겠지」"
],
"14879": [
"「...쿠라이시 씨한테 그런",
"매일 꼭 같은 행동을 하는 습관이",
"있었던가요」"
],
"14880": [
"「글쎄...?",
"거기까진 모르겠는데」"
],
"14881": [
"별로 습관적인 행동은 안 했을 것",
"같은데..."
],
"14882": [
"그럼 미리 쿠라이시 씨가",
"방 어디쯤에 설지 같은 건",
"알 수가 없는 건가...?"
],
"14883": [
"（하지만 그걸 예상할 수 있다면",
"어느 정도 조준해 둘 수 있다...）"
],
"14884": [
"（...그런 게",
"가능하다면, 말이지만...）"
],
"14885": [
"「저, 흉기인...",
"도끼 말인데요...」"
],
"14886": [
"「그거 말이야, 나 들어 본 적",
"있거든」"
],
"14887": [
"「드, 들어 봐요?」"
],
"14888": [
"「응, 진짜인가 싶어서」"
],
"14889": [
"「보기엔 전체가 쇠라",
"엄청 무거워 보였는데,",
"들어 보니 의외로 가볍더라」"
],
"14890": [
"「음, 그건...",
"나스 씨 팔 힘이라서 가볍게",
"느낀 게 아니고요?」"
],
"14891": [
"「아니, 나고무 군이라도",
"들 수 있었을 거야」"
],
"14892": [
"「실제로 쇠는 날 부분뿐이고",
"자루는 강관 같은 걸 칙칙한 색으로",
"칠한 것뿐인 것 같았거든」"
],
"14893": [
"그럼 상당한 완력의 소유자가",
"아니면 휘두를 수 없을",
"정도는 아니구나."
],
"14894": [
"「테루테루보즈를 매달 때",
"만난 건 방에 온",
"츠바키 군뿐이에요?」"
],
"14895": [
"「매달 때 말고",
"뗄 때라면",
"시즈나를 만났어」"
],
"14896": [
"「아, 뗄 때요」"
],
"14897": [
"「너무 세게 묶어서 좀처럼",
"안 풀려서 고생하는데",
"시즈나가 와서 말이야...」"
],
"14898": [
"「무슨 얘기 하셨어요?」"
],
"14899": [
"「한밤중에 뭐 하냐고",
"의아해하더라」"
],
"14900": [
"그야 그렇겠지..."
],
"14901": [
"「온실에 『복수』라고 적힌 종이가",
"놓여 있었잖아요」"
],
"14902": [
"「아아, 그거.",
"언제 온실에 둔 걸까」"
],
"14903": [
"「나스 씨는 그 소동 전에",
"온실에 들어간 적 없으셨던",
"거죠」"
],
"14904": [
"「음, 첫날 낮 말이지.",
"응, 온실은 안 들여다봤어」"
],
"14905": [
"「저택 안을 여기저기 보는데",
"츠바키 군이 거의 다 모였으니",
"거실로 오라고 부르러 왔거든」"
],
"14906": [
"「정원까지 둘러보기 전에 대본",
"리딩이 시작돼 버려서」"
],
"14907": [
"저택 안만 해도 꽤",
"넓으니까..."
],
"14908": [
"「온실에 있던 고양이 장식품",
"본 기억 없으세요?」"
],
"14909": [
"「없는 것 같은데...",
"적어도 이 저택 어딘가에",
"장식돼 있진 않았을 거야」"
],
"14910": [
"「이 저택 물건치고는",
"싸구려 같은 느낌이죠」"
],
"14911": [
"「그렇지.",
"그럼 범인이 가져왔겠네」"
],
"14912": [
"「여기 전화가 밖으로 통했으면",
"좋았을 텐데요...」"
],
"14913": [
"「그러게.",
"설마 전화가 없을 줄이야」"
],
"14914": [
"「휴대폰도 안 터지고...」"
],
"14915": [
"「나, 휴대폰 없거든」"
],
"14916": [
"「네? 그래요?」"
],
"14917": [
"「가지라고는 하는데,",
"그런 자잘한 기계는 서툴러서」"
],
"14918": [
"「특히 문자 같은 건",
"전혀 모르겠고」"
],
"14919": [
"「그럼 컴퓨터는요?」"
],
"14920": [
"「아아, 그건 완전 꽝.",
"휴대폰보다 더 몰라」"
],
"14921": [
"정말 서툰지 나스 씨는",
"쑥스러운 듯 머리를 긁었다."
],
"14922": [
"「오락실 라디오는",
"오고 나서 만져 보셨어요?」"
],
"14923": [
"「나는 안 만졌어.",
"그 오디오로 라디오도 되는 걸",
"쿠라이시 씨가 켤 때까지 몰랐고」"
],
"14924": [
"「응, 딱히 주의해서 보진",
"않았으니까」"
],
"14925": [
"「그렇죠...",
"저도 볼일 없으면 그렇게",
"자세히 안 보고」"
],
"14926": [
"「...그러고 보니 나,",
"라디오 일은",
"해 본 적이 없네」"
],
"14927": [
"외모의 임팩트 때문에",
"목소리만 하는 일이 안 들어오나."
],
"14928": [
"아니면 말하는 내용이 어떤",
"방향으로 치우쳐 있어서일까..."
],
"14929": [
"「크지.",
"얼마나 무거운가 싶어서",
"들어 보려고 했는데...」"
],
"14930": [
"「들어 올리셨어요!?」"
],
"14931": [
"「아니, 그게 아쉽게도",
"벽에 고정돼서 안 움직이더라」"
],
"14932": [
"아쉽게도, 인가."
],
"14933": [
"「온실에 장난감 벨이",
"놓여 있었는데요...」"
],
"14934": [
"「벨이라...",
"왜 벨일까?」"
],
"14935": [
"「그거 그냥 장식이라",
"안 울리는 것 같던데」"
],
"14936": [
"「그렇네요,",
"울려도 보통 벨 같은",
"맑은 금속음은 아닐 것 같아요」"
],
"14937": [
"「그렇다는 건 소리는",
"중요하지 않은 거겠지」"
],
"14938": [
"「아무거나 소리 나는 걸",
"두고 싶었다든가 하는",
"건 아닐 거야」"
],
"14939": [
"「아아, 그렇군요.",
"그렇게 되네요」"
],
"14940": [
"「온실에 긴 못이",
"놓여 있어서...」"
],
"14941": [
"「못이 어떤 거였지?」"
],
"14942": [
"「대못이에요」"
],
"14943": [
"「아, 그거구나.",
"범인이 가져왔을까」"
],
"14944": [
"「네, 아마」"
],
"14945": [
"「그냥 파는 물건인가.",
"난 사 본 적 없는데」"
],
"14946": [
"「저도 없어요, 그런 거」"
],
"14947": [
"「근데 놓여 있었다는 건",
"어디선가 구해 왔다는 거지」"
],
"14948": [
"이 사건을 위해, 어딘가에서.",
"그렇게 생각하니 꽤",
"오싹한 기분이 든다..."
],
"14949": [
"「온실에 흰 장갑이",
"놓여 있었어요」"
],
"14950": [
"「장갑이라니 어떤 거?",
"목장갑 같은 거?」"
],
"14951": [
"「아뇨, 여성용으로 하늘하늘한",
"예쁜 거예요」"
],
"14952": [
"「흐응?",
"예복용인가?」"
],
"14953": [
"「아마 그럴 거예요...」"
],
"14954": [
"「그럼 우연히 가방에",
"넣어 뒀을 리는 없겠네」"
],
"14955": [
"「그것도 이걸 위해 준비해서",
"가져왔다는 건가」"
],
"14956": [
"「그렇겠죠...」"
],
"14957": [
"「온실에 손도끼가 놓여",
"있었어요...」"
],
"14958": [
"「손도끼라니, 장식 말고",
"실제로 쓸 수 있을 것 같은 거?」"
],
"14959": [
"「아...",
"네, 그런 것 같아요」"
],
"14960": [
"「그럼 이 집 어딘가에",
"장식돼 있던 무기 중 하나는",
"아닌 건가」"
],
"14961": [
"「그렇네요,",
"그런 거랑은 다른 느낌이었어요」"
],
"14962": [
"「그렇구나...",
"손도끼 정도면 우리 집에도 있고",
"못 가져올 건 아니지」"
],
"14963": [
"「집에 있어요!?」"
],
"14964": [
"「캠핑용 작은 거」"
],
"14965": [
"그렇구나, 캠핑용품이라면",
"팔지 않는 것도 아니구나."
],
"14966": [
"「온실에 이만한",
"작은 울타리가 놓여 있어서...」"
],
"14967": [
"「울타리라니 뭐?",
"새장 같은 거?」"
],
"14968": [
"「아뇨, 둘러싸는 형태는",
"아니에요」"
],
"14969": [
"「이렇게 격자 모양으로 된 게",
"한 면뿐이에요」"
],
"14970": [
"「뭐에 쓰는 걸까?",
"무슨 장식의 일부인가」"
],
"14971": [
"「그럴지도 몰라요.",
"몇 개 조합해서",
"쓰는 거 아닐까요」"
],
"14972": [
"「흐응...?",
"근데 그거 보이는 대로 울타리일까」"
],
"14973": [
"「울타리인지 격자인지,",
"범인이 무슨 생각으로 뒀는지",
"알기 어렵네」"
],
"14974": [
"「아아...",
"그러고 보니 그렇네요」"
],
"14975": [
"울타리라고 단정 짓지 않는 게",
"좋을지도..."
],
"14976": [
"「저, 나스 씨...",
"그, 덤벨...」"
],
"14977": [
"「응? 이거?」"
],
"14978": [
"「가져오셨어요?」"
],
"14979": [
"「응, 4개만」"
],
"14980": [
"'만'이 아니잖아..."
],
"14981": [
"「마다라이 씨 방에",
"뭔가 이상한 모양의 지팡이",
"있던 거 아세요?」"
],
"14982": [
"「아아, 그거.",
"그 지팡이 단단한데 가벼워서",
"몸 단련하기엔 안 맞아」"
],
"14983": [
"판단 기준이 그것밖에 없는 건가",
"나스 씨..."
],
"14984": [
"「이 저택엔 그림이 많이",
"걸려 있네요」"
],
"14985": [
"「그러고 보니 많네.",
"이 방에도 있고...」"
],
"14986": [
"「저건 어디일까?",
"쇼난인가?」"
],
"14987": [
"「아, 아닐 거예요.",
"아마 어딘가 외국일...」"
],
"14988": [
"「아~, 외국이구나.",
"듣고 보니 그렇네」"
],
"14989": [
"...그린 사람이 들으면 그 자리에서",
"붓을 꺾어 버릴 것 같다..."
],
"14990": [
"「나스 씨 차 멋있네요」"
],
"14991": [
"「그렇지, 마음에 들어.",
"근데 아직 말을 안 해」"
],
"14992": [
"「주행 거리가 부족한가?」"
],
"14993": [
"혹시 무슨 영화나 드라마를 보고",
"거하게 착각하고 있는 건..."
],
"14994": [
"「...마다라이 씨 차가",
"하다못해 경차만 아니었으면」"
],
"14995": [
"「아니, 차에는 보통 예비 타이어를",
"하나는 싣고 다니잖아」"
],
"14996": [
"「아, 그렇구나.",
"그렇죠」"
],
"14997": [
"「근데 사이즈가 다르니까,",
"내 차랑 마다라이 씨 차는」"
],
"14998": [
"「양쪽 타이어를 어느 한쪽",
"차에 달고 달리는 건",
"역시 무리겠지」"
],
"14999": [
"「그럼 제 차는",
"경차니까 마다라이 씨 거랑",
"맞을지도 몰라요」"
],
"15000": [
"「아아, 나고무 군 차가 있었지.",
"그럼 고칠 수 있잖아!」"
],
"15001": [
"「아뇨, 하지만...",
"제 차가 어디 있는지",
"모르는데요」"
],
"15002": [
"「아, 그랬지...」"
],
"15003": [
"진심으로 잊었던 모양이다..."
],
"15004": [
"「지하에 말이죠, 엄청 많은",
"뱀이 있었어요...」"
],
"15005": [
"「헤에, 그래?」"
],
"15006": [
"「...뱀은 닭고기 맛이랑",
"비슷하대」"
],
"15007": [
"「그렇게 맛없진 않아?」"
],
"15008": [
"「...자, 잡아먹거나",
"하지 마세요...」"
],
"15009": [
"「으음, 요리법은 역시",
"모르겠네」"
],
"15010": [
"몰라도 된다...",
"깜빡 요리해서 내놓기라도 하면",
"기절할 것 같다."
],
"15011": [
"「나스 씨는 컵라면 같은 건",
"역시 안 드시죠」"
],
"15012": [
"「그렇지, 인스턴트는",
"거의 안 먹어」"
],
"15013": [
"「라면도 평소엔 거의",
"안 먹으니까」"
],
"15014": [
"「그래요?",
"싫어서가 아니라 영양 같은",
"이유 때문에요?」"
],
"15015": [
"「응, 라면 자체는 좋아해」"
],
"15016": [
"「사촌이 포장마차를 하거든,",
"거긴 가끔 먹으러 가」"
],
"15017": [
"「창고에 석궁이",
"있었어요...」"
],
"15018": [
"「석궁?",
"석궁이면 무기 말이야?」"
],
"15019": [
"「...얼마나",
"위력이 있을까?",
"이길 수 있으려나...」"
],
"15020": [
"「다짜고짜 싸우려고",
"하지 마세요!!」"
],
"15021": [
"「안 돼?」"
],
"15022": [
"「아무리 그래도 맨손으로",
"덤비는 건 위험하니까요...」"
],
"15023": [
"「그렇구나, 아쉽다」"
],
"15024": [
"「저...",
"나스 씨, 복도의 가구 말인데요」"
],
"15025": [
"「아아, 그거?",
"내가 밖에 내놓은 거?」"
],
"15026": [
"「잊지 않으셨죠?」"
],
"15027": [
"「아하하, 괜찮아 괜찮아.",
"돌아갈 때 제대로 돌려놓을게」"
],
"15028": [
"「수면제 드셔 본 적 있어요?」"
],
"15029": [
"「나는 없어.",
"잠은 잘 드니까 써 볼",
"생각도 안 해 봤고」"
],
"15030": [
"「...나스 씨는",
"잠도 잘 들고 잘 깰 것 같네요」"
],
"15031": [
"「응, 둘 다 잘해」"
],
"15032": [
"「...근데 너무 잘 자서 말이야.",
"이불에 누우면 3초도 안 돼서",
"잠들어 버리거든」"
],
"15033": [
"...부러운 사람이다."
],
"15034": [
"「지하에 마리모가",
"놓여 있었어요」"
],
"15035": [
"「마리모는 해파리 종류였던가」"
],
"15036": [
"「전혀 달라요!!」"
],
"15037": [
"「그랬나?",
"뭔가 닮지 않았어?」"
],
"15038": [
"「마리모는 조류예요...",
"초록색이고 동글동글한 거요」"
],
"15039": [
"「아아, 그렇구나!",
"왜지, 클리오네랑",
"헷갈렸나 봐」"
],
"15040": [
"너무 헷갈린다..."
],
"15041": [
"「붉은 카메오라고 아세요...?」"
],
"15042": [
"「응? 나고무 군 잘 아네.",
"그거 언론에도 안 나온",
"얘기였는데」"
],
"15043": [
"「그래요?",
"저는 쿠라이시 씨한테 들었는데」"
],
"15044": [
"「아~, 쿠라이시 씨구나.",
"그 사람이라면 잘 알 수도」"
],
"15045": [
"「나스 씨도 잘",
"아세요?」"
],
"15046": [
"「응, 아는 사람이 그 사건이",
"일어난 동네 근처에 살았거든」"
],
"15047": [
"「온실 안쪽에 이게 있었어요」"
],
"15048": [
"「응? 카세트테이프?」"
],
"15049": [
"「아아, 이거 어디서 봤다",
"했더니 천 원 숍에서 파는 거다」"
],
"15050": [
"「우리 집 근처 가게에 있어」"
],
"15051": [
"「창고에 석궁이 있는데",
"화살이 걸려 있지 않아요」"
],
"15052": [
"「응? 화살이 없다니...",
"언제부터 없는데?」"
],
"15053": [
"「그걸 모르겠어요」"
],
"15054": [
"「...뭔가에 쓴 걸까」"
],
"15055": [
"「그렇구나...",
"근데 뭐에 썼는지 모르면",
"왠지 찜찜하네」"
],
"15056": [
"「창고에...",
"화살이 없어진",
"석궁이 있어서...」"
],
"15057": [
"「...그거, 쿠라이시 씨의...?」"
],
"15058": [
"「흉기, 인 것 같아요」"
],
"15059": [
"「근데 석궁이라니...",
"어디서 쐈을까?",
"나무 위라든가?」"
],
"15060": [
"「나무 위... 는",
"어렵지 않을까요...」"
],
"15061": [
"「그렇지.",
"근데 그런 걸 든 사람을 방에",
"들여 줄 것 같지도 않고」"
],
"15062": [
"「이거 뭐라고 생각하세요?」"
],
"15063": [
"「? 뭐야 이거?」"
],
"15064": [
"「지하에서 주웠는데",
"뭔지 모르겠어서요」"
],
"15065": [
"「흐응?",
"...너무 가벼워서 운동용으론",
"안 맞겠네」"
],
"15066": [
"「...운동용품은",
"아닐 거예요...」"
],
"15067": [
"「그렇지.",
"나도 모르겠네」"
],
"15068": [
"「아아, 있었지」"
],
"15069": [
"「그거 뭐 하는 데 쓰는 가면",
"일까?」"
],
"15070": [
"「축제용인가.",
"아니면 역시 누구랑 싸울 때",
"쓰는 걸까」"
],
"15071": [
"역시라니..."
],
"15072": [
"「나스 씨, 이거 본 적",
"없으세요?」"
],
"15073": [
"「어디? 만년필?」"
],
"15074": [
"「뒤뜰에 떨어져 있었는데요」"
],
"15075": [
"「흐응...",
"꽤 오래된 물건이네」"
],
"15076": [
"「왠지 본 적 있는 것 같은데",
"어디서 봤더라...」"
],
"15077": [
"나스 씨는 어디서 봤는지",
"기억이 안 나는 모양이다..."
],
"15078": [
"「오락실 데크에 이게",
"들어 있었어요」"
],
"15079": [
"「뭐야 이거?",
"카세트테이프?」"
],
"15080": [
"「산사태 뉴스가 들어 있었어요.",
"저희가 들은 거랑 다른 게」"
],
"15081": [
"「다른 거라니, 다른 데서도",
"어딘가 산이 무너졌어?」"
],
"15082": [
"「아뇨, 그게 아니라",
"범인이 준비한 가짜 뉴스",
"아닐까 해서요」"
],
"15083": [
"「그런 게 도움이 돼?",
"정말로 안 무너졌으면",
"보러 가면 바로 들킬 텐데」"
],
"15084": [
"「아니, 저...",
"실제 뉴스에서도 아직 무너질 위험이",
"있으니 접근하지 말라고...」"
],
"15085": [
"「아, 그 전에 안 무너졌으면",
"그대로 산을 내려가 버리려나」"
],
"15086": [
"「이 폭풍 속을요!?」"
],
"15087": [
"「그치만 정말 무너진 곳이 어디에도",
"없으면 그대로 시내까지",
"가는 수밖에 없지 않아?」"
],
"15088": [
"「...시내에 도착하기 전에",
"이상하다고 생각 안 할까요...」"
],
"15089": [
"「나는 못 알아챌 것 같은데」"
],
"15090": [
"여러 의미로 범인에게 가장",
"예상 밖이었던 건 내가 아니라",
"나스 씨가 아닐까..."
],
"15091": [
"「이 꽃, 뭔지 아세요?」"
],
"15092": [
"「꽃?",
"으음, 별로 잘 알진",
"않지만, 어디 보자...」"
],
"15093": [
"「아아, 뭐야.",
"하나슈쿠샤잖아」"
],
"15094": [
"「하나슈쿠샤.",
"일본 이름으로는 말이야」"
],
"15095": [
"「진저 릴리라고 하는 게",
"알기 쉬우려나」"
],
"15096": [
"「진저라면",
"생강이요?」"
],
"15097": [
