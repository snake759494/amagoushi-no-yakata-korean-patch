 "5028": [
  "「어디 갔었어?",
  "갑자기 나가더니」"
 ],
 "5029": [
  "「어머, 이렇게 젖어서...",
  "밖에 나갔다 오셨어요?」"
 ],
 "5030": [
  "「넘치고 있어?」"
 ],
 "5031": [
  "「아뇨, 그게 아니라」"
 ],
 "5032": [
  "「설마 또 무슨 일 있었어?",
  "왠지 오빠 안색이...」"
 ],
 "5033": [
  "「그럼 안 온 사람이라면",
  "나구모 씨 정도지」"
 ],
 "5034": [
  "「나구모 씨라니...",
  "설마, 그 사람은 그냥 길이 무너져서",
  "못 온 것뿐이잖아」"
 ],
 "5035": [
  "「모르는 사이 우물에",
  "떨어진 게 아니라면 말이지」"
 ],
 "5036": [
  "「언니!?」"
 ],
 "5037": [
  "「...라고 생각해 주길",
  "바라는 사람이 있을지도 몰라」"
 ],
 "5038": [
  "「이미 죽었다고 생각해 주길",
  "바라는 거 아닐까 하는 거」"
 ],
 "5039": [
  "「나구모 씨가 이미 죽었으면",
  "아무도 나구모 씨를 범인이라고",
  "생각 안 하잖아?」"
 ],
 "5040": [
  "「엣... 그럼 나구모 씨가",
  "범인일지도 모른다는 거야?」"
 ],
 "5041": [
  "「글쎄」"
 ],
 "5042": [
  "「글쎄라니, 언니...」"
 ],
 "5043": [
  "「그럴지도 모르고,",
  "아닐지도 모르죠」"
 ],
 "5044": [
  "「뭐가 진상인지는 일단",
  "여기선 알 수 없으니까요」"
 ],
 "5045": [
  "「그, 그렇... 죠...」"
 ],
 "5046": [
  "「...언제 우물에",
  "떨어지신 걸까」"
 ],
 "5047": [
  "「음, 그러니까요...",
  "나스 씨, 무슨 말인지 아시는",
  "...건 아니죠」"
 ],
 "5048": [
  "「알리바이」"
 ],
 "5049": [
  "「그, 그래도 이상해!",
  "그럼 나스 씨가 직접 차에",
  "독을 넣은 게 되잖아!」"
 ],
 "5050": [
  "「독?」"
 ],
 "5051": [
  "「응, 나고무 군이 말려 주지",
  "않았으면 확실히 마셨을 거야」"
 ],
 "5052": [
  "「그렇군요...",
  "하지만 그러면 시체를 옮길 수",
  "있던 사람이 없어져 버려요」"
 ],
 "5053": [
  "「그렇다면...",
  "역시 다른 누군가가 있는 걸까요」"
 ],
 "5054": [
  "「이 저택 어딘가에",
  "저희 말고 누군가가...」"
 ],
 "5055": [
  "아무도 대답하지 못했다.",
  "실제로 첫날 밤 우리 말고",
  "누군가가 있었던 만큼..."
 ],
 "5056": [
  "넓은 저택이니, 모두의 눈을 피해",
  "몰래 숨어 있는 것쯤은",
  "가능할지도 모른다..."
 ],
 "5057": [
  "（어느 쪽이 마음 편할까.",
  "이 안에 범인이 있을지",
  "모르는 것과...）"
 ],
 "5058": [
  "저택 어딘가에 아무도 모르는",
  "10번째 인물이 숨어 있을지",
  "모르는 것."
 ],
 "5059": [
  "（...둘 다 무서워...）"
 ],
 "5060": [
  "「밥은?」"
 ],
 "5061": [
  "모두가 침묵하고 있자",
  "시즈나가 불쑥 중얼거렸다."
 ],
 "5062": [
  "「...나스 씨도",
  "되도록 방에서 안 나오는 게",
  "좋을지도 모르겠네요」"
 ],
 "5063": [
  "「오늘 아침 나스 씨가",
  "멀쩡한 걸 보고",
  "범인도 초조했을 테니까요」"
 ],
 "5064": [
  "「처치하다 놓친 사람이",
  "눈앞을 돌아다니면",
  "괜히 자극할지도 몰라요」"
 ],
 "5065": [
  "「응...",
  "모처럼 살았는데",
  "또 위험해질지도...」"
 ],
 "5066": [
  "「그렇구나...",
  "심심하겠지만, 그게",
  "안전하다면 어쩔 수 없지」"
 ],
 "5067": [
  "「범인을 괜히 자극하면",
  "다들 위험한 거지?」"
 ],
 "5068": [
  "「그럴지도 몰라요.",
  "심심하시겠지만...」"
 ],
 "5069": [
  "「아니, 어차피 비 때문에 밖엔",
  "못 나가니까 방에서밖에",
  "트레이닝 못 하고」"
 ],
 "5070": [
  "「현관 앞에서 했더니 마다라이",
  "씨한테 혼났거든...」"
 ]
}