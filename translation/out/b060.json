],
"30245": [
"식사를 마치고 2층으로 올라온다."
],
"30246": [
"「어라, 스즈나 짱네...」"
],
"30247": [
"「아직 밑에 있었구나.",
"지금 그쪽 방에 가 볼까 하고",
"말하던 참이었어」"
],
"30248": [
"「무슨 일이에요?」"
],
"30249": [
"「의논」"
],
"30250": [
"「의논?」"
],
"30251": [
"「응, 오빠가 망봐 준다고",
"했잖아, 근데 역시 밤새는",
"힘들 테니까」"
],
"30252": [
"「한밤중까지는 우리 둘 다",
"깨어 있을 테니까, 그때까지는",
"쉬고 있어」"
],
"30253": [
"「어, 그래도 괜찮을까」"
],
"30254": [
"「그럼 제가 먼저 복도에",
"있을까요?」"
],
"30255": [
"「혼자는 위험할지도, 싶어」"
],
"30256": [
"「나도 그렇게 생각해.",
"아직 시간 이르니까, 지금",
"쉬어 둬」"
],
"30257": [
"「뭐, 확실히 나고 씨는 좀",
"자 두는 게 좋겠네요」"
],
"30258": [
"「...알았어.",
"그럼 스즈나 짱네 중 한 명이 먼저",
"쉴 때 내선으로 불러 줘」"
],
"30259": [
"「그래, 그렇게 할게.",
"이래저래 폐 끼쳐서 미안하지만」"
],
"30260": [
"「아뇨, 피차일반이죠.",
"그럼 나고 씨는 지금 잠시",
"쉬세요」"
],
"30261": [
"「기모노 씨도」"
],
"30262": [
"「맞아, 히오리도 어제",
"못 잤잖아」"
],
"30263": [
"「네네.",
"그럼 조심하세요」"
],
"30264": [
"「그러면 더 신경 쓰이잖아.",
"무슨 소리가 나도 오빠인가",
"싶어서 못 알아챌지도 모르고」"
],
"30265": [
"「괜찮아, 나도 깨어 있을게」"
],
"30266": [
"「응, 둘이서 어떻게든 할게」"
],
"30267": [
"「오빠도 조심해.",
"그럼, 잘 자」"
],
"30268": [
"（시즈나 짱도 있다지만",
"연약한 여자애들한테만 맡기는",
"것도 좀...）"
],
"30269": [
"그렇다고 내가 도움이 되냐 하면",
"꽤 자신은 없지만."
],
"30270": [
"（역시 내버려 둘 마음은",
"안 들어...）"
],
"30271": [
"미안하지만, 몰래 망보게",
"해 달라고 하자."
],
"30272": [
"（방 바로 앞은",
"스즈나 짱 말대로 오히려",
"위험할지도 모르니까...）"
],
"30273": [
"（아, 맞다, 헛간 같은 게",
"있었지...）"
],
"30274": [
"이 안이라면 괜찮으려나.",
"문을 살짝 열어 두면 그럭저럭",
"복도는 보이고."
],
"30275": [
"（하룻밤, 여기서 망보자...）"
],
"30276": [
"마음을 다잡고 다시 문틈으로",
"스즈나 짱의 방을 망본다."
],
"30277": [
"（눈이 아파 오기 시작했어...）"
],
"30278": [
"좁은 틈으로 가만히 밖을",
"보고만 있으니 눈이 피곤해진다."
],
"30279": [
"뭔가 쓰러졌다...!",
"아까보다 요란한 소리가 들려서",
"참지 못하고 헛간에서 나왔다."
],
"30280": [
"「나고 씨?",
"왜 그쪽에서...」"
],
"30281": [
"「아니, 저기, 무슨 일이야?」"
],
"30282": [
"（눈도 피곤하네...）"
],
"30283": [
"좁은 틈으로 어두운 복도를 가만히",
"보고 있어서 그런지 눈도 아프다."
],
"30284": [
"혹시 헛간에 숨어들 때",
"사실 범인이 봤던 걸까.",
"그래서 아무도 안 오는 걸까."
],
"30285": [
"（...일단 망은 봐 두자）"
],
"30286": [
"역시 아무것도 안 하고",
"내버려 두는 건 너무 걱정돼."
],
"30287": [
"히오리가 이미 잠든 걸 확인하고",
"방을 빠져나왔다..."
],
"30288": [
"발소리를 죽이고 몰래 스즈나 짱의",
"방 앞으로 간다."
],
"30289": [
"（지금 누구한테 들키면",
"내가 수상한 사람이겠지...）"
],
"30290": [
"（어딘가 들키기 어려운",
"곳에...）"
],
"30291": [
"주위를 둘러보고, 스즈나 짱의 방",
"앞에 있는 헛간 안으로 숨어들었다."
],
"30292": [
"（여기라면 범인이 와도",
"나도 안 들키고...）"
],
"30293": [
"...하지만 정말 범인이 오면",
"어떻게 붙잡지."
],
"30294": [
"아마 등을 돌리고 있을 테니까",
"뛰쳐나가서 붙잡으면 어떻게든",
"되려나..."
],
"30295": [
"（...할 수 있다면...）"
],
"30296": [
"（아무도 안 오기를...）"
],
"30297": [
"두근거리며 살짝 연 문틈으로",
"방을 망본다."
],
"30298": [
"「뭐? 밤새도록?」"
],
"30299": [
"「응, 그 편이",
"안전하잖아」"
],
"30300": [
"「안전이라 해도, 당신...」"
],
"30301": [
"「...자고 가면?」"
],
"30302": [
"「스즈가, 내 방에서」"
],
"30303": [
"「아, 그러면 범인이",
"스즈나 짱 방에 와도 괜찮겠네」"
],
"30304": [
"「...그래도, 범인이",
"눈치채서 언니까지 습격당하면",
"어떡해」"
],
"30305": [
"「아니, 그러니까 그렇게 안 되게",
"나도 망볼 테니까」"
],
"30306": [
"「저기, 이래 봬도 꽃다운 처녀야」"
],
"30307": [
"「처녀, 처녀」"
],
"30308": [
"「아, 아니, 그러니까",
"방 안이 아니라 밖에서」"
],
"30309": [
"「복도에 밤새 있을 생각이야...?」"
],
"30310": [
"「...엉덩이 아프겠다」"
],
"30311": [
"「저기, 나는 남자니까 괜찮지만",
"언니는 이래 봬도 꽃다운 처녀라고」"
],
"30312": [
"방 맞은편 벽에 기대어",
"복도에 주저앉는다."
],
"30313": [
"（혼자서 망보는 것보다는",
"훨씬 안심이네...）"
],
"30314": [
"「나, 방 밖에 있을 건데...」"
],
"30315": [
"「됐어, 그런 거 미안하고」"
],
"30316": [
"「아니, 신경 안 써도 돼」"
],
"30317": [
"「아... 그, 그렇네...」"
],
"30318": [
"「괜찮아, 안 잘 거야」"
],
"30319": [
"「정말 괜찮아...?」"
],
"30320": [
"「무슨 일 있으면 큰 소리 낼게」"
],
"30321": [
"「그래.",
"누가 들어올 것 같으면",
"있는 힘껏 소리칠게」"
],
"30322": [
"「그렇구나...",
"그럼 조심해」"
],
"30323": [
"「응, 고마워.",
"오빠도」"
],
"30324": [
"쌍둥이는 손을 흔들며 방으로",
"돌아갔다."
],
"30325": [
"「아, 히오리.",
"이제 돌아갈게」"
],
"30326": [
"「...너무",
"골똘히 생각하지 마세요」"
],
"30327": [
"「까맣게 잊은 것 같은데",
"당신 부상자라고요」"
],
"30328": [
"「...그러고 보니 그랬지」"
],
"30329": [
"「진짜로 잊었네...",
"제대로 자야 해요」"
],
"30330": [
"「으, 응.",
"화장실 갔다가 바로 돌아가 잘게」"
],
"30331": [
"「그래요?",
"그럼 안녕히 주무세요」"
],
"30332": [
"（그렇게 말은 했지만, 역시",
"아무것도 안 하는 건 불안해...）"
],
"30333": [
"스즈나 짱한테도 들키지 않게",
"몰래 망볼까..."
],
"30334": [
"일단 방 앞 복도까지",
"가 본다."
],
"30335": [
"（아... 헛간...）"
],
"30336": [
"스즈나 짱의 방 앞에 마침",
"헛간이 있다."
],
"30337": [
"저 안에서 망보면 범인한테도",
"바로 들키지 않아서 좋을지도."
],
"30338": [
"（으, 어두워...）"
],
"30339": [
"좁고 어둡고 무섭지만...",
"여기서라면 몰래 망볼 수 있겠어."
],
"30340": [
"（아침까지 참고",
"여기 있자...）"
],
"30341": [
"（...아무도 안",
"오기를...）"
],
"30342": [
"「괜찮아, 하룻밤쯤은",
"깨어 있을 수 있어」"
],
"30343": [
"「그렇구나, 그럼 조심해」"
],
"30344": [
"「잘 자, 내일 봐」"
],
"30345": [
"「응, 알아.",
"이제 돌아가서 잘게」"
],
"30346": [
"방에 돌아오긴 했지만.",
"역시 쌍둥이 일이 좀",
"신경 쓰이네..."
],
"30347": [
"「...피곤해」"
],
"30348": [
"방에 돌아오니 피로가",
"확 몰려온다."
],
"30349": [
"（...이제 잘까...）"
],
"30350": [
"문소리가 났다...",
"그것도 비교적 가까이서."
],
"30351": [
"황급히 시선을 돌렸지만",
"물론 쌍둥이 방은 아니다."
],
"30352": [
"「...보고 올게요」"
],
"30353": [
"작게 중얼거리며 히오리는 스윽 일어나",
"복도 모퉁이 너머를 살핀다."
],
"30354": [
"「어.. 어때...」"
],
"30355": [
"「빈방 문이 열려 있어요」"
],
"30356": [
"「빈방...?」"
],
"30357": [
"「원래 나구모 씨 방이 될",
"예정이었던 그 방이요」"
],
"30358": [
"「왜.. 왜 열려 있지...",
"누가 있다는 거야...?」"
],
"30359": [
"「...시계...!?」"
],
"30360": [
"갑자기 울려온 크고 낮은 소리에",
"펄쩍 뛸 만큼 놀랐다."
],
"30361": [
"「시계 소리, 맞지...」"
],
"30362": [
"「현관 앞 홀에 있는",
"그거네요」"
],
"30363": [
"「왜 갑자기",
"울리는 거지...?」"
],
"30364": [
"「어, 어쩌지...」"
],
"30365": [
"「...보고 올게요.",
"나고 씨는 여기 지켜 주세요」"
],
"30366": [
"「으, 응.",
"조심해...」"
],
"30367": [
"「네, 그쪽도요」"
],
"30368": [
"끄덕이고 히오리는 복도를",
"돌아 시계를 보러 갔다."
],
"30369": [
"（...무섭지만...）"
],
"30370": [
"역시 둘 다 여기를 떠날",
"수는 없지..."
],
"30371": [
"눈앞의 문을 두드리는 소리에",
"나도 모르게 엉거주춤 일어선다.",
"방 안에서 쌍둥이 목소리가 났다."
],
"30372": [
"「오빠...?」"
],
"30373": [
"「무슨 일 있어?",
"시계 소리가 났는데」"
],
"30374": [
"「지, 지금 히오리가 보러 갔어.",
"거긴 아무 일 없어?」"
],
"30375": [
"「응, 여긴 딱히 아무것도」"
],
"30376": [
"「그렇구나, 그럼 그대로",
"안에 있어」"
],
"30377": [
"「무슨 일인지 모르니까",
"안 나오는 게 좋을 것 같아」"
],
"30378": [
"「알았어.",
"이대로 방에 있을게」"
],
"30379": [
"...시계 소리는 이미 멎었다.",
"하지만 왜 갑자기 울리기",
"시작한 걸까..."
],
"30380": [
"（분명 츠바키 군이 소리가 안 나게",
"해 뒀다고 했었는데...）"
],
"30381": [
"게다가 원래 아침 8시부터 밤 8시",
"까지만 울리는 거 아니었나."
],
"30382": [
"（...아직 3시 넘었을 뿐인데）"
],
"30383": [
"「나고 씨」"
],
"30384": [
"「아, 히오리.",
"어땠어?」"
],
"30385": [
"「바늘이 8시를 가리킨 데다",
"소리가 나도록 설정이 바뀌어",
"있었어요」"
],
"30386": [
"「또 울리면 못 견디니까",
"원래대로 돌려놨는데요」"
],
"30387": [
"「왜...?",
"누가 설정을 건드렸다는 거야?」"
],
"30388": [
"「시간 쪽은 오래된 시계니까",
"틀어졌을지도 모르지만,",
"소리 쪽은 말이죠...」"
],
"30389": [
"「누가 일부러 하지 않으면",
"저절로 되진 않겠지」"
],
"30390": [
"「안 될 거라고 봐요.",
"무엇 때문인진 모르겠지만」"
],
"30391": [
"「...저기, 뭐였어?」"
],
"30392": [
"문 너머에서 스즈나 짱의 목소리가",
"물어 왔다."
],
"30393": [
"「왠지 시계를 누가",
"건드렸더라고요...」"
],
"30394": [
"히오리가 나한테 한 것과 같은 말을",
"설명한다."
],
"30395": [
"「...그게 무슨 의미가 있어」"
],
"30396": [
"「전혀 모르겠어요.",
"그쪽은 아무 일 없었던",
"거죠?」"
],
"30397": [
"「아무것도...",
"아무도 안 왔어」"
],
"30398": [
"「시즈나 짱은?」"
],
"30399": [
"「있어」"
],
"30400": [
"「으악!?",
"언니, 발밑에서 갑자기",
"얼굴 내밀지 마!!」"
],
"30401": [
"「...기운찬 것 같네」"
],
"30402": [
"「뭐, 아무 일 없었다면",
"다행이지만요...」"
],
"30403": [
"「날이 밝기까지 아직 좀 남았으니",
"밝아질 때까진 경계합시다」"
],
"30404": [
"「으, 응, 알았어.",
"자, 언니 돌아가」"
],
"30405": [
"부스럭거리는 소리가 나더니 쌍둥이는",
"방 안쪽으로 돌아간 모양이었다."
],
"30406": [
"「아, 맞다...",
"빈방 쪽은..?」"
],
"30407": [
"「...그러고 보니 안 봤네요.",
"잠깐 들여다볼까요」"
],
"30408": [
"「드, 들여다보기만 해?",
"쌍둥이는 무사하니까...」"
],
"30409": [
"「네네.",
"아무도 없으면 닫아 둘게요」"
],
"30410": [
"그렇게 말하고 히오리는 빈방 쪽으로",
"향했다."
],
"30411": [
"「...아무도 없긴 한데요.",
"베란다가 열려 있는 것 같아요」"
],
"30412": [
"「베란다...?」"
],
"30413": [
"「보고 오는 게 좋으려나」"
],
"30414": [
"「아, 아침에 해도 돼!",
"거기 누가 있으면 어쩌려고!?」"
],
"30415": [
"「...그렇네요.",
"그럼 문만 닫아 둘까」"
],
"30416": [
"문 닫히는 소리가 나고, 히오리가",
"어슬렁 돌아온다."
],
"30417": [
"「...조금만 더 참으면 되겠다」"
],
"30418": [
"「그렇네요.",
"나고 씨 힘들면",
"자도 돼요」"
],
"30419": [
"「괜찮아.",
"잠이 완전히 깨 버렸어」"
],
"30420": [
"「그래요.",
"그럼 앞으로 두세 시간",
"기합 넣어 볼까요」"
],
"30421": [
"「보고 오는 게 좋겠네.",
"제가 잠깐 다녀올게요」"
],
"30422": [
"「앗, 자, 잠깐!」"
],
"30423": [
"（우리뿐... 인가...）"
],
"30424": [
"다른 사람들은 경계해서 안 나온 건지",
"복도에 있는 건 우리뿐이었다."
],
"30425": [
"「...왜...?」"
],
"30426": [
"「글쎄요...」"
],
"30427": [
"「뭔지 모르겠지만",
"울려야 할 이유가 있었겠죠」"
],
"30428": [
"왜일까.",
"왠지 그 이유는 엄청나게",
"불길한 것 같은 기분이 들었다."
],
"30429": [
"「...멈출 수 있어?」"
],
"30430": [
"「뭐, 아무튼",
"아침까지 좀 더 쉬세요」"
],
"30431": [
"「...응, 그렇게 할게」"
],
"30432": [
"결국 다른 사람들은 안 내려왔네.",
"어쩌면 바늘을 고치는 동안",
"위에서 보고 있었을지도 모르지만."
],
"30433": [
"왠지 무서워져서 침대 밑이나",
"소파 뒤를 들여다본다."
],
"30434": [
"「괜찮은 것 같아요」"
],
"30435": [
"（어...?）"
],
"30436": [
"갑자기 울려온 낮은 소리에 나도 모르게",
"비명을 지를 뻔했다."
],
"30437": [
"하지만 지금 여길 떠났다가 스즈나 짱한테",
"무슨 일이 생기면 큰일이다.",
"오히려 가만히 있는 게 나을지도."
],
"30438": [
"（그러면 이쪽에 누가 와도",
"알 수 있고...）"
],
"30439": [
"그렇게 하자.",
"소리 안 나게 조용히 문을",
"열고 빠져나가 본다..."
],
"30440": [
"문이 열려 있다.",
"누가 나온 걸까...?"
],
"30441": [
"（..아니, 저긴 빈방이잖아!",
"왜 열려 있는 거지...?）"
],
"30442": [
"그러고 보니 시계가 울리기 전에",
"문 열리는 소리가 들린 것 같은데."
],
"30443": [
"살그머니 벌어진 틈으로 안을 본다.",
"아무도 없는 것 같긴 한데..."
],
"30444": [
"...방 안에 들어가서 확인할",
"용기가 없다..."
],
"30445": [
"「읏...!!」"
],
"30446": [
"갑자기 뒤에서 말을 걸어서",
"펄쩍 뛸 뻔했다."
],
"30447": [
"「히, 히익... 히오리...」"
],
"30448": [
"「아, 죄송해요.",
"놀라게 해 버렸네요」"
],
"30449": [
"「...그런데 뭐 하는 거예요?",
"이런 데서...」"
],
"30450": [
"「어떻게 됐어?」"
],
"30451": [
"「...나고 씨는요?」"
],
"30452": [
"「어? 아, 저기...",
"왠지 모르겠지만 문이 열려 있어서」"
],
"30453": [
"「여기 말이에요?」"
],
"30454": [
"「응, 근데 아무도 없는 것 같아」"
],
"30455": [
"「...그보다 왜 나고 씨는",
"방에 없고 여기 있는 거예요」"
],
"30456": [
"「어, 그게, 나는...",
"나는... 화장실」"
],
"30457": [
"「...어쩔 수 없는 사람이네」"
],
"30458": [
"「아침이 되면",
"제대로 자는 거예요」"
],
"30459": [
"「뭣하면 같이 있어 줄까요」"
],
"30460": [
"「...아니, 저기...",
"괜찮아, 곧 날 밝으니까...」"
],
"30461": [
"「뭐, 그렇긴 하죠.",
"그럼 날이 밝으면 바로 돌아가서",
"주무세요」"
],
"30462": [
"「저기 말이야, 히오리...」"
],
"30463": [
"「불이 안 켜져 있었어요」"
],
"30464": [
"「화장실이요.",
"저는 방을 나온 뒤 계단 내려가기 전에",
"이쪽도 보러 왔는데요」"
],
"30465": [
"「당신 같은 겁쟁이가",
"불도 안 켜고 들어갈 리 없고」"
],
"30466": [
"「그렇구나... 가 아니라,",
"저기 말이야, 히오리...」"
],
"30467": [
"「그렇잖아요」"
],
"30468": [
"「그러면서 자진해서 무서운 짓을",
"하려고 한단 말이죠」"
],
"30469": [
"「그, 그치만, 아무것도 안 하면",
"더 무서운 일이 되잖아!」"
],
"30470": [
"「네네, 알았으니까요.",
"조심하세요?」"
],
"30471": [
"「응, 알아.",
"안전한 데 있을 테니까」"
],
"30472": [
"「헛간이 안전한가요.",
"뭐, 됐어요...」"
],
"30473": [
"「그럼 내일 봐」"
],
"30474": [
"나도 몰래 살금살금 헛간 쪽으로",
"돌아가서..."
],
"30475": [
"헛간에 있는 것까지 어떻게",
"아는 거야, 저 녀석..."
],
"30476": [
"（...생각하지 않기로 하자...）"
],
"30477": [
"스즈나 짱은 방에 틀어박힌",
"채지만..."
],
"30478": [
"발소리를 죽이고 스즈나 짱의 방",
"앞까지 간다."
],
"30479": [
"살며시 문에 귀를 대 보니",
"안에서 작게 흐느끼는 소리가",
"들렸다."
],
"30480": [
"（아직 울고 있어...）"
],
"30481": [
"내가 여기 있는 걸 알면",
"또 흥분할지도 모르니까",
"몰래 망봐야지..."
],
"30482": [
"소리 안 나게 방 맞은편에",
"있는 헛간 안으로 숨어들었다."
],
"30483": [
"（여기서 아침까지 어떻게든...）"
],
"30484": [
"（......그만두자）"
],
"30485": [
"지금 스즈나 짱은 섣불리",
"자극하지 않는 게 좋겠지."
],
"30486": [
"저 상태라면 아무도 가까이",
"못 오게 할 테니까..."
],
"30487": [
"대체 누가 그런 끔찍한 짓을.",
"그거라도 알면 스즈나 짱도",
"조금은 진정할지도..."
],
"30488": [
"뭐지, 방금 소리...",
"삐걱거리는 이상한 소리가 어딘가서",
"들렸다."
],
"30489": [
"（문소리도 발소리도",
"아니었어...）"
],
"30490": [
"（뭐야...?）"
],
"30491": [
"「또, 또...」"
],
"30492": [
"게다가 이번엔 아까와 다른",
"방향에서 들린 것 같은데."
],
"30493": [
"（여, 역시 울리고 있어...）"
],
"30494": [
"（대체 무슨 소리야!?）"
],
"30495": [
"나가 보는 게 좋을까.",
"복도에 나가서 상황을 보는 게",
"좋을지도 모르지만..."
],
"30496": [
"「...읏!?」"
],
"30497": [
"소리와 동시에 발밑이 흔들려서",
"비명을 지를 뻔했다."
],
"30498": [
"（뭐야..!?",
"혹시 지진...!?）"
],
"30499": [
"설마 산사태가 이 저택 근처까지",
"영향을 주고 있다든가..."
],
"30500": [
"「그, 그건...」"
],
"30501": [
"이런 데 틀어박혀 있을 때가",
"아닌 거 아냐..."
],
"30502": [
"（나, 나가는 게 좋아, 무조건!）"
],
"30503": [
"황급히 문에 손을 대고..."
],
"30504": [
"「...거짓말...」"
],
"30505": [
"문이 열리지 않았다.",
"아까... 흔들렸을 때 어긋나거나",
"뭔가 된 걸지도..."
],
"30506": [
"「에에에에에!?",
"잠깐, 잠깐만!」"
],
"30507": [
"「싫어, 그런 거!",
"누구 없어~! 히오리~!!」"
],
"30508": [
"뭘 하러 틀어박혀 있었는지도 머리에서",
"날아가서 있는 힘껏 소리쳤다."
],
"30509": [
"「으아아아아!?",
"뭔가 쿠구구궁 하고 있어!」"
],
"30510": [
"「저기, 열어 줘!",
"누가 여기 좀 열어...!?」"
],
"30511": [
"갑자기 유난히 큰 소리가 났나",
"싶더니 발밑의 감각이 사라졌다."
],
"30512": [
"바닥이, 꺼졌다."
],
"30513": [
"그걸 깨닫는 것과 동시에――"
],
"30514": [
"내 의식도 어둡고 먼 곳으로",
"떨어져 갔다......"
],
"30515": [
"...무슨 소리...?"
],
"30516": [
"삐걱, 하는 불길한 울림에 잠이",
"끊겼다."
],
"30517": [
"「...어!?」"
],
"30518": [
"흔들렸어...?",
"방금, 뭔가 흔들렸어..."
],
"30519": [
"「뭐죠, 이 흔들림...!?」"
],
"30520": [
"「뭐, 뭐야? 지진!?」"
],
"30521": [
"황급히 일어나려다",
"손으로 더듬어 안경을 찾는다."
],
"30522": [
"「앗, 뭐.. 뭐야!?」"
],
"30523": [
"낮은 땅울림 같은 소리가 여기저기서",
"들리기 시작하고, 쿵 하고 땅이 기운다."
],
"30524": [
"「으악..!?」"
],
"30525": [
"「나고 씨...!!」"
],
"30526": [
"나도 모르게 이불에 매달렸지만",
"침대에서 내던져지고――"
],
"30527": [
"「――읏!!」"
],
"30528": [
"마지막으로 본 것은, 똑바로",
"떨어져 내리는 천장이었다......"
],
"30529": [
"「내가 같이 있으면서 망볼까?」"
],
"30530": [
"「어? 밤새도록?」"
],
"30531": [
"「응, 그 편이 안전해.",
"일단 범행에 쓰일 만한 물건은",
"처분했지만...」"
],
"30532": [
"「내가 아무것도 놓치지 않았다는",
"보장은 없고, 범인도 꼭 포기해",
"준다는 보장은 없으니까」"
],
"30533": [
"「괘, 괜찮아.",
"어, 그러니까... 봐, 스즈나 짱",
"방 앞 헛간에 숨어 있을게」"
],
"30534": [
"「그게 어디가 괜찮다는",
"근거가 되는데」"
],
"30535": [
"「...일단",
"뒤에서 습격당하진 않을 것 같아」"
],
"30536": [
"「그것뿐이잖아」"
],
"30537": [
"「그럼, 어, 그러니까...」"
],
"30538": [
"「자고 가면?」"
],
"30539": [
"「어, 그러면 헛간에서",
"방이 안 보이는데...」"
],
"30540": [
"「헛간에서 좀 떨어져, 제발」"
],
"30541": [
"「언니도, 그러면 위험해지는 사람이",
"늘어날 뿐이잖아」"
],
"30542": [
"「그렇게 안 되게",
"나도 호위로...」"
],
"30543": [
"「저기, 일단 이래 봬도 시집 안 간",
"꽃다운 처녀라고」"
],
"30544": [
"「일단은 뭐야」"
],
"30545": [
"「거기 태클 걸 때가",
"아니거든」"
],
"30546": [
"「그러니까 헛간...」"
],
"30547": [
"「헛간에서 떨어지라니까...」"
],
"30548": [
"「복도면 되잖아요.",
"방 안에도 둘이 같이 있는 건",
"좋은 방법이라고 봐요」"
],
"30549": [
"「아, 응.",
"복도도 괜찮은데... 어, 히오리?」"
],
"30550": [
"「당신, 갑자기 나타나서",
"부추기지 좀 마.",
"보호자인 주제에...」"
],
"30551": [
"「그치만 이 사람, 이렇게 되면",
"말 안 들어요」"
],
"30552": [
"「내버려 두면 정말 헛간에",
"숨어 있을 텐데, 괜찮아요?」"
],
"30553": [
"「...봐줘」"
],
"30554": [
"「저기, 스즈나 짱.",
"보호자라니...」"
],
"30555": [
"「그럼 주인」"
],
"30556": [
"「훈육 실패했어, 당신」"
],
"30557": [
"「죄송하네요,",
"주운 지 얼마 안 돼서」"
],
"30558": [
"「히오리!!」"
],
"30559": [
"「농담이에요.",
"그럼 시즈나 씨 방에서 자는",
"걸로 괜찮죠?」"
],
"30560": [
"「저랑 나고 씨는 헛간이",
"아니라 복도에서」"
],
"30561": [
"「...언제 정해진 건데」"
],
"30562": [
"「헛간이 좋아요?」"
],
"30563": [
"「그게 아니라!」"
],
"30564": [
"「...스즈, 빨리」"
],
"30565": [
"「앗, 잠깐, 언니!?",
"다, 당기지 마!」"
],
"30566": [
"「아 진짜, 알았으니까!",
"헛간은 관둬, 헛간은~!!」"
],
"30567": [
"「네네, 복도에 있을게요.",
"안녕히 주무세요」"
],
"30568": [
"스즈나 짱은 시즈나 짱에게",
"질질 끌려갔다..."
],
"30569": [
"「자, 나고 씨.",
"우리도 가죠」"
],
"30570": [
"「...괜찮긴 한데」"
],
"30571": [
"「히오리는 언제부터",
"참가하게 된 거였지」"
],
"30572": [
"「필요 없어요?」"
],
"30573": [
"「아니! 필요해!",
"엄청, 아니 혼자 밤새도록",
"복도는 완전 무섭고!」"
],
"30574": [
"「네네, 있을 테니까",
"울상 짓지 마세요」"
],
"30575": [
"「자, 가요.",
"이 제일 안쪽에 있을까요,",
"누가 다가와도 바로 안 들키고」"
],
"30576": [
"「...다루기 쉬운 사람이네」"
],
"30577": [
"「아뇨아뇨.",
"그럼 그쯤에」"
],
"30578": [
"쌍둥이 방이 있는 복도의 제일 안쪽",
"막다른 곳에 쪼그려 앉는다."
],
"30579": [
"「그럼 아침까지 힘내 볼까요」"
],
"30580": [
"벽에 기대어 닫힌 문을",
"바라본다."
],
"30581": [
"（...무사하면 좋겠다..）"
],
"30582": [
"아침이 되어 둘 다 건강하게 여기서",
"나와 준다면..."
],
"30583": [
"（왠지 이것저것 태클 걸어야",
"할 걸 잊은 것 같은",
"기분이 드는데...）"
],
"30584": [
"「저기, 나는 남자니까 괜찮지만",
"언니는 일단 이래 봬도 시집 안 간",
"꽃다운 처녀라고」"
],
"30585": [
"우연이라고 생각한다"
],
"30586": [
"관계있다고 생각한다"
],
"30587": [
"계속될 것 같다"
],
"30588": [
"더는 계속되지 않는다"
],
"30589": [
"관계없다고 생각한다"
],
"30590": [
"생각해 보자"
],
"30591": [
"모자 장수와?"
],
"30592": [
"다카토 노부지로와?"
],
"30593": [
"마다라이 씨와?"
],
"30594": [
"의자 위에 묶여 있었다"
],
"30595": [
"뚱뚱해서 담에서 떨어질 체형"
],
"30596": [
"몸통만 떠 있는 상태"
],
"30597": [
"「히오리는 어떻게 생각해...?」"
],
"30598": [
"「...사건 얘기요?」"
],
"30599": [
"「응...",
"츠바키 군까지 그렇게 되고...」"
],
"30600": [
"「...이 사건 말이야,",
"대체 어떻게 된 걸까」"
],
"30601": [
"「마다라이 씨, 츠바키 씨...",
"설마 나스 씨까지라니...」"
],
"30602": [
"「이렇게 이어지니...」"
],
"30603": [
"「...뭐?」"
],
"30604": [
"「범인 말이야...",
"아직 뭔가 할 생각일까?」"
],
"30605": [
"「나고 씨는 어떻게 생각해요?」"
],
"30606": [
"「모르겠지만,",
"그래도... 불안해서...」"
],
"30607": [
"「원래대로라면...",
"내일 데리러 오는 거지」"
],
"30608": [
"「그럴 예정이었지만",
"길이 저래서야...」"
],
"30609": [
"「계속 구조가 안 오면",
"우리 대체 어떻게 되는 걸까?」"
],
"30610": [
"「저기...",
"아까 뭔가 신경 쓰는 것 같던데?」"
],
"30611": [
"「네? 아, 좀요」"
],
"30612": [
"「뭐였어?」"
],
"30613": [
"「...실은요, 계속",
"신경 쓰이던 게 있었어요」"
],
"30614": [
"「다만 너무 현실감이 없다고",
"할까... 스스로도 너무 앞서",
"생각하는 것 같아서」"
],
"30615": [
"「말을 못 꺼냈는데요,",
"들어 주실래요?」"
],
"30616": [
"「나고 씨는 이 사건이",
"다카토 노부지로의 책과 관계있다고",
"생각해요?」"
],
"30617": [
"「그... 그런...",
"우연이야, 분명」"
],
"30618": [
"「그건 그야말로",
"추리소설도 아니고, 라는",
"얘기잖아」"
],
"30619": [
"「확실히 그렇긴 한데요」"
],
"30620": [
"「...있다고 생각해.",
"왜냐면, 너무...」"
],
"30621": [
"「솔직히 저는 무관하다고는",
"생각할 수 없어요...」"
],
"30622": [
"「우리 배역 이름은 전부 다카토 작품,",
"그것도 같은 시리즈에 나오는",
"등장인물이고」"
],
"30623": [
"「고양이가 나오자마자",
"마다라이 씨가 그렇게 됐잖아요?」"
],
"30624": [
"「시즈나 짱이 고양이는 마다라이 씨라고",
"했던 것처럼, 온실의 그건 다음에",
"누굴 노린다는 뜻인 것 같아?」"
],
"30625": [
"「그런 기분이 들어서 못 견디겠어요.",
"아무튼 마다라이 씨의 그 모습을 볼 때",
"문득 생각했거든요」"
],
"30626": [
"「어, 이런 거 어디선가",
"본 적 있는 것 같다, 하고」"
],
"30627": [
"「뭐!?",
"어, 어디서!?」"
],
"30628": [
"「다시 읽어서 확인했어요.",
"역시 『검은 고양이의 독』이었어요」"
],
"30629": [
"「검은 고양이의... 라니, 그건...」"
],
"30630": [
"「장소나 상황은 다르지만요.",
"식당도 아니고 의자 위도 아니지만",
"그래도...」"
],
"30631": [
"「목과 다리를 각각 묶어 고정하고",
"몸통이 공중에 뜬 듯한 모습은",
"완전히 똑같거든요」"
],
"30632": [
"「그런... 그럼 범인은",
"대체 왜 그런...」"
],
"30633": [
"「...모방 살인이라는 거죠,",
"이래서야」"
],
"30634": [
"「모방... 살인?」"
],
"30635": [
"「시체를 하이쿠나 가사 같은 데",
"빗대서 이상한 모습으로 만들거나",
"장식하는 살인 사건 말이에요」"
],
"30636": [
"「그걸 하고 있다는 거야?",
"이 사건의 범인이?」"
],
"30637": [
"「말도 안 된다고 생각해요?",
"역시 너무 비현실적이라고...」"
],
"30638": [
"「그... 렇네.",
"또 온실에 물건이 놓여 있는",
"이상은... 계속될지도」"
],
"30639": [
"「역시 그렇게 생각하세요」"
],
"30640": [
"「그래도, 그렇다고 해도",
"뭘 어떻게 하면 좋을까?」"
],
"30641": [
"「그런...!",
"계속될 리 없어, 그런 거!」"
],
"30642": [
"「소설 속이라면 모를까,",
"현실에서 그런 짓 하려는 녀석",
"같은 건 보통 없잖아..?」"
],
"30643": [
"「저도 보통은 있을 수 없다고",
"생각하는데요...」"
],
"30644": [
"「그럼 지금 일어나는 이건",
"대체 뭘까 싶어서...」"
],
"30645": [
"「황당무계한 얘기라는 건",
"알고 있지만요」"
],
"30646": [
"「시체가 그렇게 돼 있는 만큼",
"한 번은 다카토 노부지로의 책과",
"엮어서 생각해 보면 어떨까 싶어요」"
],
"30647": [
"「과... 관계없다니까!",
"정말로 모방이니 뭐니",
"하고 있다면 말이야...」"
],
"30648": [
"「다음에 뭘 하려는지 이쪽에",
"들킬 위험이 있으니까, 범인한텐",
"불리해질 뿐이잖아」"
],
"30649": [
"「...그야 뭐」"
],
"30650": [
"「진심으로 복수를 생각한다면",
"그런 바보 같은 짓은 안 하겠지」"
],
"30651": [
"「너무 앞서가는 거야, 범인은 분명",
"우리를 겁주려고 이상한 짓을",
"하는 것뿐이라니까!」"
],
"30652": [
"「...확실히, 뭘 위해서",
"하는 건지 모르니까",
"혼란스럽긴 하네요...」"
],
"30653": [
"「그렇지?",
"뭔가 의미가 있다면",
"그거라고 생각해」"
],
"30654": [
"「그런가...",
"음, 그럴지도 모르겠네요」"
]
}