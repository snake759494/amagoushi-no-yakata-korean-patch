"10020": [
"「방 안엔 이걸 꽂을 만한",
"구멍이 없었으니까",
"그건 다른 장소라는 걸까」"
],
"10021": [
"「...빼 둬도",
"괜찮은 걸까요」"
],
"10022": [
"「...글쎄...」"
],
"10023": [
"「뭐, 크기로 보아 상당히",
"큰 물건이겠지만, 어디에도",
"그런 큰 게 고장 난 건 없고...」"
],
"10024": [
"「그, 그렇지, 응」"
],
"10025": [
"...그래도 정말 어디에 쓰는 걸까."
],
"10026": [
"「응접실에 이상한 가면이",
"장식돼 있지」"
],
"10027": [
"「...아아, 있죠.",
"왠지 다른 장식에서 그것만",
"묘하게 튄다 싶었어요」"
],
"10028": [
"「그렇지.",
"다른 가구나 그림은 유럽의",
"오래된 물건 느낌인데...」"
],
"10029": [
"「그것만 뭔가 다르죠.",
"뭐, 전 싫지 않습니다만」"
],
"10030": [
"「그, 그래?」"
],
"10031": [
"「저런, 왠지 보고 있어도",
"질리지 않는 건 좋아합니다」"
],
"10032": [
"「흐응...?」"
],
"10033": [
"「저기, 이거 본 적 있어?」"
],
"10034": [
"「그건...",
"쿠라이시 씨 거 아닙니까」"
],
"10035": [
"「윗옷 가슴 주머니에",
"늘 꽂고 있던 거",
"같은데요」"
],
"10036": [
"「그렇지, 역시」"
],
"10037": [
"「그건 어디에?」"
],
"10038": [
"「뒷마당에 떨어져 있었어.",
"쿠라이시 씨 방 바로 아래쯤」"
],
"10039": [
"「쿠라이시 씨는 그 뒤로",
"저택 밖엔 거의 안 나갔을",
"테니까...」"
],
"10040": [
"「떨어뜨렸다면",
"방 창문에서?」"
],
"10041": [
"「왠지 묘한 느낌이네요.",
"불길한 느낌이랄까...」"
],
"10042": [
"「오락실 데크에 이 테이프가",
"들어 있었어」"
],
"10043": [
"「뭡니까, 그게?」"
],
"10044": [
"「산사태 뉴스가 녹음돼",
"있는데, 우리가 라디오로",
"들은 거랑 다른 것 같아」"
],
"10045": [
"「다르다니, 그럼 그건...」"
],
"10046": [
"「진짜 뉴스가 아닌 게",
"아닐까 싶은데」"
],
"10047": [
"「...그렇군요」"
],
"10048": [
"「그걸 틀어서 우리가 벼랑이 무너진",
"줄 믿게 해서 발을 묶으려던",
"거였다는 겁니까」"
],
"10049": [
"「설마 그렇게 딱 맞게 진짜로",
"벼랑이 무너질 줄은 몰랐겠지」"
],
"10050": [
"「그렇겠죠.",
"그 말은, 진짜로 무너진 건",
"범인도 예상 밖이었다는 거군」"
],
"10051": [
"「그렇게 되지.",
"그래서 차까지 펑크 내서",
"못 쓰게 한 거고」"
],
"10052": [
"「...뭐, 알고는 있었지만",
"역시 처음부터 전부 계획대로",
"였다는 거네요...」"
],
"10053": [
"「우연히 벼랑이 무너져서",
"이런 일을 시작한 게 아니라」"
],
"10054": [
"「...응.",
"그렇겠지....」"
],
"10055": [
"저택이 갇힌 게 방아쇠가",
"된 게 아니라...."
],
"10056": [
"범인은 처음부터 모두를 여기서",
"내보낼 생각이 없었던 거다."
],
"10057": [
"「이거 무슨 꽃일까?",
"온실에 있었는데...」"
],
"10058": [
"「...?",
"뭘까요, 잠깐만 기다려 보십쇼」"
],
"10059": [
"고개를 갸웃한 히오리는 원서만",
"꽂힌 책장에서 두꺼운 책을 뽑는다."
],
"10060": [
"「사전 같은 거 있어?」"
],
"10061": [
"「네, 분명 이거였을...」"
],
"10062": [
"「아아, 이거네요.",
"지금 피어 있다는 건",
"이쯤 실려 있을 것 같은데요」"
],
"10063": [
"「...이건가?」"
],
"10064": [
"「어디 보자...",
"아, 정말이다, 같은 것 같아.",
"G, I, N... 진저?」"
],
"10065": [
"「...진저 릴리",
"라고 하네요」"
],
"10066": [
"「진저면 생강이지?」"
],
"10067": [
"「네 뭐, 그럴 텐데요...」"
],
"10068": [
"「그런데 왜 그런 게 온실에,",
"그것도 『복수』 옆에 있었을까?」"
],
"10069": [
"「왜일까요.",
"영문을 모르겠네...」"
],
"10070": [
"「음...",
"비슷하지만 다른 꽃일지도",
"모르겠네요」"
],
"10071": [
"「아아, 그럴지도.",
"다른 사람에게도 물어볼까」"
],
"10072": [
"「그렇게 하십쇼.",
"저로선 확실히 이 꽃인지",
"어떤지도 미심쩍으니」"
],
"10073": [
"「나도...」"
],
"10074": [
"「저기, 임프라고 했던가",
"나스 씨가 이상한 데서 본",
"차 안에 매달려 있던 거」"
],
"10075": [
"「네, 맞아요」"
],
"10076": [
"「...그런 걸",
"매달 것 같은 사람이라면",
"아무래도 시쿠라 씨 같네요」"
],
"10077": [
"「오컬트 마니아",
"였으니까요」"
],
"10078": [
"「...그럼 역시",
"시쿠라 씨가 차로 여기까지",
"왔었다는 걸까...」"
],
"10079": [
"「그럴 가능성이 높다고 봅니다」"
],
"10080": [
"「방 열쇠에 뭔가",
"알파벳 새겨져 있지 않아?」"
],
"10081": [
"「아아, 있습니다.",
"제 방은 『C』입니다」"
],
"10082": [
"「C구나, 고마워」"
],
"10083": [
"「그 암호 말입니까?",
"츠바키 씨 얘기만 들으면 그렇게",
"어려운 건 아니니까..」"
],
"10084": [
"「...라고 쓸데없는 말은",
"안 하는 게 좋겠네요」"
],
"10085": [
"「히오리, 풀었어?」"
],
"10086": [
"「네, 전 도착하자마자",
"해치웠거든요」"
],
"10087": [
"「뭐, 이건 저택 주인이 만든",
"여흥일 테니까",
"머리 식힐 겸 즐기십쇼」"
],
"10088": [
"「응, 그럴게」"
],
"10089": [
"「나, 지하도 아닌데",
"휴대폰 안 터지는 곳은",
"처음 와 봐...」"
],
"10090": [
"「이런,",
"그랬습니까」"
],
"10091": [
"「그럼",
"왠지 안절부절못하겠네요」"
],
"10092": [
"「응....",
"이상하지, 휴대폰 같은 건",
"쓰기 시작한 지 얼마 안 됐는데」"
],
"10093": [
"「한번 익숙해지면",
"그런 법이죠」"
],
"10094": [
"「저도 처음 전파가 전혀 안",
"닿는 곳에 갔을 땐",
"괜히 불안했습니다」"
],
"10095": [
"「어떤 곳이었어?",
"여기처럼 깊은 산속?」"
],
"10096": [
"「외딴섬입니다.",
"세토 내해의 작은 섬이죠」"
],
"10097": [
"「배도 며칠에 한 번인가밖에",
"안 오는 곳이었죠」"
],
"10098": [
"외딴섬이라....",
"그런 곳에서 지금 같은 폭풍이",
"오면 곤란하겠지."
],
"10099": [
"「히오리는 여기까지",
"택시로 왔었지」"
],
"10100": [
"「어디서 탔어?",
"오는 길에 역 근처 지났는데",
"그쪽?」"
],
"10101": [
"「아마 거기일 겁니다.",
"여기까진 전철이었으니까요」"
],
"10102": [
"「택시 승강장이 있어서",
"금방 탔죠」"
],
"10103": [
"「그러고 보니 택시 몇 대가",
"줄지어 선 곳이 있었던",
"것 같네...」"
],
"10104": [
"「있잖아, 아카시야키는",
"열광적인 팬이 있을 만한",
"음식일까...」"
],
"10105": [
"「뭔가 엄청나게",
"고집 있는 사람이 쓴 것",
"같은 책이 있어서」"
],
"10106": [
"「...잘은 모르겠지만",
"뭐든 마니아라는 건",
"있으니까요...」"
],
"10107": [
"「히오리,",
"수제 햄버그 만들 줄 알아?」"
],
"10108": [
"「네, 뭐 잘하는 편입니다.",
"드시고 싶습니까?」"
],
"10109": [
"「아니, 만드는 법 쓴 책이",
"있어서 물어본 것뿐이야.",
"게다가 여기선 무리잖아?」"
],
"10110": [
"「다진 고기가 없었을지도",
"모르겠네요」"
],
"10111": [
"「두부도 없었으려나...」"
],
"10112": [
"「왜 두부?」"
],
"10113": [
"「제일 잘하는 요리가",
"아게다시 두부라서요」"
],
"10114": [
"「아, 아재 취향이네」"
],
"10115": [
"「그렇습니까?」"
],
"10116": [
"「그치만 그거, 돌아가신",
"우리 할아버지랑 똑같아」"
],
"10117": [
"「호오, 그건...",
"그러고 보니 나고 씨 본가가",
"두부 가게라고 하셨죠」"
],
"10118": [
"「응, 서민 동네 작은 가게",
"지만」"
],
"10119": [
"「어머님도 역시",
"두부 요리 잘하십니까?」"
],
"10120": [
"「그게...",
"우리 엄마는 요리시키면",
"족족 태우는 사람이라」"
],
"10121": [
"「아빠가 더 잘하려나,",
"요리도 바느질도...」"
],
"10122": [
"「...나고 씨",
"혹시 어머니 닮았습니까」"
],
"10123": [
"「아게다시 두부",
"평소에도 자주 만들어?」"
],
"10124": [
"「그렇죠,",
"내킬 때 종종",
"만드는 편입니다」"
],
"10125": [
"「저도 좋아하고",
"술에 잘 맞으니까요」"
],
"10126": [
"「...술도 셀 것 같네, 히오리」"
],
"10127": [
"「세다고 할 정도는",
"아닙니다.",
"보통 아닐까요」"
],
"10128": [
"「전혀 못 마시는 것보단 낫잖아.",
"곤란해, 못 마시면...」"
],
"10129": [
"「...약하시군요」"
],
"10130": [
"「가족 중에 나만",
"술을 못 해.",
"누굴 닮은 건지...?」"
],
"10131": [
"「뭐, 뭐어 못 마셔도",
"두부는 맛있으니까요」"
],
"10132": [
"「무사히 산 내려가면",
"언제 한번 요리 대접하죠」"
],
"10133": [
"「응, 고마워.",
"두부라면 우리 집에",
"얼마든지 있으니까...」"
],
"10134": [
"「...그래도, 되도록",
"누나 없는 날로",
"하자...」"
],
"10135": [
"「왜요?」"
],
"10136": [
"「그런 술이 술술 들어갈",
"요리가 있는 데 있으면",
"무슨 일이 생길지...」"
],
"10137": [
"「술버릇이 나쁩니까」"
],
"10138": [
"「발바닥이랑 허리랑 관자놀이에",
"아직 상처가 남아서...」"
],
"10139": [
"어지간히 얼굴이 굳어 있었는지",
"히오리는 더는 묻지 않았다."
],
"10140": [
"(물어봐도 사실 기억은",
"안 나지만.",
"기절해 있었으니까...)"
],
"10141": [
"「히오리는 담배 안 피우네」"
],
"10142": [
"「네, 평소엔요.",
"피울 때도 있습니다, 집에선」"
],
"10143": [
"「그래?」"
],
"10144": [
"「가끔이지만요.",
"안 피워도 딱히 어떻다",
"할 건 없고」"
],
"10145": [
"「흐응?",
"그런 사람도 있구나」"
],
"10146": [
"「뭐, 제 건 담배를",
"피우고 싶다기보단",
"심심풀이 대신이라서요」"
],
"10147": [
"「대개 애연가라 하면",
"쿠라이시 씨 같은 사람이",
"많겠죠」"
],
"10148": [
"「그렇지.",
"우리 부모님도 그렇고」"
],
"10149": [
"「지하에 있는 와인 마셨어?」"
],
"10150": [
"「아뇨, 전 안 마셨습니다.",
"싫어하는 건 아닌데",
"전 어느 쪽이냐면 청주 쪽이라」"
],
"10151": [
"「청주는... 없을 것 같네」"
],
"10152": [
"「부엌 봤는데",
"없더군요」"
],
"10153": [
"「있잖아...",
"이 집, 접사다리는 없지?」"
],
"10154": [
"「접사다리는 그러고 보니 못 봤네요.",
"뭐에 쓰시게요?」"
],
"10155": [
"「아니,",
"왠지 사진집이 있어서」"
],
"10156": [
"「하아, 뭐의 사진집요?」"
],
"10157": [
"「그러니까, 접사다리의」"
],
"10158": [
"「...접사다리의?」"
],
"10159": [
"「이 저택 사람 말이야,",
"뭐랄까 역시...」"
],
"10160": [
"「...특이한 사람이네요」"
],
"10161": [
"「헛간에 하얀 우산이",
"들어 있었는데」"
],
"10162": [
"「우산 말입니까?」"
],
"10163": [
"「여자가 쓰는",
"양산 같았어」"
],
"10164": [
"「그 말은, 이 저택엔",
"평소 여자가 없는 걸까요」"
],
"10165": [
"「그럴지도」"
],
"10166": [
"「2층 창고에서 와인잔을",
"찾았는데」"
],
"10167": [
"「와인잔?",
"아아, 모방의 그거 말입니까」"
],
"10168": [
"「응, 『호숫가의 관』의」"
],
"10169": [
"「그건 숨겼는데,",
"좀 걱정되는 게...」"
],
"10170": [
"「와인잔이란 게",
"그런 모양이 맞는",
"건가 싶어서」"
],
"10171": [
"「바닥이 둥근 거 맞지?",
"삼각형에 가느다란 게 아니라」"
],
"10172": [
"「어디 보자...",
"그건 칵테일 잔",
"아닐까 싶은데요」"
],
"10173": [
"「아, 그렇구나.",
"그럼 괜찮네」"
],
"10174": [
"「...괜찮습니다」"
],
"10175": [
"왠지 흐뭇한 걸",
"지켜보는 듯한 눈으로 보는",
"것 같다...."
],
"10176": [
"「평소엔 어떤 연극에 나와?」"
],
"10177": [
"「글쎄요,",
"이것저것 나왔지만",
"사극이 많죠」"
],
"10178": [
