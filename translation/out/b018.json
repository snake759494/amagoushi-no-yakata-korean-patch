],
"9751": [
"「비밀 통로 말입니까?」"
],
"9752": [
"「응, 입구는",
"모르게끔",
"숨겨져 있었고...」"
],
"9753": [
"「누가 숨어 있거나",
"하진 않겠죠」"
],
"9754": [
"「무서운 소리 하지 마!」"
],
"9755": [
"「아니, 그치만...」"
],
"9756": [
"「숨어 있진 않더라도",
"거길 지나면 밖에서 저택에",
"몰래 들어올 수 있나 싶어서...」"
],
"9757": [
"「뭐!?",
"아, 그래도 밖에서라면",
"발자국 남아, 비 오니까」"
],
"9758": [
"「아아, 그렇군.",
"그런 발자국은",
"없었던 거죠?」"
],
"9759": [
"「응, 안 보였어」"
],
"9760": [
"「...그래도 만약을 위해",
"어디서 어디로 통하는지는",
"되도록 전부 조사해 둘게」"
],
"9761": [
"「혼자서 괜찮겠습니까?」"
],
"9762": [
"「아니, 무섭지만」"
],
"9763": [
"「...같이 갈까요」"
],
"9764": [
"「그래도 둘 다 없는 동안",
"여기서 무슨 일 생기면 싫고」"
],
"9765": [
"「음...",
"확실히 그렇지만요」"
],
"9766": [
"「한 명은 남아 있는 게",
"좋을 것 같아, 역시」"
],
"9767": [
"「그렇네요....",
"그럼 혹시 위험하다 싶으면",
"바로 도망쳐 오십쇼」"
],
"9768": [
"「응, 물론이지.",
"인기척이라도 나면",
"전속력으로 도망칠게」"
],
"9769": [
"「그렇게 하십쇼.",
"그래야 저도 안심입니다」"
],
"9770": [
"「있잖아, 마당 우물에",
"물이 있을까」"
],
"9771": [
"「우물?」"
],
"9772": [
"「봐, 그 온실 옆에 있는 거」"
],
"9773": [
"「...아아, 그러고 보니",
"있었죠」"
],
"9774": [
"「말라 있을지도 모르겠네요,",
"딱 봐도 낡아 있었으니」"
],
"9775": [
"「여기 방 이름은",
"누가 붙였을까?」"
],
"9776": [
"「비교적 최근 사람이겠죠.",
"지금 주인이라든가」"
],
"9777": [
"「전부 작가 이름인데",
"꽤 최근 사람도 들어 있으니까요」"
],
"9778": [
"「해리스라든가.",
"다만, 그건 추리 소설에",
"넣어도 되는 건지」"
],
"9779": [
"「뭔가 달라?」"
],
"9780": [
"「어느 쪽이냐 하면",
"서스펜스 아닌가",
"싶은데 말이죠」"
],
"9781": [
"「왜 그게 들어 있고",
"맥거라든가 갤리코라든가는",
"안 들어 있는 건지」"
],
"9782": [
"「아아, 죄송합니다.",
"혼잣말이니까",
"신경 쓰지 마십쇼」"
],
"9783": [
"뭔가 고집이 있는 모양이다..."
],
"9784": [
"「그 궤짝, 처음부터 안에",
"아무것도 없었던가」"
],
"9785": [
"「안의 물건을 꺼내 치운 흔적은",
"없으니, 비어 있었던 거",
"아닐까 싶은데요」"
],
"9786": [
"「나스 씨가 마신 차는",
"여기 부엌에 있던 거지?」"
],
"9787": [
"「그렇죠.",
"냉장고에 같은 게 있는 걸",
"본 기억이 있습니다」"
],
"9788": [
"「히오리, 같은 거 마셔 봤어?」"
],
"9789": [
"「전 늘 뜨거운 걸 우려서",
"마셨으니까,",
"찬 건 안 마셨습니다」"
],
"9790": [
"「그렇구나, 그러고 보니 늘",
"식사 때 차 끓여 줬지」"
],
"9791": [
"「독약은 범인이 미리",
"가져온 걸까」"
],
"9792": [
"「아무렴 그렇겠죠.",
"보통 집 안에 그런 걸",
"상비해 두진 않을 테고」"
],
"9793": [
"「그렇지」"
],
"9794": [
"「...범인은",
"아직 갖고 있을까」"
],
"9795": [
"「글쎄요....",
"아무래도 살해 방법을 처음부터",
"정해 둔 것 같으니, 그것뿐일지도」"
],
"9796": [
"「나스 씨 차에 넣은 분량뿐",
"이었다는 거야?」"
],
"9797": [
"「짐 같은 걸 조사당해 들키면",
"한 방에 범인인 게 드러나니까요」"
],
"9798": [
"「그렇네....",
"따로 독살하기로 정한 사람이",
"없다면, 그것뿐일지도...」"
],
"9799": [
"「쿠라이시 씨 옆에 있던 그림은",
"응접실에 있던 거지?」"
],
"9800": [
"「아마 그럴 겁니다.",
"장미 그림이 걸려 있던 건",
"그 방뿐이었을 테니까요」"
],
"9801": [
"「쿠라이시 씨의... 그...",
"화살은 활의 화살이지...」"
],
"9802": [
"「그런 걸",
"어디에 있었던 걸까요」"
],
"9803": [
"「언뜻 보이는 곳에는",
"안 보이고...」"
],
"9804": [
"「범인이 가져왔다고 생각해?」"
],
"9805": [
"「가져온 게 아니라면",
"범인은 어째선지 활이 이 저택",
"어딘가에 있는 걸 알았단 겁니다」"
],
"9806": [
"「...그렇지」"
],
"9807": [
"그런 걸 어떻게 알지...?"
],
"9808": [
"「그 도끼, 온실의 예고에",
"놓여 있던 거지...」"
],
"9809": [
"「범행 예고에 쓴 물건을 흉기로는",
"안 쓸 거라 생각했는데...」"
],
"9810": [
"「그 도끼, 오락실에",
"있던 거지...」"
],
"9811": [
"「벽에 걸려 있던 거겠죠.",
"가짜인 줄 알았는데...」"
],
"9812": [
"「그거 효과 있을까.",
"테루테루보즈」"
],
"9813": [
"「있으면 좋겠네요.",
"좀 지나치게 큰 것 같지만」"
],
"9814": [
"「한밤중에 보면",
"기겁할 것 같아...」"
],
"9815": [
"「처음엔 계단 홀에",
"있었다던데」"
],
"9816": [
"「다행이네요 나고 씨",
"한밤중에 방에서 안 나와서」"
],
"9817": [
"「그런 게 매달린 걸 봤으면",
"비명 질렀겠죠」"
],
"9818": [
"「응, 울어」"
],
"9819": [
"「.....우는 겁니까」"
],
"9820": [
"「그치만 무섭잖아,",
"한밤중에 그런 거랑 마주치면」"
],
"9821": [
"「네네...」"
],
"9822": [
"「웃지 마!",
"히오리도 한밤중에 그런 거랑",
"마주치면 놀랄 거잖아!?」"
],
"9823": [
"「놀라긴 하겠죠.",
"실제로 마주친 츠바키 씨는",
"꽤 놀란 모양이고」"
],
"9824": [
"「그렇다니까, 보통 놀라지」"
],
"9825": [
"「그 말은, 적어도",
"마다라이 씨는 마주치지",
"않았다는 거겠네요...」"
],
"9826": [
"「아...!」"
],
"9827": [
"「그렇구나, 만약 마다라이 씨가",
"그런 걸 봤으면...」"
],
"9828": [
"「난리 났겠죠.",
"큰 시계 소리에 놀랐을 때도",
"펄쩍 뛰며 비명 질렀으니」"
],
"9829": [
"「즉, 마다라이 씨가",
"방을 나와 식당에 간 건",
"23시 15분쯤인가...」"
],
"9830": [
"「...23시 30분보다",
"뒤라는 얘기가 되네요」"
],
"9831": [
"――23시 30분....",
"계단 홀에서 테루테루보즈가",
"사라진 시간...."
],
"9832": [
"「...아, 그래도",
"나스 씨가 계단 홀에서",
"마다라이 씨 같은 그림자 봤다고」"
],
"9833": [
"「아아, 그렇군.",
"그게 바로 테루테루보즈를",
"매달던 때니까요」"
],
"9834": [
"「그 전에 계단을 내려갔으면",
"마다라이 씨가 테루테루보즈를",
"볼 일은 없는 셈이군」"
],
"9835": [
"「그렇지...」"
],
"9836": [
"마다라이 씨 체형은 멀리서도",
"다른 사람으로 잘못 볼 일은",
"거의 없을 테니까...."
],
"9837": [
"「온실에 있던 『복수』라고",
"쓰인 종이 말인데」"
],
"9838": [
"「아아, 그거 말입니까.",
"언제 놓은 걸까요」"
],
"9839": [
"「히오리가 왔을 땐 아직",
"그런 거 없었어?」"
],
"9840": [
"「온실은 안 들여다봤어요,",
"그때 들어간 게 처음이라」"
],
"9841": [
"「온실에 있던 고양이 장식품,",
"비슷한 거 어디서 본 적 있어?」"
],
"9842": [
"「본 기억은 없지만...",
"요즘은 천 원 숍에서도 팔 것",
"같은 물건이긴 하죠」"
],
"9843": [
"「그러고 보니 천 원 숍에",
"이상한 장식품 파는 곳 있지」"
],
"9844": [
"그렇다면 어디서든 구할 수 있는",
"물건이란 건가...."
],
"9845": [
"「전화가 통하면",
"좀 더 안심될 텐데」"
],
"9846": [
"「휴대폰도 몇 번 해 봤는데",
"역시 밖으론 안 통하네요」"
],
"9847": [
"「내 것도 계속 권외야」"
],
"9848": [
"「오락실 라디오는",
"계속 켜 놓고 들었어?」"
],
"9849": [
"「아뇨...",
"그러고 보니 첫날은 아무도",
"안 건드리지 않았나 싶네요」"
],
"9850": [
"「그럼 그때... 마다라이 씨를",
"찾고 식당에서 돌아온 뒤 쿠라이시",
"씨가 켠 게 처음이야?」"
],
"9851": [
"「적어도 전 그 전에",
"켜져 있던 기억은 없습니다」"
],
"9852": [
"「전 신경도 안 썼으니까요.",
"이런 소동이 없었으면 아무도",
"안 건드렸을지도 모르죠」"
],
"9853": [
"「현관 로비의 큰 시계 대단하다.",
"외국 영화 같아」"
],
"9854": [
"「전 그 소리 좋아했는데요.",
"마다라이 씨가 시끄럽다고",
"불평을 해서...」"
],
"9855": [
"의외로 신경질적이었나,",
"마다라이 씨...."
],
"9856": [
"「온실에 있던 벨은",
"무슨 뜻이라고 생각해?」"
],
"9857": [
"「역시 검은 고양이처럼",
"뭔가를 암시하는 거라고",
"생각하는데요...」"
],
"9858": [
"「그렇다면 범인이",
"벨로서 놓은 건지 범종인지에",
"따라 답이 달라지겠네」"
],
"9859": [
"「...만약",
"『검은 고양이의 독』처럼",
"다카토 작품이라면」"
],
"9860": [
"「벨이란 건 작중에 나온",
"기억이 없네요.",
"종이나 범종이라면 몰라도」"
],
"9861": [
"「그렇구나, 종이라...」"
],
"9862": [
"「온실에 있던 벨은",
"범인이 가져온 걸까」"
],
"9863": [
"「그렇겠죠.",
"이 집에 있던 거라기엔",
"아무래도 싸구려 느낌이고」"
],
"9864": [
"「원래 장식용이라 소리도 안 나는",
