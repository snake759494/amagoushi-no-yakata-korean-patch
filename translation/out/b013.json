"7438": [
"갑자기 울음을 터뜨리는가 싶더니,",
"시즈나 짱은 자기 방으로",
"달려 돌아갔다."
],
"7439": [
"「...?」"
],
"7440": [
"「방금 그게 시즈나",
"씨였습니까?」"
],
"7441": [
"「기모노는 스즈나 짱 거지만",
"시즈나 짱이야」"
],
"7442": [
"「...네...?",
"저기, 어째서 그런...」"
],
"7443": [
"「어쨌든 가 봅시다.",
"저건 예삿일이 아니겠어요」"
],
"7444": [
"「방은 열려 있는 것 같은데...」"
],
"7445": [
"종종걸음으로 쫓아간 히오리가 중얼거린다.",
"나도 뒤따라갔다."
],
"7446": [
"「...뭐지, 이 냄새...」"
],
"7447": [
"히오리도 같은 걸 알아챘는지,",
"얼굴을 찌푸리며 한 발짝 방에 들어선다.",
"덩달아 나도..."
],
"7448": [
"「시이짱... 왜...",
"왜에...?」"
],
"7449": [
"순간, 무엇인지 이해할 수 없었다.",
"내 발밑에서 시즈나 짱이 주저앉아",
"흐느끼고 있다."
],
"7450": [
"「나고 씨!」"
],
"7451": [
"스르르, 온몸의 힘이 빠져",
"쓰러질 뻔한 순간",
"뒤에서 누가 붙잡아 주었다."
],
"7452": [
"「스, 스즈나 짱... 이...」"
],
"7453": [
"「스즈나가 아니야...",
"시노부야...」"
],
"7454": [
"「...본명...?」"
],
"7455": [
"「시노부란 말이야...",
"시노부... 왜...」"
],
"7456": [
"「왜냐고!?",
"왜 이런...!」"
],
"7457": [
"착란한 시즈나 짱이",
"손바닥으로 내 뺨을 후려쳤다."
],
"7458": [
"「이런...!",
"시즈나 씨, 진정해요...」"
],
"7459": [
"「싫어!",
"이제 싫어, 나가!」"
],
"7460": [
"「다 싫어...!",
"싫단 말이야!!」"
],
"7461": [
"흐느끼며, 시즈나 짱이",
"내 몸을 방에서 억지로",
"밀어내려 하고 있었다."
],
"7462": [
"「싫어... 이제 싫어...!」"
],
"7463": [
"슬슬 괜찮을지도.",
"시즈나 짱도 일어날지",
"모르니까 돌아갈까."
],
"7464": [
"(...아야야...)"
],
"7465": [
"계속 바닥에 앉아 있었더니",
"허리가 아프다..."
],
"7466": [
"갑자기 등 뒤에서 문 열리는 소리가 나서",
"펄쩍 뛸 뻔했다."
],
"7467": [
"(...어?)"
],
"7468": [
"(스즈라니, 저게 시즈나 짱",
"이라고...?)"
],
"7469": [
"스즈나 짱 방에서 나왔고",
"옷 색깔도..."
],
"7470": [
"(...아)"
],
"7471": [
"(그래, 한밤중에...!)"
],
"7472": [
"둘이 같이 나왔을 때...",
"그때..."
],
"7473": [
"(...바꿔치기한 거구나!)"
],
"7474": [
"「스즈~, 일어나~」"
],
"7475": [
"(전혀 몰랐어...)"
],
"7476": [
"(시즈나 짱네 나름대로",
"경계해서 범인 눈을 속이려고",
"했던 거야...)"
],
"7477": [
"「...아직 자는 거야?」"
],
"7478": [
"「스즈...」"
],
"7479": [
"방 안에서 이상한 소리가 났다.",
"놀라서 나도 모르게 복도를 되돌아가자",
"앞에서 시즈나 짱이 달려왔다."
],
"7480": [
"「...당신?」"
],
"7481": [
"...기이한 표정이었다.",
"아니, 표정이라기보다 모든 감정이",
"죽어 버린 듯 굳은 얼굴..."
],
"7482": [
"「어, 저기, 무... 무슨...」"
],
"7483": [
"「시... 시노부, 한테...」"
],
"7484": [
"「시노부?",
"시노부가 누구...?」"
],
"7485": [
"「...읏... 시이... 짜...」"
],
"7486": [
"「시즈나 짱...?」"
],
"7487": [
"「시이... 시이, 짜...」"
],
"7488": [
"「앗, 시즈나 짱!?」"
],
"7489": [
"갑자기 울음을 터뜨린 시즈나 짱은",
"나를 밀치고 달려갔다."
],
"7490": [
"「무슨 일이야!?",
"시즈나 짱이라니...!」"
],
"7491": [
"뒤를 쫓아, 반쯤 열린 채인",
"시즈나 짱의 방에 뛰어든 나는",
"너무나 끔찍한 광경에 얼어붙었다."
],
"7492": [
"「시이짱...",
"왜, 왜... 왜...?」"
],
"7493": [
"발밑에 주저앉은 채 흐느끼는",
"시즈나 짱."
],
"7494": [
"그리고..."
],
"7495": [
"「...뭐...」"
],
"7496": [
"(...뭐야, 이거...)"
],
"7497": [
"(시즈나 짱... 은...",
"여기 있으니까...)"
],
"7498": [
"그렇다면, 저건...",
"저, 침대 위에 있는 건..."
],
"7499": [
"(...스... 스즈나 짱...?)"
],
"7500": [
"「스, 스즈나 짱이」"
],
"7501": [
"「스즈나 씨?",
"스즈나 씨란 말입니까?」"
],
"7502": [
"「――아니야」"
],
"7503": [
"「시노부... 란 말이야.",
"우리... 시이짱...」"
],
"7504": [
"「...본명... 입니까?」"
],
"7505": [
"「시노부...",
"왜, 왜 시이짱이...",
"이런...」"
],
"7506": [
"「이제 싫어... 싫다고!",
"나가, 다 싫어...!!」"
],
"7507": [
"시즈나 짱이 반쯤 미쳐 소리치는",
"목소리가 멀리서 들린다."
],
"7508": [
"「아, 알았으니까",
"진정하세요...」"
],
"7509": [
"「나가아...!!」"
],
"7510": [
"「당분간, 가만히 놔두는",
"게 좋지 않을까...」"
],
"7511": [
"「알겠습니다.",
"그, 그 표는 어떻게 할까요?」"
],
"7512": [
"「...음,",
"시즈나 짱이 일어난 시간?」"
],
"7513": [
"(...방에 있을 거야,",
"그렇지...?)"
],
"7514": [
"시즈나 짱의 방 앞까지 왔지만,",
"문 너머에선 아무 소리도 안 난다."
],
"7515": [
"...소리도 없이 울고 있는지도.",
"지금은 섣불리 찾아가지",
"않는 게 좋겠지..."
],
"7516": [
"(이쪽 방에서 베란다를",
"지나 시즈나 짱의 방으로",
"가는 건 무리구나...)"
],
"7517": [
"...하지만, 이제...",
"그게 뭔지 알아 봤자 이미",
"늦었을지도 모르지만..."
],
"7518": [
"츠바키 군과, 마다라이 씨,",
"그리고 쌍둥이가 없다."
],
"7519": [
"「그래도, 저...",
"대체, 왜 스즈나 씨가...」"
],
"7520": [
"「...뭐, 그 이전에",
"죽은 게 정말 동생 쪽인지도",
"모르는 모양이지만...」"
],
"7521": [
"「방이랑 기모노는 언니 쪽",
"거였다며」"
],
"7522": [
"「그... 그렇, 지만...」"
],
"7523": [
"「...살아 있는 쪽 아이가",
"죽은 쪽을 '시노부'라고",
"부르던데...」"
],
"7524": [
"「누구, 그 아가씨들",
"본명 아시는 분 있습니까?」"
],
"7525": [
"「아, 저기...",
"분명 시즈나 씨 본명은",
"아야메 씨였을 거예요」"
],
"7526": [
"「그럼, 죽은 시노부 짱이",
"스즈나 짱이라는 거네」"
],
"7527": [
"「뭐, 살아 있는 쪽이",
"그렇게 주장할 뿐이지만」"
],
"7528": [
"「그런...",
"그건 도저히 연기가...」"
],
"7529": [
"「의심 안 할 이유가 있나」"
],
"7530": [
"쿠라이시 씨 말에 아무도 반론 못 하고,",
"무겁게 입을 다문다."
],
"7531": [
"거북했는지 나스 씨가",
"머뭇머뭇 입을 열었다."
],
"7532": [
"「...저기 말이야,",
"그 애, 언제 살해당한 거야?",
"어젯밤이겠지만...」"
],
"7533": [
"「그럼, 노려지지 않은 건",
"이제 4명뿐이잖아」"
],
"7534": [
"「그야 뭐, 제 이름은",
"순서고 뭐고 시리즈 전부에",
"나오니까요」"
],
"7535": [
"「어라? 4명?",
"나고무 군도 들어가?」"
],
"7536": [
"「확인한 건 아니잖아.",
"길 잃었다고 하는 건 본인",
"뿐이지」"
],
"7537": [
"「...그래도 한 명 많지 않아?」"
],
"7538": [
"「쌍둥이 한쪽도 살아 있어.",
"빼놓을 수는 없지」"
],
"7539": [
"「...죽일 거야」"
],
"7540": [
"불온한 목소리에 돌아보니,",
"어느새 거기에 시즈나 짱이",
"서 있었다."
],
"7541": [
"마치 유령처럼 불안정하게",
"흔들흔들하면서..."
],
"7542": [
"「...누가 그랬어」"
],
"7543": [
"「시... 시즈나 씨...」"
],
"7544": [
"「시이짱... 죽인 사람」"
],
"7545": [
"「...내가, 죽일 거야...!」"
],
"7546": [
"갑자기, 고양이처럼 덤벼든",
"시즈나 짱이 온 힘으로 내 목을 조른다."
],
"7547": [
"「읏... 시, 즈... 나 짱...」"
],
"7548": [
"「시즈나 씨!",
"진정해요... 라고 해도 무리겠군」"
],
"7549": [
"「자기 방에 처넣어!",
"진정할 때까지 위태로워서",
"못 보겠다」"
],
"7550": [
"「싫어!",
"싫어어어!!」"
],
"7551": [
"「...읏!",
"콜록...」"
],
"7552": [
"「나고 씨!",
"괜찮습니까!?」"
],
"7553": [
"「으... 응...」"
],
"7554": [
"「죽일 거야... 죽일 거라고...!",
"시이짱한테... 그런...!!」"
],
"7555": [
"「누구야!? 누구냐고...!!」"
],
"7556": [
"「난 아니야!",
"난 아니라니까... 아얏!」"
],
"7557": [
"「싫어!",
"내가 죽일 거야...!!」"
],
"7558": [
"「시이짱...!!",
"싫어어...!!」"
],
"7559": [
"마구 몸부림치는 시즈나 짱을",
"나스 씨가 간신히 들쳐 메고",
"데려갔다..."
],
"7560": [
"「동정은 하지만,",
"지금 우리가 해 줄 수 있는",
"건 없잖아」"
],
"7561": [
"(왜, 스즈나 짱이...?)"
],
"7562": [
"「모르겠군요.",
"다만, 상황으로 봐선 범인은",
"시즈나 씨를 노렸던 모양인데」"
],
"7563": [
"「응, 방도 기모노도",
"시즈나 짱 거였잖아?」"
],
"7564": [
"「근데 그 애들 분명 열쇠",
"가져갔던 것 같은데,",
"어떻게 방에 들어간 걸까」"
],
"7565": [
"「그분은, 그, 정말",
"스즈나 씨일까요?",
"틀림없이...?」"
],
"7566": [
"「언제인가요?",
"스즈나 씨가 돌아가신 건」"
],
"7567": [
"「그렇다면...",
"살해당한 게 시노부...",
"스즈나 짱 쪽이 맞는...?」"
],
"7568": [
"입 다문 우리 얼굴을 둘러보며,",
"쿠라이시 씨는 말을 이었다."
],
"7569": [
"「저, 저기...",
"4명이라니, 저까지 넣어서...」"
],
"7570": [
"「시즈나 씨!",
"안 된다니까요, 놓으세요!」"
],
"7571": [
"누가 스즈나 짱에게",
"그런 끔찍한 짓을..."
],
"7572": [
"「이거 안 되겠군...",
"어쩔 수 없지,",
"방으로 데려갑시다!」"
],
"7573": [
"「네, 네!",
"진정해요, 시즈나 씨...」"
],
"7574": [
"그렇다고 생각한다"
],
"7575": [
"아니라고 생각한다"
],
"7576": [
"나스일 가능성은 있다"
],
"7577": [
"나스는 아닐 것이다"
],
"7578": [
"맞다고 생각한다"
],
"7579": [
"아닌 것 같다"
],
"7580": [
"시체가 많다"
],
"7581": [
"범인이 많다"
],
"7582": [
"등장인물이 많다"
],
"7583": [
"아이세 미키 건"
],
"7584": [
"이케우치 리나 건"
],
"7585": [
"기사라기 유리코"
],
"7586": [
"사토에 미도리"
],
"7587": [
"기누타 유리"
],
"7588": [
"『무지개빛 사랑의 다리』"
],
"7589": [
"『백야』"
],
"7590": [
"이번 각본"
],
"7591": [
".........",
"........"
],
"7592": [
"(음...)"
],
"7593": [
"아... 벌써 아침인가..."
],
"7594": [
"고개를 돌려 옆 침대를 보니",
"히오리는 벌써 일어났는지 없었다."
],
"7595": [
"...빗소리가 거의 들리지 않는다.",
"일어나서 창밖을 본다."
],
"7596": [
"(그쳐 가고 있어...)"
],
"7597": [
"조금은 안도한 기분으로",
"침대에서 빠져나왔다."
],
"7598": [
"(이대로 돌아갈 수 있으면 좋겠지만,",
"그렇게는 안 되겠지...)"
],
"7599": [
"일단 옷을 입고, 방을 나왔다."
],
"7600": [
"왠지 거실로 내려와 보니,",
"히오리가 커피를 마시고 있었다."
],
"7601": [
"「야, 나고 씨.",
"좋은 아침입니다」"
],
"7602": [
"「마시겠습니까?",
"막 내린 겁니다」"
],
"7603": [
"소파에 앉아서",
"커피를 받았다."
],
"7604": [
"「어젯밤엔, 제대로 잤습니까?」"
],
"7605": [
"「음, 뭐...」"
],
"7606": [
"「별로였나 보군요」"
],
"7607": [
"큰일이다, 잠들어 버렸어!",
"허둥지둥 고개를 드니..."
],
"7608": [
"「...이치야나기 씨...」"
],
"7609": [
"문 앞에, 놀란 얼굴의 미사사기 씨가",
"서 있었다..."
],
"7610": [
"「어, 저, 저기...",
"좋은 아침입니다」"
],
"7611": [
"「좋은 아침이에요...」"
],
"7612": [
"스스로 생각해도 한심하다...",
"허둥지둥 일어나서",
"눈을 비빈다."
],
"7613": [
"「저, 혹시...",
"계속 거기 계셨던 거예요?」"
],
"7614": [
"「아, 네... 네」"
],
"7615": [
"「고맙습니다.",
"보시다시피, 저는 무사해요」"
],
"7616": [
"꽤 창피하지만,",
"아무 일 없었으니 됐지."
],
"7617": [
"어젯밤은, 아무 일도 없었던 것 같다.",
"다행이다..."
],
"7618": [
"「...미안해요」"
],
"7619": [
"「아니요, 저기...",
"계속 거기 계셔 주셨다니,",
"저...」"
],
"7620": [
"「전혀 눈치채지 못해서.",
"힘드셨죠...」"
],
"7621": [
"「아뇨!",
"괜찮아요,",
"전 멀쩡하니까요」"
],
"7622": [
"「정말, 그, 오히려",
"제가 죄송합니다」"
],
"7623": [
"「여성분 방 앞에서,",
"이런...」"
],
"7624": [
"「어머, 그런 건...",
"걱정해서 계셔 주신 건데",
"신경 쓰지 마세요」"
],
"7625": [
"「...이치야나기 씨는",
"다정한 분이네요」"
],
"7626": [
"「아, 아니에요, 그런」"
],
"7627": [
"「저는 괜찮으니까요.",
"이제 그만 쉬세요」"
],
"7628": [
"「아, 네.",
"그, 그럼...」"
],
"7629": [
"쑥스러워서,",
"꾸벅 고개를 숙이고",
"바로 그 자리를 떴다..."
],
"7630": [
"「히오리, 좋은 아침」"
],
"7631": [
"「...잘 자라는 인사가",
"어울리는 얼굴 같은데요」"
],
"7632": [
"「어, 저, 그게」"
],
"7633": [
"「어쩔 수 없는 양반이네.",
"방에 돌아가서 쉬겠습니까?」"
],
"7634": [
"「...아니, 아직 좀",
"잠이 안 와서」"
],
"7635": [
"「그럼, 뭐 좀 마시겠습니까.",
"저도 커피 내리려던",
"참이라서요」"
],
"7636": [
"「응, 그럼 나도」"
],
"7637": [
"「...당신 커피 마시면",
"잠 못 자는 거 아닙니까」"
],
"7638": [
"「그 정도로 애는",
"아니거든...」"
],
"7639": [
"「네, 네, 그럼 카페오레로",
"해 둡시다」"
],
"7640": [
"「남의 말 좀 들어!?」"
],
"7641": [
"...결국, 우유 듬뿍 넣은",
"따뜻한 카페오레를 타 주었다."
],
"7642": [
"놀리긴 해도,",
"신경 써 주는 거겠지.",
"...아마도."
],
"7643": [
"「...뭐, 어쨌든",
"수고 많으셨습니다」"
],
"7644": [
"「...복도에 있었던",
"것뿐이지만...」"
],
"7645": [
"「그래도, 미사사기 씨는",
"무사했잖습니까?」"
],
"7646": [
"「응, 뭐...」"
],
"7647": [
"「뭔가 석연찮은 얼굴이군요」"
],
"7648": [
"「그게 말이야...",
"이것저것 물어보고",
"조사하고 다니긴 했는데...」"
],
"7649": [
"「결국, 사건에 대해서도",
"내가 얼마나 파악하고 있는지",
"자신이 없고...」"
],
"7650": [
"「뭐, 추리 소설처럼",
"모든 단서는 제시되었습니다,",
"라고 누가 말해 주진 않으니까요」"
],
"7651": [
"「그렇게 쓸데없이 친절한 범인 싫어.",
"뭔가 꾸미는 것 같아서 무섭잖아」"
],
"7652": [
"「걱정 안 해도 보통은 없죠.",
"그럼, 여기서 확인해 볼까요」"
],
"7653": [
"「확인이라니?」"
],
"7654": [
"「의문으로 남았는데 답이",
"안 나온 걸 짚어 나가면,",
"뭘 모르는지 알 수 있겠죠」"
],
"7655": [
"「아, 그렇네.",
"뭔가 이것저것 있을 것 같아...」"
],
"7656": [
"「순서대로 생각해 볼까요.",
"우선은 나구모 씨겠군요」"
],
"7657": [
"「그렇지, 원래라면 나보다",
"먼저 와 있어야 했잖아」"
],
"7658": [
"「네.",
"늦는다고 얘기는 했었는데",
"이 폭풍우잖습니까?」"
],
"7659": [
"「자기 차로 온다면",
"늦어도 무리는 아니겠다, 하고」"
],
"7660": [
"「...실제로, 폭풍우 때문에",
"못 온 걸까요」"
],
"7661": [
"「그런 거 아닐까.",
"산사태가 있었으니까",
"늦어도 연락할 방법도 없고...」"
],
"7662": [
"「...그래도, 밤이 되고 나서",
"나고 씨가 도착했으니까요」"
],
"7663": [
"「아, 그렇구나.",
"그럼 산사태 이전에 엄청나게",
"지각한 게 되는 건가」"
],
"7664": [
"「뭐, 실제로 그냥 지각일",
"가능성도 제로는 아니지만요」"
],
"7665": [
"「으음...」"
],
"7666": [
"「하지만 모자 장수가 불렀다면",
"지각해서 기회를 날리지",
"않으려고 하겠지, 보통은」"
],
"7667": [
"「뭐, 우린 그랬으니까요」"
],
"7668": [
"「그렇지」"
],
"7669": [
"「아닐 것 같아.",
"밤이 돼서야 도착한",
"내가 여기 있으니까...」"
],
"7670": [
"「그냥 지각한 게 아니라면,",
"산사태 때문에 못 지나오는",
"일은 없었을 거야」"
],
"7671": [
"「그렇죠.",
"뭐, 정말 그냥",
"지각일 수도 있지만...」"
],
"7672": [
"「...모자 장수의 제안이라면",
"그럴 가능성도 낮고 말이야」"
],
"7673": [
"「지각하면 모처럼의 기회가",
"날아갈지도 모르니까」"
],
"7674": [
"...실제로는 기회는커녕",
"목숨이 걸린 사태가 됐지만."
],
"7675": [
"여기 올 때만 해도 그런 걸",
"알 수 있을 리 없으니..."
],
"7676": [
"「만약 나구모 씨가",
"못 온 게 아니라,",
"일부러 안 온 거라면...」"
],
"7677": [
"「...이 촬영이 애초에",
"가짜일지도 모른다는 걸 알았을",
"가능성이 높겠죠」"
],
"7678": [
"「의심 안 했던 히오리네는",
"전원 왔으니까...」"
],
"7679": [
"「...그러니까, 나구모 씨 다음은",
"온실과 주차장 소동인가」"
],
"7680": [
"「일어난 순서로 치면,",
"주차장보다 그쪽이 먼저죠」"
],
"7681": [
"「나고 씨가 길을 잃고 왔을 때",
"걸려 넘어진 정원에 있던 사람」"
],
"7682": [
"「아, 그 사람...」"
],
"7683": [
"「정말 누가 쓰러져 있었다 해도",
"우리가 갔을 땐 벌써 사라졌다는",
"게 영 이해가 안 가요」"
],
"7684": [
"「응, 히오리네가 뒷문으로",
"나올 때까지 시체를 어딘가에",
"숨겨야 하는 거잖아」"
],
"7685": [
"「시체를 숨기기만 한다면 벼랑에서",
"던져 버리면 우리로선 찾을 방법이",
"없지만...」"
],
"7686": [
"「설령 나스 씨라도,",
"사람 하나 메고 벼랑까지 왕복하면",
"시간이 꽤 걸릴 것 같고요」"
],
"7687": [
"「나스 씨라...",
"이 중 누가 했다면",
"나스 씨밖에 없었던가」"
],
"7688": [
"「그때 나스 씨 말고는",
"전원 거실에 있었으니까요」"
],
"7689": [
"「...그래도, 나스 씨가 했다는",
"게 말이 될까요」"
],
"7690": [
"「그야...",
"가능성은 제로가 아니지.",
"생각하기 어렵지만...」"
],
"7691": [
"「상상이 잘 안 되죠.",
"나스 씨가 나고 씨를 때려눕히고",
"시체 메고 도망치는 거」"
],
"7692": [
"「때린 게 나스 씨였다면",
"내가 이 정도 부상으로 끝났을까」"
],
"7693": [
"「아니... 나스 씨 짓이라면,",
"아무래도 힘 조절을 못 할 것",
"같은 건 연기가 아니라면...」"
],
"7694": [
"「연기...」"
],
"7695": [
"「그게 본성이라면 나스 씨는",
"애초에 무리겠죠」"
],
"7696": [
"「으, 응, 뭐 그렇지」"
],
"7697": [
"「뭐, 뒤뜰 시체 이동은",
"우리 외의 누군가라면 가능했죠」"
],
"7698": [
"「그렇지.",
"주차장 건으로 누군가",
"한 명 더 있던 건 확실하니까」"
],
"7699": [
"「나스 씨는 아닐 것 같아.",
"그 뒤에 독을 먹었잖아」"
],
"7700": [
"「그렇죠.",
"그쪽 범인과 별개였다는 것도",
"이상한 얘기고...」"
],
"7701": [
"「게다가, 그 전에 나를 때려서",
"기절시킨 거잖아」"
],
"7702": [
"「나스 씨 힘으로 맞았으면",
"나 벌써 죽었을 것 같은데...」"
],
"7703": [
"「아...",
"보기에도 힘 조절이 안 될 것",
"같긴 하네요...」"
],
"7704": [
"「그게 연기가 아니라는 증거는",
"뭐... 없지만...」"
],
"7705": [
"「아니, 그래도 일단",
"나스 씨가 아니라도 우리 외의",
"누군가라면 가능한 얘기고」"
],
"7706": [
"「그렇지.",
"주차장에서 차를 펑크 낸",
"녀석이라든가...」"
],
"7707": [
"「하지만 누가 했든",
"시체 자체가 어딘가로",
"사라져 버렸으니...」"
],
"7708": [
"「응...",
"벼랑 아래나 숲속이라면",
"이제 알 수 없고」"
],
"7709": [
"「설마 저택 안에",
"숨길 곳도 없을 것 같고」"
],
"7710": [
"「저택 안은 무리겠죠.",
"그렇다고 정원에 묻는",
"수고스런 짓은 안 할 테고」"
],
"7711": [
"「무서운 소리 하지 마...」"
],
"7712": [
"「아니, 설마 그건 없겠죠.",
"최근에 뭘 묻은 흔적이 있으면",
"눈치챘을 테니까요」"
],
"7713": [
"「으음, 뭐...」"
],
"7714": [
"...하지만, 아무것도 없었다고",
"단언할 수 있을 만큼 정원을",
"조사하진 않았던 것 같다."
],
"7715": [
"「...시체가 발견되지 않는 한",
"어쩔 수 없나...」"
],
"7716": [
"「...정원에 쓰러져 있던 사람은",
"우물 속에서 찾은 사람과,",
"옷차림은 같아 보인다고요」"
],
"7717": [
"「응, 옷은.",
"절대 같다고 단언할 만큼",
"자세히 본 건 아니지만」"
],
"7718": [
"「그래도, 정원에 쓰러진 사람과",
"우물 속 사람이 같은 사람이면",
"수는 맞는단 말이죠...」"
],
"7719": [
"「수?」"
],
"7720": [
"「정원에 쓰러진 사람을 옮겨서",
"우물에 숨긴 게, 주차장 소동의",
"범인이라면 앞뒤가 맞잖습니까」"
],
"7721": [
"「죽은 사람이 한 명, 범인이 한 명",
"이라는 거구나...」"
],
"7722": [
"「틀렸습니까?」"
],
"7723": [
"「맞는 것 같아.",
"나도 그렇게 생각해」"
],
"7724": [
"「그렇습니까.",
"그럼 기분 탓인가...」"
],
"7725": [
"「기분 탓이라니?」"
],
"7726": [
"「뭔가 걸리는데",
"저도 뭐가 신경 쓰이는 건지,",
"잘 모르겠단 말이죠」"
],
"7727": [
"「수는 맞을 텐데 말이죠.",
"죽은 사람과 범인이 한 명씩...」"
],
"7728": [
"「어느 쪽이 신경 쓰여?",
"죽은 사람 쪽? 범인 쪽?」"
],
"7729": [
"「...뭔가 아닌 것 같아」"
],
"7730": [
"「아, 역시」"
],
"7731": [
"「어?",
"히오리도 아니라고 생각해?」"
],
"7732": [
"「뭔가 걸린단 말이죠.",
"수는 맞을 텐데 말입니다」"
],
"7733": [
"「주차장 소동 일으킨 놈이 그 뒤로",
"전혀 기척을 안 보여서 그런가...」"
],
"7734": [
"「어? 하지만 사건은 계속",
"일어나고 있잖아」"
],
"7735": [
"「그런 것치곤 주차장 소동만큼",
"우리 외의 누가 있다는 인상이",
"없어서 신경 쓰이는 걸까요」"
],
"7736": [
"「...그러고 보니, 확실하게",
"'한 명 더 있다'는 걸 알 수 있는",
"행동은 그것뿐이었나」"
],
"7737": [
"「그렇게 생각하면 주차장 소동만",
"왠지 겉도는 것 같은",
"느낌도 드네...」"
],
"7738": [
"「그래서일까요.",
"수는 맞을 텐데 뭔가",
"위화감이 드는 건」"
],
"7739": [
"「수... 인원수라...」"
],
"7740": [
"「시체는요, 그것뿐일 겁니다.",
"아직 안 발견된 시체가 또",
"어딘가 있다기보다는...」"
],
"7741": [
"「누가 또 죽었다고 하면",
"전부 세 명이나 되는 거니까」"
],
"7742": [
"「아무리 그래도 나 말고 상관없이",
"길 잃고 휘말린 사람이 줄줄이",
"있을 것 같진 않고...」"
],
"7743": [
"「그야...」"
],
"7744": [
"「? 히오리?」"
],
"7745": [
"「...알았습니다.",
"뭐가 신경 쓰였던 건지」"
],
"7746": [
"「역시, 한 명 많아...」"
],
"7747": [
"「한 명... 많다니...」"
],
"7748": [
"「시체가 많다는 거야?」"
],
"7749": [
"「아뇨, 시체가 아닙니다.",
"등장인물 수가 안 맞는 겁니다」"
],
"7750": [
"「등장인물?」"
],
"7751": [
"「범인과 죽은 사람,",
"우리 외에 두 명이 더 있다면...」"
],
"7752": [
"「나구모 씨는 어느 쪽입니까?」"
],
"7753": [
"「어느 쪽이 나구모 씨라 해도,",
"등장인물이 아닌 사람이 나고 씨 외에",
"한 명 더 있게 되죠」"
],
"7754": [
"「범인이 많다는 거야?」"
],
"7755": [
"「아니... 복수범일 가능성은",
"있을지도 모르지만...」"
],
"7756": [
"「제가 신경 쓰였던 건,",
"등장인물 수가 안 맞는다는",
"겁니다」"
],
"7757": [
"「등장인물이라니...」"
],
"7758": [
"「범인과 죽은 사람,",
"우리 외에 두 명이 더 있다면...」"
],
"7759": [
"「...그렇구나.",
"등장인물 수가",
"안 맞는 거야...!」"
],
"7760": [
"「네, 그렇습니다.",
"범인과 죽은 사람, 우리 외에 두 명",
"누가 더 있다고 하면...」"
],
"7761": [
"「배역에 없는 사람이 나 말고",
"한 명 더 있게 되는 건가」"
],
"7762": [
"「...그게 범인일까요」"
],
"7763": [
"「죽은 게 나구모 씨고,",
"등장인물이 아닌 누군가가",
"범인 아니냐는 거야?」"
],
"7764": [
"「노려지는 건 전부,",
"각본에 등장하는 사람",
"뿐이니까요」"
],
"7765": [
"「그렇게 생각하게 하려고 일부러",
"한 명만 배역에 안 넣은 사람을",
"불러 둔 건 아닐까」"
],
"7766": [
"「아, 그렇군.",
"그럼 역시 어느 쪽이 나구모 씨인지",
"모른다는 거군」"
],
"7767": [
"「응...",
"둘 다 나구모 씨가 아닌 건",
"설마 아닐 것 같지만」"
],
"7768": [
"「뭐 그렇죠.",
"안 그러면 나구모 씨가 뭣 때문에",
"배역에 들어 있는지 모르니까」"
],
"7769": [
"「응...",
"다만, 왜 나구모 씨만 제대로",
"저택에 안 왔는지...」"
],
"7770": [
"「역시, 거기가",
"걸리는군요」"
],
"7771": [
"「의도적이라면 나구모 씨는",
"우리와 뭔가 입장이 달랐다는",
"얘기가 되니까요」"
],
"7772": [
"「행동이 부자연스러운 걸 보면,",
"범인 같기도 한데,",
"그러면 죽은 사람이 말이지」"
],
"7773": [
"「왜 살해당했는지,",
"어디 사는 누군지",
"전혀 모르겠죠」"
],
"7774": [
"「게다가 그 뒤에 시체를",
"숨겼다는 건 발견되길",
"원치 않았던 거겠죠」"
],
"7775": [
"「그럼, 만약 내가 안 왔다면",
"어떻게 됐을까...?」"
],
"7776": [
"「어떻게라니...",
"그야 뒤뜰 시체는 발견 안 되고",
"숨겨진 채였겠죠」"
],
"7777": [
"「그리고 밤이 돼도 아무도 안 온 채",
"일련의 소동이 일어나고...」"
],
"7778": [
"「온실에 그 '복수' 예고가 있고",
"주차장 소동이 있고, 다음 날 아침엔",
"마다라이 씨가 살해당하고...」"
],
"7779": [
"「...한 명 더 죽은 사람이",
"있다는 건 아무도 모른 채?」"
],
"7780": [
"「...그렇군.",
"어째선지 안 오는 나구모 씨가 제일",
"의심받았을지도 모르겠네요」"
],
"7781": [
"「나고 씨 때문에, 처음부터",
"범인의 계획과 달라져 버린",
"부분이 있을지도 몰라요」"
],
"7782": [
"「범인의 계획과 달라져",
"버린 부분...」"
],
"7783": [
"「그게 어느 부분인지 알면,",
"뭔가 보일지도 모르겠네요」"
]
}