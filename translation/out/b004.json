{
"2408": [
"「여러분, 저기... 그렇게",
"여기서 말다툼하시면...」"
],
"2409": [
"「...난, 안 했어」"
],
"2410": [
"「당연하지!",
"언니가 범인일 리 없잖아!」"
],
"2411": [
"신경이 곤두서는 듯한",
"거북한 침묵이 내려앉는다."
],
"2412": [
"「...범인...」"
],
"2413": [
"「아무리 봐도 사고도",
"자살도 아니니까요」"
],
"2414": [
"「있는 거겠죠.",
"...범인이라는 놈이」"
],
"2415": [
"「괜찮아요, 나고 씨?",
"굳어 있는 거 아니에요?」"
],
"2416": [
"뒤에서 히오리의 걱정스러운",
"속삭임이 들리지만 돌아볼 수 없다."
],
"2417": [
"「구, 굳어 있긴 한데",
"못 본 척하면 나중에 더",
"무서워진단 말이야...!」"
],
"2418": [
"「더 무서워진다고요?」"
],
"2419": [
"「뭐가 신경 쓰였는지",
"확인 안 하고 두면 계속",
"머리에서 안 떠나니까...」"
],
"2420": [
"「아아, 또 뭔가",
"신경 쓰이는 게 늘어나",
"버렸잖아!!」"
],
"2421": [
"「...거참 골치 아픈 양반이네.",
"기절이나 하지 마십쇼」"
],
"2422": [
"「차, 차라리 기절하고 싶어...」"
],
"2423": [
"하지만 이렇게 된 이상 꼭",
"신경 쓰이는 데를 다 봐야",
"눈을 뗄 수가 없다..."
],
"2424": [
"「...날씨는 괜찮아 보이네요」"
],
"2425": [
"거실 창밖을 보면서",
"히오리가 혼잣말처럼 중얼댄다."
],
"2426": [
"「차만 쓸 수 있으면 당장",
"경찰에 신고하러 갈 텐데」"
],
"2427": [
"「다들 택시나 뭐",
"타고 온 거야?」"
],
"2428": [
"「저는 사무소 차로",
"데려다줬어요...」"
],
"2429": [
"「우리는 택시예요」"
],
"2430": [
"「나도다」"
],
"2431": [
"「저도요.",
"나고 씨 차는 도중에",
"세워 두고 왔잖아요」"
],
"2432": [
"「응, 두고 와 버렸어」"
],
"2433": [
"「거기까지 걸어갈 순 없을까」"
],
"2434": [
"「갈 수야 있겠지만",
"기름이 산 아래까지",
"버틸지 모르거든요」"
],
"2435": [
"「아, 기름이라...」"
],
"2436": [
"「어이, 나쁜 소식이다」"
],
"2437": [
"다짜고짜 불길한 말을 하며",
"쿠라이시 씨가 들어온다."
],
"2438": [
"「뭐야, 아저씨.",
"어디 갔었어?」"
],
"2439": [
"「오락실이다.",
"라디오 듣고 온댔잖아」"
],
"2440": [
"「아, 날씨 말이군요.",
"...나쁜 소식이란 게 뭡니까?」"
],
"2441": [
"「어제보단 나아진",
"것 같은데...」"
],
"2442": [
"「그런 문제가 아냐.",
"산사태가 났단다」"
],
"2443": [
"「......뭐!?」"
],
"2444": [
"「전면 통행금지에 언제 또 무너질지",
"모르니 산에 들어가지 말라더군」"
],
"2445": [
"「저기, 그게...",
"무슨 뜻...?」"
],
"2446": [
"「...고립됐단 소리다.",
"여기 갇혔다는 거지」"
],
"2447": [
"「어...」"
],
"2448": [
"멍하니 기묘한 공백이 흘렀다.",
"다들 그 말의 심각함을",
"삼키는 데 시간이 걸렸겠지."
],
"2449": [
"그리고 받아들이는 데도..."
],
"2450": [
"「말도 안 돼!!」"
],
"2451": [
"「고, 고립이라니, 그런,",
"이런 데서...!?」"
],
"2452": [
"「그러니까... 걸어서도",
"못 지나간다는... 건가?」"
],
"2453": [
"「무리한 소리 마십쇼.",
"언제 무너질지 모른다잖습니까」"
],
"2454": [
"「그렇게 심한가요?",
"저기, 대체 어디쯤이",
"얼마나 크게...」"
],
"2455": [
"「오는 길에 무슨무슨",
"터널이 있었잖냐」"
],
"2456": [
"「국도로 빠지는 내리막길과",
"갈라진 직후에 있는 거」"
],
"2457": [
"「아, 아아」"
],
"2458": [
"「그 터널 이쪽 편이란다」"
],
"2459": [
"「...거기가 막혔으면",
"진짜 못 내려가잖아!!」"
],
"2460": [
"「그러니까 처음부터 말했잖냐.",
"나쁜 소식이라고」"
],
"2461": [
"「뭐, 다행히 이 폭풍에",
"차도 거의 안 다녀서",
"휘말린 피해는 없다지만...」"
],
"2462": [
"「...우리 말고는, 이겠지」"
],
"2463": [
"「그런 셈이지」"
],
"2464": [
"「근처 일대엔 접근 말라더군.",
"복구 작업도 폭풍이 그친",
"뒤가 아니면 위험하다나」"
],
"2465": [
"「그럴 수가!?",
"여기 전화도 없잖아?",
"어떻게 내려가!?」"
],
"2466": [
"「이, 일단 우리 사무소에선",
"기한이 되면 데리러 올",
"예정이긴 한데...」"
],
"2467": [
"「저희 쪽도요.",
"근데 아직 6일이나 남았죠」"
],
"2468": [
"「그때까지 길이 뚫려",
"있으면 좋겠다만」"
],
"2469": [
"「뭐, 못 내려간다는 건",
"아래서 오는 것도 무리지.",
"다른 스태프도 못 오겠군」"
],
"2470": [
"「...그럴 수가...」"
],
"2471": [
"「노, 농담하지 마!?",
"어이 아저씨, 정말로 이 산",
"얘기였어, 그거!?」"
],
"2472": [
"「못 믿겠으면 직접 들어 봐.",
"이 시간이면 아직 어딘가",
"뉴스를 하고 있을 거다」"
],
"2473": [
"「...읏!!」"
],
"2474": [
"「아, 츠바키 군!」"
],
"2475": [
"츠바키 군이 방을 뛰쳐나간다.",
"반사적으로 모두 뒤를 쫓았다."
],
"2476": [
"「츠바키 군...」"
],
"2477": [
"...귀에 거슬리는 잡음.",
"라디오에선 바깥 빗소리를",
"키운 듯한 불쾌한 소리뿐."
],
"2478": [
"「어... 어때요...?」"
],
"2479": [
"「거의 안 들려.",
"잡음뿐이야...」"
],
"2480": [
"「잠깐 기다려!",
"지금 맞추는 중이니까」"
],
"2481": [
"츠바키 군이 신중히 주파수를",
"맞추는 걸 숨죽여 지켜본다."
],
"2482": [
"『...의 산사태는, 악천후...』"
],
"2483": [
"「앗!」"
],
"2484": [
"「잡혔나...?」"
],
"2485": [
"『여전히... 복구 전망이 서지 않아",
"현... 대책본부... 가...』"
],
"2486": [
"알아들을 만해진 음성은",
"곧바로 싫은 소식을 전했다."
],
"2487": [
"모두 불안한 얼굴이 되어",
"입을 다문 채 귀를 기울인다."
],
"2488": [
"『...이 산사태... 휘말린",
"차량 등은... 확인되지...",
"않은 것으로... 만...』"
],
"2489": [
"『...로 향하... 배우",
"시쿠라 긴... 씨... 연락이 안 되어",
"...다는 정보가... 들어...』"
],
"2490": [
"「...어?」"
],
"2491": [
"「배우라니... 어?",
"시쿠라 씨라니...」"
],
"2492": [
"누군가의 본명인가 싶어",
"주위를 둘러보았다."
],
"2493": [
"「...저희는 아닙니다」"
],
"2494": [
"「아니야?」"
],
"2495": [
"「시쿠라 긴지 씨일 거야」"
],
"2496": [
"「앗...",
"타키 프로의 시쿠라 씨?」"
],
"2497": [
"「타키 프로?",
"그건...」"
],
"2498": [
"「집사 씨, 나구모 씨가",
"타키 프로 사람이라 안 했어?」"
],
"2499": [
"「아아...",
"그럼 시쿠라 씨가 나구모야?」"
],
"2500": [
"「가능성은 있겠군요」"
],
"2501": [
"「전혀 상관없는 이유로 헤맬",
"만한 곳은 아니니까 말이지」"
],
"2502": [
"「뭔가, 연락이 안 된다고",
"하지 않았어?",
"괜찮은 걸까」"
],
"2503": [
"「모르겠지만, 그 전에",
"산사태에 휘말린 차량은",
"없는 것 같다고 했죠」"
],
"2504": [
"「내가 아까 들은 뉴스도",
"그렇게 말하더군.",
"휘말리진 않았을 거다」"
],
"2505": [
"「하지만... 나구모 씨 역인데",
"산사태에 휘말리지도 않았다면",
"왜 못 오신 걸까요...?」"
],
"2506": [
"「...어젯밤, 한 사람",
"누가 더 있었지...」"
],
"2507": [
"「언니!!」"
],
"2508": [
"「아아, 있었지.",
"그게 시쿠라 씨였구나」"
],
"2509": [
"「그건 아직 모르죠.",
"시쿠라 씨였다 쳐도 무슨",
"이유로 펑크를 냈는지」"
],
"2510": [
"「그런 이상한 짓을",
"할 것 같은 사람이야?」"
],
"2511": [
"「좀 괴짜긴 해도",
"그렇게 수상한 놈은 아냐」"
],
"2512": [
"「아니... 근데 말야,",
"시쿠라 씨든 아니든",
"누가 있었던 건 확실하잖아?」"
],
"2513": [
"「그놈은 산사태 전에 여기",
"도착했던 건 확실하겠지」"
],
"2514": [
"「그야, 무너진 뒤엔 차로",
"어떻게 해도 못 오니까요」"
],
"2515": [
"「무너진 데는 내가 차에서",
"내린 곳보다 한참 아래니까",
"걸어 오르긴 무리일 거야」"
],
"2516": [
"「그런 괴물 같은 짓은",
"저 근육밖에 못 해」"
],
"2517": [
"「응? 난 차로 왔는데」"
],
"2518": [
"「알거든!",
"보통 인간은 무리라는",
"얘기를 하는 것뿐이야」"
],
"2519": [
"「...음, 그러니까",
"걸어서 오를 수 있는지",
"시험해 보면 되나」"
],
"2520": [
"「대체 어떻게 해석하면",
"그렇게 되냐!?」"
],
"2521": [
"「아니에요,",
"나스 씨, 아니니까요」"
],
"2522": [
"「아이 참, 이 비상시에",
"실종자 늘릴 만한 제안",
"하지 마, 집사 씨」"
],
"2523": [
"「내 탓이야!?",
"지금 그게 내 잘못이냐!?」"
],
"2524": [
"「될까.",
"실종...」"
],
"2525": [
"「부추기지 마!",
"이 녀석 진짜 할지도 몰라!?」"
],
"2526": [
"「저기, 아무리 나스 씨라도",
"위험할 것 같은데요」"
],
"2527": [
"「당연하지.",
"시끄러우니 좀 닥쳐라, 꼬맹이들」"
],
"2528": [
"「시험 안 해도 되나?」"
],
"2529": [
"「됐어요.",
"됐으니까 잊어 주세요」"
],
"2530": [
"「...음.",
"무슨 얘기였더라...」"
],
"2531": [
"「아, 그러니까...」"
],
"2532": [
"「...뭘 말하려 했는지",
"까먹었잖아!?」"
],
"2533": [
"「에엑!?",
"왜 나한테 화내!?」"
],
"2534": [
"「그래, 적반하장으로",
"화낼 때가 아니잖아!?」"
],
"2535": [
"「너희들...」"
],
"2536": [
"「저... 저기, 여러분",
"제발 진정하세요...」"
],
"2537": [
"「...마다라이 씨,",
"귀신 돼서 나올 것 같아...」"
],
"2538": [
"「죄, 죄송해요!?」"
],
"2539": [
"「왜 갑자기 사과하는데!",
"진짜 나올 것 같잖아!!」"
],
"2540": [
"「안 그래도 이 저택은 예전부터",
"저주받았다는 소문이...」"
],
"2541": [
"「저, 저주...?」"
],
"2542": [
"「저주일 리가 있나!",
"마다라이 씨는 누가 봐도",
"찔린 거잖아!?」"
],
"2543": [
"「넌 왜 아까부터 그렇게",
"쓸데없는 소리만 하는데!?」"
],
"2544": [
"「어? 저기, 그렇게...?」"
],
"2545": [
"「먼저 꺼낸 건",
"네 언니잖아!?」"
],
"2546": [
"「진짜로 쫄지 마,",
"남자가!!」"
],
"2547": [
"「누가 쫄았대!",
"쫄은 건 나고무잖아!!」"
],
"2548": [
"「미, 미안...」"
],
"2549": [
"「그러니까 일일이",
"사과하지 말라고...!」"
],
"2550": [
"「<fs 110>됐으니까 닥쳐!!<fs>」"
],
"2551": [
"...순식간에 모두 조용해졌다.",
"아니, 침묵이라기보다 경직."
],
"2552": [
"「역시」"
],
"2553": [
"「막상 닥치면",
"박력이 다르군요」"
],
"2554": [
"「무... 무서웠어...」"
],
"2555": [
"「네네,",
"그래도 진정됐잖아요」"
],
"2556": [
"「...흥.",
"정말이지 한심하군.",
"집단 히스테리란 건가?」"
],
"2557": [
"「...아아」"
],
"2558": [
"「? 무슨 뜻이야?」"
],
"2559": [
"「신경이 한계였겠죠.",
"어딘가에 뭔가 쏟아내야죠」"
],
"2560": [
"「...그랬던, 걸까」"
],
"2561": [
"그럴지도 모른다.",
"확실히 아까보다 조금은",
"숨막힘이 줄어든 것 같다."
],
"2562": [
"「젠장...",
"미안했다, 나고무」"
],
"2563": [
"「응? 뭐가?」"
],
"2564": [
"「시비 걸어서」"
],
"2565": [
"「아, 어, 아니, 뭐」"
],
"2566": [
"「뭐야, 그거.",
"의외로 솔직하네」"
],
"2567": [
"「의외라서 미안하다」"
],
"2568": [
"「나도 미안」"
],
"2569": [
"「...벼, 별로",
"신경 안 써...」"
],
"2570": [
"「미안하다만 훈훈할 때가 아냐」"
],
"2571": [
"「알거든!",
"그러니까, 음...」"
],
"2572": [
"「저주?」"
],
"2573": [
"「그건 소문이니 잊어.",
"그게 아니라...」"
],
"2574": [
"「어젯밤, 분명 한 사람",
"더 있었다는 얘기죠」"
],
"2575": [
"「그래, 그거다!」"
],
"2576": [
"「그러니까, 말이지」"
],
"2577": [
"「누가 더 있는 게 확실하고",
"게다가 산을 못 내려간다면」"
],
"2578": [
"「...그놈은 아직",
"이 근처에 있다는 거군」"
],
"2579": [
"「그렇... 긴 한데...」"
],
"2580": [
"「그럼 아무리 생각해도",
"그놈이 범인이잖아!」"
],
"2581": [
"「차 펑크 내고,",
"온실에 이상한 거 늘어놓고...」"
],
"2582": [
"「...그걸 전부 같은 놈이",
"혼자 했는지는 모른다」"
],
"2583": [
"「뭐!?」"
],
"2584": [
"「마다라이는 한밤중에 죽었다.",
"만약 밖에 있던 우리 말고",
"다른 한 명이 범인이라면...」"
],
"2585": [
"「그놈은 언제 어떻게",
"저택에 들어온 거지?」"
],
"2586": [
"「어, 어떻게라니...」"
],
"2587": [
"「현관도 뒷문도 밤에는",
"안에서 잠가 두지 않았나」"
],
"2588": [
"「그야, 잠겨 있었지만!",
"하, 하지만 마다라이 아저씨가",
"열어 줬을지도 모르잖아!」"
],
"2589": [
"「그럼 밖의 그놈은 마다라이랑",
"어떻게 연락했단 거냐.",
"여긴 전화도 안 된다고」"
],
"2590": [
"「밖이라...",
"음, 계속 밖에 있는 걸까」"
],
"2591": [
"「밖... 아, 밖이라니...",
"그러고 보니...」"
],
"2592": [
"「뭐냐, 꼬마?」"
],
"2593": [
"「아뇨, 저기...",
"상관없을지도 모르지만」"
],
"2594": [
"「됐으니 말해 봐」"
],
"2595": [
"「혹시 그거 말입니까.",
"그 이상한 소리」"
],
"2596": [
"「이상한 소리?」"
],
"2597": [
"「방에 돌아가려던",
"때 일인데...」"
],
"2598": [
"「밖에서 철퍼덕 하고",
"엄청 큰 물소리가 났어」"
],
"2599": [
"「물소리이?」"
],
"2600": [
"「땅이 질척해서",
"물웅덩이투성이니까요.",
"뭔가 쓰러진 듯한 소리였죠」"
],
"2601": [
"「근데 방에 돌아갈 때면",
"마다라이 아저씨 멀쩡했잖아」"
],
"2602": [
"「응, 그러니까 아마",
"상관없을 것 같은데...」"
],
"2603": [
"「음... 난 그 소리도",
"못 알아챘네」"
],
"2604": [
"「나도다.",
"애초에 그땐 아직 다들",
"복도에서 떠들고 있었고」"
],
"2605": [
"「우리도... 그치?」"
],
"2606": [
"「...미사사기 씨는?」"
],
"2607": [
"「저도, 아무것도...",
"아마 이미 방에 들어간",
"뒤였나 봐요...」"
],
"2608": [
"「나도 기억 없군.",
"흥, 뭐 그건 시간상으로도",
"마다라이와 상관없어 보여」"
],
"2609": [
"「그, 그래도...",
"그럼 마다라이 아저씨는...",
"그, 누가...」"
],
"2610": [
"「누구냐니...」"
],
"2611": [
"「음...",
"밖에서 누가 들어오는 게",
"불가능했다면...」"
],
"2612": [
"「앗, 저기, 하지만, 그건」"
],
"2613": [
"「잠깐잠깐, 근육 잠깐!",
"결론 서두르지 마!」"
],
"2614": [
"「응?",
"하지만 문은 잠겨 있었지?」"
],
"2615": [
"「그렇긴 한데!」"
],
"2616": [
"...하지만.",
"밖에 있던 누군가가 저택에",
"들어올 수 없었다면..."
],
"2617": [
"(엄청 싫은 결론이",
"돼 버리는... 거지...)"
],
"2618": [
"「...가능성을 하나",
"들자면...」"
],
"2619": [
"「범인이 처음부터 마다라이 씨를",
"속여 들어올 계획이었다든가.",
"그분 쉽게 넘어가는 분이라」"
],
"2620": [
"「없는 얘긴 아니다만,",
"어제 마다라이는 뭘 숨기고",
"연기하는 걸로 안 보였다」"
],
"2621": [
"「그놈은 배우로선 못하진 않지만",
"맨얼굴로 거짓말하는 건",
"초등학생보다 서툴러」"
],
"2622": [
"「...뭐, 그랬죠」"
],
"2623": [
"자기도 딱히 진심으로 한 말은",
"아니었는지, 히오리는 어깨를",
"으쓱하고 순순히 물러났다."
],
"2624": [
"「젠장!",
"그럼 뭐야?」"
],
"2625": [
"「어젯밤 그 한 명 말고도",
"역시 누가... 그것도",
"이 안에 있다는 거냐!?」"
],
"2626": [
"「그럴 수가...!」"
],
"2627": [
"「...역시",
"그렇게 되는 걸까.",
"믿기지 않지만」"
],
"2628": [
"「...글쎄, 어떨까」"
],
"2629": [
"「글쎄라니 뭐야?」"
],
"2630": [
"「이 안에 주범이든 공범이든",
"있는지 없는지 나도 모른다」"
],
"2631": [
"「어떻게인지는 모르지만",
"밖에 있던 누가 들어올",
"방법이 있을지도 모르고」"
],
"2632": [
"「앗... 맞다!",
"그때는?」"
],
"2633": [
"「뭐야, 그때라니?」"
],
"2634": [
"「그러니까, 우리가",
"주차장에 나와 있었을 때!」"
],
"2635": [
"「문 안 잠갔잖아?",
"우리가 밖에 있는 사이에",
"엇갈려 들어와 숨은 거 아냐?」"
],
"2636": [
"「아, 그러고 보니",
"온실에서 곧장 주차장 갔지!",
"뒷문 열어 놨었어!」"
],
"2637": [
"「그 뒤에 뒷문 잠근 게",
"언제였죠?」"
],
"2638": [
"「주차장에서 돌아온 뒤다.",
"몸 닦을 수건 가지러",
"욕실 간 김에 잠갔어」"
],
"2639": [
"「우리가 주차장에 갈 때",
"뒷문으로 달려가 들어와서",
"어딘가 숨었다는 거야?」"
],
"2640": [
"「불가능하진 않잖아?」"
],
"2641": [
"「...수건은?」"
],
"2642": [
"「우비 같은 걸 입었어도",
"꽤 젖었을 거야」"
],
"2643": [
"「뭐, 뒷문은 저희가 드나들어",
"젖어 있었으니 발자국 하나",
"더 있어도 모르겠지만」"
],
"2644": [
"「그 자리에서 물기를 닦고",
"올라가지 않으면 흔적이 남죠」"
],
"2645": [
"「그, 그야...",
"수건 정도는 준비해",
"왔던 거 아냐?」"
],
"2646": [
"「...불가능하진 않군」"
],
"2647": [
"안도하는 듯한,",
"오싹해지는 듯한,",
"기묘한 분위기였다."
],
"2648": [
"(범인은 여기 있는 누구도",
"아닐지도 모른다, 그쪽이",
"더 낫긴 하지만...)"
],
"2649": [
"(대신에 우리 말고",
"누군가가 어딘가에",
"숨어 있을... 지도...)"
],
"2650": [
"「...돌아가자.",
"이제 안 들려」"
],
"2651": [
"「아... 응.",
"그러자...」"
],
"2652": [
"어느새 라디오는 다시",
"빗소리 같은 잡음뿐이었다."
],
"2653": [
"우리는 말없이",
"거실로 돌아간다..."
],
"2654": [
"「......휴대폰」"
],
"2655": [
"「저, 전화!?",
"전화 울려!?」"
],
"2656": [
"「누구냐?",
"권외 아니었어?」"
],
"2657": [
"「그, 그럴 텐데...」"
],
"2658": [
"「아, 저기...",
"죄송해요...」"
],
"2659": [
"미사사기 씨가 꺼낸 휴대폰을",
"허둥지둥 끄면서",
"미안한 듯 고개를 숙인다."
],
"2660": [
"「당신이었나.",
"그거 연결되는 거야?」"
],
"2661": [
"「아뇨, 저기...",
"전화가 아니에요」"
],
"2662": [
"「알람이에요.",
"그, 약 먹을 시간을 잊지",
"않으려고 맞춰 둬서...」"
],
"2663": [
"「알람...?」"
],
"2664": [
"「약이라뇨?」"
],
"2665": [
"「저, 꽃가루 알레르기...」"
],
"2666": [
"「헷... 헷갈리게 좀",
"하지 말라고, 어이!!」"
],
"2667": [
"「죄, 죄송해요」"
],
"2668": [
"허둥지둥 끈 휴대폰을 넣고",
"미사사기 씨는 움츠러들었다."
],
"2669": [
"「자자, 휴대폰이 안 되는 건",
"처음부터 알던 거잖아요」"
],
"2670": [
"「그런 건 알거든!",
"젠장, 왜 휴대폰 정도는",
"되게 해 놓지 않은 거야...!」"
],
"2671": [
"「누구한테 불평하는 건데」"
],
"2672": [
"「누구냐니...!」"
],
"2673": [
"「이, 이런 산속에 별장 따위",
"지은 바보한테지!!」"
],
"2674": [
"「...그러고 보니, 집사.",
"너 이 저택에 대해 묘하게",
"잘 아는데 왜지?」"
],
"2675": [
"「......뭐...」"
],
"2676": [
"「열쇠 있는 곳이며",
"방 배치며...",
"그 큰 시계 일도 알았지」"
],
"2677": [
"「뭐야 그게!?",
"날 의심하는 거냐!?」"
],
"2678": [
"「집사 하라니까",
"그럴싸하게 굴었을 뿐인데",
"왜 내가...!」"
],
"2679": [
"「그러니까 그 그럴싸한 정보를",
"어디서 얻었냐고.",
"모자 장수가 그렇게 지시했나」"
],
"2680": [
"「그건...!」"
],
"2681": [
"「여, 열쇠든 시계든 그런 건",
"한 바퀴 둘러보면 누구든",
"알 수 있는 거잖아!」"
],
"2682": [
"「저주는?」"
],
"2683": [
"「그것도 알 만한 놈은",
"아는 얘기야!",
"서재에 그런 책도 있고」"
],
"2684": [
"「애초에 너희 도착했을 때",
"난 벌써 이 차림으로",
"여기 있었잖아!?」"
],
"2685": [
"「응.",
"우리 오기 전에",
"저택 안 둘러봤던 거야?」"
],
"2686": [
"「그, 그래!",
"내가 뭐 하러 너희보다",
"먼저 왔다고 생각하는데!」"
],
"2687": [
"「흥...",
"열심이기도 하군」"
],
"2688": [
"「뭐야, 그 말투!?",
"아직도 의심한다면...」"
],
"2689": [
"「진정 좀 하시라니까요.",
"말다툼할 때가 아니잖아요」"
],
"2690": [
"「그, 그래요...",
"우리 말고 누가 한 명 더",
"있는 건 확실하니까...」"
],
"2691": [
"「다만, 그 누군가가",
"마다라이를 죽인 놈과",
"같다는 보장도 없지」"
],
"2692": [
"「증거는 아무것도 없다.",
"온실 소동 땐 여기 전원이",
"분명 같이 있었다만...」"
],
"2693": [
"「...마다라이 쪽은 모른다.",
"애초에 범인이 하나인지도 몰라」"
],
"2694": [
"「그렇게 손 많이 갈 법한",
"짓을 했으니 말이다,",
"여럿이 더 편했겠지」"
],
"2695": [
"「혼자선 절대 불가능하다고도",
"단언할 순 없지만요」"
],
"2696": [
"「불가능하다곤 안 했다.",
"저기 빈약해 보이는 꼬마도",
"시간은 걸려도 할 수 있겠지」"
],
"2697": [
"「엣, 아, 저기」"
],
"2698": [
"「다들 깨어 있는 동안",
"서둘러 해치울 일은",
"아니었을 테니까」"
],
"2699": [
"「오히려 우리가 잠든 뒤",
"신중히 하는 게 확실하지」"
],
"2700": [
"「네, 네에...」"
],
"2701": [
"「그래도 혼자 하느니",
"두셋이면 더 확실하다.",
"아닌가?」"
],
"2702": [
"흥분했던 츠바키 군마저 입을 닫고",
"거실에 오싹한 침묵이 내렸다."
],
"2703": [
"(바로 조금 전에...",
"밖에 있던 누구라도 숨어들",
"수 있다고 했을 뿐인데...)"
],
"2704": [
"그리고 다른 사람들은 무의식중에",
"그 누군가가 범인이라 믿고...",
"아니, 믿으려 했던 걸까."
],
"2705": [
"그게 아니면 쿠라이시 씨 말대로",
"이 안에 범인이나 공범이",
"있는 게 되어 버리니까..."
],
"2706": [
"「......하, 하지만...",
"어째서, 그런...」"
],
"2707": [
"「저희는 그저 연극 때문에",
"모였을 뿐이잖아요...」"
],
"2708": [
"「그럴까?」"
],
"2709": [
"「그럴까라니, 모자 장수 씨가",
"그렇게 말하며 불렀는데...」"
],
"2710": [
"「......아닐지도」"
],
"2711": [
"「언니?」"
],
"2712": [
"「모자 장수가 누군지 아무도 몰라」"
],
"2713": [
"「뭐...?」"
],
"2714": [
"시즈나의 말에",
"쿠라이시 씨만 깊이 끄덕였다."
],
"2715": [
"「우리를 여기 모은 게",
"정말로 모자 장수였을까?」"
],
"2716": [
"「그... 그건...」"
],
"2717": [
"츠바키 군은 뭔가 반박하려 했지만",
"말이 나오지 않는지 입을 다문다."
],
"2718": [
"「...나도 아닌 것 같아」"
],
"2719": [
"나스 씨마저 어쩐지 심각한 얼굴로",
"팔짱을 끼고 생각에 잠겼다."
],
"2720": [
"「그렇다면...",
"다른 누가 모자 장수 이름을",
"사칭해 모았다는 겁니까?」"
],
"2721": [
"「진짜가 아니라면",
"그것밖에 없겠지」"
],
"2722": [
"...아무도 대답하지 않는다.",
"대답하기 싫은 걸지도."
],
"2723": [
"(왜냐면... 정말로",
"그렇다면...)"
],
"2724": [
"영화 촬영이란 얘기 자체가",
"거짓이 되니까, 오늘 올 예정인",
"촬영 스태프도 오지 않는다."
],
"2725": [
"즉, 산사태가 복구돼도",
"사무소에서 데리러 올 6일 뒤까지",
"아무도 구하러 오지 않는다..."
],
"2726": [
"「....저, 저기...」"
],
"2727": [
"침묵을 견디지 못해",
"나는 입을 열었다."
],
"2728": [
"하지만 이쪽을 본 건 히오리뿐,",
"다른 사람들은 넋이 나간 듯",
"말없이 고개를 숙이고 있다."
],
"2729": [
"「뭡니까?」"
],
"2730": [
"「아... 아니, 그러니까...",
"아까 마다라이 씨가 죽은 게",
"한밤중쯤이라고 했지...?」"
],
"2731": [
"「저도 그리 잘 알진 않지만,",
"아마 한밤중... 0시를",
"전후한 1시간쯤 아닐까요」"
],
"2732": [
"「거실에서 해산한 게",
"11시 전쯤이었죠.",
"그 뒤인 건 확실하고」"
],
"2733": [
"「그렇구나...",
"그럼 다들 방에 돌아가고",
"좀 지나서란 거네」"
],
"2734": [
"그렇다면 히오리만은 역시",
"범인이 아니구나..."
],
"2735": [
"(작은 소리에도 깰 만큼",
"잠이 얕았으니까...)"
],
"2736": [
"빠져나가려고 일어났다면",
"금방 알아챘을 거다."
],
"2737": [
"실제로 새벽녘쯤 화장실에",
"갔던 것도 기억나고,",
"금방 돌아온 것도 기억한다."
],
"2738": [
"(...다행이다...)"
],
"2739": [
"한 명이라도 아니라고 아는",
"사람이 있으니 안심된다."
],
"2740": [
"게다가 그렇게 걱정해 준 상대라",
"더욱 마음이 편해졌다..."
],
"2741": [
"(...다른 사람들은 어떨까.",
"다들 자고 있기만 했을까...)"
],
"2742": [
"「어때요?」"
],
"2743": [
"「응? 뭐가?」"
],
"2744": [
"「뭐가라뇨, 무슨 생각이 있어서",
"얘기 듣던 거 아니었어요?」"
],
"2745": [
"「아니, 딱히...",
"조용하면 무서우니까」"
],
"2746": [
"「...역시 나고 씨답네요」"
],
"2747": [
"「왜 웃는 거야?",
"싫잖아, 왠지...」"
],
"2748": [
"「그 마음은 알죠.",
"싫은 분위기니까요...」"
],
"2749": [
"「그래서, 들어 보니",
"어땠어요?」"
],
"2750": [
"「음...",
"잊어버릴 것 같으니",
"수첩에 적어 볼게」"
],
"2751": [
"들은 이야기를 수첩에",
"휘갈겨 적어 나간다."
],
"2752": [
"「정확한 시간을",
"기억하는 사람은",
"없는 것 같은데」"
],
"2753": [
"「뭐, 그야 그렇겠죠.",
"이런 일이 날 줄은",
"아무도 몰랐을 테니」"
],
"2754": [
"「방끼리 꽤",
"떨어져 있어서 옆방 아니면",
"소리도 잘 안 들리고」"
],
"2755": [
"「비가 오는 탓도",
"있겠지만...」"
],
"2756": [
"「문 소리 정도로는",
"저희 방에선 거의",
"안 들리더군요」"
],
"2757": [
"「그렇지.",
"나도 오늘 아침에 발소리 같은 거",
"못 들었고」"
],
"2758": [
"「...다 적었어.",
"얼핏 보기엔 이상한 데는",
"없는 것 같은데」"
],
"2759": [
"「무슨 일 있어?」"
],
"2760": [
"「아아, 아뇨...」"
],
"2761": [
"「역시 그 시간에 식당에",
"있었다는 사람은 없네요」"
],
"2762": [
"「있으면 무섭지」"
],
"2763": [
"「나고 씨, 이거",
"표로 만드는 게 알기",
"쉽지 않을까요」"
],
"2764": [
"「표?」"
],
"2765": [
"「마다라이 씨가 돌아가셨을",
"시간대를 대충요」"
],
"2766": [
"「알리바이... 라고 하면",
"듣기엔 좀 그렇지만」"
],
"2767": [
"「그, 그래도 그러면",
"이 안에...」"
],
"2768": [
"이 안에 범인이 있는 것 같다고",
"말할 뻔해서 황급히 입을",
"다문다."
],
"2769": [
"다른 사람들은 아직 저마다",
"생각에 잠겨 있는지",
"아무도 이쪽을 보지 않았지만."
],
"2770": [
"「저도 설마 싶긴 하지만요.",
"그래도 만약 모두의 증언을",
"대충 표로 만들어 봐서...」"
],
"2771": [
"「...<co 0f0>있을 수 없는 말을<co>",
"<co 0f0>한 사람이 있다면<co>...」"
],
"2772": [
"오싹, 목덜미에 소름이 돋았다.",
"그런 사람은 없다고 믿고 싶지만",
"만약에, 있다면..."
],
"2773": [
"「뭔가...",
"신경 쓰이는 거라도 있어?」"
],
"2774": [
"「뭐, 아무도 이상한 말을",
"안 했다면 그걸로",
"안심이잖아요」"
],
"2775": [
"「그, 그렇지」"
],
"2776": [
"「알았어,",
"그래도 역시 여기선 좀...」"
],
"2777": [
"「...그렇죠」"
],
"2778": [
"「나중에 방에서라도",
"표로 만들어 볼게」"
],
"2779": [
"불쑥, 쿠라이시 씨가",
"문 쪽으로 향했다."
],
"2780": [
"「어, 어디 가?」"
],
"2781": [
"「방에 돌아가는 거지.",
"이런 상태로 얼굴 맞대 봐야",
"무슨 소용이냐?」"
],
"2782": [
"「그래도 혼자 있는 것도",
"위험하지 않습니까?」"
],
"2783": [
"「...미안하지만 아무도 못 믿어」"
],
"2784": [
"「쿠라이시 씨!!」"
],
"2785": [
"「너희도",
"속으론 그렇지 않나?」"
],
"2786": [
"「옆에 있는 놈이 절대 거짓말",
"안 한다고 확신할 수 있냐?」"
],
"2787": [
"스즈나는 자신과 같은 얼굴의",
"언니를 흘끗 보았지만",
"아무 말도 하지 않았다."
],
"2788": [
"자매 사이엔 신뢰가 있어,",
"거짓말은 안 한다고 믿는 걸까."
],
"2789": [
"(나와 히오리가 서로만은",
"범인이 아닌 걸 알듯이...)"
],
"2790": [
"...하지만.",
"그 밖의 다른 사람들은",
"어떠냐고 하면..."
],
"2791": [
"「얼굴 맞대고 있는 한",
"아까 같은 얘기만 하며",
"지내게 될 거다」"
],
"2792": [
"「...난 이제 사양이다」"
],
"2793": [
"말없는 모두에게 등을 돌리고",
"쿠라이시 씨가 툭 말한다."
],
"2794": [
"「난 데리러 올 때까지",
"방에서 안 나가기로 하지」"
],
"2795": [
"「그런, 하지만...",
"식사 같은 건...」"
],
"2796": [
"「식량이야 부엌에 얼마든지 있지.",
"내 몫만 챙겨 가마」"
],
"2797": [
"「....그럼 간다.",
"살아 있으면 또 보자고」"
],
"2798": [
"「어이, 아저씨...!」"
],
"2799": [
"츠바키 군의 목소리에도 돌아보지 않고",
"쿠라이시 씨는 거실을 나가 버렸다..."
],
"2800": [
"「...뭉쳐 있는 게",
"나을 것 같은데 말이죠」"
],
"2801": [
"「불편하다는",
"마음은 알겠지만...」"
],
"2802": [
"「그래도 말야...",
"이 안에 범인이나 공범이",
"있다니 믿기지 않아」"
],
"2803": [
"「그래,",
"정체 모를 놈이 하나 있으니",
"그놈이 제일 수상하잖아」"
],
"2804": [
"「누구일까」"
],
"2805": [
"「누, 누구냐니... 그런 거...」"
],
"2806": [
"「시쿠라 씨?」"
],
"2807": [
"「아니, 그러니까...",
"왜 시쿠라 씨가 마다라이",
"아저씨를 죽이냐고?」"
],
"2808": [
"「그치만 이 근처에 있을 텐데",
"연락이 안 된다잖아」"
],
"2809": [
"「그런, 하지만...",
"시쿠라 씨가 왜...?」"
],
"2810": [
"「시쿠라 씨가 아니라면,",
"정체 모를 누군가가 또 하나",
"있다는 게 되는데요...」"
],
"2811": [
"「응? 있잖아」"
],
"2812": [
"「어디에!?」"
],
"2813": [
"「봐, 그 사람.",
"나고무 군이 걸려 넘어졌다는」"
],
"2814": [
"「처음 뒤뜰에 쓰러져 있을 때",
"봤다는 사람 말입니까」"
],
"2815": [
"「그 사람도 어디 누군지",
"모르고 어디 갔는지도",
"모르는 거 아니었어?」"
],
"2816": [
"「앗, 저기, 뭐...",
"그렇긴 한데요...」"
],
"2817": [
"「그쪽이 시쿠라 씨일",
"가능성도 있어」"
],
"2818": [
"「어, 어어... 그러니까",
"몇 명이야, 알 수 없는 놈이」"
],
"2819": [
"「이 근처에 있다는데 행방만",
"모르는 게 시쿠라 씨」"
],
"2820": [
"「정체도 행방도 모르는 건",
"어젯밤 주차장에서 장난친 사람,",
"나고 씨가 뒤뜰서 넘어진 사람」"
],
"2821": [
"「그리고...",
"마다라이 씨를 죽인 범인이죠」"
],
"2822": [
"「주차장 놈이랑 범인은",
"같은 놈 아니야?」"
],
"2823": [
"「그걸 단정 못 한다는 게",
"쿠라이시 씨 생각이겠죠」"
],
"2824": [
"「...그럼 정체불명만",
"셋이나 된다는 거잖아」"
],
"2825": [
"「그중 하나는",
"시쿠라 씨일지도 모르지?」"
],
"2826": [
"「그렇죠.",
"이 저택 주변에 왜인지 숨은",
"사람이 넷이나 되는 것도 이상하고」"
],
"2827": [
"「셋도 충분히 이상해!",
"주차장 놈이 범인, 뒤뜰의 사람이",
"시쿠라 씨면 둘로 끝나는데」"
],
"2828": [
"「저, 저기... 하지만...",
"이치야나기 씨는, 뒤뜰의",
"사람은 죽어 있었다고...」"
],
"2829": [
"「앗, 저기, 그렇게 보이긴",
"했는데요... 그래도...」"
],
"2830": [
"「사라졌으니까",
"살아 있던 거 아닐까」"
],
"2831": [
"「범인이 둘러메고 가서",
"숨긴 걸지도 모르잖아!?」"
],
"2832": [
"「...그러면 시쿠라 씨는",
"돌아가신 게 되는데요」"
],
"2833": [
"「그치만...",
"온실에 놓여 있던 거",
"흰 뱀이랑 상관없었어...」"
],
"2834": [
"「뭐? 흰 뱀?」"
],
"2835": [
"「『흰 뱀 살인사건』",
"나구모 씨가 나오는 이야기」"
],
"2836": [
"「아아...",
"확실히 그 이야기엔 고양이도",
"종도 안 나오죠」"
],
"2837": [
"(...고양이...)"
],
"2838": [
"(고양이는, 마다라이 씨...)"
],
"2839": [
"왜 머리에서 안 떠나는 걸까,",
"시즈나가 한 이 말이."
],
"2840": [
"「저, 저기 말야...",
"시즈나는 시쿠라 씨가",
"나구모 씨 역이었다고 봐?」"
],
"2841": [
"「집사 씨가 나구모 씨는",
"타키 프로 소속이라 했으니까」"
],
"2842": [
"「아... 아아, 그렇게 들었어.",
"근데 시쿠라 씨인지까진",
"나도 모른다고...」"
],
"2843": [
"「이런 데에 다른 볼일로",
"우연히 왔다기보단 나구모 역",
"이었을 가능성이 크겠네」"
],
"2844": [
"「음, 그럼 시쿠라 씨는",
"역시 아직 살아 있는 걸까」"
],
"2845": [
"「....글쎄」"
],
"2846": [
"「온실에 흰 뱀 같은 게",
"아무것도 없었다는 것뿐이고」"
],
"2847": [
"「결국 뭐가 뭔지",
"전혀 모르는 채냐...」"
],
"2848": [
"「어쩔 수 없죠.",
"아무리 봐도 정보가 너무 적어요」"
],
"2849": [
"그렇지...",
"정체 모를 존재가",
"몇 명인지조차 모르니까."
],
"2850": [
"여기서 고민해 봤자",
"오히려 혼란스럽기만 할지도."
],
"2851": [
"(쿠라이시 씨는 먼저 혼자",
"그런 결론에 이르러서",
"가 버린 걸까...)"
],
"2852": [
"대화가 끊기자",
"어쩐지 방 공기가 묵직하게",
"무거워진 것 같았다."
],
"2853": [
"불편한 분위기가 서서히",
"더해 가고, 견디다 못한 듯",
"스즈나가 입을 연다."
],
"2854": [
"「......언니」"
],
"2855": [
"「갈래?」"
],
"2856": [
"「......응」"
],
"2857": [
"「아......」"
],
"2858": [
"「...저기, 죄송해요.",
"실례할게요....」"
],
"2859": [
"쌍둥이가 따라 나가듯 떠나자",
"미사사기 씨까지 우물쭈물하다",
"거실을 떠났다."
],
"2860": [
"「칫...",
"시쿠라 아저씨도 살아 있으면",
"얼굴이라도 좀 보여 주지...」"
],
"2861": [
"「음, 그렇구나!",
"그럼 시쿠라 씨를 찾으면 되겠네!」"
],
"2862": [
"「잠깐, 뭔가 건너뛰었어.",
"지금 얘기가 확 건너뛰었다...」"
],
"2863": [
"「그럼, 난 밖을 보고 올게!」"
],
"2864": [
"「그럼은 또 뭐야, 어이!?」"
],
"2865": [
"「아, 겸사겸사 무너진 벼랑도",
"볼 수 있으면 보고 올게! 그럼!」"
],
"2866": [
"「그러니까 그건 위험하다고",
"했잖습니까, 잠깐만...」"
],
"2867": [
"「남의 말 좀 들으라고 인마!!」"
],
"2868": [
"「......가 버렸네」"
],
"2869": [
"「하여간, 근육으로밖에",
"생각을 못 하냐!?」"
],
"2870": [
"「어떡할까요」"
],
"2871": [
"「...따라잡긴 힘들 것 같은데」"
],
"2872": [
"「냅둬, 그 아저씨라면",
"산사태 정도로 안 죽어」"
],
"2873": [
"「...라디오라도 들어",
"둘까, 할 수 없지...」"
],
"2874": [
"「라디오라면 오락실 거?」"
],
"2875": [
"「나도 작은 거 있는데",
"음질이 나빠서 안 들려.",
"난 오락실에 있을게」"
],
"2876": [
"「어차피 식당 열쇠도",
"돌려놔야 하니까」"
],
"2877": [
"「아, 그랬죠.",
"식당 열쇠는 그거 하나입니까?」"
],
"2878": [
"「일단 여벌도 있지만 평소엔 둘 다",
"오락실 케이스에 놔둬.",
"식당은 평소에 잠그지도 않고」"
],
"2879": [
"「뭐, 그것도 그렇겠네요」"
],
"2880": [
"「그럼 난 오락실에서",
"라디오 듣고 있을게」"
],
"2881": [
"「...아, 완전히 잊고 있었네.",
"에, 그럼 실례하겠습니다」"
],
"2882": [
"정중한 태도로 인사하고",
"츠바키 군은 오락실로 향했다."
],
"2883": [
"그러고 보니 그가 집사였던 걸",
"나도 잊고 있었다..."
],
"2884": [
"(하지만 스태프가 와도",
"촬영은 이제 중지되겠지...)"
],
"2885": [
"「자, 나고 씨는 어떡할래요?」"
],
"2886": [
"「...히오리는?」"
],
"2887": [
"「저는...",
"글쎄요, 일단",
"서재에나 있을까 하고」"
],
"2888": [
"「그렇구나...」"
],
"2889": [
"「딱히 할 일 없으면",
"잠깐 같이 가 주지 않을래요」"
],
"2890": [
"「서재에?",
"좋은데, 무슨 일이야?」"
],
"2891": [
"「해 두고 싶은 얘기가",
"있어서요」"
],
"2892": [
"「? ......응」"
],
"2893": [
"뭘까.",
"어쩐지 주위를 꺼리는 듯한",
"분위기가 느껴진다."
],
"2894": [
"누가 듣지 않는 편이",
"좋은 얘기인가 싶어서",
"순순히 따라갔다."
],
"2895": [
"「...아, 맞다」"
],
"2896": [
"「하나 있었어.",
"신경 쓰이는 게...」"
],
"2897": [
"「저기, 뒤쪽 우물 말인데",
"지금은 안 쓰는 걸까?」"
]
}