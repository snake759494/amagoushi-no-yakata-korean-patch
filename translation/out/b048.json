{
 "23933": [
  " 요도자키 모자가 앉은 소파 맞은편에는",
  "히키무라 가족이 앉아 있다. 평소 그런",
  "자리에 앉는 건 당치도 않은 생활을",
  "하고 있을 테니, 히키무라 부부는 너무",
  "긴장한 나머지 돌이 될 것 같은 얼굴로",
  "나란히 몸을 움츠리고 있다.",
  " 그 한가운데서 치나미는 무슨 일이",
  "시작되는 걸까, 하는 호기심 어린 눈을",
  "두리번거리고 있었다."
 ],
 "23934": [
  " 사건 관계자는 피해자인 요도자키",
  "소베에 씨, 그리고 병석의 하쓰 씨",
  "외엔 이로써 전원이 모인 셈이다.",
  " 그런데 명탐정은 조금 전 경감에게",
  "뭔가 부탁한 모양인지, 경감이 방을",
  "나간 뒤 그걸 기다리는 듯 아직",
  "이야기를 시작하려 하지 않는다."
 ],
 "23935": [
  "「어이, 탐정 양반. 아직이야?」",
  " 아니나 다를까, 에이타로가 참다못해",
  "말을 걸어왔다.",
  "「응? 조금만 더 기다려――아아,",
  "돌아오셨군요, 경감님」",
  " 진노 경감이 뒤쪽 문으로 무슨 종이",
  "봉투를 안고 들어왔다. 료스케에게",
  "눈짓으로 고개를 끄덕여 보인다."
 ],
 "23936": [
  " 그걸 확인하자 료스케는 흡족한 미소를",
  "띠며 벽난로 앞으로 걸어 나갔다.",
  "「――자, 여러분」",
  " 이렇게 운을 떼는 게 예의라고 굳게",
  "믿어 의심치 않는다는 표정으로 입을 연",
  "명탐정에게 모두가 주목한다.",
  "「이 요도자키 소베에 씨 구타 사건은",
  "참으로 별난 사건이었습니다」"
 ],
 "23937": [
  " 료스케는 실로 즐거워 보이지만",
  "나는 조마조마했다. 관계자가 한자리에",
  "모였다는 건 이 안에 범인이 있다는",
  "뜻이다. 누가 지목되든 유쾌한 일은",
  "아닐 거라 생각하니 속이 쓰렸다.",
  " 특히――하고 나는 가장 어린 용의자인",
  "소녀를 훔쳐보았다. 치나미는 아직 무슨",
  "일인지 잘 모르는 듯 가만히 료스케를",
  "바라보고 있었다."
 ],
 "23938": [
  "「어쨌든 세 사람이나 잇달아 범인이라고",
  "자원하는 진기한 일로 시작됐으니까요.",
  "그럼, 그중에 정말로 범인이 있는가?",
  "순서대로 가 보죠」",
  " 범인, 이라는 말이 나오자마자 순간",
  "방 안에 긴장이 흐른 것 같았다.",
  "「그럼 우선, 가장 먼저 자원한",
  "요도자키 하나코 씨. 당신이 범인이",
  "아니라는 건 이미 알고 있습니다만――」"
 ],
 "23939": [
  "「저, 저는, 그게」",
  " 료스케가 얼른 넘어가려는 기색을",
  "눈치챘는지, 하나코는 황급히 뭔가",
  "말하려 했다.",
  " 하지만 에이타로가 소리쳐 그걸",
  "막았다.",
  "「아니라잖아! 누나는 가만있어!」",
  "「하지만...」",
  "「자자, 조용히 해 주세요」"
 ],
 "23940": [
  " 짝짝, 손뼉을 쳐서 남매의 말다툼을",
  "멈추게 하고 료스케는 말을 이었다.",
  "「하나코 씨가 서재를 찾았을 때,",
  "요도자키 씨는 이미 쓰러져 있었어요.",
  "그리고 곁에 떨어진 도감을 보고",
  "그게 흉기라고 오해했죠」",
  " 하나코는 창백한 얼굴로 고개를 숙였다.",
  "옆의 시마코가 위로하듯 어깨를 안았다."
 ],
 "23941": [
  "「그리고 하나코 씨는 도감을 주워",
  "들고, 처분해야겠다고 생각해 소각로로",
  "달려갔죠. 이렇게 조류도감 한 권이",
  "서재에서 사라집니다. 그런데...」",
  " 료스케는 미리 벽난로 위에 놓아 둔",
  "도감 상자를 집어 들었다.",
  "「...상자는 남아 있었다」",
  " 식물도감이 들어 있던 상자다."
 ],
 "23942": [
  "「허둥대던 하나코 씨는 도감이",
  "상자에서 꺼내진 상태라는 걸 모른 채",
  "도감만 소각로에 던져 넣은 거죠.",
  "참고로 이 상자에는 식물도감이 들어",
  "있었는데, 이상하게도 그 식물도감의",
  "상자는 보이지 않습니다」",
  " 점점 영문을 알 수 없게 되었는지",
  "일동은 미심쩍은 표정을 짓기",
  "시작했다."
 ],
 "23943": [
  "「그리고 하나코 씨의",
  "이 행동 때문에",
  "더 큰 오해를 한 사람이 있습니다」",
  "「네...」",
  " 퍼뜩 하나코가 고개를 들었다.",
  "「허둥지둥 뒤뜰을 달려가는 하나코",
  "씨. 소각로에는 계단이 몇 단 있으니",
  "멀리서도 그걸 오르는 게 보이면 뭔가",
  "태우고 있다는 건 알 수 있습니다」"
 ],
 "23944": [
  " 그 점은 집안사람이라면 누구나 짐작이",
  "가는 일인 듯, 모두 한결같이 납득한 듯",
  "고개를 끄덕였다.――한 사람만 빼고.",
  "「수상히 여겨 소각로를 들여다보니",
  "웬일인지 도감이 타고 있다. 무슨 일이",
  "있었나 하고 서재에 가 보려 해도 이상할",
  "게 없죠. 그러면 발견하는 건 쓰러져",
  "있는 요도자키 씨입니다」"
 ],
 "23945": [
  " 어렴풋이 짐작이 가기 시작했는지,",
  "일동의 시선이 한 점에 모이기 시작한다.",
  "「순간 이렇게 생각한 거죠. 같은 흉기를",
  "어딘가 눈에 띄기 쉬운 곳에 버리고",
  "자기가 범인이라고 나서 버리자, 고」",
  "「시――시끄러워!!」",
  " 쏟아지는 시선을 견디지 못했는지",
  "에이타로가 고함을 쳤다."
 ],
 "23946": [
  "「내가 나중이라는 걸 어떻게 알아?",
  "먼저 도감으로 후려친 게 나일지도",
  "모르잖아!?」",
  "「억지 부리지 마. 그럼 자넨 흉기는",
  "현장에 두고 상관없는 도감을 일부러",
  "연못에 버렸다는 거야?」",
  "「그, 그건――」",
  " 에이타로는 뭔가 받아치려 했지만",
  "그보다 먼저 료스케가 입을 열었다."
 ],
 "23947": [
  "「만에 하나 그런 기묘한 짓을 했다고",
  "우겨 봐야 불가능해. 흉기는 말이야,",
  "도감이 아니거든」",
  "「뭐...뭐라고...?」",
  "「실제 흉기가 도감이 아닌데도",
  "도감이 흉기라고 믿다니, 그건 먼저",
  "같은 오해를 한 사람을 봤다고밖엔",
  "생각할 수 없지」"
 ],
 "23948": [
  " 그렇게 말하며 료스케는 내용물이 없어진",
  "조류도감 상자를 들어 올렸다.",
  "「불타는 소각로 안에서 자넨 이것과 같은",
  "표지의 도감을 봤겠지. 그리고 서재에 가",
  "보니 쓰러진 요도자키 씨를 발견했다」",
  "「에이...」",
  " 허둥거리며 하나코가 곤란한 목소리를",
  "냈다."
 ],
 "23949": [
  "「시, 시끄러워! 누나가 헷갈리게",
  "굴었으니까 그런 거잖아!?」",
  " 순간 에이타로는 새빨개져서 고개를",
  "홱 돌렸다.",
  "「자네도 별반 다르지 않잖아」",
  " 매몰차게 말하고 료스케는 휙 도감",
  "상자를 벽난로 위에 던져 놓았다.",
  "「그런데 식물도감 상자는 어떻게",
  "했지? 서재엔 없던데」"
 ],
 "23950": [
  "「...찢어서 버렸어. 지금쯤",
  "쓰레기랑 같이 수거됐겠지」",
  " 마침내 체념했는지, 에이타로가",
  "퉁명스럽게 중얼거렸다.",
  "「그렇군. 그것도 바닥에 떨어져",
  "있었나? 아니면 책상?」",
  "「아버지 몸 저편에 있었으니까,",
  "누나가 깜빡 두고 간 줄로...」"
 ],
 "23951": [
  " 몹시 겸연쩍은 목소리로 말하며",
  "에이타로는 그 자리에 쪼그려 앉았다.",
  "「젠장, 대체 뭐야? 누나가 아니면",
  "대체 누가...!」",
  "「그래, 이로써 거짓말한 사람이 둘까지",
  "드러난 셈이야. 남은 건 한 명」",
  " 그렇게 말하고 료스케는 에이타로에게서",
  "다른 사람들 쪽으로 돌아섰다.",
  "「마지막 거짓말쟁이는――자네야」"
 ],
 "23952": [
  " 료스케가 똑바로 가리킨 인물, 그",
  "굳은 표정에 모두의 시선이 쏠렸다.",
  "「요도자키 조타로 군. 이제 슬슬",
  "진실을 이야기하지 않겠나」",
  "「저...저는...!」",
  "「형...?」",
  "「어, 오라버니...?」",
  " 당황하는 조타로를 보고 하나코와",
  "에이타로가 저마다 형제를 불렀다."
 ],
 "23953": [
  "「사, 사고다, 분명히! 사고야,",
  "그렇지!?」",
  " 조타로는 료스케에게 필사적으로 외쳤다.",
  " 그것을 창백한 얼굴로 시마코와 하나코가",
  "올려다보고 있었다.",
  "「조타로...너, 너 아무 짓도 안",
  "했다고...」",
  " 시마코는 믿을 수 없다는 목소리로",
  "장남에게 손을 뻗었다."
 ],
 "23954": [
  "「어, 잠깐만요 어머니! 저는",
  "아무 짓도 안 했어요!?」",
  "「그, 그래도 탐정님이...」",
  "「아아, 시마코 씨. 오해하시면",
  "안 됩니다」",
  "「네...?」",
  "「저는 조타로 군이 거짓말을 했다고",
  "했을 뿐입니다. 그가 범인이라고는",
  "하지 않았어요」"
 ],
 "23955": [
  "「그게 무슨 뜻이야!?」",
  " 엉거주춤 일어서며 에이타로가 외쳤다.",
  " 아무리 치나미라도 심상치 않은",
  "사태임을 깨달았는지, 조금 무서운 듯",
  "어머니의 옷자락에 매달렸다.",
  "「조타로 군의 증언 중 진실이 아닌 건",
  "때린 게 자기가 아니라는 말 이외야」",
  "「이외? 이외라니...」"
 ],
 "23956": [
  " 영문을 몰라 시마코는 료스케와 아들의",
  "얼굴을 번갈아 바라보았다.",
  " 료스케는 시마코의 시선에 답하듯 입을",
  "열었다.",
  "「그리고 조타로 군의 거짓말 역시",
  "누군가를 감싸기 위한 거짓말이었습니다.",
  "곧바로 요도자키 씨의 상태를 살핀 건",
  "사실이겠죠. 그리고 이 정도면 큰일은",
  "없겠다고 판단했던 걸까요」"
 ],
 "23957": [
  "「...제가 처음 발견했을 땐 아직",
  "피도 그렇게 많이 나지 않았어요.",
  "쓰러져 있는 동안 점점 흘러나와서,",
  "어머니가 왔을 땐 꽤 심해 보이는",
  "상태가 됐지만요」",
  " 발뺌은 못 한다고 생각했는지",
  "조타로는 순순히 인정했다.",
  "「하지만 탐정님, 제가 누군가를",
  "감싼다는 걸 어떻게 아신 겁니까」"
 ],
 "23958": [
  "「자네가 직접 그렇게 말했잖나」",
  "「제가...?」",
  " 그렇다, 료스케는 요도자키 가에",
  "오기 전에도 그런 말을 했었다.",
  "하지만 조타로는 다른 두 사람과 달리",
  "이상한 공작을 한 것도 없는데...",
  "「진노 경감에게서 이미 자수한 사람이",
  "있다는 말을 들었을 때, 자넨 이렇게",
  "말했지?」"
 ],
 "23959": [
  " ――말도 안 돼...! 경감님,",
  "설마 그걸 진심으로 믿으시는 겁니까?"
 ],
 "23960": [
  "「...그걸 진심으로. 그거란 무엇을",
  "가리키는 걸까요? 보통 자수한 사람이",
  "있다고 들으면 가장 먼저 나올 말은",
  "'누가'가 아니겠습니까?",
  " 조타로 군, 자네의 그 놀람은 누가",
  "뭐라고 자수했는지 짐작이 가는 사람의",
  "대사야」",
  "「아...아아, 그렇,",
  "군요...그렇군요, 그런 한마디로...」"
 ],
 "23961": [
  "「그리고 자넨 에이타로 군은 범인이",
  "아니라고도 주장했다지. 그야 그렇겠지,",
  "자네가 아는 범인은 에이타로 군이",
  "아니니까. 그리고 물론 하나코 씨도",
  "아니고」",
  " 오싹, 등골에 싸늘한 것이 스쳤다.",
  "조금 전부터――조타로가 범인이 아니라는",
  "말을 들었을 때부터 다른 용의자는 이미",
  "없어진 셈이긴 했지만..."
 ],
 "23962": [
  "「그럼 소개하죠. 이 사건의 진범을」",
  " 조타로가 또 뭔가 말하려 했다.",
  "하지만 료스케의 손이 가리킨 쪽을",
  "보고 의아한 표정이 되었다. 그건",
  "나도 마찬가지였다.",
  " 그쪽에 있는 건 진노 경감뿐이었기",
  "때문이다. 그리고 지목된 경감은 그",
  "종이봉투에서 무언가를 꺼냈다.",
  "「――요정님이다!」"
 ],
 "23963": [
  " 치나미가 소리쳤다. 경감의 손에",
  "들린 것은 온실 안쪽에 장식되어 있던",
  "전쟁 여신의 청동상이었다.",
  "「요정...이라니, 저게...?」",
  "「그래, 아는 사람이 보면 북유럽의",
  "전쟁 여신 발키리지만 말이야.",
  "여기서는 치나미에게 경의를 표해서",
  "요정님이라고 부르기로 하지」"
 ],
 "23964": [
  "「요정님 아니야?」",
  "「아니, 요정님 맞아. 치나미는 계속",
  "사이좋게 지냈지?」",
  "「응」",
  " 치나미는 천진하게 끄덕였다.",
