"22271": [
"(그래도... 역시...)"
],
"22272": [
"이것저것 생각하게",
"된단 말이야..."
],
"22273": [
"보고 들은 일들이 차례차례",
"머릿속에 떠오른다."
],
"22274": [
"(좀 더 정리가 안",
"되려나...)"
],
"22275": [
"「......안 되겠다」"
],
"22276": [
"졸려 오기 시작했다.",
"역시 난 너무 골똘히",
"생각하는 데는 안 맞아..."
],
"22277": [
"(슬슬 자자...)"
],
"22278": [
"하품을 하며 침대 속으로",
"파고들었다."
],
"22279": [
"내일은 제발 비가 그쳐 주면",
"좋겠다..."
],
"22280": [
"(...안 들어줄지도",
"모르지만...)"
],
"22281": [
"일단 쿠라이시 씨 방문을 노크",
"해 본다."
],
"22282": [
"「쿠라이시 씨, 저기...」"
],
"22283": [
"「끈질기구나, 너!」"
],
"22284": [
"...다짜고짜 호통을 들었다."
],
"22285": [
"「몇 번이나 영문 모를 소릴",
"해야 직성이 풀리는 거냐!?」"
],
"22286": [
"「아뇨, 저기, 이번엔...」"
],
"22287": [
"「이번엔, 이 아니야!",
"귀찮은 소리만 늘어놓지",
"말고 얼른 꺼져!」"
],
"22288": [
"역시 안 되겠다...",
"전혀 믿어 주지 않는다."
],
"22289": [
"「....그래도!",
"쿠라이시 씨, 저 정말 위험해서」"
],
"22290": [
"「네가 말 안 해도",
"그딴 건 알고 있다고!」"
],
"22291": [
"「네가 걱정할 일이",
"아니니까 꺼지라고!」"
],
"22292": [
"어떻게 할 도리가 없을 것 같다...",
"포기하고 방으로 돌아가자."
],
"22293": [
"「...하아...」"
],
"22294": [
"어떡하지...",
"이대로 자 버릴까.",
"아니면..."
],
"22295": [
"(...별로 안 졸리네)"
],
"22296": [
"여러 가지 일이 머리에 떠올라서",
"바로 잠들 수 있을 것 같지 않았다."
],
"22297": [
"(신경 쓰여서 못 참겠으니",
"잠깐 머릿속을 정리해 보자)"
],
"22298": [
"「....하암」"
],
"22299": [
"좀 졸려 오나.",
"연달아 하품이 나온다."
],
"22300": [
"쿠라이시 씨 방 앞으로 가서",
"주위에 아무도 없는 걸 확인한 뒤",
"노크해 본다."
],
"22301": [
"「쿠라이시 씨, 쿠라이시 씨」"
],
"22302": [
"「....꼬마냐?」"
],
"22303": [
"「네, 맞아요」"
],
"22304": [
"「왜 그러냐?",
"밥 접시냐?」"
],
"22305": [
"「아뇨, 저기...",
"낮에 한 얘기 말인데요」"
],
"22306": [
"「낮에... 아아...」"
],
"22307": [
"쿠라이시 씨는 문득 표정이 어두워진다.",
"그야 그렇겠지, 즐거운 화제일",
"리가 없다."
],
"22308": [
"「뭐, 어차피 오늘 밤은 안 자고",
"깨어 있을 생각이지만...」"
],
"22309": [
"「그래도 혼자는 위험해요」"
],
"22310": [
"「그렇다고 네가 호위라는",
"것도 좀...」"
],
"22311": [
"「미, 미덥진 않지만요」"
],
"22312": [
"「고양이랑 별 차이 없어」"
],
"22313": [
"「으... 아니 그래도, 여차하면",
"큰 소리로 사람 부르는 정도는」"
],
"22314": [
"「그딴 건 나 혼자서도",
"할 수 있잖아」"
],
"22315": [
"「그렇긴 한데, 그래도...」"
],
"22316": [
"「...참, 왜 이런 생판",
"남한테 그렇게까지 신경을",
"쓰려는 거냐, 너희는...」"
],
"22317": [
"「그... 그치만...」"
],
"22318": [
"「그치만, 뭐」"
],
"22319": [
"「무.. 무서우니까...」"
],
"22320": [
"「그치만 무섭잖아요,",
"아침에 일어나면 사람이 줄어 있어요?」"
],
"22321": [
"「어제까지 멀쩡했는데",
"아침이 되면 갑자기 말도 안 되는",
"상태로 시체가 돼 있고」"
],
"22322": [
"「...너...」"
],
"22323": [
"「솔직하군」"
],
"22324": [
"「하고많은 말 중에",
"무서우니까, 냐」"
],
"22325": [
"「드라마 대본이었으면",
"감독한테 얻어맞았다」"
],
"22326": [
"「죄송해요...」"
],
"22327": [
"「....아아, 정말.",
"어쩔 수 없군...」"
],
"22328": [
"「알았다, 들어와」"
],
"22329": [
"「네?」"
],
"22330": [
"「네, 가 아니잖아.",
"설마 방 앞에서 밤새도록",
"서 있을 생각이었냐?」"
],
"22331": [
"「아뇨, 저기, 그래도 방에서",
"쿠션 정도는 가져올까 했는데」"
],
"22332": [
"「안 가져와도 되니까",
"방 안에 들어와 있어!」"
],
"22333": [
"깜짝 놀랐다...",
"설마 방에 들여보내 줄 줄은",
"몰랐다."
],
"22334": [
"그렇게 경계심 강한 사람이니",
"복도에서 밤새울 거라고 각오",
"했었는데..."
],
"22335": [
"「뭘 멍하니 있냐.",
"그 근처에 앉아」"
],
"22336": [
"적당히 자리에 앉는다.",
"쿠라이시 씨는 파란 포장 상자에서",
"담배를 꺼내 불을 붙였다."
],
"22337": [
"(아, 담배 냄새였구나...)"
],
"22338": [
"방에 들어왔을 때부터",
"뭔가 쓰고 탄 듯한 냄새가",
"난다 싶었거든."
],
"22339": [
"「꼬마는 안 피우겠... 지」"
],
"22340": [
"「네, 저는...」"
],
"22341": [
"「사레들리냐?」"
],
"22342": [
"「아뇨, 맛이.",
"써서...」"
],
"22343": [
"쿠라이시 씨는 잠깐 내 얼굴을",
"빤히 쳐다보더니",
"크게 웃음을 터뜨렸다."
],
"22344": [
"「쓰다니 그게 뭐냐!",
"몇 살이냐, 꼬마?」"
],
"22345": [
"「스물하나예요...」"
],
"22346": [
"「그럼 술도 안 되냐」"
],
"22347": [
"「전혀 못 마셔요」"
],
"22348": [
"「네가 배우가 아니라 다행이다.",
"내 후배였으면 어디 데려가야",
"좋을지 모르겠다」"
],
"22349": [
"「후배분들 데리고 술 마시러",
"가시고 그래요?」"
],
"22350": [
"「당연하지.",
"나도 신참 땐 선배 뒤를",
"졸졸 따라다녔으니까」"
],
"22351": [
"「자기가 얻어먹은 만큼은",
"다음 세대에 갚는 게 예의지」"
],
"22352": [
"「왠지 운동부 같네요」"
],
"22353": [
"「비슷한 거지.",
"선배 후배라는 게」"
],
"22354": [
"「너도 못 마셔도",
"어울리느라 끌려가는 일",
"정도는 있을 거 아냐」"
],
"22355": [
"「네, 저기, 미팅 인원수가",
"안 맞는다든가 해서」"
],
"22356": [
"「흥, 미팅이라.",
"그럼 좋잖아」"
],
"22357": [
"「근데 저 항상 정신 차려 보면",
"취한 여자애 푸념 들어 주는",
"사이에 선배가 없어져 있어서」"
],
"22358": [
"「...뭐 하는 거냐, 너」"
],
"22359": [
"「왠지 잘 휘말려요.",
"역 앞에서 모르는 회사원한테",
"울며 매달린다든가」"
],
"22360": [
"「...너, 이상한 항아리나",
"엄청 비싼 이불 같은 거",
"사 온 적 없냐?」"
],
"22361": [
"「아뇨, 다행히 그런 건 없어요.",
"그런 사람이 말을 걸면",
"전력으로 뛰어서 도망치니까요」"
],
"22362": [
"「일단 알고는 있구만」"
],
"22363": [
"「그치만 얘기를 들어 버리면",
"어떻게 거절해야 할지」"
],
"22364": [
"「왜 생판 남의 방 앞에서",
"밤새 앉아 있을 생각을 했는지",
"어쩐지 알겠다」"
],
"22365": [
"「요컨대 바보로구만」"
],
"22366": [
"부정할 수가 없다...",
"어떤 의미론 제정신이 아니라고",
"나 스스로도 생각하니까."
],
"22367": [
"「그런 한심한 얼굴 하지 마.",
"그런 녀석은 있는 편이 좋아」"
],
"22368": [
"「뻔하잖아.",
"재밌으니까 그렇지」"
],
"22369": [
"「...재밌다...」"
],
"22370": [
"「배우 중에도 가끔이지만",
"너 같은 녀석이 있는데」"
],
"22371": [
"「꼭 그런 녀석들이",
"일찍 죽거나 길을 잘못 들거나",
"한단 말이야...」"
],
"22372": [
"무언가를 떠올리듯, 쿠라이시 씨는",
"감회에 젖은 듯 눈을 가늘게 떴다."
],
"22373": [
"「배우에는 안",
"맞는 걸까요」"
],
"22374": [
"「아니, 천재라고밖에 생각 안 되는",
"녀석도 있지, 가끔은」"
],
"22375": [
"「다만 하나같이 바보라서 말이야.",
"질 나쁜 놈들이 꼬여서",
"속아도 모를 정도로」"
],
"22376": [
"「역시 연예계에는",
"그런 무서운 사람도 많이",
"있나요」"
],
"22377": [
"「그야 그렇지...",
"그렇다고 그것만 있는 건 아냐」"
],
"22378": [
"「그런 놈들뿐이었으면",
"누가 좋아서 인생의 절반을",
"푹 담그고 있겠냐」"
],
"22379": [
"「뭐, 이것저것 있지.",
"상식으론 있을 수 없는 얘기부터",
"괴담인가 싶은 얘기까지」"
],
"22380": [
"「괴, 괴담이라니」"
],
"22381": [
"「...뭐야 꼬마.",
"그래, 싫어하냐 괴담」"
],
"22382": [
"「싫어요 약해요 완전 안 돼요,",
"그런 얘긴 관심도 없어서요」"
],
"22383": [
"「...붉은 카메오 얘기",
"들어 본 적 있냐?」"
],
"22384": [
"「몰라요 전혀 몰라요!」"
],
"22385": [
"「그래, 그럼 들어라」"
],
"22386": [
"「아침까지 기니까",
"심심하지 않고 좋잖아」"
],
"22387": [
"「이건 바로 얼마 전에",
"실제로 있었던 얘긴데...」"
],
"22388": [
"「쿠라이시 씨이이!!」"
],
"22389": [
"울며 빌어도 멈춰 줄 것 같지",
"않았다..."
],
"22390": [
"뭐, 뭐지...!?",
"방 밖에서 울려오는 큰 소리에",
"놀라서 벌떡 일어난다."
],
"22391": [
"「...뭡니까?」"
],
"22392": [
"「저거... 시계...?」"
],
"22393": [
"시계 소리, 같은 느낌이다.",
"그러고 보니 현관 앞 홀에 커다란",
"괘종시계가 있었지..."
],
"22394": [
"「왜 이런 시간에...」"
],
"22395": [
"「...어떡하지?」"
],
"22396": [
"「보고 오는 게 좋겠죠」"
],
"22397": [
"「위, 위험하지 않아?",
"오늘은 히오리가...」"
],
"22398": [
"「내버려 두는 것도 찜찜하잖아요?」"
],
"22399": [
"「그, 그럼 나도 갈게」"
],
"22400": [
"(아무도 없는 것 같다...)"
],
"22401": [
"방에 못 들어오니까",
"꾀어내려고 울린 거라면",
"범인이 덮쳐 올지도 모른다."
],
"22402": [
"그렇게 생각하며 필사적으로 둘러보며",
"걸었지만 인기척은 없었다."
],
"22403": [
"「몇 번 울렸는지 기억해요?」"
],
"22404": [
"「몇 번이더라...",
"다섯 번 이상은 울린 것 같아」"
],
"22405": [
"살금살금 1층으로 내려와",
"대시계 앞에 선다."
],
"22406": [
"「왜일까?",
"전에 츠바키 군이 밤중엔 안 울리게",
"돼 있다고...」"
],
"22407": [
"「이상하죠」"
],
"22408": [
"「8시...?」"
],
"22409": [
"대시계 바늘은 8시를 가리키고 있었다.",
"나도 모르게 창을 보지만 밖은 아직",
"캄캄했다."
],
"22410": [
"「...아침 8시일 리는 없지」"
],
"22411": [
"「밤 8시도 아니고요」"
],
"22412": [
"「그럼 왜...」"
],
"22413": [
"「시계 자체는 낡았으니까",
"어느새 늦어졌을지도",
"모르지만요」"
],
"22414": [
"「그래도... 지금까지 한 번도",
"안 울렸잖아...」"
],
"22415": [
"「첫날 마다라이 씨가 시끄러워해서",
"츠바키 씨가 끈 뒤론 안 울렸어요」"
],
"22416": [
"「그, 그렇다는 건... 누가 울리게",
"다시 설정한 사람이 있다...?」"
],
"22417": [
"「그쪽까지 고장 난 게 아니라면",
"누군가 한 거겠죠」"
],
"22418": [
"「그... 그건 역시...」"
],
"22419": [
"「절 방에서 꾀어내고",
"싶었던 것치곤",
"아무도 안 덮치네요」"
],
"22420": [
"「근처에서 동태를 살피는",
"것 같지도 않고」"
],
"22421": [
"「아무도 없어?",
"정말 없는 거지?」"
],
"22422": [
"「괜찮아요,",
"아무도 없어요」"
],
"22423": [
"「그럼 대체 뭘 위해",
"울린 걸까...?」"
],
"22424": [
"「장난치곤",
"좀 고약하네요」"
],
"22425": [
"「끌 수 있어?」"
],
"22426": [
"「될까요...",
"뭐, 봐 보죠」"
],
"22427": [
"「내버려 두면 한 시간마다",
"깨게 될 테니까요」"
],
"22428": [
"히오리는 시계 뒤를 들여다보고",
"간신히 뚜껑을 찾아냈다."
],
"22429": [
"「아, 그거 아냐?",
"ON으로 돼 있는 거」"
],
"22430": [
"「이건가 보군.",
"그럼 OFF로 해 둘게요」"
],
"22431": [
"딸깍, 하고 손잡이를 움직여",
"OFF로 되돌린다."
],
"22432": [
"「내친김에 시간도 되돌려",
"놓을까요」"
],
"22433": [
"「아, 그게 낫겠다」"
],
"22434": [
"「음...",
"아마 이거 같은데요」"
],
"22435": [
"「아, 움직인다, 바늘.",
"그게 맞나 봐」"
],
"22436": [
"「나고 씨, 제 소매에서",
"시계 꺼내서 봐 주세요」"
],
"22437": [
"「응, 잠깐만」"
],
"22438": [
"히오리의 기모노에서 회중시계를",
"꺼내 시간을 본다."
],
"22439": [
"「...아직 3시야...",
"음, 조금 더 돌려」"
],
"22440": [
"「이 정도예요?」"
],
"22441": [
"「조금만 더... 아, 그쯤」"
],
"22442": [
"「이러면 됐나요?」"
],
"22443": [
"「응, 맞아.",
"자, 시계」"
],
"22444": [
"「고마워요.",
"이거 원, 뭐였을까요」"
],
"22445": [
"원래대로 시간을 새기기 시작한",
"대시계를 보며 고개를 갸웃한다."
],
"22446": [
"「뭐, 어쨌든",
"아침까지 좀 더 쉽시다」"
],
"22447": [
"「...응, 그러자」"
],
"22448": [
"결국 범인이 아니더라도",
"아무도 보러 오지 않았네.."
],
"22449": [
"「왜 그래요?」"
],
"22450": [
"「아니...",
"그러고 보니 허둥대느라 문도",
"안 잠그고 나왔구나 싶어서」"
],
"22451": [
"「아아, 그러고 보니...",
"설마 아무도 없겠지만요」"
],
"22452": [
"왠지 무서워져서 침대 밑이나",
"옷장 안을 들여다본다."
],
"22453": [
"...아무도 없었다."
],
"22454": [
"내친김에 방을 나올 때 떼어 둔",
"문 장치도 원래대로 해 놨다."
],
"22455": [
"「이제 괜찮겠죠」"
],
"22456": [
"「응, 잘 자...」"
],
"22457": [
"안심하고 침대 속으로 파고든다.",
"금세 졸음이 돌아와 잠들어",
"버렸다..."
],
"22458": [
"억지로라도 모방할 것"
],
"22459": [
"이것도 추리물이니까"
],
"22460": [
"모방하기 쉬워 보여서"
],
"22461": [
"추리소설이라곤 할 수 없다"
],
"22462": [
"감"
],
"22463": [
"다카토 작품이라곤 할 수 없다"
],
"22464": [
"등장인물이 닮았다"
],
"22465": [
"틀림없다고 단언한다"
],
"22466": [
"「음, 수첩에라도",
"적어 두는 게 좋겠지...」"
],
"22467": [
"「필요한 건 날짜랑",
"그날 쓰일 것 같은 책이랑",
"노려질 것 같은 사람이겠죠」"
],
"22468": [
"「쓰일 것 같은 책이라.",
"이렇게 많으면 다 읽을",
"시간은 절대 없겠지」"
],
"22469": [
"「우선 무리죠.",
"다 읽다간 그것만으로",
"모든 게 끝나 버려요」"
],
"22470": [
"「어떻게든 짐작을 하고 나서",
"범위를 좁혀 찾을 수밖에 없겠네요」"
],
"22471": [
"「그렇지.",
"근데 일단 온실에 이상한 게",
"놓여 있다고 해도...」"
],
"22472": [
"「난 책 내용을 모르니까",
"온실 물건을 봐도 뭘 암시하는지",
"감이 안 올지도」"
],
"22473": [
"「그렇네요...",
"권수도 많고, 저라도 이거라고",
"단언하긴 어려울 것 같지만」"
],
"22474": [
"「대충 짐작하는 정도라면",
"도와드릴 수 있을 거예요」"
],
"22475": [
"「그렇구나,",
"그럼 뭘 암시하는지",
"떠오르지 않으면 물어볼게」"
],
"22476": [
"「일단 표는",
"이런 느낌으로...」"
],
"22477": [
"「모방에 쓰인 책 말인데」"
]
}