 "24605": [
  "(...무서워할 때가",
  "아니라니까...)"
 ],
 "24606": [
  "문을 노크하는 게 왠지 갑자기",
  "무서워져서 좀처럼 못 두드린다."
 ],
 "24607": [
  "두세 번 오른손을 들었다 내리는",
  "의미 없는 동작을 되풀이하고 나서",
  "겨우 문을 두드렸다."
 ],
 "24608": [
  "「쿠라이시 씨...?」"
 ],
 "24609": [
  "「저기, 쿠라이시 씨.",
  "실례합니다...」"
 ],
 "24610": [
  "...대답은 없었다.",
  "방에서 나오기 싫어하는 상태니까",
  "무시당하는 건지도 모르지만."
 ],
 "24611": [
  "(그래도 만약 그게",
  "아니라면...)"
 ],
 "24612": [
  "「쿠라이시 씨~!",
  "쿠라이시 씨, 저기...」"
 ],
 "24613": [
  "「안 나오셔도 되니까",
  "대답만이라도 해 주실래요?」"
 ],
 "24614": [
  "...한동안 기다려 봤지만,",
  "역시 아무 반응도 없었다."
 ],
 "24615": [
  "큰맘 먹고 손잡이를 잡아 봤다."
 ],
 "24616": [
  "「안 열려...",
  "당연한가...」"
 ],
 "24617": [
  "큰일이네, 여벌 열쇠는 쿠라이시 씨가",
  "방에 가져갔으니까",
  "오락실에도 없을 거다."
 ],
 "24618": [
  "(어쩌지?",
  "부수는 수밖에 없나...)"
 ],
 "24619": [
  "(...무시당한 것뿐이라면",
  "혼나겠지)"
 ],
 "24620": [
  "아니, 그러니까 그럴 때가 아니라.",
  "무시당한 것뿐이 아니라면",
  "큰일이니까 곤란한 거라고."
 ],
 "24621": [
  "「아아아, 어쩌지...」"
 ],
 "24622": [
  "「부순다 해도, 어차피 나 혼자선",
  "절대 무리니까...」"
 ],
 "24623": [
  "애초에 맨손으로 부술 수 있을 리 없다.",
  "무슨 도구 같은 게 필요할 테고,",
  "혼자선 무리일 것 같고."
 ],
 "24624": [
  "「히오리~! 잠깐만 히오리~!」"
 ],
 "24625": [
  "「히오리... 아, 있다!」"
 ],
 "24626": [
  "「어라, 나고 씨.",
  "어디 가 계셨습니까?」"
 ],
 "24627": [
  "「...그렇게 얼굴색이 변해서는,",
  "무슨 일 있으셨습니까」"
 ],
 "24628": [
  "「있었다기보다,",
  "있을지도...」"
 ],
 "24629": [
  "나는 우선 오락실과 뒤뜰에서",
  "발견한 것들을 설명한다."
 ],
 "24630": [
  "「...그래서, 걱정돼서",
  "쿠라이시 씨 방에 가 봤는데",
  "대답도 없어서...」"
 ],
 "24631": [
  "「안에 누가 있는 것 같은",
  "기척도 없었습니까?」"
 ],
 "24632": [
  "「거기까진 모르겠지만,",
  "소리 같은 건 안 났어...」"
 ],
 "24633": [
  "「...상태를 보는 게",
  "좋겠네요」"
 ],
 "24634": [
  "「네, 사건과 상관없이",
  "그냥 몸이 안 좋아서",
  "쓰러져 있어도 큰일이죠」"
 ],
 "24635": [
  "「그렇지?",
  "억지로라도 열어 보는 게",
  "좋겠지, 역시」"
 ],
 "24636": [
  "「문제는 어떻게",
  "여느냐네요」"
 ],
 "24637": [
  "「오락실엔 이제",
  "여벌 열쇠가 없으니」"
 ],
 "24638": [
  "「응...",
  "문 부수는 수밖에 없나」"
 ],
 "24639": [
  "「그건 되도록이면",
  "최후의 수단으로 하고 싶네요」"
 ],
 "24640": [
  "「일단 어떻게 안 되나",
  "쓸 만한 걸 찾아봅시다」"
 ],
 "24641": [
  "「겸사겸사, 나고 씨가",
  "발견했다는 것도 보여 주십쇼」"
 ],
 "24642": [
  "「어, 우선",
  "거기 창가 쪽...」"
 ],
 "24643": [
  "「...여기 말입니까?」"
 ],
 "24644": [
  "히오리는 창 옆에 다가가 쪼그려 앉아,",
  "바닥이며 창틀을 가만히 바라본다."
 ],
 "24645": [
  "「비가 들이칠 걸 알면서",
  "이런 데 창문을 굳이 열 사람은",
  "없을 텐데 말이죠...」"
 ],
 "24646": [
  "「나도 그렇게 생각하는데」"
 ]
}