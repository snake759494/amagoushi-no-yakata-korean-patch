"8104": [
"『어제 아침 일찍이요.",
"6시 반쯤이었던가...』"
],
"8105": [
"「어제...?」"
],
"8106": [
"『2층 복도예요.",
"제가 일찍 잠이 깨 버려서,",
"방을 나왔거든요...』"
],
"8107": [
"『그때, 쿠라이시 씨가",
"화장실에 들어가시는 걸",
"봤어요』"
],
"8108": [
"「그랬군요...",
"그 뒤엔 부엌이나 어디에?」"
],
"8109": [
"『...거실에 있었어요.",
"뭘 하고 있었던 건",
"아니지만...』"
],
"8110": [
"『점점, 방에 가만히 있는 것도",
"숨이 막히는 것 같아서...』"
],
"8111": [
"「...그렇죠...」"
],
"8112": [
"『네...』"
],
"8113": [
"『죄송해요, 그럼...』"
],
"8114": [
"「...네.",
"실례했습니다...」"
],
"8115": [
"『어머...?",
"잠깐만요, 이치야나기 씨』"
],
"8116": [
"『저기, 어젯밤엔 분명,",
"제가... 라고...』"
],
"8117": [
"「죄송해요!",
"제 실수예요...」"
],
"8118": [
"『........』"
],
"8119": [
"「죄송합니다...",
"제가 틀렸어요」"
],
"8120": [
"「미사사기 씨가 노려지는 거라고",
"멋대로 믿어 버려서...」"
],
"8121": [
"『정말 노려진 건,",
"쿠라이시 씨였군요...』"
],
"8122": [
"「...그랬던 것 같아요」"
],
"8123": [
"『쿠라이시 씨... 안됐어요...』"
],
"8124": [
"『아, 그래도 이치야나기 씨",
"탓이 아니에요』"
],
"8125": [
"『당신은 원래 상관없는 입장",
"인데도, 어떻게든 해 보려고",
"애써 주셨잖아요』"
],
"8126": [
"「...그래도, 틀렸고요.",
"도움이 못 돼서 죄송해요」"
],
"8127": [
"『신경 쓰지 마세요.",
"당신 탓이 아니에요』"
],
"8128": [
"「...감사합니다」"
],
"8129": [
"『그래도, 이제 너무 무리하진",
"마세요』"
],
"8130": [
"『범인이 무슨 생각인지",
"모르니까요,",
"이제 위험한 일은 하지 마세요』"
],
"8131": [
"「...네...",
"죄송했습니다...」"
],
"8132": [
"『아니에요, 그럼...』"
],
"8133": [
"『네, 여보세요?』"
],
"8134": [
"「아, 나스 씨.",
"죄송해요, 나고무인데요...」"
],
"8135": [
"『아, 나고무 군이구나...",
"무슨 일이야?』"
],
"8136": [
"「저기, 실은 좀 여쭤",
"보고 싶은 게 있어서...」"
],
"8137": [
"『뭔데?』"
],
"8138": [
"「나스 씨가...",
"마지막으로 쿠라이시 씨를 본 건",
"언제예요?」"
],
"8139": [
"『내가...?",
"음, 글쎄...』"
],
"8140": [
"『아마, 다른 사람들이랑 같지 않을까.",
"쿠라이시 씨가 방에 틀어박힌다고",
"한 그날 만난 게...』"
],
"8141": [
"『분명 그랬을 거야.",
"별로 도움이 못 돼서 미안해』"
],
"8142": [
"「아뇨, 괜찮아요.",
"피곤하실 텐데 죄송해요」"
],
"8143": [
"『아니, 괜찮아.",
"걱정 끼쳐서 미안했어』"
],
"8144": [
"「아니에요, 푹 쉬세요」"
],
"8145": [
"『응, 고마워.",
"그럼 이만』"
],
"8146": [
"『여보세요?』"
],
"8147": [
"기다리고 있었는지, 츠바키 군은",
"바로 전화를 받아 주었다."
],
"8148": [
"『나고무냐? 히오리는 어쩌고?』"
],
"8149": [
"「괜찮아, 같이 있어.",
"히오리는... 괜찮은데...」"
],
"8150": [
"『...아저씨 말이냐』"
],
"8151": [
"「응...",
"역시, 돌아가셨어...」"
],
"8152": [
"『쳇...!",
"뭐야, 남들보다 배로",
"경계하던 주제에...』"
],
"8153": [
"『...아저씨 까딱하면",
"언제 죽었는지도 모르는 거",
"아냐?』"
],
"8154": [
"「응...",
"확실히는 모를 거야」"
],
"8155": [
"「츠바키 군은, 쿠라이시 씨가 방에",
"틀어박힌다고 한 뒤로 못 만났어?」"
],
"8156": [
"『...못 만났지.",
"그게 마지막이 돼 버렸네...』"
],
"8157": [
"『...미안하다.",
"도움이 못 돼서』"
],
"8158": [
"「아니, 나도...",
"쿠라이시 씨 돌아가신 거",
"아까까지 몰랐는걸」"
],
"8159": [
"『어쩔 수 없지.",
"너 혼자 탓이 아니야』"
],
"8160": [
"『너무, 풀 죽지 마.",
"히오리한테도 전해 둬』"
],
"8161": [
"『그럼 끊는다』"
],
"8162": [
"다음엔 누구한테 걸까...?"
],
"8163": [
"「저기, 츠바키 군」"
],
"8164": [
"「뭔데?」"
],
"8165": [
"「나스 씨, 저기...」"
],
"8166": [
"「뭔데?」"
],
"8167": [
"「스즈나 짱, 있잖아」"
],
"8168": [
"「저기, 시즈나 짱」"
],
"8169": [
"「...」"
],
"8170": [
"「저, 미사사기 씨」"
],
"8171": [
"「무슨 일이세요?」"
],
"8172": [
"「히오리, 있잖아」"
],
"8173": [
"「어젯밤엔 방에 돌아가서",
"바로 잤어?」"
],
"8174": [
"「...바로 잘 생각",
"이었는데 말이지」"
],
"8175": [
"「무슨 일 있었어?」"
],
"8176": [
"「화장실 가려는데,",
"계단 홀 난간에 사람 그림자 같은 게",
"보여서 깜짝 놀랐지」"
],
"8177": [
"「자세히 보니 저거였어」"
],
"8178": [
"그렇게 말하며, 테라스에",
"매달린",
"테루테루 인형을 엄지로 가리킨다."
],
"8179": [
"「어차피, 그 바보 짓이겠거니",
"해서 기분 나쁘니까 딴 데",
"매달라고 방까지 말하러 갔어」"
],
"8180": [
"「그랬구나...",
"그게 한밤중이야?」"
],
"8181": [
"「아니, 방에 돌아와서 아직",
"그렇게는...」"
],
"8182": [
"「아, 맞다.",
"방에서 나올 때, 시계 봤어.",
"11시 20분이었지」"
],
"8183": [
"「밤에 만나서 얘기한 사람은",
"나스 씨뿐이었어?」"
],
"8184": [
"「음, 그럴걸?",
"다른 녀석 본 기억은 없어」"
],
"8185": [
"「그럼 나스 씨 방에",
"있었던 건 얼마나?」"
],
"8186": [
"「안까진 안 들어갔어.",
"문 앞에서 한두 마디 하고",
"바로 내 방에 돌아왔고」"
],
"8187": [
"「그렇구나.",
"애초에 뭐 하러 방에서",
"나왔었더라」"
],
"8188": [
"「화장실이라니까.",
"일단 갔다가 방에 돌아가기",
"전에 근육한테 간 거야」"
],
"8189": [
"...완전히 이름 아닌 걸로",
"불리고 있네..."
],
"8190": [
"「어젯밤엔 바로",
"주무셨어요?」"
],
"8191": [
"「설마!",
"자기 전에 늘 하던 대로",
"팔굽혀펴기랑 복근이랑 배근이랑...」"
],
"8192": [
"「그리고, 테루테루 인형 만들었지.",
"봐, 저기 있는 거」"
],
"8193": [
"그렇게 말하며 나스 씨는, 테라스",
"처마에 매달린 수건으로 만든",
"테루테루 인형을 가리켰다."
],
"8194": [
"「처음엔, 2층 계단 홀 난간에",
"매달아 뒀었는데」"
],
"8195": [
"「츠바키 군이, 사람 그림자처럼 보여서",
"기분 나쁘니까 치우라고 화내서 말이야」"
],
"8196": [
"「...그렇겠죠」"
],
"8197": [
"어두운 복도에서 저런 게 어렴풋이",
"보이면, 나라면 비명 지른다."
],
"8198": [
"「저, 그게 몇 시쯤이에요?",
"테루테루 인형 매단 게」"
],
"8199": [
"「처음에 매단 거?",
"11시 넘어서였을 거야」"
],
"8200": [
"「그때 방에서 누가",
"나오거나 한 일은",
"없었어요?」"
],
"8201": [
"「응, 아무도...」"
],
"8202": [
"「아, 그런데 그러고 보니",
"만난 건 아니지만",
"아래에 누가 있는 걸 봤어」"
],
"8203": [
"「아래라면 계단 홀?",
"1층 로비 말이에요?」"
],
"8204": [
"「왠지, 부엌 쪽으로",
"가는 게 슬쩍 보였는데」"
],
"8205": [
"「체형으로 봐서,",
"마다라이 씨였던 것 같아」"
],
"8206": [
"「...그런 체형인 사람은",
"마다라이 씨뿐이니까요」"
],
"8207": [
"「그게...",
"11시 넘어서였어요?」"
],
"8208": [
"「응, 맞아.",
"11시... 15분인가",
"그쯤 아닐까」"
],
"8209": [
"그렇다는 건, 마다라이 씨가 돌아가신 건",
"그보다 나중이구나..."
],
"8210": [
"「테루테루 인형은",
"츠바키 군한테 혼나고 바로",
"다시 매단 거예요?」"
],
"8211": [
"「응, 그래.",
"아침까지 어떻게 해 두라고",
"했으니까」"
],
"8212": [
"「그렇겠죠...",
"다시 매달러 간 게",
"몇 시쯤이었는지 기억나요?」"
],
"8213": [
"「음, 스쿼트 첫 세트가",
"끝난 참이었으니까, 11시 반",
"쯤이 아닐까」"
],
"8214": [
"뭔가 엄청난 기준으로",
"시간을 재고 있네..."
],
"8215": [
"「어젯밤엔, 바로 주무셨어요?」"
],
"8216": [
"「아니, 라이터가 다 떨어져서,",
"불씨를 찾으러 내려왔지.",
"11시 조금 넘었을 때였나」"
],
"8217": [
"「처음엔 오락실에 가려다가",
"거실에서 성냥 본 게",
"생각나서 찾아서 한 대 피웠지」"
],
"8218": [
"「여기서요?」"
],
"8219": [
"「방 안에서 피우면",
"집사가 시끄러우니까",
"저기 테라스에서」"
],
"8220": [
"「성냥도 어느새 치워",
"놔서 찾느라 고생했다」"
],
"8221": [
"「그때, 다른 누가 오거나",
"하진 않았어요?」"
],
"8222": [
"「...아니,",
"아무도 안 왔는데...」"
],
"8223": [
"「? 저기...?」"
],
"8224": [
"「아니, 아무것도 아냐.",
"아무도 안 왔어」"
],
"8225": [
"「하아...」"
],
"8226": [
"「쿠라이시 씨가 테라스에",
"계셨던 건 얼마나였어요?」"
],
"8227": [
"「찾느라 애먹고,",
"그 뒤로 두세 개비 피웠으니까...」"
],
"8228": [
"「뭐, 20분 넘게는",
"있었을 거다」"
],
"8229": [
"「20분 넘게요」"
],
"8230": [
"「30분까진 아닐",
"거다만, 뭐 그 정도야」"
],
"8231": [
"「미사사기 씨가, 부엌에 갈 때",
"쿠라이시 씨가 거실 쪽으로 가는 걸",
"봤다고 하던데요」"
],
"8232": [
"「쿠라이시 씨는, 미사사기 씨를",
"못 보셨어요?」"
],
"8233": [
"「허어...?",
"난 못 봤는데」"
],
"8234": [
"「그렇군요」"
],
"8235": [
"「어젯밤엔, 바로 잤어?」"
],
"8236": [
"「아니, 언니 방에서",
"한동안 수다 떨었어」"
],
"8237": [
"「계속 시즈나 짱",
"방에 있었구나?」"
],
"8238": [
"「응, 맞아... 아, 아니다.",
"한 번 화장실 갔어」"
],
"8239": [
"「그래서 돌아올 때, 방 앞에서",
"미사사기 씨 만나서 인사하고",
"난 바로 방에 들어갔어」"
],
"8240": [
"「미사사기 씨라...",
"미사사기 씨는 막 나오던 참이었어?」"
],
"8241": [
"「응, 나오던 참인 것 같았어.",
"그대로 복도 걸어갔고.",
"어디 갔는지는 모르지만」"
],
"8242": [
"「그렇구나.",
"그게 몇 시쯤이었어?」"
],
"8243": [
"「11시 조금 넘어서려나.",
"아마, 5분쯤」"
],
"8244": [
"「시즈나 짱 방에서",
"돌아온 건 언제쯤이야?」"
],
"8245": [
"「11시 반쯤이었나.",
"언니가 화장실 간다길래",
"그럼 나도 이제 갈게 하고」"
],
"8246": [
"「같이 나와서, 난 바로",
"그대로 방에 돌아가서 잤어」"
],
"8247": [
"「방에 있을 때, 밖에서",
"누가 얘기하는 소리 같은 거 들렸어?」"
],
"8248": [
"「음,",
"딱히 안 들렸던 것 같은데.",
"내 방, 안쪽이기도 하고」"
],
"8249": [
"「어젯밤, 바로 잤어?」"
],
"8250": [
"「깨어 있었어?」"
],
"8251": [
"「스즈랑 수다 떨었어.",
"같이 방에 돌아와서,",
"11시 반쯤까지」"
],
"8252": [
"「그러고, 화장실 가려고",
"방 나왔더니 무슨 소리가 나길래",
"보러 갔더니 나스 씨였어」"
],
"8253": [
"「계단 홀에 매단",
"테루테루 인형 풀고 있었어.",
"거긴 안 된다고 혼났대」"
],
"8254": [
"「그, 그래...」"
],
"8255": [
"보통은 한밤중 복도에서 마주칠",
"광경이 아니잖아, 그거..."
],
"8256": [
"「그래서, 스즈나 짱은",
"그때 방에 돌아간 거야?」"
],
"8257": [
"「...그 전에 한 번",
"화장실 갔는데, 그땐",
"5분쯤 있다 돌아왔어」"
],
"8258": [
"「나스 씨, 테루테루 인형",
"어디로 가져간다든가",
"말했어?」"
],
"8259": [
"「어디가 좋을까 하길래",
"보통은 창밖에 매다는 거",
"아니냐고 했어」"
],
"8260": [
"「흐응, 그렇게 한대?」"
],
"8261": [
