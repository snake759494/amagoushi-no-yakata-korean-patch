{
"6144": [
"나는 수화기를 들어",
"다른 사람들에게 내선을 걸었다."
],
"6145": [
"「...미안하게 됐수.",
"귀찮은 일을 떠넘겨서」"
],
"6146": [
"「아, 아니야.",
"겸사겸사 어젯밤 일도",
"조금 물어봤고...」"
],
"6147": [
"「의외로 강하시네, 나고 씨는」"
],
"6148": [
"「물어볼 건 잊지 않고",
"제대로 물어봤잖수」"
],
"6149": [
"「아직 범인한테 백기 들",
"생각은 없다는 거 아니겠수」"
],
"6150": [
"「아닌가요?」"
],
"6151": [
"「아니... 그냥...",
"늘 묻다 보니 습관이 돼서」"
],
"6152": [
"「당신은 참 대단한 건지",
"안 대단한 건지",
"알 수가 없는 사람이네...」"
],
"6153": [
"「...자주 듣는 말이야」"
],
"6154": [
"「어떤 의미론 재능일지도요」"
],
"6155": [
"「날카로운 거나 도움 되는 걸",
"무의식중에 하잖수?」"
],
"6156": [
"「나고 씨, 본인만 모를 뿐",
"사실은 대단한 재능이 있는",
"거 아니우」"
],
"6157": [
"「...설마」"
],
"6158": [
"「그렇게 2초 만에 부정 안 해도」"
],
"6159": [
"「그런 재능 있었으면",
"좀 덜 고생하면서",
"살고 있겠지」"
],
"6160": [
"「그럴까요?」"
],
"6161": [
"「...상당 부분 성격이",
"방해하는 것 같은데」"
],
"6162": [
"「응? 뭐라고 했어?」"
],
"6163": [
"「아뇨아뇨, 아무것도」"
],
"6164": [
"「...그래서",
"그 표는 어떡할까요?」"
],
"6165": [
"「아, 그건...",
"쿠라이시 씨가 언제 죽었는지",
"전혀 모르겠으니까」"
],
"6166": [
"「누가 본 사람도",
"없는 겁니까?」"
],
"6167": [
"「아마 마지막으로 본 사람은",
"미사사기 씨일걸」"
],
"6168": [
"「음...",
"첫날부터 세어서 5일째 아침」"
],
"6169": [
"「...5일째...",
"아침이면 몇 시쯤요?」"
],
"6170": [
"「6시 반쯤이라고 했어」"
],
"6171": [
"「6시 반이라...",
"난 아직 방에 있었으려나」"
],
"6172": [
"「벌써 일어나 있었어?」"
],
"6173": [
"「일어나 있었죠.",
"7시 전에 방 나와서 화장실 들러",
"부엌으로 내려갔으니까...」"
],
"6174": [
"「아, 그러고 보니 그 뒤에",
"거실에서 미사사기 씨 만났수」"
],
"6175": [
"「7시 반 넘어서였나.",
"밥 만들어 거실에서 먹으려는데",
"미사사기 씨가 있어서...」"
],
"6176": [
"「딱히 뭘 하는 것도 없이",
"멍하니 있는 느낌이었는데」"
],
"6177": [
"「그 부분은 다들한테",
"물어볼 수밖에 없나」"
],
"6178": [
"「그럼 그걸",
"물어본 다음이네요」"
],
"6179": [
"「그렇지.",
"여긴 누가 올지도",
"모르니까...」"
],
"6180": [
"「그렇네요.",
"그럼 무슨 일 있으면",
"나중에 서재에서라도」"
],
"6181": [
"「아, 여기 있었네」"
],
"6182": [
"문이 열리고",
"쌍둥이가 얼굴을 내밀었다."
],
"6183": [
"「어라, 아가씨들」"
],
"6184": [
"「배고파」"
],
"6185": [
"「아, 그러고 보니 벌써",
"그럴 시간이네요」"
],
"6186": [
"「오빠들은",
"아직 안 만들었나?」"
],
"6187": [
"「예, 아직인데요.",
"먼저 하시죠」"
],
"6188": [
"「그래?",
"그럼 가자, 언니」"
],
"6189": [
"고개를 끄덕이고 시즈나는",
"앞장서 거실을 나갔다."
],
"6190": [
"「그럼, 먼저 갈게」"
],
"6191": [
"「...다른 사람들은",
"역시 안 내려오네」"
],
"6192": [
"「뭐, 이렇게 돼 버리면요.",
"방 나오는 것도 용기 필요하죠」"
],
"6193": [
"「...저녁밥,",
"뭐라면 먹을 수 있겠수?」"
],
"6194": [
"「음...」"
],
"6195": [
"「식욕 같은 건 별로",
"없으시겠지만요」"
],
"6196": [
"「안 먹으면",
"정말로 지쳐 버립니다요」"
],
"6197": [
"「우동 정도면 어떻수?」"
],
"6198": [
"「아, 그 정도라면...」"
],
"6199": [
"「그럼 그렇게 합시다.",
"진공 포장된 게 있었을 거유」"
],
"6200": [
"조금 더 시간을 때운 뒤",
"우리는 일어나 거실을 나섰다."
],
"6201": [
"「...라디오, 라디오」"
],
"6202": [
"스위치를 켜고",
"뉴스가 시작되길 기다린다."
],
"6203": [
"그렇다고 반가운 소식까지",
"들려오느냐 하면",
"전혀 그렇지 않았다."
],
"6204": [
"한숨을 쉬고 있는데",
"뒤에서 문이 열렸다."
],
"6205": [
"돌아보니 내 얼굴을 본 모두가",
"전염된 듯 한숨을 쉬었다."
],
"6206": [
"「아...",
"얼굴빛만 봐도 벌써",
"좋은 뉴스 없다는 느낌」"
],
"6207": [
"「안 되는 거야?」"
],
"6208": [
"「이 날씨에 무너진 길도",
"아직 복구 안 됐나 봐」"
],
"6209": [
"「이게 다야?」"
],
"6210": [
"「우리밖에 없어?」"
],
"6211": [
"열릴 기미가 없는 문을 보고",
"스즈나가 고개를 끄덕였다."
],
"6212": [
"「...그런갑네」"
],
"6213": [
"죽은 사람은 물론이고",
"산 사람까지 방에서",
"잘 나오지 않게 되었다."
],
"6214": [
"경계하기도 하고,",
"얼굴을 볼 때마다 서로 떠보는",
"분위기가 되기도 하고..."
],
"6215": [
"（방에 틀어박혀 있는 게",
"마음은 편할지도",
"모르겠지만...）"
],
"6216": [
"「오빠들은 안 무섭나?」"
],
"6217": [
"「그렇게 역설 안 해도」"
],
"6218": [
"나도 쌍둥이가 범인이 아니라고",
"단언할 만한 확신은 아직",
"아무것도 없으니까..."
],
"6219": [
"그건 왠지 거북한",
"기분이 들었다."
],
"6220": [
"소파에서 일어나",
"부엌으로 향한다."
],
"6221": [
"라디오 스위치를 켜고",
"뉴스를 기다린다."
],
"6222": [
"（산사태 후속 보도",
"빨리 좀 해 주면 좋겠다...）"
],
"6223": [
"잠시 기다리자 금방",
"여전히 복구 작업에 진전이",
"없다는 보도가 나왔다."
],
"6224": [
"「...안 되는 건가」"
],
"6225": [
"이어서 일기 예보도 당분간",
"궂은 날씨가 계속된다고 전한다.",
"보기 좋게 나쁜 뉴스뿐이다."
],
"6226": [
"「어떻습니까, 나고 씨?」"
],
"6227": [
"「그대로야.",
"아직 걸릴 것 같대」"
],
"6228": [
"「하아, 그거 우울해지네요」"
],
"6229": [
"긴 한숨을 내쉬며",
"소파에 털썩 앉는다."
],
"6230": [
"「...안 오네요」"
],
"6231": [
"「응?",
"아, 다른 사람들?」"
],
"6232": [
"「뭐, 시간 엄수라고 정해진",
"것도 아니지만요」"
],
"6233": [
"「어쩔까요?",
"먼저 밥 먹을까요」"
],
"6234": [
"「음...",
"아직 별로 배 안 고파」"
],
"6235": [
"「그럼 지금 먼저",
"목욕해 버릴까요?」"
],
"6236": [
"「...그렇구나,",
"그게 낫겠다」"
],
"6237": [
"「그럼 먼저 하시죠.",
"난 보일러 켜고 오겠수」"
],
"6238": [
"「고마워.",
"그럼 갈아입을 옷 가져올게」"
],
"6239": [
"호의를 받아들여 옷과 수건을",
"가지러 방으로 돌아갔다."
],
"6240": [
"（...시즈나 짱네는",
"저녁 어떻게 하려나）"
],
"6241": [
"먹을 걸 가져가진 않았을",
"테니, 이대로 방에서",
"안 나오진 않겠지만."
],
"6242": [
"（잠깐 말이라도",
"걸어 볼까...）"
],
"6243": [
"계단을 지나 쌍둥이와 미사사기",
"씨가 묵는 방 쪽으로 향한다."
],
"6244": [
"방금 문소리는..."
],
"6245": [
"모퉁이에서 슬쩍 내다보니",
"쿠라이시 씨 방문이 살짝 열려 있었다."
],
"6246": [
"（웬일이지...",
"방에서 나왔나?）"
],
"6247": [
"하지만 제대로 안 닫다니",
"쿠라이시 씨답지 않은데.",
"무슨 일일까..."
],
"6248": [
"「...쿠라이시 씨?」"
],
"6249": [
"부르면서 방에 다가갔다.",
"대답은 없고 방에 불도",
"켜져 있지 않은 것 같았다."
],
"6250": [
"「...?",
"쿠라이시 씨, 실례합니다...」"
],
"6251": [
"...캄캄하다.",
"이상하네, 방에 들어간 게",
"아니라 나간 건가."
],
"6252": [
"하지만 그렇다면 나와",
"마주쳤을 텐데..."
],
"6253": [
"「쿠라이시 씨...」"
],
"6254": [
"한 걸음 더.",
"방 안으로 발을 들인 순간..."
],
"6255": [
"「읏...!?」"
],
"6256": [
"등 아래쪽에 타는 듯한",
"통증을 느끼고 숨이 막혔다."
],
"6257": [
"「어... 뭐, 야...」"
],
"6258": [
"돌아보려 해도",
"이미 허리에 힘이 안 들어간다..."
],
"6259": [
"（누... 누구...?）"
],
"6260": [
"누군가 있다.",
"등 뒤에 누군가가..."
],
"6261": [
"하지만 그게 대체 누구인지",
"모르는 채로..."
],
"6262": [
"내 의식은 녹아내리듯",
"사라져 갔다..."
],
"6263": [
"「......하암」"
],
"6264": [
"창밖은 어슴푸레",
"밝아 오고 있었다."
],
"6265": [
"역시 졸음이 몰려와",
"하품을 몇 번이고 참는다."
],
"6266": [
"「나고 씨, 힘들면",
"이제 자도 됩니다요」"
],
"6267": [
"「어차피 날도 밝았고",
"아가씨들도 슬슬",
"일어날 거유」"
],
"6268": [
"「음... 괜찮아.",
"무사히 나올 때까지 깨어 있을래」"
],
"6269": [
"「그럼 나오면 깨울 테니",
"여기서 주무실래요?」"
],
"6270": [
"「괜찮아...」"
],
"6271": [
"「꾸벅꾸벅 졸고 있잖수」"
],
"6272": [
"「음.....」"
],
"6273": [
"「뭐꼬, 잠들었나?」"
],
"6274": [
"「......스즈나 짱」"
],
"6275": [
"「아, 깨 있었네.",
"좋은 아침, 나고 짱」"
],
"6276": [
"깜빡 잠들 뻔한 나를",
"잠옷 차림의 스즈나 짱이",
"들여다보고 있었다."
],
"6277": [
"평소엔 안 보이던 장난스러운",
"웃음 때문인지..."
],
"6278": [
"「...스즈나 짱은...",
"역시 남자애구나...」"
],
"6279": [
"「인자 와서 뭔 소리고, 이 사람은」"
],
"6280": [
"「아니, 그냥...」"
],
"6281": [
"「이상한 사람이네.",
"아무리 내가 미소년이라도",
"그렇게 넋 놓고 보지 마」"
],
"6282": [
"「아니, 저기」"
],
"6283": [
"「후훗, 농담이라니까」"
],
"6284": [
"「고마워,",
"아침까지 애써 줘서」"
],
"6285": [
"「...아니, 괜찮아.",
"무사했으면 됐어...」"
],
"6286": [
"「덕분에」"
],
"6287": [
"「...다행이다...」"
],
"6288": [
"「응, 시계 울렸을 땐 진짜",
"우짜나 싶었는데...」"
],
"6289": [
"「그래도 아무 일 없었으니",
"이제 우리가 이긴 기다」"
],
"6290": [
"「....응.",
"시즈나 짱도 히오리도 같이",
"지켜 줬으니까...」"
],
"6291": [
"「애초에 나고 씨가",
"눈치챘으니까 그런 거잖수」"
],
"6292": [
"「위험해 보이는 건 전부",
"치워 놨으니 범인도 어쩔 수",
"없었던 거 아니겠수」"
],
"6293": [
"「그렇제.",
"살았다」"
],
"6294": [
"「아니, 뭘...」"
],
"6295": [
"「고마워.",
"무사히 여기 나가면",
"뭔가 답례하게 해 줘」"
],
"6296": [
"방 안에서",
"시즈나 짱 목소리가 들렸다."
],
"6297": [
"「...잠깐, 언니!",
"그런 꼴로 나오지 마라~!」"
],
"6298": [
"그 순간 놀란 스즈나 짱이",
"허둥지둥 방으로 뛰어든다."
],
"6299": [
"「...어떤 차림이었을까」"
],
"6300": [
"「꽃다운 아가씨가 하면",
"안 되는 차림이었겠지요」"
],
"6301": [
"「...좋은 아침」"
],
"6302": [
"「아, 좋은 아침」"
],
"6303": [
"갈아입었는지, 나온 시즈나 짱은",
"평범한 차림이었다."
],
"6304": [
"「어, 아니」"
],
"6305": [
"「그, 그렇네」"
],
"6306": [
"「이제 자도 괜찮습니다요.",
"날이 밝았으니까」"
],
"6307": [
"「진짜, 언니는...",
"자자, 침대로 가」"
],
"6308": [
"「응」"
],
"6309": [
"고개를 까딱 끄덕이고 시즈나",
"짱은 방으로 돌아갔다."
],
"6310": [
"「하아...",
"나도 방 가서 잘란다」"
],
"6311": [
"「그러세요.",
"우리도 물러갈 테니」"
],
"6312": [
"「응, 그럼 이만.",
"잘 자~」"
],
"6313": [
"「잘 자, 스즈나 짱」"
],
"6314": [
"「음... 아, 맞다.",
"진짜 뭔가 답례할 테니까",
"나중에 주소 좀 알려 줄래?」"
],
"6315": [
"「어, 괜찮아 그런 거...",
"신경 안 써도 돼」"
],
"6316": [
"「됐다 마, 알려 줘」"
],
"6317": [
"「아, 응.",
"그건 괜찮은데」"
],
"6318": [
"「아마 언니가 신나서",
"티켓 같은 거 보낼 기다」"
],
"6319": [
"「티켓?」"
],
"6320": [
"「티켓 말이죠.",
"연극 티켓입니까?」"
],
"6321": [
"「응, 맞아.",
"히오리 씨도 같이 와 줘」"
],
"6322": [
"「예, 기꺼이」"
],
"6323": [
"「고마워, 스즈나 짱」"
],
"6324": [
"「뭔 소리고.",
"생명의 은인이잖아」"
],
"6325": [
"「그럼, 이따 봐~」"
],
"6326": [
"「네네, 이따 봐요」"
],
"6327": [
"「잘 자~」"
],
"6328": [
"스즈나 짱은 자기 방으로",
"돌아갔다."
],
"6329": [
"「...다행이다」"
],
"6330": [
"「그렇네요」"
],
"6331": [
"「나 말이야...",
"어젯밤 몇 번이나, 아침이 돼도",
"방에서 안 나오면 어쩌지 하고」"
],
"6332": [
"「그런 생각만 하면서",
"엄청 무서웠거든...」"
],
"6333": [
"「제대로 나왔잖수」"
],
"6334": [
"「이제 안 무섭지요」"
],
"6335": [
"「그럼 푹 쉬세요.",
"당신, 정말 애썼으니까」"
],
"6336": [
"「...응.",
"히오리도」"
],
"6337": [
"「쉬겠습니다요.",
"그럼 방으로 돌아갈까요」"
],
"6338": [
"「...날이 밝았네」"
],
"6339": [
"창밖은 옅고 밝은 빛으로",
"바뀌어 가고 있었다."
],
"6340": [
"「비는 오지만」"
],
"6341": [
"「그래도 해는 떠오르고",
"있잖수」"
],
"6342": [
"살며시 문이 열리고",
"시즈나 짱이 얼굴을 내밀었다."
],
"6343": [
"평소보다 더 졸려 보였다."
],
"6344": [
"「.......아침」"
],
"6345": [
"「응, 그렇네.",
"좋은 아침」"
],
"6346": [
"「......졸려」"
],
"6347": [
"「하핫, 그야 그렇겠죠.",
"이제 괜찮습니다, 쉬어도」"
],
"6348": [
"「.....괜찮아?」"
],
"6349": [
"「응, 이제 아침이니까.",
"다행이다, 무사해서...」"
],
"6350": [
"「......덕분」"
],
"6351": [
"「예, 나고 씨가 위험하다고",
"눈치챈 덕분이지요」"
],
"6352": [
"「어」"
],
"6353": [
"스윽 다가온 시즈나 짱이",
"내 손을 두 손으로 들어 올렸다."
],
"6354": [
"「저, 저기?」"
],
"6355": [
"조물조물, 악수하듯",
"쥐고서 위아래로 흔든다."
],
"6356": [
"「감사」"
],
"6357": [
"「그, 그래...",
"어, 고마워」"
],
"6358": [
"「당신이 인사하면 어쩝니까」"
],
"6359": [
"「응, 반대」"
],
"6360": [
"「언니가 알아듣기 어렵게",
"말하니까 그렇지...」"
],
"6361": [
"방에서 얼굴을 내민 스즈나 짱이",
"어이없다는 듯 웃고 있었다."
],
"6362": [
"「고마워, 두 사람 다」"
],
"6363": [
"「...고마워」"
],
"6364": [
"「아, 아니야.",
"무사해서 다행이야...」"
],
"6365": [
"「살았어...」"
],
"6366": [
"시즈나 짱은 살며시 웃었다."
],
"6367": [
"「그러니까, 티켓 줄게」"
],
"6368": [
"「티켓?」"
],
"6369": [
"「연극」"
],
"6370": [
"「시즈나 짱이 나와?」"
],
"6371": [
"「아, 그 뮤지컬 말입니까?」"
],
"6372": [
"「맞아 맞아.",
"와 줘, 두 사람 다」"
],
"6373": [
"「그야 기꺼이.",
"그렇죠, 나고 씨」"
],
"6374": [
"「응, 갈게.",
"고마워」"
],
"6375": [
"「그럼 이제 쉬어.",
"피곤하제?」"
],
"6376": [
"「그렇네요,",
"그럼 돌아갈까요」"
],
"6377": [
"「우리도 좀 잘게.",
"그럼, 잘 자」"
],
"6378": [
"「예. 안녕히 주무세요」"
],
"6379": [
"쌍둥이는 각자의 방으로",
"돌아갔다."
],
"6380": [
"꾸벅 졸 뻔해서",
"황급히 고개를 든다."
],
"6381": [
"「...이제 괜찮습니다요」"
],
"6382": [
"「자 버려도요.",
"봐요, 이제 밝잖수」"
],
"6383": [
"「....아...」"
],
"6384": [
"「정말이다, 아침이야...」"
],
"6385": [
"창밖에는 완전히 눈에 익은",
"어둑한 아침이 찾아와 있었다."
],
"6386": [
"추적추적 계속 내리는 비는",
"여전히 유리창에 가느다란",
"곡선을 그리고 있지만..."
],
"6387": [
"「...다행이다...」"
],
"6388": [
"「아, 분명 스즈나 짱이다.",
"좋은 아침, 스즈나 짱?」"
],
"6389": [
"「좋은 아침~.",
"이제 아침인데 나가도 되나?」"
],
"6390": [
"「괜찮...겠지?」"
],
"6391": [
"「예, 이제 괜찮겠지요」"
],
"6392": [
"「응, 괜찮아.",
"나와도 돼」"
],
"6393": [
"조용히 문이 열리고 잠옷 차림의",
"스즈나 짱이 쏙 얼굴을 내민다."
],
"6394": [
"「좋은 아침, 스즈나 짱.",
"시즈나 짱은?」"
],
"6395": [
"「언니, 아까 잠들었다」"
],
"6396": [
"「아, 그렇구나.",
"다행이다, 무사해서...」"
],
"6397": [
"「진짜로?」"
],
"6398": [
"「다행이라고 생각해?」"
],
"6399": [
"「당연하지.",
"왜?」"
],
"6400": [
"스즈나 짱은 왠지 말없이 웃더니",
"내 앞에 쪼그려 앉았다."
],
"6401": [
"「왜, 왜?」"
],
"6402": [
"「.......후후」"
],
"6403": [
"그 자세 그대로",
"장난꾸러기 같은 웃음을 띠고",
"빤히 내 눈을 본다."
],
"6404": [
"「.....어」"
],
"6405": [
"「혹시.....」"
],
"6406": [
"「이런...」"
],
"6407": [
"「...시즈나 짱?」"
],
"6408": [
"눈이 휘둥그레진 우리를 보고",
"시즈나 짱은 즐겁게 까르르 웃는다."
],
"6409": [
"「속았지~」"
],
"6410": [
"「으, 응...",
"완전히 스즈나 짱인 줄 알았어」"
],
"6411": [
"「역시 쌍둥이네요.",
"아니, 배우라고 해야 하나」"
],
"6412": [
"「진짜, 언니는...」"
],
"6413": [
"어이없다는 목소리로 말하며",
"방에서 진짜 스즈나 짱이 나온다."
],
"6414": [
"「속았어」"
],
"6415": [
"「그래 잘됐네.",
"자, 이제 좀 자라니까」"
],
"6416": [
"「오빠들도.",
"고마워, 아침까지」"
],
"6417": [
"「아니, 뭘...",
"무사해서 다행이야」"
],
"6418": [
"「무엇보다 다행이네요.",
"그럼 우리도 물러갈까요」"
],
"6419": [
"「그래.",
"그럼, 잘 자...」"
],
"6420": [
"「나고땅, 나고땅」"
],
"6421": [
"「나, 나?」"
],
"6422": [
"「뭐꼬,",
"그 머리 나빠 보이는 호칭은」"
],
"6423": [
"「괜찮아.",
"나중에, 주소」"
],
"6424": [
"「주소?」"
],
"6425": [
"「답례.",
"티켓 줄게」"
],
"6426": [
"「아, 다음 달 거?",
"그래, 히오리 씨도 같이 와」"
],
"6427": [
"「다음 달 거라면 그 뮤지컬",
"말이우?」"
],
"6428": [
"「그야 물론 기꺼이」"
],
"6429": [
"「그거,",
"시즈나 짱이 나오는 거야?」"
],
"6430": [
"「나와.",
"노래해」"
],
"6431": [
"「고마워, 꼭 갈게」"
],
"6432": [
"「꼭?」"
],
"6433": [
"「응, 약속할게」"
],
"6434": [
"「그럼....잘래」"
],
"6435": [
"「잘 자, 푹 쉬어」"
],
"6436": [
"「오빠들도.",
"고마워, 진짜로」"
],
"6437": [
"「천만에요, 그럼」"
],
"6438": [
"「잘 자,",
"시즈나 짱, 스즈나 짱」"
],
"6439": [
"쌍둥이는 각자의 방으로",
"돌아갔다..."
],
"6440": [
"「자, 우리도 좀 쉴까요」"
],
"6441": [
"「다행이다, 다들 무사해서...」"
],
"6442": [
"「...앞으로 하루 남았네」"
],
"6443": [
"「예, 오늘만 버티면",
"사무소도 우리가 큰일 난 걸",
"눈치챌 테고...」"
],
"6444": [
"「실제로 산사태 뉴스는 이미",
"나왔으니, 뭔가 손을",
"쓰고 있을지도 모르고요」"
],
"6445": [
"「그렇겠지, 분명.",
"이제 곧 돌아갈 수 있어...」"
],
"6446": [
"「...살아남읍시다」"
],
"6447": [
"「응, 같이 돌아가자」"
],
"6448": [
"「그럼 지금은",
"푹 쉬어서 체력 회복하세요」"
],
"6449": [
"（....꽤 밝아진",
"것 같네...）"
],
"6450": [
"창밖을 보니 여전히 비로",
"흐리지만 날은 밝은 것 같다."
],
"6451": [
"문 안쪽에서 작게 노크 소리가 났다."
],
"6452": [
"「아, 아마 스즈나 짱일 거야.",
"스즈나 짱?」"
],
"6453": [
"역시 스즈나 짱이었는지",
"방 안에서 목소리가 들린다."
],
"6454": [
"「이제 아침이데이.",
"나가도 되나?」"
],
"6455": [
"「그렇네요, 이제 괜찮겠죠」"
],
"6456": [
"「응, 괜찮을 것 같아」"
],
"6457": [
"「하아, 드디어...」"
],
"6458": [
"「수고했데이~」"
],
"6459": [
"「천만에요, 그쪽이야말로」"
],
"6460": [
"「다행이다, 아무 일 없어서」"
],
"6461": [
"「응, 시계 울렸을 땐 진짜",
"심장 튀어나오는 줄 알았다」"
],
"6462": [
"「그래도 아무 일 없었다는",
"건 우리가 이긴 거제」"
],
"6463": [
"「...응, 분명」"
],
"6464": [
"「방 안팎에 두 명씩",
"있었으니 아무리 그래도",
"어쩔 수 없었던 거겠죠」"
],
"6465": [
"「그렇제.",
"고마워, 살았다」"
],
"6466": [
"스즈나 짱 뒤에서",
"시즈나 짱이 불쑥 얼굴을 내민다."
],
"6467": [
"「아니야, 천만에」"
],
"6468": [
"「나야말로, 이상한 말 했는데",
"믿어 줘서 고마워」"
],
"6469": [
"「뭔 소리 하노.",
"그 이상한 말 안 해 줬으면",
"나 살아 있지도 않았을 거 아이가?」"
],
"6470": [
"「진짜 고마워하고 있데이.",
"무사히 여기 나가면",
"뭔가 답례하게 해 줘」"
],
"6471": [
"「티켓 줄게」"
],
"6472": [
"「아, 다음 달 거?",
"좋네, 보러 와 두 사람 다」"
],
"6473": [
"「허어, 다음 달 거라면",
"그 뮤지컬 말입니까?」"
],
"6474": [
"「그야 기꺼이 가지요.",
"그렇죠, 나고 씨」"
],
"6475": [
"「약속」"
],
"6476": [
"「약속할게, 응」"
],
"6477": [
"옷 스치는 소리가 난 것 같아",
"눈을 뜬다."
],
"6478": [
"「아, 나고 씨.",
"일어나셨수」"
],
"6479": [
"「아, 히오리... 좋은 아침」"
],
"6480": [
"히오리가 일어나 기모노를 입고",
"있던 참이었다."
],
"6481": [
"「벌써 일어나게요?",
"난 아침 먹으러 갈 건데」"
],
"6482": [
"「...응, 일어날래」"
],
"6483": [
"하품하며 일어나",
"더듬더듬 안경을 찾아낸다."
],
"6484": [
"「...잖아」"
],
"6485": [
"「진짜, 언니는!",
"맨날 그런 것만...」"
],
"6486": [
"「아」"
],
"6487": [
"계단 쪽으로 가니 복도 안쪽으로",
"걸어가는 쌍둥이가 보였다.",
"손에 식사를 들고 있던 것 같다."
],
"6488": [
"「아가씨들,",
"벌써 일어났나 봅니다」"
],
"6489": [
"히오리가 토스트와 달걀로 아침을",
"만들어 줘서 둘이 먹는다."
],
"6490": [
"오늘은 이대로 아무 일",
"없으면 좋겠는데..."
],
"6491": [
"「...무슨 소리죠?」"
],
"6492": [
"「뭐, 뭔가 울렸지?」"
],
"6493": [
"「바깥 아닙니까?」"
],
"6494": [
"「응, 밖인 것 같아」"
],
"6495": [
"창가로 달려가 밖을 내다본다."
],
"6496": [
"여전히 비가 계속 내려서",
"시야가 나쁘다."
],
"6497": [
"「...아, 저거!」"
],
"6498": [
"「봐, 온실!",
"뭔가 빛이...!」"
],
"6499": [
"「...정말이네요.",
"손전등 불빛 같은데",
"누가 있는 건가」"
],
"6500": [
"「그야",
"저절로 흔들릴 리 없으니...」"
],
"6501": [
"「가 봅시다」"
],
"6502": [
"「어, 아, 히오리!?",
"기다려~!!」"
],
"6503": [
"「...아, 누구 있어요?」"
],
"6504": [
"온실 안에서는 예상대로 천장에",
"매달린 손전등이 흔들흔들",
"흔들리고 있었다."
],
"6505": [
"하지만 우리 말고는 누구의",
"모습도 보이지 않는다..."
],
"6506": [
"「엇!? 뭐, 뭐야?」"
],
"6507": [
"「뭔가 늘었는뎁쇼」"
],
"6508": [
"『복수』라는 붉은 글자 주변에 놓인",
"소품들 사이에 지금까지 없던",
"물건이 하나 늘어 있었다."
],
"6509": [
"작은 나무... 울타리...?",
"뭘까, 이건..."
],
"6510": [
"「저기~, 무슨 일이고?」"
],
"6511": [
"뒤에서 목소리가 나고 다가오는",
"발소리가 들린다."
],
"6512": [
"「...무슨 일 있어?」"
],
"6513": [
"「응, 저거...」"
],
"6514": [
"「탔어」"
],
"6515": [
"울타리를 가리켰던 나는",
"무슨 뜻인지 몰라 시즈나 짱의",
"시선 끝을 돌아본다."
],
"6516": [
"「...뭐야 이게.",
"뭔가 타고 남은 재 같은데」"
],
"6517": [
"살짝 그을린 바닥 위에",
"뭔가의 타다 남은 재가 흩어져 있다."
],
"6518": [
"「폭죽 같은 거 아이가?」"
],
"6519": [
"「아...",
"그러고 보니 그런 소리였어」"
],
"6520": [
"「소리?」"
],
"6521": [
"「못 들었어?",
"아까 뭔가 터지는 것 같은",
"소리가 났는데」"
],
"6522": [
"「그건 모르겠다.",
"우린 오빠들이 뛰어가는 게",
"창문으로 보여서 와 봤다」"
],
"6523": [
"「그렇구나...",
"근데 왜 이런 걸",
"터뜨린 걸까...」"
],
"6524": [
"「...아직 계속되니까, 일까」"
],
"6525": [
"「그치만, 울타리」"
],
"6526": [
"「뭐...",
"달리 이유는 생각하기 어렵네요」"
],
"6527": [
"「그렇겠제.",
"참 고약한 취미다, 진짜」"
],
"6528": [
"「가자, 언니.",
"아침밥 방에 둔 채로다」"
],
"6529": [
"그렇게 말하고 쌍둥이가 훌쩍 떠나자",
"남은 우리도 따라 온실을 나왔다."
],
"6530": [
"「...그럼",
"난 서재에 있을 테니까요」"
],
"6531": [
"방에 돌아와 비에 젖은 머리를 닦고",
"다시 묶더니 히오리는 나갔다."
],
"6532": [
"（나는 어떻게 할까...）"
],
"6533": [
"쌍둥이는 무사했지만.",
"온실의 그 모습을 보면 범인은",
"전혀 멈출 생각이 없나 보다..."
],
"6534": [
"「음....」"
],
"6535": [
"굳은 몸을 풀듯이",
"팔을 들어 기지개를 켠다."
],
"6536": [
"「역시 지치네요」"
],
"6537": [
"「좀 배고프다...」"
],
"6538": [
"「하하, 나도요.",
"부엌 들러서 뭐 좀 먹을까요」"
],
"6539": [
"녹초인데 배고파서 못 자는 건",
"곤란하니까 부엌으로 내려왔다."
],
"6540": [
"「너무 배부르게 먹는 것도",
"그건 그거대로 잠이 안 오니",
"컵수프 같은 걸로 할까요?」"
],
"6541": [
"「응, 그걸로 좋아」"
],
"6542": [
"「그럼 금방 만들게요.",
"그쪽 찬장에서 적당히",
"머그컵 좀 꺼내 주세요」"
],
"6543": [
"「음...",
"이거면 되려나」"
],
"6544": [
"「컵수프 가루가",
"이쯤이었나」"
],
"6545": [
"「거기 안쪽에 있을 거유」"
],
"6546": [
"「아, 있다 있다.",
"히오리, 콘수프랑",
"미네스트로네 중 뭐가 좋아?」"
],
"6547": [
"「음...",
"된장국 없었던가요」"
],
"6548": [
"「아, 있어.",
"나도 그걸로 할까...」"
],
"6549": [
"결국 둘이서 머그컵으로",
"인스턴트 된장국을 마신다."
],
"6550": [
"「...하아」"
],
"6551": [
"「왠지 이제야",
"살 것 같은 느낌」"
],
"6552": [
"「응...?」"
],
"6553": [
"「...방금 뭔가 이상한 소리가",
"났죠...」"
],
"6554": [
"「응...",
"밖에서 났지」"
],
"6555": [
"신경 쓰여 소리 난 쪽, 뒤뜰이",
"보이는 창문으로 다가가 봤다."
],
"6556": [
"「역시 뭔가 울리고 있어..?」"
],
"6557": [
"「...나고 씨, 저거!」"
],
"6558": [
"「어? 어느 거?」"
],
"6559": [
"온실 안에서 빛이 흔들리는 게",
"보였다."
],
"6560": [
"「저거... 손전등?」"
],
"6561": [
"「달리 흔들리는 불빛은 없으니",
"아마 그렇겠지만...」"
],
"6562": [
"「그, 그치만...!",
"저절로 흔들릴 리가 없잖아!",
"누가, 온실에 누가 있어...!!」"
],
"6563": [
"「...가 봅시다」"
],
"6564": [
"「엇!?",
"아, 아니, 그렇지...」"
],
"6565": [
"내버려 둘 수도 없어서",
"부엌을 뛰쳐나갔다."
],
"6566": [
"「...역시",
"손전등이네요」"
],
"6567": [
"온실에 와 보니 손전등은 아직",
"흔들흔들 흔들리고 있었다."
],
"6568": [
"「아무도... 없지...」"
],
"6569": [
"「...그런 것 같긴 한데.",
"우리가 오기 전에 도망쳤나...」"
],
"6570": [
"무성한 식물 때문에 안쪽까지",
"보이진 않지만 누가 숨어 있는",
"기척은 없다... 고 생각한다."
],
"6571": [
"주위를 둘러보며 안쪽으로",
"나아가 문제의 『복수』 종이가",
"놓인 곳에 왔다."
],
"6572": [
"「...아....」"
],
"6573": [
"「늘었네요...」"
],
"6574": [
"『복수』라는 붉은 글자 주위에",
"늘어놓인 소품들."
],
"6575": [
"거기에 또 하나 새로운 물건이",
"더해져 있었다."
],
"6576": [
"「...울타리?」"
],
"6577": [
"갑자기 뒤에서 목소리가 나서",
"놀라 히오리에게 매달린다."
],
"6578": [
"돌아보니 어느새",
"다른 사람들도 모여 있었다."
],
"6579": [
"「그러니까, 니 너무 놀란다」"
],
"6580": [
"「으... 그, 그치만...」"
],
"6581": [
"「처음에 울린 이상한 소리",
"들었수?」"
],
"6582": [
"「아니, 뭔가 떠드는 소리 나서",
"창문으로 보니까 오빠들이",
"뛰어가는 게 보여서」"
],
"6583": [
"「아, 우리 목소리 때문에...",
"그럼 처음 울린 이상한 소리,",
"그건 뭐였을까?」"
],
"6584": [
"「...그건?」"
],
"6585": [
"「그거?」"
],
"6586": [
"시즈나 짱은 바닥에 떨어진 뭔가의",
"타다 남은 재 같은 걸 가리킨다."
],
"6587": [
"「...뭘까, 이거」"
],
"6588": [
"「바닥이 그을렸네요.",
"폭죽 아닐까요」"
],
"6589": [
"「폭죽...",
"그래, 그러고 보니 그런 소리였어」"
],
"6590": [
"「근데 왜",
"그런 걸 터뜨리는데?」"
],
"6591": [
"「그야...",
"저 울타리 때문 아니겠수」"
],
"6592": [
"「...울타리...」"
],
"6593": [
"작은 나무 울타리였다.",
"무엇에 쓰는 물건인지",
"잘 모르겠다..."
],
"6594": [
"「...아직 계속되니까?」"
],
"6595": [
"시즈나 짱의 말에",
"대답하는 목소리는 없었다."
],
"6596": [
"분명 그 말대로일 거라고",
"다들 생각했겠지만..."
],
"6597": [
"「뭐...",
"쳐다봐도 별수 없으니",
"일단 돌아갑시다」"
],
"6598": [
"히오리가 그렇게 재촉하자, 퍼뜩",
"주박이 풀린 듯 왠지 모르게",
"서로의 얼굴을 둘러보았다."
],
"6599": [
"「....가자」"
],
"6600": [
"쌍둥이가 중얼거리고 온실을 나간다.",
"우리도 그 뒤를 따랐다."
],
"6601": [
"「이거야 원...",
"엉뚱한 방해가 들어왔네요」"
],
"6602": [
"「응... 그래도 말이야...",
"지금까진 굳이 온실로 불러낸 건",
"처음뿐이었는데...」"
],
"6603": [
"「왜 또 이번에만...?」"
],
"6604": [
"「모르겠네요.",
"하지만 예정대로라면 날짜도",
"이제 얼마 안 남았으니...」"
],
"6605": [
"「범인도 조금 초조한 건지도",
"모르지요」"
],
"6606": [
"「초조해?」"
],
"6607": [
"「쌍둥이는 무사했으니까요.",
"잘 저지당했으니 다음엔 그렇게",
"안 될 거라고 말하고 싶은 건지」"
],
"6608": [
"「그런~!?」"
],
"6609": [
"「아니, 모른다니까요.",
"그냥 떠오른 대로",
"말해 본 것뿐이니까」"
],
"6610": [
"「그렇게 무서워 안 해도",
"틀렸을 가능성이 더 높을 거유」"
],
"6611": [
"「...이번엔 틀렸기를",
"빌게...」"
],
"6612": [
"그게 맞다면 어떻게 생각해도",
"제일 원한 사는 건 나니까."
],
"6613": [
"（아니, 안 맞아도",
"그런가...?）"
],
"6614": [
"쓸데없는 짓 하는 게 나니까.",
"아, 점점 무서운 생각이 든다."
],
"6615": [
"「자자, 그렇게 울상",
"짓지 말고...」"
],
"6616": [
"「쉽시다.",
"이제 더는 방해도 없겠지요」"
],
"6617": [
"「으, 응, 그럴게...」"
],
"6618": [
"「...잘 자」"
],
"6619": [
"이상한 일이 일어난 탓에",
"잠이 달아난 것 같은",
"기분이 들었지만..."
],
"6620": [
"（...역시 피곤하구나...）"
],
"6621": [
"침대에 눕자마자",
"정신을 잃듯 잠들어 버렸다."
],
"6622": [
"（....응..?）"
],
"6623": [
"...왜 이렇게 금방",
"잠이 깨는 거지..."
],
"6624": [
"（아까 막 누웠는데...）"
],
"6625": [
"「...어라?",
"히오리, 벌써 없네...」"
],
"6626": [
"되게 빠르네, 생각하며",
"머리맡에 둔 손목시계에",
"손을 뻗어 보니...."
],
"6627": [
"「...점심이 지났어...」"
],
"6628": [
"순식간에 잠이 깬 것 같았던 건",
"완전히 착각이었다."
],
"6629": [
"꿈도 안 꾸고 곯아떨어졌던",
"것뿐이었나 보다..."
],
"6630": [
"（...일어나자）"
],
"6631": [
"고개를 저어 졸음을 떨치고",
"꼼지락꼼지락 이불에서 기어 나왔다."
],
"6632": [
"（...벌써 밝아지고",
"있네...）"
],
"6633": [
"틈새로 보이는 복도에는",
"어렴풋한 밝음이",
"번져 오고 있었다."
],
"6634": [
"（슬슬 나가도 되려나.",
"허리도 아프고...）"
],
"6635": [
"일단 방으로 돌아가자..."
],
"6636": [
"（히오리는 아직 자고",
"있을 테니까",
"깨우지 않게...）"
],
"6637": [
"조용히 침대에 파고들어",
"얕고 짧은 잠에 빠졌다..."
],
"6638": [
"슬슬 괜찮을지도.",
"다들 일어나기 전에",
"일단 방으로 돌아가자."
],
"6639": [
"（...어디 가지）"
],
"6640": [
"「아, 벌써 시간이 이렇게.",
"누가 내려올지도...」"
],
"6641": [
"「...왠지",
"엄청 어둑해지지 않았나?」"
],
"6642": [
"「아, 벌써 저녁이네」"
],
"6643": [
"「해가 진 것뿐이가?",
"또 날씨 나빠진 줄 알았다」"
],
"6644": [
"「...오빠 저녁밥",
"우짤 기고?」"
],
"6645": [
"「1층에 내려가 볼게.",
"히오리가 올 테니까」"
],
"6646": [
"「그래, 그럼 나도",
"언니 부르러 가야지」"
],
"6647": [
"「그럼, 또 봐」"
],
"6648": [
"「응, 그럼」"
],
"6649": [
"히오리도 이제 서재에서",
"나올 시간이겠지."
],
"6650": [
"「...이제 됐제.",
"해가 져 버렸다」"
],
"6651": [
"「아, 정말이네...",
"미안, 그럼 갈게」"
],
"6652": [
"...히오리도 이제",
"서재에서 나올 때쯤인가."
],
"6653": [
"「...배고파」"
],
"6654": [
"「어? 아, 벌써 이렇게 됐네」"
],
"6655": [
"「아마 슬슬",
"스즈가 부르러 올 거야...」"
],
"6656": [
"「히오리도 서재에서 나올 때겠다」"
],
"6657": [
"「...그럼, 바이바이」"
],
"6658": [
"「응, 고마워.",
"그럼 갈게」"
],
"6659": [
"「....이제 됐나?」"
],
"6660": [
"「아..",
"응, 고마워」"
],
"6661": [
"（벌써 저녁이구나...）"
],
"6662": [
"히오리도 슬슬 서재에서 나올",
"테니 1층으로 내려가자..."
],
"6663": [
"「...어머, 죄송해요.",
"벌써 시간이 이렇게 됐네요」"
],
"6664": [
"「우와, 정말이다.",
"죄송합니다」"
],
"6665": [
"「아니요, 저는 괜찮아요.",
"하지만 이치야나기 씨는 히오리",
"씨가 걱정하시지 않겠어요?」"
],
"6666": [
"「아, 네.",
"그럼 실례했습니다」"
],
"6667": [
"「언제든 오세요.",
"혼자 방에 있으면 아무래도",
"마음이 가라앉아 버려서...」"
],
"6668": [
"「...네.",
"그럼...」"
],
"6669": [
"「...저기, 죄송하지만",
"몸이 좀 안 좋아서요..」"
],
"6670": [
"「아, 죄송합니다.",
"그럼...」"
],
"6671": [
"「...미안해요」"
],
"6672": [
"（...꽤 지쳐 있는",
"것 같네...）"
],
"6673": [
"...아, 벌써 시간이 이렇게.",
"슬슬 1층으로 내려가자."
],
"6674": [
"「...어이, 꼬마.",
"슬슬 뉴스 시간이다」"
],
"6675": [
"「아, 정말이네요.",
"그럼 전 라디오 들으러 갈게요」"
],
"6676": [
"「부탁한다.",
"좋은 소식 있으면 바로 알려라」"
],
"6677": [
"「알겠습니다.",
"그럼 또...」"
],
"6678": [
"「조심해서 가」"
],
"6679": [
"「네」"
],
"6680": [
"「...응?",
"왠지 어둡다 했더니 벌써",
"시간이 이렇게 됐냐...」"
],
"6681": [
"「어, 정말이다.",
"벌써 저녁이네...」"
],
"6682": [
"「그럼 나 슬슬 갈게.",
"실례했어」"
],
"6683": [
"「...실례지만 슬슬",
"해가 지니까요...」"
],
"6684": [
"「아, 그렇네.",
"그럼 실례했어」"
],
"6685": [
"「조심해서 가세요」"
],
"6686": [
"...히오리는 벌써 와 있으려나."
],
"6687": [
"「아, 벌써 저녁 시간이네요」"
],
"6688": [
"「어, 벌써 그렇게 됐어?",
"아차, 스쿼트 아직 못 끝냈네」"
],
"6689": [
"「어, 저기, 죄송해요",
"방해해 버려서」"
],
"6690": [
"「하하, 괜찮아 그런 건.",
"지금부터 해치울 테니까」"
],
"6691": [
"「나고무 군은 밥 먹으러 가」"
],
"6692": [
"「네, 그럴게요.",
"그럼, 감사했습니다」"
],
"6693": [
"「또 봐~」"
],
"6694": [
"「...미안, 이제 됐을까?",
"오늘 몫의 스쿼트를 아직",
"평소 횟수만큼 못 끝내서 말야」"
],
"6695": [
"「아, 죄송합니다.",
"그럼 실례할게요」"
],
"6696": [
"「응, 미안하네」"
],
"6697": [
"（...아, 벌써 이런 시간인가）"
],
"6698": [
"히오리가 와 있을지도 모르니",
"1층으로 내려가자..."
],
"6699": [
"「...어라, 벌써 어둑하네」"
],
"6700": [
"「어? 아, 정말이다.",
"벌써 저녁이네...」"
],
"6701": [
"「슬슬 갈까요」"
],
"6702": [
"「...싫어어어어어어...!!」"
],
"6703": [
"「!?」"
],
"6704": [
"저택 전체에 울려 퍼질 듯한",
"엄청난 비명에 벌떡 일어났다."
],
"6705": [
"「뭐... 바, 방금 그 소리...」"
],
"6706": [
"「쌍둥이 중 하나 아니겠수.",
"갑시다!」"
],
"6707": [
"서둘러 안경을 쓰고 방을 뛰쳐나간다."
],
"6708": [
"「...시즈나 씨 방이우」"
],
"6709": [
"「정말이다, 열려 있어...」"
],
"6710": [
"「언니!!",
"언니이이!!」"
],
"6711": [
"시즈나 짱의 방문이 반쯤",
"열린 채로 있다."
],
"6712": [
"안에서 스즈나 짱의 외침이",
"들려와 황급히 다가갔다."
],
"6713": [
"「스즈나 짱?",
"무슨 일이...」"
],
"6714": [
"「.....이건...」"
],
"6715": [
"너무나 처참한 광경에 가위라도",
"눌린 듯 몸이 굳어 버린다."
],
"6716": [
"비명을 지르고 싶어도 소리도 안 나고",
"몸은 안 움직이는데 눈앞의 새빨간",
"방만 빙글빙글 돌기 시작해서..."
],
"6717": [
"「...나고 씨!」"
],
"6718": [
"휘청, 시선이 크게 흔들린다.",
"정신 차려 보니 쓰러질 뻔한 걸",
"누가 받쳐 주고 있었다."
],
"6719": [
"「...히... 히오리...」"
],
"6720": [
"「말 안 해도 돼요,",
"됐으니까, 정신 차려요...」"
],
"6721": [
"「...저... 거,",
"시즈나 짱... 이야...?」"
],
"6722": [
"「.......예」"
],
"6723": [
"침대에 누운 피투성이 몸에서",
"기이한 것이 솟아 있다."
],
"6724": [
"가슴께에서 이상한 각도로",
"둔한 쇳빛을 띤 무언가가..."
],
"6725": [
"「...어째, 서?",
"저런... 저거, 뭐야...?」"
],
"6726": [
"「...도끼 같습니다」"
],
"6727": [
"「도끼? 도끼라니...」"
],
"6728": [
"「――나가라!!」"
],
"6729": [
"「우왓..!?」"
],
"6730": [
"멍하니 있는데 갑자기 달려온",
"스즈나 짱에게 떠밀려 넘어졌다."
],
"6731": [
"「나가, 나가라니까!",
"언니한테 손대지 마!!」"
],
"6732": [
"「잠깐... 스즈나 씨,",
"진정해요, 손 안 댈 테니까」"
],
"6733": [
"「나가라! 빨리!!",
"나가라꼬!!」"
],
"6734": [
"히오리가 달래려 해도",
"스즈나 짱은 나가라며",
"밀어낼 뿐이었다."
],
"6735": [
"그리고 눈앞에서 문을 닫아 버린다.",
"방 안에서는 이 세상 것이라고는",
"생각할 수 없는 통곡이 들려온다.."
],
"6736": [
"「...당분간 가만히",
"둘 수밖에 없겠지요」"
],
"6737": [
"「네......」"
],
"6738": [
"아, 히오리 말고도 누가 있었구나.",
"희미해지는 의식 속에서 멍하니",
"그런 생각을 했다."
]
}