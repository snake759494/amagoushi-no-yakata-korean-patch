 ],
 "27211": [
  "「게다가 왓슨 역이라서",
  "최종적으로 범인 역이 된다는",
  "논리를 모르겠는데요...」"
 ],
 "27212": [
  "듣고 보니 확실히 모르겠다.",
  "왜 이렇게 된 거지...?"
 ],
 "27213": [
  "「히오리만 다카토 씨 저서의",
