 ],
 "27219": [
  "「게다가....」"
 ],
 "27220": [
  "「게다가...?」"
 ],
 "27221": [
  "「이건 말하면 히오리 씨가 부당하게",
  "의심받을 것 같아서 말 안 했지만",
  "어쩔 수 없네요...」"
 ],
 "27222": [
  "「히오리 씨가 이 사건에서",
