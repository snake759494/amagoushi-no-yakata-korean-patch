 ],
 "27204": [
  "「물론 알겠죠.",
  "시쿠라 씨는 어디까지나 갇힌",
  "다른 사람들을 위한 방패였어요」"
 ],
 "27205": [
  "「최종적인 범인 역은 따로 있어요.",
  "분명히 다른 사람과는 다른 위치에",
  "놓였던 인물, 그건...」"
 ],
 "27206": [
  "「...히오리예요」"
 ],
 "27207": [
  "「히오리 씨...?",
