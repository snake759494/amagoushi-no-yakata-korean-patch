  "그거랑 같은 자세로 만들려 하면",
  "도중에 누가 소리를 알아챌 거다."
 ],
 "23316": [
  "「헤에, 그렇구나?",
  "그럼 내 때는 어떻게 할",
  "예정이었을까?」"
 ],
 "23317": [
  "「그게, 작중에 나오는 키워드가",
  "너무 많아서 어느 걸 쓰려고",
  "했는지 잘 모르겠어요」"
 ],
 "23318": [
  "「거의 다 소품이라서",
  "숨기기는 어렵지 않았지만요」"
 ],
 "23319": [
  "「숨겼어? 전부?」"
 ],
 "23320": [
  "「네, 쓸 만한 건",
  "전부 치웠어요」"
 ],
 "23321": [
  "「그렇구나, 그럼 안심이네」"
 ],
 "23322": [
  "나스 씨는 그렇게 말하며 선반 위에",
  "어질러진 병을 치우고 뭔가를",
  "찾기 시작했다."
 ],
 "23323": [
  "「그게 보충제라는",
  "건가요?」"
 ],
 "23324": [
  "「응, 맞아.",
  "...어라, 아까 부엌에서",
  "받아 온 차가 없네...」"
 ],
 "23325": [
  "「아, 아까 목욕하기 전에",
  "들고 있던 거요?」"
 ],
 "23326": [
  "「그래, 그거.",
  "어디 뒀더라」"
 ],
 "23327": [
  "두리번거리며 방 안을",
  "둘러보며 걷는다..."
 ],
 "23328": [
  "「...저기, 그 트레이닝",
  "머신 위에 올려져 있는 건」"
 ],
 "23329": [
  "「오?",
  "아~, 이거다 이거.",
  "고마워, 나고무 군」"
 ],
 "23330": [
  "머신 위에서 페트병을 집더니",
  "단숨에 들이켜고..."
 ],
 "23331": [
  "「아니...어쩐지...」"
 ],
 "23332": [
  "「읏...크...!!」"
 ],
 "23333": [
  "「엣!? 나, 나스 씨!?」"
 ],
 "23334": [
  "갑자기 나스 씨가 눈을 부릅뜨고",
  "자기 목을 쥐어뜯기 시작했다."
 ],
 "23335": [
  "놓친 페트병이 바닥에 떨어져",
  "액체 자국을 남기며 굴러간다."
 ],
 "23336": [
  "「크...흡...」"
 ],
 "23337": [
  "몸을 ㄱ자로 꺾으며 피인지",
  "토사물인지 모를 것을 토하고",
  "나스 씨가 무너져 내린다."
 ],
 "23338": [
  "붙잡으려 해도 내 힘으론 튕겨 나갈",
  "듯한 기세로 몸부림치고 있어서",
  "어떻게 할 수가 없다."
 ],
 "23339": [
  "「나스 씨!? 나스 씨이!!」"
 ],
 "23340": [
  "「누...누가...",
  "누가 좀 와 줘요, 누구 없어요!!」"
 ],
 "23341": [
  "허둥지둥 문에 달려들어",
  "애를 먹으며 간신히 연다."
 ],
 "23342": [
  "「히...히오리...!",
  "나스 씨가...나스 씨가!!」"
 ],
 "23343": [
  "「무슨 일입니까!?」"
 ],
 "23344": [
  "「나스 씨가...어떡해!",
  "나스 씨가...!!」"
 ],
 "23345": [
  "「진정하세요, 나고 씨!",
  "방입니까? 나스 씨 방?」"
 ],
 "23346": [
  "「그...방...",
  "갑자기, 방에서...」"
 ],
 "23347": [
  "제대로 된 말도 못 하고",
  "중얼거리며 히오리의 기모노",
  "소매를 잡아끈다."
 ],
 "23348": [
  "「무슨 일이세요...!?」"
 ],
 "23349": [
  "「뭐야? 이번엔 또 뭔데!?」"
 ],
 "23350": [
  "소란을 듣고 다른 방 사람들도",
  "뛰쳐나온다."
 ],
 "23351": [
  "「방에 있던 건",
  "나스 씨뿐입니까?」"
 ],
 "23352": [
  "「그래!",
  "우리 둘뿐이었는데!!」"
 ],
 "23353": [
  "「그런데...왜!?",
  "어째서...!?」"
 ],
 "23354": [
  "나스 씨 방 앞까지 와서",
  "히오리는 얼어붙은 듯 멈춰 섰다."
 ],
 "23355": [
  "험악한 눈빛과 침묵이, 혼란스럽던",
  "의식을 가라앉히는 대신",
  "오싹한 한기를 몰고 왔다."
 ],
 "23356": [
  "소리가 나지 않았다.",
  "조금 전까지 나스 씨가 내던",
  "격렬한 소리가 더는 들리지 않는다."
 ],
 "23357": [
  "부르면서, 녹슨 톱니바퀴처럼",
  "어색한 움직임으로 어깨 너머를 본다."
 ],
 "23358": [
  "「――――!!」"
 ],
 "23359": [
  "...움직이지 않았다.",
  "나스 씨는 이제 꿈쩍도 않고",
  "바닥 위에 쓰러져 있었다."
 ],
 "23360": [
  "엎질러진 녹차와 토혈이 바닥에 섬뜩한",
  "무늬를 그리고, 그 위에 비좁은 자세로",
  "그 커다란 몸이 가라앉아 있다..."
 ],
 "23361": [
  "「......거짓말」"
 ],
 "23362": [
  "「기...기절, 한 거",
  "아니야...?」"
 ],
 "23363": [
  "「그치, 그런 거지!",
  "나스 씨잖아!?」"
 ],
 "23364": [
  "「그렇게 건강한 사람이, 이런,",
  "이런....」"
 ],
 "23365": [
  "히오리는 나를 문 옆으로 살며시",
  "비키게 하고, 나스 씨 곁에 꿇어앉았다."
 ],
 "23366": [
  "손을 뻗어 나스 씨의 손목을",
  "짚는다."
 ],
 "23367": [
  "「맥박이, 없습니다.",
  "...돌아가셨어요」"
 ],
 "23368": [
  "「조금 전까지 멀쩡했는데...」"
 ],
 "23369": [
  "...그런데 갑자기.",
  "차를 마셨을 뿐인데."
 ],
 "23370": [
  "갑자기 괴로워하더니..."
 ],
 "23371": [
  "영문도 모른 채 비틀비틀",
  "방 쪽으로 두세 걸음 다가간다."
 ],
 "23372": [
  "「독...」"
 ],
 "23373": [
  "「...그렇지 않수.",
  "나스 씨, 좋은 사람이었지요」"
 ],
 "23374": [
  "「이리 오세요, 나고 씨.",
  "아래서 뭔가 따뜻한 거라도",
  "마십시다」"
 ],
 "23375": [
  "「나고 씨만의 탓은",
  "아니잖수」"
 ],
 "23376": [
  "「그치만, 난...",
  "같이 있었는데...」"
 ],
 "23377": [
  "그래도...",
  "내가 조금만 더 주의했더라면",
  "나스 씨는 살았을지도..."
 ],
 "23378": [
  "「갑시다, 나고 씨」"
 ],
 "23379": [
  "「아뇨, 그게...",
  "정말 다 숨겼는지",
  "자신이 없어요」"
 ],
 "23380": [
  "「이 저택 넓고, 제가 못 찾았을",
  "뿐이지 쓸 만한 게 어딘가에",
  "더 있을지도 모르고...」"
 ],
 "23381": [
  "「그렇구나, 그래서 그렇게",
  "걱정스러운 얼굴이구나」"
 ],
 "23382": [
  "「음, 분명 나랑 같은 이름의",
  "사람이 나오는 건 『호반의 저택』",
  "이란 이야기였지」"
 ],
 "23383": [
  "「맞아요.",
  "연쇄 살인이라서 사건 자체도",
  "잔뜩 일어나요」"
 ],
 "23384": [
  "「읽은 지 꽤 돼서",
  "확실히 기억이 안 나네」"
 ],
 "23385": [
  "「아, 읽으셨군요」"
 ],
 "23386": [
  "「읽었을 텐데 말이야.",
  "무슨 이야기였더라?」"
 ],
 "23387": [
  "읽었다는 데 놀라야 할지,",
  "하나도 기억 못 한다는 데",
  "놀라야 할지..."
 ],
 "23388": [
  "「음, 어떤 커다란 저택의",
  "일족이 차례로 살해당하는 얘기고...」"
 ],
 "23389": [
  "「현장에 꼭 상관없어 보이는",
  "물건이 굴러다니는...」"
 ],
 "23390": [
  "「아아, 어렴풋이 생각났어!",
  "술 마시고 난동 부리던 주정뱅이가",
  "갑자기 죽는 장면이 있었지」"
 ],
 "23391": [
  "「이, 이상한 데만 기억하시네요」"
 ],
 "23392": [
  "「음~, 영화로 본 것 같으니까",
  "인상이 강했던 거겠지」"
 ],
 "23393": [
  "「영화로도 나왔어요?",
  "음, 분명 처음 살해당하는",
  "사람 장면이죠, 그거」"
 ],
 "23394": [
  "「그래그래, 마시던 술에",
  "독이 들어 있었던가」"
 ],
 "23395": [
  "「그야 뭐, 그 이야기는",
  "모든 사건의 살해 방법이 전부",
  "독살이었을 테니까요...」"
 ],
 "23396": [
  "「어라? 그랬나?」"
 ],
 "23397": [
  "「뭔가 종 안에 처박힌",
  "사람도 있지 않았나?」"
 ],
 "23398": [
  "「...그거, 다른 이야기가",
  "섞인 것 같아요」"
 ],
 "23399": [
  "「그런가, 꽤 옛날이라",
  "잊어버렸네」"
 ],
 "23400": [
  "잊었다 어쩌다 하는 것 이전의",
  "문제인 것 같다."
 ],
 "23401": [
  "나스 씨는 대수롭지 않게",
  "어질러진 책상 위를 치우기 시작했다."
 ],
 "23402": [
  "「그 병들, 전부 영양제",
  "같은 건가요?」"
 ],
 "23403": [
  "「응, 보충제야.",
  "이건 아까 냉장고에서 가져온",
  "평범한 차지만」"
 ],
 "23404": [
  "트레이닝 머신 위에 놓여 있던",
  "녹차 페트병을 손에",
  "들며 나스 씨가 대답한다."
 ],
 "23405": [
  "「아, 목욕하러 가기 전에",
  "들고 있던 거네요」"
 ],
 "23406": [
  "「응, 그래.",
  "그러고 보니...」"
 ],
 "23407": [
  "「이 페트병, 연 기억이 없는데",
  "왜 열려 있지?」"
 ],
 "23408": [
  "「뭐, 됐나」"
 ],
 "23409": [
  "「안 돼요! 잠깐만요!!」"
 ],
 "23410": [
  "「마시면 안 돼요!!",
  "수상하잖아요, 그거!?",
  "아무리 봐도 수상하잖아요!?」"
 ],
 "23411": [
  "「...수상하다니 뭐가?」"
 ],
 "23412": [
  "「1분 전에 한 얘기 정도는",
  "기억해 주세요!!」"
 ],
 "23413": [
  "「독이요, 독!!",
  "들어 있으면 어쩌려고요!」"
 ],
 "23414": [
  "「......여기에!?」"
 ],
 "23415": [
  "「연 기억이 없는데",
  "열려 있다면서요!?」"
 ],
 "23416": [
  "「엄청 수상하잖",
  "아요!!」"
 ],
 "23417": [
  "「....아아, 그렇구나」"
 ],
 "23418": [
  "겨우 납득한 듯이 나스 씨는",
  "자기가 든 페트병을 찬찬히",
  "바라본다."
 ],
 "23419": [
  "「그럼 이거 이제 못 마시는구나」"
 ],
 "23420": [
  "「마시면 안 돼요!」"
 ],
 "23421": [
  "「아깝더라도",
  "참으세요!!」"
 ],
 "23422": [
  "「...조금 핥아 보면",
  "들었는지 알 수 있지 않을까」"
 ],
 "23423": [
  "「안 된다니까요!!」"
 ],
 "23424": [
  "태평하게 마실 것 같고, 곧 했던 말을",
  "잊고 마실 것 같아 무서워서",
  "억지로 빼앗았다..."
 ],
 "23425": [
  "「부탁이니까 조금만 더",
  "경계 좀 해 주세요...」"
 ],
 "23426": [
  "「하하, 미안 미안.",
  "그래도 그것만 안 마시면",
  "괜찮은 거지?」"
 ],
 "23427": [
  "「아, 아뇨, 제일 수상할 뿐이지",
  "범인이 더는 아무 짓도 안 할지는",
  "모르는 거예요」"
 ],
 "23428": [
  "「그럼 역시",
  "깨어 있는 게 좋겠네」"
 ],
 "23429": [
  "「그게 안전하겠죠」"
 ],
 "23430": [
  "「그렇구나...",
  "그런데 한밤 내내면 심심하겠다」"
 ],
 "23431": [
  "「텔레비전도 없으니까요...」"
 ],
 "23432": [
  "「스쿼트 연속 몇 번",
  "할 수 있나 도전해 볼까」"
 ],
 "23433": [
  "「...밤새도록요?」"
 ],
 "23434": [
  "「나고무 군은 도중에 뻗어",
  "버리겠네」"
 ],
 "23435": [
  "「저, 전 됐어요!",
  "운동은 못 한단 말이에요!!」"
 ],
 "23436": [
  "「평소에 운동 안 해?",
  "어디 보자」"
 ],
 "23437": [
  "무심코 팔을 붙잡혀",
  "휙 비틀렸다."
 ],
 "23438": [
  "「으악!?",
  "아파 아파, 나스 씨 아파요!」"
 ],
 "23439": [
  "「몸이 뻣뻣하네, 이러면",
  "어깨 결리겠다」"
 ],
 "23440": [
  "「겨, 결리긴 하는데, 방금 게",
  "더 아팠어요...」"
 ],
 "23441": [
  "「스트레칭으로 좀 풀어 주면",
  "엄청 편해져」"
 ],
 "23442": [
  "「음 팔 들어서 이렇게 돌리고...」"
 ],
 "23443": [
  "「아니, 그러니까, 저는」"
 ],
 "23444": [
  "「자, 숨 참고~」"
 ],
 "23445": [
  "「......!」"
 ],
 "23446": [
  "왜, 왜 스트레칭 체조 강좌가",
  "되어 버린 거지..."
 ],
 "23447": [
  "「굴신 운동 좀 해 볼까.",
  "자, 다리 뻗고」"
 ],
 "23448": [
  "「네? 네에에!?",
  "아니 저기 나스 씨, 저 몸 뻣뻣해요!」"
 ],
 "23449": [
  "「뻣뻣하니까 라니, 밀지 마요!",
  "아파 아파 아파!!」"
 ],
 "23450": [
  "....접혀 버리는 줄 알았다."
 ],
 "23451": [
  "결국 복근이다 등근육이다 아령이다,",
  "점점 스트레칭 정도가 아닌",
  "세계가 되어 가서..."
 ],
 "23452": [
  "...도중에 의식을 잃었다."
 ],
 "23453": [
  "「괜찮아, 괜찮아!",
  "누가 억지로 들어오면 이렇게 팔 잡고",
  "관절 꺾으면 문제없으니까」"
 ],
 "23454": [
  "「...아, 다치게 하면 안 되려나.",
  "그럼 뒤를 잡고 슬리퍼 홀드로",
  "기절시키는 게 낫겠네」"
 ],
 "23455": [
  "어쩐지 이 사람은 걱정할 필요",
  "없을 것 같아졌다..."
 ],
 "23456": [
  "「저, 정말 괜찮으세요?」"
 ],
 "23457": [
  "「그럼, 일대일이면 절대",
  "안 진다니까!」"
 ],
 "23458": [
  "「......하아」"
 ],
 "23459": [
  "「무슨 일이냐니요,",
  "나스 씨, 그러니까 그 얘기...」"
 ],
 "23460": [
  "「그 얘기?",
  "내가 늘 카레에 넣는",
  "거라면, 사과...」"
 ],
 "23461": [
  "「무슨 얘기예요!?」"
 ],
 "23462": [
  "「저녁 얘기가 아니라,",
