  "그 아이는 화내지도 울지도 않아요」"
 ],
 "26765": [
  "「리나에게는",
  "모르는 사람이 끔찍한 짓을 했다,",
  "그것뿐이니까...」"
 ],
 "26766": [
  "「그렇게... 생각하니...",
  "택하지 않을 수 없었어요...」"
 ],
 "26767": [
  "「...읏, 흑...」"
 ],
 "26768": [
  "「이상한 사람이네요...",
  "왜 당신이 우는 거예요?」"
 ],
 "26769": [
  "「그... 그치만...",
  "그런 건... 불쌍해요...」"
 ],
 "26770": [
  "「미사사기 씨도...",
  "리나 씨도...」"
 ],
 "26771": [
  "「정말로 아무것도...",
  "말 안 해도 된다고 생각했어요?」"
 ],
 "26772": [
  "「말할 수 있었다면...",
  "하지만, 말할 수 없었는걸!」"
 ],
 "26773": [
  "「리나가 어디 있는지조차",
  "모르는데...!」"
 ],
 "26774": [
  "「그런 건...!」"
 ],
 "26775": [
  "「뭔가...",
  "분명 뭔가 방법이 있었을 거예요!」"
 ],
 "26776": [
  "「복수 같은 게 아니라,",
  "다른, 뭔가...」"
 ],
 "26777": [
  "「생각했어요...",
  "실컷 생각했다고요!」"
 ],
 "26778": [
  "「하지만 다른 건 아무것도",
  "떠오르지 않았어!!」"
 ],
 "26779": [
  "「다른 건 아무것도",
  "생각할 수 없게 됐어요...」"
 ],
 "26780": [
  "「그런데...",
  "전부 착각이었다니..」"
 ],
 "26781": [
  "「나는 아무 관계도 없는 사람들을",
  "원망하고, 죽여 버리고...」"
 ],
 "26782": [
  "「...이제 모든 걸",
  "되돌릴 수 없어요...」"
 ],
 "26783": [
  "「그럼 제가...",
  "제가 다녀올게요!」"
 ],
 "26784": [
  "「리나 씨의 무덤을 찾아서",
  "미사사기 씨가 하고 싶던 말 전부",
  "전하고 올 테니까요...!」"
 ],
 "26785": [
  "「그러니까, 이제...",
  "이제 그만둬요!",
  "부탁이에요...」"
 ],
 "26786": [
  "「더 이상",
  "끔찍한 짓은 하지 마요...」"
 ],
 "26787": [
  "「...리나... 에게...」"
 ],
 "26788": [
  "「...하지만, 이제 와서...",
  "이제 와서 뭐라고 하면 돼요?」"
 ],
 "26789": [
  "「나는 사람을 죽였어요...!",
  "그것도 아무 관계 없는 사람을요!?」"
 ],
 "26790": [
  "「그런 짓을...",
  "그런, 무서운 짓을...」"
 ],
 "26791": [
  "「무덤 앞이 아니어도",
  "괜찮잖아요!!」"
 ],
 "26792": [
  "「무덤 앞이 아니어도...",
  "리나 씨가 좋아하던 곳이라든가",
  "다른 곳에서도...」"
 ],
 "26793": [
  "「리나가...",
  "좋아하던 곳...」"
 ],
 "26794": [
  "「미사사기 씨라면 알잖아요?",
  "계속 지켜봤으니까...」"
 ]
