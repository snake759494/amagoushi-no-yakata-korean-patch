],
"14431": [
"「응, 무사하면 좋겠네」"
],
"14432": [
"일단 고개는 끄덕였지만..."
],
"14433": [
"애초에 내가 꿈이라도 꾼 걸지도 모른다는",
"가능성이 더 높겠지..."
],
"14434": [
"「...좀 더 제대로",
"불러 볼 걸 그랬어요, 저...」"
],
"14435": [
"「응? 아아, 미안!",
"너를 탓하는 게 아니야」"
],
"14436": [
"「놀랐을 테고, 너도",
"그 자리에서 쓰러졌잖아」"
],
"14437": [
"「아, 네, 하지만...」"
],
"14438": [
"「괜찮아 괜찮아,",
"시체가 걸어 다닐 리 없으니까",
"분명 무사할 거야, 응」"
],
"14439": [
"「...그러면 좋겠네요」"
],
"14440": [
"하지만 살아 있었다면 내 목소리에",
"좀 더 반응하지 않았을까."
],
"14441": [
"그전에, 내가 잘못 봤거나 쓰러졌을 때",
"꿈이라도 꿨을 가능성이 더",
"높을지도 모르지만."
],
"14442": [
"「그럴 리 없어요.",
"살아 있었다면 좀 더 반응이",
"있었을 테고...」"
],
"14443": [
"「응? 하지만 죽었다면",
"사라질 리가 없잖아」"
],
"14444": [
"「어, 아, 뭐...」"
],
"14445": [
"「그렇지?",
"살아 있길 바라,",
"무사하길 빌자고」"
],
"14446": [
"「...그러고 보니 나고무 군은",
"배우가 아니었던가」"
],
"14447": [
"「아니에요, 그냥 길 잃은 사람이에요」"
],
"14448": [
"「길 잃었구나, 그거 힘들지.",
"나도 가끔 길을 잃거든」"
],
"14449": [
"「이름만 비슷한 전혀 다른",
"역에 도착해서, 게다가 그걸",
"모르고 내려 버린다든가」"
],
"14450": [
"「저, 그건...」"
],
"14451": [
"「...호쾌하시네요...」"
],
"14452": [
"「아하하, 그런가?」"
],
"14453": [
"「하지만 그러면",
"언제까지 가도 목적지에",
"도착 못 하잖아요...?」"
],
"14454": [
"「아니, 그게 도착했어」"
],
"14455": [
"「어떻게요!?」"
],
"14456": [
"「잘은 모르겠는데",
"2시간쯤 걸었더니 도착했어」"
],
"14457": [
"그건 즉...",
"원래 도착해야 할 역까지 걸어서",
"이동해 기적적으로 도착했다는 건가."
],
"14458": [
"「그래서 크게 지각은 했지만",
"어떻게든 되더라고, 응」"
],
"14459": [
"그걸로 어떻게든 되는 건 분명",
"나스 씨 정도일 거다..."
],
"14460": [
"（적어도 나는 도중에",
"쓰러지겠지...）"
],
"14461": [
"「길 잃은 거랑은 뭔가 다른",
"것 같은데요...」"
],
"14462": [
"「아, 역시?",
"누구한테 말해도",
"그런 소리를 듣더라」"
],
"14463": [
"「그거, 역을 잘못 간 이유가",
"방향 감각이랑 상관없잖아요」"
],
"14464": [
"「...아아, 그렇구나!",
"듣고 보니 그렇네」"
],
"14465": [
"「그래, 물건 이름 외우는 게",
"서툴거든, 나는」"
],
"14466": [
"...그건 알겠다.",
"아까도 내 이름 틀렸고."
],
"14467": [
"「그때도 결국 엄청 늦었지만",
"목적지까지는 도착했으니까」"
],
"14468": [
"「도착해서 다행이네요...」"
],
"14469": [
"「응, 왠지 운은 좋거든」"
],
"14470": [
"그건 부럽다..."
],
"14471": [
"「저는 그렇게까지 심하진 않지만요」"
],
"14472": [
"「응? 그래?」"
],
"14473": [
"「그렇구나... 역시 내가",
"틀리는 방식이 심한 거구나...」"
],
"14474": [
"아, 좀 풀이 죽었다.",
"괜한 말을 했나..."
],
"14475": [
"「...응? 그러고 보니",
"무슨 용건 있지 않았어?」"
],
"14476": [
"「아, 음...",
"나스 씨는 여기까지 차로",
"오셨죠」"
],
"14477": [
"「응, 맞아.",
"앞에 세워 뒀어」"
],
"14478": [
"「제가 도중에 차를 두고 와서요,",
"죄송한데 내일 제 차 있는 데까지",
"태워 주실 수 있을까요?」"
],
"14479": [
"「아아, 뭐야 그런 거구나.",
"물론 괜찮아」"
],
"14480": [
"「근데 두고 왔다니",
"고장 난 건 아니야?」"
],
"14481": [
"「네, 고장은 아니에요.",
"기름이 위험하다 싶어서",
"내려서 걸어온 것뿐이라」"
],
"14482": [
"「그렇구나, 그럼 어쨌든",
"산에서 내려갈 때까지 기름이",
"버틸지 모르는 거네」"
],
"14483": [
"「혹시 모자랄 것 같으면",
"일단 내 차로 시내까지 가면 돼」"
],
"14484": [
"「그래도 돼요?」"
],
"14485": [
"「그럼, 분명 병원에도",
"가야 한다고 했지?」"
],
"14486": [
"「그럼 차 상태 보고 병원 가고,",
"차는 시내에서 정비소에 연락해서",
"가지러 가 달라고 하면 어때?」"
],
"14487": [
"「고맙습니다,",
"그렇게 해 주시면 살 것 같아요」"
],
"14488": [
"「죄송해요, 왠지",
"폐만 끼치고...」"
],
"14489": [
"「무슨 소리야,",
"어려울 땐 서로 돕는 거지」"
],
"14490": [
"「그럼 내일은 일찍",
"일어나서 시내로 가자」"
],
"14491": [
"「네, 잘 부탁드려요」"
],
"14492": [
"그렇게 말하고 나스 씨는 다시",
"몸을 움직이기 시작했다."
],
"14493": [
"（좀 특이하지만",
"좋은 사람이네...）"
],
"14494": [
"「음, 나스 씨」"
],
"14495": [
"「응? 왜?」"
],
"14496": [
"그렇게 생각한다"
],
"14497": [
"생각하지 않는다"
],
"14498": [
"제대로 충고한다"
],
"14499": [
"말하지 않는다"
],
"14500": [
"모방할 책을 암시"
],
"14501": [
"맡은 배역을 암시"
],
"14502": [
"「저기요, 실은 오늘 밤...」"
],
"14503": [
"「오늘 밤? 무슨 일 있어?」"
],
"14504": [
"「밤에는 말이야, 자기 전에 저 기구를",
"문 앞에 둬서 막아 두는데」"
],
"14505": [
"「...저",
"운동 기구요...?」"
],
"14506": [
"확실히 저런 게 문 앞에 있으면",
"문이 열려 있어도 못 들어가겠지만."
],
"14507": [
"「뭐, 혹시 누가 억지로 들어와도",
"웬만해선",
"지지 않을 것 같고」"
],
"14508": [
"「그러니까 괜찮을 거야」"
],
"14509": [
"「음, 그럼...",
"밤에는 절대 문을 열지",
"마세요」"
],
"14510": [
"「아아, 그럴게.",
"고마워!」"
],
"14511": [
"...이 사람은 괜찮겠다.",
"웬만한 상대는 역으로 당하는 게",
"뻔하다, 분명."
],
"14512": [
"「아, 아뇨, 그래도...",
"범인이요, 오늘 노리는 건",
"나스 씨인 것 같아요」"
],
"14513": [
"「나?」"
],
"14514": [
"「네, 저, 믿기지 않으실지도",
"모르겠지만...」"
],
"14515": [
"「...그렇구나.",
"나인가...」"
],
"14516": [
"「저, 나스 씨...?」"
],
"14517": [
"「미, 믿어 주시는 거예요?」"
],
"14518": [
"「응, 나고무 군이",
"설마 농담으로 그런 고약한",
"소리는 안 할 테니까」"
],
"14519": [
"「안 해요 안 해요」"
],
"14520": [
"「그런데 왜 나라는 걸",
"알았어?」"
],
"14521": [
"「저, 온실에 이상한 게",
"놓여 있었잖아요」"
],
"14522": [
"「그게 다음에 누구를 노리는지",
"가리키는 것 같아요」"
],
"14523": [
"「그게?」"
],
"14524": [
"「...음, 나로서는 그게,",
"어떤 식으로 나를 암시하는 건지",
"모르겠는데...」"
],
"14525": [
"「직접 나스 씨를",
"암시하는 건 아니에요」"
],
"14526": [
"「? 무슨 뜻이야?」"
],
"14527": [
"「나스 씨가 아니라",
"나스 씨의 배역을",
"암시하는 것 같아요」"
],
"14528": [
"「배역이라면, 지금 이 『나스』 역?」"
],
"14529": [
"「그래도 대본은 도입부밖에 없어서",
"어떤 역인지 잘 모르는",
"상태인데...」"
],
"14530": [
"「네, 뭐, 그렇긴 한데요」"
],
"14531": [
"「흐음...?",
"응, 뭐 잘 모르겠지만",
"아무튼 위험하다는 거지」"
],
"14532": [
"「알았어, 조심할게.",
"일부러 고마워」"
],
"14533": [
"왠지 영 위기감을",
"못 느끼시는 것 같은데..."
],
"14534": [
"「검은 고양이가 마다라이 씨가 나오는",
"『검은 고양이의 독』이라는 작품을",
"암시했던 것처럼...」"
],
"14535": [
"「아아, 그럼 나도 책이야?」"
],
"14536": [
"「네, 맞아요.",
"나스 씨 건 음...」"
],
"14537": [
"수첩을 펼쳐 오늘 날짜에 적어 둔",
"책 제목을 본다."
],
"14538": [
"「응? 이거?」"
],
"14539": [
"나스 씨가 옆에서 수첩을 들여다보며",
"고개를 갸웃한다."
],
"14540": [
"「네, 그런데요...」"
],
"14541": [
"「...흐음?",
"왠지 나로서는 왜 이건지",
"잘 모르겠는데...」"
],
"14542": [
"「뭐 됐어.",
"위험하다는 건 알았으니까",
"일단 조심할게」"
],
"14543": [
"「일부러 고마워」"
],
"14544": [
"「...『호숫가의 저택』인가.",
"나랑 같은 이름의 사람이 나오는 얘기지」"
],
"14545": [
"「맞아요.",
"범인은 마다라이 씨 때처럼",
"온실에서 그걸 암시하고...」"
],
"14546": [
"「...현장도 이 책과 비슷한 상황으로",
"꾸미려고 할 것 같아요」"
],
"14547": [
"나스 씨는 감탄한 듯",
"고개를 끄덕이며 잠자코 들어 주었다."
],
"14548": [
"「허어... 그렇구나.",
"대단하다, 나고무 군은」"
],
"14549": [
"「그래도 괜찮을 거야」"
],
"14550": [
"「오늘 밤 범인이 와도 아마 방엔",
"못 들어올 테고, 들어와도",
"싸워서 이기면 되잖아?」"
],
"14551": [
"「그, 그건 그렇지만요」"
],
"14552": [
"「응, 그럼 괜찮아!",
"질 자신은 없으니까!」"
],
"14553": [
"...그런 문제, 인가.",
"아니, 뭔가 다른 것 같은데..."
],
"14554": [
"「그래도 고마워.",
"제대로 조심할게」"
],
"14555": [
"「어, 아, 아뇨」"
],
"14556": [
"「그럼 운동하던 중이었으니까...",
"아, 같이 할래?」"
],
"14557": [
"「아뇨! 사, 사양할게요!」"
],
"14558": [
"「그래?",
"하고 싶어지면 언제든",
"말해도 돼」"
],
"14559": [
"「네.....네」"
],
"14560": [
"믿어 주는 것 같긴 한데",
"괜찮을까..."
],
"14561": [
"（물리적으로는 안 질 것 같은",
"기분이 들지만...）"
],
"14562": [
"...범인이 정면으로 덤벼",
"올 것 같지도 않다."
],
"14563": [
"밤이 되면 다시 한 번",
"얘기해 볼까..."
],
"14564": [
"「저...",
"실은 오늘 노리는 건",
"나스 씨가 아닐까 해서...」"
],
"14565": [
"「응? 또 나야?」"
],
"14566": [
"「죄, 죄송해요!",
"그래도 틀림없다고 생각해요!」"
],
"14567": [
"「으음...",
"알았어, 조심할게」"
],
"14568": [
"「나고무 군도 조심해.",
"그럼 이만」"
],
"14569": [
"...왠지 영",
"진지하게 안 받아들이는 것 같다."
],
"14570": [
"（괜찮을까...）"
],
"14571": [
"나스 씨라면 웬만한 상대에겐",
"안 지겠지만..."
],
"14572": [
"「...전에도",
"그렇게 말하지 않았어?」"
],
"14573": [
"「네, 네!",
"죄송해요, 전에 건, 그게...」"
],
"14574": [
"「으음...",
"뭐, 일단 조심할게」"
],
"14575": [
"「그럼 나고무 군도",
"조심해」"
],
"14576": [
"...역시 안 믿어 주는",
"것 같다..."
],
"14577": [
"「...비가 도무지",
"그치질 않네요」"
],
"14578": [
"「으음, 곤란하네.",
"달리기도 못 나가고」"
],
"14579": [
"곤란한 포인트가 뭔가 다르다..."
],
"14580": [
"「산사태는 상당히 심한",
"상태였어요?」"
],
"14581": [
"「응, 넘어가는 건",
"역시 무리일 것 같았어」"
],
"14582": [
"「아, 저, 걸어서 돌아갈 수 있냐",
"그런 게 아니라요」"
],
"14583": [
"「아, 아니야?」"
],
"14584": [
"「그게 아니라, 이 근처까지",
"피해가 번지거나",
"하지 않을까 해서요...」"
],
"14585": [
"「이 근처는 괜찮지 않을까.",
"꽤 떨어져 있었으니까」"
],
"14586": [
"그것만은 안심해도 될까.",
"하지만 복구가 돼야 할 텐데..."
],
"14587": [
"「나스 씨, 온실에 불이",
"켜져 있던 거 알아채셨어요?」"
],
"14588": [
"「아니, 그게 손가락 팔굽혀펴기",
"중이라 전혀 몰랐어」"
],
"14589": [
"「...손가락...」"
],
"14590": [
"「몰라?",
"음, 이렇게 해서...」"
],
"14591": [
"「아, 아뇨!",
"하는 법은 알아요!」"
],
"14592": [
"「그래? 그건 시작하면",
"집중해 버려서 불러도",
"모를 때가 있거든」"
],
"14593": [
"「저...",
"계속 여장한 채로 지내는 건",
"꽤 힘들겠죠...?」"
],
