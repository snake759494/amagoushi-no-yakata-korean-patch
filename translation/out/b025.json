{
"13095": [
"「...저기, 정말",
"말씀드리기 어렵지만...」"
],
"13096": [
"「저, 그 드라마 전부 봤어요.",
"그런데... 그게... 마다라이 씨가",
"어디 나왔는지 기억이 안 나서...」"
],
"13097": [
"「...그러세요?」"
],
"13098": [
"「하지만 그런 걸 본인에게",
"도저히 여쭤볼 수는 없잖아요?」"
],
"13099": [
"「그렇죠...」"
],
"13100": [
"물어보면 분명 충격을 받아",
"날뛸 것 같은 기분이...."
],
"13101": [
"「『마작 지옥 전설』이라는",
"비디오 영화 아세요?」"
],
"13102": [
"「글쎄요...",
"제목만은...」"
],
"13103": [
"「마작은 잘 몰라서",
"본 적은 없어요」"
],
"13104": [
"「다카토 씨가 쓴 이야기 중",
"『백사 살인 사건』이라는 거",
"아세요?」"
],
"13105": [
"「죄송해요, 잘 모르겠네요.",
"어떤 이야기인가요?」"
],
"13106": [
"「나구모 씨라는 이름의 사람이",
"나오는 것 같더라고요」"
],
"13107": [
"「어머, 그랬군요.",
"기억하지 못했네요」"
],
"13108": [
"「아메후라시 전기라는",
"게임 모르세요?」"
],
"13109": [
"「게임이요?",
"죄송해요, 저는 게임은",
"전혀 몰라서요」"
],
"13110": [
"「새벽의 하얀 장미라는",
"드라마 아세요?」"
],
"13111": [
"「네, 자주 봤어요」"
],
"13112": [
"「그런데 분명 도중에",
"조기 종영됐었던가요?」"
],
"13113": [
"「조기 종영?」"
],
"13114": [
"「네, 그런 소문을",
"들었는데요」"
],
"13115": [
"「...실제로 어떻게 끝났는지",
"본 기억이 없기도 하고요」"
],
"13116": [
"「이 저택 꽤 오래돼 보이죠」"
],
"13117": [
"「네, 운치 있고 멋져요」"
],
"13118": [
"「...좀 무섭지 않으세요?」"
],
"13119": [
"「후후, 밤에 혼자 복도를 걷는 건",
"조금 용기가 필요하네요」"
],
"13120": [
"「저, 식당 문을 잠근 뒤에",
"들어가 보신 적 있어요?」"
],
"13121": [
"「네에!?",
"설마, 그런...」"
],
"13122": [
"「무서워서 부엌을 쓸 때도",
"그 문에는 되도록 가까이",
"가지 않으려고 하는데요」"
],
"13123": [
"...나랑 똑같다."
],
"13124": [
"「오락실도 잠가 버렸는데",
"그 뒤로 들어가 보신 적 있어요?」"
],
"13125": [
"「아뇨, 저는 없는데요.",
"무슨 일 있었나요?」"
],
"13126": [
"「아뇨, 그런 건 아니고」"
],
"13127": [
"「...이제 아무 일도",
"없으면 좋겠는데요」"
],
"13128": [
"「저, 뒤뜰 우물... 말인데요」"
],
"13129": [
"「네, 저, 또 무슨 일이...?」"
],
"13130": [
"「아뇨, 무슨 일이 있던 건 아니고",
"열어 보신다거나 하는...」"
],
"13131": [
"「어머, 그런 짓 안 해요!",
"왜냐면... 아직...」"
],
"13132": [
"「...거기 계시잖아요?」"
],
"13133": [
"「미사사기 씨 방에는 베란다가",
"있네요」"
],
"13134": [
"「네? 아, 그렇네요.",
"비가 세고 창문도 연 적이 없어서",
"별로 신경 안 썼어요」"
],
"13135": [
"「그렇겠네요,",
"이 날씨로는...」"
],
"13136": [
"「이치야나기 씨 방에는",
"없나요?」"
],
"13137": [
"「없어요.",
"베란다는 이쪽 방에만",
"있는 것 같더라고요」"
],
"13138": [
"「어머, 그랬군요」"
],
"13139": [
"뭐, 있어도 이 비라면 어차피",
"나도 안 나가겠지만."
],
"13140": [
"「거실 밖에 있는 테라스",
"멋지네요」"
],
"13141": [
"「네, 외국 집 같아요」"
],
"13142": [
"「...음, 저기...",
"이 집은 원래 서양식 저택이라는",
"거 아니었나...」"
],
"13143": [
"「네? 어머?",
"아, 그렇네요, 애초에",
"외국식 집이었죠」"
],
"13144": [
"「아, 저기...",
"분명 맑은 날이면 기분 좋은",
"곳이겠네요, 거기는」"
],
"13145": [
"「미사사기 씨는 이 소동이 나기",
"전에 온실에 가 보셨어요?」"
],
"13146": [
"「네, 낮 동안에...",
"집 안을 한 번 둘러보게 해 주셔서",
"온실에도 가 봤어요」"
],
"13147": [
"「화분이 저렇게 많으면 손질이",
"힘들겠어요」"
],
"13148": [
"「아, 하지만 정원도 넓으니",
"정원사 분이 하시는 걸까요」"
],
"13149": [
"「정원사요?」"
],
"13150": [
"「보통 계시잖아요?」"
],
"13151": [
"「...그렇네요.",
"이렇게 넓은 정원이면...」"
],
"13152": [
"그런가, 전문가가 돌보는 건지도",
"모르겠다."
],
"13153": [
"「미사사기 씨는 부엌을",
"자주 쓰시네요」"
],
"13154": [
"「네, 넓어서 아주",
"쓰기 편해요」"
],
"13155": [
"「이런 소동만 아니었다면",
"더 즐거웠을 텐데요...」"
],
"13156": [
"「응접실에 들어가 보셨어요?」"
],
"13157": [
"「응접실... 이라면, 음,",
"아, 있었어요.",
"첫날에 딱 한 번」"
],
"13158": [
"「방이 많으면",
"외우기 힘드네요」"
],
"13159": [
"「그런 것 같네요.",
"자세히 보진 않았지만요」"
],
"13160": [
"「뭔가 트럼프라든가",
"체스라든가 여러 가지 있어요」"
],
"13161": [
"「...저, 카드 게임은",
"서툴러서... 잘 안 해요」"
],
"13162": [
"「아, 저도요.",
"금방 얼굴에 드러나서요」"
],
"13163": [
"「어머, 그래요?",
"후후, 이치야나기 씨는 솔직하셔서",
"알기 쉽네요」"
],
"13164": [
"「...그런가 봐요」"
],
"13165": [
"「저는 규칙을 못 외우겠어요.",
"그, 가끔 다른 게임 규칙이랑",
"헷갈려서 모르게 되거나...」"
],
"13166": [
"「그치만 게임에 따라",
"13이 제일 세거나 2가 세거나",
"달라지잖아요?」"
],
"13167": [
"「아... 그렇죠」"
],
"13168": [
"「전부 똑같이 해 주면",
"저도 할 수 있을 텐데」"
],
"13169": [
"그건 그것대로 큰일이",
"날 것 같은데...."
],
"13170": [
"「여기 서재는",
"책이 엄청 많죠」"
],
"13171": [
"「정말 그래요.",
"살짝 들여다봤을 뿐이지만",
"굉장한 장서였어요」"
],
"13172": [
"「대부분 외국 책 같았어요」"
],
"13173": [
"「어머, 그래요?",
"이 댁 분은 꽤",
"박식하신가 보네요」"
],
"13174": [
"「그런 것 같아요」"
],
"13175": [
"「이 저택, 창고도",
"많이 있죠」"
],
"13176": [
"「어머, 그래요?」"
],
"13177": [
"「모르셨어요?」"
],
"13178": [
"「네, 안내해 주셨을 때도",
"역시 창고까지는",
"보여 주지 않으셨으니까요...」"
],
"13179": [
"「그야, 그렇겠네요...」"
],
"13180": [
"「미사사기 씨 방은 원래",
"객실인가요?」"
],
"13181": [
"「네, 집사분이",
"그렇게 말씀하셨어요」"
],
"13182": [
"「츠바키 군이요?」"
],
"13183": [
"「안내해 주셨을 때요.",
"객실이니 편하게 쓰시라고",
"말씀해 주셨어요」"
],
"13184": [
"「보통 호텔보다 넓어서",
"쓰기 편하네요」"
],
"13185": [
"「아, 그래요?」"
],
"13186": [
"「2층에 뭔가 하나만",
"다른 방이 있죠」"
],
"13187": [
"「혹시 열쇠 선반에",
"'열리지 않는 방'이라고 적힌",
"방 말인가요?」"
],
"13188": [
"「아, 맞아요.",
"열리지 않는다면서 멀쩡히",
"열쇠가 놓여 있지만...」"
],
"13189": [
"「그러고 보니 그렇네요.",
"츠바키 씨는 들어가면 안 된다고",
"하셨던 것 같은데」"
],
"13190": [
"「...그런데",
"왜 열리지 않는 방일까요」"
],
"13191": [
"「봉인된, 열어서는",
"안 되는 방이라면",
"열쇠도 숨겨 둘 텐데요」"
],
"13192": [
"「봉인이라니, 저기,",
"왜 그런...」"
],
"13193": [
"「...저희 집에는 있었어요.",
"옛날에 그 방에서 불행하게",
"돌아가신 조상님이 계셨다나...」"
],
"13194": [
"미사사기 씨네 집은 대체...."
],
"13195": [
"「2층 안쪽에 헛간이 있죠」"
],
"13196": [
"「...아, 그러고 보니.",
"들여다보진 않았지만,",
"분명 안쪽에 있었네요」"
],
"13197": [
"「스즈나 씨 방",
"앞이었던가요?」"
],
"13198": [
"「그건...",
"역시 어릴 때 나쁜 짓을 하면",
"갇히거나 하는 걸까요」"
],
"13199": [
"「네, 그치만 벌이라면",
"어딘가에 가두는 거 아닌가...」"
],
"13200": [
"「...저희 집에서는",
"마당으로 쫓겨났어요」"
],
"13201": [
"「어머, 그랬군요.",
"집집마다 법도가 다르네요」"
],
"13202": [
"...법도, 인 걸까."
],
"13203": [
"「미사사기 씨는 지하실에",
"내려가 보신 적은... 아, 저기",
"이 소동이 나기 전에요」"
],
"13204": [
"「아뇨, 저는 없어요.",
"츠바키 씨께는 보일러랑 창고만",
"있다고 들었는데요」"
],
"13205": [
"「평범한 지하실이죠?」"
],
"13206": [
"「평, 평범이요?」"
],
"13207": [
"「원래 사설 감옥이었다든가,",
"그런 곳은 아니고...」"
],
"13208": [
"「아니에요 아니에요!」"
],
"13209": [
"「그래요? 다행이다.",
"저, 그 때문에 친정 지하에",
"내려가는 게 무서워서...」"
],
"13210": [
"「...네?」"
],
"13211": [
"「아뇨, 지금은 완전히",
"창고로 쓰여서 창살만",
"남아 있을 뿐이지만...」"
],
"13212": [
"「...역시 아주 옛날 여기서",
"옥사한 분이 있었다고 들으면",
"기분 나쁘잖아요」"
],
"13213": [
"「무, 무서워요, 그건 무서워요」"
],
"13214": [
"...랄까, 지하 감옥이 남은",
"친정이라니 너무 대단하다."
],
"13215": [
"「지하에요,",
"뭔가 미로 같은 게",
"있었어요」"
],
"13216": [
"「정말이에요.",
"꽤 깊어 보이는 게...」"
],
"13217": [
"「어머, 영화 같네요.",
"왠지 무서울 것 같지만...」"
],
"13218": [
"「그래서, 저기...",
"역시 족자 뒤로 들어가나요?」"
],
"13219": [
"「아뇨, 저기, 족자는",
"없었는데요」"
],
"13220": [
"이렇게 어딜 봐도 서양식 저택에",
"족자가 있으면, 숨길 것도",
"못 숨길 만큼 눈에 띄겠지...."
],
"13221": [
"「어머, 그래요.",
"저희 집에도 옛날에 도코노마에",
"있었던 모양인데요...」"
],
"13222": [
"「역시 족자 뒤였다고",
"하더라고요, 입구가」"
],
"13223": [
"「...음, 그거",
"지금은 없나요」"
],
"13224": [
"「밖에서도 들어올 수 있어서",
"위험하다고 메워 버렸대요」"
],
"13225": [
"「...그야 그렇겠네요」"
],
"13226": [
"그런데 대체 어떤 저택에서",
"자란 거야, 이 사람."
],
"13227": [
"「뒤뜰에 우물이 있죠」"
],
"13228": [
"「네, 있었죠.",
"온실 꽃에는 거기서 물을 길어",
"주는 걸까요」"
],
"13229": [
"「아, 그런데 뚜껑이 덮여 있어요」"
],
"13230": [
"「어머?",
"그럼 아닌 걸까요」"
],
"13231": [
"「...설마, 안은 우물이 아니라",
"비밀 통로가 있다든가...」"
],
"13232": [
"「아니, 저기, 비밀 통로라니」"
],
"13233": [
"「제 친척 집에는",
"옛날에 있었다던데요」"
],
"13234": [
"대체 어떤 친척인 거야...."
],
"13235": [
"「방 이름 말인데요,",
"이 저택의 방들이요?」"
],
"13236": [
"「츠바키 씨가, 방 이름은",
"전부 실존 작가 이름이라고",
"말씀하셨어요」"
],
"13237": [
"「저는 잘 몰라서",
"모르는 이름도 많지만",
"요...」"
],
"13238": [
"「히오리 씨나 시즈나 씨는",
"잘 아시는 것 같던데요」"
],
"13239": [
"「관심 있으시면",
"그분들께 물어보시는 게",
"어떨까요?」"
],
"13240": [
"「네, 감사합니다」"
],
"13241": [
"「...아, 저기」"
],
"13242": [
"「이치야나기 씨, 어젯밤...",
"제가 위험하다고",
"말씀하셨죠?」"
],
"13243": [
"「...기분 탓일지도",
"모르지만요...」"
],
"13244": [
"「네?",
"무슨 일 있었어요?」"
],
"13245": [
"「...아... 아뇨,",
"분명 기분 탓이에요」"
],
"13246": [
"「아뇨, 저기,",
"기분 탓이 아니면",
"큰일이니까요!」"
],
"13247": [
"「뭐든지,",
"무슨 일이 있었다면",
"알려 주세요!!」"
],
"13248": [
"「아, 기분 탓이라도",
"괜찮아요?」"
],
"13249": [
"「그러면 그런 대로 안심이고,",
"그, 신경 쓰지 마시고...」"
],
"13250": [
"「...화내지",
"않으실 거죠...?」"
],
"13251": [
"「네? 제가?",
"왜 화를 내요?」"
],
"13252": [
"「아, 저기, 딱히",
"화 안 내요」"
],
"13253": [
"「...저기,",
"혹시...」"
],
"13254": [
"「제가 노려지고 있다는 걸",
"우리가 눈치챘다고 범인이",
"알게 된다면...」"
],
"13255": [
"「처음 계획을 이미",
"바꿨을지도",
"모르지 않을까요?」"
],
"13256": [
"「아니, 하지만 저는 미사사기 씨가",
"위험하다고 미사사기 씨에게만",
"말했는데...」"
],
"13257": [
"「정말인가요...?」"
],
"13258": [
"「아, 저기, 의심하는 건",
"아니지만요...」"
],
"13259": [
"「정말이에요,",
"누가 범인인지 모르니까",
"말 안 했어요」"
],
"13260": [
"「미안해요,",
"이상한 소리를 해서」"
],
"13261": [
"「아, 아뇨, 괜찮아요」"
],
"13262": [
"「이치야나기 씨는 걱정해",
"주시는 건데...」"
],
"13263": [
"「신경 쓰지 마세요",
"그런 거, 왜냐면 저는,",
"저, 무서... 아니, 그게」"
],
"13264": [
"「...그렇네요.",
"무섭죠...」"
],
"13265": [
"「저도... 무서워요」"
],
"13266": [
"「어서...",
"전부 끝나면...」"
],
"13267": [
"「...그렇네요.",
"그러면 좋겠네요」"
],
"13268": [
"「아...",
"맞다, 이치야나기 씨」"
],
"13269": [
"「어젯밤, 제가 위험하다고",
"말씀하셨죠?",
"노려지고 있다고...」"
],
"13270": [
"「아, 네, 네」"
],
"13271": [
"「...그 이야기,",
"저 말고 다른 누구한테 하셨나요?」"
],
"13272": [
"「아뇨... 아,",
"생각할 때 옆에 있어서",
"히오리는 알고 있지만요」"
],
"13273": [
"「아, 아뇨,",
"아무것도 아니에요」"
],
"13274": [
"「그냥 왠지...",
"신경이 쓰였을 뿐이에요」"
],
"13275": [
"왜 그러지.",
"왜 신경이 쓰이는 걸까."
],
"13276": [
"（하지만 왠지...",
"억지로 캐묻는 것도 좀）"
],
"13277": [
"「...저기, 이치야나기 씨」"
],
"13278": [
"「어젯밤...",
"역시 제가 위험하다는",
"그 이야기...」"
],
"13279": [
"「저도 생각해 봤어요」"
],
"13280": [
"「이치야나기 씨가 맞는 것",
"같은 기분이 들었어요」"
],
"13281": [
"「하지만 역시 그건",
"범인에게 알려진 게",
"아닐까 해서...」"
],
"13282": [
"「실제로 제 주변에는",
"아무 수상한 일도",
"일어나지 않았잖아요」"
],
"13283": [
"「범인은 이치야나기 씨가 누구를",
"경계하는지 알고 있는 게",
"아닐까요?」"
],
"13284": [
"「저는 그렇게밖에",
"생각이 안 들어요...」"
],
"13285": [
"「그...",
"그렇다면...」"
],
"13286": [
"「...네.",
"당신이 누군가에게 경계를 권하는 게",
"무엇보다 위험할지도 몰라요」"
],
"13287": [
"「아, 저기, 너무 심각하게",
"생각하지 마세요?」"
],
"13288": [
"「제 착각일지도",
"모르고, 오히려",
"그러길 바라요」"
],
"13289": [
"「하지만 실제로...",
"저는 몇 번이나 미사사기 씨가 위험하다고",
"생각해서 그렇게 말하면...」"
],
"13290": [
"「...하지만 만약",
"그렇다면 범인은 대체",
"어떻게 아는 건지...」"
],
"13291": [
"「정말로 저 말고는",
"말한 기억이 없으신 거죠?」"
],
"13292": [
"「그럴 텐데요」"
],
"13293": [
"「저도 이런 이야기는",
"다른 사람에게 안 했어요」"
],
"13294": [
"어떻게 된 걸까.",
"만약 미사사기 씨 말대로라면",
"...."
],
"13295": [
"애초에 지금 추리의 전제부터",
"틀렸다는 얘기가 되는 건가...."
],
"13296": [
"「...미안해요,",
"오히려 고민하게 만들어서」"
],
"13297": [
"「아, 아뇨, 그런」"
],
"13298": [
"「분명 제가",
"너무 깊게 생각한 거예요.",
"신경 쓰지 마세요」"
],
"13299": [
"미사사기 씨가 걱정하는 것 같아",
"고개는 끄덕였지만...."
],
"13300": [
"...역시 마음에 걸린다."
],
"13301": [
"「저기, 이치야나기 씨...」"
],
"13302": [
"「제가 어젯밤 노려졌을",
"거라는 이야기...」"
],
"13303": [
"「만약 당신 말씀대로라면",
"무서운 일",
"아닌가요?」"
],
"13304": [
"「그렇잖아요?",
"만약 범인이 원래 노린",
"게 저라면...」"
],
"13305": [
"「...범인은 어째선지",
"그걸 알고 계획을 바꿨다는",
"게 되잖아요」"
],
"13306": [
"「걱정해 주시는 건",
"알아요... 하지만...」"
],
"13307": [
"「이제 입 밖에 내지",
"말아 주세요...」"
],
"13308": [
"「...저기」"
],
"13309": [
"「제가... 노려지고",
"있다고 말씀하셨던",
"그, 이야기...」"
],
"13310": [
"「...아뇨, 그만둬요.",
"싫은 생각만 들 뿐이니까요」"
],
"13311": [
"「싫은...?」"
],
"13312": [
"「미안해요,",
"잊어 주세요」"
],
"13313": [
"「...네, 네」"
],
"13314": [
"「이치야나기 씨...」"
],
"13315": [
"「아직도 제가 노려진다고",
"생각하세요...?」"
],
"13316": [
"「아, 저기」"
],
"13317": [
"「...이제 말하지 마세요.",
"저, 왠지...」"
],
"13318": [
"「돌아가시는 분들이",
"제 대신 희생되는 것 같은",
"기분이 들어서...」"
],
"13319": [
"「저, 지하실에 있던",
"궤짝 말인데요...」"
],
"13320": [
"「네, 저...",
"츠바키 씨의...?」"
],
"13321": [
"「그건...",
"원래 거기 있었던 걸까요",
"저는 잘 모르지만요」"
],
"13322": [
"「나스 씨가 마셔 버린 차",
"말인데요, 그거...」"
],
"13323": [
"「아...",
"그건 녹차 쪽이었죠」"
],
"13324": [
"「...저도 같은 걸",
"마셨는데요」"
],
"13325": [
"「네, 하지만",
"보시다시피 무사해요」"
],
"13326": [
"역시 범인은 반드시 나스 씨가",
"마실 걸 아는 상태에서 독을",
"넣은 거겠지...."
],
"13327": [
"「...저, 독극물 말인데...」"
],
"13328": [
"「네...",
"그, 나, 나스 씨의...?」"
],
"13329": [
"「...이런... 이런 말",
"하면 나스 씨에게 죄송할지도",
"모르지만...」"
],
"13330": [
"「다른 음식은...",
"괜찮은 걸까요...?」"
],
"13331": [
"「...아, 아마도요.",
"범인이 모두에게 독을 먹일 거면",
"진작 했을 것 같아요」"
],
"13332": [
"「조심해서 나쁠 건",
"없겠지만요...」"
],
"13333": [
"범인은 차례로 한 명씩 노리지만",
"다음 표적이 독살이 아니라는",
"보장은 없으니까...."
],
"13334": [
"「쿠라이시 씨 방에...",
"장미 그림이 놓여 있었는데요」"
],
"13335": [
"「네...?",
"놓여 있었다니, 방에 원래",
"걸려 있던 게 아니라요?」"
],
"13336": [
"「네, 벽에 걸린 건",
"전혀 다른 그림이었어요」"
],
"13337": [
"「그럼 그... 그림도,",
"저, 범인이 일부러...?」"
],
"13338": [
"「그런 것 같아요」"
],
"13339": [
"「...어디 있던 걸까요」"
],
"13340": [
"「응접실인 것 같아요」"
],
"13341": [
"「어머, 그렇군요」"
],
"13342": [
"「여기는 그림이 많이 걸려",
"있어서 어디에 뭐가 있었는지는",
"기억 못 했어요」"
],
"13343": [
"「쿠라이시 씨...",
"화살에 맞은 것 같아요」"
],
"13344": [
"「화살...?",
"화살이라니, 그 활과 화살?」"
],
"13345": [
"「그런 것까지 가지고 들어왔다니",
"...무서워...」"
],
"13346": [
"「저...",
"커다란 도끼 말인데...」"
],
"13347": [
"「...아, 그건, 저...",
"저, 장식품인 줄만...」"
],
"13348": [
"「저, 저도요」"
],
"13349": [
"「그, 그만해요...",
"이 이야기는 이제...」"
],
"13350": [
"「그 도끼 말인데...」"
],
"13351": [
"「...저, 저런 게",
"대체 어디에...」"
],
"13352": [
"「그 커다란 테루테루보즈,",
"효과가 있으면 좋겠네요」"
],
"13353": [
"「아, 거실 테라스에 있는",
"커다란 거요?」"
],
"13354": [
"「네, 좀 너무 큰",
"것 같긴 하지만...」"
],
"13355": [
"「그건 누가",
"매달아 주셨나요?」"
],
"13356": [
"「어머, 나스 씨답네요.",
"언제 만드셨을까요」"
],
"13357": [
"「아침에 거실에 와 보니 뭔가 큰",
"그림자가 흔들려서 놀랐어요」"
],
"13358": [
"「하하, 그렇죠.",
"한밤중엔 놀란 츠바키 군한테",
"혼났다던데요」"
],
"13359": [
"「그랬어요?",
"츠바키 씨가 화를 내다니,",
"어지간히 놀라셨나 봐요」"
],
"13360": [
"...뭐, 츠바키 군은 다른 일로도",
"자주 나스 씨를 혼내지만."
],
"13361": [
"「저, 온실의...",
"『복수』라고 적힌 종이 말인데요」"
],
"13362": [
"「...그건...",
"대체 언제...」"
],
"13363": [
"「미사사기 씨네가 낮에 왔을 땐",
"물론 없었죠?」"
],
"13364": [
"「없었어요.",
"저택 안을 한 번 둘러봤는데",
"그때는 아무것도...」"
],
"13365": [
"「온실에 놓인 고양이 장식품",
"말인데요...」"
],
"13366": [
"「...처음에 시즈나 씨가",
"『고양이는 마다라이 씨』라고",
"하셨잖아요...?」"
],
"13367": [
"「아, 네」"
],
"13368": [
"「...설마 정말 관계가 있을",
"줄은... 몰랐어요...」"
],
"13369": [
"「그치만 검은 고양이는 그것만으로",
"왠지 불길함을 상징하는 거",
"아닌가요...?」"
],
"13370": [
"「그렇죠....",
"옆에 복수라고 적혀 있었고」"
],
"13371": [
"「네, 그러니까...",
"설마 책과 관계가 있을 줄은」"
],
"13372": [
"「여기 내선 전화",
"써 보셨어요?」"
],
"13373": [
"「아뇨, 저는 없어요.",
"처음엔 내선이라는 것도",
"몰랐어요...」"
],
"13374": [
"「인터폰인 줄",
"알았어요」"
],
"13375": [
"「...음,",
"현관에 온 사람이랑 말하는 거요?」"
],
"13376": [
"「네, 맞아요.",
"왜 방마다 있는 걸까 하고",
"이상하게 생각했어요」"
],
"13377": [
"...그야 이상했겠지."
],
"13378": [
"「오락실 라디오,",
"잡음이 좀 더 적으면",
"좋을 텐데요」"
],
"13379": [
"「그렇네요....",
"그래도 라디오라도 되니",
"다행이지 않아요?」"
],
"13380": [
"「그것도 그렇네요」"
],
"13381": [
"「1층 홀에 있는 큰 시계",
"대단하죠」"
],
"13382": [
"「네, 정말요.",
"언제쯤 물건일까요?」"
],
"13383": [
"「상당히 오래돼 보여요」"
],
"13384": [
"「골동품이겠죠.",
"멋져요」"
],
"13385": [
"「하지만 그건 이 정도로 큰",
"집이 아니면 못 두겠네요...」"
],
"13386": [
"「그렇네요.",
"친정이라면 어떻게든...」"
],
"13387": [
"「둘 수 있어요!?」"
],
"13388": [
"「네, 하지만 할아버님께서",
"서양 골동품은 별로 안",
"좋아하셔서...」"
],
"13389": [
"그렇다는 건, 일본 골동품은",
"잔뜩 있다는 걸까...."
],
"13390": [
"「온실에 놓여 있던",
"종 말인데요...」"
],
"13391": [
"「아, 그...」"
],
"13392": [
"「그건 무슨 종일까요?",
"금속은 아닌 것 같던데요」"
],
"13393": [
"「장난감 같죠」"
],
"13394": [
"「어머, 장난감이에요?",
"어린이용일까요...」"
],
"13395": [
"...뭔가 아닌 것 같은데."
],
"13396": [
"「온실에 큰 못이",
"있었죠」"
],
"13397": [
"「대못이라는",
"거죠」"
],
"13398": [
"「왠지 기분이",
"나쁘네요」"
],
"13399": [
"「온실에 하얀 장갑이",
"놓여 있었어요」"
],
"13400": [
"「장갑이요?」"
],
"13401": [
"「네, 저, 길고 뭔가",
"화려한 느낌의 하늘하늘한...」"
],
"13402": [
"「? 왜 그러세요?」"
],
"13403": [
"「예복용 긴 장갑이죠?",
"저, 비슷한 걸 몇 개 갖고",
"있어서요...」"
],
"13404": [
"「싫다, 이제 무서워서",
"못 쓸 것 같아요...」"
],
"13405": [
"「온실에 이번엔 손도끼가",
"놓여 있어서...」"
],
"13406": [
"「손도끼?",
"어머, 무서워...」"
],
"13407": [
"「그건 대체 무슨 의미",
"일까요...?」"
],
"13408": [
"「확실히는 모르지만",
"아마 또 예고가 아닐까 해요」"
],
"13409": [
"「...그렇군요.",
"하지만 도끼라니...」"
],
"13410": [
"「왠지 싫네요,",
"그... 지금까지 물건보다",
"구체적인 느낌이라...」"
],
"13411": [
"그대로 흉기가 될 법한 물건이라",
"직접적인 느낌이 든다...."
],
"13412": [
"「온실에 이번엔 울타리가 있었어요.",
"뭔가, 이만한 소형...」"
],
"13413": [
"「울타리요...?」"
],
"13414": [
"「어디에 쓰는 건지",
"잘 모르겠는데요」"
],
"13415": [
"「...그 크기라면",
"원예용 같은 게",
"아닐까 싶은데요」"
],
"13416": [
"「원예요?」"
],
"13417": [
"「네, 화단을 나누거나 하는",
"물건 아닐까요?」"
],
"13418": [
"「그렇구나, 그렇네요」"
],
"13419": [
"「저, 나스 씨가 가져온",
"덤벨 말인데요...」"
],
"13420": [
"「...덤벨?」"
],
"13421": [
"「네, 집에서 일부러",
"가져왔다나 봐요」"
],
"13422": [
"（...?",
"어이없어하는 건가...）"
],
"13423": [
"「...저기...",
"덤벨이 뭔가요?」"
],
"13424": [
"「네? 뭐라고요?」"
],
"13425": [
"「먹는 건 아니겠죠?",
"음... 나스 씨가 일부러 집에서",
"가져오는 거라면...」"
],
"13426": [
"「...아, 혹시 그,",
"서플리먼트라는 약 같은",
"것의 일종인가요?」"
],
"13427": [
"「...아뇨, 머, 먹을 수 없어요」"
],
"13428": [
"「아니었어요?",
"어머, 저는 당연히...」"
],
"13429": [
"「...저, 그래서,",
"덤벨이란...」"
],
"13430": [
"「음, 저기, 몸을 단련하기",
"위한 추랄까, 그...」"
],
"13431": [
"「앗!",
"알겠어요, 쇠막대 끝에",
"동그란 게 달린 그거죠?」"
],
"13432": [
"「그게 덤벨이라는",
"이름이었군요」"
],
"13433": [
"「속이 시원해졌어요.",
"고마워요」"
],
"13434": [
"「마다라이 씨 방에 이상한",
"모양 지팡이가 있던 거 아세요?」"
],
"13435": [
"「지팡이요?",
"게다가 이상한 모양?」"
],
"13436": [
"「네, 뭔가 이렇게...",
"마법사 할아버지가 들고 있는",
"것 같은 구불구불한 모양의」"
],
"13437": [
"「마법사... 음, 그건",
"석장이 아니라...?」"
],
"13438": [
"「석장이랑은 다를 거예요」"
],
"13439": [
"「미안해요, 저는 왠지",
"모양이 떠오르지 않네요」"
],
"13440": [
"아느냐 모르느냐 이전의",
"문제였던 것 같다...."
],
"13441": [
"「이 저택엔 그림이 꽤",
"많이 걸려 있네요」"
],
"13442": [
"「그렇네요.",
"모든 방에 있는 것 같아요」"
],
"13443": [
"「저택 주인이",
"수집하는 걸까요」"
],
"13444": [
"「그럴지도 몰라요.",
"그림은 벽에 걸어 두면 자리를",
"차지하지 않아서 좋죠」"
],
"13445": [
"「저희 할아버님은",
"청자 항아리를 좋아하셔서...」"
],
"13446": [
"...잘은 모르지만 그 항아리가",
"엄청 유명하고 비싼 건 알겠다..."
],
"13447": [
"「주차장에 있는 건 나스 씨랑",
"마다라이 씨 차였던가요」"
],
"13448": [
"「네, 분명 그랬어요」"
],
"13449": [
"「저는 사무소에서",
"데려다 주셨고,",
"다른 분들은 택시겠죠」"
],
"13450": [
"「펑크가 나 버려서",
"안됐네요...」"
],
"13451": [
"「...네.",
"심한 짓을 하는 사람이",
"다 있네요」"
],
"13452": [
"「하지만...",
"대체 누가 펑크를 내고 어디로",
"도망친 걸까요...」"
],
"13453": [
"그게 제일 문제란 말이지."
],
"13454": [
"「실은 지하에 뱀이",
"잔뜩 있었어요...」"
],
"13455": [
"「네...",
"저, 저기, 그게... 위층까지",
"올라오거나 하진...」"
],
"13456": [
"「그, 그건 없을 거라고...",
"저도 믿고 싶어요」"
],
"13457": [
"「...곤란해요.",
"저, 파충류는 전부 질색이라...」"
],
"13458": [
"「저도... 못 참아요」"
],
"13459": [
"「지하에서 안 나오면",
"좋겠네요...」"
],
"13460": [
"「미사사기 씨는 컵라면 같은 건",
"별로 안 드세요?」"
],
"13461": [
"「아, 저는... 그게...」"
],
"13462": [
"「그거, 어떻게",
"만드는 건지",
"몰라서...」"
],
"13463": [
"「저기, 뭔가 뜨거운 물을 붓는다는",
"건 알고 있어요?」"
],
"13464": [
"「촬영장에서 스태프가 먹는 걸",
"몇 번 본 적도 있고요」"
],
"13465": [
"「...음,",
"그럼 왜 모르시는...」"
],
"13466": [
"「저, 그러니까...",
"물을 부은 다음 어떻게...?」"
],
"13467": [
"「저, 늘 중요한 부분을 놓치는",
"것 같아서, 정신 차려 보면 다들",
"벌써 뚜껑 열고 먹고 있어요」"
],
"13468": [
"「...그, 그야...」"
],
"13469": [
"「그래서 물을 붓고 나서 완성될",
"때까지의 과정이 수수께끼예요」"
],
"13470": [
"「뭘 어떻게 하면 냄비도 양념도",
"안 쓰고 완성되는 건가요?」"
],
"13471": [
"「가끔 어느새 떡이나 유부가",
"들어 있어서 깜짝 놀라요.",
"신기하죠...」"
],
"13472": [
"아무래도 인스턴트 식품이라는",
"개념 자체를 모르는 모양이다...."
],
"13473": [
"「...저, 이치야나기 씨는",
"그거 만들 줄 아세요?」"
],
"13474": [
"「네, 물론이죠」"
],
"13475": [
"「어떻게 하세요?",
"그, 촬영장에선 이제 와서 묻기",
"부끄러워서...」"
],
"13476": [
"「음...",
"그러니까, 물만 부으면 돼요」"
],
"13477": [
"「.........네?」"
],
"13478": [
"「뚜껑을 열고 안에 든 작은 봉지를",
"꺼내서, 먼저 넣으라고 적힌",
"건 뜯어서 넣고...」"
],
"13479": [
"「...나머진 물을 붓고",
"정해진 몇 분 기다리면 끝이에요」"
],
"13480": [
"「저기... 무슨 뜻인지...",
"잘 모르겠는데요...」"
],
"13481": [
"「그, 그러니까 정말로",
"물을 부은 다음엔 아무것도",
"안 해도 된다니까요」"
],
"13482": [
"「...아, 아무것도?",
"젓는다거나...」"
],
"13483": [
"「하면 안 돼요.",
"3분이나 4분이나, 정해진 시간",
"뚜껑 열지 말고 기다리면 돼요」"
],
"13484": [
"「...그런가요...?」"
],
"13485": [
"엄청난 기세로 멍해져 있다....",
"미사사기 씨에게는 상상도",
"못 해 본 이야기겠지...."
],
"13486": [
"「...그건...",
"그, 무섭지 않나요?」"
],
"13487": [
"「네? 왜, 왜요...?」"
],
"13488": [
"「그치만 물을 붓고 기다리는 동안",
"이 안에서 대체 무슨 일이 일어날까",
"하고 생각하지 않으세요...?」"
],
"13489": [
"「...아, 아뇨,",
"생각해 본 적 없어요...」"
],
"13490": [
"「...저는",
"먹을 수 있게 되기까지",
"용기가 필요할 것 같네요...」"
],
"13491": [
"미사사기 씨 머릿속에선 컵라면 안에서",
"무슨 일이 일어나는 걸까...."
],
"13492": [
"「실은 창고 안에",
"석궁이 들어 있어서...」"
],
"13493": [
"「석궁?",
"석궁이라면 그, 활 같은?」"
],
"13494": [
"「어머...",
"그거, 쓸 수 있는 걸까요...」"
],
"13495": [
"「모르겠어요.",
"뭔가 액자 같은 데 들어 있어서",
"장식일지도...」"
],
"13496": [
"「...그러면 좋겠네요」"
],
"13497": [
"「복도에 뭔가 내다 놓은",
"가구가 있잖아요」"
],
"13498": [
"「아, 그러고 보니...",
"어느새 있었네요」"
],
"13499": [
"「왜 저런 데 두는 걸까",
"생각했었는데요」"
],
"13500": [
"「그거, 나스 씨가",
"한 짓이래요」"
],
"13501": [
"「나스 씨가?」"
],
"13502": [
"「...음, 저기,",
"개성적인 배치네요」"
],
"13503": [
"「아니, 저기, 자기가 가져온",
"운동 기구를 놓는 데",
"방해돼서 내놓은 것 같은데요」"
],
"13504": [
"「어, 어머? 그래요?",
"싫다, 저 또",
"지레짐작해서...」"
],
"13505": [
"「꽤 특이한",
"취미인가 했어요...」"
],
"13506": [
"어떤 취미라는 거야...."
],
"13507": [
"「수면제는 예전부터",
"드셨어요?」"
],
"13508": [
"「아뇨, 예전엔 그렇지도",
"않았는데요...」"
],
"13509": [
"「요즘 왠지 잠이 안 와서",
"병원에 갔더니 처방해 주셨어요.",
"불면증이 생긴 것 같아서요」"
],
"13510": [
"「그렇군요....",
"힘드시겠네요」"
],
"13511": [
"「네...",
"어쩔 수 없죠, 이 나이가 되면",
"여러 가지 있답니다」"
],
"13512": [
"미사사기 씨, 겉보기엔 아직",
"젊어 보이는데...."
],
"13513": [
"「저, 이상한 걸 묻는데요",
"이거 마리모 맞죠」"
],
"13514": [
"「어머, 귀여워라」"
],
"13515": [
"「...귀여운가요」"
],
"13516": [
"「네, 귀엽잖아요.",
"오래 키우면 따르기도",
"하려나요」"
],
"13517": [
"「글, 글쎄요...」"
],
"13518": [
"그 정도 지능이 있을까.",
"부르면 다가와서 비비거나 하면",
"좀 귀여울지도...."
],
"13519": [
"「저, 미사사기 씨...",
"붉은 카메오 아세요?」"
],
"13520": [
"「카메오...",
"아, 들어 본 적은 있어요」"
],
"13521": [
"「있으세요?",
"역시 연예계에선 유명한",
"이야기군요...」"
],
"13522": [
"「네, 분명 어느",
"방송국의 행운의 상징",
"같은 거죠?」"
],
"13523": [
"「네?",
"아, 저기... 제가 들은 이야기랑",
"뭔가 다른 것 같은데...」"
],
"13524": [
"「제가 들은 바로는 붉은 카메오는",
"스타가 될 수 있는 증표라던데요」"
],
"13525": [
"「오...?",
"그런 이야기도 있군요」"
],
"13526": [
"그럼 내가 쿠라이시 씨한테 들은 거랑은",
"전혀 다른 물건이겠지...."
],
"13527": [
"「온실 안쪽에 이런 테이프가",
"있었어요」"
],
"13528": [
"「어머...",
"왜 온실에 카세트테이프가?」"
],
"13529": [
"「유리 깨지는 소리가",
"녹음돼 있었어요」"
],
"13530": [
"「유리?",
"무슨 효과음일까요...?",
"꽃 성장에 좋을 것 같진 않은데」"
],
"13531": [
"「아, 저기...",
"그러니까 첫날 밤에 우리가 들은",
"그게 아닐까 해서...」"
],
"13532": [
"「...아아!",
"그래서 어느 창문도 깨지지",
"않았던 거군요」"
],
"13533": [
"「저, 창고에 화살만 없어진",
"석궁이 있었는데요...」"
],
"13534": [
"「네에...?",
"그거, 저기... 설마 뭔가에",
"쓰인 걸까요...?」"
],
"13535": [
"「모르겠어요...",
"아직 거기까지는」"
],
"13536": [
"「...처음부터 없었던",
"거라면 좋겠는데요」"
],
"13537": [
"「나쁜 일에 쓰인 게",
"아니면 좋겠네요...」"
],
"13538": [
"「창고에...",
"화살이 없어진 석궁이 있었어요」"
],
"13539": [
"「그, 런가요...",
"그럼 쿠라이시 씨는...」"
],
"13540": [
"「...네, 아마」"
],
"13541": [
"미사사기 씨는 비통한 얼굴로",
"고개를 숙여 버렸다...."
],
"13542": [
"「저, 이거...",
"본 기억 없으세요?」"
],
"13543": [
"「쿠라이시 씨 것이었던",
"것 같은데요...」"
],
"13544": [
"「...역시 그렇군요」"
],
"13545": [
"「저, 그건 어디에?」"
],
"13546": [
"「뒤뜰이요.",
"쿠라이시 씨 방 바로",
"아래쯤에 떨어져 있었어요」"
],
"13547": [
"「어머...",
"그럼 창문에서 떨어뜨린 걸까요」"
],
"13548": [
"「...그럴지도 모르지만,",
"하지만 언제 떨어진 건지...」"
],
"13549": [
"「그렇네요...」"
],
"13550": [
"「저, 이게 뭔지",
"아세요?」"
],
"13551": [
"「뭘까요...",
"원예에 쓰는 건가...?」"
],
"13552": [
"「말뚝 같으니까",
"그걸로 울타리라도 만드나",
"생각했는데요」"
],
"13553": [
"「아, 그러고 보니...",
"그런데 뭔가 길이가",
"제각각이지 않아요?」"
],
"13554": [
"「손으로 만든 거 아닐까요?」"
],
"13555": [
"「그럴까요...」"
],
"13556": [
"좀 손재주 없는 사람이",
"만든 건가."
],
"13557": [
"「응접실에 이상한 가면이",
"걸려 있네요」"
],
"13558": [
"「...아, 있죠.",
"좀 무서운 느낌 들지 않아요?」"
],
"13559": [
"「들었어요.",
"뭔가, 그... 섬뜩한」"
],
"13560": [
"「그렇죠....",
"손님을 맞이하는 방에",
"저런 게 괜찮을까요」"
],
"13561": [
"「저도...",
"그건 좀 아닌 것 같은데요」"
],
"13562": [
"「음, 저기... 하지만...",
"이 댁 분은 아주 훌륭한",
"예술이라 생각하실지도...」"
],
"13563": [
"「그, 그렇죠.",
"사람 취향은 제각각이니」"
],
"13564": [
"「익숙해지면 분명...",
"조금 귀여울지도 몰라요」"
],
"13565": [
"「...꽤 시간이",
"걸릴 것 같지만요...」"
],
"13566": [
"「오락실 라디오의",
"데크에 이게 들어 있어서...」"
],
"13567": [
"「...제 것은 아닌",
"것 같은데요...」"
],
"13568": [
"「아, 그게 아니라...",
"산사태 뉴스가",
"녹음돼 있었어요」"
],
"13569": [
"「산사태...?",
"왜 일기 예보 같은 걸",
"녹음했을까요...」"
],
"13570": [
