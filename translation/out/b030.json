{
"15598": [
"「음, 첫날부터 세어서",
"5일째 이른 아침인데요」"
],
"15599": [
"「5일째...?",
"나고무 군이 여기서 망봐",
"준 날 아침이었나」"
],
"15600": [
"「아뇨, 그다음 하루 더",
"지난 날 아침이에요」"
],
"15601": [
"「아, 그렇구나.",
"음, 그렇다면 난 방에서",
"안 나갔으니까...」"
],
"15602": [
"「아직 주무셨어요?」"
],
"15603": [
"「아니, 깨어는 있었어.",
"아마 복근 운동 했을걸」"
],
"15604": [
"「저, 저기, 그럼 옆방",
"소리나 문소리 같은 건...」"
],
"15605": [
"「들은 기억은 없네」"
],
"15606": [
"「나스 씨 방 이름이",
"뭐였죠?」"
],
"15607": [
"「음, 그 사람 있잖아.",
"주인공 탐정이 마술사고,",
"본인도 마술사인...」"
],
"15608": [
"「...어라, 탐정 이름은",
"생각나는데...」"
],
"15609": [
"「본인도 마술사라는 건",
"작가가요?」"
],
"15610": [
"「응, 맞아.",
"작가가... 아, 그렇지",
"로슨이었어」"
],
"15611": [
"「로슨이군요」"
],
"15612": [
"「그랬지.",
"읽은 게 꽤 옛날이네...」"
],
"15613": [
"...나스 씨 읽어 봤구나.",
"조금 의외라는 생각이 들었다."
],
"15614": [
"「응? 미키 짱?",
"우리 사장님 손녀?」"
],
"15615": [
"「...어라.",
"근데 아이세라는 성은",
"아니었던 것 같은데」"
],
"15616": [
"「저, 그건 이름만",
"같은 거 아닐까요」"
],
"15617": [
"「응, 왠지 그런 것 같아」"
],
"15618": [
"「참고로 그 손녀분은",
"몇 살이에요?」"
],
"15619": [
"「3살이었나」"
],
"15620": [
"「...다른 사람이에요」"
],
"15621": [
"「하하, 역시 그렇구나.",
"성이 다를 만하네」"
],
"15622": [
"문제는 거기일까.",
"뭔가 다른 것 같은데..."
],
"15623": [
"「기사라기 씨?",
"아, 물론 알지」"
],
"15624": [
"「딱 한 번 같은 사극에",
"나온 적이 있는데.",
"엄청 웃음거리가 됐지」"
],
"15625": [
"「왜요?」"
],
"15626": [
"「내가 악역 부하 중 하나라서",
"초반에 베여 쓰러졌는데,",
"그대로 잠들어 버렸거든」"
],
"15627": [
"「그래서 OK 사인이 나도",
"나 혼자 안 일어났지」"
],
"15628": [
"「무슨 일인가 스태프가",
"달려와 보니 자고 있었대.",
"억지로 깨워졌지만」"
],
"15629": [
"「호탕한 아이네, 하고",
"기사라기 씨가 폭소했었지」"
],
"15630": [
"그야 웃을 수밖에 없겠지..."
],
"15631": [
"「나루세 기미야스라는 사람",
"아세요?」"
],
"15632": [
"「나루세...?",
"어디서 들어 본",
"것 같긴 한데...」"
],
"15633": [
"「누구였더라.",
"잘 기억이 안 나네」"
],
"15634": [
"「아뇨, 사실 저도 잘은",
"몰라요.",
"서재 책에서 이름만 봤어요」"
],
"15635": [
"「오, 책에 실릴 만한",
"사람이구나?」"
],
"15636": [
"「그래서 어쩐지",
"귀에 익었나」"
],
"15637": [
"「마리안느라는 히로인이",
"나오는 소설 아세요?」"
],
"15638": [
"「아, 그거 재밌지.",
"무대에도 몇 번 올랐고」"
],
"15639": [
"「무대에서요?」"
],
"15640": [
"「응, 아직도 팬이 많아서",
"꽤 단골 레퍼토리로 하는",
"극단도 있어」"
],
"15641": [
"하긴 좋아하는 사람은",
"꽤 좋아할 만한 세계지."
],
"15642": [
"「해리 키드먼이라는",
"탐정 아세요?」"
],
"15643": [
"「알지 알지.",
"재밌는데 일본에선",
"별로 안 알려졌지」"
],
"15644": [
"「역시 영화 같은 걸로",
"안 만들어져서 그런가」"
],
"15645": [
"「영상화된 적",
"없어요?」"
],
"15646": [
"「주연 캐스팅이",
"어려울 거야」"
],
"15647": [
"「있어도 눈치 못 챌 만큼",
"존재감 없는 배우는",
"별로 없을 테니까」"
],
"15648": [
"「나스 씨, 진짜 집사를",
"만나 본 적 있으세요?」"
],
"15649": [
"「그러고 보니 없네.",
"츠바키 군밖에 몰라」"
],
"15650": [
"「츠바키 군은 진짜가",
"아니라 배역인데요...」"
],
"15651": [
"「아, 그렇구나!",
"그럼 한 번도 없네」"
],
"15652": [
"「일본엔 없나.",
"일본 사람 중에 세바스찬이란",
"사람은 본 적 없으니」"
],
"15653": [
"...뭔가를 심하게 오해하고",
"있는 것 같다."
],
"15654": [
"「나스 씨는",
"형제 있으세요?」"
],
"15655": [
"「있어, 다섯 명쯤」"
],
"15656": [
"「다섯 명!?」"
],
"15657": [
"「전부 남자라서, 딸 하나는",
"갖고 싶었대. 그런데",
"다섯째에서 결국 포기했대」"
],
"15658": [
"「나스 씨는 몇째예요?」"
],
"15659": [
"「난 막내야」"
],
"15660": [
"「그런데 다른 형들은",
"다 문과라서 말이야」"
],
"15661": [
"「집 안을 책장투성이로 만들어서",
"자주 부모님께 혼났지,",
"바닥 꺼진다고」"
],
"15662": [
"왜 나스 씨만",
"이렇게 된 거지..."
],
"15663": [
"「아니, 전혀 몰랐어」"
],
"15664": [
"「그야...",
"그런 거 아냐?」"
],
"15665": [
"이런 걸 나스 씨한테 물어서",
"어쩌자는 거야, 나는..."
],
"15666": [
"「어느 거?」"
],
"15667": [
"「...음?",
"잘 모르겠네」"
],
"15668": [
"「그랬었나...",
"아~, 그랬던 것 같아」"
],
"15669": [
"신경 안 썼는지",
"잘 기억 못 하는 모양이다."
],
"15670": [
"「그 밖에 특별히",
"아무것도 없었어」"
],
"15671": [
"「음...",
"별로 모르겠네」"
],
"15672": [
"「같이 일해 본 사람이 몇 명",
"있을 텐데, 그렇게 친한",
"상대는 없으니까」"
],
"15673": [
"「헬스장이",
"가까워서 편해」"
],
"15674": [
"왜 입지 얘기로..."
],
"15675": [
"「가면?",
"그런 게 있어?」"
],
"15676": [
"「흐음, 그래도",
"팬은 많을 테니까」"
],
"15677": [
"많은 걸까.",
"실제로 애호회가 있을 정도니",
"많은 건가..."
],
"15678": [
"「...뭐였더라 그거.",
"어디서 들은 것 같은데」"
],
"15679": [
"「아~, 생각났다.",
"엄청 맛없는 걸 마신",
"기억이 있어」"
],
"15680": [
"「...나고무 군, 좋아해?」"
],
"15681": [
"「아, 아뇨!",
"그런 건 아니에요」"
],
"15682": [
"「하하, 그렇지.",
"맛없으니까」"
],
"15683": [
"「음...",
"잘 모르겠네」"
],
"15684": [
"「첫 장면밖에 없으니까,",
"문장 버릇으로도 판단하기 어렵고」"
],
"15685": [
"「글쎄?",
"난 마작 잘 안 해서」"
],
"15686": [
"「아~, 옛날에 읽었는데...",
"어떤 얘기였는지 잘 기억 안 나」"
],
"15687": [
"그래도 읽긴 했구나..."
],
"15688": [
"「아니...",
"모를 것 같은데」"
],
"15689": [
"비디오 게임 같은 건 별로",
"안 할 것 같지, 나스 씨는."
],
"15690": [
"「아~, 그거 10년도 더 됐나.",
"이제 재방송도 없을 테니",
"못 보겠지...」"
],
"15691": [
"아쉬워 보였다.",
"좋아하던 드라마였나."
],
"15692": [
"「그렇지,",
"청소는 힘들겠지만」"
],
"15693": [
"「아, 그렇네요...」"
],
"15694": [
"유지비만으로도 엄청나게",
"들겠지."
],
"15695": [
"「그렇네, 이쪽 편",
"방에는 어디에도 없나 봐」"
],
"15696": [
"「그렇네요.",
"저희 방에도 없고」"
],
"15697": [
"「그렇구나...」"
],
"15698": [
"왠지 조금 아쉬워 보인다.",
"왜일까..."
],
"15699": [
"「그렇지.",
"우리 집에도 저런 거 있으면」"
],
"15700": [
"「나스 씨 집은",
"넓어요?」"
],
"15701": [
"「그렇지도 않아.",
"지하실도 없고」"
],
"15702": [
"보통은 없는 집이 더 많을",
"텐데 그건..."
],
"15703": [
"「별로 안 써.",
"냉장고 정도밖에 안 만지고」"
],
"15704": [
"「응, 있어.",
"평범한 방이었지만」"
],
"15705": [
"「그렇지.",
"그래도 몸을 좀 더 쓰는",
"게임이 있으면 좋을 텐데」"
],
"15706": [
"그런 건 저런 오락실에는",
"안 둘 것 같은데..."
],
"15707": [
"「아, 대단하네.",
"들여오느라 중노동이었을",
"거야...」"
],
"15708": [
"내용이 아니라 무게에 먼저",
"관심이 가는 모양이다..."
],
"15709": [
"「음, 첫날 한 번",
"들여다본 게 다인가」"
],
"15710": [
"「그럴 거야.",
"몸 움직이기엔 좀 좁지만」"
],
"15711": [
"보통 실내에선 안 할 법한",
"운동을 하고 있을 것 같다..."
],
"15712": [
"「어, 열리지 않는 방",
"이라는 거?」"
],
"15713": [
"「그 방은 본 적이 없어.",
"츠바키 군이 들어가지 말래서」"
],
"15714": [
"뭔가 실수로 물건을 부술 것",
"같다고 생각한 걸까."
],
"15715": [
"「오, 그래?",
"몰랐어」"
],
"15716": [
"「...글쎄?",
"왜일까」"
],
"15717": [
"나스 씨는 딱히 신경 쓰이지",
"않는 모양이었다."
],
"15718": [
"「그런 게 있어!?",
"그거 어디까지 이어질까,",
"여기서 도망칠 수 있을 만큼?」"
],
"15719": [
"「아니, 저, 아무리 그래도",
"그건 무리일...」"
],
"15720": [
"여기서 탈출할 만한 통로라면",
"몇 킬로를 파야 하는 거야..."
],
"15721": [
"「...그랬나.",
"아니, 분명 있었지, 응」"
],
"15722": [
"관심이 없는지 별로",
"신경 안 쓰는 것 같다..."
],
"15723": [
"「응, 딱히 없는지도.",
"내장도 평범하고」"
],
"15724": [
"「하하, 미안.",
"신경 안 써도 돼」"
],
"15725": [
"무슨 얘기였을까..."
],
"15726": [
"「...아마",
"그럴 것 같은데...」"
],
"15727": [
"「실제로 어떻게 했는지는",
"도통 모르겠지」"
],
"15728": [
"「저, 도끼 말인데요...",
"흉기로 쓰인 그거요...」"
],
"15729": [
"「...그거",
"벽에 걸려 있던 거지」"
],
"15730": [
"「꽤 가벼웠는데.",
"진짜였구나...」"
],
"15731": [
"들어 본 적이 있구나.",
"근데 가볍다고 느낀 건 나스 씨라서",
"그런 것 같은데..."
],
"15732": [
"「그거구나...",
"언제 갖다 놨을까?」"
],
"15733": [
"「낮에는 아직 없었죠,",
"그런 거」"
],
"15734": [
"「있었으면 누가 발견하고",
"난리 났겠지」"
],
"15735": [
"「음...",
"난 본 적 없네」"
],
"15736": [
"「응, 설마 밖으로 연결되는",
"전화가 없을 줄은 몰랐어」"
],
"15737": [
"「휴대폰도 안 터지고요」"
],
"15738": [
"「그런가 봐...」"
],
"15739": [
"「아니, 난 안 만졌어」"
],
"15740": [
"「아, 그 커다란 거",
"대단하지」"
],
"15741": [
"「얼마나 무거울까...」"
],
"15742": [
"대단하다는 게 그쪽 얘기였어..."
],
"15743": [
"「음...",
"왜 벨일까?",
"모르겠네...」"
],
"15744": [
"「온실에 긴 못이",
"놓여 있었죠」"
],
"15745": [
"「대못이라는 거죠」"
],
"15746": [
"「그렇지...",
"범인이 가져왔을까」"
],
"15747": [
"「보통 집에 놓아두는",
"물건은 아니니까요」"
],
"15748": [
"「그렇지.",
"우리 집에도 없어, 대못은」"
],
"15749": [
"「저희 집에도 없어요,",
"그런 거...」"
],
"15750": [
"「장갑이라...",
"난 장갑이 불편해서",
"거의 안 끼는데」"
],
"15751": [
"「드레스 같은 거 입을 때",
"낄 법한 하늘하늘한 거였어요」"
],
"15752": [
"「아, 그런 장갑이구나.",
"더더욱 안 끼겠네」"
],
"15753": [
"그야 그렇겠지..."
],
"15754": [
"「손도끼?",
"작은 거?」"
],
"15755": [
"「네, 이 정도요」"
],
"15756": [
"「그럼 무기가 아니라",
"벌목용 같은 건가」"
],
"15757": [
"애초에 무장용으로 도끼를 집에",
"두는 사람은 별로",
"없겠지..."
],
"15758": [
"「그거 어디에 쓰는 거야?」"
],
"15759": [
"「잘 모르겠어요.",
"그냥 장식일지도」"
],
"15760": [
"「아, 그거 가벼워」"
],
"15761": [
"「가벼워요?」"
],
"15762": [
"「응, 가벼웠어」"
],
"15763": [
"다른 감상은 없나 보다..."
],
"15764": [
"「그렇지.",
"여기에도 무슨 그림이 있고」"
],
"15765": [
"그렇게 말하며 나스 씨는 벽 그림을",
"봤지만 별 관심은 없어 보였다."
],
"15766": [
"「오...?",
"옛날에 먹어 본 적 있는데...」"
],
"15767": [
"「외국에서」"
],
"15768": [
"...먹는다는 발상이 제일 먼저",
"나오는 게 대단하다..."
],
"15769": [
"「응, 인스턴트는",
"안 먹으려고 해」"
],
"15770": [
"역시 그렇구나..."
],
"15771": [
"「보우건이라면 무기?」"
],
"15772": [
"「네, 화살을 쏘는 총이요」"
],
"15773": [
"「흐음?」"
],
"15774": [
"고개를 갸웃하며 뭔가 생각에 잠겼다.",
"뭘까...?"
],
"15775": [
"「아니, 마셔 본 적 없어」"
],
"15776": [
"필요 없어 보이니까."
],
"15777": [
"「흐음?",
"특이한 걸 기르네」"
],
"15778": [
"「응? 나고무 군이야말로",
"그런 걸 어떻게 알아?」"
],
"15779": [
"「아, 저는 쿠라이시 씨한테",
"살짝 들었을 뿐인데요」"
],
"15780": [
"「아, 쿠라이시 씨구나.",
"그렇군...」"
],
"15781": [
"「카세트테이프라.",
"천 원 숍에서 파는 거 같네」"
],
"15782": [
"「응, 본 적 있어」"
],
"15783": [
"「화살이...?",
"왜 없을까」"
],
"15784": [
"「뭔가에 썼나?」"
],
"15785": [
"「모르겠어요...」"
],
"15786": [
"「그렇구나....",
"그래도 어디서 쐈을까...」"
],
"15787": [
"「글쎄? 뭘까?」"
],
"15788": [
"나스 씨도 전혀 짐작이",
"안 가는 모양이다."
],
"15789": [
"「아, 그거 재밌지」"
],
"15790": [
"「좀 섬뜩하지 않아요?」"
],
"15791": [
"「그래?",
"난 좋은데」"
],
"15792": [
"「...음?",
"기억 안 나는데」"
],
"15793": [
"「응? 카세트테이프?",
"뭐 녹음돼 있어?」"
],
"15794": [
"「산사태 뉴스가...",
"근데 저희가 라디오로 들은 거랑",
"내용이 달라요」"
],
"15795": [
"「범인이 준비한 가짜",
"뉴스가 아닐까 싶어서...」"
],
"15796": [
"「...왜 그런 걸?」"
],
"15797": [
"「왜냐니, 그야 설마 범인도",
"정말 벼랑이 무너질 줄은",
"몰랐던 거 아닐까요?」"
],
"15798": [
"「그래도 그거 쓸모없잖아.",
"보러 가 버리면 안 무너진 게",
"금방 들통나니까」"
],
"15799": [
"아마 아무 망설임 없이",
"걸어가는 사람이 있을 줄은",
"몰랐던 게 아닐까..."
],
"15800": [
"「꽃?」"
],
"15801": [
"「...하나슈쿠샤 같은데」"
],
"15802": [
"「슈쿠... 네?」"
],
"15803": [
"「이른바 진저야」"
],
"15804": [
"「진저요?",
"그래요?」"
],
"15805": [
"「응, 그런데 이거 어디",
"있었어?",
"땅에 떨어져 있는 것 같은데」"
],
"15806": [
"「온실이요.",
"『복수』 종이 옆에 뜯겨서",
"놓여 있었어요」"
],
"15807": [
"「....거기구나」"
],
"15808": [
"「진저면 생강이잖아요,",
"왜 이런 꽃을...」"
],
"15809": [
"「생강이라고 해도,",
"진저는 생강과 식물의",
"총칭이라서...」"
],
"15810": [
"「...아, 뭐 그건",
"아무래도 좋나.",
"생강은 상관없을 테니」"
],
"15811": [
"「아, 네, 아마도.",
"그래도 다른 의미가 있을까요?」"
],
"15812": [
"「그 밖엔...",
"음, 꽃말 같은 거?」"
],
"15813": [
"「꽃말이요?」"
],
"15814": [
"「응, 『헛된 일』이라고",
"하는데」"
],
"15815": [
"「그거... 저...",
"범인이 저희한테 그렇게",
"말하는 걸까요...」"
],
"15816": [
"「응? 아...",
"그럴지도 모르겠네」"
],
"15817": [
"「그런 짓 해 봤자 헛수고라고",
"말하고 싶은 걸까...」"
],
"15818": [
"그런 짓...",
"우리가 어떻게든 범인이 하는 짓을",
"방해하는 것...?"
],
"15819": [
"（그게 헛수고라는 건 무슨",
"의미일까...）"
],
"15820": [
"「아, 잠깐만」"
],
"15821": [
"그렇게 말하고 나스 씨는 바지",
"주머니에서 열쇠를 꺼냈다."
],
"15822": [
"「『C』네」"
],
"15823": [
"「응, 기계에 약해서」"
],
"15824": [
"「불편하지 않으세요?」"
],
"15825": [
"「매니저가 있으니까",
"괜찮아」"
],
"15826": [
"그렇구나, 배우에겐",
"그런 사람이 붙어 있었지."
],
"15827": [
"「응, 난 대개",
"어딜 가든 내 차로",
"다니니까」"
],
"15828": [
"「아카시야키...",
"별로 안 먹는 것 같네」"
],
"15829": [
"뭐, 자주 먹는",
"음식은 아니지."
],
"15830": [
"「아니, 그렇게 공들인",
"요리는 무리야」"
],
"15831": [
"「먹고 싶네,",
"햄버그스테이크...」"
],
"15832": [
"「응, 좋아해.",
"...먹고 싶다」"
],
"15833": [
"...안 되겠다.",
"음식 얘기를 하니까",
"배가 고파진다..."
],
"15834": [
"「응, 피워 본 적 없어」"
],
"15835": [
"그렇겠지..."
],
"15836": [
"「아니, 안 마셨어.",
"와인은 원래 별로",
"안 마시거든」"
],
"15837": [
"단련도 하고, 술 자체를",
"별로 안 마실 것 같아..."
],
"15838": [
"「...음.",
"굳이 따지면 접이식 의자가",
"더 좋으려나」"
],
"15839": [
"「....그, 그러세요」"
],
"15840": [
"왜 접이식 의자...?"
],
"15841": [
"「아니, 유리잔은",
"안 빌렸어」"
],
"15842": [
"휙, 하고 팔을 굽혀 포즈를",
"잡아 보였다."
],
"15843": [
"팔 둘레가 아무리 봐도",
"내 다리보다 굵다..."
],
"15844": [
"「미사사기 씨는 평소에도 그렇게",
"느긋한 느낌이세요?」"
],
"15845": [
"「음, 아마」"
],
"15846": [
"「아마요?」"
],
"15847": [
"「응, 잘은 모르지만」"
],
"15848": [
"「예쁜 사람이긴 한데.",
"...말랐단 말이지」"
],
"15849": [
"근육이 없다는",
"뜻이겠지..."
],
"15850": [
"「응, 알지.",
"영화도 다 봤고」"
],
"15851": [
"「직접 만나서 얘기해 본 적은요?」"
],
"15852": [
"「그건 아무래도 무리지」"
],
"15853": [
"정말로 완전히 사람 앞에",
"안 나오는 사람이구나..."
],
"15854": [
"「난 딱히 이제 밝혀도",
"상관없는데...」"
],
"15855": [
"「정체불명의 각본가가 더",
"재밌으니까 입 다물라고",
"매니저가 그러거든」"
],
"15856": [
"이제 밝혀도, 라는 건",
"처음엔 다른 이유가 있었던 걸까."
],
"15857": [
"「책은 읽었지만,",
"본인에 대해선 잘 몰라」"
],
"15858": [
"그래도 책은 읽는다는 게",
"조금 의외... 라고 하면",
"실례일까..."
],
"15859": [
"「글쎄, 기억에 없는데.",
"근처에 있었어?」"
],
"15860": [
"「오?",
"못 만났는데」"
],
"15861": [
"（하지만 아무리 마다라이 씨라도",
"혼자서 웃고 있진",
"않았을 테니...）"
],
"15862": [
"（누군가가 그 자리에",
"함께 있었던 거야...）"
],
"15863": [
"「――아...」"
],
"15864": [
"「응? 왜 그래?」"
],
"15865": [
"「아, 아뇨",
"아무것도 아니에요」"
],
"15866": [
"...11시 40분 이후.",
"그 시간까지 방에 안 돌아갔다고",
"말한 건 이 나스 씨뿐이다."
],
"15867": [
"「아... 응...",
"대체 왜 이런 일이",
"생긴 걸까...」"
],
"15868": [
"「나로선 뭐가 뭔지",
"도통 모르겠어...」"
],
"15869": [
"「...놀랐지」"
],
"15870": [
"나스 씨는 평소엔 상상도 못 할",
"만큼 비통한 표정으로 고개를 숙였다."
],
"15871": [
"「대체 언제 돌아가셨을까.",
"난... 전혀 몰랐어」"
],
"15872": [
"「...저도요...」"
],
"15873": [
"그대로 거의 대화가",
"되지 않았다..."
],
"15874": [
"「불쌍하네...」"
],
"15875": [
"그 뒤로 서로 말없이",
"있게 되었다..."
],
"15876": [
"「...그럴지도.",
"죽었으면 올 수가",
"없는 거지...」"
],
"15877": [
"「안됐다...」"
],
"15878": [
"「이케우치 씨?",
"음, 모르겠는데」"
],
"15879": [
"이름도 전혀 모르는 것 같다."
],
"15880": [
"「사토에 씨? 사토에 씨라...",
"음, 기억이 잘 안 나네」"
],
"15881": [
"꽤 옛날 사람 같으니",
"모르려나..."
],
"15882": [
"「...그래?",
"오, 아이돌이라...」"
],
"15883": [
"「미사사기 씨는 젊을 때부터",
"미인이었구나」"
],
"15884": [
"「응? 아, 알지.",
"악마를 불러내려 했다든가,",
"그런...」"
],
"15885": [
"「아아아, 저, 자세한 건",
"괜찮아요!」"
],
"15886": [
"「? 그래?」"
],
"15887": [
"「응, 탐정 말이지?」"
],
"15888": [
"「...분명 수영을 잘하지,",
"그 사람」"
],
"15889": [
"「그런데 운동신경 좋아 보이는데",
"평소엔 거의 안 움직이니까」"
],
"15890": [
"뭔가 보는 곳이 다르다..."
],
"15891": [
"「아, 응.",
"왓슨 역 사람이지」"
],
"15892": [
"「스포츠는 서툴러 보이는",
"느낌이었어」"
],
"15893": [
"거기밖에 기억에 없는 걸까..."
],
"15894": [
"「응, 기억해.",
"경감님이지」"
],
"15895": [
"「네, 네, 그야...」"
],
"15896": [
"뭔가 대화가 미묘하게",
"안 맞물리는 것 같다."
],
"15897": [
"「...누구였더라?",
"잘 기억 안 나네」"
],
"15898": [
"역시 모르는구나..."
],
"15899": [
"「응? 마다라이 씨가",
"시게오 씨였어?」"
],
"15900": [
"「아뇨, 소설에 나오는 쪽",
"마다라이 씨요」"
],
"15901": [
"「아, 그쪽이구나.",
"흐음, 그런 이름이었나」"
],
"15902": [
"읽어 본 적은 있는 걸까...?"
],
"15903": [
"「...?",
"아니, 잘 모르겠네」"
],
"15904": [
"「음, 분명 읽은 이야기에",
"나왔던 것 같은데,",
"확실히 기억이 안 나...」"
],
"15905": [
"「도깨비의... 음, 어라?",
"어떤 이야기였더라...」"
],
"15906": [
"읽었는데도 생각이 안 나는",
"모양이었다."
],
"15907": [
"「...아, 그 이야기",
"드라마로 봤었지」"
],
"15908": [
"「드라마로 나왔어요?」"
],
"15909": [
"「꽤 전에.",
"그래도 잘 기억 안 나」"
],
"15910": [
"그렇게 잘 만든 드라마는",
"아니었던 걸까...?"
],
"15911": [
"「...누구였더라, 그거.",
"어디서 들은 것 같은데」"
],
"15912": [
"「다카토 노부지로 소설에",
"나오는 사람인데요」"
],
"15913": [
"「아, 그렇구나.",
"...무슨 이야기에 나오는",
"사람이었더라...」"
],
"15914": [
"...나스 씨도 기억 못 하는 모양이다."
],
"15915": [
"「뭐였더라, 그거.",
"뭔가 기분 나쁜 이야기지」"
],
"15916": [
"「아, 저, 역시 괜찮아요」"
],
"15917": [
"나스 씨가 기분 나빠할 정도면",
"상당히 무서운 거구나..."
],
"15918": [
"「그런 이름이었나?",
"잘 기억 안 나는데」"
],
"15919": [
"「나랑은 꽤 다른 타입",
"이었던 것 같고」"
],
"15920": [
"나스 씨 같은 타입은 그런",
"이야기엔 별로 안 나올 것 같다."
],
"15921": [
"「아, 그거 재밌어.",
"분명 옛날에 영화화된 게",
"DVD로 나와 있을걸」"
],
"15922": [
"「응, 찾아서 봐 봐.",
"추천이야」"
],
"15923": [
"「책 쪽?",
"음... 여기 미사사기 씨랑",
"별로 다르지 않았던 것 같은데」"
],
"15924": [
"「응, 뭔가 미인이었어」"
],
"15925": [
"「음...?",
"아, 마지막에 쓰인 이야기지」"
],
"15926": [
"「응, 사건 자체는 마지막도",
"뭣도 아닌데, 쓰여서",
"출간된 건 그게 마지막일걸」"
],
"15927": [
"「아, 그렇군요」"
],
"15928": [
"「다카토 씨가 쓴 책에도",
"기누타 유리라는 여배우가",
"나오죠」"
],
"15929": [
"「...음...",
"아, 그러고 보니 있었나」"
],
"15930": [
"별로 인상에 없는 모양이다."
],
"15931": [
"「종루... 아, 그거구나.",
"여기 츠바키 군하곤 전혀",
"안 닮은 사람이었던 것 같은데」"
],
"15932": [
"「기본적으로 이름만 따왔지",
"작중 인물과 배역은 상관없나 봐」"
],
"15933": [
"「아~... 어렴풋하게밖에",
"기억 안 나네」"
],
"15934": [
"인상이 약한 이야기인가..."
],
"15935": [
"「음...",
"응, 있었던 건 기억해」"
],
"15936": [
"「그거 뭔가 원래 모티브가",
"있었는데, 뭐였더라」"
],
"15937": [
"「아, 아뇨, 저,",
"모티브 같은 건 괜찮아요...」"
],
"15938": [
"「응? 그래?",
"뭐, 나도 깜빡해서",
"생각이 안 나고」"
],
"15939": [
"분명히 무서운 얘기일 테니,",
"사건과 상관없다면 모르는",
"채로 있고 싶다..."
],
"15940": [
"「그걸 모르겠단 말이지.",
"왜 모자 장수일까...」"
],
"15941": [
"「왜라니, 뭐가요?」"
],
"15942": [
"「...잘 모르겠어.",
"뭔가 찜찜하네...」"
],
"15943": [
"나스 씨는 계속해서",
"고개를 갸웃할 뿐이었다..."
],
"15944": [
"「로슨이야.",
"아마 마술사 쪽이겠지」"
],
"15945": [
"「마술사예요?」"
],
"15946": [
"「아니, 작가인데.",
"다른 방들처럼」"
],
"15947": [
"마술사이기도 하다는",
"건가...?"
],
"15948": [
"「미키 짱?",
"미키... 음...」"
],
"15949": [
"「기억에 없네.",
"모르는 것 같아」"
],
"15950": [
"나스 씨는 아이돌 같은 데",
"관심 없어 보이니까."
],
"15951": [
"「아, 알지.",
"유명한 여배우니까」"
],
"15952": [
"「일로 같이한 건",
"한 번뿐이지만」"
],
"15953": [
"「무슨 일이었어요?」"
],
"15954": [
"「사극이었어」"
],
"15955": [
"그러고 보니 기사라기 씨는",
"사극에 자주 나오지."
],
"15956": [
"「나루세...",
"아니, 잘 모르겠네」"
],
"15957": [
"「아~, 그거 재밌지」"
],
"15958": [
"「재밌어, 응」"
],
"15959": [
"...라기보다",
"읽었구나..."
],
"15960": [
"「응, 알지.",
"아쉽단 말이야, 재밌는데 일본에선",
"별로 안 알려져서」"
],
"15961": [
"역시 마이너한",
"탐정이구나..."
],
"15962": [
"「음, 츠바키 군밖에",
"모르는데?」"
],
"15963": [
"「아뇨, 저, 츠바키 군도",
"배역일 뿐인 것 같은데요...」"
],
"15964": [
"「아, 그렇구나!",
"그럼 없네」"
],
"15965": [
"「아, 있어.",
"형이」"
],
"15966": [
"「그럼 두 형제예요?」"
],
"15967": [
"「아니, 다섯」"
],
"15968": [
"「형이 넷 있어」"
],
"15969": [
"「그... 그러세요...」"
],
"15970": [
"어떤 집일까.",
"나스 씨 같은 사람이 다섯",
"있는 걸까..."
],
"15971": [
"「...어라, 그러고 보니」"
],
"15972": [
"「나고무 군,",
"어제 뭔가 말하지 않았어?」"
],
"15973": [
"「분명 사건 얘기였던",
"것 같은데...」"
],
"15974": [
"「어, 저, 그거...",
"나스 씨가 노려질지도",
"모른다고 한 거요?」"
],
"15975": [
"「아, 그랬나?",
"그래도 난 아무 일도 없었는데」"
],
"15976": [
"...라기보다 지금까지 진심으로",
"잊고 있었던 걸까..."
],
"15977": [
"「뭔가 어젯밤에 무슨 일이",
"있을 거란 얘기 안 했었나」"
],
"15978": [
"「어, 아, 그건,",
"나스 씨가 노려...」"
],
"15979": [
"「아니, 착각이겠지.",
"내 주변엔 아무 일도 없었고」"
],
"15980": [
"진심으로 잊은 걸까..."
],
"15981": [
"「아, 저기,",
"어젯밤에 내가 위험하다는",
"얘기 했었지?」"
],
"15982": [
"「아니, 특별히 아무 일도 없어서",
"일단 보고해 둘까 해서」"
],
"15983": [
"「아...",
"그, 그러세요」"
],
"15984": [
"「응.",
"그런데 그거 뭔가 착오",
"였던 거 아닐까」"
],
"15985": [
"「왜냐면 어젯밤 이 기계를",
"문 앞에 옮기는 걸 깜빡하고",
"잤는데 아무 일도 없었거든」"
],
"15986": [
"「에에에!?",
"문도 안 잠그고요!?」"
],
"15987": [
"「응, 깜빡했어」"
],
"15988": [
"「나, 나스 씨!",
"제 추리는 둘째 치고 더",
"경계하셔야 해요!?」"
],
"15989": [
"「...그렇지.",
"응, 조심할게」"
],
"15990": [
"괜찮은 걸까,",
"정말로..."
],
"15991": [
"「아~, 맞다 맞다.",
"어젯밤에 내가 위험하다고",
"했었잖아」"
],
"15992": [
"「네? 아, 네」"
],
"15993": [
"「그거 아니었나 봐」"
],
"15994": [
"「아니었다니, 그건...」"
],
"15995": [
"「아니, 괜찮았으니까」"
],
"15996": [
"나스 씨가 무사한 건",
"보면 알지만..."
],
"15997": [
"（뭔가 아니었다고 말하는",
"근거가 따로 있을 것 같은 건",
"기분 탓일까...）"
],
"15998": [
"「아, 그러고 보니...」"
],
"15999": [
"「어젯밤 내가 노려졌다는",
"얘기... 그거 언제",
"들었더라」"
],
"16000": [
"「아니, 뭔가 여러 번 들은",
"것 같아서 언제였는지」"
],
"16001": [
"「뭐, 됐나」"
],
"16002": [
"「돼요!?」"
],
"16003": [
"「난 딱히 위험한 일은",
"안 당했으니 괜찮지 않아?」"
],
"16004": [
"괜찮은 걸까..."
],
"16005": [
"「아, 맞다.",
"나고무 군 말이야...」"
],
"16006": [
"「뭔가 어젯밤 내가",
"위험하다고... 어라?」"
],
"16007": [
"「이 얘기 전에도 했지.",
"미안 미안」"
],
"16008": [
"「아... 아, 아뇨...」"
],
"16009": [
"어젯밤에도 위험하다고 한 게",
"전 얘기랑 섞인 것 같다..."
],
"16010": [
"모르겠어"
],
"16011": [
"놀리지 마"
],
"16012": [
"놀라게 하지 마"
],
"16013": [
"어디까지 진심이야"
],
"16014": [
"2번으로 할게"
],
"16015": [
"3번..."
],
"16016": [
"다 싫어"
],
"16017": [
"「...저기, 시즈나 짱?」"
],
"16018": [
"대본을 훑어보던 소녀는",
"말없이 고개를 들었다."
],
"16019": [
"검은자위가 큰, 빨려 들어갈",
"것 같은 눈이었다."
],
"16020": [
"「저...」"
],
"16021": [
"「그럼 여기서 문제입니다」"
],
"16022": [
"「나는 시즈나일까요",
"아니면 스즈나일까요」"
],
"16023": [
"「뭐!?",
"어, 저... 그게...」"
],
"16024": [
"「3」"
],
"16025": [
"「사, 삼!?」"
],
"16026": [
"「2」"
],
"16027": [
"「카운트다운이야!?」"
],
"16028": [
"「1」"
],
"16029": [
"「아, 아, 그게...!」"
],
"16030": [
"「시, 시즈나 짱!」"
],
"16031": [
"「...인 것 같은데...」"
],
"16032": [
"「그게... 저... 틀렸어?」"
],
"16033": [
"「...칫」"
],
"16034": [
"「안 걸렸네」"
],
"16035": [
"시즈나 짱은 불만스러운 듯",
"입술을 삐죽였다."
],
"16036": [
"뭐야 대체..."
],
"16037": [
"「미, 미안!",
"모르겠어!!」"
],
"16038": [
"「...그, 그치만",
"똑같이 생겼는걸...」"
],
"16039": [
"「....우후」"
],
"16040": [
"「시즈나였습니다」"
],
"16041": [
"「아, 그, 그렇구나...」"
],
"16042": [
"다행이다, 화난 것 같진 않네."
],
"16043": [
"「스, 스즈나 짱!」"
],
"16044": [
"「...이었어?」"
],
"16045": [
"「땡~」"
],
"16046": [
"방긋, 고양이 같은 미소를",
"지어 보인다."
],
"16047": [
"「때, 땡...",
"그럼 시즈나 짱이 맞았구나」"
],
"16048": [
"「후후후, 걸렸다」"
],
"16049": [
"즐거워 보인다..."
],
"16050": [
"「....그래서, 뭔데?」"
],
"16051": [
"「왜 말 걸었어」"
],
"16052": [
"「아, 아아...」"
],
"16053": [
"당황한 탓에 무슨 얘기를",
"하려 했는지 잊어버렸다..."
],
"16054": [
"「...작업?」"
],
"16055": [
"「아, 아아아 아니야 아니야!」"
],
"16056": [
"「그렇게 온 힘을 다해 부정하다니",
"너무해!」"
],
"16057": [
"「에에에!?」"
],
"16058": [
"「아, 놀랐다」"
],
"16059": [
"「성공~」"
],
"16060": [
"「...시즈나 짱...」"
],
"16061": [
"「너무",
"놀리지 마...」"
],
"16062": [
"「...화났어?」"
],
"16063": [
"「아니, 화난 건",
"아니지만」"
],
"16064": [
"시즈나 짱은 조금 시시한 듯",
"원래의 무표정으로 돌아갔다."
],
"16065": [
"「놀라게 하지 마...」"
],
"16066": [
"「에~」"
],
"16067": [
"「에~라니...」"
],
"16068": [
"「반응 좋은데」"
],
"16069": [
"「...봐줘.",
"나 소심하단 말이야...」"
],
"16070": [
"「...겁쟁이야?」"
],
"16071": [
"「더 재밌는...」"
],
"16072": [
"「시즈나 짱!?」"
],
"16073": [
"...농담으로 안 들린 건",
"내 착각일까."
],
"16074": [
"「어디까지 진심인지",
"모르겠어...」"
],
"16075": [
"「모르겠어?」"
],
"16076": [
"「응, 그게",
"방금 것도 연기로 안 보였고」"
],
"16077": [
"「...여, 연기지?」"
],
"16078": [
"「왜 웃는 거야!?」"
],
"16079": [
"「연기였습니다」"
],
"16080": [
"「그, 그렇지...」"
],
"16081": [
"「...인 척하고...」"
],
"16082": [
"「후후후, 농담.",
"오빠 재밌다」"
],
"16083": [
"엄청 기뻐 보인다..."
],
"16084": [
"「...그래서, 뭐였더라」"
],
"16085": [
"「어...",
"아, 아아, 그게...」"
],
"16086": [
"이젠 완전히 깨끗하게, 왜",
"말을 걸었는지 생각이 안 난다."
],
"16087": [
"「잊었어?」"
],
"16088": [
"「미안, 잊었어...」"
],
"16089": [
"「...그럼 내가 정해 줄게」"
],
"16090": [
"「뭐!?」"
],
"16091": [
"「1번, 역시 작업이었습니다」"
],
"16092": [
"「아니, 아니라니까!」"
],
"16093": [
"「2번, 제 노래를 들어 주세요」"
],
"16094": [
"「왜 노래!?」"
],
"16095": [
"「3번, 부끄러운 비밀 고백」"
],
"16096": [
"「그게 무슨 용건이야!?」"
],
"16097": [
"「자, 골라.",
"10초 전~」"
],
"16098": [
"「에에에에!?」"
],
"16099": [
"「9, 8」"
],
"16100": [
"「그치만 그거 다",
"말도 안 되는 용건뿐...」"
],
"16101": [
"「3, 2, 1」"
],
"16102": [
"「건너뛰었어!?",
"지금 숫자 확 건너뛰었지!?」"
],
"16103": [
"「영」"
],
"16104": [
"「아아아, 정말...!」"
],
"16105": [
"「2, 2번... 으로 할게」"
],
"16106": [
"「와, 대단해.",
"노래해 주는구나~」"
],
"16107": [
"「그치만 시즈나 짱이",
"고르라고...」"
],
"16108": [
"「불러」"
],
"16109": [
"「...왜 이렇게 된 거지...」"
],
"16110": [
"「포기해」"
],
"16111": [
"「포, 포기하라니...」"
],
"16112": [
"「자, 불러」"
],
"16113": [
"「뭘 부르면 되는데...?」"
],
"16114": [
"「음...",
"그럼 캐나다 국가」"
],
"16115": [
"「왜 캐나다!?",
"게다가 몰라, 그런 거!」"
],
"16116": [
"「몰라?",
"그럼 오빠네 교가」"
],
"16117": [
"「교가? 대학교?」"
],
"16118": [
"「응.",
"하나, 둘」"
],
"16119": [
"시즈나 짱이 지휘봉을 든",
"시늉을 하며 손을 흔드는",
"바람에 덩달아 부르기 시작했다."
],
"16120": [
"（...왜 나는...）"
],
"16121": [
"（산꼭대기 저택에 잘못 들어와서",
"교가를 부르고 있는 걸까...）"
],
"16122": [
"문득 보니 시즈나 짱 뒤에",
"스즈나 짱까지 불쑥 서 있었다."
],
"16123": [
"「와~, 짝짝짝」"
],
"16124": [
"「자, 스즈도 박수」"
],
"16125": [
"「응? 아, 응」"
],
"16126": [
"다 부른 나에게 쌍둥이가",
"나란히 박수를 쳐 주었다."
],
"16127": [
"「...그래서,",
"뭐 하는 거야, 오빠」"
],
"16128": [
"「제 노래를 들어 주세요래」"
],
"16129": [
"「안 했어!",
"그런 말 안 했다니까!」"
],
"16130": [
"「무슨 얘기 하려 했는지 잊었다니까",
"시즈나 짱이 왠지 정해 주겠다고",
"하더라고!」"
],
"16131": [
"「그래서, 저, 왠지 3지선다가",
"돼서 노래하기가 들어 있고...」"
],
"16132": [
"「아하하, 그, 그래서...",
"진짜로 불러 준 거야!?」"
],
"16133": [
"「아하하하하하!",
"오빠 착하다~!」"
],
"16134": [
"「...그치만",
"순간 제일 나은 것 같아서」"
],
"16135": [
"「아~, 웃겨.",
"근데 그 선곡은 뭐야?」"
],
"16136": [
"「어, 시즈나 짱이",
"우리 교가 부르라고」"
],
"16137": [
"「의외네 의외」"
],
"16138": [
"「어, 뭐, 뭐가?」"
],
"16139": [
"「진짜 의외야.",
"오빠 머리 좋구나」"
],
"16140": [
"「응, 대단해」"
],
"16141": [
"미묘하게 칭찬받은 것 같지",
"않은 기분이 든다..."
],
"16142": [
"「아, 맞다.",
"언니, 대본 관련해서",
"좀 물어볼 게 있어」"
],
"16143": [
"「아, 그럼 난 이만...」"
],
"16144": [
"「아~, 미안.",
"또 놀아 줘」"
],
"16145": [
"「바이바이」"
],
"16146": [
"놀아 준 게 아니라 놀림당한",
"거 아닐까."
],
"16147": [
"뭐, 조금은 친해진 것 같은",
"기분이 드니 됐나..."
],
"16148": [
"「저기, 3번...」"
],
"16149": [
"「3번?",
"부끄러운 비밀?」"
],
"16150": [
"「뭐야, 그 설레는 얼굴은」"
],
"16151": [
"「어떤 건데?」"
],
"16152": [
