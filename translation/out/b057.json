{
"28323": [
"「방에 틀어박힌 내가",
"할 소리는 아니다만」"
],
"28324": [
"「아직 젊은 것들이 많으니까.",
"어떻게든 할 수 있으면",
"좀 해 줘라」"
],
"28325": [
"「아, 아뇨, 그게,",
"자신은 없지만",
"할 수 있는 만큼은...」"
],
"28326": [
"「어쩔 수 없는 꼬맹이구먼,",
"정말이지...」"
],
"28327": [
"「살아 있는 증거가",
"눈앞에 있는데 말이야」"
],
"28328": [
"「정말 위급할 때는",
"나도 손 좀 보태 주마」"
],
"28329": [
"「...부탁한다」"
],
"28330": [
"「네, 네엣!」"
],
"28331": [
"「...아아, 꼬맹이」"
],
"28332": [
"「힘내라」"
],
"28333": [
"「내가 안 뒈졌으니까",
"괜찮기야 하겠지만...」"
],
"28334": [
"「...알기 쉬운 녀석이구먼」"
],
"28335": [
"「...꼬맹아, 괜찮냐?」"
],
"28336": [
"「또 밤새 복도에 있겠다느니",
"무리한 소리 안 하냐는 거다」"
],
"28337": [
"「아, 그게, 저기」"
],
"28338": [
"「네가 믿을 구석인 건",
"확실하다만...」"
],
"28339": [
"「그렇다고 네가 뒈져 버리면",
"아무 의미 없다고」"
],
"28340": [
"「여긴 생판 남들뿐이야.",
"목숨까지 걸 필요는 없어」"
],
"28341": [
"「멍청한 놈.",
"네가 뒈져 버리면 우리가",
"네 부모한테 뭐라고 하냐」"
],
"28342": [
"「잘 들어, 꼬맹아.",
"우리에 대해서는 말이다...」"
],
"28343": [
"「...여차하면",
"버리고 가도 된다」"
],
"28344": [
"「쿠라이시 씨...!」"
],
"28345": [
"「흥...",
"모르고 있을 줄",
"알았는데 역시나구먼」"
],
"28346": [
"「그, 그치만, 그런...」"
],
"28347": [
"「괜찮다고 했잖냐.",
"넌 이미 충분히 잘했어」"
],
"28348": [
"「...뭐, 진짜 위험할 땐",
"그 녀석이 어떻게든 하겠지만..」"
],
"28349": [
"「아아, 신경 쓰지 마.",
"넌 내가 한 말만",
"기억하고 있으면 돼」"
],
"28350": [
"――여차할 때..."
],
"28351": [
"그건 분명, 내가 뭔가를",
"실패했을 때 일어난다..."
],
"28352": [
"（그렇게 되면, 이 사람은",
"죽어 버릴지도 몰라）"
],
"28353": [
"（모처럼...",
"모처럼 살아났는데...）"
],
"28354": [
"「우울한 낯짝 하지 마.",
"나도 그렇게 쉽게 뒈질",
"생각은 없으니까」"
],
"28355": [
"「그렇게 안 되게 하려고",
"네가 뛰어다녀 주고",
"있는 거 아니냐?」"
],
"28356": [
"「네, 네...!」"
],
"28357": [
"「...너, 아직도",
"다른 놈들 구하려는 거냐」"
],
"28358": [
"「...의외로 근성 있구먼」"
],
"28359": [
"「비실비실한 낯짝 해 갖고는",
"보기와는 딴판이잖아」"
],
"28360": [
"「아, 네에」"
],
"28361": [
"칭찬받은 건가...?"
],
"28362": [
"「...그래서, 꼬맹아.",
"어떻게든 될 것 같냐」"
],
"28363": [
"「다른 녀석들은",
"구할 수 있겠냐고」"
],
"28364": [
"「어, 아, 자신은 없지만",
"어떻게든 해 보려고...」"
],
"28365": [
"「흥, 뭐...",
"내가 안 뒈졌으니",
"할 수 있으면 해 줘라」"
],
"28366": [
"（어...?）"
],
"28367": [
"창틀 아래쪽에 살짝 젖어서",
"변색된 듯한 자국이 있다."
],
"28368": [
"（...아래쪽에 틈이..）"
],
"28369": [
"창문이 제대로 닫히지 않아",
"창틀에서 조금 떠 있었다.",
"거기로 비가 들이치는 듯하다."
],
"28370": [
"（낡아서 아귀가 안 맞나?）"
],
"28371": [
"하지만 처음부터 이랬다면",
"틈이 벌어진 채로 내버려",
"두진 않겠지."
],
"28372": [
"그럼 여기 창문도 열 수",
"있었다는 건가...?"
],
"28373": [
"어째선지 시신 곁에",
"장미꽃이 놓여 있다."
],
"28374": [
"「저건, 뭐지...?」"
],
"28375": [
"「저거, 온실에 피어 있던",
"거 아닙니까요?」"
],
"28376": [
"「그게 왜 여기에...」"
],
"28377": [
"어째선지 시신 곁에",
"장미꽃이 놓여 있다.",
"온실에 피어 있던 것 같다..."
],
"28378": [
"어째선지 시신 곁에 장미가",
"그려진 그림이 액자째 있다."
],
"28379": [
"「저 그림, 뭐지...?」"
],
"28380": [
"「저거, 응접실에 있던",
"거 아닙니까요?」"
],
"28381": [
"「응접실?」"
],
"28382": [
"「거실 옆에 있는 방이요.",
"저희는 별로 안 씁니다만",
"이런 그림이 있었던 것 같은...」"
],
"28383": [
"어째선지 시신 곁에 장미가",
"그려진 그림이 액자째 있다.",
"응접실에 있던 것 같다..."
],
"28384": [
"융단 위에는 딱히 뭔가",
"쏟아진 흔적은 없는 것 같다."
],
"28385": [
"（어라, 그런데...）"
],
"28386": [
"어쩐지 창문 근처만 이상하게",
"보풀이 인 느낌이다."
],
"28387": [
"뭔가를 쏟고 닦지 않고",
"내버려 둔 것처럼..."
],
"28388": [
"창문 근처만 이상하게",
"보풀이 인 느낌이다."
],
"28389": [
"얼굴은 이미 흙빛이다.",
"방금 막 돌아가신 건",
"아닐 것이다..."
],
"28390": [
"「...어젯밤인가...」"
],
"28391": [
"「돌아가신 게 말이에요.",
"꼬박 하루는 안 지났을 겁니다」"
],
"28392": [
"「어젯밤...」"
],
"28393": [
"「...하루는 지났네요」"
],
"28394": [
"「돌아가신 게 말이에요.",
"어젯밤 같은 건 아닐 겁니다」"
],
"28395": [
"모르는 사이에 이미 돌아가",
"셨다는 거야...?"
],
"28396": [
"얼굴은 이미 흙빛이다.",
"부자연스럽게 젖혀진 채",
"이쪽을 보고 있다..."
],
"28397": [
"이마 한가운데에 화살이 박혀",
"있다. 어디서 이런 게..."
],
"28398": [
"몸은 아무렇게나 내던져진 듯",
"바닥에 쓰러져 있었다."
],
"28399": [
"어째선지 다리가 창 아래 벽에",
"눌려 무릎이 굽어 있다."
],
"28400": [
"바지 주머니에서 뭔가가",
"빠져나올 것 같다."
],
"28401": [
"「저게 뭐지...」"
],
"28402": [
"「...열쇠 아닐까요」"
],
"28403": [
"「열쇠? 아, 그렇구나...」"
],
"28404": [
"「...어느 쪽이지. 쿠라이시 씨,",
"여벌 열쇠도 직접 갖고 계셨지」"
],
"28405": [
"「나머지 하나는... 아, 있다」"
],
"28406": [
"테이블 위 담배를 슥 치우고",
"갑 뒤에 숨은 열쇠를 가리킨다."
],
"28407": [
"「...이거네요.",
"그럼 열쇠는 두 개 다",
"방 안에 있었다는 거네...」"
],
"28408": [
"「그럼, 설마...」"
],
"28409": [
"「창문으로 들어오는 수밖에",
"없다는 거네요」"
],
"28410": [
"문은 안쪽에서 잠겨 있었다."
],
"28411": [
"전기스탠드다.",
"불이 켜진 채다."
],
"28412": [
"발판에 올라간다"
],
"28413": [
"아무것도 안 한다"
],
"28414": [
"「...여긴...?」"
],
"28415": [
"뭔가... 딱 봐도",
"수상한 분위기인데..."
],
"28416": [
"（저 기분 나쁜 인형",
"같은 건 뭐야...）"
],
"28417": [
"이상한 물건이 잔뜩 있는 방에 왔다."
],
"28418": [
"방 안을 둘러본다..."
],
"28419": [
"어쩐지 기분 나쁜 그림이 있다."
],
"28420": [
"（으악, 해골이다.",
"사신인가...?）"
],
"28421": [
"이상하리만치 섬뜩한 터치의",
"무서운 그림이다..."
],
"28422": [
"사신을 그린 그림이 있다."
],
"28423": [
"（해골이니까 사신인가.",
"이건 숨겨 둬야지）"
],
"28424": [
"떼면 저주받을 것 같은",
"그림이라 꽤 신경 쓰이지만..."
],
"28425": [
"호숫가의 성을 그린 풍경화가 있다."
],
"28426": [
"（호숫가의, 성이라...）"
],
"28427": [
"이건 숨기는 게 나을까.",
"소설 속엔 성이 아니라 저택이지만."
],
"28428": [
"（혹시 모르니 떼 두자...）"
],
"28429": [
"（뭐지 이 자루...?）"
],
"28430": [
"나무 상자 안에 먼지가 별로",
"안 쌓인 천 자루가 있었다."
],
"28431": [
"살며시 집어 들고 안을",
"들여다봤다."
],
"28432": [
"뭐지, 이건.",
"돌로 된 말뚝인지 쐐기인지가",
"6개나 들어 있었다."
],
"28433": [
"머리 부분은 빨강과 파랑으로",
"칠해져 있고 번호가 새겨져 있다."
],
"28434": [
"（어디에 쓰는 걸까...?）"
],
"28435": [
"차가운 돌벽이다..."
],
"28436": [
"문이 있다.",
"통로로 나갈 수 있는 문이다."
],
"28437": [
"기묘한 도형이 그려진 원반이",
"있다. 마법진 같다."
],
"28438": [
"기묘한 받침대가 있다."
],
"28439": [
"（저 인형 무서워...）"
],
"28440": [
"램프 4개가 매달려 있다."
],
"28441": [
"이 벽은 숨겨진 문이다..."
],
"28442": [
"이상한 원반과 인형 앞 바닥에",
"한 단 높아진 부분이 있다."
],
"28443": [
"（뭘까, 이거.",
"왠지 발판 같은...）"
],
"28444": [
"이상한 원반과 인형 앞 바닥에",
"한 단 높은 발판이 있다."
],
"28445": [
"마법진 장치를 움직이는 발판이다."
],
"28446": [
"「열렸다...!",
"풀었어...」"
],
"28447": [
"후우 하고 어깨로 숨을 쉰다."
],
"28448": [
"안쪽에도 방이 있는 것 같다.",
"좀 무섭지만 모처럼",
"열렸으니 들어가 보자."
],
"28449": [
"「...몇 번이나",
"저주하게 해서 미안해」"
],
"28450": [
"마법진 위의 인형에게",
"살짝 손을 들어 보이고",
"안쪽 방으로 향한다..."
],
"28451": [
"마다라이 씨의 방 앞이다."
],
"28452": [
"「마다라이 씨... 어라?」"
],
"28453": [
"어쩐지 문이 살짝 열려 있다."
],
"28454": [
"「마다라이 씨?」"
],
"28455": [
"...없다.",
"벌써 일어나셨나."
],
"28456": [
"「마다라이 씨~」"
],
"28457": [
"...아직 안 돌아왔네."
],
"28458": [
"나도 모르게 방 안을",
"둘러보게 된다..."
],
"28459": [
"「...멋대로 봐서",
"죄송해요...」"
],
"28460": [
"일단 합장을 하고 나서",
"방 안을 살펴본다."
],
"28461": [
"「...어라」"
],
"28462": [
"침대 밑에 뭔가 떨어져",
"있는 것 같다."
],
"28463": [
"（뭔가 비틀린 나무 막대",
"같아 보이는데 뭐지?）"
],
"28464": [
"침대 밑에 뭔가 떨어져 있다.",
"손을 뻗어 끄집어내 봤다."
],
"28465": [
"「이거... 지팡이...?」"
],
"28466": [
"책 속에서는 분명 지팡이가",
"흉기였을 거다."
],
"28467": [
"（그럼 이건",
"꼭 숨겨야 해...）"
],
"28468": [
"창문은 닫혀 있었다."
],
"28469": [
"유리 케이스 안에 기타가",
"장식되어 있다."
],
"28470": [
"뭔가 놓여 있다.",
"명함 같다."
],
"28471": [
"（마사키 유키토모...",
"아... 본명 명함이구나）"
],
"28472": [
"（마사키 유키토모...?",
"누구 명함이지）"
],
"28473": [
"램프가 놓여 있다.",
"지금은 꺼져 있다."
],
"28474": [
"심플한 테이블이 있다."
],
"28475": [
"테이블과 세트인 의자다."
],
"28476": [
"방에 딸린 옷장이다."
],
"28477": [
"「죄송해요, 열게요...」"
],
"28478": [
"합장을 하고 나서 옷장을",
"열어 봤다."
],
"28479": [
"낡은 보스턴백이 던져져",
"있었다.",
"마다라이 씨의 짐인 것 같다."
],
"28480": [
"강아지를 안은 여자 그림이 걸려 있다."
],
"28481": [
"커튼이 있다."
],
"28482": [
"미사사기 씨의 방이다."
],
"28483": [
"（계시려나, 미사사기 씨...）"
],
"28484": [
"「네, 누구세요?」"
],
"28485": [
"「이치야나기인데요...」"
],
"28486": [
"「어머, 금방 열게요」"
],
"28487": [
"「어서 와요, 이치야나기 씨.",
"들어오세요」"
],
"28488": [
"「감사합니다.",
"실례하겠습니다」"
],
"28489": [
"「어질러 놔서 미안해요.",
"그러니까... 무슨 일이죠?」"
],
"28490": [
"「저, 이치야나기인데요",
"잠깐 괜찮으세요?」"
],
"28491": [
"「어머...",
"잠시만 기다리세요」"
],
"28492": [
"「어서 와요, 이치야나기 씨.",
"무슨 볼일이라도?」"
],
"28493": [
"「저기, 이치야나기예요.",
"잠깐 괜찮으세요?」"
],
"28494": [
"「...기다려 주세요」"
],
"28495": [
"「어서 와요...",
"미안해요, 저기, 무서워서",
"문을 별로 열고 싶지 않아요...」"
],
"28496": [
"「아, 네, 이대로도 괜찮아요.",
"저기...」"
],
"28497": [
"「죄송해요, 이치야나기인데요」"
],
"28498": [
"「...무슨 일이죠?」"
],
"28499": [
"「죄송하지만, 방 안을",
"좀 봐도 될까요?」"
],
"28500": [
"「어머, 그럴 줄 알았으면",
"좀 더 치워 둘 걸 그랬네요」"
],
"28501": [
"「미안해요,",
"어질러 놓은 채라...」"
],
"28502": [
"「아뇨, 저기,",
"제가 오히려 죄송해요」"
],
"28503": [
"「...정말",
"감사했습니다」"
],
"28504": [
"「어머, 벌써 됐나요?」"
],
"28505": [
"「네, 너무 오래",
"방해하는 것도 좀...」"
],
"28506": [
"「신경 쓰지 말고",
"또 놀러 오세요」"
],
"28507": [
"「감사합니다.",
"그럼 이만」"
],
"28508": [
"「...이제",
"됐을까요」"
],
"28509": [
"「아, 네.",
"감사했습니다」"
],
"28510": [
"「아니에요, 그럼",
"실례할게요」"
],
"28511": [
"「네, 죄송했습니다」"
],
"28512": [
"「...실례할게요」"
],
"28513": [
"「저, 그리고...」"
],
"28514": [
"「방 안을 좀",
"보여 주실 수 있나요?」"
],
"28515": [
"「네, 그러세요」"
],
"28516": [
"「저, 괜찮으시면 방 안을",
"좀 보여 주실 수 있나요?",
"아무것도 안 만질게요」"
],
"28517": [
"「그건, 저...",
"미안해요, 좀...」"
],
"28518": [
"침대는 깔끔하게 정돈되어 있다."
],
"28519": [
"사이드 테이블이다.",
"위에 램프가 놓여 있다."
],
"28520": [
"귀여운 모양의 램프다.",
"지금은 꺼져 있다."
],
"28521": [
"「아, 이치야나기 씨.",
"부탁 좀 해도 될까요」"
],
"28522": [
"「네? 뭔데요?」"
],
"28523": [
"「그 촛대를 테이블 쪽으로",
"조금 옮겨 줄 수 없을까요」"
],
"28524": [
"「직접 옮겨 보려고 했는데",
"무거워서 안 되더라고요」"
],
"28525": [
"「이거... 저, 바닥에",
"고정되어 있는 것 같은데요」"
],
"28526": [
"「무거운 게 아니라",
"애초에 안 움직이는 게 아닐지」"
],
"28527": [
"「어, 아... 그, 그랬",
"던 거예요...?」"
],
"28528": [
"「어머나, 저는 그만",
"엄청 무거운 줄로만...」"
],
"28529": [
"미사사기 씨는 쑥스러운 듯",
"눈을 돌렸다."
],
"28530": [
"커다란 촛대가 있다.",
"바닥에 붙박이로 되어 있는 듯하다."
],
"28531": [
"붙박이 옷장이다."
],
"28532": [
"캐비닛이 있다."
],
"28533": [
"교회 같은 건물이 그려진",
"그림이 걸려 있다."
],
"28534": [
"테이블 위에는 휴대폰과",
"작은 약통이 놓여 있었다."
],
"28535": [
"「미안해요, 어질러 놔서」"
],
"28536": [
"내 시선을 눈치챘는지 미사사기",
"씨는 허둥지둥 가방에 넣었다."
],
"28537": [
"「네?",
"아뇨, 그런, 전혀요」"
],
"28538": [
"이게 어질러진 거라면",
"내 방은..."
],
"28539": [
"쿠션이 좋아 보이는 소파다."
],
"28540": [
"베란다로 나가는 문이다.",
"지금은 닫혀 있다."
],
"28541": [
"「어, 이거... 총이에요!?」"
],
"28542": [
"「깜짝 놀랐죠?",
"저도 놀랐는데,",
"그 장식장은 안 열리나 봐요」"
],
"28543": [
"「...아, 정말이다.",
"여는 곳이 없네요」"
],
"28544": [
"「그렇죠?",
"츠바키 씨께 여쭤 보니",
"그냥 장식이래요」"
],
"28545": [
"장식장 안에 총이 있다.",
"이 장식장은 열 수 없는 것 같다."
],
"28546": [
"여기는 헛간이다."
],
"28547": [
"（뭔가 이것저것 있네...）"
],
"28548": [
"커다란 나무 상자가 있다."
],
"28549": [
"열어 보니 안 쓰는 쿠션을",
"넣어 둔 것 같았다."
],
"28550": [
"（흐음, 가죽 쿠션까지 있네.",
"넣어 두다니 아깝다）"
],
"28551": [
"커다란 상자 안에 안 쓰는",
"쿠션이 잔뜩 들어 있었다."
],
"28552": [
"「있다, 가죽 쿠션!」"
],
"28553": [
"있는 대로 숨겨 두자."
],
"28554": [
"커다란 상자 안에 안 쓰는",
"쿠션이 잔뜩 들어 있다."
],
"28555": [
"（뭐가 들어 있으려나.",
"어디 보자...）"
],
"28556": [
"양초가 잔뜩 든 상자와",
"안 쓰는 램프 같은 것들이었다."
],
"28557": [
"나무 상자를 뒤지니 양초가 나왔다."
],
"28558": [
"（있다 있어.",
"이건 숨겨 둬야지）"
],
"28559": [
"안 쓰는 램프 등이 든",
"골판지 상자다."
],
"28560": [
"커다란 선반이 있다.",
"열어 보니 안 쓰는 우산 등이",
"들어 있는 것 같다."
],
"28561": [
"커다란 선반이 있다."
],
"28562": [
"（아, 우산이다.",
"하얀 건... 있다!）"
],
"28563": [
"하얀 양산...",
"이건 숨겨 둬야지."
],
"28564": [
"벽을 따라 선반이 늘어서 있다.",
"잡동사니만 놓여 있는",
"것 같은데..."
],
"28565": [
"（...뭔가 하나만",
"이상하게 튀는 게 있어...）"
],
"28566": [
"왠지 놓여 있는 복고양이...",
"신경 쓰여서 집어 들고 말았다."
],
"28567": [
"（왜 금화에 『승리』...?）"
],
"28568": [
"선반 안에는 자잘한 물건들이",
"들어 있다."
],
"28569": [
"낮은 서랍장이 있다.",
"주로 지도 같은 게 든 것 같다."
],
"28570": [
"낮은 서랍장이 있다."
],
"28571": [
"「이건... 간사이 지도인가」"
],
"28572": [
"세토 내해가 무대인 이야기니까",
"이건 일단 숨겨 두자..."
],
"28573": [
"낮은 서랍장이 있다.",
"열어 봤지만 여분의 시트 등이",
"잔뜩 들어 있을 뿐이었다."
],
"28574": [
"서랍 안은 여분의 시트 등이다."
],
"28575": [
"벽에 불이 켜져 있다."
],
"28576": [
"여기는 2층 창고다."
],
"28577": [
"「뭐가 있으려나...」"
],
"28578": [
"항아리가 놓여 있다.",
"이상한 모양이다..."
],
"28579": [
"「있다! 이상한 항아리!」"
],
"28580": [
"이건 충분히 『기묘한 항아리』지.",
"좋아, 숨겨 버리자."
],
"28581": [
"이상한 모양의 항아리다."
],
"28582": [
"이 나무 상자는 뭘까..."
],
"28583": [
"「뭔가, 꽤 귀여운 무늬의",
"커튼이랑 시트랑...」"
],
"28584": [
"꽃무늬니 물방울무늬니 귀여운",
"커튼과 시트가 들어 있었다."
],
"28585": [
"나무 상자가 있다.",
"안에는 꽃무늬, 물방울무늬",
"커튼과 시트가 가득하다."
],
"28586": [
"「어디 보자...",
"아, 이 커튼 벚꽃 무늬다」"
],
"28587": [
"이건 일단 숨겨 두자."
],
"28588": [
"커다란 나무 상자다.",
"안에는 꽃무늬, 물방울무늬",
"커튼과 시트가 가득하다."
],
"28589": [
"먼지투성이 선반이다.",
"안 쓰는 식기 등이 상자에",
"든 채 놓여 있는 것 같다."
],
"28590": [
"（접시는 상관없겠지.",
"어디, 이쪽은...）"
],
"28591": [
"「아, 와인 잔이다!」"
],
"28592": [
"이건 숨겨 두자."
],
"28593": [
"서랍이 잔뜩 달린",
"커다란 선반이 있다."
],
"28594": [
"（이 선반은...）"
],
"28595": [
"손전등과 건전지가 든 상자가",
"놓여 있었다."
],
"28596": [
"손전등과 건전지가 든 상자가",
"놓여 있다."
],
"28597": [
"（...뭐야.",
"거의 빈 상자네...）"
],
"28598": [
"이 선반에 든 상자는 거의",
"텅 비어 있었다."
],
"28599": [
"서랍이 늘어선 선반이 있다.",
"열어서 안을 봤다."
],
"28600": [
"「뭐지, 이거.",
"모형...?」"
],
"28601": [
"유리에 금이 간 액자 안에",
"뭔가가 들어 있다."
],
"28602": [
"「...이거, 활...?」"
],
"28603": [
"총처럼 방아쇠를 당겨 쏘는 활이다.",
"보우건이라고 했던가."
],
"28604": [
"액자가 망가져서 안 걸어",
"둔 거겠지만..."
],
"28605": [
"（이거, 진짜 쏠 수 있나...）"
],
"28606": [
"서랍을 열어 본다."
],
"28607": [
"「으악, 이거...」"
],
"28608": [
"유리에 금이 간 액자.",
"그 안에 험악한 무기가 들어 있다."
],
"28609": [
"「보우건도... 방아쇠 당겨서",
"쏘는 거니까... 사살이 되겠지」"
],
"28610": [
"이건 무조건 위험해. 숨기자."
],
"28611": [
"「있다...」"
],
"28612": [
"선반 서랍을 열어 봤다."
],
"28613": [
"유리가 깨진 액자, 그 안에..."
],
"28614": [
"（...보우건...）"
],
"28615": [
"험악한 그 활에는 화살이",
"메겨져 있지 않았다."
],
"28616": [
"「앗!",
"이, 이거...」"
],
"28617": [
"유리가 깨진 액자 안에",
"보우건이 들어 있었다.",
"그런데, 화살이..."
],
"28618": [
"（화살이 없어...",
"쿠라이시 씨를 쏜 게, 이건가..?）"
],
"28619": [
"보우건이 들어 있다.."
],
"28620": [
"이 선반 서랍에 있던",
"보우건은 숨겨 뒀다.."
],
"28621": [
"불이 켜져 있다."
],
"28622": [
"화살 없는 보우건이 들어 있다.."
],
"28623": [
"1층 창고에 왔다."
],
"28624": [
"먼지 낀 창고 안을 둘러본다..."
],
"28625": [
"서랍이 잔뜩 달린",
"커다란 선반이 있다."
],
"28626": [
"시계니 옷걸이니 안 쓰는 물건을",
"대충 넣어 둔 것 같다."
],
"28627": [
"안 쓰는 물건들이 대충",
"채워져 있다."
],
"28628": [
"「아, 벽시계가 있다」"
],
"28629": [
"멈춰 있는 것 같지만",
"숨겨 두는 게 낫겠지."
],
"28630": [
"선반 안의 상자를 열어 봤다."
],
"28631": [
"「뭔가 이것저것 들어 있네...」"
],
"28632": [
"잘 모를 민예품 같은 것과",
"풍경 등이 뒤죽박죽 있었다."
],
"28633": [
"민예품이니 풍경이니",
"지금은 장식하지 않는 물건을",
"넣어 둔 선반인 것 같다."
],
"28634": [
"안 쓰는 담요 등이",
"들어 있는 것 같다."
],
"28635": [
"서랍 달린 선반이 있다."
],
"28636": [
"（뭐가 들어 있으려나...?）"
],
"28637": [
"열어 봤지만 헌 옷 같은 게",
"잔뜩 들어 있을 뿐이었다."
],
"28638": [
"헌 옷이 가득 든 서랍장이다"
],
"28639": [
"「...목마?」"
],
"28640": [
"아이가 타고 노는 작은 목마였다.",
"꽤 낡았다."
],
"28641": [
"（옛날엔 어린아이가 있었나,",
"이 저택에...）"
],
"28642": [
"낡은 목마가 놓여 있다."
],
"28643": [
"나무 상자를 들여다봤다.",
"안에는 잡다한 물건들이",
"뒤죽박죽 들어 있다."
],
"28644": [
"「남는 장식품 같은 건가」"
],
"28645": [
"작은 꽃병이나 청동 개,",
"하트 방패 같은 것까지 있다."
],
"28646": [
"「어디, 꽃병은 상관없고",
"이것도 아니고... 아, 이건?」"
],
"28647": [
"하트 무늬 방패 같은 장식품이",
"있다. 작은 글씨가 새겨져 있다."
],
"28648": [
"「퀸 오브 하트인가.",
"...하트의 여왕?」"
],
"28649": [
"트럼프의 12, 맞지.",
"이거 숨기는 게 나을까."
],
"28650": [
"（놔뒀다가 쓰이면",
"싫으니까 숨겨 두자...）"
],
"28651": [
"이 상자에는 남는 장식품이",
"뒤죽박죽 채워져 있다."
],
"28652": [
"「엄청 큰 항아리...」"
],
"28653": [
"들여다봤지만 안에는",
"먼지만 쌓여 있었다."
],
"28654": [
"「이 무지막지하게 큰 항아리는...」"
],
"28655": [
"숨기는 게 낫겠지.",
"큰 항아리는 대놓고 책 속에",
"나오니까."
],
"28656": [
"「들고 가기 힘들겠지만",
"어쩔 수 없지...」"
],
"28657": [
"무지막지하게 큰 항아리다."
],
"28658": [
"왜 이런 곳에 구멍이",
"뚫려 있는 걸까."
],
"28659": [
"파랗게 테두리가 쳐져 있으니",
"그냥 부서진 건 아닌 것 같은데."
],
"28660": [
"（이상하네...）"
],
"28661": [
"벽에 파란 테두리 구멍이 있다."
],
"28662": [
"나스 씨의 방 앞이다."
],
"28663": [
"나스 씨의 방은 문이",
"잠겨 있다..."
],
"28664": [
"「나스 씨, 계시려나?」"
],
"28665": [
"역시 아직 안 돌아온 것 같다."
],
"28666": [
"「네~?",
"야아, 나고무 군이구나!」"
],
"28667": [
"「나, 나스 씨...",
"저기...」"
],
"28668": [
"「응? 무슨 일이야?」"
],
"28669": [
"「이상한 사람이 돌아다닐지도",
"모르니까, 누군지도",
"확인 안 하고 열면 안 돼요」"
],
"28670": [
"「아아, 그렇구나.",
"그것도 그렇네, 조심할게」"
],
"28671": [
"...금방 잊어버릴 것 같은 건",
"내 기분 탓일까."
],
"28672": [
"문도 안 잠갔던 것 같고",
"말이야..."
],
"28673": [
"「....저기, 나스 씨」"
],
"28674": [
"「그, 방 안에 있는...",
"커다란 기계 같은 건",
"원래 여기 있던 거예요?」"
],
"28675": [
"「아니, 이건 내 거야.",
"없으면 불안해서",
"집에서 가져왔지」"
],
"28676": [
"「가, 가져...",
"오신 거예요...」"
],
"28677": [
"「그, 구석에 있는",
"덤벨도요?」"
],
"28678": [
"「응, 맞아.",
"근데 기계 쪽은",
"둘 데가 없어서 말이야...」"
],
"28679": [
"「이 방에 있던 가구를",
"복도에 내놓게 해 줬지 뭐야」"
],
"28680": [
"복도에 덩그러니 하나만",
"놓여 있던 가구가 여기 거구나..."
],
"28681": [
"「어디 보자, 그래서",
"왜 온 거였지?」"
],
"28682": [
"「러닝 시간도 아니고",
"프로틴은 아까 마셨고...」"
],
"28683": [
"「저, 그런 게 아니라",
"좀 묻고 싶은 게 있어서요」"
],
"28684": [
"「아, 그래?",
"뭔데?」"
],
"28685": [
"「...그러니까...」"
],
"28686": [
"「야아, 나고무 군!」"
],
"28687": [
"「나스 씨, 저기...",
"경계하시라니까요...」"
],
"28688": [
"「아, 깜빡했다!",
"미안미안, 조심할게」"
],
"28689": [
"...말한 즉시 잊어버린 것 같다."
],
"28690": [
"「어디, 그래서 뭐였지?」"
],
"28691": [
"「누구야~?」"
],
"28692": [
"「나고무예요, 잠깐 괜찮으세요?」"
],
"28693": [
"「아아, 나고무 군이구나」"
],
"28694": [
"「야아, 무슨 일이야?」"
],
"28695": [
"「저, 나고무인데요」"
],
"28696": [
"「아... 잠깐 기다려」"
],
"28697": [
"「무슨 일이야?」"
],
"28698": [
"「저, 방 안을 좀",
"봐도 될까요?」"
],
"28699": [
"「아아, 좋아.",
"근력 운동 해 보고 싶어?」"
],
"28700": [
"「아뇨!",
"제 방이랑 어떻게 다른지",
"보고 싶을 뿐이에요!!」"
],
"28701": [
"「흐음?",
"뭐 됐어, 들어와」"
],
"28702": [
"「죄송해요,",
"또 방 안을 보고 싶은데요」"
],
"28703": [
"「좋아, 들어와」"
],
"28704": [
"「저, 방 안을 좀",
"보여 주실 수 있나요?」"
],
"28705": [
"「아~, 미안!",
"지금 좀 어질러 놔서 말이야」"
],
"28706": [
"억지로 부탁할 수는 없으니",
"어쩔 수 없나."
],
"28707": [
"「...저, 그리고",
"말인데요」"
],
"28708": [
"「...그건 그렇고,",
"나고무 군, 근육 좀 더 안 붙일래?」"
],
"28709": [
"「조금만 더 단련하면",
"꽤 멋진 체형이 될 것",
"같단 말이지」"
],
"28710": [
"「어, 아, 그게」"
],
"28711": [
"「원한다면 내가 지도를...」"
],
"28712": [
"「죄, 죄송해요!",
"어, 저, 저기, 이다음에도 볼일이」"
],
"28713": [
"「네!",
"시, 실례하겠습니다!!」"
],
"28714": [
"붙잡히면 큰일 난다.",
"허둥지둥 뒷걸음질 쳐서",
"나스 씨의 방에서 도망쳤다..."
],
"28715": [
"「...그러고 보니,",
"나고무 군 턱걸이 할 줄 알아?」"
],
"28716": [
"갑자기 무슨 소리를...",
"왠지 불길한 예감이 든다."
],
"28717": [
"「아니, 왠지",
"못할 것 같아서」"
],
"28718": [
"「모, 못해요, 네」"
],
"28719": [
"「...한번 해 보지 않을래?」"
],
"28720": [
"「방에서요!?",
"아, 아뇨, 저기, 사, 사양",
"할게요... 네」"
],
"28721": [
"했다간 틀림없이 근육통으로",
"큰일 날 거다..."
],
"28722": [
"애매하게 웃어넘기며 허둥지둥",
"인사하고 방에서 도망쳤다."
],
"28723": [
"「...그건 그렇고,",
"지금은 트레이닝할 시간 없어?」"
],
"28724": [
"「죄, 죄송해요,",
"아직 다른 볼일이...」"
],
"28725": [
"「그래, 아쉽네」"
],
"28726": [
"「그, 그럼 이만...」"
],
"28727": [
"슬금슬금 뒷걸음질 쳐 방을 나왔다."
],
"28728": [
"「...이제 됐을까.",
"복근 운동 하던 중이었거든」"
],
"28729": [
"「미안, 또 봐」"
],
"28730": [
"「...이제 됐을까.",
"스쿼트 하던 중이었거든」"
],
"28731": [
"「미안해, 또 봐」"
],
"28732": [
"「...이제 됐을까.",
"손가락 팔굽혀펴기 하던 중이었거든」"
],
"28733": [
"일부러 가져온 듯한",
"트레이닝 기계가 있다."
],
"28734": [
"（어디에 앉아서 어떻게 쓰는지도",
"모르겠어...）"
],
"28735": [
"선반 위에는 운동 기구 카탈로그나",
"소품이 널려 있다."
],
"28736": [
"풍경화다.",
"외국 바닷가 같다."
],
"28737": [
"여러 가지 보충제가 놓여 있다."
],
"28738": [
"무거워 보이는 덤벨이 굴러다닌다."
],
"28739": [
"램프가 놓여 있다.",
"지금은 꺼져 있다."
],
"28740": [
"「맞다, 나고무 군.",
"내가 뭐 도울 거 없어?」"
],
"28741": [
"「도울 거요?」"
],
"28742": [
"「응, 범인이랑 싸운다든가」"
],
"28743": [
"「왜 갑자기",
"싸우는 건데요!?」"
],
"28744": [
"「지금도 물건 숨기거나",
"범인이 하는 짓 막으려고",
"이것저것 하는 거 아냐?」"
],
"28745": [
"「나도 도움받았으니까",
"뭐 도울 게 없나 해서」"
],
"28746": [
"「근데 추리는 영 꽝이라",
"도움 될 만한 건",
"범인 때려잡는 정도일까 하고」"
],
"28747": [
"「저... 저기요,",
"범인은 아직 누군지",
"모르니까...」"
],
"28748": [
"「만약 붙잡아야 하게",
"되면 부탁드릴게요」"
],
"28749": [
"「그래, 알았어.",
"맡겨만 줘!」"
],
"28750": [
"「만약 범인이 날뛰기라도 하면",
"바로 나한테 알려.",
"쓰러뜨려 줄 테니까」"
],
"28751": [
"...범인이 날뛰지 않기를."
],
"28752": [
"「맞다, 나고무 군",
"괜찮은 거야?」"
],
"28753": [
"「범인이 너한테 뭔가",
"못된 짓 안 했나 싶어서」"
],
"28754": [
"「모, 못된 짓이라니, 저기」"
],
"28755": [
"「그치만 나고무 군은 계속",
"범인이랑 싸우고 있잖아」"
],
"28756": [
"「방해받아서 화난",
"범인한테 습격당하지",
"않을까 걱정이야」"
],
"28757": [
"「...지금으로선",
"괜찮아요」"
],
"28758": [
"「그래, 그럼 됐지만」"
],
"28759": [
"「혹시 뭔가 위험할 것 같으면",
"언제든 불러 줘?」"
],
"28760": [
"「범인이든 곰이든",
"내가 쓰러뜨려 줄 테니까」"
],
"28761": [
"왜 곰...?"
],
"28762": [
"「...저기, 나고무 군」"
],
"28763": [
"「원래라면 이제 곧 촬영이",
"끝나서 돌아갈 날이지」"
],
"28764": [
"「아... 네,",
"그렇죠...」"
],
"28765": [
"「그렇게 되면 범인은",
"어쩔 셈일까?」"
],
"28766": [
"「설마 시간 초과로",
"노 사이드는 아니겠지」"
],
"28767": [
"「그렇게 신사적일 리가",
"없잖아요...」"
],
"28768": [
"「그럼 역시...」"
],
"28769": [
"「...나고무 군,",
"만일의 때는 사양 말고",
"뭐든 의지해 줘?」"
],
"28770": [
"「설령 범인이 권총이나",
"대포를 꺼내 들어도",
"사양하지 마?」"
],
"28771": [
"「아니, 그건 저기」"
],
"28772": [
"「괜찮아,",
"반드시 이길 테니까!」"
],
"28773": [
"「좋아, 약속이다」"
],
"28774": [
"하는 말은 꽤나",
"엉뚱하지만,",
"걱정해 주는 거겠지."
],
"28775": [
"（...어떻게든",
"다 같이 이 저택을",
"나갈 수 있으면 좋겠다...）"
],
"28776": [
"「위험한 짓 안 하고 있어?」"
],
"28777": [
"「복도에서 망을 본다든가",
"범인한테 결투를 신청한다든가」"
],
"28778": [
"「시, 신청 안 해요.",
"안 한다니까요」"
],
"28779": [
"「그래.",
"위험한 짓은 하지 마」"
],
"28780": [
"잘은 모르겠지만",
"걱정해 주는 건가."
],
"28781": [
"「아, 맞다」"
],
"28782": [
"「범인은 나고무 군한테는",
"아무 짓도 안 해?」"
],
"28783": [
"「저한테요?」"
],
"28784": [
"「방해한 앙갚음이라든가」"
],
"28785": [
"「지, 지금으로선",
"직접 뭘 당하진 않았어요」"
],
"28786": [
"「그래, 다행이다.",
"안심했어」"
],
"28787": [
"「그래도 방심하진 마」"
],
"28788": [
"「네, 조심할게요」"
],
"28789": [
"「저기, 나고무 군.",
"내가 한 번 더 벼랑 무너진 데",
"보고 오는 게 나을까」"
],
"28790": [
"「그게 말이야, 원래라면",
"이제 곧 촬영이 끝나서",
"돌아갈 날이잖아?」"
],
"28791": [
"「근데 벼랑이 무너진 채면",
"마중도 못 오겠지만",
"범인도 도망 못 가잖아」"
],
"28792": [
"「그런 상황에서",
"범인이 죽이려다 실패한",
"우리가 살아 있다는 건...」"
],
"28793": [
"「뭔가 자포자기해서",
"위험한 짓 하지 않을까",
"걱정인데」"
],
"28794": [
"「위험한 짓?」"
],
"28795": [
"「저택에 불을 지른다든가",
"보일러를 폭발시킨다든가」"
],
"28796": [
"「그런!?」"
],
"28797": [
"「나야 그렇다 쳐도",
"나고무 군 같은 애들은",
"도망칠 길을 확보해 둬야지?」"
],
"28798": [
"「그렇다 쳐도라뇨, 나스 씨",
"보일러가 폭발하면",
"어쩌실 건데요?」"
],
"28799": [
"「...기합으로 어떻게든...」"
],
"28800": [
"「하지 마세요!!",
"제발 부탁이니까 그런",
"위험한 쪽으로 가지 마세요!」"
],
"28801": [
"「으음, 그럼",
"어떻게 할 건데?」"
],
"28802": [
"「저, 그러니까,",
"어떻게든 해 볼게요」"
],
"28803": [
"「제가 힘낼 테니까",
"조금만 더 방에서",
"참고 계세요」"
],
"28804": [
"「...그래?",
"그래도 이제 시간이",
"없는 것 같은데」"
],
"28805": [
"「네, 네, 힘낼게요」"
],
"28806": [
"「혹시 뭔가랑 싸우거나",
"쓰러뜨려야 하게",
"되면 불러 줘?」"
],
"28807": [
"「부를게요,",
"그때는 꼭 의지할게요」"
],
"28808": [
"「응, 맡겨 줘!」"
],
"28809": [
"...오랫동안 방에서",
"못 나가서 스트레스가",
"한계인 걸지도..."
],
"28810": [
"（빨리 어떻게든 안 하면",
"진짜로 걸어서 산을",
"내려가려 할지도...）"
],
"28811": [
"두 눈이 멍하니 뜨인 채다..."
],
"28812": [
"몸은 엎드려 쓰러져 있고, 두 손은",
"뭔가를 붙잡으려는 듯",
"융단에 손톱을 세우고 있다."
],
"28813": [
"앞으로 고꾸라져서인지 다리가",
"부자연스럽게 굽어 있다."
],
"28814": [
"나스 씨가 토한 피다..."
],
"28815": [
"페트병 차가 융단에",
"스며들어 있다."
],
"28816": [
"페트병이 굴러가 안의 차가",
"쏟아져 있다..."
],
"28817": [
"（이걸 마시자마자",
"나스 씨는...）"
],
"28818": [
"트레이닝 기계다.",
"나스 씨가 가져온 것이겠지."
],
"28819": [
"페트병 속 차가 융단에 스며 있다.",
"군데군데 붉은 건 나스 씨가",
"토한 피가 섞였기 때문이겠지."
],
"28820": [
"디버그용 입실 상자"
],
"28821": [
"지하로 내려가 봤다."
],
"28822": [
"바닥은 의외로 깨끗하다.",
"보일러실에 가느라 사람이",
"꽤 지나다녀서일까."
],
"28823": [
"1층으로 올라가는 계단이다."
],
"28824": [
"문이 있다.",
"이 너머에 보일러실이 있다."
],
"28825": [
"창고 문이다."
],
"28826": [
"큼직한 공구 상자가",
"놓여 있었다."
],
"28827": [
"열어 보니 펜치와 망치가",
"뒤죽박죽 들어 있다."
],
"28828": [
"「응?",
"뭔가 종이가... 영수증?」"
],
"28829": [
"공구 위에 영수증 한 장이",
"아무렇게나 올려져 있었다."
],
"28830": [
"사 온 공구를 넣을 때",
"상자 안에 떨어뜨린 걸까."
],
"28831": [
"「자재비? 공구 값이 아니네」"
],
"28832": [
"「...어라,",
"이 날짜는...」"
],
"28833": [
"연도 부분이 물에 젖었는지 번져서",
"읽기 힘들지만, 간신히 올해인",
"것 같다는 건 알겠다."
],
"28834": [
"（...그럼 이 날짜는",
"우리가 이 저택에 오기 이틀 전이야）"
],
"28835": [
"（그렇게 최근에 자재를 쓸 만한",
"개조나 보강을 한 흔적은",
"못 봤는데）"
],
"28836": [
"자세히 보면 공구 상자 자체는 꽤",
"낡은 상자고 안의 공구도 대부분",
"오래 쓴 물건인데..."
],
"28837": [
"（몇 개는 묘하게 새 공구야.",
"하지만 자재비라면 이 영수증은",
"공구 게 아닐 텐데...）"
],
"28838": [
"누가 뭘 사서 어디에 쓴 걸까.",
"그것도 최근 며칠 사이라니..."
],
"28839": [
"「아, 송곳이다.",
"이건 숨겨 둬야지...」"
],
"28840": [
"공구 상자에서 송곳을 빼내",
"가져가기로 한다."
],
"28841": [
"커다란 공구 상자가 놓여 있다."
],
"28842": [
"「...아, 망치다」"
],
"28843": [
"맞다, 뚜껑을 못으로 박아서",
"못 열게 하면 될지도."
],
"28844": [
"（어디, 못이랑 망치랑...）"
],
"28845": [
"한 벌 빌려 가자."
],
"28846": [
"내려가 본다"
],
"28847": [
"지하로 내려간다"
],
"28848": [
"지금은 안 내려간다"
],
"28849": [
"온실에 왔다."
],
"28850": [
"울창한 온실 안을 둘러본다."
],
"28851": [
"「...읏!?",
"어, 고, 고양이...?」"
],
"28852": [
"「장식품 같은뎁쇼」"
],
"28853": [
"「아, 아아... 정말이네.",
"근데 왜 이런 데에...」"
],
"28854": [
"온실 바닥에 덩그러니 장식할",
"물건은 아니겠지, 보통은."
],
"28855": [
"（...게다가...）"
],
"28856": [
"（고양이 밑에 깔려 있는",
"저 종이...）"
],
"28857": [
"빨간 글씨로 『복수』라고 쓰여 있었다."
],
"28858": [
"『복수』 종이와 고양이 장식품.",
"그 옆에 하나 더..."
],
"28859": [
"「뭐지 이건...",
"종? 벨?」"
],
"28860": [
"장난감 벨 같은 게 놓여 있었다."
],
"28861": [
"『복수』 글자 주위에는",
"검은 고양이 장식품과 벨이 있다."
],
"28862": [
"「또 늘었어...」"
],
"28863": [
"빨간 『복수』 글자 주위에는",
"검은 고양이와 벨에 이어 이번엔",
"커다란 못이 놓여 있었다."
],
"28864": [
"『복수』라고 쓰인 종이 옆에",
"검은 고양이, 벨, 큰 못이 있다."
],
"28865": [
"「이번엔 장갑...?」"
],
"28866": [
"『복수』 글자 주위에",
"하얗고 긴 장갑이 놓여 있었다."
],
"28867": [
"가련한 디자인이라 더더욱",
"지독하게 어울리지 않는다..."
],
"28868": [
"『복수』라고 쓰인 종이 주위에",
"검은 고양이, 벨, 큰 못,",
"하얀 장갑이 늘어 있다."
],
"28869": [
"「도끼다...!」"
],
"28870": [
"또 물건이 늘어 있었다.",
"게다가 이번엔 손도끼였다."
],
"28871": [
"의미를 모를 물건도 싫지만,",
"이렇게 딱 봐도 위험한 건",
"더 기분 나쁘다..."
],
"28872": [
"『복수』라고 쓰인 종이 옆에는",
"검은 고양이, 벨, 못, 장갑,",
"게다가 손도끼까지 놓여 있다."
],
"28873": [
"『복수』라고 쓰인 종이 옆에는",
"검은 고양이 장식품, 벨, 못,",
"장갑이 놓여 있다."
],
"28874": [
"『복수』 글자 주위에는",
"역시 또 물건이 늘어 있었다."
],
"28875": [
"（그런데, 뭐지 이건...?）"
],
"28876": [
"작은 격자... 울타리 같은데.",
"뭔가를 두르는 것의 일부일까."
],
"28877": [
"빨간 『복수』 글자를 둘러싸듯",
"여러 물건이 놓여 있다.",
"작은 울타리 같은 게 늘었다."
],
"28878": [
"「아, 도끼라면...」"
],
"28879": [
"여기 있는 손도끼도 일단 도끼지.",
"이건 이것대로 숨기는 게",
"나을까..."
],
"28880": [
"（...여기 놓인 걸 흉기로",
"쓸지는 모르겠지만...）"
],
"28881": [
"내버려 두기도 걱정되니",
"숨겨 버릴까."
],
"28882": [
"손전등이다.",
"천장에 매달려서",
"흔들흔들 흔들리고 있다..."
],
"28883": [
"손전등이다.",
"천장에 끈으로 매달려 있다."
],
"28884": [
"유리창에는 계속 내리는 빗물이",
"쉴 새 없이 흘러내리고 있다."
],
"28885": [
"화분이 늘어서 있다."
],
"28886": [
"（장미꽃인가...）"
],
"28887": [
"평소 같으면 예뻤겠지만",
"지금은 왠지 섬뜩하다..."
],
"28888": [
"「있다, 장미다...」"
],
"28889": [
"모처럼 예쁘게 피었는데",
"미안하지만 숨겨야 해..."
],
"28890": [
"「미안해...」"
],
"28891": [
"이 꽃...",
"근처 화단에서 떨어진 줄 알았는데",
"주변에 같은 꽃이 안 보인다."
],
"28892": [
"（저절로 떨어진 게",
"아닌 건가...?）"
],
"28893": [
"줄기와 이어져 있던 부분도",
"아무래도 저절로 떨어진 게",
"아니라 뜯어낸 것 같다."
]
}