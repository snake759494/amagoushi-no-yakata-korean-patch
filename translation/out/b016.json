 ],
 "9114": [
  "「그래도 그걸 빼더라도",
  "본인 행동에 잘 모르겠는",
  "부분이 있었으니까」"
 ],
 "9115": [
  "「본인의 행동?」"
 ],
 "9116": [
  "「기모노 씨,",
  "왜 계속 서재에 있었어?」"
 ],
 "9117": [
  "「낮에 돌아다니거나",
  "얘기하러 오거나 한 건",
  "오빠뿐이었던 건 왜?」"
 ],
 "9118": [
  "「...그건, 저기",
  "처음 서재에서 상의했을 때",
  "히오리가 그게 낫다고」"
 ],
 "9119": [
  "「둘이면 눈에 띄고",
  "내가 덜 경계받으니까",
  "부탁한다고 해서...」"
 ],
 "9120": [
  "「...고마워.",
  "그걸로 알았어」"
 ],
 "9121": [
  "「아, 알았어?」"
 ],
 "9122": [
  "「모르겠어?」"
 ],
 "9123": [
  "「으, 응.",
  "그치만 그 탓에 히오리만",
  "수상해 보였던 거잖아?」"
 ],
 "9124": [
  "「그러니까, 라고 생각해」"
 ],
 "9125": [
  "「...그러니까...?」"
 ],
 "9126": [
  "「처음엔 오빠랑 기모노 씨",
  "둘 다 제일 수상했어」"
 ],
 "9127": [
  "「마다라이 씨가 죽었을 때",
  "둘한테만 딱 좋게 알리바이가",
  "있었으니까」"
 ],
 "9128": [
  "「아~, 확실히 처음엔",
  "너희 둘이 처음부터",
  "짠 건가 싶었지」"
 ],
 "9129": [
  "「...그럼",
  "설마...」"
 ],
 "9130": [
  "「만약 그 뒤로도 오빠랑",
  "기모노 씨가 계속",
  "같이 행동했다면...」"
 ],
 "9131": [
  "「나, 도...",
  "계속 의심받았을...?」"
 ],
 "9132": [
  "「그러고 보니 어느새",
  "오빠만은 왠지",
  "범인이 아닐 것 같았어」"
 ],
 "9133": [
  "「그렇게 되도록",
  "유도한 사람이 있었으니까」"
 ],
 "9134": [
  "「...일지도 몰라」"
 ],
 "9135": [
  "「라는 추리일 뿐.",
  "증명은 못 하는걸」"
 ],
 "9136": [
  "「흥...",
  "정말 하나같이」"
 ],
 "9137": [
  "「뭐~ 어때.",
  "괴로운 얘기로만 끝나는 것보단.",
  "그치, 오빠?」"
 ],
 "9138": [
  "「...그럼",
  "저걸로 힐링해 보든가」"
 ],
 "9139": [
  "「어떻게든 못 싣나」"
 ],
 "9140": [
  "「안 된다고 했잖아!",
  "근력 운동 도구는 나중에 회수해!",
  "우리가 대피하는 게 먼저라고!!」"
 ],
 "9141": [
  "「그럼 덤벨만?",
  "곤란한데...」"
 ],
 "9142": [
  "「으아악!!",
  "이제 넌 덤벨 짊어지고",
  "걸어서 내려가!!」"
 ],
 "9143": [
  "「뭐...",
  "음침하게 가라앉아 있는 것보단",
  "나을지도 모르지만...」"
 ],
 "9144": [
  "「저거, 진짜로 걸어 내려갈지도",
  "모르니까 말리는 게...」"
 ],
 "9145": [
  "「...우리보다 먼저",
  "내려가서 기다리고 있으면 어쩌지」"
 ],
 "9146": [
  "...있을 법하게 느껴져서",
  "싫다..."
 ],
 "9147": [
  "「근데 우리 짐도",
  "아직 방에 있어」"
 ],
 "9148": [
  "「가지러 가도",
  "되려나?」"
 ],
 "9149": [
  "「그 근처 형사한테",
  "물어보고 올까...」"
 ],
 "9150": [
  "「왜 가고 싶어 하는 거야",
  "언니는...」"
 ],
 "9151": [
  "「뭐야, 또 시끄럽다 싶더니",
  "역시 그 두 사람입니까」"
 ],
 "9152": [
  "「...나스 씨가 걸어 내려가려고",
  "하면 같이 말려 줘」"
 ],
 "9153": [
  "「무슨 소릴 하시는지...",
  "뭐, 설마 경찰이 말리겠죠」"
 ],
 "9154": [
  "「그보다 여기, 나고 씨 짐",
  "이것뿐이면 됐습니까?」"
 ],
 "9155": [
  "「아, 가져와 줬구나?",
  "응, 다 있어, 고마워」"
 ],
 "9156": [
  "「뭘요, 겸사겸사죠」"
 ],
 "9157": [
  "「...저기, 히오리」"
 ],
 "9158": [
  "「물건 찾는 것도 사람들과 얘기도",
  "전부 나한테 맡긴 건 왜야?」"
 ],
 "9159": [
  "「그야 나고 씨 쪽이",
  "적합하다고 생각했으니까요」"
 ],
 "9160": [
  "「...그것뿐만은 아니잖아」"
 ],
 "9161": [
  "「자기가 점점 더 의심받는다는 거",
  "알고 있었잖아?」"
 ],
 "9162": [
  "「...말했잖습니까.",
  "당신만은 지키겠다고」"
 ],
 "9163": [
  "「그렇다고...!",
  "너무 위험하잖아, 내가 뭘 실수해서",
  "사람이 더 죽었으면...」"
 ],
 "9164": [
  "「결국 나도 신뢰받지 못해서",
  "어떻게도 못 하게 됐을지도",
  "모르는데」"
 ],
 "9165": [
  "「그렇게는 안 될 거라고",
