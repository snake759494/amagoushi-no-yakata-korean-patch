 ],
 "9166": [
  "「왜?」"
 ],
 "9167": [
  "「믿고 있었으니까요」"
 ],
 "9168": [
  "「...처음 만났는데」"
 ],
 "9169": [
  "「그건 제가 할 말입니다」"
 ],
 "9170": [
  "「보통은 말 안 하죠,",
  "처음 본 상대한테...」"
 ],
 "9171": [
  "「다음에 노려질 것 같은 사람을 구하자",
  "같은 소린 말이죠」"
 ],
 "9172": [
  "「전 그때 생각했습니다.",
  "지금 여기서 우릴 구할 수 있는 건",
  "정말 이 사람뿐이겠구나 하고」"
 ],
 "9173": [
  "「그래서...",
  "전 제가 할 수 있는 범위에서",
  "당신 힘이 되자고 생각했죠」"
 ],
 "9174": [
  "「그러길 잘했습니다.",
  "덕분에 우린 살아서 돌아갑니다」"
 ],
 "9175": [
  "「...게다가 미사사기 씨도」"
 ],
 "9176": [
  "「나, 나는...",
  "우연이야, 그런 건」"
 ],
 "9177": [
  "「우연히 나만",
  "전혀 관계없는 입장이라서",
  "그래서...」"
 ],
 "9178": [
  "「좀 더 자신을 가져",
  "주면 좋으련만,",
  "어쩔 수 없는 양반이네」"
 ],
 "9179": [
  "「뭐, 미사사기 씨도 당신의",
  "그런 점에 두 손 들었을지도",
  "모르지만요」"
 ],
 "9180": [
  "「나고 씨가 아니었다면",
  "어쩌면 미사사기 씨는 지하에서",
  "안 나와 줬을지도 몰라요」"
 ],
 "9181": [
  "「그럼 나...",
  "조금은 도움이 됐나」"
 ],
 "9182": [
  "「조금 정도가 아니라니까요.",
  "정말이지, 이 사람은...」"
 ],
 "9183": [
  "「자, 가시죠.",
  "슬슬 차가 떠납니다」"
 ],
 "9184": [
  "왠지 바로 떠나기가 아쉬워서",
  "저택을 바라보고 만다."
 ],
 "9185": [
  "길을 잃고 여기 다다른 건",
  "얼마 전인데..."
 ],
 "9186": [
  "무척 오랫동안 여기",
  "있었던 것 같은 기분이 든다."
 ],
 "9187": [
  "「왜 그러세요?",
  "아아...」"
 ],
 "9188": [
  "「비가 그쳤네요」"
 ],
 "9189": [
  "「정말이네....」"
 ],
 "9190": [
  "조심조심 현관을 열고",
  "밖으로 나가 본다."
 ],
 "9191": [
  "「...나왔다...」"
 ],
 "9192": [
  "저택은 이제 쥐 죽은 듯 조용해서",
  "그 기분 나쁜 삐걱임도 들리지 않았다."
 ],
 "9193": [
  "「아, 시즈나...」"
 ],
 "9194": [
  "휘청, 하고 시즈나가 저택으로",
  "다가왔다."
 ],
 "9195": [
  "「...안 무너져?」"
 ],
 "9196": [
  "「으, 응...",
  "이제 괜찮을 거야...」"
 ],
 "9197": [
  "「그럼 시이 데리고",
  "돌아갈 수 있겠네...」"
 ],
 "9198": [
  "그렇게 중얼거리고 시즈나는",
  "주저앉았다."
 ],
 "9199": [
  "...미안해.",
  "구하지 못해서..."
 ],
 "9200": [
  "「...언니는?」"
 ],
 "9201": [
  "억지로 밖에 내보냈던",
  "스즈나가 달려온다."
 ],
 "9202": [
  "「저기, 언니는?」"
 ],
 "9203": [
  "「아, 아직 방에 있는데...",
  "그래도 저택은 이제 안 무너질",
  "테니까...」"
 ],
 "9204": [
  "「언니한테 가면",
  "안 돼...?」"
 ],
 "9205": [
  "「저, 저기...",
  "안 무너질 것 같긴 한데",
  "아직 위험하고... 그...」"
 ],
 "9206": [
  "「...언니...」"
 ],
 "9207": [
  "「언니... 혼자 있는데.",
  "빨리 데려와...!」"
 ],
 "9208": [
  "그렇게 말하고 스즈나는 흐느끼며",
  "차 쪽으로 달려가 버렸다."
 ],
 "9209": [
  "「...미안... 해」"
 ],
 "9210": [
  "그로부터..."
 ],
 "9211": [
  "몇 시간 뒤, 겨우 산사태로 막혔던",
  "길이 복구되어 구조대가 왔다.",
  " ",
  "우리는 구조되어 산을 내려가게",
  "되었지만..."
 ],
 "9212": [
  "「나고 씨, 가시죠」"
 ],
 "9213": [
  "「...용케 살아남았네요.",
  "나고 씨가 없었다면",
  "살아나지 못했을 겁니다」"
 ],
 "9214": [
  "「...하지만...",
  "모두를 구하진 못했어」"
 ],
 "9215": [
  "「무슨 소립니까.",
  "다 죽었을지도 모르는데」"
 ],
 "9216": [
  "「감사하고 있습니다요.",
  "당신 덕분입니다」"
 ],
 "9217": [
  "「자, 가시죠」"
 ],
 "9218": [
  "한 번만 더 돌아보고",
  "저택을 올려다본다."
 ],
 "9219": [
  "아마 두 번 다시 볼 일은",
  "없는 광경이겠지만..."
 ],
 "9220": [
  "（평생 잊지 못하겠지...）"
 ],
 "9221": [
  "...산기슭 병원으로 옮겨진 뒤",
  "나는 곧바로 정신을 잃고 말았다."
 ],
 "9222": [
  "긴장이 풀려서 그동안의 피로가",
  "한꺼번에 몰려온 거라며",
  "그대로 하룻밤 입원하게 됐다."
 ],
 "9223": [
  "히오리는 먼저 마중이 와서",
  "그 병원에서 헤어졌다."
 ],
 "9224": [
  "미사사기 씨는 지금 경찰에서",
  "조사를 받고 있다고 한다."
 ],
 "9225": [
  "내게 사정을 물으러 온 형사님",
  "말로는, 무척 순순히 모든 것을",
  "털어놓고 있다고 했다."
 ],
 "9226": [
  "저택 지하실에서 미사사기 씨의",
  "시신이 발견되었다고 들었다."
 ],
 "9227": [
  "나스 씨는 구조된 뒤의",
  "기자회견에서 자기가 모자 장수라는",
  "사실을 선선히 밝혔다."
 ],
 "9228": [
  "밝히는 게 좋겠다 싶어",
  "독단으로 털어놓은 건지..."
 ],
 "9229": [
  "그냥 깜빡 입이 미끄러진 것뿐",
  "인지는 수수께끼지만."
 ],
 "9230": [
