"19735": [
"「어?",
"저, 저기, 미안」"
],
"19736": [
"왜 혼난 걸까, 나..."
],
"19737": [
"「있잖아, 스즈나는 히오리를",
"여기서 만나기 전부터 알았어?」"
],
"19738": [
"「아니, 잘 몰라」"
],
"19739": [
"「그 녀석 싫어」"
],
"19740": [
"말 붙일 틈도 없었다..."
],
"19741": [
"「그렇지.",
"난 별로 얘기해 본 적 없지만」"
],
"19742": [
"「응, 잘 몰라」"
],
"19743": [
"「글쎄?",
"잘 모르겠는데」"
],
"19744": [
"「응, 제대로 만난 건",
"이번이 처음이니까」"
],
"19745": [
"「응, 대선배 베테랑」"
],
"19746": [
"「같이 일해 본 적 있어?」"
],
"19747": [
"「아니, 이번이 처음.",
"이었는데...」"
],
"19748": [
"「뭐? 관심 있어?」"
],
"19749": [
"「아니, 관심이라니...」"
],
"19750": [
"「작업 걸기만 해 봐",
"가만 안 둬」"
],
"19751": [
"「아, 안 걸어요」"
],
"19752": [
"「스즈나 말인데...」"
],
"19753": [
"「...왜 내 얘기 같은 걸",
"묻는 거야?」"
],
"19754": [
"「어, 왜냐니...」"
],
"19755": [
"「말해 두는데,",
"관심 가져도 곤란해, 난」"
],
"19756": [
"「아, 저기, 그런 게 아니라」"
],
"19757": [
"「우리 아빠보다 센",
"사람 아니면 싫으니까」"
],
"19758": [
"「아버지가 세셔...?」"
],
"19759": [
"「가라테 사범인데 도전해 볼래?」"
],
"19760": [
"「...사양할게요」"
],
"19761": [
"나스 씨 정도가 아니면",
"못 이기지 않을까..."
],
"19762": [
"「근육이면 된다는",
"얘기가 아니거든!?」"
],
"19763": [
"「뭐, 그렇지.",
"좋은 사람이지만」"
],
"19764": [
"템포가 꽤 어긋나 있지만."
],
"19765": [
"「...역시",
"이제 안 올 거라 생각해?」"
],
"19766": [
"「불안하지 않아?」"
],
"19767": [
"「생각해 봤자 소용없는걸」"
],
"19768": [
"「수상한 사람이라는 것",
"정도밖에 몰라」"
],
"19769": [
"「수, 수상한...」"
],
"19770": [
"「안 수상해?」"
],
"19771": [
"「아니, 수상하지만」"
],
"19772": [
"「그렇지.",
"미심쩍잖아」"
],
"19773": [
"「...그래도 제대로 부르면",
"여기까지 오는구나」"
],
"19774": [
"「그치만 정체 알고 싶잖아」"
],
"19775": [
"「이름 정도는.",
"별로 읽어 본 적 없지만」"
],
"19776": [
"얘기하기 싫은 듯이 시선을",
"피해 버렸다..."
],
"19777": [
"「....없어, 아무것도」"
],
"19778": [
"별로 건드리고 싶지 않은 화제 같다.",
"무리도 아니지만..."
],
"19779": [
"「그만해」"
],
"19780": [
"「...얘기할 수 있는 건",
"없으니까...」"
],
"19781": [
"「...얘기하기 싫어...」"
],
"19782": [
"「...절대 수상해」"
],
"19783": [
"「그치만 왜 안 오는데.",
"이렇게 될 줄 알았거나,",
"범인 그 자체라서 아냐?」"
],
"19784": [
"「그... 그건...」"
],
"19785": [
"「난 수상하다고 생각해」"
],
"19786": [
"「전혀 몰라」"
],
"19787": [
"「뭐야, 갑자기...?",
"같은 소속사였긴 하지만...」"
],
"19788": [
"「아, 저기, 서재에 주간지가",
"있어서 거기 실려 있길래...」"
],
"19789": [
"「...가만히 내버려 둬.",
"관계없잖아, 그 애는」"
],
"19790": [
"「...전혀」"
],
"19791": [
"「...흐응, 그렇구나」"
],
"19792": [
"조금 감탄한 듯한 목소리였다."
],
"19793": [
"「...누구였더라?",
"잘 모를 것 같은데」"
],
"19794": [
"「...뭐, 일단은.",
"근데 자세히는 몰라」"
],
"19795": [
"깊이 캐묻지 말라고 눈이 말했다."
],
"19796": [
"「...별로 기억 안 나」"
],
"19797": [
"별로 기억 못 하는 것 같다."
],
"19798": [
"「...전혀 몰라」"
],
"19799": [
"수상쩍다는 얼굴을 했다."
],
"19800": [
"「안 읽어서 몰라」"
],
"19801": [
"「아, 아아, 그래...」"
],
"19802": [
"「그런 사람 모르는데」"
],
"19803": [
"「...?",
"전혀 모르는 사람 같은데」"
],
"19804": [
"정말 모르는 것 같다."
],
"19805": [
"「전혀」"
],
"19806": [
"안 읽은 것 같다."
],
"19807": [
"「...기억 안 나」"
],
"19808": [
"「난 안 읽었어」"
],
"19809": [
"「아, 그렇구나...」"
],
"19810": [
"「몰라.",
"안 읽었으니까」"
],
"19811": [
"관심 없어 보였다..."
],
"19812": [
"...한마디였다."
],
"19813": [
"안 읽은 걸까..."
],
"19814": [
"「글쎄?」"
],
"19815": [
"「...없어」"
],
"19816": [
"「그거, 아직 읽는 중이니까",
"얘기하지 마」"
]
}