{
"19214": [
"「안 들킬 줄 알았겠지.",
"실제로 곧이듣는 사람도 많고」"
],
"19215": [
"「그래도... 되는 거야?",
"진짜로 눈에 든 것도",
"아무것도 아닌데...」"
],
"19216": [
"「...이 업계에선 흔해.",
"정보 조작 같은 짓 하는 거」"
],
"19217": [
"「고소하거나 할 순 없어?」"
],
"19218": [
"「그냥 소문일 뿐이니까",
"출처가 어딘지 증거도 없고」"
],
"19219": [
"「게다가...",
"윗선엔 이것저것 있대,",
"힘 관계라든가 골치 아픈 게」"
],
"19220": [
"「그래도...",
"사람이 한 명 죽었는데...」"
],
"19221": [
"「...오빠, 좋은 사람이네」"
],
"19222": [
"「...리나는 말이야,",
"엄청 성실하고 노력파였어」"
],
"19223": [
"「...모자 장수 팬이라서",
"그 사람 연극에 나가고 싶다고",
"늘 말했었거든...」"
],
"19224": [
"「뭐... 그럼 혹시",
"모자 장수 때문에 떨어졌다는",
"얘기가 없었더라면...」"
],
"19225": [
"「자살까지는 안 했을지도",
"모른다는... 거야...?」"
],
"19226": [
"「...그럴",
"가능성이 크다고 생각해...」"
],
"19227": [
"「뛰어내린 게 모자 장수 얘기가",
"우리 소속사에 소문난 직후라",
"정말 갑작스러웠으니까...」"
],
"19228": [
"「...조금",
"기운을 차리는 것처럼",
"보였는데...」"
],
"19229": [
"「억지로 밝은 척한 걸지도.",
"무리하던 참에 그런",
"얘기를 들어서...」"
],
"19230": [
"문득 마음이 꺾여 버린 건지도",
"모른다."
],
"19231": [
"진실도 아니었는데..."
],
"19232": [
"「...그래도",
"미키는 관계없었던",
"것 같고...」"
],
"19233": [
"「미키?",
"아, 그 오디션에",
"붙은 애?」"
],
"19234": [
"「응, 맞아.",
"그 애는 몰랐던 것 같다고",
"우리 사장님이 그랬어」"
],
"19235": [
"「아마 소속사나 영화 주최 같은",
"윗선이 멋대로 한 거겠지」"
],
"19236": [
"「왠지 그 애도",
"불쌍하네...」"
],
"19237": [
"「응...",
"소문 듣고 풀이 죽어 있다는",
"얘기더라」"
],
"19238": [
"「그야...",
"그렇겠지」"
],
"19239": [
"「...장례식 때 말이야,",
"누가 보냈는지 모를 꽃이",
"두 개쯤 왔었거든」"
],
"19240": [
"「보낸 사람 이름 같은 게",
"아무것도 안 적힌 게」"
],
"19241": [
"「그중 하나가",
"미키가 보낸 거 아닐까",
"난 그렇게 생각하는데」"
],
"19242": [
"「...그럼 다른 하나는",
"누가 보낸 걸까?",
"팬?」"
],
"19243": [
"「그게...",
"리나 부모님은",
"누군지 짐작하시는 것 같았어」"
],
"19244": [
"「확실히 그렇게 말씀하신",
"건 아니지만」"
],
"19245": [
"「내가 하나는 미키가 보낸",
"거 아닐까 했더니,",
"그래서 두 개군요 하셨거든」"
],
"19246": [
"「그래서, 두 개...」"
],
"19247": [
"「그래, 그건",
"미키 아닌 쪽은 이미",
"안다는 뜻 같잖아?」"
],
"19248": [
"「...그런 것 같네」"
],
"19249": [
"「그러니까 친척이라든가,",
"가족이 아는 사람이겠지」"
],
"19250": [
"「뭐, 누구든 간에",
"리나를 슬퍼하는 사람이",
"또 있다는 것만으로...」"
],
"19251": [
"「...그걸로 충분하다",
"싶어서, 누굴까 하고",
"별로 생각 안 했어」"
],
"19252": [
"「그거면 되지 않을까」"
],
"19253": [
"「그렇지.",
"내가 억지로 캐물어서",
"좋을 것도 없을 테고」"
],
"19254": [
"「리나를 위해 같이 울어 준",
"사람이 또 있었다는 것만",
"기억해 두기로 할게」"
],
"19255": [
"「...미안해,",
"괴로운 걸 물어서」"
],
"19256": [
"「아니...」"
],
"19257": [
"「이런 건 왠지,",
"잘 모르는 사람한테 얘기하는",
"게 좀 마음이 편하잖아」"
],
"19258": [
"「응, 언니나 리나를",
"아는 사람이랑 얘기하면",
"끝도 없이 우울해지거든」"
],
"19259": [
"「언제까지고",
"초상집 분위기면",
"리나도 곤란하잖아?」"
],
"19260": [
"「사토에 미도리라는 사람 알아?」"
],
"19261": [
"「사토에...?",
"모를 것 같은데, 누구야?」"
],
"19262": [
"「꽤 옛날 아이돌인",
"것 같은데」"
],
"19263": [
"「아이돌이라...",
"음~, 난 모르겠어」"
],
"19264": [
"「어~?",
"그랬어?」"
],
"19265": [
"「아이돌이라...",
"노래 같은 것도 내셨나」"
],
"19266": [
"「그런가 봐」"
],
"19267": [
"「흐응, 사람마다 역사가 있네」"
],
"19268": [
"「미사사기 씨라면 천연계",
"귀여운 아이돌이었겠다」"
],
"19269": [
"「르로이 백작이라는 사람 알아?」"
],
"19270": [
"「르로이?",
"어디서 들어 봤는데...」"
],
"19271": [
"「아, 전에 언니한테",
"들은 것 같아.",
"무서운 사람 아니었어?」"
],
"19272": [
"「아, 아마 그 사람」"
],
"19273": [
"「난 그런 오컬트 쪽은",
"별로 안 좋아해」"
],
"19274": [
"「나도 싫어...」"
],
"19275": [
"「응, 그건 보면 알아」"
],
"19276": [
"「기타하야미 료스케 알아?",
"다카토 씨 책에 나오는 탐정」"
],
"19277": [
"「아, 응.",
"일단 조금은 읽었으니까」"
],
"19278": [
"「...근데 말이야, 명탐정은",
"왜 다들 이상한 사람이야?」"
],
"19279": [
"「글, 글쎄...",
"나도 잘 모르지만,",
"다들 이상한 사람이야...?」"
],
"19280": [
"「...글쎄.",
"언니가 읽는 책에 나오는",
"탐정은 예외 없이 괴짜였어」"
],
"19281": [
"「...그렇구나.",
"우리 언니가 그런 것만",
"골라 읽는 건지도...」"
],
"19282": [
"「히오리 료 말인데...",
"아, 책에 나오는 쪽」"
],
"19283": [
"「아, 소설 캐릭터 쪽?",
"왠지 되게 운이 나쁜",
"사람 같았어」"
],
"19284": [
"「언니 말로는,",
"히오리가 운이 나쁜 건",
"팔 할이 료스케 탓이래」"
],
"19285": [
"「...왜 붙어 다니는 걸까」"
],
"19286": [
"「질긴 악연 아냐?」"
],
"19287": [
"아아...",
"그런 건 끊어지질 않지."
],
"19288": [
"「다카토 씨 책에 나오는",
"진노 경감 기억해?」"
],
"19289": [
"「아, 있었던 건 기억나는데",
"잘... 기억 안 나려나」"
],
"19290": [
"「그렇게 많이 안 읽었거든,",
"난, 언니랑 달리」"
],
"19291": [
"「나미즈미 슌지라는 사람 알아?」"
],
"19292": [
"「...그게 누군데?」"
],
"19293": [
"「다카토 씨 책에 나오는 사람」"
],
"19294": [
"「어~?",
"고정 캐릭터는 아니지?」"
],
"19295": [
"「응, 한 작품에만 나올 거야」"
],
"19296": [
"「아, 그럼",
"그건 안 읽었을 거야」"
],
"19297": [
"「『검은 고양이의 독』에 나오는",
"마다라이 씨 말인데...」"
],
"19298": [
"「아, 미안.",
"그 얘기는 안 읽었어」"
],
"19299": [
"「아, 그렇구나」"
],
"19300": [
"「구로조노 다쓰야라는 사람이",
"나오는 얘기 말인데...」"
],
"19301": [
"「누구야?",
"난 모를 것 같은데」"
],
"19302": [
"「『회색 가면』이라는",
"얘기에 나오는 사람」"
],
"19303": [
"「...제목도 기억 안 나.",
"집에는 있을지도 모르지만」"
],
"19304": [
"「스즈나는 안 읽었어?」"
],
"19305": [
"「응, 안 읽었어」"
],
"19306": [
"「고오리 미즈에라는 사람",
"기억해?」"
],
"19307": [
"「어? 누구?」"
],
"19308": [
"「『고오리 가의 악몽』에 나오는 사람」"
],
"19309": [
"「뭐야 그게?",
"다카토 씨 책?」"
],
"19310": [
"「기억 안 나네,",
"안 읽었어, 그거」"
],
"19311": [
"「『오니의 밀실』에 나오는",
"사에키 노인 알아?」"
],
"19312": [
"「그 얘기 안 읽어서",
"모르겠어」"
],
"19313": [
"「그렇구나, 그럼 모르겠네」"
],
"19314": [
"「아케오 미쓰키라는 사람 알아?」"
],
"19315": [
"「...어디서 들은 것 같아.",
"누구였더라, 그거」"
],
"19316": [
"「『사신의 낫』에 나오는 사람이야.",
"다카토 엔지로의」"
],
"19317": [
"「아, 생각났다.",
"그건 읽었어」"
],
"19318": [
"「...근데 이번 사건이랑은",
"관계없어 보이는 얘기 아니었어?」"
],
"19319": [
"「역시 그런가」"
],
"19320": [
"같은 이름인 사람이 안 나오니까."
],
"19321": [
"「다키 주자부로라는 사람 알아?」"
],
"19322": [
"「다키 주...?",
"아니, 그런 사람 아는 사람 없어」"
],
"19323": [
"「아, 소설에 나오는 사람이야.",
"다카토 엔지로의」"
],
"19324": [
"「아, 그건 모르겠어.",
"안 읽었을 거고」"
],
"19325": [
"「오코노기라는 사람 알아?",
"『항아리 속의 수수께끼』에",
"나오는 골동품상인데」"
],
"19326": [
"「골동품상이라... 아,",
"그거 아마 언니가 좋아하는",
"얘기 아닐까」"
],
"19327": [
"「스즈나는 읽었어?」"
],
"19328": [
"「아니, 왠지 섬뜩한",
"얘기 같아서」"
],
"19329": [
"섬뜩한 건가...",
"그걸 좋아하는 시즈나는",
"대체..."
],
"19330": [
"「『호반의 저택』에",
"나오는 쪽 나스 씨 알아?」"
],
"19331": [
"「아~, 그거 안 읽었어.",
"근데 언니가 하나도 안 닮았다고",
"그러던데」"
],
"19332": [
"「흐응?」"
],
"19333": [
"「뭐, 그 나스 씨 닮은 사람이",
"다카토 엔지로 얘기에",
"나올 것 같진 않지만」"
],
"19334": [
"...애초에 추리 소설에 거의",
"안 나오겠지..."
],
"19335": [
"「『잊지 못할 섬』에 나오는",
"도모에라는 여자 알아?」"
],
"19336": [
"「아, 알아.",
"언니가 제일 좋아하는",
"얘기에 나오는 사람이야」"
],
"19337": [
"「제일 좋아하는 거야?」"
],
"19338": [
"「그렇게 말하던데」"
],
"19339": [
"「흐응?",
"어떤 얘기일까」"
],
"19340": [
"「아~, 나도 안 읽었거든.",
"재밌으니까 읽으라고",
"듣긴 했는데...」"
],
"19341": [
"「다카토 씨 책 중에 미사사기 씨가",
"나오는 거 벌써 읽었어?」"
],
"19342": [
"「아직 안 읽었을 거야.",
"제목이 뭐였더라」"
],
"19343": [
"「『우리 속의 여자』라는 얘기」"
],
"19344": [
"「아, 그거 안 읽었어」"
],
"19345": [
"「쿠라이시 씨 나오는 얘기 읽었어?",
"『꺼림칙한 꽃』이라는 얘기」"
],
"19346": [
"「응, 그건 읽었어.",
"여기 쿠라이시 씨가 같은 역 해도",
"별로 어색하지 않은 느낌」"
],
"19347": [
"「뭐, 쿠라이시 씨는 잘하니까",
"뭘 해도 나름 어울리겠지만」"
],
"19348": [
"「흐응, 그렇구나...」"
],
"19349": [
"「기누타 유리라는 사람 알아?」"
],
"19350": [
"「어~, 누구였더라?」"
],
"19351": [
"「『오이란은 왜 살해되나』라는",
"얘기에 나오는...」"
],
"19352": [
"「아, 여배우였던가.",
"언니가 읽었었어」"
],
"19353": [
"「난 아직 안 읽었어」"
],
"19354": [
"「츠바키 군이 나오는 얘기",
"읽은 적 있어?」"
],
"19355": [
"「다카토 씨 거?",
"그건 아직 안 읽었는데, 거기",
"츠바키 씨는 집사가 아니라며」"
],
"19356": [
"「응, 당주래」"
],
"19357": [
"「흐응?",
"여기선 왜 집사일까」"
],
"19358": [
"「시노노메 다키라는 사람 알아?",
"『그림 속의 죽음』에 나오는 사람」"
],
"19359": [
"「어디 보자...",
"잠깐만, 그 얘기 읽었을",
"텐데...」"
],
"19360": [
"「어땠더라,",
"왠지 어두운 얘기였던",
"기억은 있는데」"
],
"19361": [
"「잘 기억 안 나?」"
],
"19362": [
"「응, 꽤 오래전이거든, 읽은 게」"
],
"19363": [
"「『악마의 화원』에 나오는",
"스즈나네 말인데...」"
],
"19364": [
"「잠깐! 그건 잠깐!",
"나 지금 그거 읽는 중이야!」"
],
"19365": [
"「먼저 스포일러 들었다간",
"언니한테 혼쭐나...」"
],
"19366": [
"「응, 분명 이불 속에",
"몰래 이상한 걸 넣어 둘 거야」"
],
"19367": [
"그건 벌인 걸까..."
],
"19368": [
"「우쓰로이 가라고 알아?",
"다카토 씨 소설에 나오는...」"
],
"19369": [
"「...뭔가 들어 본 적은",
"있는데...」"
],
"19370": [
"「생각이 안 나.",
"아마 언니한테 듣기만 하고",
"안 읽은 것 같아」"
],
"19371": [
"「요즘 세상에 할멈 하녀가",
"있는 집은 어떤 집일까?」"
],
"19372": [
"「뭐야 그게?",
"난 할멈 하녀보다 메이드가",
"좋지만」"
],
"19373": [
"「메이드?",
"직접 하게?」"
],
"19374": [
"「왜 그렇게 되는데!?」"
],
"19375": [
"「어울릴 것 같아서...」"
],
"19376": [
"「내가 하고 싶단 게 아냐!",
"이왕이면 메이드가 시중들어",
"주는 게 좋다는 얘기!!」"
],
"19377": [
"「...오빠는",
"메이드보다 할멈이 좋아?」"
],
"19378": [
"「어? 나?」"
],
"19379": [
"「그야 뭐,",
"귀여운 메이드가 좋지」"
],
"19380": [
"「그렇지?",
"역시 그렇지」"
],
"19381": [
"왜 그렇게 힘차게",
"고개를 끄덕이는 걸까..."
],
"19382": [
"「난 할멈 쪽이 좋은데」"
],
"19383": [
"「긴장되잖아,",
"젊은 여자애 메이드라니」"
],
"19384": [
"「남자로서 어떻냐, 그건」"
],
"19385": [
"어이없어하고 말았다..."
],
"19386": [
"「여기에 모두를 모은 게",
"모자 장수 본인이라고 생각해?」"
],
"19387": [
"「굳이 따지자면",
"그렇게 믿고 싶은지도 몰라」"
],
"19388": [
"「믿고 싶어?」"
],
"19389": [
"「만약 우릴 모은 게 모자 장수면",
"모자 장수가 범인일",
"가능성이 제일 높잖아」"
],
"19390": [
"「왠지 말이야...",
"아무리 수상한 괴짜라도",
"범죄자는 아니라고 믿고 싶잖아」"
],
"19391": [
"「...쿠라이시 씨 말인데」"
],
"19392": [
"「어? 뭐 알아냈어?」"
],
"19393": [
"「미사사기 씨가 아침 일찍",
"복도에서 봤다고 하더라고」"
],
"19394": [
"「그러니까, 첫날부터 세서",
"5일째 이른 아침이래」"
],
"19395": [
"「5일째...?」"
],
"19396": [
"「아, 아~...",
"내가 꽤 일찍 깬 날인가」"
],
"19397": [
"「그랬어?",
"방에서 나갔어?」"
],
"19398": [
"「...목욕하고 있었어」"
],
"19399": [
"「응, 나온 게 7시 전이었나.",
"방에 돌아가서...」"
],
"19400": [
"「...근데 내가 본 건",
"쿠라이시 씨가 아니라",
"기모노 입은 오빠였어」"
],
"19401": [
"「히오리를 만났어?」"
],
"19402": [
"「만났다기보단 2층 화장실에",
"들어가는 걸 본 것뿐이지만」"
],
"19403": [
"「그 뒤 7시 넘어서 언니",
"깨우러 가서, 부엌에 내려간 게",
"7시 반이나 좀 더 뒤였나」"
],
"19404": [
"「스즈나 방",
"이름이 뭐였더라」"
],
"19405": [
"「뭐였더라.",
"무슨 미국 대통령",
"같은 이름」"
],
"19406": [
"「대통령...?」"
],
"19407": [
"「클린턴이나 워싱턴이나",
"루스벨트 같은 게 아니라",
"좀 더 담백한 거」"
],
"19408": [
"「부시?」"
],
"19409": [
"「그래 최근 사람 아이다,",
"더 옛날 사람이라 카이!」"
],
"19410": [
"「...카이?」"
],
"19411": [
"「잠깐 기다리 봐,",
"지금 생각날라 카니까,",
"기다리라꼬...」"
],
"19412": [
"「뭔가 길게 늘이는 소리가 있다,",
"어디 보자, 푸틴... 아이고」"
],
"19413": [
"「저기 그거, 러시아...」"
],
"19414": [
"「그래, 러시아가 와",
"나오노!?」"
],
"19415": [
"「...사과 안 해도 되는데」"
],
"19416": [
"「아, 아니, 그치만」"
],
"19417": [
"「겁먹지 마.",
"좀 생각이 안 나서",
"사투리 튀어나온 것뿐이야」"
],
"19418": [
"「...평소엔 사투리",
"참고 말하는구나」"
],
"19419": [
"「안 그러면",
"다들 나랑 언니가",
"뭔 말 하는지 모르잖아」"
],
"19420": [
"「...그래서, 무슨 얘기",
"였더라?",
"아, 내 방 이름이구나」"
],
"19421": [
"「생각났어?」"
],
"19422": [
"「안 되겠어.",
"안 나오니까 알아서 찾아봐」"
],
"19423": [
"「...알았어」"
],
"19424": [
"「아이세 미키 알아?」"
],
"19425": [
"「...아, 이름은」"
],
"19426": [
"「일로 같이 만나거나",
"한 적은 없구나?」"
],
"19427": [
"「응.",
"그러니까 어떤 앤지도...」"
],
"19428": [
"「...아니, 뭐",
"평범한 애겠지만」"
],
"19429": [
"왠지 말끝을 흐리는 말투",
"같은 느낌이 들었다..."
],
"19430": [
"「그야 알지.",
"명색이 배우인데",
"모를 리가 없잖아」"
],
"19431": [
"「멋진 언니야,",
"화나면 무섭지만」"
],
"19432": [
"「혼난 적 있어?」"
],
"19433": [
"「다행히 난 없는데,",
"혼나는 건 본 적 있어」"
],
"19434": [
"「소리 지르진 않아.",
"엄청난 박력으로 노려보면서",
"담담하게 설교해」"
],
"19435": [
"「무, 무섭겠다」"
],
"19436": [
"「혼나는 사람,",
"기절할 것 같더라」"
],
"19437": [
"...나라면 기절했겠다."
],
"19438": [
"「나루세 기미야스라는 사람",
"몰라?」"
],
"19439": [
"「어? 그게 누군데」"
],
"19440": [
"「서재에 있던 책에서",
"이름을 봤는데...」"
],
"19441": [
"「무슨 유명한 사람이야?",
"옛날 총리대신이라든가」"
],
"19442": [
"「아니, 그렇게 옛날 사람은",
"아닌 것 같은데」"
],
"19443": [
"「흐응?",
"난 전혀 모르겠어」"
],
"19444": [
"「있잖아, 마리안느라는 히로인이",
"나오는 얘기 알아?」"
],
"19445": [
"「...혹시 그,",
"눈 속에 별이 반짝일 것 같은",
"로맨스 소설?」"
],
"19446": [
"「...우리 엄마가",
"팬클럽 들어가 있어...」"
],
"19447": [
"「난...",
"질색이지만...」"
],
"19448": [
"왠지 괴로워 보인다..."
],
"19449": [
"「해리 키드먼이라는",
"탐정 알아?」"
],
"19450": [
"「...?",
"어디서 들어 본",
"것 같은데...」"
],
"19451": [
"「읽은 기억은 없으니까",
"언니한테 들었나.",
"어떤 사람이야?」"
],
"19452": [
"「나도 잘 모르지만",
"존재감이 희미한...」"
],
"19453": [
"「아~앗!",
"생각났다!!」"
],
"19454": [
"「더워 죽겠는데 언니 따라",
"하루 종일 헌책방 순례했던",
"그 녀석 말이구나!!」"
],
"19455": [
"「하루 종일...」"
],
"19456": [
"「절판됐다나 뭐라나 해서",
"보통 서점엔 없었거든」"
],
"19457": [
"「더웠어...",
"그때는 정말이지...」"
],
"19458": [
"「고, 고생했구나...」"
],
"19459": [
"「...뭐, 열 몇 번째 가게에서",
"찾았을 때 언니가 엄청",
"기뻐했으니까, 괜찮지만」"
],
"19460": [
"（엄청 기뻐하는 시즈나라니",
"어떤 모습일까...）"
],
"19461": [
"왠지 잘 상상이",
"안 된다."
],
"19462": [
"「진짜 집사를",
"만나 본 적 있어?」"
],
"19463": [
"「설마.",
"그런 게 요즘 실제로 있어?」"
],
"19464": [
"「일단 없지는",
"않을 것 같은데」"
],
"19465": [
"「흐응?",
"역시 이런 집에 사는",
"사람 쪽에 있으려나」"
],
"19466": [
"「...근데 집사는",
"기본적으로 뭘 하는 사람이야?」"
],
"19467": [
"「비서 같은 거랑은 다르지?",
"하인 중에 제일 높은 사람",
"같은 느낌?」"
],
"19468": [
"「...그러고 보니",
"나도 잘 모르겠네」"
],
"19469": [
"「그렇지.",
"진짜로는 어떤 걸까」"
],
"19470": [
"「적어도 집 안에서",
"덤벨 휘두르는 사람한테 호통치는",
"게 일은 아니겠지」"
],
"19471": [
"「...그건 너무 특수한",
"경우라고 봐...」"
],
"19472": [
"「있잖아, 형제는...」"
],
"19473": [
"「맞다!",
"너 외동이야?」"
],
"19474": [
"「어? 나?",
"아니, 아닌데」"
],
"19475": [
"「왠지 위에 형제가",
"있을 것 같았어」"
],
"19476": [
"「응, 누나가...」"
],
"19477": [
"「...상냥해?」"
],
"19478": [
"「...때와 경우에 따라, 려나」"
],
"19479": [
"「어디나 똑같구나...」"
],
"19480": [
"「그, 그래도 시즈나는",
"얌전하고...」"
],
"19481": [
"「어디가」"
],
"19482": [
"「어디냐니, 저기...」"
],
"19483": [
"「내 저녁밥만",
"토란조림으로 위장한 경단으로",
"바꿔치기해 놓는데도?」"
],
"19484": [
"「학교 가서 가방 열었더니",
"교과서가 전부 초등학교",
"1학년 때 걸로 바뀌어 있고...」"
],
"19485": [
"「...고, 곤란하겠다...」"
],
"19486": [
"「곤란한 정도가 아니야!!",
"화나게 하면 무슨 짓을 할지",
"몰라, 우리 언니는...」"
],
"19487": [
"대놓고 따귀나 관절기로",
"덤비는 우리 누나 쪽이",
"차라리 나은 걸까..."
],
"19488": [
"잠자코 기다린다"
],
"19489": [
"얘기만이라도 들어 줘"
],
"19490": [
"아무도 안 죽었으면 하니까"
],
"19491": [
"확실히 무뚝뚝했지"
],
"19492": [
"무뚝뚝했었나?"
],
"19493": [
"의미는 있다"
],
"19494": [
"「저기, 미안.",
"별로 기분 좋은 얘기는",
"아닌데...」"
],
"19495": [
"「뭐야, 그게?」"
],
"19496": [
"「사건에 관한 거야」"
],
"19497": [
"「...뭐 알아냈어?」"
],
"19498": [
"「알아냈다기보다,",
"오늘 밤, 그 범인이...」"
],
"19499": [
"「아 진짜, 똑바로 말해",
"똑바로!」"
],
"19500": [
"「미, 미안.",
"저기, 범인이 노리는 건...」"
],
"19501": [
"「...스즈나,",
"가... 아닌가...」"
],
"19502": [
"「시, 싶어서, 그...」"
],
"19503": [
"...화난 걸까.",
"스즈나는 험악한 표정 그대로",
"입을 다물어 버렸다."
],
"19504": [
"굉장히 입 열기 힘든",
"분위기라 잠자코 기다려 본다."
],
"19505": [
"「얘기만이라도 들어",
"줄 수 없을까」"
],
"19506": [
"「싫은 얘기겠지만...",
"정말 위험하단 말이야」"
],
"19507": [
"「아, 아니, 내 추리가 틀렸을",
"수도 있긴 한데」"
],
"19508": [
"「그래도 일단 제대로 생각해",
"본 거니까...」"
],
"19509": [
"（...안 되려나.",
"역시...）"
],
"19510": [
"「정말...",
"들으면 되잖아 들으면」"
],
"19511": [
"「알았으니까 빨리 말해」"
],
"19512": [
"「아, 응, 고마워!」"
],
"19513": [
"「저, 저기 말이야?",
"딱히 아직 믿는 건",
"아니거든?」"
],
"19514": [
"「그렇게 울상을 지으면",
"내가 괴롭히는 것 같아서",
"기분 나쁠 뿐이니까...」"
],
"19515": [
"「응, 알았어.",
"제대로 믿어 줄 수 있게",
"설명할게」"
],
"19516": [
"「진짜로 알아들은 거야!?」"
],
"19517": [
"「...아 진짜, 이상한 사람이야.",
"나, 오빠한텐 무뚝뚝하게",
"굴었을 텐데 왜 신경 쓰는지...」"
],
"19518": [
"「...왜냐니, 그야",
"아무도 안 죽었으면 하니까」"
],
"19519": [
"「엄청 평범한 대답이네」"
],
"19520": [
"「그렇게 친하지 않았다고",
"죽어도 된다고는 보통",
"생각 안 하잖아?」"
],
"19521": [
"「뭐, 아무리 그래도 그건",
"사람으로서 좀 아니지만」"
],
"19522": [
"「응, 그러니까 그런 거야」"
],
"19523": [
"「응, 뭐, 확실히 무뚝뚝하긴",
"했던 것 같지만」"
],
"19524": [
"「소, 솔직하네 너」"
],
"19525": [
"「그렇다고 살해당해도",
"된다고까지는 생각 안 해」"
],
"19526": [
"「...뭐, 그야 그렇지」"
],
"19527": [
"「아무 말도 안 했는데 살해당하면",
"엄청 찝찝하고」"
],
"19528": [
"「일단 오빠 머릿속엔",
"거짓말이나 둘러대기가",
"티끌만큼도 없다는 건 알겠어」"
],
"19529": [
"역시 좀 너무 솔직하게",
"말했나..."
],
"19530": [
"「...무뚝뚝했었나?」"
],
"19531": [
"「저, 저기 말이야...",
"내가 언제 너한테 살갑게",
"구는 것처럼 보였어...?」"
],
"19532": [
"「아니, 살갑게 구는 것처럼은",
"안 보였지만...」"
],
"19533": [
"「...나한테만 특별히",
"무뚝뚝한 게 아니라",
"그냥 원래 성격인가 해서...」"
],
"19534": [
"「...그렇구나, 그냥 둔한 거구나」"
],
"19535": [
"「두, 둔한가」"
],
"19536": [
"「둔하지, 아무리 봐도」"
],
"19537": [
"「그래도 봐, 계속 쌀쌀맞았던",
"건 아니잖아...」"
],
"19538": [
"「그건 다른 사람 있을 때고!",
"나랑 너 사이에 제대로 된 대화가",
