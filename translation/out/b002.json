{
"1319": [
"「무슨 일이에요?」"
],
"1320": [
"「...장난이 아니구먼」"
],
"1321": [
"「아, 다들!",
"이것 좀 봐 봐...」"
],
"1322": [
"나스 씨까지 어쩔 줄 모르겠다는",
"얼굴을 하고 있다."
],
"1323": [
"「이건... 네에엣!?」"
],
"1324": [
"「...이거 참...」"
],
"1325": [
"나스 씨가 가리킨 쪽을 보니",
"차 2대가 세워져 있었다."
],
"1326": [
"1대는 검은 승용차, 다른 1대는",
"꽤 연식이 된 경차였다."
],
"1327": [
"다만, 그 2대 모두..."
],
"1328": [
"「<fs 110>뭐, 뭐란 말인가 이건!?<fs>",
"<fs 110>내 차가! 내 차가아!?<fs>」"
],
"1329": [
"「어머, 큰일이네요.",
"왜 이렇게 기울어 있죠?」"
],
"1330": [
"「...그렇군, 펑크 소리였어」"
],
"1331": [
"「펑크?」"
],
"1332": [
"「타이어가」"
],
"1333": [
"뭔가로 힘껏 찢긴 모양인지",
"타이어가 터져서 차가 이상한",
"각도로 기울어 있었다."
],
"1334": [
"앞바퀴와 뒷바퀴 하나씩,",
"타이어가 무려 4개나 망가졌다."
],
"1335": [
"「그러고 보니 달리는 동안에도",
"그 소리, 들렸어...」"
],
"1336": [
"「두 번 울렸던 것 같습죠.",
"딱 4개인가...」"
],
"1337": [
"「오오오, 이 무슨 짓을!?",
"아, 안은! 차 안은 무사한가!」"
],
"1338": [
"완전히 뒤집힌 목소리로 외치며",
"마다라이 씨는 허둥지둥 윗옷에서",
"열쇠를 꺼내 차 문을 연다."
],
"1339": [
"「아, 그러고 보니",
"나도 차 안은 안 봤네」"
],
"1340": [
"그걸 보고 나스 씨도 바지에서",
"열쇠를 꺼내 버튼을 눌러",
"차 문을 열었다."
],
"1341": [
"「있잖아, 펑크라는 게",
"날씨 나쁘면 저절로 나?」"
],
"1342": [
"「아뇨, 설마 그런 일은",
"없을 겁니다만」"
],
"1343": [
"「그치만, 저 타이어...」"
],
"1344": [
"「일부러지, 누가 봐도.",
"누군가가...」"
],
"1345": [
"「.........누군가」"
],
"1346": [
"「어머...",
"하지만, 저기...」"
],
"1347": [
"「누군가라니... 누군데?」"
],
"1348": [
"우리는 전원 여기에 있다."
],
"1349": [
"거실에서 유리 깨지는 소리를",
"들었을 때부터, 거의 전원이",
"함께 움직이고 있었다."
],
"1350": [
"「...차 안은",
"이상 없었어」"
],
"1351": [
"「내 쪽도 도둑맞은 건",
"없었네만...」"
],
"1352": [
"「이래서는 달릴 수 없잖나!",
"어떻게 산을 내려가란 말인가",
"엉!? 곤란하네 자네!!」"
],
"1353": [
"「우리한테 소리쳐 봤자 어쩌라고」"
],
"1354": [
"「하지만 이건 좀",
"장난의 선을 넘었네요」"
],
"1355": [
"「으음, 그러게.",
"곤란하네, 스페어 타이어는",
"1개밖에 없는데」"
],
"1356": [
"「그, 그렇지!",
"자네도 차로 오지 않았나?」"
],
"1357": [
"「아, 저기, 일단 차긴 한데요",
"장소가, 그게...」"
],
"1358": [
"「엄청 헤매면서 숲속을",
"곧장 올라와 버려서",
"위치를 몰라서...」"
],
"1359": [
"「그딴 거 찾으러 안 가도",
"내일 되면 촬영 스태프가",
"올 거 아냐...」"
],
"1360": [
"「스태프는 어차피 차로 올 테니",
"그걸로 산 내려가서 타이어",
"구해 오면 되잖아」"
],
"1361": [
"「그렇네요.",
"나고 씨, 미안하지만 스태프가",
"올 때까지 기다려 주시겠수?」"
],
"1362": [
"「응, 물론이지.",
"난 급하지 않고, 태워만",
"준다면 언제든」"
],
"1363": [
"「...일단,",
"방으로 돌아갈래?",
"비가 또 심해지고 있고」"
],
"1364": [
"「그래, 여기서 멍하니 서 있어도",
"어쩔 수 없나...」"
],
"1365": [
"「장난친 범인도",
"안 보이고 말이야」"
],
"1366": [
"주위를 둘러봤지만",
"사람 그림자는 없었다."
],
"1367": [
"（...그래도...）"
],
"1368": [
"우리 말고 누군가가...."
],
"1369": [
"누군가, 한 사람 더 이 저택",
"근처에 있는 거다...."
],
"1370": [
"...저택으로 돌아와 각자 수건으로",
"몸을 닦고 다시 거실에 모였다."
],
"1371": [
"「...자, 어쩐다」"
],
"1372": [
"「어쩌다니?」"
],
"1373": [
"「너 말이야, 타이어 당한",
"당사자면서 왜 그렇게",
"태평한 거냐?」"
],
"1374": [
"「...근육이니까」"
],
"1375": [
"「뭐, 경계해서",
"나쁠 건 없겠죠」"
],
"1376": [
"「아무래도 이 저택에 우리 말고",
"누가 있는 건 틀림없는 모양이니」"
],
"1377": [
"「그거 나구모 씨 아냐?」"
],
"1378": [
"「나구모라 쳐도 말이야,",
"왜 타이어를 펑크 내고",
"온실에 이상한 짓을 해야 돼?」"
],
"1379": [
"「정말 그렇네, 자네!",
"내 차에 이 무슨 짓을...」"
],
"1380": [
"「근데 있잖아,",
"왜 펑크 같은 걸 낸 걸까?」"
],
"1381": [
"「내일 되면 촬영팀 올 거고",
"발을 묶는다 쳐도 오늘 밤",
"하룻밤밖에 효과 없는데」"
],
"1382": [
"「그야 괴롭히려는 게",
"뻔하지 않나... 하하아,",
"알았다!」"
],
"1383": [
"「이건 분명 모자 장수에게",
"초대받지 못한 어느 삼류 배우의",
"심술이 틀림없다네, 자네들!」"
],
"1384": [
"「...하아?」"
],
"1385": [
"「아아, 참으로 개탄스럽군.",
"재능 있는 자는 언제나 이런",
"시기를 견뎌야 하니 말이야」"
],
"1386": [
"「특히 나는 자기 방에 소품이",
"숨겨져 있다는 특별 대우...",
"아아, 아니 이건 비밀이지만」"
],
"1387": [
"「비밀이라니 저기,",
"방금 대놓고 말했...」"
],
"1388": [
"「자, 자네!",
"지금이라도 사과하게」"
],
"1389": [
"「사과하고 타이어를 변상한다면",
"봐줄 수도 있다고",
"말하는 걸세, 자네」"
],
"1390": [
"「<fs 110>하아아!?<fs>",
"<fs 110>왜 나야!?<fs>」"
],
"1391": [
"「자네는 모자 장수의 초대를",
"받고 온 게 아니라고 했잖나」"
],
"1392": [
"「말하긴 했지만,",
"난 그냥 길 잃은 거라니까요!」"
],
"1393": [
"「...이치야나기.",
"이상한 놈은 상대하지 마」"
],
"1394": [
"「뭐, 뭔가 그 말투는!?",
"그럼 달리 납득할 만한 설명이",
"있다는 건가!?」"
],
"1395": [
"「이 아가씨의 추리로",
"펑크에 발 묶기 의미는 없다고",
"증명되지 않았나!!」"
],
"1396": [
"「...끌어들이지 말아 줬으면」"
],
"1397": [
"「그렇다고 대뜸 괴롭히려는",
"목적에다 나고 씨가 범인이란",
"건 말이 안 되죠」"
],
"1398": [
"「아니에요, 저, 아니에요」"
],
"1399": [
"「아니라는 증거는 있나!?",
"펑크가 괴롭힘 목적이 아니라고",
"증명할 변명이 있냔 말일세!?」"
],
"1400": [
"「어, 저기, 그게, 이, 있어요!」"
],
"1401": [
"「거 보게!",
"있을 리가 없지...」"
],
"1402": [
"「뭐라고!?」"
],
"1403": [
"「이, 있단 말인가.",
"괴롭힘이 아닌 경우란 대체",
"무슨 이유인가, 자네!?」"
],
"1404": [
"「만약, 그...",
"내일 스태프가 온다는 걸",
"모르는 사람이라면요?」"
],
"1405": [
"「음? 뭐, 뭔가 그건」"
],
"1406": [
"「그러니까, 다른 스태프가 오는 걸",
"몰라서, 차가 없으면 발이",
"묶일 거라 믿고 있다든가...」"
],
"1407": [
"「아~, 그렇구나」"
],
"1408": [
"「그 경우엔 괴롭힘이 아니지.",
"그냥 발을 묶고 싶은 거야」"
],
"1409": [
"「...흐, 흠.",
"뭐, 그건... 일리가 있다고",
"말할 수도...」"
],
"1410": [
"「다만, 그쪽이 더 악질이라는 게",
"문제지만...」"
],
"1411": [
"「왜?」"
],
"1412": [
"「발을 묶고 싶다는 건,",
"이후에도 뭔가 저지를",
"생각이란 거잖아」"
],
"1413": [
"「...아아」"
],
"1414": [
"「아, 아직 계속된단 말인가!?",
"농담이 아닐세, 자네!?」"
],
"1415": [
"「제가 하는 게",
"아니라고요!?」"
],
"1416": [
"「그게, 스태프가 안 오면",
"발이 묶이게 될 거예요...」"
],
"1417": [
"「무슨 소린가 자네는.",
"온다니까, 스태프는!」"
],
"1418": [
"「....글쎄」"
],
"1419": [
"「『우리, 속은 거야』」"
],
"1420": [
"「뭐, 소, 속...」"
],
"1421": [
"「...라든가」"
],
"1422": [
"「언니...」"
],
"1423": [
"「누가 속인다는 거야?",
"몰래카메라냐, 이게」"
],
"1424": [
"「농담」"
],
"1425": [
"「근데 스태프가 못 오게",
"될 수는 있어」"
],
"1426": [
"「어, 어째서?」"
],
"1427": [
"「태풍으로 길이 통제된다든가」"
],
"1428": [
"「음.. 그, 그건...",
"뭐, 있을지도 모르지만...」"
],
"1429": [
"「있을 수 있다 쳐도,",
"펑크 낸 놈이 미리 알 수 있는",
"얘기는 아니잖아, 그건」"
],
"1430": [
"「응, 뭐, 적어도 내가",
"차로 달리는 동안엔 그런",
"뉴스는 안 나왔어」"
],
"1431": [
"「노, 놀라게 하지 말게, 자네!",
"결국 설명도 안 되잖나!!」"
],
"1432": [
"「애초에 네가 이상한 소리만",
"안 꺼냈으면 됐잖아」"
],
"1433": [
"「무슨 소린가!?",
"나의 완벽한 추리 어디가...」"
],
"1434": [
"「...저기요.",
"그 이전에, 유리 소리가 났을 때도",
"펑크 소리가 났을 때도...」"
],
"1435": [
"「지금 여기 있는 우리 전원",
"함께 있었잖습니까.",
"물론 나고 씨도」"
],
"1436": [
"「.........음?」"
],
"1437": [
"「아~, 그렇구나!",
"애초에 우리 중에 범인이",
"있을 리가 없네」"
],
"1438": [
"「...야, 거기 두 사람",
"진짜로 지금 듣기 전까지",
"몰랐던 건 아니겠지」"
],
"1439": [
"「뭐, 다, 당연하지!",
"하하하, 알고 있었고말고!」"
],
"1440": [
"「아니~, 난 잊고 있었어」"
],
"1441": [
"<fs 120>「진심이냐!?」<fs>"
],
"1442": [
"「뭔가 이젠 차라리",
"속이 시원하네, 나스 씨」"
],
"1443": [
"「저기, 그래서...",
"결국 어떻게 하면...?」"
],
"1444": [
"「어, 어떻게... 라니」"
],
"1445": [
"「범인이 어디 숨어 있는지",
"모르겠지만, 찾는다 해도",
"이 시간이니까요」"
],
"1446": [
"「이제 싫어...",
"밖에 나가면 뭔가 일어나고",
"무서우니까 싫어...」"
],
"1447": [
"「네네,",
"이제 안 나갈 테니까」"
],
"1448": [
"「어느 쪽이든 내일 되어서",
"다른 스태프가 오면",
"이런 짓은 못 하겠지」"
],
"1449": [
"「오늘은 조심해서",
"자 버리는 수밖에 없겠군」"
],
"1450": [
"「음~, 신경 쓰이지만",
"달리 방법이 없네」"
],
"1451": [
"「.........졸려」"
],
"1452": [
"「아~, 네네.",
"어쩐지 조용하다 했더니」"
],
"1453": [
"「그럼, 쉴까요」"
],
"1454": [
"「나고 씨도 다친 사람이니",
"이제 그만 자야죠」"
],
"1455": [
"「으, 응」"
],
"1456": [
"「그렇네.",
"누가 있을지도 모른다면",
"내일 찾아보자」"
],
"1457": [
"「무슨 생각인지 모를 놈이니까",
"일단 조심해 둬」"
],
"1458": [
"「네...",
"방문은 잠가 둘게요」"
],
"1459": [
"「그럼, 저는 먼저...」"
],
"1460": [
"우아하게 인사하고 미사사기 씨는",
"먼저 거실을 나갔다."
],
"1461": [
"「...정말이지!",
"웬 촌극인가, 기분 나쁘게...」"
],
"1462": [
"「시끄럽네, 진짜.",
"제일 신나서 떠든 주제에」"
],
"1463": [
"「시, 신나서 떠들다니 뭔가",
"무례하군, 자네!?」"
],
"1464": [
"「떠들지 말라고.",
"자, 철수하자」"
],
"1465": [
"「그러자.",
"언니 가자」"
],
"1466": [
"「....응~」"
],
"1467": [
"「나도.",
"내일 봐, 다들」"
],
"1468": [
"「우리도 갈까요」"
],
"1469": [
"「응, 안녕히 주무세요」"
],
"1470": [
"「그래... 아, 아니",
"편히 주무십시오」"
],
"1471": [
"「늦었어, 지금까지 계속",
"평소 말투로 떠들었잖아」"
],
"1472": [
"「이, 잊고 있었다고요!",
"이상한 일만 일어나고...」"
],
"1473": [
"...정체 모를 소동 탓에",
"다들 어딘가 불안한 모습으로",
"거실을 나왔다."
],
"1474": [
"「...참, 술이라도",
"안 마시면 못 해 먹겠군」"
],
"1475": [
"「와인이라도 괜찮으시다면",
"지하에 조금 있습니다」"
],
"1476": [
"「알아.",
"벌써 방에 한 병 받아 놨어」"
],
"1477": [
"「손 빠르네, 아저씨!?」"
],
"1478": [
"「흠, 와인이라...",
"나는 와인에 좀 까다롭네만」"
],
"1479": [
"「...거짓말 마」"
],
"1480": [
"「뭔가 자네는 아까부터!?",
"일일이 트집을...」"
],
"1481": [
"「하하, 떠들썩하네~」"
],
"1482": [
"「부탁인데, 밤새도록 그",
"텐션으로 떠들지 말아 줘」"
],
"1483": [
"「안 떠들어!",
"이제 지쳤어, 잘 거야」"
],
"1484": [
"「네네, 언니 이쪽」"
],
"1485": [
"「지하가 어딘데?」"
],
"1486": [
"「저기요,",
"봐요, 계단 있죠?」"
],
"1487": [
"「...아, 정말이네」"
],
"1488": [
"2층으로 올라가는 계단 옆에 조용히",
"지하로 내려가는 계단이 숨어 있었다."
],
"1489": [
"「흐음.",
"이런 곳에 계단이 있는 줄",
"몰랐네」"
],
"1490": [
"「내려가 볼까요?」"
],
"1491": [
"「뭐!?",
"괘, 괜찮아, 이런 밤늦게",
"그렇게 무서워 보이는 데」"
],
"1492": [
"「알기 쉬운 사람이네요」"
],
"1493": [
"「됐으니까 가자, 응.",
"다들 가 버렸어」"
],
"1494": [
"내가 지하 계단을 바라보는",
"사이에 다른 사람들은 벌써",
"2층으로 올라가 버렸다."
],
"1495": [
"「네네.",
"그럼 가 볼까요...」"
],
"1496": [
"「...?」"
],
"1497": [
"「뭔가 요란한 물소리가 났네요」"
],
"1498": [
"「뭐지?",
"바람에 뭐가 날아왔나」"
],
"1499": [
"「그럴까요?",
"바람에 날아온 것치곤",
"묵직한 소리 아니었어요?」"
],
"1500": [
"「그, 그럼 뭔데...?」"
],
"1501": [
"「...글쎄요?",
"그러고 보니 커다란 개구리가",
"있긴 했죠, 정원에」"
],
"1502": [
"「방금 게 개구리면 최소한",
"나만 한 크기잖아!?」"
],
"1503": [
"「설마 그렇게까지",
"크진 않았습니다만」"
],
"1504": [
"「당연하지...",
"개구리 아니야, 절대」"
],
"1505": [
"「그럼 뭘까요.",
"잠깐...」"
],
"1506": [
"「안 봐도 된다니까~!」"
],
"1507": [
"「신경 안 쓰여요?」"
],
"1508": [
"「이제 밖에 안 나간다고",
"아까 말했잖아~!?」"
],
"1509": [
"「안 그래도 이상한 일만",
"일어나고 있으니까 그만하자~!」"
],
"1510": [
"「아뇨, 오히려",
"모르는 채로 있는 게",
"더 위험하지 않을까요?」"
],
"1511": [
"「무서운 거면 어떡해!?",
"보면 안 되는 거라든가,",
"모르는 게 행복한 거라든가!!」"
],
"1512": [
"「...나고 씨는...」"
],
"1513": [
"「우, 아, 아니, 그게, 유, 유언!",
"유언이야, 돌아가신 할아버지의!」"
],
"1514": [
"「『군자는 위험을 멀리한다』!!」"
],
"1515": [
"「....유언이라구요」"
],
"1516": [
"「그래! 유언!」"
],
"1517": [
"「...음~,",
"유언이라면 어쩔 수 없죠」"
],
"1518": [
"「어, 납득하는구나...」"
],
"1519": [
"「그럼, 저 창문으로",
"들여다보기만 할까요」"
],
"1520": [
"「가까이 가잖아!",
"그거 충분히 가까이 가는 거라고!!」"
],
"1521": [
"「밖에까진 안 가요.",
"음~, 역시 어둡네...」"
],
"1522": [
"「...뭐, 뭐 있어?」"
],
"1523": [
"「역시 신경 쓰이는 거",
"아닙니까」"
],
"1524": [
"「신경 안 쓰이는 건 아니야!",
"...무서울 뿐이지」"
],
"1525": [
"「솔직한 사람이네.",
"근데 아무것도 없는 것 같네」"
],
"1526": [
"「거 봐...",
"역시 바람에 뭐가 날아왔다가",
"또 날아가 버린 거야」"
],
"1527": [
"「...그럴지도 모르겠네요.",
"뭐, 아침 되고 나서 다시",
"보러 오면 되려나...」"
],
"1528": [
"「응, 그러자.",
"그럼 이제 가자」"
],
"1529": [
"...한껏 붙임성 있는",
"쓴웃음을 지으며 히오리는",
"창가에서 떨어져 주었다."
],
"1530": [
"「...저쪽 제일 안쪽이",
"여자분들 방이에요」"
],
"1531": [
"2층에 올라오자 히오리가",
"오른쪽 안쪽을 가리키며 말한다."
],
"1532": [
"다른 사람들은 벌써 방으로 돌아간",
"모양인지 복도엔 아무도 없었다."
],
"1533": [
"「그 앞 모퉁이가 화장실입니다.",
"그다음은 차례로 쿠라이시 씨,",
"나스 씨, 마다라이 씨, 츠바키 씨」"
],
"1534": [
"「우리 방은 이 안쪽이에요」"
],
"1535": [
"「이쪽?」"
],
"1536": [
"「네, 계단 올라와서 바로니까",
"알기 쉽죠」"
],
"1537": [
"「...자, 들어오세요」"
],
"1538": [
"「와... 꽤 넓네.",
"여기 히오리 혼자 쓰는 거야?」"
],
"1539": [
"「네, 다른 데는 1인실인데",
"인원이 애매해서 저만 여기에」"
],
"1540": [
"「흐응?",
"그 나구모 씨란 사람 방은",
"따로 있는 거지?」"
],
"1541": [
"「있습죠.",
"화장실 하나 더 안쪽 방이에요,",
"미사사기 씨 옆」"
],
"1542": [
"「그렇구나.",
"왜 안 왔을까,",
"폭풍 때문에 발이 묶였나」"
],
"1543": [
"「아마 그런 거겠죠.",
"연락할 방법이 없으니, 여긴」"
],
"1544": [
"「응... 어라?」"
],
"1545": [
"「저거 전화 아니야?」"
],
"1546": [
"「아아, 그건 내선 전화예요.",
"이 저택 안 다른 방에만",
"연결돼 있거든요」"
],
"1547": [
"「밖으론 안 통하는구나...",
"내일 정말 산 내려갈 수 있을까」"
],
"1548": [
"「아침 되면 좀 낫겠죠.",
"밤엔 아무래도 위험해서",
"달릴 만한 게 못 되지만요」"
],
"1549": [
"「응... 이미 어디가 길인지",
"모를 정도였어」"
],
"1550": [
"「하하, 내리길 잘했네요.",
"이 근처 주변이 온통 벼랑이라",
"자칫하면 떨어졌을 거예요」"
],
"1551": [
"「주변이 절벽인 곳이",
"많거든요」"
],
"1552": [
"「...다, 다행이다.",
"차에서 내려서....」"
],
"1553": [
"「차도 찾아야겠네요.",
"길가에 있다면 내일 내려갈 때",
"도중에 찾을 수 있겠죠」"
],
"1554": [
"「태워 준다면,",
"그대로 내 차 타고 돌아갈게」"
],
"1555": [
"「안 돼요, 그 전에",
"병원 가야죠.",
"머리 부딪쳤잖습니까, 당신」"
],
"1556": [
"「차는 제가 따라가서 챙길 테니",
"나고 씨는 먼저 병원 가서",
"괜찮은지 검사받으세요」"
],
"1557": [
"「이제 별로 안 아픈데,",
"가는 게 나으려나?」"
],
"1558": [
"「머리는 방심하면 안 된다니까요」"
],
"1559": [
"「으음...",
"그렇겠지」"
],
"1560": [
"「오늘 밤에도 혹시 속이 안 좋아지면",
"바로 말해 주세요.",
"전 깨어 있을 테니까」"
],
"1561": [
"「어? 됐어, 그렇게까지...」"
],
"1562": [
"「한밤중에 토하면 어쩔 건데요」"
],
"1563": [
"「으... 그, 그건 좀",
"싫지만...」"
],
"1564": [
"「좀 싫은 걸로 안 끝나요」"
],
"1565": [
"「그래도 역시 미안해.",
"그렇게 걱정 안 해도",
"아마 괜찮을 테니까」"
],
"1566": [
"「...제 할아버지가요,",
"물건이 떨어져서 머리 부딪치고",
"돌아가셨거든요」"
],
"1567": [
"「그래서 신경이 쓰여서요.",
"아침에 안 일어나면",
"어쩌나... 하고」"
],
"1568": [
"「귀찮을지도 모르지만",
"하룻밤만 참아 주세요」"
],
"1569": [
"「.....알았어.",
"그럼 말이야, 속 안 좋아지면",
"깨울 테니까 누워는 있어」"
],
"1570": [
"「그래요?",
"뭐, 옆에서 깨어 있으면 불편하겠네」"
],
"1571": [
"「그럼 참지 말고",
"사양 말고 두들겨 깨우세요」"
],
"1572": [
"「응」"
],
"1573": [
"「그럼, 그 침대 쓰세요.",
"전 이쪽 쓸 테니까」"
],
"1574": [
"「고마워」"
],
"1575": [
"「안녕히 주무세요」"
],
"1576": [
"「잘 자...」"
],
"1577": [
"손을 팔랑팔랑 흔들며 히오리는",
"옆 침대에 벌러덩 누웠다."
],
"1578": [
"나도 불을 끄고 안경을 벗고",
"부스럭부스럭 이불 속에 파고든다."
],
"1579": [
"（...유난히 신경 써 준다",
"했더니...）"
],
"1580": [
"할아버지라...",
"우리 할아버지도 꽤 오래전에",
"돌아가셨지만 천수를 누리셨지."
],
"1581": [
"「...아야...」"
],
"1582": [
"돌아누우려다가 마침",
"부딪친 곳을 베개에 눌렀는지",
"조금 아팠다."
],
"1583": [
"「...나고 씨?」"
],
"1584": [
"「아, 괜찮아.",
"좀, 어느 쪽 보고",
"잘까 해서...」"
],
"1585": [
"어떻게든 아프지 않게 옆으로 누워",
"몸을 편히 했다."
],
"1586": [
"히오리도 그걸 보고 안심했는지",
"다시 침대에 몸을 묻는다."
],
"1587": [
"（....좀,",
"열이 있나...）"
],
"1588": [
"눈 안쪽이 뜨겁다.",
"하지만 머리를 부딪친 탓인지,",
"빗속을 걸은 탓인지...."
],
"1589": [
"감기 걸렸으면 싫은데.",
"열이 심하게 안 올라야 할 텐데."
],
"1590": [
"（뭐, 그래도...）"
],
"1591": [
"（내일까지만 참으면 되니까.",
"산만 내려가면 병원 가고,",
"그러고 나서...）"
],
"1592": [
"（아, 아르바이트 없어졌지.",
"어떡하나...）"
],
"1593": [
"두서없는 생각이 계속 떠올라서",
"좀처럼 잠이 오지 않는다."
],
"1594": [
"일이 너무 많아서 진정이 안 되는지",
"살짝 꾸벅꾸벅해도 바람이 조금만",
"세게 불어도 잠이 깬다."
],
"1595": [
"（비... 안 그치네...）"
],
"1596": [
"문득 보니 내가 뒤척일 때마다",
"히오리도 깨서 이쪽을 신경 써",
"주고 있는 것 같았다."
],
"1597": [
"（...자야지.",
"내가 안 자면 저쪽도",
"안심 못 할 테니까...）"
],
"1598": [
"그렇게 생각하고 눈을 감아도",
"창을 두드리는 빗소리, 비명 같은",
"바람 소리가 귀에 걸려 푹 못 잔다."
],
"1599": [
"그대로 잠들 듯 말 듯한",
"어중간한 상태로..."
],
"1600": [
"밖이 밝아질 때까지",
"둘이서 자다 깨다 했다..."
],
"1601": [
"..........."
],
"1602": [
".................."
],
"1603": [
"（.................）"
],
"1604": [
"（.........비.........）"
],
"1605": [
"흐릿한 의식 속으로",
"다시 조금 거세지기 시작한 빗소리가",
"스며든다...."
],
"1606": [
"「.................」"
],
"1607": [
"눈을 비비며 고개를 돌렸다.",
"일단 날은 밝은 모양이다."
],
"1608": [
"（밝은 거 맞지,",
"이래 봬도...）"
],
"1609": [
"비 때문인지 여전히 어둑해서",
"도무지 아침 같지 않지만."
],
"1610": [
"「음~... 응」"
],
"1611": [
"목소리가 난 쪽을 보니",
"벌써 단정하게 기모노로 갈아입은",
"히오리가 서 있었다."
],
"1612": [
"「안녕...",
"벌써 일어났구나」"
],
"1613": [
"「저도 지금 막 일어났습니다만」"
],
"1614": [
"그러고 보니 빗소리에 섞여",
"희미하게 옷 스치는 소리를",
"들었던 것 같다."
],
"1615": [
"「몸은 좀 어때요?」"
],
"1616": [
"「...머리는 괜찮은 것 같아.",
"이제 별로 안 아프고」"
],
"1617": [
"나도 침대에서 상반신을 일으키며",
"하품 섞어 대답한다."
],
"1618": [
"더듬어 안경을 찾아 쓰자",
"시야와 함께 머리도 조금",
"맑아진 느낌이 들었다."
],
"1619": [
"「스태프 올 때까지 자도",
"상관없어요.",
"어젯밤 별로 못 잤잖아요」"
],
"1620": [
"「못 잤다기보다는...",
"자다 깨다 한 느낌이었어」"
],
"1621": [
"「저도요.",
"그냥 꾸벅꾸벅한 정도라」"
],
"1622": [
"「내가 자꾸",
"깨서 그런 거 아냐?」"
],
"1623": [
"「아뇨, 혼자 잤어도",
"마찬가지였을 거예요.",
"왠지 신경이 곤두서서요」"
],
"1624": [
"「...그렇구나」"
],
"1625": [
"낯선 저택이라는 긴장감 탓인지,",
"어젯밤 본 것의 기이함 탓인지...."
],
"1626": [
"다만 혼자였다면 무서워서 정말",
"한숨도 못 잤을지도 모른다.",
"조금이라도 쉬어서 다행이다."
],
"1627": [
"「어라...",
"이 창문, 잠금장치가 없네」"
],
"1628": [
"「아아, 원래 없어요.",
"이런 산속이니 누가",
"들어오진 않겠지만요」"
],
"1629": [
"「뭐, 그렇겠지.",
"온다 해도 저 돌벽은",
"못 오를 것 같고...」"
],
"1630": [
"「다들 벌써 일어났으려나?」"
],
"1631": [
"「아까 복도 쪽에서 뭔가",
"소리가 났으니 일어난 사람은",
"있지 않을까 싶네요」"
],
"1632": [
"「소리 났었어?",
"난 못 들었는데」"
],
"1633": [
"「꾸벅꾸벅해서 그렇겠죠.",
"빗소리도 시끄럽고」"
],
"1634": [
"「제가 들은 것도",
"쿵쾅거리는 발소리뿐이에요.",
"아마 나스 씨려나」"
],
"1635": [
"「그렇구나...",
"그럼 나도 일어날까」"
],
"1636": [
"「그럼 밥 먹을까요」"
],
"1637": [
"「어? 아니, 괜찮아.",
"거기까지 신세 질 수는」"
],
"1638": [
"「무슨 소리예요.",
"그렇게 사양하지 마세요」"
],
"1639": [
"「스태프가 몇 시에 올지도",
"모르는데 참고 기다릴 건",
"없잖아요」"
],
"1640": [
"「그래도 여긴 잠깐 장 보러",
"쉽게 갈 수 있는 데도 아니고,",
"내가 먹으면 곤란하지 않아?」"
],
"1641": [
"「식량은 차고 넘칠 만큼",
"있다고 츠바키 씨가 그랬으니",
"괜찮아요」"
],
"1642": [
"「아니, 그래도 역시...」"
],
"1643": [
"「식욕이 없어요?",
"그럼 아직 몸이 안 좋은 걸지도",
"모르겠네요」"
],
"1644": [
"「아, 아니.",
"그런 건 아닌데」"
],
"1645": [
"「그럼 제대로 드세요.",
"안 그러면 다른 사람도 걱정해요」"
],
"1646": [
"「아...",
"응, 그건...」"
],
"1647": [
"「...그러니까,",
"식사 시간은 정해져 있어?」"
],
"1648": [
"「그러고 보니 안 정했네요.",
"어제는 다들 제각각 다른 시간에",
"도착해서 대충 먹었거든요」"
],
"1649": [
"「뭐, 부엌에 가면",
"뭐라도 있을 거예요」"
],
"1650": [
"「그래...?",
"그럼, 미안하지만 아침만",
"얻어먹을까」"
],
"1651": [
"「그렇게 하세요.",
"안 그러면 산 내려갈 때까지",
"아무것도 못 먹으니까요」"
],
"1652": [
"「그렇네.",
"...내려갈 수 있을까」"
],
"1653": [
"「글쎄요...」"
],
"1654": [
"그렇게 말하며 히오리는",
"커튼을 살짝 걷고 밖을 본다."
],
"1655": [
"「어젯밤보단 나아졌으니",
"어떻게든 괜찮겠죠」"
],
"1656": [
"「그렇구나, 다행이다」"
],
"1657": [
"「그럼, 갈까요.",
"벌써 배고파요?」"
],
"1658": [
"「아니, 막 일어나서",
"아직 그렇게는... 히오리는?」"
],
"1659": [
"「저도 아직 그런 느낌이에요.",
"그럼 먼저 서재로 갈까요」"
],
"1660": [
"「서재?」"
],
"1661": [
"「배치도가 있거든요, 여기.",
"일단 드릴게요」"
],
"1662": [
"「없으면 길 잃을 만큼 넓어?」"
],
"1663": [
"「길을 잃을 정도는",
"아니겠지만요」"
],
"1664": [
"「우리가 연습 중이라 안내 못 할 때",
"화장실 위치를 모르게 되면",
"곤란하잖아요」"
],
"1665": [
"「그, 그건 좀 곤란해」"
],
"1666": [
"넓긴 하지, 이 저택.",
"어젯밤 들어가 본 거실이나 욕실",
"말고는 뭐가 어딘지 전혀 모른다."
],
"1667": [
"「그럼, 먼저 서재로 가죠」"
],
"1668": [
"「아, 벌써 30분 지났네」"
],
"1669": [
"거실에 가 보자."
],
"1670": [
"어두운 계단을 다 올라 머리 위 문을",
"밀어 열자 거센 빗소리가 들렸다."
],
"1671": [
"「어, 밖...?」"
],
"1672": [
"갑자기 밝아져 눈을 깜박이며",
"주위를 둘러본다."
],
"1673": [
"「...온실이다」"
],
"1674": [
"저택과 온실은 지하 통로로",
"이어져 있었구나...."
],
"1675": [
"한동안 멍하니 온실에서",
"비가 흐르는 유리 너머로",
"저택을 바라본다...."
],
"1676": [
"「.........아」"
],
"1677": [
"「지금 몇 시지.",
"슬슬 돌아가는 게 좋겠다」"
],
"1678": [
"허둥지둥 지하 통로 문을 닫고",
"저택으로 돌아간다."
],
"1679": [
"「아~, 미안.",
"나, 슬슬",
"언니한테 가 봐야 해」"
],
"1680": [
"「아, 그렇지.",
"나도 슬슬 가야겠다」"
],
"1681": [
"「그럼, 실례했어.",
"나중에 봐」"
],
"1682": [
"「응, 그럼 안녕~」"
],
"1683": [
"자, 거실로 가자."
],
"1684": [
"「이제 됐어?",
"나, 슬슬 가 봐야 돼」"
],
"1685": [
"「아, 응.",
"그럼...」"
],
"1686": [
"「응, 바이바이」"
],
"1687": [
"（왠지 쌀쌀맞았네.",
"피하는 걸지도...）"
],
"1688": [
"거실로 가자...."
],
"1689": [
"「...계란 구울 거야」"
],
"1690": [
"「아, 요리하던 중이었지, 미안」"
],
"1691": [
"「아니」"
],
"1692": [
"「...이따가, 같이 먹자」"
],
"1693": [
"「고마워,",
"히오리도 뭐 만든다고 했으니까",
"불러올게」"
],
"1694": [
"「그럼, 금방 돌아올게」"
],
"1695": [
"음, 히오리는 벌써 거실에 있으려나."
],
"1696": [
"말없이 고개를 끄덕이고 시즈나는",
"개수대 쪽으로 가 버렸다."
],
"1697": [
"（...원래 저런 건지,",
"내가 미움받는 건지",
"잘 모르겠다...）"
],
"1698": [
"일단,",
"슬슬 거실에 가 보자."
],
"1699": [
"「...다른 분들은 벌써",
"일어나셨을까요」"
],
"1700": [
"「슬슬 1층으로 내려가 볼게요」"
],
"1701": [
"「그렇네요, 저도 내려갈게요」"
],
"1702": [
"「먼저 가 계세요.",
"저는 약을 먹고 갈게요」"
],
"1703": [
"「네, 그럼",
"실례했습니다」"
],
"1704": [
"「네, 나중에 봬요」"
],
"1705": [
"자, 거실에 가 보자."
],
"1706": [
"「...이제 됐을까요.",
"저, 좀...」"
],
"1707": [
"「아, 네, 죄송해요.",
"그럼 실례하겠습니다」"
],
"1708": [
"「네...」"
],
"1709": [
"（왠지 별로 환영받지 못하는",
"분위기였네...）"
],
"1710": [
"역시 갑자기 나타난 수상한 놈이라고",
