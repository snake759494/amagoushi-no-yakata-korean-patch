],
"1725": [
"「아~, 미안! 부탁해!」"
],
"1726": [
"「그럼, 이따 봐」"
],
"1727": [
"「어, 금방 갈게~」"
],
"1728": [
"음, 일단 거실이었지."
],
"1729": [
"「...이제 됐습니까.",
"저는 이만 방을 나갈 건데요」"
],
"1730": [
"「아, 응.",
"실례했어」"
],
"1731": [
"（왠지... 츠바키 군은",
"날 수상하게 보는 것 같아）"
],
"1732": [
"...일단 거실로 가자."
],
"1733": [
"「...아, 맞다.",
"아직 아침 프로틴 안 마셨네」"
],
"1734": [
"「네? 아, 죄송해요",
"제가 방해해서...」"
],
"1735": [
"「아니, 괜찮아.",
"지금 마시면 되니까」"
],
"1736": [
"「그럼, 실례하겠습니다」"
],
"1737": [
"「응, 미안해.",
"나중에 봐」"
],
"1738": [
"「네, 나중에 봬요」"
],
"1739": [
"마침 적당한 시간이 됐으니",
"거실에 가 볼까."
],
"1740": [
"「...이제 됐으려나.",
"아침 프로틴을",
"아직 안 마셔서 말이야」"
],
"1741": [
"「아, 죄송해요",
"방해해서」"
],
"1742": [
"「응, 그럼 안녕」"
],
"1743": [
"（...일단 거실로 가자）"
],
"1744": [
"「슬슬 다른 사람들도",
"아침 먹으러 오려나요」"
],
"1745": [
"「그럼 부엌 쪽으로",
"가 볼까요」"
],
"1746": [
"「...아, 전 화장실 들렀다",
"갈 테니 먼저 가 계세요」"
],
"1747": [
"「응, 알았어」"
],
"1748": [
"「역시",
"넓네...」"
],
"1749": [
"외국 옛날 영화에 나올 것 같은",
"분위기야."
],
"1750": [
"크고 넓은 창으로 정원이 한눈에 보인다.",
"맑았다면 기분 좋았겠다."
],
"1751": [
"「마, 다... 라이 씨...",
"주... 죽었...........」"
],
"1752": [
"「...으........」"
],
"1753": [
"「으아아아아아아아악!?」"
],
"1754": [
"외침과 동시에 뒷걸음질 쳐",
"달아나려 했다."
],
"1755": [
"...하지만 다리가 꼬여 그 자리에",
"털썩 주저앉는다."
],
"1756": [
"「아, 아... 누, 누구...」"
],
"1757": [
"뒤로 짚은 손을 움직여",
"어떻게든 문으로 다가가려 했지만",
"거의 움직일 수 없었다."
],
"1758": [
"「――나고 씨!?」"
],
"1759": [
"「으악!?",
"히, 히오리...!」"
],
"1760": [
"「무슨 일이에요!?",
"나고 씨!?」"
],
"1761": [
"「누, 눈이...」"
],
"1762": [
"「눈?」"
],
"1763": [
"「눈이!!",
"눈이 마주쳐 버렸어!!」"
],
"1764": [
"「왜 나만!?",
"응! 왜 나만!?」"
],
"1765": [
"「진정해요 진정해요,",
"뭐랑 눈이 마주쳤는데요?」"
],
"1766": [
"「마다라이 씨야!!",
"응, 왜 나야!?」"
],
"1767": [
"소란을 피우자 다른 사람들이 줄줄이",
"의아한 얼굴로 나타난다."
],
"1768": [
"「뭐야?",
"그 아저씨 이번엔 무슨",
"트집을 잡은 거야?」"
],
"1769": [
"「곤란한 분이네요...」"
],
"1770": [
"「아, 아니... 주, 주,",
"마, 마다... 씨... 죽었...」"
],
"1771": [
"아니라고 말하고 싶은데 혀가 안 돈다.",
"허둥대고 있자 등 뒤에서",
"시즈나의 목소리가 들렸다."
],
"1772": [
"「....아닐 거야」"
],
"1773": [
"「언니?",
"무슨 일이야?」"
],
"1774": [
"「마다라이 씨 어딨어?」"
],
"1775": [
"「의자 위」"
],
"1776": [
"「식사 중이신가요?」"
],
"1777": [
"「<fs 110>...읏, 아니야!!<fs>」"
],
"1778": [
"겨우 그것만 외치고",
"의자 쪽을 가리킨다."
],
"1779": [
"「...응」"
],
"1780": [
"「아니야」"
],
"1781": [
"나와 시즈나의 모습에 다른 사람들은",
"수상쩍게 서로 얼굴을 마주 본다."
],
"1782": [
"「나고 씨...",
"아니라니, 그럼...」"
],
"1783": [
"「그, 그치만... 저거...!」"
],
"1784": [
"「그치만, 마다라이 씨 죽었어」"
],
"1785": [
"혼란스러운 나 대신 시즈나의",
"담담한 목소리가 대답한다."
],
"1786": [
"「네...?」"
],
"1787": [
"「뭐라고?」"
],
"1788": [
"「나고 씨...」"
],
"1789": [
"나는 말없이 끄덕이는 게 고작이었다.",
"끄덕이면서 필사적으로 의자 쪽을",
"계속 가리킨다."
],
"1790": [
"「설마...!」"
],
"1791": [
"그렇게 말하고 나스 씨가 먼저",
"의자 쪽으로 달려간다.",
"츠바키 씨, 쿠라이시 씨가 뒤따랐다."
],
"1792": [
"「...일어설 수 있겠어요?」"
],
"1793": [
"「으... 응...」"
],
"1794": [
"나는 히오리의 부축을 받아",
"간신히 일어섰다."
],
"1795": [
"「꺄아악...!!」"
],
"1796": [
"덩달아 다가가 버린 모양인",
"미사사기 씨의 비명이 들린다."
],
"1797": [
"허둥지둥 스즈나와",
"껴안다시피 하며 미사사기 씨는",
"우리 쪽으로 돌아왔다."
],
"1798": [
"「...괜찮아요?」"
],
"1799": [
"「네... 네....」"
],
"1800": [
"「뭔데, 저거...?」"
],
"1801": [
"「몰라...!",
"내가 봤을 때부터 이미...」"
],
"1802": [
"「이치야나기 님, 잠깐 와 주세요!」"
],
"1803": [
"「에에엣!?",
"왜!?」"
],
"1804": [
"「뭔가 이상한 일이라도",
"생긴 거 아닐까요?」"
],
"1805": [
"「생겼어!!",
"이미 한참 전부터 이상했다고!!」"
],
"1806": [
"「나고무 군~,",
"저거 네가 한 거 아니지?」"
],
"1807": [
