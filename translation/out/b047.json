 ],
 "23888": [
  " 료스케는 외울 생각이 없는 일에는",
  "철저히 무지한 채로 있는 사람이라,",
  "스스로 헤맨다고 단언한 이상 저택 안",
  "길을 아직 파악하지 못한 건 틀림없다.",
  " 다시 긴 복도를 지나 저택을 나와서",
  "뒤뜰을 비스듬히 가로질러 온실에 왔다.",
  "자물쇠는 원래 없다고 하며, 유리문은",
  "순순히 열렸다.",
  "「오오, 이거 굉장한데」"
 ],
 "23889": [
  " 가장 먼저 들어간 료스케가 신이 난",
  "목소리를 낸다. 뒤따라 들어가 보니,",
  "숨이 턱 막힐 듯한 습기가 피부에",
  "느껴졌다. 안은 꽤 온도가 높은 듯하다.",
  " 바닥은 벽 쪽과 한가운데에 화단처럼",
  "흙이 드러난 부분이 있고, 거기엔 그다지",
  "낯익지 않은 식물――아마 따뜻한 기후의",
  "외국 것이리라――이 푸르게 우거져",
  "있었다."
 ],
 "23890": [
  " 게다가 천장에서도 화분이 매달려 있고,",
  "큰 잎을 단 식물이 덩굴을 뻗고 있다.",
  "「료스케, 어디 있어?」",
  " 우거진 식물에 시야가 가려, 료스케의",
  "모습을 놓쳐 버렸다.",
  "「이쪽이야」",
  " 목소리를 따라 안쪽으로 늘어진 덩굴과",
  "잎을 헤치고, 무성한 가지를 피해 간다."
 ],
 "23891": [
  " 온실 거의 한가운데라고 생각되는 곳에",
  "어깨에 항아리를 멘 여인의 하얀 석상이",
  "있고, 주위엔 둥근 선반이 놓여 작은",
  "화분과 조개껍데기 모양 접시, 그리스의",
  "아테나와 북유럽 전쟁 여신의 청동상,",
  "도자기 천사 인형, 뭔지 모를 철제",
  "오브제 등이 함께 늘어서 있었다. 그",
  "발치엔 은색의 가느다란 주둥이",
  "물뿌리개와 나무 들통이 놓여 있다."
 ],
 "23892": [
  "「아아, 여기 있었네」",
  " 료스케는 그 석상 건너편에서, 석상이",
  "멘 항아리를 들여다보듯 올려다봤다.",
  "「뭐 하는 거야?」",
  "「여기서 물이 나오는 건 아닌가 봐」",
  "「젖은 흔적은 없는데」",
  "「그럼 그냥 장식인가. 흐음」",
  " 시시하다는 듯 말하고, 료스케는",
  "석상 주위를 한 바퀴 빙 돌았다."
 ],
 "23893": [
  "「...여긴 뭐 하러 온 거야?」",
  "「응? 아아, 볼일은 끝났어. 더우니까",
  "이제 나가자」",
  "「뭐야, 그게?」",
  " 당연하다는 듯 내 의문은 무시하고",
  "료스케는 휙 온실을 나가 버린다.",
  "「경감님, 하나코는 만날 수 있나요?」",
  "「...가 보시겠습니까」"
 ],
 "23894": [
  " 놀라는 것조차 이젠 귀찮아졌는지,",
  "진노 경감은 쓴웃음을 지으며 옷깃을",
  "매만지고 료스케의 뒤를 따라갔다.",
  " 나는 한 번 더 온실 안을",
  "둘러보았지만 ――역시 료스케가 뭘",
  "하러 왔는지 도무지 알 수 없었다."
 ],
 "23895": [
  " 요도자키 하나코는 몹시 초췌한",
  "모습이었다. 취조실의 간소한 의자에",
  "앉아 깊이 고개를 숙이고, 이따금",
  "이쪽을 힐끔 치떠 훔쳐볼 뿐 누구와도",
  "눈을 마주치려 하지 않는다.",
  " 저런 저택에서 아가씨로 자란 사람에게",
  "경찰서에 며칠이나 구류되는 경험은 필시",
  "신경이 곤두서는 일이리라."
 ],
 "23896": [
  " 나도 예전에 이 방에서 호되게 추궁당한",
  "기억이 있는 만큼 동정을 금할 수 없다.",
  "「하나코 씨, 이쪽은 경찰 수사에 협력해",
  "주고 계신 탐정님입니다」",
  " 경감이 먼저 료스케를 소개했다.",
  "「물어보시는 건 저희한테처럼 정직하게",
  "대답해 주십시오」",
  " 가냘픈 어깨가 조금 떨리고, 하나코는",
  "네, 하고 희미한 목소리로 대답했다."
 ],
 "23897": [
  "「그럼 하나코 씨, 여쭙겠습니다」",
  " 어울리지 않을 만큼 쾌활한 말투로",
  "료스케가 입을 열었다.",
  "「요정이 어디 있는지 아십니까」",
  "「네...?」",
  " 갑자기 전혀 예상치 못했을 질문을",
  "받고, 하나코는 순간 눈을 들었다.",
  "하지만 눈이 마주칠 듯하자 이내 다시",
  "시선을 내리깔았다."
 ],
 "23898": [
  "「저, 저기...저는...모릅니다...」",
  "「그렇군요. 당신이 요도자키 씨를 때린",
  "흉기는 도감이라면서요」",
  "「네」",
  " 허둥대던 말투가 갑자기 반듯해지더니,",
  "하나코는 또렷하게 고개를 끄덕였다.",
  "「...서재의, 책상 위에 있던 도감으로",
  "제가 때렸습니다. 도감은 소각로에",
  "버렸습니다」"
 ],
 "23899": [
  " 여기서 이미 몇 번이나 같은 질문을",
  "받았으리라. 하나코는 마치 최면술에라도",
  "걸린 듯 무기질적이고 감정 없는",
  "목소리로 그렇게 말했다.",
  "「아아, 그 부분은 지금은 됐습니다」",
  "「네...」",
  " 하나코가 처음으로 고개를 들었다.",
  "경찰과는 영 다르다고 생각했는지, 이상한",
  "말만 하는 남자를 보고 싶어졌는지."
 ],
 "23900": [
  "「그 도감 말인데요, 당신이 직접",
  "읽어 보거나 뭔가에 쓴 적은?」",
  "「아, 그건...어릴 때라면...」",
  "「흥, 그렇군요. 확실히 아이들은",
  "그런 그림이나 사진이 잔뜩 실린 책을",
  "좋아하죠. 당신도 그런 아이였던",
  "거로군요」",
  "「...네」"
 ],
 "23901": [
