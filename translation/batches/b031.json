[
{
"id": 16221,
"kind": "msg",
"jp": [
"「静奈ちゃん言っただろ?",
"『猫は斑井さん』って」"
]
},
{
"id": 16222,
"kind": "msg",
"jp": [
"「あれがヒントになったんだ。",
"その後も同じなんだよ」"
]
},
{
"id": 16223,
"kind": "msg",
"jp": [
"「・・・同じ」"
]
},
{
"id": 16224,
"kind": "msg",
"jp": [
"「黒猫以外の温室に置いてあるものも",
"みんな次に狙われる誰かを暗示してるん",
"じゃないかと思ったんだ」"
]
},
{
"id": 16225,
"kind": "msg",
"jp": [
"「・・・あの、温室ので次は誰って",
"犯人が言うてきてるん」"
]
},
{
"id": 16226,
"kind": "msg",
"jp": [
"「うん・・・。",
"あと、一応こういう順番に狙って",
"きてそうだなっていうのはあるけど」"
]
},
{
"id": 16227,
"kind": "msg",
"jp": [
"書斎で考えていたことをメモした",
"手帳を開く。"
]
},
{
"id": 16228,
"kind": "msg",
"jp": [
"「書いてあるん?",
"見せて」"
]
},
{
"id": 16229,
"kind": "msg",
"jp": [
"「順番がそうなってるんだ」"
]
},
{
"id": 16230,
"kind": "msg",
"jp": [
"「・・・順番?」"
]
},
{
"id": 16231,
"kind": "msg",
"jp": [
"「うん、犯人がどういう順番で",
"選んでるんだろうって考えて",
"みたんだけどさ・・・」"
]
},
{
"id": 16232,
"kind": "msg",
"jp": [
"手帳を開いて説明しようとすると",
"静奈ちゃんが覗き込んできた。"
]
},
{
"id": 16233,
"kind": "msg",
"jp": [
"「えっと、順番は・・・」"
]
},
{
"id": 16234,
"kind": "msg",
"jp": [
"「待って」"
]
},
{
"id": 16235,
"kind": "msg",
"jp": [
"説明しようとすると、静奈ちゃんは",
"恐ろしく真剣な顔で僕を止めた。"
]
},
{
"id": 16236,
"kind": "msg",
"jp": [
"（なんだろう・・・?）"
]
},
{
"id": 16237,
"kind": "msg",
"jp": [
"「あの・・・何か変・・・?」"
]
},
{
"id": 16238,
"kind": "msg",
"jp": [
"・・・答えてくれない。",
"だんだん不安になってきた。"
]
},
{
"id": 16239,
"kind": "msg",
"jp": [
"「・・・・ギブアップ」"
]
},
{
"id": 16240,
"kind": "msg",
"jp": [
"「わからへん。",
"これ、何の順番?」"
]
},
{
"id": 16241,
"kind": "msg",
"jp": [
"「か、考えてたの?」"
]
},
{
"id": 16242,
"kind": "msg",
"jp": [
"「だって本の発売順でも",
"発表順でもないし・・・」"
]
},
{
"id": 16243,
"kind": "msg",
"jp": [
"「・・・事件の起きた順",
"やったら『花』がこんな",
"前にあるの変やし・・・」"
]
},
{
"id": 16244,
"kind": "msg",
"jp": [
"「あ、それ、事件の発端が",
"20年前って書いてあったから」"
]
},
{
"id": 16245,
"kind": "msg",
"jp": [
"「だから、事件の発生順ていうか",
"年代順のつもりなんだけど」"
]
},
{
"id": 16246,
"kind": "msg",
"jp": [
"「・・・・・しまった」"
]
},
{
"id": 16247,
"kind": "msg",
"jp": [
"「見落とし」"
]
},
{
"id": 16248,
"kind": "msg",
"jp": [
"「・・・全部読んでるのに」"
]
},
{
"id": 16249,
"kind": "msg",
"jp": [
"・・・ものすごく悔しそうだ。"
]
},
{
"id": 16250,
"kind": "msg",
"jp": [
"「・・・えーと。",
"あの、静奈ちゃん・・・?」"
]
},
{
"id": 16251,
"kind": "msg",
"jp": [
"「とりあえず、思てたより",
"お兄さんが鋭そうな気はしてきた」"
]
},
{
"id": 16252,
"kind": "msg",
"jp": [
"誉められてるんだろうか・・・。"
]
},
{
"id": 16253,
"kind": "msg",
"jp": [
"「・・・『悪魔の花園』」"
]
},
{
"id": 16254,
"kind": "msg",
"jp": [
"「うん、静奈ちゃん達と",
"同じ名前の双子が出てくるから」"
]
},
{
"id": 16255,
"kind": "msg",
"jp": [
"「・・・・なんで?」"
]
},
{
"id": 16256,
"kind": "msg",
"jp": [
"「本、違う」"
]
},
{
"id": 16257,
"kind": "msg",
"jp": [
"「本?」"
]
},
{
"id": 16258,
"kind": "msg",
"jp": [
"「今日のところにあるのん、",
"うちらの出てくる本と違うけど」"
]
},
{
"id": 16259,
"kind": "msg",
"jp": [
"「あ、うん、そうなんだけど",
"並べてみるとこうなっちゃって・・・」"
]
},
{
"id": 16260,
"kind": "msg",
"jp": [
"「・・・・ふぅん」"
]
},
{
"id": 16261,
"kind": "msg",
"jp": [
"「ほんで、どないするん?」"
]
},
{
"id": 16262,
"kind": "msg",
"jp": [
"「理由はわかったけど。",
"具体的対策は」"
]
},
{
"id": 16263,
"kind": "msg",
"jp": [
"「あ・・・",
"信じてくれるんだ」"
]
},
{
"id": 16264,
"kind": "msg",
"jp": [
"「とりあえず」"
]
},
{
"id": 16265,
"kind": "msg",
"jp": [
"とりあえずか・・・。",
"でもまあ、完全に信用してもらえない",
"よりはよっぽどマシだよな。"
]
},
{
"id": 16266,
"kind": "msg",
"jp": [
"「えーと、どうやら犯人は",
"見立て殺人ていうのを",
"やってるみたいだからさ」"
]
},
{
"id": 16267,
"kind": "msg",
"jp": [
"「見立て・・・」"
]
},
{
"id": 16268,
"kind": "msg",
"jp": [
"「斑井さんのあれ、",
"何やったか知ってる?」"
]
},
{
"id": 16269,
"kind": "msg",
"jp": [
"「あれ?",
"えーと、あれは・・・」"
]
},
{
"id": 16270,
"kind": "msg",
"jp": [
"「・・・『猫と初雪』だったっけ」"
]
},
{
"id": 16271,
"kind": "msg",
"jp": [
"「猫違い」"
]
},
{
"id": 16272,
"kind": "msg",
"jp": [
"「え? あれ?」"
]
},
{
"id": 16273,
"kind": "msg",
"jp": [
"「あれは『黒猫の毒』のほう」"
]
},
{
"id": 16274,
"kind": "msg",
"jp": [
"「あ、そうか!」"
]
},
{
"id": 16275,
"kind": "msg",
"jp": [
"どっちも猫がつくタイトルだったから",
"間違えた・・・。"
]
},
{
"id": 16276,
"kind": "msg",
"jp": [
"「・・・なんだっけ。",
"『我輩は猫である』・・じゃないよね」"
]
},
{
"id": 16277,
"kind": "msg",
"jp": [
"「それはそれで見立てには",
"使えるやろうけど、はずれ」"
]
},
{
"id": 16278,
"kind": "msg",
"jp": [
"「つ、使えたっけ!?」"
]
},
{
"id": 16279,
"kind": "msg",
"jp": [
"「でっかい瓶の中で",
"溺死させたらええと思う」"
]
},
{
"id": 16280,
"kind": "msg",
"jp": [
"「でも斑井さんのやつは",
"『黒猫の毒』ね」"
]
},
{
"id": 16281,
"kind": "msg",
"jp": [
"「あ、そうか。",
"そうだった・・・」"
]
},
{
"id": 16282,
"kind": "msg",
"jp": [
"「『黒猫の毒』だよね」"
]
},
{
"id": 16283,
"kind": "msg",
"jp": [
"「あたり」"
]
},
{
"id": 16284,
"kind": "msg",
"jp": [
"「ちゃんとタイトル覚えてたんや」"
]
},
{
"id": 16285,
"kind": "msg",
"jp": [
"「温室に黒猫があって、",
"斑井さんはあんなふうに",
"縛られてて・・・」"
]
},
{
"id": 16286,
"kind": "msg",
"jp": [
"「名前も、やねんね。",
"斑井さんて名前は『黒猫の毒』に",
"出てくる人の名前」"
]
},
{
"id": 16287,
"kind": "msg",
"jp": [
"「それが、何か気になるの?」"
]
},
{
"id": 16288,
"kind": "msg",
"jp": [
"「どうしても気が付いて",
"ほしかったんやろか」"
]
},
{
"id": 16289,
"kind": "msg",
"jp": [
"「え? 何を?」"
]
},
{
"id": 16290,
"kind": "msg",
"jp": [
"「これが見立て殺人やってことに」"
]
},
{
"id": 16291,
"kind": "msg",
"jp": [
"「多分ね、名前も違って黒猫もなくて",
"斑井さんが縛られてるだけやったら",
"何の見立てかすぐわからんと思う」"
]
},
{
"id": 16292,
"kind": "msg",
"jp": [
"「ああ、そりゃそうだろうね」"
]
},
{
"id": 16293,
"kind": "msg",
"jp": [
"「そう考えると何の見立てか",
"やけに強調してるのか。",
"なんでだろう・・・?」"
]
},
{
"id": 16294,
"kind": "msg",
"jp": [
"「・・・これは小説の話やけど",
"見立て殺人の理由って殺す相手に",
"対するメッセージやったりする」"
]
},
{
"id": 16295,
"kind": "msg",
"jp": [
"「メッセージ?」"
]
},
{
"id": 16296,
"kind": "msg",
"jp": [
"「たとえば・・・",
"昔、マリモをいじめた人が",
"殺されたとして」"
]
},
{
"id": 16297,
"kind": "msg",
"jp": [
"「なんでマリモ・・・」"
]
},
{
"id": 16298,
"kind": "msg",
"jp": [
"「なんでもええの。",
"それで被害者がマリモに見立てられた",
"格好で死んでたら・・・」"
]
},
{
"id": 16299,
"kind": "msg",
"jp": [
"「・・・そいつと一緒にマリモを",
"いじめた覚えのある人は怖いやん。",
"自分とこにも来るかもと思って」"
]
},
{
"id": 16300,
"kind": "msg",
"jp": [
"「マリモに見立てるってどういう",
"状態・・・いや、まあいいけど」"
]
},
{
"id": 16301,
"kind": "msg",
"jp": [
"「つまり、メッセージっていうのは",
"その見立ての意味とかに共通点が",
"ある人達に対する脅しかもってこと?」"
]
},
{
"id": 16302,
"kind": "msg",
"jp": [
"「そう。",
"うちらの場合は高遠作品から役名が",
"取られてる役者って共通点がある」"
]
},
{
"id": 16303,
"kind": "msg",
"jp": [
"「見立てに使われてるのも",
"高遠作品だもんな」"
]
},
{
"id": 16304,
"kind": "msg",
"jp": [
"「ようするにこの場合犯人は、",
"静奈ちゃん達全員を脅すのが目的で",
"見立てって事を強調してるのかな」"
]
},
{
"id": 16305,
"kind": "msg",
"jp": [
"「それもあると思うけど、",
"なんか引っかかるん」"
]
},
{
"id": 16306,
"kind": "msg",
"jp": [
"「引っかかるって?」"
]
},
{
"id": 16307,
"kind": "msg",
"jp": [
"「まず、脅すだけやったら",
"『嵐の山荘』だけで十分」"
]
},
{
"id": 16308,
"kind": "msg",
"jp": [
"「・・・山奥の山荘に閉じ込められて",
"人が殺されるだけで十分やと思う」"
]
},
{
"id": 16309,
"kind": "msg",
"jp": [
"「あ、そりゃそうか。",
"十分怖いよね・・・」"
]
},
{
"id": 16310,
"kind": "msg",
"jp": [
"「それをわざわざ見立て殺人にして",
"しかも何の見立てなんかを、",
"早く誰かが気付くように強調してる」"
]
},
{
"id": 16311,
"kind": "msg",
"jp": [
"「実際、意味は斑井さんが",
"殺されるよりも先に静奈ちゃんは",
"気が付いたくらいだもんな」"
]
},
{
"id": 16312,
"kind": "msg",
"jp": [
"「見立て殺人よりも{先/・}{に/・}見立ての",
"内容が披露されたことになるのか」"
]
},
{
"id": 16313,
"kind": "msg",
"jp": [
"「先に披露するんやったら、",
"レコードで歌流して人形10個並べとく",
"くらいしたらわかりやすいのに」"
]
},
{
"id": 16314,
"kind": "msg",
"jp": [
"「マニアの独り言やから",
"気にせんでええの」"
]
},
{
"id": 16315,
"kind": "msg",
"jp": [
"「とにかく、犯人はとっとと誰かが",
"『高遠延二郎』に行き着くように",
"仕向けてる」"
]
},
{
"id": 16316,
"kind": "msg",
"jp": [
"「では、ここで問題です」"
]
},
{
"id": 16317,
"kind": "msg",
"jp": [
"「も、問題?」"
]
},
{
"id": 16318,
"kind": "msg",
"jp": [
"「・・・{な/・}{ん/・}{で/・}{高/・}{遠/・}なん?」"
]
},
{
"id": 16319,
"kind": "msg",
"jp": [
"「うちらの間にある『高遠』って",
"共通点は渡された脚本{し/・}{か/・}{な/・}{い/・}んよ」"
]
},
{
"id": 16320,
"kind": "msg",
"jp": [
"「その脚本も、帽子屋が書いたとは",
"もう思えん状況やし犯人がでっち上げた",
"可能性が高いとうちは思うん」"
]
},
{
"id": 16321,
"kind": "msg",
"jp": [
"「・・・じゃあ、なんで高遠なん?",
"マザーグースでも手毬唄でもなくて",
"高遠延二郎を選んだ理由って何?」"
]
},
{
"id": 16322,
"kind": "msg",
"jp": [
"「脚本だけは本物なのかも",
"しれないよ」"
]
},
{
"id": 16323,
"kind": "msg",
"jp": [
"「本物って脚本書いたんは",
"ほんまに帽子屋ってこと?」"
]
},
{
"id": 16324,
"kind": "msg",
"jp": [
"「うん、それを犯人が利用してるん",
"じゃないのかな」"
]
},
{
"id": 16325,
"kind": "msg",
"jp": [
"「・・・それやと、本物の帽子屋って",
"もう死んでそうな気がする」"
]
},
{
"id": 16326,
"kind": "msg",
"jp": [
"「だって今ここに集められてんのは",
"犯人が復讐したい相手であって、",
"帽子屋の決めた配役やないでしょ」"
]
},
{
"id": 16327,
"kind": "msg",
"jp": [
"「まさか、帽子屋の決めた配役が",
"たまたま犯人の復讐したい相手全員と",
"ぴったり同じやったわけないやろうし」"
]
},
{
"id": 16328,
"kind": "msg",
"jp": [
"「そりゃ・・・なさそうだね」"
]
},
{
"id": 16329,
"kind": "msg",
"jp": [
"「万が一偶然にも同じやったとしても",
"その場合やっぱり犯人は事前に配役",
"知ってたことになるし」"
]
},
{
"id": 16330,
"kind": "msg",
"jp": [
"「どっちにしろ、帽子屋本人と",
"何らかの接触がないと無理そう」"
]
},
{
"id": 16331,
"kind": "msg",
"jp": [
"「・・・そうか」"
]
},
{
"id": 16332,
"kind": "msg",
"jp": [
"「そうなると帽子屋ってもう",
"犯人に殺されてそうやない?」"
]
},
{
"id": 16333,
"kind": "msg",
"jp": [
"「帽子屋放っといたら事件が明るみに",
"出たとき犯人誰かすぐバレそうやん」"
]
},
{
"id": 16334,
"kind": "msg",
"jp": [
"「そうなるね・・・」"
]
},
{
"id": 16335,
"kind": "msg",
"jp": [
"「・・・帽子屋の中の人が",
"犯人やない限りはね」"
]
},
{
"id": 16336,
"kind": "msg",
"jp": [
"「静奈ちゃん、帽子屋が犯人かも",
"知れないと思うの?」"
]
},
{
"id": 16337,
"kind": "msg",
"jp": [
"「うちは、脚本自体帽子屋が",
"書いたんとは違うと思てる」"
]
},
{
"id": 16338,
"kind": "msg",
"jp": [
"「そない自信ない顔せんでも。",
"うちとお兄さんとどっちが当たりか",
"まだわからへんのに」"
]
},
{
"id": 16339,
"kind": "msg",
"jp": [
"「・・・高遠氏の関係者が",
"いるのかも・・・・」"
]
},
{
"id": 16340,
"kind": "msg",
"jp": [
"「やっぱりそない思うん」"
]
},
{
"id": 16341,
"kind": "msg",
"jp": [
"「うちも、どっちかやと思う」"
]
},
{
"id": 16342,
"kind": "msg",
"jp": [
"「どっちかって・・・?」"
]
},
{
"id": 16343,
"kind": "msg",
"jp": [
"「実は高遠延二郎と関係のある人間が",
"うちらの中に混じってて、犯人が一番",
"殺したいのはその人やとか」"
]
},
{
"id": 16344,
"kind": "msg",
"jp": [
"「・・・もしくは、",
"犯人が高遠延二郎の関係者か、",
"どっちかかな」"
]
},
{
"id": 16345,
"kind": "msg",
"jp": [
"「犯人が・・・」"
]
},
{
"id": 16346,
"kind": "msg",
"jp": [
"「犯人にとって身近で、",
"見立て殺人を連想しやすい",
"ものやったんかもしれへん」"
]
},
{
"id": 16347,
"kind": "msg",
"jp": [
"（・・・実は1人だけ本当に",
"高遠延二郎の孫がいるんだけど・・・）"
]
},
{
"id": 16348,
"kind": "msg",
"jp": [
"今それ言っちゃうと静奈ちゃんは",
"日織を疑うかもしれないな。"
]
},
{
"id": 16349,
"kind": "msg",
"jp": [
"そうなるとずっと一緒にいる僕も",
"信用してもらえなくなるかも・・・。"
]
},
{
"id": 16350,
"kind": "msg",
"jp": [
"（あー、でも、黙ってて後から",
"バレたらもっと疑われるかな）"
]
},
{
"id": 16351,
"kind": "msg",
"jp": [
"（僕さえ言わなかったら",
"大丈夫かなあ・・・・）"
]
},
{
"id": 16352,
"kind": "msg",
"jp": [
"「・・・どないしたん?",
"うちの言うてることなんか変?」"
]
},
{
"id": 16353,
"kind": "msg",
"jp": [
"「あ、いや・・・",
"別に変じゃないと思うよ」"
]
},
{
"id": 16354,
"kind": "msg",
"jp": [
"「・・・それにしては",
"なんか変な顔してる」"
]
},
{
"id": 16355,
"kind": "msg",
"jp": [
"「え、これは、あの、",
"えーっと・・・どっちだろうって",
"考えてただけで・・・」"
]
},
{
"id": 16356,
"kind": "msg",
"jp": [
"「なんで変な汗かいてんの」"
]
},
{
"id": 16357,
"kind": "msg",
"jp": [
"「えっ!?",
"そ、そう・・・?」"
]
},
{
"id": 16358,
"kind": "msg",
"jp": [
"「あ、あの、多分・・・",
"慣れない話してるから緊張してるん",
"じゃないかな・・・」"
]
},
{
"id": 16359,
"kind": "msg",
"jp": [
"「・・・あのさ。",
"多分・・・犯人が高遠さんの関係者って",
"ことはないと思うよ」"
]
},
{
"id": 16360,
"kind": "msg",
"jp": [
"「その・・・",
"実は本当に関係者なのが",
"いるにはいるんだけど・・・」"
]
},
{
"id": 16361,
"kind": "msg",
"jp": [
"「・・・着流しさんや」"
]
},
{
"id": 16362,
"kind": "msg",
"jp": [
"「えっ!?",
"なんでわかったの!?」"
]
},
{
"id": 16363,
"kind": "msg",
"jp": [
"「だってすごい言いにくそう",
"やったから」"
]
},
{
"id": 16364,
"kind": "msg",
"jp": [
"「お兄さんが絶対犯人やないって",
"信じてる人やろうと思ったん」"
]
},
{
"id": 16365,
"kind": "msg",
"jp": [
"「あの、でも日織は本当に",
"犯人じゃないよ?",
"僕、ずっと一緒にいるけど・・・」"
]
},
{
"id": 16366,
"kind": "msg",
"jp": [
"「斑井さんが殺された時は",
"間違いなくずっと部屋にいたし、",
"それに、えーと・・・」"
]
},
{
"id": 16367,
"kind": "msg",
"jp": [
"「他のうちらは全員ゲストキャラで、",
"猫は斑井さん、みたいにどの話を",
"差してたら誰って予測がつくけど」"
]
},
{
"id": 16368,
"kind": "msg",
"jp": [
"「日織諒だけはそれが出来へん。",
"1人だけ浮いてる。",
"うちは、それって・・・・」"
]
},
{
"id": 16369,
"kind": "msg",
"jp": [
"「{わ/・}{ざ/・}{と/・}{浮/・}{か/・}{さ/・}{れ/・}{て/・}{る/・}気がする」"
]
},
{
"id": 16370,
"kind": "msg",
"jp": [
"「わざと・・・?」"
]
},
{
"id": 16371,
"kind": "msg",
"jp": [
"「犯人が、ね」"
]
},
{
"id": 16372,
"kind": "msg",
"jp": [
"「え、じゃあ静奈ちゃん",
"日織のこと疑ってないんだ?」"
]
},
{
"id": 16373,
"kind": "msg",
"jp": [
"「・・・まだわからへん」"
]
},
{
"id": 16374,
"kind": "msg",
"jp": [
"「ほんまに犯人やったら、",
"そんな露骨に自分だけ浮くような",
"ことは普通せんと思う」"
]
},
{
"id": 16375,
"kind": "msg",
"jp": [
"「そ、そうだよな。",
"目立ちすぎて本気で疑われたら",
"身動き取れなくなるし・・・」"
]
},
{
"id": 16376,
"kind": "msg",
"jp": [
"「・・・一旦疑われといて",
"疑い晴らして容疑者の候補から",
"外れるって手もあるんやけど」"
]
},
{
"id": 16377,
"kind": "msg",
"jp": [
"「けど、それがやりたかったん",
"やとしたら着流しのお兄さんに",
"しては手際が悪すぎる」"
]
},
{
"id": 16378,
"kind": "msg",
"jp": [
"「手際・・・?」"
]
},
{
"id": 16379,
"kind": "msg",
"jp": [
"「あの人、うちと同レベルの",
"ミステリマニアみたいやもん」"
]
},
{
"id": 16380,
"kind": "msg",
"jp": [
"「『一番怪しい奴がやっぱり犯人』が",
"やりたいんやったら、もっと最初に",
"疑われんと意味ないて知らんわけない」"
]
},
{
"id": 16381,
"kind": "msg",
"jp": [
"「それどころか斑井さんの時は",
"唯一お兄さんとアリバイ証言しあえる",
"立場におりんさったやん」"
]
},
{
"id": 16382,
"kind": "msg",
"jp": [
"「やってることがまるっきり逆。",
"むしろあの時唯一アリバイが無いくらい",
"やっとかなあかんところやのに」"
]
},
{
"id": 16383,
"kind": "msg",
"jp": [
"「・・・だから、",
"着流しのお兄さんは犯人違う」"
]
},
{
"id": 16384,
"kind": "msg",
"jp": [
"「そ、そういうもんなの?」"
]
},
{
"id": 16385,
"kind": "msg",
"jp": [
"「それで後から疑い晴れたら",
"もう疑う人おらんやん。",
"一旦違うって判断されてんのに」"
]
},
{
"id": 16386,
"kind": "msg",
"jp": [
"「ああ、まあ",
"そうかも・・・」"
]
},
{
"id": 16387,
"kind": "msg",
"jp": [
"「着流しさんの場合、それが逆。",
"最初はアリバイあったのにその後",
"どんどん怪しくなってる」"
]
},
{
"id": 16388,
"kind": "msg",
"jp": [
"「・・・だから、",
"そういう意味では着流しさんは",
"犯人らしくない」"
]
},
{
"id": 16389,
"kind": "msg",
"jp": [
"なんかものすごい理由のような",
"気がするんだけど。",
"疑いが晴れてるならいいかな・・・。"
]
},
{
"id": 16390,
"kind": "msg",
"jp": [
"「くぉど・えらと・でもんすとらんだむ」"
]
},
{
"id": 16391,
"kind": "msg",
"jp": [
"「へ? な、なに?」"
]
},
{
"id": 16392,
"kind": "msg",
"jp": [
"「いっぺん言うてみたかっただけ」"
]
},
{
"id": 16393,
"kind": "msg",
"jp": [
"なんで照れくさそうなんだろう。",
"それに、今の呪文みたいなの何・・・?"
]
},
{
"id": 16394,
"kind": "msg",
"jp": [
"「・・・僕にはわからないよ」"
]
},
{
"id": 16395,
"kind": "msg",
"jp": [
"「・・・なんか頼りない」"
]
},
{
"id": 16396,
"kind": "msg",
"jp": [
"「ごめん・・・」"
]
},
{
"id": 16397,
"kind": "msg",
"jp": [
"「けど、一応本気みたい",
"なんはわかった」"
]
},
{
"id": 16398,
"kind": "msg",
"jp": [
"「え、あ、そりゃ本気だよ。",
"冗談でこんな物騒なこと言わないし、",
"絶対危ないだろうから・・・」"
]
},
{
"id": 16399,
"kind": "msg",
"jp": [
"「わかった」"
]
},
{
"id": 16400,
"kind": "msg",
"jp": [
"「・・・信用しとく。",
"夜も、気ぃつけとくから」"
]
},
{
"id": 16401,
"kind": "msg",
"jp": [
"「う、うん。",
"ありがとう」"
]
},
{
"id": 16402,
"kind": "msg",
"jp": [
"「・・・とりあえず」"
]
},
{
"id": 16403,
"kind": "msg",
"jp": [
"「信用する」"
]
},
{
"id": 16404,
"kind": "msg",
"jp": [
"「お兄さんの推理、",
"大半うちと同じっぽい」"
]
},
{
"id": 16405,
"kind": "msg",
"jp": [
"「・・・しかも、うちより",
"ちょっと先行ってる気がする」"
]
},
{
"id": 16406,
"kind": "msg",
"jp": [
"「え・・そ、そうかな」"
]
},
{
"id": 16407,
"kind": "msg",
"jp": [
"「ここは潔く負けを認めて・・」"
]
},
{
"id": 16408,
"kind": "msg",
"jp": [
"「負け!?」"
]
},
{
"id": 16409,
"kind": "msg",
"jp": [
"「お兄さんの警告に従う」"
]
},
{
"id": 16410,
"kind": "msg",
"jp": [
"「・・・あ、ありがとう」"
]
},
{
"id": 16411,
"kind": "msg",
"jp": [
"いつの間に勝ち負けの話になったのか",
"よくわからないけど・・・。"
]
},
{
"id": 16412,
"kind": "msg",
"jp": [
"「鈴にも言うとく。",
"うちが言うた方がええと思うし」"
]
},
{
"id": 16413,
"kind": "msg",
"jp": [
"「あの子にいきなりうちの命が",
"危ないなんていうたら暴れ出す」"
]
},
{
"id": 16414,
"kind": "msg",
"jp": [
"「お兄さんに怪我されても困るし」"
]
},
{
"id": 16415,
"kind": "msg",
"jp": [
"「わ・・わかった・・・。",
"じゃあ、鈴奈ちゃんの方は任せる」"
]
},
{
"id": 16416,
"kind": "msg",
"jp": [
"「・・・あとは・・・」"
]
},
{
"id": 16417,
"kind": "msg",
"jp": [
"「あ、一応見立てに使われそうな",
"物とかは隠しておくから」"
]
},
{
"id": 16418,
"kind": "msg",
"jp": [
"「静奈ちゃん達が直接動き回るのは",
"いろいろ危ないだろうし」"
]
},
{
"id": 16419,
"kind": "msg",
"jp": [
"「うん、わかった。",
"ほな、あとは・・・」"
]
},
{
"id": 16420,
"kind": "msg",
"jp": [
"「あと・・何かあるかな」"
]
},
{
"id": 16421,
"kind": "msg",
"jp": [
"「うん。",
"うちは1つ残ってる」"
]
},
{
"id": 16422,
"kind": "msg",
"jp": [
"「心配してくれて、ありがとう」"
]
},
{
"id": 16423,
"kind": "msg",
"jp": [
"「え、あ・・いや・・・」"
]
},
{
"id": 16424,
"kind": "msg",
"jp": [
"「そんな思いっきり赤面されたら",
"うちまで恥ずかしいやんか」"
]
},
{
"id": 16425,
"kind": "msg",
"jp": [
"「ぐらしあす、あみーご",
"とかにしとけばよかった」"
]
},
{
"id": 16426,
"kind": "msg",
"jp": [
"「なんでスペイン語・・・?」"
]
},
{
"id": 16427,
"kind": "msg",
"jp": [
"「趣味」"
]
},
{
"id": 16428,
"kind": "msg",
"jp": [
"やっぱり静奈ちゃんって",
"よくわからない・・・。"
]
},
{
"id": 16429,
"kind": "msg",
"jp": [
"「実はさ、事件のことなんだけど」"
]
},
{
"id": 16430,
"kind": "msg",
"jp": [
"「・・・ああ、やっぱり」"
]
},
{
"id": 16431,
"kind": "msg",
"jp": [
"「やっぱり?」"
]
},
{
"id": 16432,
"kind": "msg",
"jp": [
"「昨日、鈴に二人とも危ないって",
"言うてたんでしょ」"
]
},
{
"id": 16433,
"kind": "msg",
"jp": [
"「あ・・うん。",
"だから今夜は・・・静奈ちゃんが",
"危険だと思うんだけど・・・」"
]
},
{
"id": 16434,
"kind": "msg",
"jp": [
"「けど、夕べうちら二人で同じ部屋に",
"おったから犯人がどっち狙てたんかは",
"わからんし」"
]
},
{
"id": 16435,
"kind": "msg",
"jp": [
"「そっか、それもそうだな・・・。",
"どっちにしろ今夜も二人とも",
"警戒してた方がいいよね」"
]
},
{
"id": 16436,
"kind": "msg",
"jp": [
"「そう思う。",
"とりあえず夕べと同じように",
"二人で一緒におる」"
]
},
{
"id": 16437,
"kind": "msg",
"jp": [
"「その方がいいね。",
"僕も夜になったら廊下で見張るから」"
]
},
{
"id": 16438,
"kind": "msg",
"jp": [
"「・・・ありがとう」"
]
},
{
"id": 16439,
"kind": "msg",
"jp": [
"「え、あ、いや、だって",
"みんな助かった方がいいし」"
]
},
{
"id": 16440,
"kind": "msg",
"jp": [
"「そこまで照れんでも」"
]
},
{
"id": 16441,
"kind": "msg",
"jp": [
"だってなんか、こうあっさり",
"信用してくれてお礼まで言われると",
"逆に焦るっていうか。"
]
},
{
"id": 16442,
"kind": "msg",
"jp": [
"「・・・ほな、うち鈴に",
"そない言うとく」"
]
},
{
"id": 16443,
"kind": "msg",
"jp": [
"「あ、うん、それじゃ",
"気をつけてね」"
]
},
{
"id": 16444,
"kind": "msg",
"jp": [
"「雨、なかなかやまないね」"
]
},
{
"id": 16445,
"kind": "msg",
"jp": [
"「雨は好きやけど、",
"今は早よやんでほしい」"
]
},
{
"id": 16446,
"kind": "msg",
"jp": [
"「そうだね・・」"
]
},
{
"id": 16447,
"kind": "msg",
"jp": [
"「崖崩れって怖いよね」"
]
},
{
"id": 16448,
"kind": "msg",
"jp": [
"「・・・あれは、わざと違うよね」"
]
},
{
"id": 16449,
"kind": "msg",
"jp": [
"「わざと?」"
]
},
{
"id": 16450,
"kind": "msg",
"jp": [
"「犯人が崩したんとちゃうよね」"
]
},
{
"id": 16451,
"kind": "msg",
"jp": [
"「それはさすがに",
"無理だと思うよ」"
]
},
{
"id": 16452,
"kind": "msg",
"jp": [
"「そうやんね」"
]
},
{
"id": 16453,
"kind": "msg",
"jp": [
"「温室に灯りがついてるの",
"気が付かなかった?」"
]
},
{
"id": 16454,
"kind": "msg",
"jp": [
"「・・・カーテン開けて",
"へんかったから」"
]
},
{
"id": 16455,
"kind": "msg",
"jp": [
"「・・・あの、変なこと聞くけど",
"鈴奈ちゃ・・・くんって、",
"あの格好・・・」"
]
},
{
"id": 16456,
"kind": "msg",
"jp": [
"「・・・ふふ。",
"鈴、きれいでしょ」"
]
},
{
"id": 16457,
"kind": "msg",
"jp": [
"「う、うん、まあ」"
]
},
{
"id": 16458,
"kind": "msg",
"jp": [
"「あの格好やとほとんど誰も",
"気がつかへんの」"
]
},
{
"id": 16459,
"kind": "msg",
"jp": [
"「便利便利」"
]
},
{
"id": 16460,
"kind": "msg",
"jp": [
"役の上でだけじゃなくて",
"何かいろいろやってそうだ・・・。"
]
},
{
"id": 16461,
"kind": "msg",
"jp": [
"「寝ぼけて歩いて行っちゃうのって",
"何かその、ストレスとかそういうのが",
"原因なのかな」"
]
},
{
"id": 16462,
"kind": "msg",
"jp": [
"「そう言えば、試験の前の日とか",
"よぉ夜中に歩いてるらしいけど」"
]
},
{
"id": 16463,
"kind": "msg",
"jp": [
"「あ、じゃあやっぱり",
"プレッシャーとか・・・」"
]
},
{
"id": 16464,
"kind": "msg",
"jp": [
"「けど、遠足の前の日とか",
"次の日の学食ランチがイワシの梅煮の",
"ときとかも、たまに歩いてる」"
]
},
{
"id": 16465,
"kind": "msg",
"jp": [
"つまり、いい悪いに関わらず、",
"なんか興奮する出来事があると",
"発病するってことかな・・・。"
]
},
{
"id": 16466,
"kind": "msg",
"jp": [
"「あのさ、これなんて",
"書いてあるかわかる?」"
]
},
{
"id": 16467,
"kind": "msg",
"jp": [
"「・・・ええの?」"
]
},
{
"id": 16468,
"kind": "msg",
"jp": [
"「読んでもええの?",
"ほんまに?」"
]
},
{
"id": 16469,
"kind": "msg",
"jp": [
"「あの・・・なんでそんな",
"楽しそうな顔してる、のかな・・・」"
]
},
{
"id": 16470,
"kind": "msg",
"jp": [
"「読んで欲しい?」"
]
},
{
"id": 16471,
"kind": "msg",
"jp": [
"「よ、読めるの・・・?」"
]
},
{
"id": 16472,
"kind": "msg",
"jp": [
"「・・・なんて書いてあるの?」"
]
},
{
"id": 16473,
"kind": "msg",
"jp": [
"「ほんまにええのん?」"
]
},
{
"id": 16474,
"kind": "msg",
"jp": [
"「・・・怖いよ?」"
]
},
{
"id": 16475,
"kind": "msg",
"jp": [
"「そこまで聞いちゃったら",
"気になるよ!」"
]
},
{
"id": 16476,
"kind": "msg",
"jp": [
"「なるよね」"
]
},
{
"id": 16477,
"kind": "msg",
"jp": [
"わざと気になるように",
"焦らしてたのか・・・?"
]
},
{
"id": 16478,
"kind": "msg",
"jp": [
"「呪ってる」"
]
},
{
"id": 16479,
"kind": "msg",
"jp": [
"「一族すべて呪ってる」"
]
},
{
"id": 16480,
"kind": "msg",
"jp": [
"「・・・・って、",
"か、書いてあるの・・・?」"
]
},
{
"id": 16481,
"kind": "msg",
"jp": [
"「私は一族全員呪ってますって」"
]
},
{
"id": 16482,
"kind": "msg",
"jp": [
"「これ、地下の壁に",
"彫ってあったやつやんね」"
]
},
{
"id": 16483,
"kind": "msg",
"jp": [
"「知ってたの!?」"
]
},
{
"id": 16484,
"kind": "msg",
"jp": [
"「最初の日に探検したとき見つけて、",
"気になるから書斎で辞書引いた」"
]
},
{
"id": 16485,
"kind": "msg",
"jp": [
"「この館、昔は外国のお城",
"やったから地下室ってやっぱり",
"牢屋とか拷問部屋とか」"
]
},
{
"id": 16486,
"kind": "msg",
"jp": [
"「わ、わかった、もういいっ!",
"もういいからやめてー!!」"
]
},
{
"id": 16487,
"kind": "msg",
"jp": [
"「・・・怖がりー」"
]
},
{
"id": 16488,
"kind": "msg",
"jp": [
"静奈ちゃん・・・。",
"もの凄く楽しそうだ・・・。"
]
},
{
"id": 16489,
"kind": "msg",
"jp": [
"「泊まる部屋は",
"最初から決まってたんだよね」"
]
},
{
"id": 16490,
"kind": "msg",
"jp": [
"「招待状に書いてあった」"
]
},
{
"id": 16491,
"kind": "msg",
"jp": [
"「密室になってへんかなーて",
"思たけど、普通に開いた」"
]
},
{
"id": 16492,
"kind": "msg",
"jp": [
"「み、密室?」"
]
},
{
"id": 16493,
"kind": "msg",
"jp": [
"「うん、密室」"
]
},
{
"id": 16494,
"kind": "msg",
"jp": [
"なぜそれを期待するのか",
"よくわからない・・・。"
]
},
{
"id": 16495,
"kind": "msg",
"jp": [
"「那須さんが見たっていう",
"通行止めの看板だけどさ」"
]
},
{
"id": 16496,
"kind": "msg",
"jp": [
"「本物ではない、と思う。",
"実在したとしても」"
]
},
{
"id": 16497,
"kind": "msg",
"jp": [
"「実在・・・え?」"
]
},
{
"id": 16498,
"kind": "msg",
"jp": [
"「だって、それ見たん",
"那須さんだけやし」"
]
},
{
"id": 16499,
"kind": "msg",
"jp": [
"「・・・・え・・」"
]
},
{
"id": 16500,
"kind": "msg",
"jp": [
"「他の誰も、ほんまに置いて",
"あるかどうか確かめに行ってへん」"
]
},
{
"id": 16501,
"kind": "msg",
"jp": [
"「そ・・そりゃ・・・",
"そうだけど・・・」"
]
},
{
"id": 16502,
"kind": "msg",
"jp": [
"「だから見に行きたいって",
"言うたら鈴に怒られた」"
]
},
{
"id": 16503,
"kind": "msg",
"jp": [
"「あ、当たり前だよっ!」"
]
},
{
"id": 16504,
"kind": "msg",
"jp": [
"「危ないからやめて。",
"雨も止んでないんだから、",
"また崩れるかも知れないし」"
]
},
{
"id": 16505,
"kind": "msg",
"jp": [
"「ほな、那須さんを",
"信じるしかない」"
]
},
{
"id": 16506,
"kind": "msg",
"jp": [
"「那須さんが・・・",
"嘘ついてるかもしれないって",
"思う・・・?」"
]
},
{
"id": 16507,
"kind": "msg",
"jp": [
"「・・・あの人は・・・」"
]
},
{
"id": 16508,
"kind": "msg",
"jp": [
"「嘘をつくっていう",
"機能が脳に搭載されてない",
"ように見える・・・」"
]
},
{
"id": 16509,
"kind": "msg",
"jp": [
"「黙ってる事は出来ても",
"事実と違う事言うのは",
"もの凄く下手そう」"
]
},
{
"id": 16510,
"kind": "msg",
"jp": [
"「・・・僕もそう思う」"
]
},
{
"id": 16511,
"kind": "msg",
"jp": [
"「せやから、とりあえず",
"信用することにしてる」"
]
},
{
"id": 16512,
"kind": "msg",
"jp": [
"「滝プロさんって事務所の人で",
"知ってる人居る?」"
]
},
{
"id": 16513,
"kind": "msg",
"jp": [
"「ふぇいばりっと」"
]
},
{
"id": 16514,
"kind": "msg",
"jp": [
"「一番上手い人がね、",
"うちの目標」"
]
},
{
"id": 16515,
"kind": "msg",
"jp": [
"「へえ、そうなんだ。",
"女優さん?」"
]
},
{
"id": 16516,
"kind": "msg",
"jp": [
"「うん、かっこいい」"
]
},
{
"id": 16517,
"kind": "msg",
"jp": [
"「けど、まだ一緒に仕事したことない。",
"やってみたいな・・・」"
]
},
{
"id": 16518,
"kind": "msg",
"jp": [
"「ふぅん・・・」"
]
},
{
"id": 16519,
"kind": "msg",
"jp": [
"静奈ちゃんが目標にしてる人って",
"どんな人だろう・・・。"
]
},
{
"id": 16520,
"kind": "msg",
"jp": [
"「スズメ芸能っていう事務所",
"どんなとこなの?」"
]
},
{
"id": 16521,
"kind": "msg",
"jp": [
"「・・・斑井さんとこ?」"
]
},
{
"id": 16522,
"kind": "msg",
"jp": [
"「すごい昔からある事務所なん。",
"有名な俳優さんもいっぱいおったし」"
]
},
{
"id": 16523,
"kind": "msg",
"jp": [
"「へえ・・・?",
"どんな人がいたの?」"
]
},
{
"id": 16524,
"kind": "msg",
"jp": [
"「お兄さん知らんと思う。",
"戦前の人ばっかりやし」"
]
},
{
"id": 16525,
"kind": "msg",
"jp": [
"「・・・それは知らないだろうな」"
]
},
{
"id": 16526,
"kind": "msg",
"jp": [
"「静奈ちゃんの事務所って",
"どんなところ?」"
]
},
{
"id": 16527,
"kind": "msg",
"jp": [
"「猫がおる」"
]
},
{
"id": 16528,
"kind": "msg",
"jp": [
"「へ・・?」"
]
},
{
"id": 16529,
"kind": "msg",
"jp": [
"「あと、{十姉妹/じゅうしまつ}も飼うてる」"
]
},
{
"id": 16530,
"kind": "msg",
"jp": [
"「来客用のお茶菓子は桜餅」"
]
},
{
"id": 16531,
"kind": "msg",
"jp": [
"「ふぅん」"
]
},
{
"id": 16532,
"kind": "msg",
"jp": [
"「相手がコーヒー飲んでても桜餅」"
]
},
{
"id": 16533,
"kind": "msg",
"jp": [
"「なんかこだわりでもあるの?",
"桜餅に・・・」"
]
},
{
"id": 16534,
"kind": "msg",
"jp": [
"「社長室に飾ってある絵が不評」"
]
},
{
"id": 16535,
"kind": "msg",
"jp": [
"「社長が自分で描いたん」"
]
},
{
"id": 16536,
"kind": "msg",
"jp": [
"「・・・上手くないの?」"
]
},
{
"id": 16537,
"kind": "msg",
"jp": [
"「自分ちの愛犬らしいねんけど",
"生まれたてのエイリアンに見える」"
]
},
{
"id": 16538,
"kind": "msg",
"jp": [
"お客さんとかが、激しくコメントに",
"困りそうな事務所だな・・・。"
]
},
{
"id": 16539,
"kind": "msg",
"jp": [
"「仮面愛好会って",
"知ってる?」"
]
},
{
"id": 16540,
"kind": "msg",
"jp": [
"「うん。",
"書斎の会報見た」"
]
},
{
"id": 16541,
"kind": "msg",
"jp": [
"「・・・楽しそう」"
]
},
{
"id": 16542,
"kind": "msg",
"jp": [
"「入りたいの?」"
]
},
{
"id": 16543,
"kind": "msg",
"jp": [
"「入会資格は満たしてるから",
"入れるけど・・・」"
]
},
{
"id": 16544,
"kind": "msg",
"jp": [
"「体験入会とかあったら",
"行ってみたいかも」"
]
},
{
"id": 16545,
"kind": "msg",
"jp": [
"「そ、そっか・・・」"
]
},
{
"id": 16546,
"kind": "msg",
"jp": [
"「不思議ビバレーツって知ってる?」"
]
},
{
"id": 16547,
"kind": "msg",
"jp": [
"「・・・ふふふ」"
]
},
{
"id": 16548,
"kind": "msg",
"jp": [
"「だいすき」"
]
},
{
"id": 16549,
"kind": "msg",
"jp": [
"「・・・好きなんだ」"
]
},
{
"id": 16550,
"kind": "msg",
"jp": [
"「けど、最近ヒットがなくて",
"ちょっと寂しい・・・」"
]
},
{
"id": 16551,
"kind": "msg",
"jp": [
"「うちの姉ちゃんも今年のは",
"全体的においしくないって",
"言ってたなぁ」"
]
},
{
"id": 16552,
"kind": "msg",
"jp": [
"「うん、そう。",
"普通にまずいだけなん」"
]
},
{
"id": 16553,
"kind": "msg",
"jp": [
"「ふ、普通に?」"
]
},
{
"id": 16554,
"kind": "msg",
"jp": [
"「地獄のようなまずさとか、",
"この世の悪夢みたいな味のは",
"ここ2年くらい出てない」"
]
},
{
"id": 16555,
"kind": "msg",
"jp": [
"「いや・・・",
"そんなの生み出されても」"
]
},
{
"id": 16556,
"kind": "msg",
"jp": [
"「あのね、中部地方限定商品で",
"『べじた・すかっしゅ』っていう",
"ジュースあるから飲んでみて」"
]
},
{
"id": 16557,
"kind": "msg",
"jp": [
"「・・・まずいんだね」"
]
},
{
"id": 16558,
"kind": "msg",
"jp": [
"「じゃあなんで、",
"そんな嬉しそうな顔・・・」"
]
},
{
"id": 16559,
"kind": "msg",
"jp": [
"「まずくないよ」"
]
},
{
"id": 16560,
"kind": "msg",
"jp": [
"「・・・本当に?」"
]
},
{
"id": 16561,
"kind": "msg",
"jp": [
"「ただ、この世には",
"『まずい』よりも上があるって",
"いう真実に触れられる」"
]
},
{
"id": 16562,
"kind": "msg",
"jp": [
"「触れたくないんだけど!?」"
]
},
{
"id": 16563,
"kind": "msg",
"jp": [
"「れっつ・ちゃれんじ」"
]
},
{
"id": 16564,
"kind": "msg",
"jp": [
"なんかとてつもなく",
"得るものの少なそうな",
"挑戦だ・・・。"
]
},
{
"id": 16565,
"kind": "msg",
"jp": [
"「今回やる脚本って",
"どういう話なの?」"
]
},
{
"id": 16566,
"kind": "msg",
"jp": [
"「ちょっと変なん」"
]
},
{
"id": 16567,
"kind": "msg",
"jp": [
"「変? 何が?」"
]
},
{
"id": 16568,
"kind": "msg",
"jp": [
"「この脚本、前に見た映画と",
"台詞回しの癖がなんか違うん」"
]
},
{
"id": 16569,
"kind": "msg",
"jp": [
"「なんで違うんかわからへん。",
"まだ最初のところしか来てへんし」"
]
},
{
"id": 16570,
"kind": "msg",
"jp": [
"それじゃあ、内容的なことが理由で",
"違ってるのかどうかもわからないって",
"ことだよな・・・。"
]
},
{
"id": 16571,
"kind": "msg",
"jp": [
"「静奈ちゃん、",
"『白夜』ってビデオ映画覚えてる?」"
]
},
{
"id": 16572,
"kind": "msg",
"jp": [
"「うん。",
"ちょこっと出てる」"
]
},
{
"id": 16573,
"kind": "msg",
"jp": [
"「そっか。",
"その打ち上げのときにさ・・・」"
]
},
{
"id": 16574,
"kind": "msg",
"jp": [
"「・・・それ、うちと違う」"
]
},
{
"id": 16575,
"kind": "msg",
"jp": [
"「打ち上げ行ったんは、鈴の方」"
]
},
{
"id": 16576,
"kind": "msg",
"jp": [
"「出演したのは静奈ちゃんだけど、",
"打ち上げに顔出したの鈴奈ちゃん",
"だったってこと?」"
]
},
{
"id": 16577,
"kind": "msg",
"jp": [
"「ビデオ壊れてて」"
]
},
{
"id": 16578,
"kind": "msg",
"jp": [
"「見てたドラマの最終回が",
"録画出来んかったから」"
]
},
{
"id": 16579,
"kind": "msg",
"jp": [
"「・・・そ、そう」"
]
},
{
"id": 16580,
"kind": "msg",
"jp": [
"それで姉の代わりに行っちゃうあたり",
"鈴奈ちゃんて、相当静奈ちゃんに頭が",
"上がらないのかな・・・。"
]
},
{
"id": 16581,
"kind": "msg",
"jp": [
"「そう言えば、なんかあの打ち上げ",
"帽子屋来てたらしいって噂聞いた」"
]
},
{
"id": 16582,
"kind": "msg",
"jp": [
"「その噂って誰から・・・」"
]
},
{
"id": 16583,
"kind": "msg",
"jp": [
"「事務所の人」"
]
},
{
"id": 16584,
"kind": "msg",
"jp": [
"「『白夜』の脚本は全然違う人やし、",
"来てた人の誰かが帽子屋",
"やったかもって話やと思う」"
]
},
{
"id": 16585,
"kind": "msg",
"jp": [
"「静奈ちゃんは、",
"『虹色の愛の架け橋』ってドラマ",
"知ってる?」"
]
},
{
"id": 16586,
"kind": "msg",
"jp": [
"「・・・斑井さんのあれ?」"
]
},
{
"id": 16587,
"kind": "msg",
"jp": [
"「うん、出てたらしいけど」"
]
},
{
"id": 16588,
"kind": "msg",
"jp": [
"「子役の頃でしょ。",
"うち見たけどどれが斑井さんか",
"わからへん」"
]
},
{
"id": 16589,
"kind": "msg",
"jp": [
"「見たことあるんだ」"
]
},
{
"id": 16590,
"kind": "msg",
"jp": [
"「DVD借りて見た。",
"うち、やるんやったらヒロインより",
"いじわるな妹の役がええな」"
]
},
{
"id": 16591,
"kind": "msg",
"jp": [
"「そうなの? なんで?」"
]
},
{
"id": 16592,
"kind": "msg",
"jp": [
"「悪役のがやってて楽しい」"
]
},
{
"id": 16593,
"kind": "msg",
"jp": [
"「・・・そういうもんなんだ」"
]
},
{
"id": 16594,
"kind": "msg",
"jp": [
"「『麻雀地獄伝説』って知ってる?」"
]
},
{
"id": 16595,
"kind": "msg",
"jp": [
"「・・・ビデオ映画のやつ?」"
]
},
{
"id": 16596,
"kind": "msg",
"jp": [
"「あぁ・・・",
"斑井さん、どっかで見たと",
"思ったらあれにも出てた」"
]
},
{
"id": 16597,
"kind": "msg",
"jp": [
"「なんか最新作らしいよ。",
"どんな役かは知らないけど」"
]
},
{
"id": 16598,
"kind": "msg",
"jp": [
"「麻雀屋さんのお客さんの中におった」"
]
},
{
"id": 16599,
"kind": "msg",
"jp": [
"「・・・えーと、それは・・・",
"主人公とかストーリーとかに関係",
"あるのかな・・・」"
]
},
{
"id": 16600,
"kind": "msg",
"jp": [
"「ううん、手前で会話してる",
"主人公の後ろで麻雀打ってるだけ」"
]
},
{
"id": 16601,
"kind": "msg",
"jp": [
"「でも、おらんとあかん役よ。",
"店に誰もおらんかったら変やもん」"
]
},
{
"id": 16602,
"kind": "msg",
"jp": [
"「あ、うん。",
"そうだろうね・・・」"
]
},
{
"id": 16603,
"kind": "msg",
"jp": [
"「斑井さんはなんかもっと",
"出番の多い人の役みたいに聞こえる",
"ように言うから・・・」"
]
},
{
"id": 16604,
"kind": "msg",
"jp": [
"「・・・実は台詞も無いって",
"わかったらなーんやって思われるん。",
"おらんとあかん役やのに」"
]
},
{
"id": 16605,
"kind": "msg",
"jp": [
"「自分が一番自分に損させてんの",
"わかってないん・・・なんでやろね」"
]
},
{
"id": 16606,
"kind": "msg",
"jp": [
"静奈ちゃんは少し悲しそうだった。"
]
},
{
"id": 16607,
"kind": "msg",
"jp": [
"「『白蛇殺人事件』って話知ってる?",
"南雲さんて人が出てくるやつ」"
]
},
{
"id": 16608,
"kind": "msg",
"jp": [
"「・・・それ、まだ読んでへん」"
]
},
{
"id": 16609,
"kind": "msg",
"jp": [
"「あ、そうなの?」"
]
},
{
"id": 16610,
"kind": "msg",
"jp": [
"「だって今出てる文庫やと、",
"『黒猫の毒』と同じのに入ってるん」"
]
},
{
"id": 16611,
"kind": "msg",
"jp": [
"「うちに『黒猫』だけのんがあるから",
"なんとなくまだ買うてへんの」"
]
},
{
"id": 16612,
"kind": "msg",
"jp": [
"「あぁ、なるほどね」"
]
},
{
"id": 16613,
"kind": "msg",
"jp": [
"そういうのは後回しになりがちだよな。"
]
},
{
"id": 16614,
"kind": "msg",
"jp": [
"「アメフラシ戦記って",
"ゲーム知ってる?」"
]
},
{
"id": 16615,
"kind": "msg",
"jp": [
"「まだやってる」"
]
},
{
"id": 16616,
"kind": "msg",
"jp": [
"「ボスが倒せへん・・・」"
]
},
{
"id": 16617,
"kind": "msg",
"jp": [
"「もうレベル99やのに。",
"全員鍛えたのに」"
]
},
{
"id": 16618,
"kind": "msg",
"jp": [
"「全員・・・」"
]
},
{
"id": 16619,
"kind": "msg",
"jp": [
"「お気に入りの髭のおっちゃん",
"なんかもう上がるパラメータ",
"ないのに・・・」"
]
},
{
"id": 16620,
"kind": "msg",
"jp": [
"どんだけ強いんだ、ボス。"
]
},
{
"id": 16621,
"kind": "msg",
"jp": [
"「あかつきの白いバラって",
"ドラマ知ってる?」"
]
},
{
"id": 16622,
"kind": "msg",
"jp": [
"「・・・DVDが」"
]
},
{
"id": 16623,
"kind": "msg",
"jp": [
"「来年出るかもって噂が」"
]
},
{
"id": 16624,
"kind": "msg",
"jp": [
"「5年くらい前から",
"毎年この時期になると流れる」"
]
},
{
"id": 16625,
"kind": "msg",
"jp": [
"「この館ってすごく古いよね」"
]
},
{
"id": 16626,
"kind": "msg",
"jp": [
"「・・・・ふふ」"
]
},
{
"id": 16627,
"kind": "msg",
"jp": [
"「古いおうちってわくわくする」"
]
},
{
"id": 16628,
"kind": "msg",
"jp": [
"「変な物多いし」"
]
},
{
"id": 16629,
"kind": "msg",
"jp": [
"「変な物?」"
]
},
{
"id": 16630,
"kind": "msg",
"jp": [
"「応接室の仮面とか、",
"書斎にも変な本多いし、",
"あと・・・穴開いてる」"
]
},
{
"id": 16631,
"kind": "msg",
"jp": [
"「あな?」"
]
},
{
"id": 16632,
"kind": "msg",
"jp": [
"「隅っこに、なんでか",
"わからへんけど穴開いてる",
"部屋がときどきある」"
]
},
{
"id": 16633,
"kind": "msg",
"jp": [
"「執事さんに聞いたけど、",
"なんで開いてるんか知らんて」"
]
},
{
"id": 16634,
"kind": "msg",
"jp": [
"「ふぅん・・・",
"なんで開いてるんだろうね」"
]
},
{
"id": 16635,
"kind": "msg",
"jp": [
"「さあ・・・」"
]
},
{
"id": 16636,
"kind": "msg",
"jp": [
"「何か入れたら",
"すごいことになったりして」"
]
},
{
"id": 16637,
"kind": "msg",
"jp": [
"「す、すごいこと?」"
]
},
{
"id": 16638,
"kind": "msg",
"jp": [
"「館が変形するとか」"
]
},
{
"id": 16639,
"kind": "msg",
"jp": [
"「すごすぎない!?」"
]
},
{
"id": 16640,
"kind": "msg",
"jp": [
"「けど、意味もなく",
"穴だけ開いてるって変」"
]
},
{
"id": 16641,
"kind": "msg",
"jp": [
"「そりゃそうだけど・・・」"
]
},
{
"id": 16642,
"kind": "msg",
"jp": [
"「でも、そこがいい」"
]
},
{
"id": 16643,
"kind": "msg",
"jp": [
"「うん。",
"意味わからへんとこが好き」"
]
},
{
"id": 16644,
"kind": "msg",
"jp": [
"「・・・ちょっと",
"タンスの中にも入ってみた」"
]
},
{
"id": 16645,
"kind": "msg",
"jp": [
"「なんでタンス・・・」"
]
},
{
"id": 16646,
"kind": "msg",
"jp": [
"「けど、どこにも",
"つながってなかった」"
]
},
{
"id": 16647,
"kind": "msg",
"jp": [
"「・・・残念だったね」"
]
},
{
"id": 16648,
"kind": "msg",
"jp": [
"本気で残念そうだ・・・。"
]
},
{
"id": 16649,
"kind": "msg",
"jp": [
"「あのね、食堂のこと",
"なんだけどさ・・・」"
]
},
{
"id": 16650,
"kind": "msg",
"jp": [
"「静奈ちゃん、台所にいた間に",
"物音とかはしなかった?」"
]
},
{
"id": 16651,
"kind": "msg",
"jp": [
"「・・・うん。",
"料理してたし気がつかへんかった",
"だけかもしれへんけど」"
]
},
{
"id": 16652,
"kind": "msg",
"jp": [
"「けど、扉の音とかは開け閉め",
"されたら聞こえたと思う」"
]
},
{
"id": 16653,
"kind": "msg",
"jp": [
"「じゃあ、誰も出たり入ったりは",
"してないみたいだね」"
]
},
{
"id": 16654,
"kind": "msg",
"jp": [
"「こっそり入れたらおばけやね」"
]
},
{
"id": 16655,
"kind": "msg",
"jp": [
"「・・・そんなのに",
"出入りされても・・・」"
]
},
{
"id": 16656,
"kind": "msg",
"jp": [
"「あのさ、娯楽室なんだけど",
"静奈ちゃんも何度も入ってるよね」"
]
},
{
"id": 16657,
"kind": "msg",
"jp": [
"「けど、あんまり1人では",
"入ったことないかも」"
]
},
{
"id": 16658,
"kind": "msg",
"jp": [
"「あ、そうか。",
"大抵鈴奈ちゃんと",
"一緒だったんだ」"
]
},
{
"id": 16659,
"kind": "msg",
"jp": [
"「鍵閉めてからは",
"入ってない?」"
]
},
{
"id": 16660,
"kind": "msg",
"jp": [
"「ないよ」"
]
},
{
"id": 16661,
"kind": "msg",
"jp": [
"「あのさ・・・",
"井戸のことなんだけど」"
]
},
{
"id": 16662,
"kind": "msg",
"jp": [
"「・・・落ちてた人は?」"
]
},
{
"id": 16663,
"kind": "msg",
"jp": [
"「え、あ・・・",
"警察がくるまで触っちゃだめ",
"だろうからって、そのまま・・・」"
]
},
{
"id": 16664,
"kind": "msg",
"jp": [
"「・・・・・そう」"
]
},
{
"id": 16665,
"kind": "msg",
"jp": [
"「あの、静奈ちゃんはあの井戸",
"開けてみたりしてないよね」"
]
},
{
"id": 16666,
"kind": "msg",
"jp": [
"「蓋して釘打ってあったから、",
"開くと思わへんかった」"
]
},
{
"id": 16667,
"kind": "msg",
"jp": [
"「静奈ちゃんの部屋には",
"ベランダあるんだよね」"
]
},
{
"id": 16668,
"kind": "msg",
"jp": [
"「けど、閉まらへん」"
]
},
{
"id": 16669,
"kind": "msg",
"jp": [
"「鍵、ついてない」"
]
},
{
"id": 16670,
"kind": "msg",
"jp": [
"「・・・誰か入ってきたら",
"どうしよう」"
]
},
{
"id": 16671,
"kind": "msg",
"jp": [
"「え、ちょっと静奈ちゃん",
"それマジで危ないんじゃ・・・」"
]
},
{
"id": 16672,
"kind": "msg",
"jp": [
"「ふふふ」"
]
},
{
"id": 16673,
"kind": "msg",
"jp": [
"「大丈夫。",
"無理やから」"
]
},
{
"id": 16674,
"kind": "msg",
"jp": [
"「む、むり?」"
]
},
{
"id": 16675,
"kind": "msg",
"jp": [
"「壁。",
"とっかかりないから",
"登ってくるの無理」"
]
},
{
"id": 16676,
"kind": "msg",
"jp": [
"「誰も外から入って来たり",
"せえへんから大丈夫」"
]
},
{
"id": 16677,
"kind": "msg",
"jp": [
"「あ・・あの、静奈ちゃん",
"さっき怖がってるようなこと",
"言ってたのは・・・」"
]
},
{
"id": 16678,
"kind": "msg",
"jp": [
"「あいあむ、あくとれす」"
]
},
{
"id": 16679,
"kind": "msg",
"jp": [
"すごく楽しそうだ・・・。"
]
},
{
"id": 16680,
"kind": "msg",
"jp": [
"「居間の外にある",
"テラスって晴れてたら",
"気持ちよさそうだね」"
]
},
{
"id": 16681,
"kind": "msg",
"jp": [
"「{蚊帳/かや}つって、ぶたさんで",
"蚊取り線香たいてお昼寝したい」"
]
},
{
"id": 16682,
"kind": "msg",
"jp": [
"「蚊帳・・・」"
]
},
{
"id": 16683,
"kind": "msg",
"jp": [
"渋い趣味だな・・・。"
]
},
{
"id": 16684,
"kind": "msg",
"jp": [
"「静奈ちゃんは、来てから",
"昼の間に温室に入ったことある?」"
]
},
{
"id": 16685,
"kind": "msg",
"jp": [
"「そのときは、温室の中には",
"あの、変なものは何もなかった?」"
]
},
{
"id": 16686,
"kind": "msg",
"jp": [
"「・・・なかった」"
]
},
{
"id": 16687,
"kind": "msg",
"jp": [
"「けど、あれ・・・",
"なんで温室やったん?」"
]
},
{
"id": 16688,
"kind": "msg",
"jp": [
"「他の場所やなくて、",
"なんで温室に置いたんやろう」"
]
},
{
"id": 16689,
"kind": "msg",
"jp": [
"「・・・そう言えば、そうだね」"
]
},
{
"id": 16690,
"kind": "msg",
"jp": [
"どうして温室に置いたのかな。",
"何か理由が・・・?"
]
},
{
"id": 16691,
"kind": "msg",
"jp": [
"「静奈ちゃんは、台所には",
"よく入ってるよね」"
]
},
{
"id": 16692,
"kind": "msg",
"jp": [
"「料理のとき、注意して見てるけど",
"知らん間に物がなくなったりは",
"してへんみたい」"
]
},
{
"id": 16693,
"kind": "msg",
"jp": [
"「そっか。",
"台所には刃物なんかもいっぱい",
"あるからなあ・・・」"
]
},
{
"id": 16694,
"kind": "msg",
"jp": [
"「応接室には入ったことある?」"
]
},
{
"id": 16695,
"kind": "msg",
"jp": [
"「あるよ。",
"変なお面があった」"
]
},
{
"id": 16696,
"kind": "msg",
"jp": [
"「ああ、あるね。",
"なんか民芸品みたいなの」"
]
},
{
"id": 16697,
"kind": "msg",
"jp": [
"「・・・欲しい」"
]
},
{
"id": 16698,
"kind": "msg",
"jp": [
"「ほ、欲しいの?」"
]
},
{
"id": 16699,
"kind": "msg",
"jp": [
"「あんなん好き」"
]
},
{
"id": 16700,
"kind": "msg",
"jp": [
"やっぱり変わった子だ・・・。"
]
},
{
"id": 16701,
"kind": "msg",
"jp": [
"「娯楽室ってなんかいろいろ",
"置いてあるよね」"
]
},
{
"id": 16702,
"kind": "msg",
"jp": [
"「・・・ダーツ」"
]
},
{
"id": 16703,
"kind": "msg",
"jp": [
"「ダーツ?」"
]
},
{
"id": 16704,
"kind": "msg",
"jp": [
"「投げてみたら、壁に刺さった」"
]
},
{
"id": 16705,
"kind": "msg",
"jp": [
"「内緒内緒」"
]
},
{
"id": 16706,
"kind": "msg",
"jp": [
"何をやってるんだか・・・。"
]
},
{
"id": 16707,
"kind": "msg",
"jp": [
"「書斎って入ったことある?」"
]
},
{
"id": 16708,
"kind": "msg",
"jp": [
"「うん。",
"ドイツ語と英語の本が多いね」"
]
},
{
"id": 16709,
"kind": "msg",
"jp": [
"「ドイツ語わかるの?」"
]
},
{
"id": 16710,
"kind": "msg",
"jp": [
"「ぐーでんだーく、と",
"だんけしぇーん、はわかる」"
]
},
{
"id": 16711,
"kind": "msg",
"jp": [
"「あ、それは僕もわかる。",
"こんにちは、と、ありがとうだよね」"
]
},
{
"id": 16712,
"kind": "msg",
"jp": [
"「・・・あと、",
"はーけんくろいつ、と",
"はいる・・・」"
]
},
{
"id": 16713,
"kind": "msg",
"jp": [
"「そ、それもわかるけどっ!」"
]
},
{
"id": 16714,
"kind": "msg",
"jp": [
"やっぱり、よくわからない子だ。"
]
},
{
"id": 16715,
"kind": "msg",
"jp": [
"「物置の中って見たことある?」"
]
},
{
"id": 16716,
"kind": "msg",
"jp": [
"「・・・あんまり",
"おもしろそうな物なかった」"
]
},
{
"id": 16717,
"kind": "msg",
"jp": [
"「入ったんだ・・・」"
]
},
{
"id": 16718,
"kind": "msg",
"jp": [
"「かくれんぼには良さそう」"
]
},
{
"id": 16719,
"kind": "msg",
"jp": [
"「うん、まあね・・・」"
]
},
{
"id": 16720,
"kind": "msg",
"jp": [
"「静奈ちゃんの部屋って",
"僕らの部屋よりちょっと広いね」"
]
},
{
"id": 16721,
"kind": "msg",
"jp": [
"「家具も部屋ごとに",
"ちょっと違うみたいなん」"
]
},
{
"id": 16722,
"kind": "msg",
"jp": [
"「ああ、そうみたいだね」"
]
},
{
"id": 16723,
"kind": "msg",
"jp": [
"「鈴の部屋の方が窓多いし」"
]
},
{
"id": 16724,
"kind": "msg",
"jp": [
"「ああ、角部屋だもんね。",
"あっちの部屋の方がよかったの?」"
]
},
{
"id": 16725,
"kind": "msg",
"jp": [
"「ううん。",
"暗い方が好き」"
]
},
{
"id": 16726,
"kind": "msg",
"jp": [
"「そ、そうなんだ」"
]
},
{
"id": 16727,
"kind": "msg",
"jp": [
"なぜか違和感がない。",
"暗い方が似合うというか・・・。"
]
},
{
"id": 16728,
"kind": "msg",
"jp": [
"「2階のさ、ひとつだけ",
"客間じゃないみたいな部屋って",
"入ってみたことある?」"
]
},
{
"id": 16729,
"kind": "msg",
"jp": [
"「『ロス』?",
"うん、開けてみたことある」"
]
},
{
"id": 16730,
"kind": "msg",
"jp": [
"「うん、なんかそういう名前の。",
"開かずの間ってなってるけど」"
]
},
{
"id": 16731,
"kind": "msg",
"jp": [
"「・・・けど、開かずっていう",
"名前やのに、あの部屋だけ普通に",
"使われてそうな感じ」"
]
},
{
"id": 16732,
"kind": "msg",
"jp": [
"「変なの・・・」"
]
},
{
"id": 16733,
"kind": "msg",
"jp": [
"不満そうだ。",
"開かずの間なのに簡単に開くなって",
"ことかな・・・。"
]
},
{
"id": 16734,
"kind": "msg",
"jp": [
"「そこにも納戸みたいなのが",
"あるよね」"
]
},
{
"id": 16735,
"kind": "msg",
"jp": [
"「うん、普通の物置",
"みたいやったけど」"
]
},
{
"id": 16736,
"kind": "msg",
"jp": [
"「のぞいてみたんだ?」"
]
},
{
"id": 16737,
"kind": "msg",
"jp": [
"「見た。",
"なんもなかった」"
]
},
{
"id": 16738,
"kind": "msg",
"jp": [
"つまらなそうだ・・・。"
]
},
{
"id": 16739,
"kind": "msg",
"jp": [
"「地下室まであるのって",
"すごいよね」"
]
},
{
"id": 16740,
"kind": "msg",
"jp": [
"「けど狭い」"
]
},
{
"id": 16741,
"kind": "msg",
"jp": [
"「座敷牢とか変な仕掛けとか",
"落とし穴とかなさそう」"
]
},
{
"id": 16742,
"kind": "msg",
"jp": [
"「あっても怖いよ、",
"そんなの・・・」"
]
},
{
"id": 16743,
"kind": "msg",
"jp": [
"しかもなぜ座敷牢・・・?"
]
},
{
"id": 16744,
"kind": "msg",
"jp": [
"「裏庭に井戸があるよね」"
]
},
{
"id": 16745,
"kind": "msg",
"jp": [
"「うん。",
"開けてみたん?」"
]
},
{
"id": 16746,
"kind": "msg",
"jp": [
"「いや、開けてはないけど」"
]
},
{
"id": 16747,
"kind": "msg",
"jp": [
"「なんや・・・。",
"なんか変なもの入ってたんかと思た」"
]
},
{
"id": 16748,
"kind": "msg",
"jp": [
"「へ、変なものって?」"
]
},
{
"id": 16749,
"kind": "msg",
"jp": [
"「河童とか」"
]
},
{
"id": 16750,
"kind": "msg",
"jp": [
"「・・・開けてみても",
"住んでないと思うよ・・・」"
]
},
{
"id": 16751,
"kind": "msg",
"jp": [
"「静奈ちゃんの部屋の",
"名前って・・・」"
]
},
{
"id": 16752,
"kind": "msg",
"jp": [
"「好きやねんけど」"
]
},
{
"id": 16753,
"kind": "msg",
"jp": [
"「なんで海外の人",
"ばっかりなんやろう」"
]
},
{
"id": 16754,
"kind": "msg",
"jp": [
"「海外って・・・」"
]
},
{
"id": 16755,
"kind": "msg",
"jp": [
"「部屋の名前。",
"海外の作家ばっかし」"
]
},
{
"id": 16756,
"kind": "msg",
"jp": [
"「それは、あの、",
"ここが洋館だからじゃ",
"ないかな・・・」"
]
},
{
"id": 16757,
"kind": "msg",
"jp": [
"「じゃあ、ムシタロウ」"
]
},
{
"id": 16758,
"kind": "msg",
"jp": [
"「・・・マニアックすぎた」"
]
},
{
"id": 16759,
"kind": "msg",
"jp": [
"「ご、ごめん。",
"あの、僕あんまり詳しくないから」"
]
},
{
"id": 16760,
"kind": "msg",
"jp": [
"「ううん、今のはさすがに",
"着流しさんくらいやないと",
"知らんと思う」"
]
},
{
"id": 16761,
"kind": "msg",
"jp": [
"知ってると断言される日織も",
"どうなんだろう・・・。"
]
},
{
"id": 16762,
"kind": "msg",
"jp": [
"「けど、どーしても",
"海外限定なんやったら",
"あの人が良かったのに」"
]
},
{
"id": 16763,
"kind": "msg",
"jp": [
"「あの人って?」"
]
},
{
"id": 16764,
"kind": "msg",
"jp": [
"「未発表作品と一緒に",
"海に沈んでしもた人」"
]
},
{
"id": 16765,
"kind": "msg",
"jp": [
"「な、なんで!?」"
]
},
{
"id": 16766,
"kind": "msg",
"jp": [
"「タイタニック号に乗ってたから」"
]
},
{
"id": 16767,
"kind": "msg",
"jp": [
"「残念」"
]
},
{
"id": 16768,
"kind": "msg",
"jp": [
"「そ、そうだね・・・」"
]
},
{
"id": 16769,
"kind": "msg",
"jp": [
"「地下室のさ、長持って・・・」"
]
},
{
"id": 16770,
"kind": "msg",
"jp": [
"「あれ、空やったよ」"
]
},
{
"id": 16771,
"kind": "msg",
"jp": [
"「え? 見たの?」"
]
},
{
"id": 16772,
"kind": "msg",
"jp": [
"「最初の日、来てすぐ探検したん。",
"その時開けてみたら空やった」"
]
},
{
"id": 16773,
"kind": "msg",
"jp": [
"「那須さんがさ・・・",
"飲んじゃったお茶なんだけど」"
]
},
{
"id": 16774,
"kind": "msg",
"jp": [
"「・・・まだ冷蔵庫に",
"ぎょうさんある」"
]
},
{
"id": 16775,
"kind": "msg",
"jp": [
"「まだあるんだ」"
]
},
{
"id": 16776,
"kind": "msg",
"jp": [
"「あるけど・・・",
"なんか、飲みたないね」"
