[
{
"id": 6144,
"kind": "msg",
"jp": [
"僕は受話器を取り上げて、",
"他の人達に内線で電話を掛けた。"
]
},
{
"id": 6145,
"kind": "msg",
"jp": [
"「・・・すみませんね。",
"面倒なこと押しつけちまって」"
]
},
{
"id": 6146,
"kind": "msg",
"jp": [
"「あ、ううん。",
"ついでに夕べのことも",
"少し聞けたし・・・」"
]
},
{
"id": 6147,
"kind": "msg",
"jp": [
"「意外と強えな、{和/なご}さんは」"
]
},
{
"id": 6148,
"kind": "msg",
"jp": [
"「ちゃんと聞き出すことは",
"忘れずに聞いたんでしょ」"
]
},
{
"id": 6149,
"kind": "msg",
"jp": [
"「まだ、犯人に白旗揚げる",
"気はねえって事でしょうに」"
]
},
{
"id": 6150,
"kind": "msg",
"jp": [
"「違うんですかい?」"
]
},
{
"id": 6151,
"kind": "msg",
"jp": [
"「いや・・・なんとなく・・・",
"いつも聞いてたから習慣になってて」"
]
},
{
"id": 6152,
"kind": "msg",
"jp": [
"「あんたってつくづく、",
"凄えんだか凄くねえんだか",
"わからん人ですね・・・」"
]
},
{
"id": 6153,
"kind": "msg",
"jp": [
"「・・・よく言われる」"
]
},
{
"id": 6154,
"kind": "msg",
"jp": [
"「ある意味才能かも知れねえなあ」"
]
},
{
"id": 6155,
"kind": "msg",
"jp": [
"「だって、鋭いこととか役に立つ",
"こととか無意識にやってんでしょ?」"
]
},
{
"id": 6156,
"kind": "msg",
"jp": [
"「{和/なご}さん、自覚してねえ",
"だけで実は凄え才能あるんじゃ",
"ねえですかい」"
]
},
{
"id": 6157,
"kind": "msg",
"jp": [
"「・・・まさか」"
]
},
{
"id": 6158,
"kind": "msg",
"jp": [
"「そんな、2秒で否定しなくても」"
]
},
{
"id": 6159,
"kind": "msg",
"jp": [
"「そんな才能あったら、",
"もっと苦労しないで",
"人生すごせてるよ」"
]
},
{
"id": 6160,
"kind": "msg",
"jp": [
"「そうですかねえ?」"
]
},
{
"id": 6161,
"kind": "msg",
"jp": [
"「・・・かなりの部分で性格が",
"邪魔してる気がするなあ」"
]
},
{
"id": 6162,
"kind": "msg",
"jp": [
"「ん? なんか言った?」"
]
},
{
"id": 6163,
"kind": "msg",
"jp": [
"「いえいえ、何でも」"
]
},
{
"id": 6164,
"kind": "msg",
"jp": [
"「・・・それで、",
"あの表どうします?」"
]
},
{
"id": 6165,
"kind": "msg",
"jp": [
"「ああ、あれは・・・",
"暗石さんがいつ亡くなったか",
"全然わからないしなぁ」"
]
},
{
"id": 6166,
"kind": "msg",
"jp": [
"「誰か見かけた人とかも",
"いねえんですかい?」"
]
},
{
"id": 6167,
"kind": "msg",
"jp": [
"「多分、一番最後に",
"見かけた人は御陵さんかな」"
]
},
{
"id": 6168,
"kind": "msg",
"jp": [
"「ええと・・・",
"最初の日から数えて5日目の朝かな」"
]
},
{
"id": 6169,
"kind": "msg",
"jp": [
"「・・・5日目・・・。",
"朝って何時ごろです?」"
]
},
{
"id": 6170,
"kind": "msg",
"jp": [
"「6時半くらいって言ってた」"
]
},
{
"id": 6171,
"kind": "msg",
"jp": [
"「6時半かぁ・・・",
"俺はまだ部屋にいたかなあ」"
]
},
{
"id": 6172,
"kind": "msg",
"jp": [
"「もう起きてた?」"
]
},
{
"id": 6173,
"kind": "msg",
"jp": [
"「起きてましたよ。",
"7時前には部屋出て、トイレに寄って",
"台所に降りましたから・・・」"
]
},
{
"id": 6174,
"kind": "msg",
"jp": [
"「ああ、そういや、その後",
"居間で御陵さんに会いましたよ」"
]
},
{
"id": 6175,
"kind": "msg",
"jp": [
"「あれは7時半過ぎだったかな。",
"飯作って居間に持ってって食おうと",
"したら御陵さんがいて・・・」"
]
},
{
"id": 6176,
"kind": "msg",
"jp": [
"「何をするでもなくぼーっと",
"してた感じでしたがねえ」"
]
},
{
"id": 6177,
"kind": "msg",
"jp": [
"「その辺りのことみんなに",
"聞いてみるしかないか」"
]
},
{
"id": 6178,
"kind": "msg",
"jp": [
"「じゃあ、そいつを",
"聞いてからですね」"
]
},
{
"id": 6179,
"kind": "msg",
"jp": [
"「そうだね。",
"ここじゃ誰か来るかも",
"しれないし・・・」"
]
},
{
"id": 6180,
"kind": "msg",
"jp": [
"「そうですね。",
"なら何かあったら",
"後で書斎ででも」"
]
},
{
"id": 6181,
"kind": "msg",
"jp": [
"「あ、こっちやった」"
]
},
{
"id": 6182,
"kind": "msg",
"jp": [
"扉が開いて、",
"双子が顔をのぞかせた。"
]
},
{
"id": 6183,
"kind": "msg",
"jp": [
"「ありゃ、お嬢さん方」"
]
},
{
"id": 6184,
"kind": "msg",
"jp": [
"「お腹すいた」"
]
},
{
"id": 6185,
"kind": "msg",
"jp": [
"「ああ、そう言やもう",
"そんな時間ですね」"
]
},
{
"id": 6186,
"kind": "msg",
"jp": [
"「お兄さんら、",
"まだ作ってないのん?」"
]
},
{
"id": 6187,
"kind": "msg",
"jp": [
"「ええ、まだですが。",
"お先にどうぞ」"
]
},
{
"id": 6188,
"kind": "msg",
"jp": [
"「そう?",
"ほな行こか、お姉ちゃん」"
]
},
{
"id": 6189,
"kind": "msg",
"jp": [
"頷くと、静奈ちゃんは先に立って",
"居間を出て行った。"
]
},
{
"id": 6190,
"kind": "msg",
"jp": [
"「ほな、お先に」"
]
},
{
"id": 6191,
"kind": "msg",
"jp": [
"「・・・他の人は、",
"やっぱり降りてこないね」"
]
},
{
"id": 6192,
"kind": "msg",
"jp": [
"「まあ、こうなっちまうとね。",
"部屋から出るだけで勇気いるでしょう」"
]
},
{
"id": 6193,
"kind": "msg",
"jp": [
"「・・・晩飯、",
"何だったら食えそうです?」"
]
},
{
"id": 6194,
"kind": "msg",
"jp": [
"「ん・・・」"
]
},
{
"id": 6195,
"kind": "msg",
"jp": [
"「あんまり食欲なんかねえ",
"でしょうけどね」"
]
},
{
"id": 6196,
"kind": "msg",
"jp": [
"「食わねえと、",
"本当に参っちまいますぜ」"
]
},
{
"id": 6197,
"kind": "msg",
"jp": [
"「うどんくらいなら、どうです?」"
]
},
{
"id": 6198,
"kind": "msg",
"jp": [
"「ああ、それくらいなら・・・」"
]
},
{
"id": 6199,
"kind": "msg",
"jp": [
"「じゃ、そうしましょうか。",
"確か真空パックのがありましたから」"
]
},
{
"id": 6200,
"kind": "msg",
"jp": [
"もうしばらく時間を潰してから、",
"僕らは立ち上がって居間を出た。"
]
},
{
"id": 6201,
"kind": "msg",
"jp": [
"「・・・ラジオ、ラジオ」"
]
},
{
"id": 6202,
"kind": "msg",
"jp": [
"スイッチをオンにして",
"ニュースが始まるのを待つ。"
]
},
{
"id": 6203,
"kind": "msg",
"jp": [
"だからと言って、嬉しい知らせまで",
"聞こえてくるかというと、",
"まったくそんなことはなかった。"
]
},
{
"id": 6204,
"kind": "msg",
"jp": [
"ため息をついていると、",
"背後で扉が開いた。"
]
},
{
"id": 6205,
"kind": "msg",
"jp": [
"振り向くと僕の顔を見て全員が",
"伝染したようにため息をつく。"
]
},
{
"id": 6206,
"kind": "msg",
"jp": [
"「あー・・・",
"なんか顔色だけでもう",
"ええニュースありませんて感じ」"
]
},
{
"id": 6207,
"kind": "msg",
"jp": [
"「アカンの?」"
]
},
{
"id": 6208,
"kind": "msg",
"jp": [
"「この天気で崩れた道もまだ",
"復旧してないみたいだよ」"
]
},
{
"id": 6209,
"kind": "msg",
"jp": [
"「これだけ?」"
]
},
{
"id": 6210,
"kind": "msg",
"jp": [
"「うちらだけ?」"
]
},
{
"id": 6211,
"kind": "msg",
"jp": [
"開く様子のない扉を見て、",
"鈴奈ちゃんは頷いた。"
]
},
{
"id": 6212,
"kind": "msg",
"jp": [
"「・・・そうみたいやね」"
]
},
{
"id": 6213,
"kind": "msg",
"jp": [
"亡くなった人どころか、",
"生きてる人まであまり部屋から",
"出て来なくなってしまった。"
]
},
{
"id": 6214,
"kind": "msg",
"jp": [
"警戒しているのであったり、",
"顔を合わせるたびに探り合うような",
"雰囲気になったり・・・。"
]
},
{
"id": 6215,
"kind": "msg",
"jp": [
"（部屋にこもりきりに",
"なってた方が気は楽なのかも",
"しれないけど・・・）"
]
},
{
"id": 6216,
"kind": "msg",
"jp": [
"「お兄さんらは、怖ないの?」"
]
},
{
"id": 6217,
"kind": "msg",
"jp": [
"「そんな力説しなくても」"
]
},
{
"id": 6218,
"kind": "msg",
"jp": [
"僕だって、双子は犯人じゃないって",
"言い切れるだけの確信はまだ",
"何もないもんな・・・。"
]
},
{
"id": 6219,
"kind": "msg",
"jp": [
"それは、なんとなく気まずい",
"ような気がした。"
]
},
{
"id": 6220,
"kind": "msg",
"jp": [
"ソファから立ち上がって",
"台所へ向かう。"
]
},
{
"id": 6221,
"kind": "msg",
"jp": [
"ラジオのスイッチを入れて、",
"ニュースを待つ。"
]
},
{
"id": 6222,
"kind": "msg",
"jp": [
"（崖崩れの続報早くやって",
"くれないかなー・・・）"
]
},
{
"id": 6223,
"kind": "msg",
"jp": [
"しばらく待っているとすぐに",
"相変わらず復旧作業は進展して",
"いないと報じられた。"
]
},
{
"id": 6224,
"kind": "msg",
"jp": [
"「・・・駄目なのか」"
]
},
{
"id": 6225,
"kind": "msg",
"jp": [
"次いで、天気予報も当分空模様は",
"崩れっぱなしだと告げてくる。",
"見事に悪いニュースばっかりだ。"
]
},
{
"id": 6226,
"kind": "msg",
"jp": [
"「どうです、{和/なご}さん?」"
]
},
{
"id": 6227,
"kind": "msg",
"jp": [
"「変わらずだよ。",
"まだかかりそうだって」"
]
},
{
"id": 6228,
"kind": "msg",
"jp": [
"「はぁ、そりゃ気が滅入りますねえ」"
]
},
{
"id": 6229,
"kind": "msg",
"jp": [
"長いため息を吐きながら、",
"ソファにどさりと腰掛ける"
]
},
{
"id": 6230,
"kind": "msg",
"jp": [
"「・・・来ませんね」"
]
},
{
"id": 6231,
"kind": "msg",
"jp": [
"「え?",
"ああ、他の人?」"
]
},
{
"id": 6232,
"kind": "msg",
"jp": [
"「まあ、時間厳守って決まってる",
"わけでもねえですが」"
]
},
{
"id": 6233,
"kind": "msg",
"jp": [
"「どうします?",
"先に飯にしますかい」"
]
},
{
"id": 6234,
"kind": "msg",
"jp": [
"「んー・・・",
"まだあんまりお腹すいてないな」"
]
},
{
"id": 6235,
"kind": "msg",
"jp": [
"「なら、今のうちに先に",
"風呂入っちまいますか?」"
]
},
{
"id": 6236,
"kind": "msg",
"jp": [
"「・・・そっか、",
"その方がいいかな」"
]
},
{
"id": 6237,
"kind": "msg",
"jp": [
"「なら、お先にどうぞ。",
"俺、ボイラーつけて来ますよ」"
]
},
{
"id": 6238,
"kind": "msg",
"jp": [
"「ありがと。",
"じゃあ着替えとって来る」"
]
},
{
"id": 6239,
"kind": "msg",
"jp": [
"お言葉に甘えて、と着替えとタオルを",
"取りに部屋に戻った。"
]
},
{
"id": 6240,
"kind": "msg",
"jp": [
"（・・・静奈ちゃん達は",
"晩ご飯どうするんだろう）"
]
},
{
"id": 6241,
"kind": "msg",
"jp": [
"食料持ち込んだりはしてない",
"はずだから、このまま部屋から",
"出て来ないって事はないだろうけど。"
]
},
{
"id": 6242,
"kind": "msg",
"jp": [
"（ちょっと声だけでも",
"掛けてみようかな・・・）"
]
},
{
"id": 6243,
"kind": "msg",
"jp": [
"階段を通り過ぎて、双子や御陵さんの",
"泊まっている部屋の方へ向かう。"
]
},
{
"id": 6244,
"kind": "msg",
"jp": [
"今の扉の音って・・・。"
]
},
{
"id": 6245,
"kind": "msg",
"jp": [
"ひょい、と角から顔をのぞかせると",
"暗石さんの部屋の扉が薄く開いていた。"
]
},
{
"id": 6246,
"kind": "msg",
"jp": [
"（珍しい・・・",
"部屋から出たのかな?）"
]
},
{
"id": 6247,
"kind": "msg",
"jp": [
"けど、ちゃんと閉まってないなんて",
"暗石さんらしくないな。",
"どうしたんだろう・・・。"
]
},
{
"id": 6248,
"kind": "msg",
"jp": [
"「・・・暗石さん?」"
]
},
{
"id": 6249,
"kind": "msg",
"jp": [
"呼びながら、部屋に近づいた。",
"返事はなく部屋の明かりも",
"点いてないようだった。"
]
},
{
"id": 6250,
"kind": "msg",
"jp": [
"「・・・?",
"暗石さん、すみません・・・」"
]
},
{
"id": 6251,
"kind": "msg",
"jp": [
"・・・真っ暗だ。",
"おかしいな、部屋に入ったところ",
"じゃなくて出て行ったのかな。"
]
},
{
"id": 6252,
"kind": "msg",
"jp": [
"けど、それなら僕と",
"鉢合わせてるはずなのに・・・。"
]
},
{
"id": 6253,
"kind": "msg",
"jp": [
"「暗石さ・・・・」"
]
},
{
"id": 6254,
"kind": "msg",
"jp": [
"更に一歩。",
"部屋に中に踏み込んだ時・・・。"
]
},
{
"id": 6255,
"kind": "msg",
"jp": [
"「っ・・・!?」"
]
},
{
"id": 6256,
"kind": "msg",
"jp": [
"背中の下の方に、焼けつくような",
"痛みを感じて息が詰まった。"
]
},
{
"id": 6257,
"kind": "msg",
"jp": [
"「え・・・な、に・・・」"
]
},
{
"id": 6258,
"kind": "msg",
"jp": [
"振り向こうとしても、",
"もう腰に力が入らない・・・。"
]
},
{
"id": 6259,
"kind": "msg",
"jp": [
"（だ・・・誰・・・?）"
]
},
{
"id": 6260,
"kind": "msg",
"jp": [
"誰かがいる。",
"背後に誰かが・・・。"
]
},
{
"id": 6261,
"kind": "msg",
"jp": [
"だけど、それが一体誰なのか",
"わからないままに・・・。"
]
},
{
"id": 6262,
"kind": "msg",
"jp": [
"僕の意識は溶けるように",
"消えていった・・・。"
]
},
{
"id": 6263,
"kind": "msg",
"jp": [
"「・・・・・・ふぁ」"
]
},
{
"id": 6264,
"kind": "msg",
"jp": [
"窓の外は、うっすらと",
"明るくなってきていた。"
]
},
{
"id": 6265,
"kind": "msg",
"jp": [
"さすがに眠くなってきて、",
"欠伸を何度もかみ殺す。"
]
},
{
"id": 6266,
"kind": "msg",
"jp": [
"「{和/なご}さん、辛えなら",
"もう寝ていいですぜ」"
]
},
{
"id": 6267,
"kind": "msg",
"jp": [
"「どうせ夜は明けましたし、",
"お嬢さん方もそろそろ",
"起きてくるでしょ」"
]
},
{
"id": 6268,
"kind": "msg",
"jp": [
"「んー・・・いい。",
"無事に出て来るまで起きてる」"
]
},
{
"id": 6269,
"kind": "msg",
"jp": [
"「じゃあ、出てきたら起こしますから",
"ここで寝てますか」"
]
},
{
"id": 6270,
"kind": "msg",
"jp": [
"「大丈夫・・・」"
]
},
{
"id": 6271,
"kind": "msg",
"jp": [
"「船こいでるじゃねえですか」"
]
},
{
"id": 6272,
"kind": "msg",
"jp": [
"「んー・・・・・」"
]
},
{
"id": 6273,
"kind": "msg",
"jp": [
"「なんや、寝てもうたん?」"
]
},
{
"id": 6274,
"kind": "msg",
"jp": [
"「・・・・・・鈴奈ちゃん」"
]
},
{
"id": 6275,
"kind": "msg",
"jp": [
"「あ、起きてた。",
"おはよー、{和/なご}ちゃん」"
]
},
{
"id": 6276,
"kind": "msg",
"jp": [
"うっかり眠り込みそうになった僕を、",
"寝巻き姿の鈴奈ちゃんが",
"のぞき込んでいた。"
]
},
{
"id": 6277,
"kind": "msg",
"jp": [
"普段見せないような、いたずらっぽい",
"笑顔のせいなのか・・・"
]
},
{
"id": 6278,
"kind": "msg",
"jp": [
"「・・・鈴奈ちゃんて・・・",
"やっぱり男の子なんだ・・・」"
]
},
{
"id": 6279,
"kind": "msg",
"jp": [
