"jp": [
"「ああ、来月の?",
"そやね、日織さんも一緒に来てや」"
]
},
{
"id": 6427,
"kind": "msg",
"jp": [
"「来月のって、あのミュージカル",
"ですかい?」"
]
},
{
"id": 6428,
"kind": "msg",
"jp": [
"「そりゃもう、喜んで」"
]
},
{
"id": 6429,
"kind": "msg",
"jp": [
"「それって、",
"静奈ちゃんが出てるの?」"
]
},
{
"id": 6430,
"kind": "msg",
"jp": [
"「出てる。",
"歌うよ」"
]
},
{
"id": 6431,
"kind": "msg",
"jp": [
"「ありがとう、必ず行くよ」"
]
},
{
"id": 6432,
"kind": "msg",
"jp": [
"「絶対?」"
]
},
{
"id": 6433,
"kind": "msg",
"jp": [
"「うん、約束する」"
]
},
{
"id": 6434,
"kind": "msg",
"jp": [
"「じゃあ・・・・寝る」"
]
},
{
"id": 6435,
"kind": "msg",
"jp": [
"「おやすみ、ゆっくり休んでね」"
]
},
{
"id": 6436,
"kind": "msg",
"jp": [
"「お兄さんらもね。",
"ありがとう、ほんまに」"
]
},
{
"id": 6437,
"kind": "msg",
"jp": [
"「いえいえ、それじゃ」"
]
},
{
"id": 6438,
"kind": "msg",
"jp": [
"「おやすみ、",
"静奈ちゃん、鈴奈ちゃん」"
]
},
{
"id": 6439,
"kind": "msg",
"jp": [
"双子は、それぞれの部屋に",
"戻って行った・・・。"
]
},
{
"id": 6440,
"kind": "msg",
"jp": [
"「さーて、俺らも一休みしますか」"
]
},
{
"id": 6441,
"kind": "msg",
"jp": [
"「よかった、みんな無事で・・・」"
]
},
{
"id": 6442,
"kind": "msg",
"jp": [
"「・・・あと1日だね」"
]
},
{
"id": 6443,
"kind": "msg",
"jp": [
"「ええ、今日さえ乗り切りゃ、",
"事務所も俺らがえらい事になってんの",
"気がつくはずですし・・・」"
]
},
{
"id": 6444,
"kind": "msg",
"jp": [
"「実際、崖崩れのニュースはもう",
"流れてますから、何か手を打って",
"くれてるかもしれませんし」"
]
},
{
"id": 6445,
"kind": "msg",
"jp": [
"「そうだね、きっと。",
"もうすぐ帰れるんだ・・・」"
]
},
{
"id": 6446,
"kind": "msg",
"jp": [
"「・・・生き残りましょうぜ」"
]
},
{
"id": 6447,
"kind": "msg",
"jp": [
"「うん、一緒に帰ろう」"
]
},
{
"id": 6448,
"kind": "msg",
"jp": [
"「じゃ、今のところは",
"ゆっくり休んで体力回復して下さいな」"
]
},
{
"id": 6449,
"kind": "msg",
"jp": [
"（・・・・だいぶ明るく",
"なってきたかな・・・）"
]
},
{
"id": 6450,
"kind": "msg",
"jp": [
"窓の外を見てみると、相変わらず",
"雨で曇ってるけど夜は明けたみたいだ。"
]
},
{
"id": 6451,
"kind": "msg",
"jp": [
"扉の中から、小さくノックの音がした。"
]
},
{
"id": 6452,
"kind": "msg",
"jp": [
"「あ、多分鈴奈ちゃんだよ。",
"鈴奈ちゃん?」"
]
},
{
"id": 6453,
"kind": "msg",
"jp": [
"やっぱり鈴奈ちゃんだったらしく、",
"部屋の中から声がする。"
]
},
{
"id": 6454,
"kind": "msg",
"jp": [
"「もう朝やで。",
"出てもええかな」"
]
},
{
"id": 6455,
"kind": "msg",
"jp": [
"「そうですね、もう大丈夫でしょ」"
]
},
{
"id": 6456,
"kind": "msg",
"jp": [
"「うん、いいと思うよ」"
]
},
{
"id": 6457,
"kind": "msg",
"jp": [
"「はー、やっとかぁ・・・」"
]
},
{
"id": 6458,
"kind": "msg",
"jp": [
"「お疲れさーん」"
]
},
{
"id": 6459,
"kind": "msg",
"jp": [
"「いえいえ、そちらこそ」"
]
},
{
"id": 6460,
"kind": "msg",
"jp": [
"「よかったね、何もなくて」"
]
},
{
"id": 6461,
"kind": "msg",
"jp": [
"「うん、時計が鳴ったときはもう",
"心臓飛び出そうになったけどな」"
]
},
{
"id": 6462,
"kind": "msg",
"jp": [
"「それでも何もなかったって",
"ことは、うちらの勝ちやんな」"
]
},
{
"id": 6463,
"kind": "msg",
"jp": [
"「・・・うん、きっとね」"
]
},
{
"id": 6464,
"kind": "msg",
"jp": [
"「部屋の中と外に2人ずつ",
"いたんじゃさすがにどうしようも",
"なかったんでしょうよ」"
]
},
{
"id": 6465,
"kind": "msg",
"jp": [
"「せやな。",
"ありがとう、助かったわ」"
]
},
{
"id": 6466,
"kind": "msg",
"jp": [
"鈴奈ちゃんの後ろから、",
"静奈ちゃんがひょっこり顔を出す。"
]
},
{
"id": 6467,
"kind": "msg",
"jp": [
"「いいえ、どういたしまして」"
]
},
{
"id": 6468,
"kind": "msg",
"jp": [
"「こっちこそ、変なこと言ったのに",
"信じてくれてありがと」"
]
},
{
"id": 6469,
"kind": "msg",
"jp": [
"「何言うてんねんな。",
"その変なこと言うてくれへんかったら",
"うち生きてなかったんやろ?」"
]
},
{
"id": 6470,
"kind": "msg",
"jp": [
"「感謝してるねんで、ほんまに。",
"無事にここ出られたら、",
"なんかお礼さしてや」"
]
},
{
"id": 6471,
"kind": "msg",
"jp": [
"「チケットあげる」"
]
},
{
"id": 6472,
"kind": "msg",
"jp": [
"「ああ、来月のやつ?",
"ええね、観に来てや2人とも」"
]
},
{
"id": 6473,
"kind": "msg",
"jp": [
"「へえ、来月のって",
"あのミュージカルですかい?」"
]
},
{
"id": 6474,
"kind": "msg",
"jp": [
"「そりゃ喜んでいきますよ。",
"ねえ、{和/なご}さん」"
]
},
{
"id": 6475,
"kind": "msg",
"jp": [
"「約束」"
]
},
{
"id": 6476,
"kind": "msg",
"jp": [
"「約束するよ、うん」"
]
},
{
"id": 6477,
"kind": "msg",
"jp": [
"衣擦れの音がした気がして",
"目を開ける。"
]
},
{
"id": 6478,
"kind": "msg",
"jp": [
"「あ、{和/なご}さん。",
"お目覚めですかい」"
]
},
{
"id": 6479,
"kind": "msg",
"jp": [
"「あー、日織・・・おはよう」"
]
},
{
"id": 6480,
"kind": "msg",
"jp": [
"日織が起きて着物を着ている",
"ところだった。"
]
},
{
"id": 6481,
"kind": "msg",
"jp": [
"「もう起きますかい?",
"俺は朝飯食いに行きますが」"
]
},
{
"id": 6482,
"kind": "msg",
"jp": [
"「・・・うん、起きる」"
]
},
{
"id": 6483,
"kind": "msg",
"jp": [
"欠伸しながら起き上がって、",
"手探りで眼鏡を探し当てる。"
]
},
{
"id": 6484,
"kind": "msg",
"jp": [
"「・・・やんか」"
]
},
{
"id": 6485,
"kind": "msg",
"jp": [
"「もう、お姉ちゃんはぁ!",
"そんなんばっかり・・・」"
]
},
{
"id": 6486,
"kind": "msg",
"jp": [
"「あ」"
]
},
{
"id": 6487,
"kind": "msg",
"jp": [
"階段へ向かうと、廊下の奥へ",
"歩いていく双子の姿が見えた。",
"手には食事を持っていたようだ。"
]
},
{
"id": 6488,
"kind": "msg",
"jp": [
"「お嬢さん方、",
"もう起きてたみてえですね」"
]
},
{
"id": 6489,
"kind": "msg",
"jp": [
"日織がトーストと卵で朝食を作って",
"くれたので二人して食べる。"
]
},
{
"id": 6490,
"kind": "msg",
"jp": [
"今日はこのまま何事もなければ",
"いいんだけど・・・。"
]
},
{
"id": 6491,
"kind": "msg",
"jp": [
"「・・・何の音です?」"
]
},
{
"id": 6492,
"kind": "msg",
"jp": [
"「な、なんか、鳴ったよね」"
]
},
{
"id": 6493,
"kind": "msg",
"jp": [
"「表じゃねえですかい?」"
]
},
{
"id": 6494,
"kind": "msg",
"jp": [
"「うん、外だと思う」"
]
},
{
"id": 6495,
"kind": "msg",
"jp": [
"窓に駆け寄って外を見てみる。"
]
},
{
"id": 6496,
"kind": "msg",
"jp": [
"相変わらず雨は降りつづけていて、",
"視界が悪い。"
]
},
{
"id": 6497,
"kind": "msg",
"jp": [
"「・・・あ、あれ!」"
]
},
{
"id": 6498,
"kind": "msg",
"jp": [
"「ほら、温室!",
"なんか光が・・・!」"
]
},
{
"id": 6499,
"kind": "msg",
"jp": [
"「・・・本当ですね。",
"懐中電灯の明かりみてえですが",
"誰かいるのかな」"
]
},
{
"id": 6500,
"kind": "msg",
"jp": [
"「そりゃあ、",
"勝手に揺れるわけないし・・・」"
]
},
{
"id": 6501,
"kind": "msg",
"jp": [
"「行ってみましょう」"
]
},
{
"id": 6502,
"kind": "msg",
"jp": [
"「え、あ、日織!?",
"待ってー!!」"
]
},
{
"id": 6503,
"kind": "msg",
"jp": [
"「・・・あ、誰かいる?」"
]
},
{
"id": 6504,
"kind": "msg",
"jp": [
"温室の中では、思ったとおり天井から",
"吊るされていた懐中電灯がゆらゆらと",
"揺れていた。"
]
},
{
"id": 6505,
"kind": "msg",
"jp": [
"しかし、僕ら以外には誰の姿も",
"見当たらない・・・。"
]
},
{
"id": 6506,
"kind": "msg",
"jp": [
"「えっ!? な、なに?」"
]
},
{
"id": 6507,
"kind": "msg",
"jp": [
"「なんか増えてますぜ」"
]
},
{
"id": 6508,
"kind": "msg",
"jp": [
"『復讐』の赤い文字の周りに並んだ",
"小物の中に、今までなかった物が",
"ひとつ増えていた。"
]
},
{
"id": 6509,
"kind": "msg",
"jp": [
"小さな木の、柵・・・?",
"なんなんだろう、これ・・・。"
]
},
{
"id": 6510,
"kind": "msg",
"jp": [
"「ちょっとー、どないしたん?」"
]
},
{
"id": 6511,
"kind": "msg",
"jp": [
"背後から声がして、近寄ってくる",
"足音が聞こえる。"
]
},
{
"id": 6512,
"kind": "msg",
"jp": [
"「・・・なんかあった?」"
]
},
{
"id": 6513,
"kind": "msg",
"jp": [
"「うん、あれ・・・」"
]
},
{
"id": 6514,
"kind": "msg",
"jp": [
"「焦げてる」"
]
},
{
"id": 6515,
"kind": "msg",
"jp": [
"柵を指差したつもりだった僕は",
"意味がわからず静奈ちゃんの",
"視線の先を振り返る。"
]
},
{
"id": 6516,
"kind": "msg",
"jp": [
"「・・・なんだこりゃ。",
"なんかの燃えカスみてえだな」"
]
},
{
"id": 6517,
"kind": "msg",
"jp": [
"うっすらと焦げた床の上に、",
"何かの燃えカスが散らばっている。"
]
},
{
"id": 6518,
"kind": "msg",
"jp": [
"「バクチクか何か違うん?」"
]
},
{
"id": 6519,
"kind": "msg",
"jp": [
"「あ・・・",
"そう言えばそんな音だった」"
]
},
{
"id": 6520,
"kind": "msg",
"jp": [
"「音?」"
]
},
{
"id": 6521,
"kind": "msg",
"jp": [
"「聞こえなかった?",
"さっきなんか破裂するみたいな",
"音がしたんだけど」"
]
},
{
"id": 6522,
"kind": "msg",
"jp": [
"「それは知らんわ。",
"うちら、お兄さんらが走って行くん",
"窓から見えたから来てみてん」"
]
},
{
"id": 6523,
"kind": "msg",
"jp": [
"「そっか・・・。",
"けど、なんでこんなもの",
"鳴らすんだろう・・・」"
]
},
{
"id": 6524,
"kind": "msg",
"jp": [
"「・・・まだ続くから、かな」"
]
},
{
"id": 6525,
"kind": "msg",
"jp": [
"「だって、柵」"
]
},
{
"id": 6526,
"kind": "msg",
"jp": [
"「まあ・・・",
"他に理由は考えにくいですね」"
]
},
{
"id": 6527,
"kind": "msg",
"jp": [
"「そやろね。",
"ええ趣味してはるわ、ほんまに」"
]
},
{
"id": 6528,
"kind": "msg",
"jp": [
"「行こう、お姉ちゃん。",
"朝ご飯部屋に置いたままや」"
]
},
{
"id": 6529,
"kind": "msg",
"jp": [
"そう言ってふらりと双子が去り、",
"つられるように残る僕らも温室を出た。"
]
},
{
"id": 6530,
"kind": "msg",
"jp": [
"「・・・それじゃ、",
"俺は書斎にいますからね」"
]
},
{
"id": 6531,
"kind": "msg",
"jp": [
"部屋に戻り、雨に濡れた髪を拭いて",
"束ねなおすと日織は出て行った。"
]
},
{
"id": 6532,
"kind": "msg",
"jp": [
"（僕はどうしようかな・・・）"
]
},
{
"id": 6533,
"kind": "msg",
"jp": [
"双子は無事だったけど。",
"温室のあの様子じゃ犯人はちっとも",
"止める気ないみたいだ・・・。"
]
},
{
"id": 6534,
"kind": "msg",
"jp": [
"「んー・・・・」"
]
},
{
"id": 6535,
"kind": "msg",
"jp": [
"強ばった身体をほぐすように",
"腕を上げて背を伸ばす。"
]
},
{
"id": 6536,
"kind": "msg",
"jp": [
"「さすがにくたびれましたねえ」"
]
},
{
"id": 6537,
"kind": "msg",
"jp": [
"「ちょっとお腹すいた・・・」"
]
},
{
"id": 6538,
"kind": "msg",
"jp": [
"「あはは、俺もです。",
"台所に寄ってなんか食いますか」"
]
},
{
"id": 6539,
"kind": "msg",
"jp": [
"疲れきってるのに空腹で眠れないのは",
"困るということで、台所へ降りてきた。"
]
},
{
"id": 6540,
"kind": "msg",
"jp": [
"「あんまり腹いっぱい食うのも",
"それはそれで寝苦しいし、",
"カップスープか何かにします?」"
]
},
{
"id": 6541,
"kind": "msg",
"jp": [
"「うん、それでいいよ」"
]
},
{
"id": 6542,
"kind": "msg",
"jp": [
"「んじゃ、すぐ作りますよ。",
"そっちの棚から適当に",
"マグカップ出して下さいな」"
]
},
{
"id": 6543,
"kind": "msg",
"jp": [
"「んーと・・・",
"これでいいかな」"
]
},
{
"id": 6544,
"kind": "msg",
"jp": [
"「カップスープの素って",
"この辺だっけ」"
]
},
{
"id": 6545,
"kind": "msg",
"jp": [
"「そこの奥にあるでしょう」"
]
},
{
"id": 6546,
"kind": "msg",
"jp": [
"「ああ、あったあった。",
"日織、コーンポタージュと",
"ミネストローネどっちがいい?」"
]
},
{
"id": 6547,
"kind": "msg",
"jp": [
"「んー・・・",
"味噌汁ありませんでしたっけ」"
]
},
{
"id": 6548,
"kind": "msg",
"jp": [
"「あ、あるよ。",
"僕もそうしようかな・・・」"
]
},
{
"id": 6549,
"kind": "msg",
"jp": [
"結局、二人してマグカップで",
"インスタントの味噌汁を飲む。"
]
},
{
"id": 6550,
"kind": "msg",
"jp": [
"「・・・はー」"
]
},
{
"id": 6551,
"kind": "msg",
"jp": [
"「なんか、やっと",
"人心地ついた感じ」"
]
},
{
"id": 6552,
"kind": "msg",
"jp": [
"「へ・・・?」"
]
},
{
"id": 6553,
"kind": "msg",
"jp": [
"「・・・今、なんか変な音が",
"しましたよね・・・」"
]
},
{
"id": 6554,
"kind": "msg",
"jp": [
"「うん・・・。",
"外からだったよね」"
]
},
{
"id": 6555,
"kind": "msg",
"jp": [
"気になって、音がした方――裏庭の",
"見える方の窓へ近寄ってみた。"
]
},
{
"id": 6556,
"kind": "msg",
"jp": [
"「やっぱり何か鳴ってる・・?」"
]
},
{
"id": 6557,
"kind": "msg",
"jp": [
"「・・・{和/なご}さん、あれ!」"
]
},
{
"id": 6558,
"kind": "msg",
"jp": [
"「え? どれ?」"
]
},
{
"id": 6559,
"kind": "msg",
"jp": [
"温室の中で光が揺れているのが",
"見えた。"
]
},
{
"id": 6560,
"kind": "msg",
"jp": [
"「あれって・・・懐中電灯?」"
]
},
{
"id": 6561,
"kind": "msg",
"jp": [
"「他に揺れる灯りなんてねえし",
"多分そうでしょうが・・・」"
]
},
{
"id": 6562,
"kind": "msg",
"jp": [
"「でっ、でも・・・!",
"勝手に揺れ出すわけないよ!",
"誰か、温室に誰かいる・・・!!」"
]
},
{
"id": 6563,
"kind": "msg",
"jp": [
"「・・・行ってみましょう」"
]
},
{
"id": 6564,
"kind": "msg",
"jp": [
"「えっ!?",
"あ、いや、そうだね・・・」"
]
},
{
"id": 6565,
"kind": "msg",
"jp": [
"放っておくわけにもいかないので、",
"台所を飛び出した。"
]
},
{
"id": 6566,
"kind": "msg",
"jp": [
"「・・・やっぱ、",
"懐中電灯ですね」"
]
},
{
"id": 6567,
"kind": "msg",
"jp": [
"温室へ来てみると、懐中電灯はまだ",
"ゆらゆら揺れていた。"
]
},
{
"id": 6568,
"kind": "msg",
"jp": [
"「誰も・・・いないよね・・・」"
]
},
{
"id": 6569,
"kind": "msg",
"jp": [
"「・・・そのようですがね。",
"俺らが来る前に逃げたのか・・・」"
]
},
{
"id": 6570,
"kind": "msg",
"jp": [
"生い茂った植物のせいで、奥までは",
"見通せないけど誰かが潜んでいる",
"ような気配はしない・・・と、思う。"
]
},
{
"id": 6571,
"kind": "msg",
"jp": [
"周りを見回しながら、奥の方へと",
"進んでいき、例の『復讐』の紙が",
"置いてある場所へ来た。"
]
},
{
"id": 6572,
"kind": "msg",
"jp": [
"「・・・あ・・・・」"
]
},
{
"id": 6573,
"kind": "msg",
"jp": [
"「増えてますね・・・」"
]
},
{
"id": 6574,
"kind": "msg",
"jp": [
"『復讐』の赤い文字の周りに",
"並べられた小物。"
]
},
{
"id": 6575,
"kind": "msg",
"jp": [
"そこに、また1つ新たな品が",
"加えられていた。"
]
},
{
"id": 6576,
"kind": "msg",
"jp": [
"「・・・柵?」"
]
},
{
"id": 6577,
"kind": "msg",
"jp": [
"不意に後ろから声がして、",
"驚いて日織にしがみつく。"
]
},
{
"id": 6578,
"kind": "msg",
"jp": [
"振り向いてみると、いつの間にか",
"他の人も集まってきていた。"
]
},
{
"id": 6579,
"kind": "msg",
"jp": [
"「だから、アンタ驚きすぎ」"
]
},
{
"id": 6580,
"kind": "msg",
"jp": [
"「う・・・だ、だって・・・」"
]
},
{
"id": 6581,
"kind": "msg",
"jp": [
"「最初に鳴った変な音",
"聞こえたんですかい?」"
]
},
{
"id": 6582,
"kind": "msg",
"jp": [
"「ううん、なんか騒いでる声がして",
"窓からのぞいたら、お兄さんらが",
"走ってくんが見えたから」"
]
},
{
"id": 6583,
"kind": "msg",
"jp": [
"「ああ、僕らの声でか・・・。",
"じゃあ最初になった変な音、",
"あれなんだったんだろ?」"
]
},
{
"id": 6584,
"kind": "msg",
"jp": [
"「・・・それは?」"
]
},
{
"id": 6585,
"kind": "msg",
"jp": [
"「それ?」"
]
},
{
"id": 6586,
"kind": "msg",
"jp": [
"静奈ちゃんは、床に落ちている何かの",
"燃えかすのような物を指さしている。"
]
},
{
"id": 6587,
"kind": "msg",
"jp": [
"「・・・何だろ、これ」"
]
},
{
"id": 6588,
"kind": "msg",
"jp": [
"「床が焦げてますね。",
"バクチクじゃねえかなぁ」"
]
},
{
"id": 6589,
"kind": "msg",
"jp": [
"「バクチク・・・。",
"そうか、そういえばそんな音だったね」"
]
},
{
"id": 6590,
"kind": "msg",
"jp": [
"「けど、なんで",
"そんなん鳴らすわけ?」"
]
},
{
"id": 6591,
"kind": "msg",
"jp": [
"「そりゃあ・・・",
"あの柵のためじゃねえかな」"
]
},
{
"id": 6592,
"kind": "msg",
"jp": [
"「・・・柵・・・」"
]
},
{
"id": 6593,
"kind": "msg",
"jp": [
"小さな木製の柵だった。",
"何に使うものなのか、",
"よくわからない・・・。"
]
},
{
"id": 6594,
"kind": "msg",
"jp": [
"「・・・まだ続く、から?」"
]
},
{
"id": 6595,
"kind": "msg",
"jp": [
"静奈ちゃんの言葉に、",
"答える声はなかった。"
]
},
{
"id": 6596,
"kind": "msg",
"jp": [
"きっと、その通りだろうと",
"思っていただろうけど・・・。"
]
},
{
"id": 6597,
"kind": "msg",
"jp": [
"「まあ・・・",
"ながめててもしょうがねえし、",
"とにかく戻りましょうや」"
]
},
{
"id": 6598,
"kind": "msg",
"jp": [
"日織がそう促し、はっと呪縛が",
"解けたかのようになんとなく",
"お互いの顔を見回した。"
]
},
{
"id": 6599,
"kind": "msg",
"jp": [
"「・・・・帰ろ」"
]
},
{
"id": 6600,
"kind": "msg",
"jp": [
"双子が呟いて、温室を出て行く。",
"僕らもそれに続いた。"
]
},
{
"id": 6601,
"kind": "msg",
"jp": [
"「やれやれ・・・",
"とんだ邪魔が入りましたね」"
]
},
{
"id": 6602,
"kind": "msg",
"jp": [
"「うん・・・でもさぁ・・・",
"今まではわざわざ温室に誘い出したの",
"最初だけだったのに・・・」"
]
},
{
"id": 6603,
"kind": "msg",
"jp": [
"「なんでまた、今回に限って・・・?」"
]
},
{
"id": 6604,
"kind": "msg",
"jp": [
"「わかりませんねぇ。",
"けど、予定通りなら日数も",
"もう残り少ねえし・・・」"
]
},
{
"id": 6605,
"kind": "msg",
"jp": [
"「犯人も少々焦ってるのかも",
"知れませんね」"
]
},
{
"id": 6606,
"kind": "msg",
"jp": [
"「焦ってる?」"
]
},
{
"id": 6607,
"kind": "msg",
"jp": [
"「双子は無事でしたからね。",
"上手く阻止されたんで、次はそうは",
"いかないとでも言いたいのか」"
]
},
{
"id": 6608,
"kind": "msg",
"jp": [
"「そんなぁっ!?」"
]
},
{
"id": 6609,
"kind": "msg",
"jp": [
"「いや、わかんねえですって。",
"適当に思いついたこと言っただけ",
"なんですから」"
]
},
{
"id": 6610,
"kind": "msg",
"jp": [
"「そんな怖がらなくても",
"外れてる可能性のが高えでしょう」"
]
},
{
"id": 6611,
"kind": "msg",
"jp": [
"「・・・今回は外れてることを",
"祈るよ・・・」"
]
},
{
"id": 6612,
"kind": "msg",
"jp": [
"それが当たってたら、どう考えても",
"一番恨まれてるの僕だし。"
]
},
{
"id": 6613,
"kind": "msg",
"jp": [
"（いや、当たってなくても",
"そうなのか・・・?）"
]
},
{
"id": 6614,
"kind": "msg",
"jp": [
"余計なことしてるの僕だしなぁ。",
"ああ、だんだん怖い考えになってきた。"
]
},
{
"id": 6615,
"kind": "msg",
"jp": [
"「ほらほら、そんな泣きそうな顔",
"してねえで・・・」"
]
},
{
"id": 6616,
"kind": "msg",
"jp": [
"「休みましょうや。",
"もうさすがに邪魔も入んねえでしょう」"
]
},
{
"id": 6617,
"kind": "msg",
"jp": [
"「う、うん、そうする・・・」"
]
},
{
"id": 6618,
"kind": "msg",
"jp": [
"「・・・おやすみ」"
]
},
{
"id": 6619,
"kind": "msg",
"jp": [
"変なことが起きたせいで、",
"眠気が飛んでしまったような",
"気がしたけど・・・。"
]
},
{
"id": 6620,
"kind": "msg",
"jp": [
"（・・・やっぱり疲れてるな・・・）"
]
},
{
"id": 6621,
"kind": "msg",
"jp": [
"ベッドに横になった途端、",
"意識を失うように眠ってしまった。"
]
},
{
"id": 6622,
"kind": "msg",
"jp": [
"（・・・・ん・・?）"
]
},
{
"id": 6623,
"kind": "msg",
"jp": [
"・・・なんでこんなすぐに",
"目が覚めるんだ・・・。"
]
},
{
"id": 6624,
"kind": "msg",
"jp": [
"（さっき横になったばっかし・・・）"
]
},
{
"id": 6625,
"kind": "msg",
"jp": [
"「・・・あれ?",
"日織、もういない・・・」"
]
},
{
"id": 6626,
"kind": "msg",
"jp": [
"やけに早いな、と思いながら",
"枕もとに置いた腕時計に手を伸ばし",
"見てみると・・・・。"
]
},
{
"id": 6627,
"kind": "msg",
"jp": [
"「・・・昼過ぎてる・・・」"
]
},
{
"id": 6628,
"kind": "msg",
"jp": [
"一瞬で目が覚めたような気がしたのは",
"完全に気のせいだった。"
]
},
{
"id": 6629,
"kind": "msg",
"jp": [
"夢も見ないで爆睡していただけ",
"だったらしい・・・。"
]
},
{
"id": 6630,
"kind": "msg",
"jp": [
"（・・・起きよう）"
]
},
{
"id": 6631,
"kind": "msg",
"jp": [
"頭を振って眠気を振り払うと、",
"ごそごそと布団から這い出した。"
]
},
{
"id": 6632,
"kind": "msg",
"jp": [
"（・・・もう、明るくなって",
"来てるなぁ・・・）"
]
},
{
"id": 6633,
"kind": "msg",
"jp": [
"隙間から見える廊下には、",
"ぼんやりとした明るさが",
"にじんできていた。"
]
},
{
"id": 6634,
"kind": "msg",
"jp": [
"（そろそろ、出てもいいかな。",
"腰も痛いし・・・）"
]
},
{
"id": 6635,
"kind": "msg",
"jp": [
"一度部屋に戻ろう・・・。"
]
},
{
"id": 6636,
"kind": "msg",
"jp": [
"（日織はまだ寝てる",
"だろうから、",
"起こさないように・・・）"
]
},
{
"id": 6637,
"kind": "msg",
"jp": [
"静かにベッドに潜り込んで",
"浅く短い眠りについた・・・。"
]
},
{
"id": 6638,
"kind": "msg",
"jp": [
"そろそろ、大丈夫かも。",
"みんな起きてくる前に",
"一度部屋に引き上げよう。"
]
},
{
"id": 6639,
"kind": "msg",
"jp": [
"（・・・どこ行こう）"
]
},
{
"id": 6640,
"kind": "msg",
"jp": [
"「あ、もうこんな時間か。",
"誰か降りてくるかも・・・」"
]
},
{
"id": 6641,
"kind": "msg",
"jp": [
"「・・・なんか、",
"えらい薄暗ぁなって来てへん?」"
]
},
{
"id": 6642,
"kind": "msg",
"jp": [
"「あ、もう夕方だね」"
]
},
{
"id": 6643,
"kind": "msg",
"jp": [
"「日が暮れただけ?",
"また天気悪化してんのか思た」"
]
},
{
"id": 6644,
"kind": "msg",
"jp": [
"「・・・お兄さん晩ご飯",
"どないすんのん?」"
]
},
{
"id": 6645,
"kind": "msg",
"jp": [
"「1階に降りてみるよ。",
"日織が顔出すだろうから」"
]
},
{
"id": 6646,
"kind": "msg",
"jp": [
"「そう、ほなうちも",
"お姉ちゃん誘いに行こ」"
]
},
{
"id": 6647,
"kind": "msg",
"jp": [
"「じゃあ、またね」"
]
},
{
"id": 6648,
"kind": "msg",
"jp": [
"「うん、それじゃあ」"
]
},
{
"id": 6649,
"kind": "msg",
"jp": [
"日織ももう、書斎から",
"出てくる時間だよな。"
]
},
{
"id": 6650,
"kind": "msg",
"jp": [
"「・・・もうええでしょ。",
"日が暮れてもうたわ」"
]
},
{
"id": 6651,
"kind": "msg",
"jp": [
"「あ、本当だ・・・。",
"ごめん、それじゃあね」"
]
},
{
"id": 6652,
"kind": "msg",
"jp": [
"・・・日織ももう、",
"書斎から出てくる頃かな。"
]
},
{
"id": 6653,
"kind": "msg",
"jp": [
"「・・・お腹すいた」"
]
},
{
"id": 6654,
"kind": "msg",
"jp": [
"「え? あ、もうこんな時間か」"
]
},
{
"id": 6655,
"kind": "msg",
"jp": [
"「たぶん、そろそろ",
"鈴が呼びに来る・・・」"
]
},
{
"id": 6656,
"kind": "msg",
"jp": [
"「日織ももう書斎から出てくる頃かな」"
]
},
{
"id": 6657,
"kind": "msg",
"jp": [
"「・・・ほな、ばいばい」"
]
},
{
"id": 6658,
"kind": "msg",
"jp": [
"「うん、ありがとうね。",
"それじゃあ」"
]
},
{
"id": 6659,
"kind": "msg",
"jp": [
"「・・・・もうええ?」"
]
},
{
"id": 6660,
"kind": "msg",
"jp": [
"「あ・・",
"うん、ありがとう」"
]
},
{
"id": 6661,
"kind": "msg",
"jp": [
"（もう夕方だな・・・）"
]
},
{
"id": 6662,
"kind": "msg",
"jp": [
"日織もそろそろ書斎から出てくる",
"だろうから1階に降りよう・・・。"
]
},
{
"id": 6663,
"kind": "msg",
"jp": [
"「・・・あら、ごめんなさい。",
"もうこんな時間だわ」"
]
},
{
"id": 6664,
"kind": "msg",
"jp": [
"「うわ、本当だ。",
"すみません」"
]
},
{
"id": 6665,
"kind": "msg",
"jp": [
"「いいえ、私はかまいませんわ。",
"でも一柳さんは日織さんが心配",
"なさるんじゃありません?」"
]
},
{
"id": 6666,
"kind": "msg",
"jp": [
"「え、ええ。",
"それじゃ、お邪魔しました」"
]
},
{
"id": 6667,
"kind": "msg",
"jp": [
"「いつでもいらして下さい。",
"1人で部屋にいるとどうしても",
"気が滅入ってしまいますから・・・」"
]
},
{
"id": 6668,
"kind": "msg",
"jp": [
"「・・・はい。",
"それじゃあ・・・」"
]
},
{
"id": 6669,
"kind": "msg",
"jp": [
"「・・・あの、申し訳ないの",
"ですけど気分が優れませんので・・」"
]
},
{
"id": 6670,
"kind": "msg",
"jp": [
"「あ、すみません。",
"それじゃあ・・・」"
]
},
{
"id": 6671,
"kind": "msg",
"jp": [
"「・・・ごめんなさい」"
]
},
{
"id": 6672,
"kind": "msg",
"jp": [
"（・・・かなり参ってる",
"みたいだなあ・・・）"
]
},
{
"id": 6673,
"kind": "msg",
"jp": [
"・・・あ、もうこんな時間か。",
"そろそろ1階に降りよう。"
]
},
{
"id": 6674,
"kind": "msg",
"jp": [
"「・・・おう、坊主。",
"そろそろニュースの時間だぜ」"
]
},
{
"id": 6675,
"kind": "msg",
"jp": [
"「あ、本当ですね。",
"それじゃ、僕ラジオ聞きに行きます」"
]
},
{
"id": 6676,
"kind": "msg",
"jp": [
"「頼んだぜ。",
"朗報があったらすぐ知らせろよ」"
]
},
{
"id": 6677,
"kind": "msg",
"jp": [
"「わかりました。",
"じゃあ、また・・・」"
]
},
{
"id": 6678,
"kind": "msg",
"jp": [
"「気ぃつけてな」"
]
},
{
"id": 6679,
"kind": "msg",
"jp": [
"「はい」"
]
},
{
"id": 6680,
"kind": "msg",
"jp": [
"「・・・んー?",
"なんか暗ぇなと思ったらもう",
"こんな時間かよ・・・」"
]
},
{
"id": 6681,
"kind": "msg",
"jp": [
"「あれ、本当だ。",
"もう夕方かあ・・・」"
]
},
{
"id": 6682,
"kind": "msg",
"jp": [
"「それじゃ、僕そろそろ行くよ。",
"お邪魔しました」"
]
},
{
"id": 6683,
"kind": "msg",
"jp": [
"「・・・失礼ですがそろそろ",
"日も暮れますので・・・」"
]
},
{
"id": 6684,
"kind": "msg",
"jp": [
"「あ、そうだね。",
"それじゃ、お邪魔しました」"
]
},
{
"id": 6685,
"kind": "msg",
"jp": [
"「お気をつけて」"
]
},
{
"id": 6686,
"kind": "msg",
"jp": [
"・・・日織はもう来てるかな。"
]
},
{
"id": 6687,
"kind": "msg",
"jp": [
"「あ、もう夕飯の時間ですね」"
]
},
{
"id": 6688,
"kind": "msg",
"jp": [
"「あれ、もうそんな時間だった?",
"しまったまだスクワット終わってないや」"
]
},
{
"id": 6689,
"kind": "msg",
"jp": [
"「え、あの、すみません",
"お邪魔しちゃって」"
]
},
{
"id": 6690,
"kind": "msg",
"jp": [
"「あはは、いいよそんなの。",
"今からやっちゃうからさ」"
]
},
{
"id": 6691,
"kind": "msg",
"jp": [
"「和くんはご飯食べに行きなよ」"
]
},
{
"id": 6692,
"kind": "msg",
"jp": [
"「はい、そうします。",
"それじゃ、ありがとうございました」"
]
},
{
"id": 6693,
"kind": "msg",
"jp": [
"「またねー」"
]
},
{
"id": 6694,
"kind": "msg",
"jp": [
"「・・・ごめん、もういいかな?",
"今日の分のスクワットがまだ",
"いつもの回数終わってなくてさ」"
]
},
{
"id": 6695,
"kind": "msg",
"jp": [
"「あ、すみません。",
"それじゃ失礼します」"
]
},
{
"id": 6696,
"kind": "msg",
"jp": [
"「うん、すまないね」"
]
},
{
"id": 6697,
"kind": "msg",
"jp": [
"（・・・ああ、もうこんな時間か）"
]
},
{
"id": 6698,
"kind": "msg",
"jp": [
"日織が来てるかもしれないし",
"1階に降りよう・・・。"
]
},
{
"id": 6699,
"kind": "msg",
"jp": [
"「・・・ありゃ、もう薄暗ぇな」"
]
},
{
"id": 6700,
"kind": "msg",
"jp": [
"「え? ああ、本当だ。",
"もう夕方だね・・・」"
]
},
{
"id": 6701,
"kind": "msg",
"jp": [
"「そろそろ行きましょうか」"
]
},
{
"id": 6702,
"kind": "msg",
"jp": [
"「・・・いやあぁぁぁぁぁ・・・!!」"
]
},
{
"id": 6703,
"kind": "msg",
"jp": [
"「!?」"
]
},
{
"id": 6704,
"kind": "msg",
"jp": [
"館中に響き渡るような、",
"ものすごい悲鳴で飛び起きた。"
]
},
{
"id": 6705,
"kind": "msg",
"jp": [
"「な・・い、今の声・・・」"
]
},
{
"id": 6706,
"kind": "msg",
"jp": [
"「双子のどっちかじゃねえですかい。",
"行きましょう!」"
]
},
{
"id": 6707,
"kind": "msg",
"jp": [
"急いで眼鏡を掛けて、部屋を飛び出す。"
]
},
{
"id": 6708,
"kind": "msg",
"jp": [
"「・・・静奈さんの部屋ですぜ」"
]
},
{
"id": 6709,
"kind": "msg",
"jp": [
"「ほんとだ、開いてる・・・」"
]
},
{
"id": 6710,
"kind": "msg",
"jp": [
"「お姉ちゃん!!",
"お姉ちゃぁあん!!」"
]
},
{
"id": 6711,
"kind": "msg",
"jp": [
"静奈ちゃんの部屋の扉が半分ほど",
"開きっぱなしになっている。"
]
},
{
"id": 6712,
"kind": "msg",
"jp": [
"中からは鈴奈ちゃんの叫び声が",
"聞こえており、慌てて近づいた。"
]
},
{
"id": 6713,
"kind": "msg",
"jp": [
"「鈴奈ちゃん?",
"どうしたん・・・・」"
]
},
{
"id": 6714,
"kind": "msg",
"jp": [
"「・・・・・こりゃあ・・・」"
]
},
{
"id": 6715,
"kind": "msg",
"jp": [
"あまりにも凄惨な光景に、金縛りにでも",
"あったように身体が固まってしまう。"
]
},
{
"id": 6716,
"kind": "msg",
"jp": [
"悲鳴を上げたくても、声も出なくて、",
"身体は動かないのに目の前の真っ赤な",
"部屋だけがぐるぐる回り出して・・・"
]
},
{
"id": 6717,
"kind": "msg",
"jp": [
"「・・・{和/なご}さん!」"
]
},
{
"id": 6718,
"kind": "msg",
"jp": [
"がくん、と視線が大きく揺れる。",
"気がつくと崩れ落ちそうになったのを",
"支えられていた。"
]
},
{
"id": 6719,
"kind": "msg",
"jp": [
"「・・・ひ・・・ひおり・・・」"
]
},
{
"id": 6720,
"kind": "msg",
"jp": [
"「喋んなくていいです、",
"いいですから、しっかり・・・」"
]
},
{
"id": 6721,
"kind": "msg",
"jp": [
"「・・・あ・・・れ、",
"静奈ちゃん・・・なの・・・?」"
]
},
{
"id": 6722,
"kind": "msg",
"jp": [
"「・・・・・・・ええ」"
]
},
{
"id": 6723,
"kind": "msg",
"jp": [
"ベッドに横たわった血まみれの姿からは",
"異様なものが生えている。"
]
},
{
"id": 6724,
"kind": "msg",
"jp": [
"胸元から、変な角度で、",
"鈍い鉄の色をした何かが・・・。"
]
},
{
"id": 6725,
"kind": "msg",
"jp": [
"「・・・なん、で?",
"あんな・・・あれ、なに・・・?」"
]
},
{
"id": 6726,
"kind": "msg",
"jp": [
"「・・・斧だと思います」"
]
},
{
"id": 6727,
"kind": "msg",
"jp": [
"「おの? おのって・・・」"
]
},
{
"id": 6728,
"kind": "msg",
"jp": [
"「――出てけぇっ!!」"
]
},
{
"id": 6729,
"kind": "msg",
"jp": [
"「うわっ・・!?」"
]
},
{
"id": 6730,
"kind": "msg",
"jp": [
"呆然としていると、突然走り寄って",
"きた鈴奈ちゃんに突き飛ばされた。"
]
},
{
"id": 6731,
"kind": "msg",
"jp": [
"「出てけ、出てけってばぁ!",
"お姉ちゃんに触るなぁ!!」"
]
},
{
"id": 6732,
"kind": "msg",
"jp": [
"「ちょっ・・・鈴奈さん、",
"落ち着いて、触りゃしませんから」"
]
},
{
"id": 6733,
"kind": "msg",
"jp": [
"「出てけやぁ! 早う!!",
"出てけぇっ!!」"
]
},
{
"id": 6734,
"kind": "msg",
"jp": [
"日織がなだめようとしても、",
"鈴奈ちゃんは出て行けと",
"押し出すばかりだった。"
]
},
{
"id": 6735,
"kind": "msg",
"jp": [
"そして、目の前で扉を閉めてしまう。",
"部屋の中からは、この世の物とは",
"思えない号泣の声が聞こえてくる・・。"
]
},
{
"id": 6736,
"kind": "msg",
"jp": [
"「・・・しばらく、そっと",
"しとくしかねえでしょうね」"
]
},
{
"id": 6737,
"kind": "msg",
"jp": [
"「ええ・・・・・・」"
]
},
{
"id": 6738,
"kind": "msg",
"jp": [
"ああ、日織の他にも誰かいたんだ。",
"薄れていく意識の中で、ぼんやりと",
"そんなことを考えていた。"
]
}
]