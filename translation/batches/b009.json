]
},
{
"id": 5327,
"kind": "msg",
"jp": [
"「で、でも・・・!」"
]
},
{
"id": 5328,
"kind": "msg",
"jp": [
"なんて言えばいいのか、",
"とっさにわからなかった。"
]
},
{
"id": 5329,
"kind": "msg",
"jp": [
