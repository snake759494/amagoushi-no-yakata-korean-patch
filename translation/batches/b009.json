]
},
{
"id": 5334,
"kind": "msg",
"jp": [
"「でも、それは・・・",
"僕だけ部外者だからで・・・」"
]
},
{
"id": 5335,
"kind": "msg",
"jp": [
"「もし、同じ立場だったら",
"僕だってきっと・・・」"
]
},
{
"id": 5336,
"kind": "msg",
"jp": [
"「違う立場だからいいんですよ。",
"{和/なご}さんがいてくれるから",
"俺も正気でいられる」"
]
},
{
"id": 5337,
"kind": "msg",
"jp": [
"「いや、正気だったらどうだったか",
"思い出せるっていうかね・・・」"
]
},
{
"id": 5338,
"kind": "msg",
"jp": [
"「あんたが嫌じゃなけりゃ、",
"ここにいて下さいな」"
]
},
{
"id": 5339,
"kind": "msg",
"jp": [
"「なじってくれたって",
"いいですから。",
"那須さんの代わりに」"
]
},
{
"id": 5340,
"kind": "msg",
"jp": [
"「そんなの・・・」"
]
},
{
"id": 5341,
"kind": "msg",
"jp": [
"「そんなの、出来ないよ・・・!",
"日織は悪くないもん・・・」"
]
},
{
"id": 5342,
"kind": "msg",
"jp": [
"「こんな、こんなこと・・・に、",
"した、犯人が・・・悪いんだ・・・」"
]
},
{
"id": 5343,
"kind": "msg",
"jp": [
"「ああ、すみませんねえ。",
"また泣かせちまった」"
]
},
{
"id": 5344,
"kind": "msg",
"jp": [
"「は、犯人が・・・犯人が",
"いちば・・・悪い・・だよ・・・」"
]
},
{
"id": 5345,
"kind": "msg",
"jp": [
"「わかってますよ・・・",
"わかってますから」"
]
},
{
"id": 5346,
"kind": "msg",
"jp": [
"「も・・・やめて・・・",
"こんなの・・・こんな・・・」"
]
},
{
"id": 5347,
"kind": "msg",
"jp": [
"ぽんぽん、と頭を撫でられて",
"どうしようもなく",
"涙が止まらなくなる。"
]
},
{
"id": 5348,
"kind": "msg",
"jp": [
"（日織は優しいのに・・・）"
]
},
{
"id": 5349,
"kind": "msg",
"jp": [
"（いいヤツなのに、",
"どうしてこんな・・・）"
]
},
{
"id": 5350,
"kind": "msg",
"jp": [
"那須さんがいなくなって悲しいって。"
]
},
{
"id": 5351,
"kind": "msg",
"jp": [
"そんな当たり前のことさえ",
"思いつくのに時間がかかるような、",
"ひどい目に遭うんだろう・・・。"
]
},
{
"id": 5352,
"kind": "msg",
"jp": [
"きっと僕よりすごく怖いし、",
"辛いし何かに当たり散らしたいかも",
"しれないのに・・・。"
]
},
{
"id": 5353,
"kind": "msg",
"jp": [
"「・・・ごめん・・・」"
]
},
{
"id": 5354,
"kind": "msg",
"jp": [
"「僕ばっかり泣いてて・・・",
"ごめん・・・」"
]
},
{
"id": 5355,
"kind": "msg",
"jp": [
"「いいんですって」"
]
},
{
"id": 5356,
"kind": "msg",
"jp": [
"「そりゃあ、笑っててくれた方が",
"いいに決まってますがね」"
]
},
{
"id": 5357,
"kind": "msg",
"jp": [
"「俺はなんだか、もう・・・",
"悲しいとかそういうのが、",
"よく思い出せねえんですよ」"
]
},
{
"id": 5358,
"kind": "msg",
"jp": [
"「だから、生きてここを",
"出られるまで泣きません」"
]
},
{
"id": 5359,
"kind": "msg",
"jp": [
"「{和/なご}さんが、俺の代わりに",
"泣いたり怒ったりして下さい」"
]
},
{
"id": 5360,
"kind": "msg",
"jp": [
"「でねえと、普通の感情ってやつを",
"忘れちまいそうだから・・・」"
]
},
{
"id": 5361,
"kind": "msg",
"jp": [
"そのまま、涙が止まるまで",
"何も言わずにいると・・・。"
]
},
{
"id": 5362,
"kind": "msg",
"jp": [
"・・・いつの間にか、うとうとして",
"しまっていたみたいで。"
]
},
{
"id": 5363,
"kind": "msg",
"jp": [
"「・・・・さん?",
"{和/なご}さん?」"
]
},
{
"id": 5364,
"kind": "msg",
"jp": [
"「・・・え・・・」"
]
},
{
"id": 5365,
"kind": "msg",
"jp": [
"「ああ、起きてました?」"
]
},
{
"id": 5366,
"kind": "msg",
"jp": [
"「あ・・・あれ・・・",
"僕、寝てた?」"
]
},
{
"id": 5367,
"kind": "msg",
"jp": [
"「舟こいでましたぜ」"
]
},
{
"id": 5368,
"kind": "msg",
"jp": [
"「うわ、ごめん・・・」"
]
},
{
"id": 5369,
"kind": "msg",
"jp": [
"「いいですよ、疲れてんでしょう。",
"寝るなら部屋に戻って寝た方が",
"いいですぜ」"
]
},
{
"id": 5370,
"kind": "msg",
"jp": [
"「・・・・ううん。",
"もう、明るくなってきてるし」"
]
},
{
"id": 5371,
"kind": "msg",
"jp": [
"窓から、ぼんやりとした",
"明るさが見えていた。"
]
},
{
"id": 5372,
"kind": "msg",
"jp": [
"「そうですねえ・・・」"
]
},
{
"id": 5373,
"kind": "msg",
"jp": [
"「・・・もう大丈夫だよ。",
"泣かないから・・・」"
]
},
{
"id": 5374,
"kind": "msg",
"jp": [
"「本当に大丈夫ですかい?」"
]
},
{
"id": 5375,
"kind": "msg",
"jp": [
"「うん、もう・・・。",
"だいぶ落ち着いたから」"
]
},
{
"id": 5376,
"kind": "msg",
"jp": [
"「・・・そうですか」"
]
},
{
"id": 5377,
"kind": "msg",
"jp": [
"日織は、なぜか少し沈んだ顔で",
"口ごもる。"
]
},
{
"id": 5378,
"kind": "msg",
"jp": [
"「・・・どうしたの?」"
]
},
{
"id": 5379,
"kind": "msg",
"jp": [
"「いえね・・・",
"那須さんの部屋、閉めとかなきゃ",
"いけねえなと・・・」"
]
},
{
"id": 5380,
"kind": "msg",
"jp": [
"「そっか、鍵まだ開いてるん",
"だったっけ・・・」"
]
},
{
"id": 5381,
"kind": "msg",
"jp": [
"「・・・じゃあ」"
]
},
{
"id": 5382,
"kind": "msg",
"jp": [
"「写真、撮っといた方がいいよね」"
]
},
{
"id": 5383,
"kind": "msg",
"jp": [
"「・・・いいんですかい」"
]
},
{
"id": 5384,
"kind": "msg",
"jp": [
"「うん、だって・・・",
"警察に渡す時、僕の携帯1つ",
"渡せばすむ方が・・・」"
]
},
{
"id": 5385,
"kind": "msg",
"jp": [
"「・・・すみません。",
"こんな大事になるなら最初から",
"俺ので撮っとけばよかったですね」"
]
},
{
"id": 5386,
"kind": "msg",
"jp": [
"「そんなの仕方ないよ。",
"僕だって、まさか・・・・」"
]
},
{
"id": 5387,
"kind": "msg",
"jp": [
"あの時はまだ、何も実感が湧かなくて",
"ここまでひどい事になるなんて",
"想像出来なかった・・・。"
]
},
{
"id": 5388,
"kind": "msg",
"jp": [
"「・・・・行こう」"
]
},
{
"id": 5389,
"kind": "msg",
"jp": [
"「ええ」"
]
},
{
"id": 5390,
"kind": "msg",
"jp": [
"重い腰を上げて、",
"那須さんの部屋へ向かう。"
]
},
{
"id": 5391,
"kind": "msg",
"jp": [
"・・・雨の音は相変わらず",
"絶え間なく続いているのに。"
]
},
{
"id": 5392,
"kind": "msg",
"jp": [
"（いつもより、しんとしてる",
"ような気がする・・・）"
]
},
{
"id": 5393,
"kind": "msg",
"jp": [
"室内は、さっき見た時と何一つ",
"変わっていなかった。"
]
},
{
"id": 5394,
"kind": "msg",
"jp": [
"ほんの少しだけ、やっぱり何かの",
"間違いじゃないかと信じたがっていた",
"気持ちが溶けるように消えていった。"
]
},
{
"id": 5395,
"kind": "msg",
"jp": [
"「{和/なご}さん、外で待ってて",
"くれてもいいですぜ」"
]
},
{
"id": 5396,
"kind": "msg",
"jp": [
"廊下に1人でいるのも嫌なので、",
"一緒に室内に入り携帯を渡す。"
]
},
{
"id": 5397,
"kind": "msg",
"jp": [
"「すぐ終わりますから・・・」"
]
},
{
"id": 5398,
"kind": "msg",
"jp": [
"そう言いながら日織は携帯の",
"カメラを起動させる。"
]
},
{
"id": 5399,
"kind": "msg",
"jp": [
"「・・・那須さんがさ、",
"亡くなったのって、すぐだよね」"
]
},
{
"id": 5400,
"kind": "msg",
"jp": [
"「お茶・・・毒飲んで、",
"すぐ・・・」"
]
},
{
"id": 5401,
"kind": "msg",
"jp": [
"「・・・ええ。",
"脈取ったとき、まだ体温",
"ありましたから・・・」"
]
},
{
"id": 5402,
"kind": "msg",
"jp": [
"「お茶以外の、もっと前に食べた",
"何か違うものに毒が入ってたって",
"ことはないかな」"
]
},
{
"id": 5403,
"kind": "msg",
"jp": [
"「それだとかなりの",
"遅効性ですね・・・」"
]
},
{
"id": 5404,
"kind": "msg",
"jp": [
"日織は一瞬だけ迷うような表情を",
"浮かべたが、すぐに那須さんの",
"顔の側にひざまずいた。"
]
},
{
"id": 5405,
"kind": "msg",
"jp": [
"「日織?」"
]
},
{
"id": 5406,
"kind": "msg",
"jp": [
"「・・・青酸系のもんだと思います」"
]
},
{
"id": 5407,
"kind": "msg",
"jp": [
"「アーモンドみてえな匂いが",
"するんですよ、それ系の毒はね」"
]
},
{
"id": 5408,
"kind": "msg",
"jp": [
"「・・・ああ、お茶の方もだ。",
"こりゃ多分、間違いねえでしょう」"
]
},
{
"id": 5409,
"kind": "msg",
"jp": [
"「・・・そうなんだ」"
]
},
{
"id": 5410,
"kind": "msg",
"jp": [
"「あの、ごめん。",
"なんか・・僕が変なこと",
"言い出したから、そんな・・・」"
]
},
{
"id": 5411,
"kind": "msg",
"jp": [
"「何言ってんですかい。",
"実はね、俺だって気には",
"なってたんですよ」"
]
},
{
"id": 5412,
"kind": "msg",
"jp": [
"「けど、さっきはさすがに",
"そこまで気が回りません",
"でしたからね・・・」"
]
},
{
"id": 5413,
"kind": "msg",
"jp": [
"でも、これで・・・。",
"那須さんが亡くなった原因はあのお茶に",
"入ってた毒に間違いないみたいだ・・・。"
]
},
{
"id": 5414,
"kind": "msg",
"jp": [
"「はい、携帯ありがとうございます」"
]
},
{
"id": 5415,
"kind": "msg",
"jp": [
"「・・・行きましょうか」"
]
},
{
"id": 5416,
"kind": "msg",
"jp": [
"携帯を受け取って部屋を出る。",
"今度こそ本当に・・・"
]
},
{
"id": 5417,
"kind": "msg",
"jp": [
"・・・那須さんの部屋は",
"閉ざされた。"
]
},
{
"id": 5418,
"kind": "msg",
"jp": [
"（・・・おやすみなさい）"
]
},
{
"id": 5419,
"kind": "msg",
"jp": [
"小さく手を合わせておく。",
"早く助けが来てくれて、",
"一緒に山を降りられますように。"
]
},
{
"id": 5420,
"kind": "msg",
"jp": [
"「・・・日織、どうするの?",
"また書斎?」"
]
},
{
"id": 5421,
"kind": "msg",
"jp": [
"「ええ、本読んでます。",
"用があったらいつでも",
"声かけて下さいな」"
]
},
{
"id": 5422,
"kind": "msg",
"jp": [
"「それじゃ、また後で。",
"あんまり無理しねえで下さいよ」"
]
},
{
"id": 5423,
"kind": "msg",
"jp": [
"「うん、わかってる。",
"また後でね」"
]
},
{
"id": 5424,
"kind": "msg",
"jp": [
"「はい、後で」"
]
},
{
"id": 5425,
"kind": "msg",
"jp": [
"日織はふらりと着物の裾を",
"翻して階段を降りて行った。"
]
},
{
"id": 5426,
"kind": "msg",
"jp": [
"（あいつこそ、全然寝てないんじゃ",
"ないのかなぁ・・・）"
]
},
{
"id": 5427,
"kind": "msg",
"jp": [
"平気そうな顔してたけど。",
"眠れないのかもしれないな・・・。"
]
},
{
"id": 5428,
"kind": "msg",
"jp": [
"「・・・暗石さん」"
]
},
{
"id": 5429,
"kind": "msg",
"jp": [
"ふらりと廊下へ出てきた",
"暗石さんは無言で那須さんの",
"部屋の扉を見つめた。"
]
},
{
"id": 5430,
"kind": "msg",
"jp": [
"「殺しても死にそうに",
"ねえと思ってたんだがな」"
]
},
{
"id": 5431,
"kind": "msg",
"jp": [
"「昼間はまるっきり",
"いつも通りだったんだろ」"
]
},
{
"id": 5432,
"kind": "msg",
"jp": [
"「いつも通りでした。",
"夕食のときも、その後も」"
]
},
{
"id": 5433,
"kind": "msg",
"jp": [
"「その後?",
"そういや何度も部屋を",
"出たり入ったりしてやがったな」"
]
},
{
"id": 5434,
"kind": "msg",
"jp": [
"「何度も?」"
]
},
{
"id": 5435,
"kind": "msg",
"jp": [
"「ああ、何やってたんだか",
"知らねえけどな」"
]
},
{
"id": 5436,
"kind": "msg",
"jp": [
"「それって夕べの",
"何時頃のことですか?」"
]
},
{
"id": 5437,
"kind": "msg",
"jp": [
"「7時前に一度戻ってきて",
"15分かそこらでドタバタ",
"出て行ったと思ったら・・」"
]
},
{
"id": 5438,
"kind": "msg",
"jp": [
"「また5分もしねえうちに",
"戻って来てたみてぇだな」"
]
},
{
"id": 5439,
"kind": "msg",
"jp": [
"「ああ、那須さんは確か",
"一度ダンベル取りに来て",
"またすぐ戻って・・・」"
]
},
{
"id": 5440,
"kind": "msg",
"jp": [
"（あれ、でも・・・",
"それは7時前だったような）"
]
},
{
"id": 5441,
"kind": "msg",
"jp": [
"（じゃあ15分ほどしてから",
"出て行ってまた戻ってきたって",
"いうのは・・・）"
]
},
{
"id": 5442,
"kind": "msg",
"jp": [
"「なんだ?",
"どうかしたのか?」"
]
},
{
"id": 5443,
"kind": "msg",
"jp": [
"「いえ、あの、",
"那須さんが5分ほどで",
"戻って来たのって・・・」"
]
},
{
"id": 5444,
"kind": "msg",
"jp": [
"「正確には何時頃だったか",
"覚えてますか?」"
]
},
{
"id": 5445,
"kind": "msg",
"jp": [
"「そん時は7時過ぎてたな。",
"5分ほどは」"
]
},
{
"id": 5446,
"kind": "msg",
"jp": [
"「暗石さん、その時那須さんに",
"会ったんですか?」"
]
},
{
"id": 5447,
"kind": "msg",
"jp": [
"「会っちゃいねえが",
"アイツの部屋の扉の音",
"だったのは確かだぜ」"
]
},
{
"id": 5448,
"kind": "msg",
"jp": [
"「双子の嬢ちゃんに",
"ならそのちょっと後で",
"会ったがな」"
]
},
{
"id": 5449,
"kind": "msg",
"jp": [
"「双子って",
"二人ともにですか?」"
]
},
{
"id": 5450,
"kind": "msg",
"jp": [
"「いいや、妹の方だけだ。",
"便所の前でばったり",
"鉢合わせしちまってな」"
]
},
{
"id": 5451,
"kind": "msg",
"jp": [
"「鈴奈ちゃんですか」"
]
},
{
"id": 5452,
"kind": "msg",
"jp": [
"「あの喋り方はそうだろうな。",
"うわ、びっくりしたーとか",
"言われたからな」"
]
},
{
"id": 5453,
"kind": "msg",
"jp": [
"「その反応は鈴奈ちゃん",
"ぽいですね」"
]
},
{
"id": 5454,
"kind": "msg",
"jp": [
"「多分な」"
]
},
{
"id": 5455,
"kind": "msg",
"jp": [
"「ま、どっちだろうと",
"毒殺じゃアリバイなんざ",
"大した意味もねえだろ」"
]
},
{
"id": 5456,
"kind": "msg",
"jp": [
"「意味があるとすりゃ",
"死んだ時間よりいつ毒が",
"入れられたか、だろうよ」"
]
},
{
"id": 5457,
"kind": "msg",
"jp": [
"「それがわかりゃあ",
"苦労はねえけどな・・・」"
]
},
{
"id": 5458,
"kind": "msg",
"jp": [
"そういい残して、",
"暗石さんはまたふらりと",
"部屋に戻っていった。"
]
},
{
"id": 5459,
"kind": "msg",
"jp": [
"（いつ、毒が・・・）"
]
},
{
"id": 5460,
"kind": "msg",
"jp": [
"（・・・そんなの特定",
"出来るのかな・・・）"
]
},
{
"id": 5461,
"kind": "msg",
"jp": [
"「あ、そうだ。",
"アリバイ表・・・!」"
]
},
{
"id": 5462,
"kind": "msg",
"jp": [
"書斎に行こう。",
"日織の聞いてくれた話も",
"聞かなきゃ・・・。"
]
},
{
"id": 5463,
"kind": "msg",
"jp": [
"「ありゃ、{和/なご}さん。",
"どうしました?」"
]
},
{
"id": 5464,
"kind": "msg",
"jp": [
"「あのほら、あれ、",
"今のうちに・・・」"
]
},
{
"id": 5465,
"kind": "msg",
"jp": [
"「・・・ああ、表ですね。",
"そういやそうでした」"
]
},
{
"id": 5466,
"kind": "msg",
"jp": [
"「しかし、やっかいですね。",
"那須さんの場合は亡くなった時間は",
"はっきりしてますが・・・」"
]
},
{
"id": 5467,
"kind": "msg",
"jp": [
"「うん、毒だから",
"飲んだ時間は犯人がどこにいようと",
"関係ないんだよね」"
]
},
{
"id": 5468,
"kind": "msg",
"jp": [
"「むしろ、毒を入れた時間ですね。",
"そのチャンスがあった人か・・・」"
]
},
{
"id": 5469,
"kind": "msg",
"jp": [
"「てことは、表の軸にする物は",
"はっきりしてますね」"
]
},
{
"id": 5470,
"kind": "msg",
"jp": [
"「えっと、それは・・・」"
]
},
{
"id": 5471,
"kind": "msg",
"jp": [
"「毒の入れられたお茶・・・」"
]
},
{
"id": 5472,
"kind": "msg",
"jp": [
"「ええ、あれは俺らがまだ",
"娯楽室に居た時に那須さんが",
"持ってたの見ましたからね」"
]
},
{
"id": 5473,
"kind": "msg",
"jp": [
"「うん、そうだった」"
]
},
{
"id": 5474,
"kind": "msg",
"jp": [
"「お風呂?」"
]
},
{
"id": 5475,
"kind": "msg",
"jp": [
"「いやまあ、風呂入るだの",
"なんだのって騒いでましたが",
"そうじゃなくてですね」"
]
},
{
"id": 5476,
"kind": "msg",
"jp": [
"「え、あ、じゃあ・・・」"
]
},
{
"id": 5477,
"kind": "msg",
"jp": [
"「・・・ダンベル?」"
]
},
{
"id": 5478,
"kind": "msg",
"jp": [
"「なんでですか。",
"まあ、それも持ってましたが」"
]
},
{
"id": 5479,
"kind": "msg",
"jp": [
"「ち、違うよね。",
"えーと・・・」"
]
},
{
"id": 5480,
"kind": "msg",
"jp": [
"「那須さんが台所に行って",
"お茶持ってったってのは、",
"確実ですからね」"
]
},
{
"id": 5481,
"kind": "msg",
"jp": [
"「その時、まだ台所にいた",
"女性陣がみんな見てますし」"
]
},
{
"id": 5482,
"kind": "msg",
"jp": [
"「だよね。",
"その後また娯楽室にダンベル",
"取りに戻ってきて・・・」"
]
},
{
"id": 5483,
"kind": "msg",
"jp": [
"「最初に娯楽室出てったのが",
"確か6時半頃で、お茶持って戻って",
"来たのが40分頃でしたか」"
]
},
{
"id": 5484,
"kind": "msg",
"jp": [
"「うん・・・あ、そうだ。",
"さっき暗石さんに廊下で",
"会ったんだけどさ」"
]
},
{
"id": 5485,
"kind": "msg",
"jp": [
"「7時前に那須さんが部屋に",
"戻ってきた物音聞いたって。",
"でも・・・」"
]
},
{
"id": 5486,
"kind": "msg",
"jp": [
"「15分かそこらで出て行ったと",
"思ったらまた5分くらいで",
"扉の音がしたって言うんだよ」"
]
},
{
"id": 5487,
"kind": "msg",
"jp": [
"「てことは那須さんが部屋に",
"戻ったのが6時45分頃とすると",
"それから7時頃まで部屋にいて・・」"
]
},
{
"id": 5488,
"kind": "msg",
"jp": [
"「暗石さんが言うには、",
"またすぐ扉の音がしたのは",
"7時ちょっと過ぎだって」"
]
},
{
"id": 5489,
"kind": "msg",
"jp": [
"「・・・何しに戻ったんでしょう。",
"着替えでも忘れたのか・・・」"
]
},
{
"id": 5490,
"kind": "msg",
"jp": [
"「そもそも、それは本当に",
"那須さんだったんですかね?」"
]
},
{
"id": 5491,
"kind": "msg",
"jp": [
"「暗石さんは扉の音を聞いたって",
"言ってるってことは、那須さんに",
"会ったわけじゃねえんですよね」"
]
},
{
"id": 5492,
"kind": "msg",
"jp": [
"「・・・うん。",
"会ってはないって」"
]
},
{
"id": 5493,
"kind": "msg",
"jp": [
"「その後トイレの前で",
"鈴奈ちゃんにはばったり",
"会ったらしいけど」"
]
},
{
"id": 5494,
"kind": "msg",
"jp": [
"「じゃあ、間違いなく那須さんと",
"特定は出来ねえわけだ・・・」"
]
},
{
"id": 5495,
"kind": "msg",
"jp": [
"「・・・そっか。",
"じゃあ表の方も7時頃の",
"那須さんのところって・・・」"
]
},
{
"id": 5496,
"kind": "msg",
"jp": [
"「部屋じゃなくて2階、",
"くらいの表記にしといた方が",
"いいかな」"
]
},
{
"id": 5497,
"kind": "msg",
"jp": [
"「そうですね。",
"今のところ断定は出来ねえし」"
]
},
{
"id": 5498,
"kind": "msg",
"jp": [
"「那須さんが",
"風呂から戻ってきたのは",
"7時半より少し前でしたか」"
]
},
{
"id": 5499,
"kind": "msg",
"jp": [
"「うん、それくらい",
"だったと思う」"
]
},
{
"id": 5500,
"kind": "msg",
"jp": [
"「その後はすぐに部屋に",
"戻っていったよね」"
]
},
{
"id": 5501,
"kind": "msg",
"jp": [
"「後は・・・静奈さんは",
"2階の吹き抜けのところの",
"長椅子にいたんですよね」"
]
},
{
"id": 5502,
"kind": "msg",
"jp": [
"「7時過ぎくれえから",
"しばらくいたって話でしたか」"
]
},
{
"id": 5503,
"kind": "msg",
"jp": [
"「部屋に戻っていく那須さんに",
"会ってるよね、そこで」"
]
},
{
"id": 5504,
"kind": "msg",
"jp": [
"「ええ、7時半頃",
"那須さんが戻ってきたって",
"言ってたはずです」"
]
},
{
"id": 5505,
"kind": "msg",
"jp": [
"「静奈ちゃん達が2階に",
"戻ったのって何時頃だっけ」"
]
},
{
"id": 5506,
"kind": "msg",
"jp": [
"「6時40分は過ぎてたって",
"話だったと思いますぜ」"
]
},
{
"id": 5507,
"kind": "msg",
"jp": [
"「鈴奈さんはその後",
"7時過ぎまで静奈さんの部屋に",
"いたそうですが」"
]
},
{
"id": 5508,
"kind": "msg",
"jp": [
"「その後、廊下で",
"暗石さんに会ったんだな」"
]
},
{
"id": 5509,
"kind": "msg",
"jp": [
"「椿くんは7時過ぎまで",
"僕らと一緒に娯楽室に",
"いたしな・・・」"
]
},
{
"id": 5510,
"kind": "msg",
"jp": [
"「部屋に戻るところは",
"静奈さんが見かけてましたね」"
]
},
{
"id": 5511,
"kind": "msg",
"jp": [
"「・・・じゃあ、",
"また考えて整理してみるよ」"
]
},
{
"id": 5512,
"kind": "msg",
"jp": [
"「わかんなくなったらまた",
"聞きに来て下さいね」"
]
},
{
"id": 5513,
"kind": "msg",
"jp": [
"「うん、ありがと。",
"それじゃあまた後で」"
]
},
{
"id": 5514,
"kind": "msg",
"jp": [
"「ええ、気をつけて」"
]
},
{
"id": 5515,
"kind": "msg",
"jp": [
"ここにいても仕方ないし、",
"どこか出ようかな・・・。"
]
},
{
"id": 5516,
"kind": "msg",
"jp": [
"（ちょうどいいから、",
"このまま娯楽室に行こう・・・）"
]
},
{
"id": 5517,
"kind": "msg",
"jp": [
"「あら・・・",
"そろそろ1階に",
"降りてみた方がいいかしら」"
]
},
{
"id": 5518,
"kind": "msg",
"jp": [
"娯楽室に来て、ラジオをつけてみる。",
"相変わらずノイズが酷くて、あまり",
"よく聞こえない。"
]
},
{
"id": 5519,
"kind": "msg",
"jp": [
"「・・・あの子、効き目ないね」"
]
},
{
"id": 5520,
"kind": "msg",
"jp": [
"あの子・・・。",
"最初の夜に、那須さんが吊した",
"てるてる坊主の事だろう。"
]
},
{
"id": 5521,
"kind": "msg",
"jp": [
"・・・もう効かないのかも。",
"作ってくれた本人がもういなくなって",
"しまったんだから。"
]
},
{
"id": 5522,
"kind": "msg",
"jp": [
"（でも、せめて・・・）"
]
},
{
"id": 5523,
"kind": "msg",
"jp": [
"僕らが山を降りられるようになったら",
"一緒につれてってやりたいけど。"
]
},
{
"id": 5524,
"kind": "msg",
"jp": [
"誰に返せばいいんだろう・・・。"
]
},
{
"id": 5525,
"kind": "msg",
"jp": [
"「あ・・・え?」"
]
},
{
"id": 5526,
"kind": "msg",
"jp": [
"「どうしました?",
"ぼーっとして」"
]
},
{
"id": 5527,
"kind": "msg",
"jp": [
"「いや・・・",
"あいつ、どうすればいいのかな」"
]
},
{
"id": 5528,
"kind": "msg",
"jp": [
"「あいつ?」"
]
},
{
"id": 5529,
"kind": "msg",
"jp": [
"「てるてる坊主」"
]
},
{
"id": 5530,
"kind": "msg",
"jp": [
"「居間の・・・",
"テラスにいるやつ」"
]
},
{
"id": 5531,
"kind": "msg",
"jp": [
"「・・・・どうすれば、って」"
]
},
{
"id": 5532,
"kind": "msg",
"jp": [
"「那須さんのタオルだよね。",
"置いてっちゃダメだと思うんだけど」"
]
},
{
"id": 5533,
"kind": "msg",
"jp": [
"「持ってって、那須さんの",
"事務所の人とかに",
"渡せばいいのかな・・・」"
]
},
{
"id": 5534,
"kind": "msg",
"jp": [
"「それとも、警察の人が来るまで",
"あそこに置いといた方がいいのかな」"
]
},
{
"id": 5535,
"kind": "msg",
"jp": [
"「・・・警察に、何て言って",
"見せるんですかい」"
]
},
{
"id": 5536,
"kind": "msg",
"jp": [
"「え? えーと・・・・」"
]
},
{
"id": 5537,
"kind": "msg",
"jp": [
"「・・・・ごめん。",
"何言ってるんだろう、僕・・・」"
]
},
{
"id": 5538,
"kind": "msg",
"jp": [
"「はいはい、大丈夫ですよ。",
"ちょっと気になったんでしょ」"
]
},
{
"id": 5539,
"kind": "msg",
"jp": [
"「うん、なんか急に・・・」"
]
},
{
"id": 5540,
"kind": "msg",
"jp": [
"「持って帰る人、いなくなっちゃって",
"どうするんだろうって・・・」"
]
},
{
"id": 5541,
"kind": "msg",
"jp": [
"「気になるんなら、",
"俺が持ってって那須さんの",
"事務所の人にでも渡しときますよ」"
]
},
{
"id": 5542,
"kind": "msg",
"jp": [
"・・・本当に、何言ってるんだろう。",
"なんで突然てるてる坊主の心配なんか。"
]
},
{
"id": 5543,
"kind": "msg",
"jp": [
"「あ・・・",
"こんばんは、みなさん・・・」"
]
},
{
"id": 5544,
"kind": "msg",
"jp": [
"「こんばんは。",
"お加減どうです?」"
]
},
{
"id": 5545,
"kind": "msg",
"jp": [
"「ええ、少し落ち着きました。",
"あの・・・天気は・・・」"
]
},
{
"id": 5546,
"kind": "msg",
"jp": [
"「残念ながら、あまり回復して",
"くれそうにありませんや」"
]
},
{
"id": 5547,
"kind": "msg",
"jp": [
"「・・・そうですか・・・」"
]
},
{
"id": 5548,
"kind": "msg",
"jp": [
"そうか・・・。",
"那須さんがあんな亡くなり方を",
"したから・・・。"
]
},
{
"id": 5549,
"kind": "msg",
"jp": [
"・・・普通に話してるような",
"口調だったのに・・・。"
]
},
{
"id": 5550,
"kind": "msg",
"jp": [
"（もう・・・誰も・・・）"
]
},
{
"id": 5551,
"kind": "msg",
"jp": [
"（誰も、お互いを",
"信じてないんだな・・・）"
]
},
{
"id": 5552,
"kind": "msg",
"jp": [
"娯楽室に来てラジオをつけてみる。",
"相変わらずノイズが酷くて、",
"あまりよく聞こえない。"
]
},
{
"id": 5553,
"kind": "msg",
"jp": [
"「ほんまなん!?」"
]
},
{
"id": 5554,
"kind": "msg",
"jp": [
"「ひ、人だったよ・・・。",
"男の人で・・・で、でも・・・」"
]
},
{
"id": 5555,
"kind": "msg",
"jp": [
"「・・・しょうがねえな。",
"ぶっ倒れねえで下さいよ?」"
]
},
{
"id": 5556,
"kind": "msg",
"jp": [
"静奈ちゃんは日織の差し出した携帯を",
"さしてためらいもせず受け取る。"
]
},
{
"id": 5557,
"kind": "msg",
"jp": [
"「だ、大丈夫?",
"お姉ちゃん・・・」"
]
},
{
"id": 5558,
"kind": "msg",
"jp": [
"「・・・・・・無理」"
]
},
{
"id": 5559,
"kind": "msg",
"jp": [
"「鈴は、見ん方がええと思う」"
]
},
{
"id": 5560,
"kind": "msg",
"jp": [
"「・・・う、うん」"
]
},
{
"id": 5561,
"kind": "msg",
"jp": [
"「あ・・あの・・・",
"それじゃあ、私は・・・」"
]
},
{
"id": 5562,
"kind": "msg",
"jp": [
"「やめた方が」"
]
},
{
"id": 5563,
"kind": "msg",
"jp": [
"「俺もそう思いますぜ」"
]
},
{
"id": 5564,
"kind": "msg",
"jp": [
"「・・・そうですか。",
"なら・・・遠慮しておきます」"
]
},
{
"id": 5565,
"kind": "msg",
"jp": [
"「多分、誰が見てもほとんど",
"誰なんかわからへんと思う」"
]
},
{
"id": 5566,
"kind": "msg",
"jp": [
"「でしょう。",
"少なくとも俺には知り合いだった",
"としてもわかるかどうか・・・」"
]
},
{
"id": 5567,
"kind": "msg",
"jp": [
"「うん、うちも」"
]
},
{
"id": 5568,
"kind": "msg",
"jp": [
"「・・・はい、お兄さん」"
]
},
{
"id": 5569,
"kind": "msg",
"jp": [
"差し出された携帯を受け取って、",
"とっとと懐にしまう。"
]
},
{
"id": 5570,
"kind": "msg",
"jp": [
"「・・・お兄さん、よぉ気絶して",
"井戸に落ちんかったね・・・」"
]
},
{
"id": 5571,
"kind": "msg",
"jp": [
"「怖いこと言わないで・・・」"
]
},
{
"id": 5572,
"kind": "msg",
"jp": [
"気絶はしなかったけどパニックに",
"なって滑り落ちかけただけに・・・。"
]
},
{
"id": 5573,
"kind": "msg",
"jp": [
"落ちてたら間違いなく気絶してた",
"だろうけどな。"
]
},
{
"id": 5574,
"kind": "msg",
"jp": [
"「・・・けど」"
]
},
{
"id": 5575,
"kind": "msg",
"jp": [
"「その人、いつから",
"井戸におったんやろう」"
]
},
{
"id": 5576,
"kind": "msg",
"jp": [
"「え? さ、さあ・・・」"
]
},
{
"id": 5577,
"kind": "msg",
"jp": [
"「状態が状態ですからねえ、",
"日にちを特定するのは",
"難しいと思いますぜ」"
]
},
{
"id": 5578,
"kind": "msg",
"jp": [
"「ただ、いくら前でも",
"数日以内だろうとは思いますが」"
]
},
{
"id": 5579,
"kind": "msg",
"jp": [
"「数日・・・ってことは、",
"うちらが来てからってこと?」"
]
},
{
"id": 5580,
"kind": "msg",
"jp": [
"「来てからか、来る直前か、",
"それくらいじゃねえかな」"
]
},
{
"id": 5581,
"kind": "msg",
"jp": [
"「体型は違うよね」"
]
},
{
"id": 5582,
"kind": "msg",
"jp": [
"「体型? 誰と?」"
]
},
{
"id": 5583,
"kind": "msg",
"jp": [
"「暗石さんとか」"
]
},
{
"id": 5584,
"kind": "msg",
"jp": [
"「だって、あのおっちゃん",
"ずっと部屋にこもってるから知らん間に",
"井戸に落ちててもわからへん」"
]
},
{
"id": 5585,
"kind": "msg",
"jp": [
"「そやけど・・・」"
]
},
{
"id": 5586,
"kind": "msg",
"jp": [
"「うん、髪型も{違/ちご}たと思う」"
]
},
{
"id": 5587,
"kind": "msg",
"jp": [
"「あ、そ、そうやん!",
"誰かおったやん、駐車場で",
"パンクさせたりした人が!」"
]
},
{
"id": 5588,
"kind": "msg",
"jp": [
"「それが、この人やったら",
"やっぱり1人足りへん」"
]
},
{
"id": 5589,
"kind": "msg",
"jp": [
"「どっちにしろ、",
"この人を井戸の中に",
"投げ込んだ犯人がいりますね」"
]
}
]