[
{
"id": 5071,
"kind": "msg",
"jp": [
"・・・いくら広いからって",
"何をしてるんだか。"
]
},
{
"id": 5072,
"kind": "msg",
"jp": [
"「それじゃ、なるべく",
"部屋にいるようにするよ」"
]
},
{
"id": 5073,
"kind": "msg",
"jp": [
"「すみませんねえ。",
"何かあったらすぐ報告しますんで」"
]
},
{
"id": 5074,
"kind": "msg",
"jp": [
"「うん、頼むよ」"
]
},
{
"id": 5075,
"kind": "msg",
"jp": [
"「食料庫から適当にいろいろ",
"持ってっていいかな?」"
]
},
{
"id": 5076,
"kind": "msg",
"jp": [
"「あ、あの、開封されてない",
"物にして下さいね」"
]
},
{
"id": 5077,
"kind": "msg",
"jp": [
"「見つくろいましょう。",
"一緒に行きますから」"
]
},
{
"id": 5078,
"kind": "msg",
"jp": [
"「そうしよう・・・」"
]
},
{
"id": 5079,
"kind": "msg",
"jp": [
"那須さんに任せるのは",
"ものすごく不安だ・・・。"
]
},
{
"id": 5080,
"kind": "msg",
"jp": [
"「今日の晩飯は",
"何か作りますから」"
]
},
{
"id": 5081,
"kind": "msg",
"jp": [
"「そうかい?",
"ありがとう」"
]
},
{
"id": 5082,
"kind": "msg",
"jp": [
"「{和/なご}さん、なんか適当に",
"保存食見つくろって下さい」"
]
},
{
"id": 5083,
"kind": "msg",
"jp": [
"「うん。",
"えーと、これとか・・・」"
]
},
{
"id": 5084,
"kind": "msg",
"jp": [
"「これも大丈夫?",
"開いてないよ」"
]
},
{
"id": 5085,
"kind": "msg",
"jp": [
"「開いてませんけど、",
"生のタマネギそのまんま",
"食べるんですか・・・?」"
]
},
{
"id": 5086,
"kind": "msg",
"jp": [
"「ドレッシングも",
"もらっていい?」"
]
},
{
"id": 5087,
"kind": "msg",
"jp": [
"「・・・こっちに",
"まだ開けてないのがあります」"
]
},
{
"id": 5088,
"kind": "msg",
"jp": [
"「お、ありがとう」"
]
},
{
"id": 5089,
"kind": "msg",
"jp": [
"・・・どこまでも",
"ワイルドな人だな・・・。"
]
},
{
"id": 5090,
"kind": "msg",
"jp": [
"「晩飯の方は冷凍のピラフとかで",
"いいですかね?」"
]
},
{
"id": 5091,
"kind": "msg",
"jp": [
"「うん、いいよ」"
]
},
{
"id": 5092,
"kind": "msg",
"jp": [
"日織は適当な冷凍食品に開封されて",
"いなかった食材を入れて具を増やした",
"食事を作ってくれた。"
]
},
{
"id": 5093,
"kind": "msg",
"jp": [
"「器用だなー」"
]
},
{
"id": 5094,
"kind": "msg",
"jp": [
"「火に掛けただけじゃ",
"ねえですか」"
]
},
{
"id": 5095,
"kind": "msg",
"jp": [
"「だってさあ、料理って",
"やったことないと本当に",
"わけわかんないよ」"
]
},
{
"id": 5096,
"kind": "msg",
"jp": [
"「まず、何から手をつけて",
"いいのかがわからないし」"
]
},
{
"id": 5097,
"kind": "msg",
"jp": [
"「適当に切って鍋に放り込んで",
"なんとなく煮れば、大抵のものは",
"料理っぽくなるよ」"
]
},
{
"id": 5098,
"kind": "msg",
"jp": [
"「あの、なんとなく煮るって",
"状態がよくわかんないんですけど」"
]
},
{
"id": 5099,
"kind": "msg",
"jp": [
"「いや、{和/なご}さん。",
"こればっかりは那須さんが",
"けっこう正しいですぜ」"
]
},
{
"id": 5100,
"kind": "msg",
"jp": [
"「そうなの!?」"
]
},
{
"id": 5101,
"kind": "msg",
"jp": [
"「そんなもんです」"
]
},
{
"id": 5102,
"kind": "msg",
"jp": [
"「そうそう、難しく考える",
"ことなんかないって」"
]
},
{
"id": 5103,
"kind": "msg",
"jp": [
"「たまに、一緒に煮込むと",
"すごい味になるものがあるけど」"
]
},
{
"id": 5104,
"kind": "msg",
"jp": [
"「・・・それは、煮る前に",
"見てわかりませんか」"
]
},
{
"id": 5105,
"kind": "msg",
"jp": [
"「もしかしたら、おいしいかも",
"しれないなーと思ってさあ」"
]
},
{
"id": 5106,
"kind": "msg",
"jp": [
"「すいません、やっぱ",
"{和/なご}さんは真似しねえ方が",
"いいかもしれません」"
]
},
{
"id": 5107,
"kind": "msg",
"jp": [
"「そうする・・・」"
]
},
{
"id": 5108,
"kind": "msg",
"jp": [
"那須さんなら、その程度で",
"お腹壊しそうにもないけど、",
"僕はひどい目に遭いそうだ・・・。"
]
},
{
"id": 5109,
"kind": "msg",
"jp": [
"「それじゃ、ぼくは",
"トレーニングがあるから",
"先に戻るねー」"
]
},
{
"id": 5110,
"kind": "msg",
"jp": [
"「はい・・・って",
"那須さん晩ご飯は!?」"
]
},
{
"id": 5111,
"kind": "msg",
"jp": [
"「今日の晩飯は持ってって",
"くれてよかったんですがねえ」"
]
},
{
"id": 5112,
"kind": "msg",
"jp": [
"「あ、そうだ。",
"借りた食器、部屋に置いた",
"ままだったんだ」"
]
},
{
"id": 5113,
"kind": "msg",
"jp": [
"「ちょっと取って来るよ。",
"先に行ってて」"
]
},
{
"id": 5114,
"kind": "msg",
"jp": [
"「・・・そう言えば那須さん",
"相変わらず鍵掛けてないんじゃ",
"ないかなあ・・・」"
]
},
{
"id": 5115,
"kind": "msg",
"jp": [
"「しょうがねえなあ。",
"もう一度念押しといた方が",
"いいんじゃねえですかい」"
]
},
{
"id": 5116,
"kind": "msg",
"jp": [
"「うん、そ・・・・」"
]
},
{
"id": 5117,
"kind": "msg",
"jp": [
"「何か壊れた・・!?」"
]
},
{
"id": 5118,
"kind": "msg",
"jp": [
"「うわああああああっ!?」"
]
},
{
"id": 5119,
"kind": "msg",
"jp": [
"「{和/なご}さんっ!!」"
]
},
{
"id": 5120,
"kind": "msg",
"jp": [
"「やあ、お待たせ!」"
]
},
{
"id": 5121,
"kind": "msg",
"jp": [
"「な、ななっ、な、すさ」"
]
},
{
"id": 5122,
"kind": "msg",
"jp": [
"「あれ、そんなに驚いた?」"
]
},
{
"id": 5123,
"kind": "msg",
"jp": [
"「おっ、おどおっ、だって、",
"降っ、降って、来っ・・・」"
]
},
{
"id": 5124,
"kind": "msg",
"jp": [
"「はいはい、",
"{和/なご}さんは落ち着いて」"
]
},
{
"id": 5125,
"kind": "msg",
"jp": [
"「驚くに決まってまさぁね、",
"まったく那須さんは・・・」"
]
},
{
"id": 5126,
"kind": "msg",
"jp": [
"「いや、昨日は何があったのか",
"わからなくて怖がってたみたい",
"だったからさあ」"
]
},
{
"id": 5127,
"kind": "msg",
"jp": [
"「昨日のあれも降ってきた",
"音だったんですかっ!?」"
]
},
{
"id": 5128,
"kind": "msg",
"jp": [
"「うん。",
"だって階段降りるより",
"早そうだからさ」"
]
},
{
"id": 5129,
"kind": "msg",
"jp": [
"「だからって試さねえで",
"下さいな・・・」"
]
},
{
"id": 5130,
"kind": "msg",
"jp": [
"「さっきの変な音は",
"なんです?」"
]
},
{
"id": 5131,
"kind": "msg",
"jp": [
"「あ、ごめん。",
"ちょっと飛びすぎちゃって",
"シャンデリアにぶら下がった音だ」"
]
},
{
"id": 5132,
"kind": "msg",
"jp": [
"「大丈夫だよ、",
"落ちては来なかったし」"
]
},
{
"id": 5133,
"kind": "msg",
"jp": [
"「館壊さねえで下さいよ・・・」"
]
},
{
"id": 5134,
"kind": "msg",
"jp": [
"「・・・家と戦ってみた",
"ことないなあ・・・」"
]
},
{
"id": 5135,
"kind": "msg",
"jp": [
"「戦わないで下さいっ!!」"
]
},
{
"id": 5136,
"kind": "msg",
"jp": [
"「まあ、見立て殺人も何も",
"あったもんじゃなくなる",
"でしょうけどねえ」"
]
},
{
"id": 5137,
"kind": "msg",
"jp": [
"「間違ってる!",
"その解決方法、",
"絶対間違ってるから!」"
]
},
{
"id": 5138,
"kind": "msg",
"jp": [
"「あはは、さすがに",
"壊したりしないって。",
"雨降ってるしね」"
]
},
{
"id": 5139,
"kind": "msg",
"jp": [
"「・・・雨以外に何かこう",
"もっと根本的に駄目だろうって",
"思う理由ないんですか・・・」"
]
},
{
"id": 5140,
"kind": "msg",
"jp": [
"「もうこの人にそういう",
"普通のこと求めちゃ駄目ですって」"
]
},
{
"id": 5141,
"kind": "msg",
"jp": [
"「那須さん、とりあえず",
"急いでても階段使って下さいや。",
"心臓に悪ぃから」"
]
},
{
"id": 5142,
"kind": "msg",
"jp": [
"「うん、わかった。",
"そうするよ」"
]
},
{
"id": 5143,
"kind": "msg",
"jp": [
"「さーて、腹減ったし",
"台所に行こうか」"
]
},
{
"id": 5144,
"kind": "msg",
"jp": [
"「・・・はい・・・」"
]
},
{
"id": 5145,
"kind": "msg",
"jp": [
"「やれやれ・・・」"
]
},
{
"id": 5146,
"kind": "msg",
"jp": [
"「・・・・・・・?」"
]
},
{
"id": 5147,
"kind": "msg",
"jp": [
"突然響いてきた妙な物音で",
"目が覚めた。"
]
},
{
"id": 5148,
"kind": "msg",
"jp": [
"「な、何の音・・・?」"
]
},
{
"id": 5149,
"kind": "msg",
"jp": [
"起きあがってみると、",
"隣のベッドで日織も半身を起こして",
"{怪訝/けげん}な顔をしていた。"
]
},
{
"id": 5150,
"kind": "msg",
"jp": [
"「まだ夜中、だよね・・・?」"
]
},
{
"id": 5151,
"kind": "msg",
"jp": [
"「ええ、そうなんですが。",
"何かあったんですかね・・・」"
]
},
{
"id": 5152,
"kind": "msg",
"jp": [
"「こりゃあ・・・",
"ちょいとただ事じゃねえかも",
"しれませんね・・・」"
]
},
{
"id": 5153,
"kind": "msg",
"jp": [
"「・・見てきましょう」"
]
},
{
"id": 5154,
"kind": "msg",
"jp": [
"「ま、待って!",
"僕も行く!」"
]
},
{
"id": 5155,
"kind": "msg",
"jp": [
"あたふたとベッドから這い出して、",
"眼鏡を掛ける。"
]
},
{
"id": 5156,
"kind": "msg",
"jp": [
"「何があったんだろう?」"
]
},
{
"id": 5157,
"kind": "msg",
"jp": [
"「わかりませんけど・・・",
"あの変な物音はどうやら",
"那須さんの部屋からですぜ」"
]
},
{
"id": 5158,
"kind": "msg",
"jp": [
"「那須さんの部屋?」"
]
},
{
"id": 5159,
"kind": "msg",
"jp": [
"那須さんの部屋の方を見てみるが、",
"もう妙な音はしなかった。"
]
},
{
"id": 5160,
"kind": "msg",
"jp": [
"「・・・声掛けてみましょうか」"
]
},
{
"id": 5161,
"kind": "msg",
"jp": [
"日織が扉の前に近づいて、",
"声を掛けながらノックする。"
]
},
{
"id": 5162,
"kind": "msg",
"jp": [
"「那須さん?",
"どうかしたんですかい?」"
]
},
{
"id": 5163,
"kind": "msg",
"jp": [
"「・・・那須さーん?」"
]
},
{
"id": 5164,
"kind": "msg",
"jp": [
"「おかしいですね。",
"那須さん、すいませーん」"
]
},
{
"id": 5165,
"kind": "msg",
"jp": [
"「寝てる、のかな・・・?」"
]
},
{
"id": 5166,
"kind": "msg",
"jp": [
"「けど、さっき確かに那須さんの",
"部屋からすごい音がしましたぜ」"
]
},
{
"id": 5167,
"kind": "msg",
"jp": [
"「俺が廊下に出てきてからも",
"何度か聞こえましたから、",
"間違いねえと思うんですが」"
]
},
{
"id": 5168,
"kind": "msg",
"jp": [
"「じゃ、じゃあ・・・",
"何かあったってこと?」"
]
},
{
"id": 5169,
"kind": "msg",
"jp": [
"「わかりませんが、",
"何かヤな予感がしますね」"
]
},
{
"id": 5170,
"kind": "msg",
"jp": [
"「那須さん、すいませんが",
"開けますぜ?」"
]
},
{
"id": 5171,
"kind": "msg",
"jp": [
"断ってから開こうとしてみたが",
"開かないようだった。"
]
},
{
"id": 5172,
"kind": "msg",
"jp": [
"「さすがに鍵掛かってますね。",
"合鍵、娯楽室にありましたっけ」"
]
},
{
"id": 5173,
"kind": "msg",
"jp": [
"「那須さんは、自分で持ってって",
"なかったはずだから、あると思うよ」"
]
},
{
"id": 5174,
"kind": "msg",
"jp": [
"「じゃあ、ちょいと取ってきます。",
"{和/なご}さんはここにいて下さい」"
]
},
{
"id": 5175,
"kind": "msg",
"jp": [
"「は、早くね!?」"
]
},
{
"id": 5176,
"kind": "msg",
"jp": [
"日織は足早に1階へと降りて行った。",
"ぽつん、と暗い廊下に残される。"
]
},
{
"id": 5177,
"kind": "msg",
"jp": [
"（だ・・誰も来ませんように・・・）"
]
},
{
"id": 5178,
"kind": "msg",
"jp": [
"「・・・何かあったん?」"
]
},
{
"id": 5179,
"kind": "msg",
"jp": [
"「うわああっ!?」"
]
},
{
"id": 5180,
"kind": "msg",
"jp": [
"飛び上がりそうになって振り向くと、",
"同じくらい驚いた顔をした鈴奈ちゃんと",
"御陵さんが立っていた。"
]
},
{
"id": 5181,
"kind": "msg",
"jp": [
"声を掛けてきたのは静奈ちゃんだった",
"ようだが、彼女はいつもの眠そうな顔で",
"那須さんの部屋をじっと見ている。"
]
},
{
"id": 5182,
"kind": "msg",
"jp": [
"「びっくりした・・・。",
"お兄さん、そない驚かんでも」"
]
},
{
"id": 5183,
"kind": "msg",
"jp": [
"「ご、ご、ごめん・・・」"
]
},
{
"id": 5184,
"kind": "msg",
"jp": [
"「あの、また何かあったんですの?」"
]
},
{
"id": 5185,
"kind": "msg",
"jp": [
"「いや、それがわからないんです。",
"変な音がしたんですけど」"
]
},
{
"id": 5186,
"kind": "msg",
"jp": [
"「・・・那須さん、",
"出て来んさらんね」"
]
},
{
"id": 5187,
"kind": "msg",
"jp": [
"やっぱり変だよな。",
"これだけ廊下で騒いでたら、",
"真っ先に飛び出してきそうな人なのに。"
]
},
{
"id": 5188,
"kind": "msg",
"jp": [
"「{和/なご}さん!?",
"さっきの悲鳴は・・・ああ、なんだ」"
]
},
{
"id": 5189,
"kind": "msg",
"jp": [
"「・・・脅かしてもた」"
]
},
{
"id": 5190,
"kind": "msg",
"jp": [
"「いや、あの、ごめん」"
]
},
{
"id": 5191,
"kind": "msg",
"jp": [
"「はいはい、驚いただけですね。",
"すいませんね、ちょいと失礼しますよ」"
]
},
{
"id": 5192,
"kind": "msg",
"jp": [
"何があったのかすぐ察したらしく、",
"日織は苦笑しながら那須さんの部屋の",
"扉に合鍵を差し込む。"
]
},
{
"id": 5193,
"kind": "msg",
"jp": [
"「呼んでも返事ないのん?」"
]
},
{
"id": 5194,
"kind": "msg",
"jp": [
"「うん、なかった・・・」"
]
},
{
"id": 5195,
"kind": "msg",
"jp": [
"「よく寝てらっしゃる",
"だけなんじゃありません?」"
]
},
{
"id": 5196,
"kind": "msg",
"jp": [
"「だったらいいんですがね。",
"那須さん、失礼します・・・」"
]
},
{
"id": 5197,
"kind": "msg",
"jp": [
"扉を開けると、隙間から明かりが",
"漏れてきた。",
"室内の電気はついたままだったようだ。"
]
},
{
"id": 5198,
"kind": "msg",
"jp": [
"「・・・・・日織?」"
]
},
{
"id": 5199,
"kind": "msg",
"jp": [
"開いた扉の前で、日織が立ちすくむ。",
"その肩越しに見える室内には・・・"
]
},
{
"id": 5200,
"kind": "msg",
"jp": [
"「な・・・那須さん・・・?」"
]
},
{
"id": 5201,
"kind": "msg",
"jp": [
"「きゃあっ・・・!!」"
]
},
{
"id": 5202,
"kind": "msg",
"jp": [
"背後で御陵さんが悲鳴を上げる。",
"たたらを踏むように後ずさる足音。"
]
},
{
"id": 5203,
"kind": "msg",
"jp": [
"「なに・・・これ・・・」"
]
},
{
"id": 5204,
"kind": "msg",
"jp": [
"こぼれた何かが滲んだ絨毯の上に、",
"那須さんが倒れ込んでいる。"
]
},
{
"id": 5205,
"kind": "msg",
"jp": [
"目は開いているのに、なぜかどこも",
"見ていないようだった。"
]
},
{
