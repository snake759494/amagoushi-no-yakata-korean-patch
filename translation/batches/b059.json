[
{
"id": 29529,
"kind": "msg",
"jp": [
"「ええ、すみませんね。",
"机の下に落ちてました」"
]
},
{
"id": 29530,
"kind": "msg",
"jp": [
"「はい、これです」"
]
},
{
"id": 29531,
"kind": "msg",
"jp": [
"日織に渡された館の見取り図を",
"開いてみてみる。"
]
},
{
"id": 29532,
"kind": "msg",
"jp": [
"「全部の部屋に名前がついてるんだ」"
]
},
{
"id": 29533,
"kind": "msg",
"jp": [
"「ええ、そうらしいです。",
"この書斎は<co 0f0>『ノックス』<co>ですね」"
]
},
{
"id": 29534,
"kind": "msg",
"jp": [
"「僕らが夕べ泊まった部屋が",
"<co 0f0>『ミルン』<co>か。",
"全部人名だよね」"
]
},
{
"id": 29535,
"kind": "msg",
"jp": [
"「全部、作家の名前ですぜ。",
"推理小説書いてる人ばっかり」"
]
},
{
"id": 29536,
"kind": "msg",
"jp": [
"「古いのから比較的最近のまで",
"混じってるから、今の持ち主か誰かが",
"最近になって付けたんでしょうね」"
]
},
{
"id": 29537,
"kind": "msg",
"jp": [
"「ふーん・・・。",
"覚えるの大変そうだな、これ」"
]
},
{
"id": 29538,
"kind": "msg",
"jp": [
"「まあ、どっか行くときは広げて",
"確認してみりゃ迷わないでしょう」"
]
},
{
"id": 29539,
"kind": "msg",
"jp": [
"「そうだね、そうするよ」"
]
},
{
"id": 29540,
"kind": "msg",
"jp": [
"「朝飯、まだ早いなら",
"しばらくうろついて来ますかい?」"
]
},
{
"id": 29541,
"kind": "msg",
"jp": [
"「勝手に歩き回ってても",
"いいのかな」"
]
},
{
"id": 29542,
"kind": "msg",
"jp": [
"「椿さんは物壊さねえ限りは",
"好きにやってくれって言って",
"ましたから大丈夫でしょう」"
]
},
{
"id": 29543,
"kind": "msg",
"jp": [
"「他の人達も、",
"もう起きてるでしょうしね」"
]
},
{
"id": 29544,
"kind": "msg",
"jp": [
"「じゃあ、そうしようかな。",
"日織はここにいる?」"
]
},
{
"id": 29545,
"kind": "msg",
"jp": [
"「ええ、実はここの蔵書かなりの",
"もんなんで稽古の時間以外はほとんど",
"入り浸ってまして」"
]
},
{
"id": 29546,
"kind": "msg",
"jp": [
"「あはは、いくらでも読むもの",
"ありそうだもんね」"
]
},
{
"id": 29547,
"kind": "msg",
"jp": [
"「そうなんですよねえ。",
"堅い本が多いのかと思ったら",
"なんか妙なのも混じってるし」"
]
},
{
"id": 29548,
"kind": "msg",
"jp": [
"「妙なの?」"
]
},
{
"id": 29549,
"kind": "msg",
"jp": [
"「ゴシップ雑誌みてえなのやら",
"怪しげな専門誌やら色々ね」"
]
},
{
"id": 29550,
"kind": "msg",
"jp": [
"「まあ、30分ほどしたら",
"居間に顔出しますから」"
]
},
{
"id": 29551,
"kind": "msg",
"jp": [
"「うん、わかった。",
"僕もそれくらいしたら居間に行くよ」"
]
},
{
"id": 29552,
"kind": "msg",
"jp": [
"「はい、それじゃ",
"お気をつけて」"
]
},
{
"id": 29553,
"kind": "msg",
"jp": [
"「また後でね」"
]
},
{
"id": 29554,
"kind": "msg",
"jp": [
"（また後で本も見に来よう）"
]
},
{
"id": 29555,
"kind": "msg",
"jp": [
"（どこに行ってみようかな・・）"
]
},
{
"id": 29556,
"kind": "msg",
"jp": [
"30分くらいだから、全部の部屋を",
"のんびり見て回るってほどの時間は",
"さすがにないな。"
]
},
{
"id": 29557,
"kind": "msg",
"jp": [
"（さっきは日織がいたけど",
"今度は声掛けてくれる人も",
"いないから・・・）"
]
},
{
"id": 29558,
"kind": "msg",
"jp": [
"切り上げるときは、",
"自分で見切りつけないと。"
]
},
{
"id": 29559,
"kind": "msg",
"jp": [
"（・・・えーと、",
"見取り図開いて見て決めるか）"
]
},
{
"id": 29560,
"kind": "msg",
"jp": [
"書斎だ。"
]
},
{
"id": 29561,
"kind": "msg",
"jp": [
"「お邪魔しまーす」"
]
},
{
"id": 29562,
"kind": "msg",
"jp": [
"椅子で本を読んでいる日織に",
"手を振って応えながら書斎へ入る。"
]
},
{
"id": 29563,
"kind": "msg",
"jp": [
"「・・・そりゃないだろう!」"
]
},
{
"id": 29564,
"kind": "msg",
"jp": [
"（へ・・・?）"
]
},
{
"id": 29565,
"kind": "msg",
"jp": [
"「涼介、どうして君はいつも",
"最後まで何も教えてくれないんだ?」"
]
},
{
"id": 29566,
"kind": "msg",
"jp": [
"「・・・いや、わからないよ。",
"同じ手がかりを見てるといわれても",
"僕にはさっぱり・・・」"
]
},
{
"id": 29567,
"kind": "msg",
"jp": [
"「・・・ありゃ、{和/なご}さん」"
]
},
{
"id": 29568,
"kind": "msg",
"jp": [
"「すいません、ちょっと",
"やってみたかったんです」"
]
},
{
"id": 29569,
"kind": "msg",
"jp": [
"「・・・すごいね。",
"ほんとに別人みたいになるよね」"
]
},
{
"id": 29570,
"kind": "msg",
"jp": [
"「そうですかい?",
"けどやっぱ、現代劇はちょいと",
"苦手ですねえ」"
]
},
{
"id": 29571,
"kind": "msg",
"jp": [
"そうなのか・・・。",
"十分上手いと思ったけどなぁ。"
]
},
{
"id": 29572,
"kind": "msg",
"jp": [
"（・・・・・あれ）"
]
},
{
"id": 29573,
"kind": "msg",
"jp": [
"書斎に戻ってくると、日織が椅子に",
"座ったまま居眠りしていた。"
]
},
{
"id": 29574,
"kind": "msg",
"jp": [
"（日織も疲れてるんだなぁ・・・）"
]
},
{
"id": 29575,
"kind": "msg",
"jp": [
"（起こさないように、",
"そーっと・・・）"
]
},
{
"id": 29576,
"kind": "msg",
"jp": [
"後ろ手に扉を閉めて、",
"本棚の方へ近寄って行く。"
]
},
{
"id": 29577,
"kind": "msg",
"jp": [
"「・・・・・うわ!」"
]
},
{
"id": 29578,
"kind": "msg",
"jp": [
"「へっ!?",
"な、{和/なご}さん!?」"
]
},
{
"id": 29579,
"kind": "msg",
"jp": [
"「いっ・・・痛・・・」"
]
},
{
"id": 29580,
"kind": "msg",
"jp": [
"「ご、ごめん、起こしちゃった」"
]
},
{
"id": 29581,
"kind": "msg",
"jp": [
"「いや、んなこと別に",
"どうでもいいんですが・・・」"
]
},
{
"id": 29582,
"kind": "msg",
"jp": [
"「どうしたんです、いきなり",
"そんなとこに転がって」"
]
},
{
"id": 29583,
"kind": "msg",
"jp": [
"「え、えーと・・・",
"そーっと歩こうとしたら緊張して",
"足が・・・もつれた・・・」"
]
},
{
"id": 29584,
"kind": "msg",
"jp": [
"「・・・おもしれえ人だなぁ」"
]
},
{
"id": 29585,
"kind": "msg",
"jp": [
"「笑うなよぉっ!」"
]
},
{
"id": 29586,
"kind": "msg",
"jp": [
"「しかし普通、こんな何もない",
"とこで転びますかね」"
]
},
{
"id": 29587,
"kind": "msg",
"jp": [
"「ねんざとかしてねえでしょうね?",
"どこも痛くねえですかい?」"
]
},
{
"id": 29588,
"kind": "msg",
"jp": [
"「う、うん、大丈夫」"
]
},
{
"id": 29589,
"kind": "msg",
"jp": [
"・・・なんでこう間抜けなことに",
"なるんだろう、僕は・・・。"
]
},
{
"id": 29590,
"kind": "msg",
"jp": [
"「それならいいんですがね。",
"あー、どこまで読んだっけな・・・」"
]
},
{
"id": 29591,
"kind": "msg",
"jp": [
"日織はソファに戻り、寝てる間に",
"ページがわからなくなったらしい",
"読みかけの本をめくる。"
]
},
{
"id": 29592,
"kind": "msg",
"jp": [
"書斎へ来てみると、日織は",
"いつも通り本を読んでいた。"
]
},
{
"id": 29593,
"kind": "msg",
"jp": [
"「はい?",
"ああ、{和/なご}さん来てたんですかい」"
]
},
{
"id": 29594,
"kind": "msg",
"jp": [
"「今朝、廊下で那須さんが",
"なんか騒いでなかった?」"
]
},
{
"id": 29595,
"kind": "msg",
"jp": [
"「あー・・・あれは・・・」"
]
},
{
"id": 29596,
"kind": "msg",
"jp": [
"眉尻を下げて苦笑しながら、",
"日織は肩をすくめる。"
]
},
{
"id": 29597,
"kind": "msg",
"jp": [
"「雨が止まねえんで、",
"身体がなまって暇らしくてねぇ」"
]
},
{
"id": 29598,
"kind": "msg",
"jp": [
"「逆立ちして階段降りようとして",
"たんで慌てて止めたんですが」"
]
},
{
"id": 29599,
"kind": "msg",
"jp": [
"僕が遭遇しなくて良かった。",
"間違いなく悲鳴上げてる、",
"そんな異様な光景に出くわしたら。"
]
},
{
"id": 29600,
"kind": "msg",
"jp": [
"「そこからまあ、筋トレが",
"どうだとかプロテインがどうだとか",
"話してましたが・・・」"
]
},
{
"id": 29601,
"kind": "msg",
"jp": [
"「濃すぎて俺にも",
"ほとんどわかりませんでした」"
]
},
{
"id": 29602,
"kind": "msg",
"jp": [
"ちょっと小耳に挟んだ僕には",
"まったくわからない会話っぽかった",
"もんなぁ・・・。"
]
},
{
"id": 29603,
"kind": "msg",
"jp": [
"「・・・ありゃ、{和/なご}さん?」"
]
},
{
"id": 29604,
"kind": "msg",
"jp": [
"書斎をのぞくと、いつも通り日織が",
"書き物机の前にいた。"
]
},
{
"id": 29605,
"kind": "msg",
"jp": [
"「寝たんじゃなかったん",
"ですかい?」"
]
},
{
"id": 29606,
"kind": "msg",
"jp": [
"「だって、なんか目がさえちゃって",
"眠れないんだよ」"
]
},
{
"id": 29607,
"kind": "msg",
"jp": [
"「日織こそ、部屋に戻ったんじゃ",
"なかったの?」"
]
},
{
"id": 29608,
"kind": "msg",
"jp": [
"「お互い様でさぁ、",
"俺も目がさえちまいました」"
]
},
{
"id": 29609,
"kind": "msg",
"jp": [
"「俺が変なこと",
"言ったせいですか」"
]
},
{
"id": 29610,
"kind": "msg",
"jp": [
"「犯人が焦ってるんじゃ",
"ねえかって話ですよ」"
]
},
{
"id": 29611,
"kind": "msg",
"jp": [
"「ああ、あれ・・・。",
"うん、気にはなるけど",
"それだけじゃないよ」"
]
},
{
"id": 29612,
"kind": "msg",
"jp": [
"「ここまで来て、失敗は",
"出来ないだろうから・・・」"
]
},
{
"id": 29613,
"kind": "msg",
"jp": [
"「{和/なご}さんなら大丈夫でしょ」"
]
},
{
"id": 29614,
"kind": "msg",
"jp": [
"「あ、あのね、",
"そんな那須さんみたいな",
"楽天的なこと・・・」"
]
},
{
"id": 29615,
"kind": "msg",
"jp": [
"「だってここまで片っ端から",
