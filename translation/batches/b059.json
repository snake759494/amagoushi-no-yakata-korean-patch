]
},
{
"id": 29622,
"kind": "msg",
"jp": [
"（・・・難しいなぁ・・・）"
]
},
{
"id": 29623,
"kind": "msg",
"jp": [
"「ありゃ、{和/なご}さん」"
]
},
{
"id": 29624,
"kind": "msg",
"jp": [
"「日織、寝たんじゃなかったの?」"
]
},
{
"id": 29625,
"kind": "msg",
"jp": [
"「{和/なご}さんこそ。",
"いや・・・まあ、眠気なんか",
"飛んじまいましたけどねぇ」"
]
},
{
"id": 29626,
"kind": "msg",
"jp": [
"「ああ、やっぱり・・・」"
]
},
{
"id": 29627,
"kind": "msg",
"jp": [
"やっぱり日織も気になって",
"眠れなくなったんだな。"
]
},
{
"id": 29628,
"kind": "msg",
"jp": [
"無理もないよなぁ・・・。"
]
},
{
"id": 29629,
"kind": "msg",
"jp": [
"「大丈夫ですかい?",
"あんまり顔色よくねえですぜ」"
]
},
{
"id": 29630,
"kind": "msg",
"jp": [
"「うん、疲れてはいるんだけど。",
"目がさえちゃって・・・」"
]
},
{
"id": 29631,
"kind": "msg",
"jp": [
"「そうですねぇ。",
"まったくなんだってんだか」"
]
},
{
"id": 29632,
"kind": "msg",
"jp": [
"「あと2日だってのに・・・」"
]
},
{
"id": 29633,
"kind": "msg",
"jp": [
"そーっと書斎をのぞいてみると、",
"いつも通り日織が本を読んでいた。"
]
},
{
"id": 29634,
"kind": "msg",
"jp": [
"なぜだか、その光景にひどく",
