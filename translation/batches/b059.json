"「いや、音楽が聴けるだけだ。",
"ジュークボックスの小さいの",
"みたいなもんだな」"
]
},
{
"id": 29805,
"kind": "msg",
"jp": [
"なんだか不気味な抽象画らしきものが",
"飾られている・・・。"
]
},
{
"id": 29806,
"kind": "msg",
"jp": [
"「・・・これ、何・・・?」"
]
},
{
"id": 29807,
"kind": "msg",
"jp": [
"「よくわかんねーけど、",
"魔法使いが唱えた",
"呪文のイメージらしいぜ」"
]
},
{
"id": 29808,
"kind": "msg",
"jp": [
"聞いてもよくわからなかった。"
]
},
{
"id": 29809,
"kind": "msg",
"jp": [
"魔法使いが唱えた呪文を",
"イメージしたとかいう抽象画が",
"飾ってある。"
]
},
{
"id": 29810,
"kind": "msg",
"jp": [
"夢に出ると嫌なので、あまり",
"見たくないかも・・・。"
]
},
{
"id": 29811,
"kind": "msg",
"jp": [
"シンプルなデザインの",
"テーブルがある。"
]
},
{
"id": 29812,
"kind": "msg",
"jp": [
"ソファの上に放り出してあった上着を",
"椿くんはひょいと取り上げてタンスへ",
"しまった。"
]
},
{
"id": 29813,
"kind": "msg",
"jp": [
"「本当は、普段そういう服なんだ」"
]
},
{
"id": 29814,
"kind": "msg",
"jp": [
"「当たり前だ。",
"こんな窮屈な格好いつもしてられっか」"
]
},
{
"id": 29815,
"kind": "msg",
"jp": [
"「・・・ああ、そーだ。",
"お前、大丈夫?」"
]
},
{
"id": 29816,
"kind": "msg",
"jp": [
"「大丈夫って?」"
]
},
{
"id": 29817,
"kind": "msg",
"jp": [
"「その様子なら",
"大丈夫そうだな」"
]
},
{
"id": 29818,
"kind": "msg",
"jp": [
"「どっかで見張るとか",
"なんかして危ねえ目に",
"あってねーかって事だよ」"
]
},
{
"id": 29819,
"kind": "msg",
"jp": [
"「ああ、うん。",
"大丈夫だよ、ありがと」"
]
},
{
"id": 29820,
"kind": "msg",
"jp": [
"「・・・鈍いのかなぁ」"
]
},
{
"id": 29821,
"kind": "msg",
"jp": [
"「いや、お前ってどう見ても",
"根性据ってるようには",
"見えねーからさ」"
]
},
{
"id": 29822,
"kind": "msg",
"jp": [
"「どっか鈍いか、",
"怖いって感情に間違った回路が",
"接続されてんのかなと」"
]
},
{
"id": 29823,
"kind": "msg",
"jp": [
"「間違った回路って何!?」"
]
},
{
"id": 29824,
"kind": "msg",
"jp": [
"「うはは、怒んなよ。",
"だってそーじゃん?」"
]
},
{
"id": 29825,
"kind": "msg",
"jp": [
"「怖がりのくせに",
"妙に大胆なことするしさ」"
]
},
{
"id": 29826,
"kind": "msg",
"jp": [
"「なんでだかわかんないけど",
"昔からそうなんだよ・・・」"
]
},
{
"id": 29827,
"kind": "msg",
"jp": [
"「ガキの頃からか?」"
]
},
{
"id": 29828,
"kind": "msg",
"jp": [
"「小さい頃よく姉ちゃんが",
"こっそり物音立てておばけだって",
"脅かしてくれてさあ・・・」"
]
},
{
"id": 29829,
"kind": "msg",
"jp": [
"「それが姉ちゃんの仕業だって",
"気付いた後も姉ちゃんだって",
"確かめないと怖くて眠れなかったな」"
]
},
{
"id": 29830,
"kind": "msg",
"jp": [
"「なあ、お前それって・・・」"
]
},
{
"id": 29831,
"kind": "msg",
"jp": [
"「しかも姉ちゃんそのこと",
"知ってるから未だにやるし」"
]
},
{
"id": 29832,
"kind": "msg",
"jp": [
"「・・・オレはどこから",
"ツッ込めばいいんだ」"
]
},
{
"id": 29833,
"kind": "msg",
"jp": [
"「いや、その・・・",
"仲良いんだな、姉弟の」"
]
},
{
"id": 29834,
"kind": "msg",
"jp": [
"「悪くはないけど、",
"それ以上に逆らうと怖いから」"
]
},
{
"id": 29835,
"kind": "msg",
"jp": [
"「どうせなら弟か兄貴が",
"いて欲しかったなあ」"
]
},
{
"id": 29836,
"kind": "msg",
"jp": [
"「あー、それは",
"オレもよく思う」"
]
},
{
"id": 29837,
"kind": "msg",
"jp": [
"「どっちかってーと兄貴かな。",
"下は間に合ってっから、",
"頼りになる兄貴が欲しかった」"
]
},
{
"id": 29838,
"kind": "msg",
"jp": [
"「頼りにねぇ・・・」"
]
},
{
"id": 29839,
"kind": "msg",
"jp": [
"「・・・そう言や",
"一応年上だったな、お前」"
]
},
{
"id": 29840,
"kind": "msg",
"jp": [
"「頼りにはならないと",
"思うよ、僕は」"
]
},
{
"id": 29841,
"kind": "msg",
"jp": [
"「そーでもねえだろ、",
"お兄ちゃん」"
]
},
{
"id": 29842,
"kind": "msg",
"jp": [
"「・・・っじ、自分の方が",
"ダメージでかかった・・・」"
]
},
{
"id": 29843,
"kind": "msg",
"jp": [
"「気にするな、",
"自爆したオレが悪いんだ」"
]
},
{
"id": 29844,
"kind": "msg",
"jp": [
"「・・・あー、",
"考えなしに喋ると",
"ろくなことねーな」"
]
},
{
"id": 29845,
"kind": "msg",
"jp": [
"「頼りがいのある",
"お兄さんだったらさ」"
]
},
{
"id": 29846,
"kind": "msg",
"jp": [
"「那須さんがいるじゃん」"
]
},
{
"id": 29847,
"kind": "msg",
"jp": [
"「和の方がマシだっ!!」"
]
},
{
"id": 29848,
"kind": "msg",
"jp": [
"「僕より頼りには",
"なると思うけど」"
]
},
{
"id": 29849,
"kind": "msg",
"jp": [
"「体力勝負な事だけだろ!?",
"どう見ても頼りがいより",
"苦労のが多いぞ、あれは!」"
]
},
{
"id": 29850,
"kind": "msg",
"jp": [
"否定出来ない・・・。"
]
},
{
"id": 29851,
"kind": "msg",
"jp": [
"「・・・なぁ、和」"
]
},
{
"id": 29852,
"kind": "msg",
"jp": [
"「お前今日もどっかで",
"見張ったりすんの?」"
]
},
{
"id": 29853,
"kind": "msg",
"jp": [
"「あー、うん。",
"そうなるかも」"
]
},
{
"id": 29854,
"kind": "msg",
"jp": [
"「・・・ひ弱そうなのになあ」"
]
},
{
"id": 29855,
"kind": "msg",
"jp": [
"「見た目のわりに",
"根性あるよな」"
]
},
{
"id": 29856,
"kind": "msg",
"jp": [
"「だって普通、殺人犯に",
"喧嘩売ろうとは思わんだろ」"
]
},
{
"id": 29857,
"kind": "msg",
"jp": [
"「喧嘩売ってるつもりは",
"ないんだけど・・・」"
]
},
{
"id": 29858,
"kind": "msg",
"jp": [
"「じゃあ、何してる",
"つもりだったんだよ」"
]
},
{
"id": 29859,
"kind": "msg",
"jp": [
"「怖いからやめてくれない",
"かなぁと思って・・・」"
]
},
{
"id": 29860,
"kind": "msg",
"jp": [
"「・・・あのな」"
]
},
{
"id": 29861,
"kind": "msg",
"jp": [
"「お前のその意思って",
"絶対、犯人には伝わって",
"ねーと思うぞ」"
]
},
{
"id": 29862,
"kind": "msg",
"jp": [
"「・・・僕もそんな気がしてた」"
]
},
{
"id": 29863,
"kind": "msg",
"jp": [
"「大丈夫なのか、お前。",
"オレが助かっちまったせいで",
"恨まれてるだろ、絶対」"
]
},
{
"id": 29864,
"kind": "msg",
"jp": [
"「う、恨まれ・・・」"
]
},
{
"id": 29865,
"kind": "msg",
"jp": [
"「最初に間違えられてたし",
"もう、こいつが南雲でいいや",
"とかって事になったりしねえ?」"
]
},
{
"id": 29866,
"kind": "msg",
"jp": [
"「オレだって想像したか",
"ねーけどよ・・・」"
]
},
{
"id": 29867,
"kind": "msg",
"jp": [
"「でもヤバイだろ。",
"気をつけろよ?」"
]
},
{
"id": 29868,
"kind": "msg",
"jp": [
"「・・・そう言や",
"犯人の奴、来ねーな」"
]
},
{
"id": 29869,
"kind": "msg",
"jp": [
"「どこに?」"
]
},
{
"id": 29870,
"kind": "msg",
"jp": [
"「お前んとこに決まってるだろ」"
]
},
{
"id": 29871,
"kind": "msg",
"jp": [
"「なんで僕んとこ!?」"
]
},
{
"id": 29872,
"kind": "msg",
"jp": [
"「なんでって、",
"邪魔されてんだから仕返しとか",
"しねーのかなと思って」"
]
},
{
"id": 29873,
"kind": "msg",
"jp": [
"「しなくていいよ、",
"怖いからっ!!」"
]
},
{
"id": 29874,
"kind": "msg",
"jp": [
"「怖いからかよ!?」"
]
},
{
"id": 29875,
"kind": "msg",
"jp": [
"「怖いに決まってるだろ!",
"椿くん怖くなかったの?」"
]
},
{
"id": 29876,
"kind": "msg",
"jp": [
"「・・・いや、そりゃ",
"怖くなかったわけはねーけど」"
]
},
{
"id": 29877,
"kind": "msg",
"jp": [
"「絶対怖いって!",
"僕なんか想像しただけで",
"気が遠くなるのに・・・」"
]
},
{
"id": 29878,
"kind": "msg",
"jp": [
"「それもどうかと思うんだが」"
]
},
{
"id": 29879,
"kind": "msg",
"jp": [
"「・・・狙われてる",
"椿くん達なんかもう",
"どれだけ怖いか・・・」"
]
},
{
"id": 29880,
"kind": "msg",
"jp": [
"「なんつーか、",
"お前がオレらの側にいたら",
"殺される前に寝込んでそうだな」"
]
},
{
"id": 29881,
"kind": "msg",
"jp": [
"「多分、最初に温室の",
"『復讐』っていうの見た時にね」"
]
},
{
"id": 29882,
"kind": "msg",
"jp": [
"「早いだろ、それは!?",
"まだ何が起きたのかすら",
"わかってねーじゃねえか!」"
]
},
{
"id": 29883,
"kind": "msg",
"jp": [
"「だ、だって怖い・・・」"
]
},
{
"id": 29884,
"kind": "msg",
"jp": [
"「・・・お前、オカルト系の",
"芝居とか見せると役者にとっては",
"理想的な客なんだろうな」"
]
},
{
"id": 29885,
"kind": "msg",
"jp": [
"「途中で気絶しちゃったり",
"するとかえって迷惑じゃない?」"
]
},
{
"id": 29886,
"kind": "msg",
"jp": [
"「芝居でかっ!?」"
]
},
{
"id": 29887,
"kind": "msg",
"jp": [
"「だってお芝居じゃ、",
"席に座ってなきゃいけないから",
"逃げられないじゃないか」"
]
},
{
"id": 29888,
"kind": "msg",
"jp": [
"「そうか、今ここで妙に",
"動き回ってんのは逃げ場が",
"ないからか」"
]
},
{
"id": 29889,
"kind": "msg",
"jp": [
"「うん、逃げられないから",
"なんとかしないと怖いままだし」"
]
},
{
"id": 29890,
"kind": "msg",
"jp": [
"「・・・なんでいきなり",
"迷子になってたのかわかった」"
]
},
{
"id": 29891,
"kind": "msg",
"jp": [
"「夜の山の中で、",
"独りで車の中にいるのが",
"怖くなったんだな」"
]
},
{
"id": 29892,
"kind": "msg",
"jp": [
"「あ、でもガソリンが",
"切れかけてたのも本当だよ?」"
]
},
{
"id": 29893,
"kind": "msg",
"jp": [
"「わかったわかった」"
]
},
{
"id": 29894,
"kind": "msg",
"jp": [
"「・・・もうすぐだな」"
]
},
{
"id": 29895,
"kind": "msg",
"jp": [
"「もうすぐって?」"
]
},
{
"id": 29896,
"kind": "msg",
"jp": [
"「撮影終了・・・の、",
"はずだった日だよ」"
]
},
{
"id": 29897,
"kind": "msg",
"jp": [
"「ああ・・・",
"うん、そうだね」"
]
},
{
"id": 29898,
"kind": "msg",
"jp": [
"「オレら、本当に帰れんのかな」"
]
},
{
"id": 29899,
"kind": "msg",
"jp": [
"「か、帰ろうよ。",
"せっかく助かったんだから」"
]
},
{
"id": 29900,
"kind": "msg",
"jp": [
"「犯人が最後の最後に",
"何かしでかさなきゃいいけどよ」"
]
},
{
"id": 29901,
"kind": "msg",
"jp": [
"「・・・まだ気ぃ抜けねーだろ」"
]
},
{
"id": 29902,
"kind": "msg",
"jp": [
"「・・・なあ、和」"
]
},
{
"id": 29903,
"kind": "msg",
"jp": [
"「死ぬなよ」"
]
},
{
"id": 29904,
"kind": "msg",
"jp": [
"「オレ達だけ助けて",
"自分は戻って来ねえなんて",
"ドラマみてーな真似すんなよ」"
]
},
{
"id": 29905,
"kind": "msg",
"jp": [
"「し、しないよ」"
]
},
{
"id": 29906,
"kind": "msg",
"jp": [
"「ここから出るんだったら",
"一緒でねーと意味ねえぞ。",
"お前も、日織もな」"
]
},
{
"id": 29907,
"kind": "msg",
"jp": [
"「・・・マジで頼むぞ」"
]
},
{
"id": 29908,
"kind": "msg",
"jp": [
"「オレはな、そんなに",
"図太くも強くもねーんだよ」"
]
},
{
"id": 29909,
"kind": "msg",
"jp": [
"「自分の人生だけで、",
"一杯一杯なんだよ」"
]
},
{
"id": 29910,
"kind": "msg",
"jp": [
"「お前の分まで背負って",
"生きてけなんて言われても",
"無理だからな」"
]
},
{
"id": 29911,
"kind": "msg",
"jp": [
"「ただでさえ・・・",
"斑井のオッサンだとかもう",
"無駄に重てぇのによ」"
]
},
{
"id": 29912,
"kind": "msg",
"jp": [
"「僕も、自分だけで",
"精一杯だから・・・」"
]
},
{
"id": 29913,
"kind": "msg",
"jp": [
"「一緒に帰ろう」"
]
},
{
"id": 29914,
"kind": "msg",
"jp": [
"「・・・おう」"
]
},
{
"id": 29915,
"kind": "msg",
"jp": [
"「あと、たった1日だ。",
"生き延びようぜ」"
]
},
{
"id": 29916,
"kind": "msg",
"jp": [
"あと、1日――"
]
},
{
"id": 29917,
"kind": "msg",
"jp": [
"それはもしかしたら、",
"タイムリミットかもしれない。"
]
},
{
"id": 29918,
"kind": "msg",
"jp": [
"（それまでにどうにか、",
"犯人をどうにかしないと・・・）"
]
},
{
"id": 29919,
"kind": "msg",
"jp": [
"（・・・帰れないかもしれない）"
]
},
{
"id": 29920,
"kind": "msg",
"jp": [
"「・・・一柳さま」"
]
},
{
"id": 29921,
"kind": "msg",
"jp": [
"「え? 何?」"
]
},
{
"id": 29922,
"kind": "msg",
"jp": [
"「こういう事を聞くのは",
"少々失礼かもしれませんが」"
]
},
{
"id": 29923,
"kind": "msg",
"jp": [
"「勝算はおありで?」"
]
},
{
"id": 29924,
"kind": "msg",
"jp": [
"「・・・勝算?」"
]
},
{
"id": 29925,
"kind": "msg",
"jp": [
"「お前、実はまぐれと",
"偶然だけで生きてねーか」"
]
},
{
"id": 29926,
"kind": "msg",
"jp": [
"「なんでいきなり",
"素に戻るんだよ!?」"
]
},
{
"id": 29927,
"kind": "msg",
"jp": [
"「ああ、失礼」"
]
},
{
"id": 29928,
"kind": "msg",
"jp": [
"「すっとぼけてらっしゃるので",
"どこまで天然なのかと思いまして」"
]
},
{
"id": 29929,
"kind": "msg",
"jp": [
"「とぼけてるわけじゃ",
"ないんだけど・・・」"
]
},
{
"id": 29930,
"kind": "msg",
"jp": [
"「・・・本気ですか」"
]
},
{
"id": 29931,
"kind": "msg",
"jp": [
"「え、だから",
"勝算って何?」"
]
},
{
"id": 29932,
"kind": "msg",
"jp": [
"「犯人にだよっ!」"
]
},
{
"id": 29933,
"kind": "msg",
"jp": [
"「驚くなよっ!?",
"なんでオレが生きてんのか",
"不思議になってくるだろーが!」"
]
},
{
"id": 29934,
"kind": "msg",
"jp": [
"「・・・お前、今",
"なんでだろうとか",
"思わなかったか」"
]
},
{
"id": 29935,
"kind": "msg",
"jp": [
"「お、思ってないよ?」"
]
},
{
"id": 29936,
"kind": "msg",
"jp": [
"「嘘をつくのも",
"下手なんですね」"
]
},
{
"id": 29937,
"kind": "msg",
"jp": [
"「だって・・・",
"本当に勝算なんかないし」"
]
},
{
"id": 29938,
"kind": "msg",
"jp": [
"「どこの世界に",
"助けた被害者を不安に陥れる",
"名探偵がいるんです」"
]
},
{
"id": 29939,
"kind": "msg",
"jp": [
"「名探偵って誰!?」"
]
},
{
"id": 29940,
"kind": "msg",
"jp": [
"「一柳さま以外に誰が",
"おられると?」"
]
},
{
"id": 29941,
"kind": "msg",
"jp": [
"「なんで僕が!?」"
]
},
{
"id": 29942,
"kind": "msg",
"jp": [
"「犯人とタイマンはってんのは",
"一柳さまだけですが!?」"
]
},
{
"id": 29943,
"kind": "msg",
"jp": [
"「いや、日織もいるけど」"
]
},
{
"id": 29944,
"kind": "msg",
"jp": [
"「セコンドだろ、あれは」"
]
},
{
"id": 29945,
"kind": "msg",
"jp": [
"「・・・もういい。",
"なんか犯人が哀れになってきた」"
]
},
{
"id": 29946,
"kind": "msg",
"jp": [
"「その後、犯人の手がかり",
"などは何かありましたか」"
]
},
{
"id": 29947,
"kind": "msg",
"jp": [
"「・・・手がかりっていうか",
"黒猫とかベルとかなら",
"いっぱいあるんだけど・・・」"
]
},
{
"id": 29948,
"kind": "msg",
"jp": [
"「そんなもんは",
"見りゃわかります」"
]
},
{
"id": 29949,
"kind": "msg",
"jp": [
"「あの、椿くん・・・地が・・・」"
]
},
{
"id": 29950,
"kind": "msg",
"jp": [
"「大丈夫ですか本当に・・・",
"まだ何日もここで閉じ込められて",
"なきゃなんねーんですがね?」"
]
},
{
"id": 29951,
"kind": "msg",
"jp": [
"「・・・早く帰りたいね」"
]
},
{
"id": 29952,
"kind": "msg",
"jp": [
"「私は一柳さまのおかげで",
"助かったはずなんですが」"
]
},
{
"id": 29953,
"kind": "msg",
"jp": [
"「話せば話すほど不安に",
"なって来るのはなぜですか」"
]
},
{
"id": 29954,
"kind": "msg",
"jp": [
"「そんなこと言われても",
"殺人犯の邪魔するなんて",
"生まれて初めてだし」"
]
},
{
"id": 29955,
"kind": "msg",
"jp": [
"「オレだって、",
"殺人犯に命狙われるなんざ",
"生まれて初めてだよっ!?」"
]
},
{
"id": 29956,
"kind": "msg",
"jp": [
"「あ、そうか」"
]
},
{
"id": 29957,
"kind": "msg",
"jp": [
"「・・・頭痛がしてきたぞ、おい」"
]
},
{
"id": 29958,
"kind": "msg",
"jp": [
"「あー、ところで",
"一柳さま?」"
]
},
{
"id": 29959,
"kind": "msg",
"jp": [
"「見たところご無事のようですが",
"犯人からお礼参りなどは行われて",
"おりませんか」"
]
},
{
"id": 29960,
"kind": "msg",
"jp": [
"「そんなことされてたら",
"僕もう死んでる・・・」"
]
},
{
"id": 29961,
"kind": "msg",
"jp": [
"「反撃食らったら死ぬという",
"ことは理解してらっしゃるんですね」"
]
},
{
"id": 29962,
"kind": "msg",
"jp": [
"「そ、そりゃあ・・・」"
]
},
{
"id": 29963,
"kind": "msg",
"jp": [
"「なのに、なぜそんなに",
"危機感がないんです」"
]
},
{
"id": 29964,
"kind": "msg",
"jp": [
"「・・・ないように見える?」"
]
},
{
"id": 29965,
"kind": "msg",
"jp": [
"「微塵もないようにしか",
"見えませんが」"
]
},
{
"id": 29966,
"kind": "msg",
"jp": [
"「これでも目一杯",
"あるんだけどなあ」"
]
},
{
"id": 29967,
"kind": "msg",
"jp": [
"「どこら辺にですか」"
]
},
{
"id": 29968,
"kind": "msg",
"jp": [
"「館の中うろうろしてる間も",
"周りに気をつけたりしてるよ」"
]
},
{
"id": 29969,
"kind": "msg",
"jp": [
"「なんで素で驚くんだよ」"
]
},
{
"id": 29970,
"kind": "msg",
"jp": [
"「とてもそうは",
"見えませんでしたので」"
]
},
{
"id": 29971,
"kind": "msg",
"jp": [
"「ちゃんと気をつけてるよ。",
"変な足音がついて来てないかとか",
"誰かの視線を感じないかとか」"
]
},
{
"id": 29972,
"kind": "msg",
"jp": [
"「壁の染みが怖い形してないかとか",
"階段を上り下りするたびに",
"段数が変わってないかとか・・・」"
]
},
{
"id": 29973,
"kind": "msg",
"jp": [
"「どこの学校の怪談だ",
"そりゃあっ!?」"
]
},
{
"id": 29974,
"kind": "msg",
"jp": [
"「だって怖い・・・」"
]
},
{
"id": 29975,
"kind": "msg",
"jp": [
"「今、気をつけなきゃならん",
"種類の恐怖じゃねーだろ、",
"特に後半の2つ!」"
]
},
{
"id": 29976,
"kind": "msg",
"jp": [
"「前半はいいんだ」"
]
},
{
"id": 29977,
"kind": "msg",
"jp": [
"「足音とか妙な視線は",
"普通にヤバイだろ。",
"犯人かもしれんじゃないか」"
]
},
{
"id": 29978,
"kind": "msg",
"jp": [
"「変なこと言うなよっ!?",
"おばけか犯人かどっちか",
"だけで十分なのに・・・」"
]
},
{
"id": 29979,
"kind": "msg",
"jp": [
"「今は犯人にしとけ犯人に!",
"つーか、出ねーから幽霊とか!」"
]
},
{
"id": 29980,
"kind": "msg",
"jp": [
"「こんな、いかにも",
"出そうな建物に?」"
]
},
{
"id": 29981,
"kind": "msg",
"jp": [
"「・・・出るって噂が",
"あるだけで出ねーから」"
]
},
{
"id": 29982,
"kind": "msg",
"jp": [
"「噂あるんじゃないかー!」"
]
},
{
"id": 29983,
"kind": "msg",
"jp": [
"「噂だけだっ!",
"オレは見たことねーよ!」"
]
},
{
"id": 29984,
"kind": "msg",
"jp": [
"「僕、見たらどうしよう」"
]
},
{
"id": 29985,
"kind": "msg",
"jp": [
"「念仏でも唱えとけ。",
"あーもう、疲れる・・・」"
]
},
{
"id": 29986,
"kind": "msg",
"jp": [
"「・・・一柳さま・・って",
"ああ、もう面倒くせーわ」"
]
},
{
"id": 29987,
"kind": "msg",
"jp": [
"「なんとなく無事に",
"生きてるみてーだから",
"大丈夫なんだろうけどよ」"
]
},
{
"id": 29988,
"kind": "msg",
"jp": [
"「お前だ」"
]
},
{
"id": 29989,
"kind": "msg",
"jp": [
"「無防備にうろうろしてっと",
"一番危ないの自分だって",
"自覚・・・ねーよな?」"
]
},
{
"id": 29990,
"kind": "msg",
"jp": [
"「危ないって、あの、",
"僕より他の人達の方が」"
]
},
{
"id": 29991,
"kind": "msg",
"jp": [
"「その、他の人達のために",
"犯人の神経逆なでしまくってんのは",
"お前だろうって話だよっ!」"
]
},
{
"id": 29992,
"kind": "msg",
"jp": [
"「逆なで・・・」"
]
},
{
"id": 29993,
"kind": "msg",
"jp": [
"「してねーとでも言う気か」"
]
},
{
"id": 29994,
"kind": "msg",
"jp": [
"「・・・してるんだろうね」"
]
},
{
"id": 29995,
"kind": "msg",
"jp": [
"「してんだよ!",
"オレが犯人だったら真っ先に",
"後ろから刺してるよ!」"
]
},
{
"id": 29996,
"kind": "msg",
"jp": [
"「さ、刺すの!?」"
]
},
{
"id": 29997,
"kind": "msg",
"jp": [
"「刺すでも殴るでも",
"なんでもいーよ」"
]
},
{
"id": 29998,
"kind": "msg",
"jp": [
"「頼むから自覚して下さい。",
"こっちの胃が痛くなって",
"来やがりますんで」"
]
},
{
"id": 29999,
"kind": "msg",
"jp": [
"「言葉使い無茶苦茶に",
"なってるよ・・・」"
]
},
{
"id": 30000,
"kind": "msg",
"jp": [
"「お前がよけいな心配",
"させっからだろーが!?」"
]
},
{
"id": 30001,
"kind": "msg",
"jp": [
"「・・・んだよ?」"
]
},
{
"id": 30002,
"kind": "msg",
"jp": [
"「あ、あの、ごめん」"
]
},
{
"id": 30003,
"kind": "msg",
"jp": [
"「・・・心配して",
"くれてたんだ・・・」"
]
},
{
"id": 30004,
"kind": "msg",
"jp": [
"「き、気のせいだ」"
]
},
{
"id": 30005,
"kind": "msg",
"jp": [
"「え、あの、でも今",
"自分で言った・・・」"
]
},
{
"id": 30006,
"kind": "msg",
"jp": [
"「気のせいだっつったら",
"気のせいなんだよっ!",
"忘れろ、とっとと!!」"
]
},
{
"id": 30007,
"kind": "msg",
"jp": [
"「ほんっとに",
"わけわかんねー奴・・・」"
]
},
{
"id": 30008,
"kind": "msg",
"jp": [
"（椿くんほどじゃないと",
"思うんだけどなー・・・）"
]
},
{
"id": 30009,
"kind": "msg",
"jp": [
"でも言ったらまた怒られるから",
"やめとこう。"
]
},
{
"id": 30010,
"kind": "yesno",
"jp": [
"システム情報をセーブしますか?"
]
},
{
"id": 30011,
"kind": "yesno",
"jp": [
"『推理』を終了しますか?"
]
},
{
"id": 30012,
"kind": "msg",
"jp": [
"森本くーん、バグってる!!"
]
},
{
"id": 30013,
"kind": "msg",
"jp": [
"（・・・気になるけど",
"やっぱり怖い・・・）"
]
},
{
"id": 30014,
"kind": "msg",
"jp": [
"も、もうちょっと余裕のある時に",
"来よう、それがいいよな。"
]
},
{
"id": 30015,
"kind": "msg",
"jp": [
"食堂は鍵をかけられて",
"閉ざされている・・・。"
]
},
{
"id": 30016,
"kind": "msg",
"jp": [
"（勝手に入っちゃって",
"ごめんね・・・）"
]
},
{
"id": 30017,
"kind": "msg",
"jp": [
"地下の物置はあれから",
"鍵をかけて閉ざしてある・・・。"
]
},
{
"id": 30018,
"kind": "msg",
"jp": [
"暗石さんの部屋には、",
"鍵が掛かっている・・・。"
]
},
{
"id": 30019,
"kind": "msg",
"jp": [
"長持部屋には、",
"鍵が掛かっている・・・。"
]
},
{
"id": 30020,
"kind": "msg",
"jp": [
"静奈ちゃんの部屋は、鍵が掛けられ",
"閉ざされている・・・。"
]
},
{
"id": 30021,
"kind": "msg",
"jp": [
"どこに行ってみようかな。"
]
},
{
"id": 30022,
"kind": "msg",
"jp": [
"（^ω^）"
]
},
{
"id": 30023,
"kind": "msg",
"jp": [
"（現場の写真とかメモとか",
"整理した方がいいかな・・・）"
]
},
{
"id": 30024,
"kind": "msg",
"jp": [
"（そう言えば、日織が現場で",
"言ってた死因とかそういうのも",
"書いといた方が・・・）"
]
},
{
"id": 30025,
"kind": "msg",
"jp": [
"携帯と手帳を見ながら、",
"ふっと言いようのない恐怖に",
"とらわれた。"
]
},
{
"id": 30026,
"kind": "msg",
"jp": [
"（・・・僕は、本気で・・・）"
]
},
{
"id": 30027,
"kind": "msg",
"jp": [
"（本気で、犯人が誰なのか",
"考えようとしてるのか・・・?）"
]
},
{
"id": 30028,
"kind": "msg",
"jp": [
"人を殺した相手を突き止めようと",
"するなんて、普段の僕なら",
"考えもつかないだろうに・・・。"
]
},
{
"id": 30029,
"kind": "msg",
"jp": [
"（放っておいたら、",
"もっと怖いことになるし・・）"
]
},
{
"id": 30030,
"kind": "msg",
"jp": [
"・・・そうだよ。",
"推理とか探偵とか柄じゃないけど",
"放っておくのはもっと怖いんだよ。"
]
},
{
"id": 30031,
"kind": "msg",
"jp": [
"だからどうにかして、",
"こんなの全部終わらせてしまえば",
"怖いのも終わるし・・・。"
]
},
{
"id": 30032,
"kind": "msg",
"jp": [
"（でも、探偵なんて",
"向いてないのは確かだしな）"
]
},
{
"id": 30033,
"kind": "msg",
"jp": [
"もしも犯人が誰かわかっても",
"本当に確信が持てるまでは",
"黙ってた方がよさそうだ。"
]
},
{
"id": 30034,
"kind": "msg",
"jp": [
"（それに、もし確信が",
"もてたとしても・・・）"
]
},
{
"id": 30035,
"kind": "msg",
"jp": [
"揃えてある資料が間違ってたり",
"したら、犯人に足元をすくわれる",
"ような結果になりかねない。"
]
},
{
"id": 30036,
"kind": "msg",
"jp": [
"（特に、この表・・・）"
]
},
{
"id": 30037,
"kind": "msg",
"jp": [
"アリバイ表はおかしなことに",
"なってたら絶対まずいよな。",
"日織も注意しろって言ってたし。"
]
},
{
"id": 30038,
"kind": "msg",
"jp": [
"（嘘かもしれない状態の",
"ままじゃ駄目ってことだよな）"
]
},
{
"id": 30039,
"kind": "msg",
"jp": [
"何か、矛盾した部分があったら",
"そこを真実であるはずの状態に",
"なおしておかないと駄目なんだ。"
]
},
{
"id": 30040,
"kind": "msg",
"jp": [
"誰かが起きてきて驚かれないうちに",
"部屋に戻ろう・・・。"
]
},
{
"id": 30041,
"kind": "msg",
"jp": [
"（日織はまだ寝てるな・・・）"
]
},
{
"id": 30042,
"kind": "msg",
"jp": [
"起こさないようにそっと",
"自分のベッドへ滑り込む。"
]
},
{
"id": 30043,
"kind": "choice",
"jp": [
"部屋の前で見張る"
]
},
{
"id": 30044,
"kind": "msg",
"jp": [
"「食ってねえ人の分は",
"どうしましょうかね」"
]
},
{
"id": 30045,
"kind": "msg",
"jp": [
"流し台に向かいながら",
"日織が聞いてくる。"
]
},
{
"id": 30046,
"kind": "msg",
"jp": [
"「持っていってあげた方が",
"いいんじゃないかな。",
"ちょっと心配だし・・・」"
]
},
{
"id": 30047,
"kind": "msg",
"jp": [
"「そうですねえ。",
"それじゃ用意しましょうか」"
]
},
{
"id": 30048,
"kind": "msg",
"jp": [
"日織は頷いて、慣れた手つきで",
"食事を用意してくれた。"
]
},
{
"id": 30049,
"kind": "msg",
"jp": [
"「・・・こんなもんかな。",
"持ってってくれますかい」"
]
},
{
"id": 30050,
"kind": "msg",
"jp": [
"「うん、わかった。",
"じゃあ御陵さんとこ行ってくる」"
]
},
{
"id": 30051,
"kind": "msg",
"jp": [
"盛り付けられた皿を持って、",
"台所を出る。"
]
},
{
"id": 30052,
"kind": "msg",
"jp": [
"「御陵さん、起きてます?」"
]
},
{
"id": 30053,
"kind": "msg",
"jp": [
"中から声がして、扉が開いた。"
]
},
{
"id": 30054,
"kind": "msg",
"jp": [
"「こんばんは、あの・・・",
"何か食べた方がいいんじゃ",
"ないかと思って・・・」"
]
},
{
"id": 30055,
"kind": "msg",
"jp": [
"「まぁ、すみません・・・」"
]
},
{
"id": 30056,
"kind": "msg",
"jp": [
"「全部じゃなくても、",
"少しだけでも食べて下さい」"
]
},
{
"id": 30057,
"kind": "msg",
"jp": [
"「・・・ありがとうございます。",
"いただいておきますわ」"
]
},
{
"id": 30058,
"kind": "msg",
"jp": [
"「はい、どうぞ。",
"それじゃあ」"
]
},
{
"id": 30059,
"kind": "msg",
"jp": [
"とりあえず、受け取ってもらえた",
"だけでもよかったかな・・・。"
]
},
{
"id": 30060,
"kind": "msg",
"jp": [
"「お帰りなさい。",
"もらってくれましたか」"
]
},
{
"id": 30061,
"kind": "msg",
"jp": [
"「うん、ありがとうって」"
]
},
{
"id": 30062,
"kind": "msg",
"jp": [
"「そりゃよかった。",
"俺らの分ももう出来ますからね」"
]
},
{
"id": 30063,
"kind": "msg",
"jp": [
"「手間が変わらないんなら、",
"用意してあげようよ。",
"僕、持っていってくるから」"
]
},
{
"id": 30064,
"kind": "msg",
"jp": [
"「大して変わりゃしませんよ。",
"それじゃ、先に差し入れますかね」"
]
},
{
"id": 30065,
"kind": "msg",
"jp": [
"日織はそう言って、なれた手つきで",
"てきぱきと用意してくれた。"
]
},
{
"id": 30066,
"kind": "msg",
"jp": [
"「・・・よっと。",
"{和/なご}さん、そっちの器持ってって",
"くれますかい」"
]
},
{
"id": 30067,
"kind": "msg",
"jp": [
"「うん、それじゃ椿くんとこ",
"行ってくる」"
]
},
{
"id": 30068,
"kind": "msg",
"jp": [
"「椿くーん」"
]
},
{
"id": 30069,
"kind": "msg",
"jp": [
"「あー? なんだ?」"
]
},
{
"id": 30070,
"kind": "msg",
"jp": [
"ノックして声をかけると、",
"中から間延びした声で返事があった。"
]
},
{
"id": 30071,
"kind": "msg",
"jp": [
"「ご飯持ってきたけど食べない?」"
]
},
{
"id": 30072,
"kind": "msg",
"jp": [
"「飯!?",
"ちょっと待て、すぐ開ける!」"
]
},
{
"id": 30073,
"kind": "msg",
"jp": [
"打って変わってどたばた慌しい物音と",
"ほぼ同時に扉が勢いよく開いた。"
]
},
{
"id": 30074,
"kind": "msg",
"jp": [
"「うわ」"
]
},
{
"id": 30075,
"kind": "msg",
"jp": [
"「おっと、悪ぃ!",
"飯こぼれてねえ?」"
]
},
{
"id": 30076,
"kind": "msg",
"jp": [
"「だ、大丈夫・・・」"
]
},
{
"id": 30077,
"kind": "msg",
"jp": [
"「いやもー、寝ちまおうと",
"してたんだけどやっぱ",
"腹へってさー!」"
]
},
{
"id": 30078,
"kind": "msg",
"jp": [
"「んじゃ、日織にも礼言っといて",
"マジありがてーからなー」"
]
},
{
"id": 30079,
"kind": "msg",
"jp": [
"「うん、わかった。",
"・・・食欲あってよかったよ」"
]
},
{
"id": 30080,
"kind": "msg",
"jp": [
"「なんか波が激しいんだよ。",
"食欲ある時とない時の」"
]
},
{
"id": 30081,
"kind": "msg",
"jp": [
"「まともな飯食ってねーからな。",
"乾パンだのジャーキーだの、",
"水気のねーもんもう飽きたっつの」"
]
},
{
"id": 30082,
"kind": "msg",
"jp": [
"ああ、確かに。",
"それは辛そうだ・・・。"
]
},
{
"id": 30083,
"kind": "msg",
"jp": [
"「んじゃな、いただきまーす」"
]
},
{
"id": 30084,
"kind": "msg",
"jp": [
"・・・相当飢えてたみたいだなぁ。"
]
},
{
"id": 30085,
"kind": "msg",
"jp": [
"「ただいまー。",
"無茶苦茶喜んでたよ」"
]
},
{
"id": 30086,
"kind": "msg",
"jp": [
"「あはは、そりゃよかった。",
"俺らの分ももうすぐ出来ますからね」"
]
},
{
"id": 30087,
"kind": "msg",
"jp": [
"「他の人はわかんないけど、",
"那須さんは持っていったら食べて",
"くれそうな気がする・・・」"
]
},
{
"id": 30088,
"kind": "msg",
"jp": [
"「あぁ、そうですねえ。",
"人一倍食う人だから腹減らして",
"そうな気もするし」"
]
},
{
"id": 30089,
"kind": "msg",
"jp": [
"「じゃ、先に差し入れましょう。",
"すぐ用意出来ますから」"
]
},
{
"id": 30090,
"kind": "msg",
"jp": [
"そう言って日織は手際よく食事を",
"用意してくれた。"
]
},
{
"id": 30091,
"kind": "msg",
"jp": [
"「・・・こんなもんかな」"
]
},
{
"id": 30092,
"kind": "msg",
"jp": [
"「じゃあ僕、持っていってくるよ」"
]
},
{
"id": 30093,
"kind": "msg",
"jp": [
"「那須さん、こんばんはー」"
]
},
{
"id": 30094,
"kind": "msg",
"jp": [
"「ん? 和くんかい?」"
]
},
{
"id": 30095,
"kind": "msg",
"jp": [
"返事がしたかと思ったら、何のためらい",
"もなく扉が開いた。"
]
},
{
"id": 30096,
"kind": "msg",
"jp": [
"一応、危険なときは乗り切ったとはいえ",
"警戒心のない人だ・・・。"
]
},
{
"id": 30097,
"kind": "msg",
"jp": [
"「あ、えーと・・・」"
]
},
{
"id": 30098,
"kind": "msg",
"jp": [
"「やあ、美味そうだな!",
"それもらっていいの?」"
]
},
{
"id": 30099,
"kind": "msg",
"jp": [
"「は、はい、どうぞ」"
]
},
{
"id": 30100,
"kind": "msg",
"jp": [
"「ありがとう!",
"助かるよ、保存食だけじゃ",
"やっぱり腹減っちゃってさあ」"
]
}
]