[
{
"id": 19214,
"kind": "msg",
"jp": [
"「バレへんと思たんやろ。",
"実際、けっこう真に受けてる人多いし」"
]
},
{
"id": 19215,
"kind": "msg",
"jp": [
"「それで・・・いいものなの?",
"本当に気に入られてるわけでも",
"なんでもないのに・・・」"
]
},
{
"id": 19216,
"kind": "msg",
"jp": [
"「・・・この業界よぉあるけどな。",
"情報操作みたいな真似するんなんて」"
]
},
{
"id": 19217,
"kind": "msg",
"jp": [
"「訴えたり出来ないの?」"
]
},
{
"id": 19218,
"kind": "msg",
"jp": [
"「だって単なる噂やねんから",
"出所がどこやって証拠も無いし」"
]
},
{
"id": 19219,
"kind": "msg",
"jp": [
"「それに・・・",
"なんか上の方はいろいろあるんやって、",
"力関係とかそういう面倒くさいことが」"
]
},
{
"id": 19220,
"kind": "msg",
"jp": [
"「でも・・・",
"人が1人亡くなってるのに・・・」"
]
},
{
"id": 19221,
"kind": "msg",
"jp": [
"「・・・お兄さん、ええ人やね」"
]
},
{
"id": 19222,
"kind": "msg",
"jp": [
"「・・・梨奈ちゃんてさあ、",
"すごい真面目で頑張り屋さんやったん」"
]
},
{
"id": 19223,
"kind": "msg",
"jp": [
"「・・・帽子屋のファンやって",
"あの人の芝居出たいってずっと",
"言うててさ・・・」"
]
},
{
"id": 19224,
"kind": "msg",
"jp": [
"「え・・・じゃあ、もしかして",
"帽子屋のせいで落ちたなんて話が",
"なかったら・・・」"
]
},
{
"id": 19225,
"kind": "msg",
"jp": [
"「自殺までしなかったかも",
"しれない、の・・・?」"
]
},
{
"id": 19226,
"kind": "msg",
"jp": [
"「・・・その、",
"可能性が高いと思う・・・」"
]
},
{
"id": 19227,
"kind": "msg",
"jp": [
"「飛び降りたん、帽子屋の話が",
"うちの事務所で噂になったすぐ後で",
"ほんまに突然やったから・・・」"
]
},
{
"id": 19228,
"kind": "msg",
"jp": [
"「・・・ちょっと",
"立ち直りかけてたように",
"見えたのに・・・」"
]
},
{
"id": 19229,
"kind": "msg",
"jp": [
"「{空元気/からげんき}やったんかも。",
"無理してたところにそんな",
"話聞いたせいで・・・」"
]
},
{
"id": 19230,
"kind": "msg",
"jp": [
"ふっと、心が折れてしまったの",
"かもしれない。"
]
},
{
"id": 19231,
"kind": "msg",
"jp": [
"真実じゃなかったのに・・・。"
]
},
{
"id": 19232,
"kind": "msg",
"jp": [
"「・・・けど、",
"みきちゃんは関係なかった",
"みたいやし・・・」"
]
},
{
"id": 19233,
"kind": "msg",
"jp": [
"「みきちゃん?",
"ああ、あのオーディションに",
"受かった子?」"
]
},
{
"id": 19234,
"kind": "msg",
"jp": [
"「うん、そう。",
"あの子は知らんかったみたいって",
"うちの社長が言うてた」"
]
},
{
"id": 19235,
"kind": "msg",
"jp": [
"「多分、事務所とか映画の主催とか",
"上の方が勝手にやったんやろうね」"
]
},
{
"id": 19236,
"kind": "msg",
"jp": [
"「なんか、その子も",
"可哀想だね・・・」"
]
},
{
"id": 19237,
"kind": "msg",
"jp": [
"「うん・・・。",
"噂聞いて落ち込んでる",
"らしいって話やわ」"
]
},
{
"id": 19238,
"kind": "msg",
"jp": [
"「そりゃあ・・・",
"そうだろうね」"
]
},
{
"id": 19239,
"kind": "msg",
"jp": [
"「・・・お葬式の時にさ、",
"誰からかわからんお花が",
"2つくらい届いたんよね」"
]
},
{
"id": 19240,
"kind": "msg",
"jp": [
"「差出人の名前とか",
"何も書いてないやつが」"
]
},
{
"id": 19241,
"kind": "msg",
"jp": [
"「それの、どっちかが",
"みきちゃんなんと違うかなって",
"うちは思てるんやけどさ」"
]
},
{
"id": 19242,
"kind": "msg",
"jp": [
"「・・・けど、もう片方は",
"誰からなんだろう?",
"ファンの人?」"
]
},
{
"id": 19243,
"kind": "msg",
"jp": [
"「それが・・・",
"梨奈ちゃんのご両親は、",
"誰か見当ついてた気がするんよ」"
]
},
{
"id": 19244,
"kind": "msg",
"jp": [
"「はっきりそう言うてた",
"わけやないねんけどさ」"
]
},
{
"id": 19245,
"kind": "msg",
"jp": [
"「うちが、片方はみきちゃん",
"ちゃうかなって言うたら、",
"それで2つあるんですねって」"
]
},
{
"id": 19246,
"kind": "msg",
"jp": [
"「それで、2つ・・・」"
]
},
{
"id": 19247,
"kind": "msg",
"jp": [
"「そう、それって",
"みきちゃんやない方はもう",
"わかってるって事っぽいやん?」"
]
},
{
"id": 19248,
"kind": "msg",
"jp": [
"「・・・そうみたいだね」"
]
},
{
"id": 19249,
"kind": "msg",
"jp": [
"「だから親戚の人とか、",
"家族は知ってる人なんやろね」"
]
},
{
"id": 19250,
"kind": "msg",
"jp": [
"「まあ、誰やったとしても",
"梨奈ちゃんのこと哀しんでる人が",
"他にも{居/お}るってだけで・・・」"
]
},
{
"id": 19251,
"kind": "msg",
"jp": [
"「・・・それはそれだけで",
"ええかなって思たから、",
"あんまり誰やろって考えんかった」"
]
},
{
"id": 19252,
"kind": "msg",
"jp": [
"「それでいいんじゃないかな」"
]
},
{
"id": 19253,
"kind": "msg",
"jp": [
"「そうやんね。",
"うちが無理に聞き出して",
"ええことでもないやろうし」"
]
},
{
"id": 19254,
"kind": "msg",
"jp": [
"「梨奈ちゃんのために一緒に",
"泣いてくれた人が他にも{居/お}った",
"ことだけ覚えてくことにするわ」"
]
},
{
"id": 19255,
"kind": "msg",
"jp": [
"「・・・ごめんね、",
"辛いこと聞いちゃって」"
]
},
{
"id": 19256,
"kind": "msg",
"jp": [
"「ううん・・・」"
]
},
{
"id": 19257,
"kind": "msg",
"jp": [
"「こういう事ってなんか、",
"あんまり知らん人に話した方が",
"ちょっと気が楽になるやん」"
]
},
{
"id": 19258,
"kind": "msg",
"jp": [
"「うん、だってお姉ちゃんとか",
"梨奈ちゃん知ってる人と話すと",
"際限なく暗くなるからなぁ」"
]
},
{
"id": 19259,
"kind": "msg",
"jp": [
"「いつまでたっても",
"お通夜みたいやったら、",
"梨奈ちゃんも困るやんか?」"
]
},
{
"id": 19260,
"kind": "msg",
"jp": [
"「里江みどりさんって人知ってる?」"
]
},
{
"id": 19261,
"kind": "msg",
"jp": [
"「里江・・・?",
"知らんと思うけど、誰?」"
]
},
{
"id": 19262,
"kind": "msg",
"jp": [
"「かなり昔のアイドルみたい",
"なんだけど」"
]
},
{
"id": 19263,
"kind": "msg",
"jp": [
"「アイドルねえ・・・",
"うーん、うちは知らんわ」"
]
},
{
"id": 19264,
"kind": "msg",
"jp": [
"「えー?",
"そうやったん?」"
]
},
{
"id": 19265,
"kind": "msg",
"jp": [
"「アイドルねえ・・・",
"歌とか出してはったんかな」"
]
},
{
"id": 19266,
"kind": "msg",
"jp": [
"「そうみたいだよ」"
]
},
{
"id": 19267,
"kind": "msg",
"jp": [
"「ふーん、人に歴史ありやねぇ」"
]
},
{
"id": 19268,
"kind": "msg",
"jp": [
"「御陵さんやったら天然系で",
"可愛いアイドルやったんやろなぁ」"
]
},
{
"id": 19269,
"kind": "msg",
"jp": [
"「ルロイ伯爵って人知ってる?」"
]
},
{
"id": 19270,
"kind": "msg",
"jp": [
"「ルロイ?",
"どっかで聞いたなぁ・・・」"
]
},
{
"id": 19271,
"kind": "msg",
"jp": [
"「あ、なんか前にお姉ちゃんに",
"聞いたことある気がする。",
"なんか怖い人やなかった?」"
]
},
{
"id": 19272,
"kind": "msg",
"jp": [
"「た、多分その人」"
]
},
{
"id": 19273,
"kind": "msg",
"jp": [
"「うち、ああいうオカルト系",
"あんまり好きやないんよね」"
]
},
{
"id": 19274,
"kind": "msg",
"jp": [
"「僕も苦手・・・」"
]
},
{
"id": 19275,
"kind": "msg",
"jp": [
"「うん、それは見たらわかる」"
]
},
{
"id": 19276,
"kind": "msg",
"jp": [
"「北速水涼介って知ってる?",
"高遠さんの本に出てくる探偵の」"
]
},
{
"id": 19277,
"kind": "msg",
"jp": [
"「ああ、うん。",
"一応ちょっとだけ読んだし」"
]
},
{
"id": 19278,
"kind": "msg",
"jp": [
"「・・・けどさあ、名探偵って",
"なんでみんな変な人なん?」"
]
},
{
"id": 19279,
"kind": "msg",
"jp": [
"「さ、さあ・・・",
"僕もよく知らないけど、",
"みんな変な人なの・・・?」"
]
},
{
"id": 19280,
"kind": "msg",
"jp": [
"「・・・どうやろう。",
"お姉ちゃんが読んでる本に出てくる",
"やつは全員例外なく変人やったけど」"
]
},
{
"id": 19281,
"kind": "msg",
"jp": [
"「・・・そうか。",
"うちのお姉ちゃんがそういうの",
"選んで読んでるんかも・・・」"
]
},
{
"id": 19282,
"kind": "msg",
"jp": [
"「日織諒ってさ・・・",
"あ、本に出てくる方のだけど」"
]
},
{
"id": 19283,
"kind": "msg",
"jp": [
"「ああ、小説のキャラの方?",
"なんかやたら運の悪い人って",
"感じやったなあ」"
]
},
{
"id": 19284,
"kind": "msg",
"jp": [
"「お姉ちゃんが言うには、",
"日織の運が悪いのは八割方涼介の",
"せいらしいねんけどさ」"
]
},
{
"id": 19285,
"kind": "msg",
"jp": [
"「・・・なんでつるんでるんだろう」"
]
},
{
"id": 19286,
"kind": "msg",
"jp": [
"「腐れ縁なんとちゃう?」"
]
},
{
"id": 19287,
"kind": "msg",
"jp": [
"ああ・・・。",
"そういうのって切れないんだよなあ。"
]
},
{
"id": 19288,
"kind": "msg",
"jp": [
"「高遠さんの本に出てくる",
"陣野警部って覚えてる?」"
]
},
{
"id": 19289,
"kind": "msg",
"jp": [
"「ああ、おったんは覚えてるけど",
"あんまり・・・覚えてへんかな」"
]
},
{
"id": 19290,
"kind": "msg",
"jp": [
"「そんなに読んでへんからなあ",
"うちは、お姉ちゃんと違て」"
]
},
{
"id": 19291,
"kind": "msg",
"jp": [
"「波積駿二って人知ってる?」"
]
},
{
"id": 19292,
"kind": "msg",
"jp": [
"「・・・誰それ?」"
]
},
{
"id": 19293,
"kind": "msg",
"jp": [
"「高遠さんの本に出てくる人」"
]
},
{
"id": 19294,
"kind": "msg",
"jp": [
"「えぇ～?",
"レギュラーと違うよね」"
]
},
{
"id": 19295,
"kind": "msg",
"jp": [
"「うん、一作しか出てこないと思う」"
]
},
{
"id": 19296,
"kind": "msg",
"jp": [
"「ああ、やったら",
"読んでへんと思うわ、それ」"
]
},
{
"id": 19297,
"kind": "msg",
"jp": [
"「『黒猫の毒』に出てくる方の",
"斑井さんってさ・・・」"
]
},
{
"id": 19298,
"kind": "msg",
"jp": [
"「あ、ごめん。",
"その話読んでへんわ」"
]
},
{
"id": 19299,
"kind": "msg",
"jp": [
"「ああ、そうなんだ」"
]
},
{
"id": 19300,
"kind": "msg",
"jp": [
"「黒園龍哉って人が出てくる",
"話でさあ・・・」"
]
},
{
"id": 19301,
"kind": "msg",
"jp": [
"「誰それ?",
"うち知らんと思うけど」"
]
},
{
"id": 19302,
"kind": "msg",
"jp": [
"「『灰色の仮面』っていう",
"話に出てくる人」"
]
},
{
"id": 19303,
"kind": "msg",
"jp": [
"「・・・タイトルも覚えてへん。",
"家にはあるかもしれへんけど」"
]
},
{
"id": 19304,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは読んでない?」"
]
},
{
"id": 19305,
"kind": "msg",
"jp": [
"「うん、読んでへん」"
]
},
{
"id": 19306,
"kind": "msg",
"jp": [
"「古折みづえっていう人",
"覚えてる?」"
]
},
{
"id": 19307,
"kind": "msg",
"jp": [
"「え? 誰?」"
]
},
{
"id": 19308,
"kind": "msg",
"jp": [
"「『古折家の悪夢』に出てくる人」"
]
},
{
"id": 19309,
"kind": "msg",
"jp": [
"「なにそれ?",
"高遠さんの本?」"
]
},
{
"id": 19310,
"kind": "msg",
"jp": [
"「覚えてへんなあ、",
"読んでないわ、それ」"
]
},
{
"id": 19311,
"kind": "msg",
"jp": [
"「『鬼の密室』って話に出てくる",
"佐伯老人って知ってる?」"
]
},
{
"id": 19312,
"kind": "msg",
"jp": [
"「その話、読んでへんから",
"わからへんわ」"
]
},
{
"id": 19313,
"kind": "msg",
"jp": [
"「そっか、じゃあ知らないね」"
]
},
{
"id": 19314,
"kind": "msg",
"jp": [
"「暁生光起って人知ってる?」"
]
},
{
"id": 19315,
"kind": "msg",
"jp": [
"「・・・どっかで聞いた気がする。",
"誰やったっけ、それ」"
]
},
{
"id": 19316,
"kind": "msg",
"jp": [
"「『死神の鎌』に出てくる人だよ。",
"高遠延二郎の」"
]
},
{
"id": 19317,
"kind": "msg",
"jp": [
"「ああ、思い出した。",
"それは読んだわ」"
]
},
{
"id": 19318,
"kind": "msg",
"jp": [
"「・・・けど、今回の事件とは",
"関係なさそうな話やなかった?」"
]
},
{
"id": 19319,
"kind": "msg",
"jp": [
"「やっぱりそうかな」"
]
},
{
"id": 19320,
"kind": "msg",
"jp": [
"同じ名前の人出てこないもんな。"
]
},
{
"id": 19321,
"kind": "msg",
"jp": [
"「あのさ、滝重三郎って人知らない?」"
]
},
{
"id": 19322,
"kind": "msg",
"jp": [
"「滝重・・・?",
"ううん、そんな人知り合いにおらんよ」"
]
},
{
"id": 19323,
"kind": "msg",
"jp": [
"「あ、小説に出てくる人なんだよ。",
"高遠延二郎の」"
]
},
{
"id": 19324,
"kind": "msg",
"jp": [
"「ああ、それは知らんわ。",
"読んでへんと思うし」"
]
},
{
"id": 19325,
"kind": "msg",
"jp": [
"「小此木って人知ってる?",
"『壺の中の謎』って話に出てくる",
"古物商なんだけど」"
]
},
{
"id": 19326,
"kind": "msg",
"jp": [
"「古物商って・・・ああ、",
"それ多分、お姉ちゃんが気に入ってる",
"話とちゃうかな」"
]
},
{
"id": 19327,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは読んだ?」"
]
},
{
"id": 19328,
"kind": "msg",
"jp": [
"「ううん、なんか不気味な",
"話みたいやったから」"
]
},
{
"id": 19329,
"kind": "msg",
"jp": [
"不気味なのか・・・。",
"それを気に入ってる静奈ちゃんって",
"いったい・・・。"
]
},
{
"id": 19330,
"kind": "msg",
"jp": [
"「『湖畔の館』って話に",
"出てくる方の那須さん知ってる?」"
]
},
{
"id": 19331,
"kind": "msg",
"jp": [
"「あー、それ読んでへん。",
"けど、お姉ちゃんが全然似てないて",
"言うてたで」"
]
},
{
"id": 19332,
"kind": "msg",
"jp": [
"「ふぅん?」"
]
},
{
"id": 19333,
"kind": "msg",
"jp": [
"「まあ、あの那須さんに似た人って",
"高遠延二郎の話には出てきそうに",
"ないけどさ」"
]
},
{
"id": 19334,
"kind": "msg",
"jp": [
"・・・そもそも推理小説にほとんど",
"出てこないだろう・・・。"
]
},
{
"id": 19335,
"kind": "msg",
"jp": [
"「『忘れじの島』に出てくる",
"ともえって女の人知ってる?」"
]
},
{
"id": 19336,
"kind": "msg",
"jp": [
"「あ、知ってる。",
"なんかお姉ちゃんが一番好きな",
"話に出てくる人やわ」"
]
},
{
"id": 19337,
"kind": "msg",
"jp": [
"「一番気に入ってるの?」"
]
},
{
"id": 19338,
"kind": "msg",
"jp": [
"「そない言うてたよ」"
]
},
{
"id": 19339,
"kind": "msg",
"jp": [
"「ふぅん?",
"どんな話なのかな」"
]
},
{
"id": 19340,
"kind": "msg",
"jp": [
"「あー、うちも読んでへんのよね。",
"おもしろいから読めって言われてん",
"ねんけどさ・・・」"
]
},
{
"id": 19341,
"kind": "msg",
"jp": [
"「高遠さんの本で、御陵さんが",
"出てくるやつもう読んだ?」"
]
},
{
"id": 19342,
"kind": "msg",
"jp": [
"「まだ読んでへんと思うわ。",
"タイトルなんやったっけ」"
]
},
{
"id": 19343,
"kind": "msg",
"jp": [
"「『檻の中の女』って話」"
]
},
{
"id": 19344,
"kind": "msg",
"jp": [
"「ああ、それ読んでへん」"
]
},
{
"id": 19345,
"kind": "msg",
"jp": [
"「暗石さんが出てくる話読んだ?",
"『忌まわしい花』って話」"
]
},
{
"id": 19346,
"kind": "msg",
"jp": [
"「うん、それは読んだ。",
"こっちの暗石さんが同じ役やっても",
"あんま違和感ない感じ」"
]
},
{
"id": 19347,
"kind": "msg",
"jp": [
"「まあ、暗石さん上手いから",
"何やってもそれなりにハマるやろうけど」"
]
},
{
"id": 19348,
"kind": "msg",
"jp": [
"「ふーん、なるほどね・・・」"
]
},
{
"id": 19349,
"kind": "msg",
"jp": [
"「絹田ユリって人知ってる?」"
]
},
{
"id": 19350,
"kind": "msg",
"jp": [
"「えーっと、誰やっけ?」"
]
},
{
"id": 19351,
"kind": "msg",
"jp": [
"「『花魁はなぜ殺される』って",
"いう話に出てくる・・・」"
]
},
{
"id": 19352,
"kind": "msg",
"jp": [
"「ああ、女優さんやったかな。",
"お姉ちゃんが読んでたわ」"
]
},
{
"id": 19353,
"kind": "msg",
"jp": [
"「うちはまだ読んでないねん」"
]
},
{
"id": 19354,
"kind": "msg",
"jp": [
"「椿くんが出てくる話",
"読んだことある?」"
]
},
{
"id": 19355,
"kind": "msg",
"jp": [
"「高遠さんの?",
"それまだ読んでへんけど、そっちの",
"椿さんて執事さん違うねんてな」"
]
},
{
"id": 19356,
"kind": "msg",
"jp": [
"「うん、当主らしいよ」"
]
},
{
"id": 19357,
"kind": "msg",
"jp": [
"「ふーん?",
"こっちはなんで執事なんかな」"
]
},
{
"id": 19358,
"kind": "msg",
"jp": [
"「東雲多岐って人知ってる?",
"『絵の中の死』に出てくる人」"
]
},
{
"id": 19359,
"kind": "msg",
"jp": [
"「えーっとな・・・",
"ちょお待って、その話読んだはず",
"やねんけど・・・」"
]
},
{
"id": 19360,
"kind": "msg",
"jp": [
"「どんなんやったかなぁ、",
"なんか暗い話やったような",
"記憶はあるんやけど」"
]
},
{
"id": 19361,
"kind": "msg",
"jp": [
"「あんまり覚えてない?」"
]
},
{
"id": 19362,
"kind": "msg",
"jp": [
"「うん、かなり前やし、読んだの」"
]
},
{
"id": 19363,
"kind": "msg",
"jp": [
"「『悪魔の花園』に出てくる",
"鈴奈ちゃん達ってさ・・・」"
]
},
{
"id": 19364,
"kind": "msg",
"jp": [
"「待って! それは待って!",
"うち、今それ読んでる最中やねん!」"
]
},
{
"id": 19365,
"kind": "msg",
"jp": [
"「先にネタバレ聞いたりしたら",
"お姉ちゃんにしばかれる・・・」"
]
},
{
"id": 19366,
"kind": "msg",
"jp": [
"「うん、きっと布団の中に",
"こっそり変なもの入れられたりする」"
]
},
{
"id": 19367,
"kind": "msg",
"jp": [
"それは、お仕置きなんだろうか・・・。"
]
},
{
"id": 19368,
"kind": "msg",
"jp": [
"「虚井家って知ってる?",
"高遠さんの小説に出てくる・・・」"
]
},
{
"id": 19369,
"kind": "msg",
"jp": [
"「・・・なんか聞いたことは",
"あるんやけど・・・」"
]
},
{
"id": 19370,
"kind": "msg",
"jp": [
"「思い出されへん。",
"多分、お姉ちゃんに聞いただけで",
"読んでないんやと思うわ」"
]
},
{
"id": 19371,
"kind": "msg",
"jp": [
"「今時さあ、ばあやさんが",
"いるような家ってどんなんだろう?」"
]
},
{
"id": 19372,
"kind": "msg",
"jp": [
"「なんやのん、それ?",
"うちはばあやよりメイドさんのが",
"ええけどさ」"
]
},
{
"id": 19373,
"kind": "msg",
"jp": [
"「メイドさん?",
"自分でやるの?」"
]
},
{
"id": 19374,
"kind": "msg",
"jp": [
"「なんでやっ!?」"
]
},
{
"id": 19375,
"kind": "msg",
"jp": [
"「似合いそうだと思って・・・」"
]
},
{
"id": 19376,
"kind": "msg",
"jp": [
"「自分でやりたいんと違うっ!",
"どうせならメイドさんがお世話して",
"くれるほうが嬉しいって話!!」"
]
},
{
"id": 19377,
"kind": "msg",
"jp": [
"「・・・お兄さん、",
"メイドさんよりばあやがええの?」"
]
},
{
"id": 19378,
"kind": "msg",
"jp": [
"「へ? 僕?」"
]
},
{
"id": 19379,
"kind": "msg",
"jp": [
"「そりゃまあ、",
"可愛いメイドさんのがいいけど」"
]
},
{
"id": 19380,
"kind": "msg",
"jp": [
"「そうやろ?",
"やっぱそうやんなあ」"
]
},
{
"id": 19381,
"kind": "msg",
"jp": [
"なんでそんなに力強く",
"頷くんだろう・・・。"
]
},
{
"id": 19382,
"kind": "msg",
"jp": [
"「僕はばあやの方がいいなあ」"
]
},
{
"id": 19383,
"kind": "msg",
"jp": [
"「だって緊張するもん、",
"若い女の子のメイドさんなんて」"
]
},
{
"id": 19384,
"kind": "msg",
"jp": [
"「男としてどうなん、それは」"
]
},
{
"id": 19385,
"kind": "msg",
"jp": [
"呆れられてしまった・・・。"
]
},
{
"id": 19386,
"kind": "msg",
"jp": [
"「ここにみんなを集めたのって",
"帽子屋本人だと思う?」"
]
},
{
"id": 19387,
"kind": "msg",
"jp": [
"「どっちか言うたら",
"思いたい、かもしれんけど」"
]
},
{
"id": 19388,
"kind": "msg",
"jp": [
"「思いたい?」"
]
},
{
"id": 19389,
"kind": "msg",
"jp": [
"「だってもしうちら集めたんが",
"帽子屋やとしたら、帽子屋が犯人て",
"可能性が一番高いやん」"
]
},
{
"id": 19390,
"kind": "msg",
"jp": [
"「なんかなぁ・・・。",
"なんぼ胡散臭い変わり者でもさ、",
"犯罪者やないと思いたいやん」"
]
},
{
"id": 19391,
"kind": "msg",
"jp": [
"「・・・暗石さんのことなんだけど」"
]
},
{
"id": 19392,
"kind": "msg",
"jp": [
"「え? 何かわかったん?」"
]
},
{
"id": 19393,
"kind": "msg",
"jp": [
"「御陵さんがさ、朝早くに廊下で",
"見かけたって言っててさ」"
]
},
{
"id": 19394,
"kind": "msg",
"jp": [
"「えーと、最初の日から数えて",
"5日目の朝早くだって」"
]
},
{
"id": 19395,
"kind": "msg",
"jp": [
"「5日目・・・?」"
]
},
{
"id": 19396,
"kind": "msg",
"jp": [
"「あ、あー・・・",
"うちがかなり早く目ぇ覚めた日かな」"
]
},
{
"id": 19397,
"kind": "msg",
"jp": [
"「そうなの?",
"部屋から出た?」"
]
},
{
"id": 19398,
"kind": "msg",
"jp": [
"「・・・お風呂入ってた」"
]
},
{
"id": 19399,
"kind": "msg",
"jp": [
"「うん、上がったん7時前かな。",
"部屋に戻って・・・」"
]
},
{
"id": 19400,
"kind": "msg",
"jp": [
"「・・・けど、うちが見かけたんは",
"暗石さんやなくて着流しのお兄さん",
"やったなぁ」"
]
},
{
"id": 19401,
"kind": "msg",
"jp": [
"「日織に会ったの?」"
]
},
{
"id": 19402,
"kind": "msg",
"jp": [
"「会うたいうても2階のトイレに",
"入ってくん見ただけやけどね」"
]
},
{
"id": 19403,
"kind": "msg",
"jp": [
"「その後、7時過ぎにお姉ちゃん",
"起こしに行って、台所に降りたんが",
"7時半か、もうちょい後かな」"
]
},
{
"id": 19404,
"kind": "msg",
"jp": [
"「鈴奈ちゃんの部屋の",
"名前ってなんだったっけ」"
]
},
{
"id": 19405,
"kind": "msg",
"jp": [
"「なんやっけ。",
"なんかアメリカの大統領",
"みたいな名前」"
]
},
{
"id": 19406,
"kind": "msg",
"jp": [
"「大統領・・・?」"
]
},
{
"id": 19407,
"kind": "msg",
"jp": [
"「クリントンとかワシントンとか",
"ルーズベルトとかじゃなくて、",
"もっとあっさりしたやつで」"
]
},
{
"id": 19408,
"kind": "msg",
"jp": [
"「ブッシュ?」"
]
},
{
"id": 19409,
"kind": "msg",
"jp": [
"「そげぇ最近の人じゃねえって、",
"もっと昔の人じゃ!」"
]
},
{
"id": 19410,
"kind": "msg",
"jp": [
"「・・・じゃ?」"
]
},
{
"id": 19411,
"kind": "msg",
"jp": [
"「ちょお待ち、",
"今思い出しかけよるけぇ、",
"待ちって・・・」"
]
},
{
"id": 19412,
"kind": "msg",
"jp": [
"「なんか伸ばす音が入っとるん、",
"えーと、プーチン・・・違うし」"
]
},
{
"id": 19413,
"kind": "msg",
"jp": [
"「あのそれ、ロシア・・・」"
]
},
{
"id": 19414,
"kind": "msg",
"jp": [
"「そうじゃ、なんでロシアが",
"出てくるんな!?」"
]
},
{
"id": 19415,
"kind": "msg",
"jp": [
"「・・・謝らんでも」"
]
},
{
"id": 19416,
"kind": "msg",
"jp": [
"「い、いや、だって」"
]
},
{
"id": 19417,
"kind": "msg",
"jp": [
"「怯えんとってよ。",
"ちょっと思い出せんけぇ",
"地が出ただけやん」"
]
},
{
"id": 19418,
"kind": "msg",
"jp": [
"「・・・普段、方言",
"押さえて喋ってるんだね」"
]
},
{
"id": 19419,
"kind": "msg",
"jp": [
"「そうせな、",
"みんな、うちとお姉ちゃんが",
"なに言うてるかわからんやん」"
]
},
{
"id": 19420,
"kind": "msg",
"jp": [
"「・・・って、何の話",
"やったっけ?",
"ああ、うちの部屋の名前か」"
]
},
{
"id": 19421,
"kind": "msg",
"jp": [
"「思い出した?」"
]
},
{
"id": 19422,
"kind": "msg",
"jp": [
"「あかん。",
"出て来んから勝手に調べて」"
]
},
{
"id": 19423,
"kind": "msg",
"jp": [
"「・・・わかった」"
]
},
{
"id": 19424,
"kind": "msg",
"jp": [
"「藍瀬みきちゃんて知ってる?」"
]
},
{
"id": 19425,
"kind": "msg",
"jp": [
"「・・・ああ、名前はね」"
]
},
{
"id": 19426,
"kind": "msg",
"jp": [
"「仕事で一緒になったり",
"したことはないんだ?」"
]
},
{
"id": 19427,
"kind": "msg",
"jp": [
"「うん。",
"だから、どんな子なんかも・・・」"
]
},
{
"id": 19428,
"kind": "msg",
"jp": [
"「・・・いや、まあ",
"普通の子なんやろうけどさ」"
]
},
{
"id": 19429,
"kind": "msg",
"jp": [
"なんだか歯切れの悪い喋り方の",
"ような気がした・・・。"
]
},
{
"id": 19430,
"kind": "msg",
"jp": [
"「そら知ってるよ。",
"一応女優やってんのに",
"知らんわけないって」"
]
},
{
"id": 19431,
"kind": "msg",
"jp": [
"「かっこええ姐さんやで、",
"怒ったら怖いけど」"
]
},
{
"id": 19432,
"kind": "msg",
"jp": [
"「怒られたことあるの?」"
]
},
{
"id": 19433,
"kind": "msg",
"jp": [
"「幸いうちはないけど、",
"怒られてるとこ見たことある」"
]
},
{
"id": 19434,
"kind": "msg",
"jp": [
"「怒鳴ったりせんのよ。",
"すんごい迫力でにらんで",
"淡々と説教するん」"
]
},
{
"id": 19435,
"kind": "msg",
"jp": [
"「こ、怖そうだね」"
]
},
{
"id": 19436,
"kind": "msg",
"jp": [
"「怒られてる人、",
"気絶しそうになってたわ」"
]
},
{
"id": 19437,
"kind": "msg",
"jp": [
"・・・僕なら気絶してるな。"
]
},
{
"id": 19438,
"kind": "msg",
"jp": [
"「成瀬公康っていう人",
"知らない?」"
]
},
{
"id": 19439,
"kind": "msg",
"jp": [
"「へ? 誰それ」"
]
},
{
"id": 19440,
"kind": "msg",
"jp": [
"「書斎にあった本で",
"名前見かけたんだけど・・・」"
]
},
{
"id": 19441,
"kind": "msg",
"jp": [
"「なんか有名な人なん?",
"昔の総理大臣とか」"
]
},
{
"id": 19442,
"kind": "msg",
"jp": [
"「いや、そんな昔の人じゃ",
"ないみたいだけど」"
]
},
{
"id": 19443,
"kind": "msg",
"jp": [
"「ふうん?",
"うちは全然知らんわ」"
]
},
{
"id": 19444,
"kind": "msg",
"jp": [
"「あのさ、マリアンヌって",
"ヒロインが出てくる話知ってる?」"
]
},
{
"id": 19445,
"kind": "msg",
"jp": [
"「・・・もしかしてあの、",
"目の中に星が飛んでそうな",
"ロマンス小説の?」"
]
},
{
"id": 19446,
"kind": "msg",
"jp": [
"「・・・うちの、母親が",
"ファンクラブ入ってる・・・」"
]
},
{
"id": 19447,
"kind": "msg",
"jp": [
"「うちは・・・",
"苦手やねんけどな・・・」"
]
},
{
"id": 19448,
"kind": "msg",
"jp": [
"なんだか辛そうだ・・・。"
]
},
{
"id": 19449,
"kind": "msg",
"jp": [
"「ハリー・キッドマンって",
"探偵知ってる?」"
]
},
{
"id": 19450,
"kind": "msg",
"jp": [
"「・・・?",
"どっかで聞いた事ある",
"気がするなあ・・・」"
]
},
{
"id": 19451,
"kind": "msg",
"jp": [
"「読んだ覚えはないし",
"お姉ちゃんに聞いたんかな。",
"どんな人?」"
]
},
{
"id": 19452,
"kind": "msg",
"jp": [
"「僕もよく知らないけど",
"影の薄い・・・」"
]
},
{
"id": 19453,
"kind": "msg",
"jp": [
"「あーっ!",
"思い出したっ!!」"
]
},
{
"id": 19454,
"kind": "msg",
"jp": [
"「くそ暑い中をお姉ちゃんに、",
"丸一日古本屋巡りつき合わされた",
"アイツのことかあっ!!」"
]
},
{
"id": 19455,
"kind": "msg",
"jp": [
"「丸一日・・・」"
]
},
{
"id": 19456,
"kind": "msg",
"jp": [
"「なんか絶版になってる",
"とかで普通の本屋になくてな」"
]
},
{
"id": 19457,
"kind": "msg",
"jp": [
"「暑かった・・・",
"あの時はもうホンマに・・・」"
]
},
{
"id": 19458,
"kind": "msg",
"jp": [
"「た、大変だったね・・・」"
]
},
{
"id": 19459,
"kind": "msg",
"jp": [
"「・・・まあ、10何軒目かで",
"見つかった時の喜びようったら",
"なかったし、ええねんけどさ」"
]
},
{
"id": 19460,
"kind": "msg",
"jp": [
"（大喜びする静奈ちゃんて",
"どんなんだろう・・・）"
]
},
{
"id": 19461,
"kind": "msg",
"jp": [
"なんか、いまいち想像",
"出来ないな。"
]
},
{
"id": 19462,
"kind": "msg",
"jp": [
"「本物の執事って",
"会ったことある?」"
]
},
{
"id": 19463,
"kind": "msg",
"jp": [
"「まさか。",
"そんなん今どき実在すんの?」"
]
},
{
"id": 19464,
"kind": "msg",
"jp": [
"「一応、いないことは",
"ないんじゃないかな」"
]
},
{
"id": 19465,
"kind": "msg",
"jp": [
"「ふーん?",
"やっぱ、こんな家住んでるような",
"人んとこにおるんかなあ」"
]
},
{
"id": 19466,
"kind": "msg",
"jp": [
"「・・・けどさ、執事って",
"基本的には何をする人なん?」"
]
},
{
"id": 19467,
"kind": "msg",
"jp": [
"「秘書とかとは違うやろ?",
"使用人の中で一番偉い人",
"みたいな感じ?」"
]
},
{
"id": 19468,
"kind": "msg",
"jp": [
"「・・・そう言えば",
"僕もよく知らないや」"
]
},
{
"id": 19469,
"kind": "msg",
"jp": [
"「そやんなぁ。",
"ホンマはどういうもんなんやろ」"
]
},
{
"id": 19470,
"kind": "msg",
"jp": [
"「少なくとも、家の中で",
"ダンベル振り回す人怒鳴るんが",
"仕事ではないわな」"
]
},
{
"id": 19471,
"kind": "msg",
"jp": [
"「・・・あれは特殊すぎると",
"思うよ・・・」"
]
},
{
"id": 19472,
"kind": "msg",
"jp": [
"「あのさ、兄弟って・・・」"
]
},
{
"id": 19473,
"kind": "msg",
"jp": [
"「そうや!",
"アンタ一人っ子?」"
]
},
{
"id": 19474,
"kind": "msg",
"jp": [
"「へ? 僕?",
"いや、違うけど」"
]
},
{
"id": 19475,
"kind": "msg",
"jp": [
"「なんとなく上に兄弟が",
"いそうな気がしてん」"
]
},
{
"id": 19476,
"kind": "msg",
"jp": [
"「うん、姉ちゃんが・・・」"
]
},
{
"id": 19477,
