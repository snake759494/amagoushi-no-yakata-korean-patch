]
},
{
"id": 19595,
"kind": "msg",
"jp": [
"「うん・・・まあね」"
]
},
{
"id": 19596,
"kind": "msg",
"jp": [
"「・・・あんまり」"
]
},
{
"id": 19597,
"kind": "msg",
"jp": [
"「知らん」"
]
},
{
"id": 19598,
"kind": "msg",
"jp": [
"一言だった・・・。"
]
},
{
"id": 19599,
"kind": "msg",
"jp": [
"「・・・言うとくけどな」"
]
},
{
"id": 19600,
"kind": "msg",
"jp": [
"「変なんは",
