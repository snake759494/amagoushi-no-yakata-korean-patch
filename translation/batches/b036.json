]
},
{
"id": 19610,
"kind": "msg",
"jp": [
"「知らん、うち見たことない」"
]
},
{
"id": 19611,
"kind": "msg",
"jp": [
"「あ、そうなんだ・・・」"
]
},
{
"id": 19612,
"kind": "msg",
"jp": [
"「・・・見てへん」"
]
},
{
"id": 19613,
"kind": "msg",
"jp": [
"なんだかやけに不愉快そうに",
