},
{
"id": 19591,
"kind": "msg",
"jp": [
"「ああ、そやったね」"
]
},
{
"id": 19592,
"kind": "msg",
"jp": [
"なんか、そっけない・・・。"
]
},
{
"id": 19593,
"kind": "msg",
"jp": [
