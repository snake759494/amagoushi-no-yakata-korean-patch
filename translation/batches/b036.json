]
},
{
"id": 19602,
"kind": "msg",
"jp": [
"どういう社長なんだ、一体。"
]
},
{
"id": 19603,
"kind": "msg",
"jp": [
"「・・・書斎になんか",
"あったらしいのはな」"
]
},
{
"id": 19604,
"kind": "msg",
"jp": [
"「けど、どんな会なんか",
"までは知らんで」"
]
},
{
"id": 19605,
"kind": "msg",
"jp": [
"「アンタまさか好きなん?」"
]
},
{
"id": 19606,
"kind": "msg",
"jp": [
"「好きじゃない好きじゃない」"
]
},
{
"id": 19607,
"kind": "msg",
"jp": [
