[
{
"id": 11160,
"kind": "msg",
"jp": [
"「俺は事務所っつーか",
"映画会社なんだがな」"
]
},
{
"id": 11161,
"kind": "msg",
"jp": [
"「そうなんですか?」"
]
},
{
"id": 11162,
"kind": "msg",
"jp": [
"「最近の若い奴は知らんのか?",
"昔は映画俳優ってぇと大抵は",
"映画会社のお抱えだったもんだ」"
]
},
{
"id": 11163,
"kind": "msg",
"jp": [
"「あの頃の主役級だった人らも",
"ずいぶん減っちまったなぁ」"
]
},
{
"id": 11164,
"kind": "msg",
"jp": [
"「気が向いたら古い映画も",
"たまには見てみろ。",
"昔の俳優はすげぇぞ」"
]
},
{
"id": 11165,
"kind": "msg",
"jp": [
"「あ、はい。",
"そうします」"
]
},
{
"id": 11166,
"kind": "msg",
"jp": [
"「仮面愛好会って",
"ご存知ですか?」"
]
},
{
"id": 11167,
"kind": "msg",
"jp": [
"「書斎に会報があったんで",
"なんだろうと思って・・・」"
]
},
{
"id": 11168,
"kind": "msg",
"jp": [
"「はぁん・・・?",
"愛好会ねえ・・・」"
]
},
{
"id": 11169,
"kind": "msg",
"jp": [
"「色んな趣味の奴が",
"いるもんだな」"
]
},
{
"id": 11170,
"kind": "msg",
"jp": [
"「不思議ビバレーツの",
"飲み物は普段買うことあります?」"
]
},
{
"id": 11171,
"kind": "msg",
"jp": [
"「あんまりねぇなあ・・・",
"まともなのあるのか?」"
]
},
{
"id": 11172,
"kind": "msg",
"jp": [
"「うちの姉が言うには、",
"奇跡的においしいのがいくつか",
"あるって話なんですが」"
]
},
{
"id": 11173,
"kind": "msg",
"jp": [
"「奇跡が起きねぇと美味いもの",
"作れん会社ってどうなんだよ」"
]
},
{
"id": 11174,
"kind": "msg",
"jp": [
"「・・・何か間違ってますね」"
]
},
{
"id": 11175,
"kind": "msg",
"jp": [
"「なんで潰れねぇんだか」"
]
},
{
"id": 11176,
"kind": "msg",
"jp": [
"「なんか・・・",
"一部に熱狂的な",
"ファンがいるみたいで」"
]
},
{
"id": 11177,
"kind": "msg",
"jp": [
"うちの姉とか、大学の先輩とか。",
"なんか身近にけっこういる・・。"
]
},
{
"id": 11178,
"kind": "msg",
"jp": [
"「そういや、新製品が出ると",
"喜んで買ってくる若いのが",
"けっこういるな・・・」"
]
},
{
"id": 11179,
"kind": "msg",
"jp": [
"「あれか、一種の博打みてぇな",
"楽しみがあるのか」"
]
},
{
"id": 11180,
"kind": "msg",
"jp": [
"「そうかもしれないです」"
]
},
{
"id": 11181,
"kind": "msg",
"jp": [
"「・・・近頃の若い奴らは",
"よくわからん・・・」"
]
},
{
"id": 11182,
"kind": "msg",
"jp": [
"「今回の脚本ってどんな話",
"なんですか?」"
]
},
{
"id": 11183,
"kind": "msg",
"jp": [
"「こんな序盤しかねえんじゃ",
"どういう話なのかさっぱりだ」"
]
},
{
"id": 11184,
"kind": "msg",
"jp": [
"「はあ・・・",
"やっぱりそうですか」"
]
},
{
"id": 11185,
"kind": "msg",
"jp": [
"「あの、『白夜』ってビデオ映画の",
"打ち上げのことで他に覚えてること",
"ないですか?」"
]
},
{
"id": 11186,
"kind": "msg",
"jp": [
"「・・・そうだな」"
]
},
{
"id": 11187,
"kind": "msg",
"jp": [
"「前に話したこと以外でってぇと",
"ちょっとひっかかること",
"思い出したんだがな・・・」"
]
},
{
"id": 11188,
"kind": "msg",
"jp": [
"「最後の方に顔出したヤツがな、",
"『白夜』には関係ないスタッフだったと",
"思うんだが・・・」"
]
},
{
"id": 11189,
"kind": "msg",
"jp": [
"「・・・『帽子屋を探してる』みてぇな",
"ことを言ってた気がするんだよ」"
]
},
{
"id": 11190,
"kind": "msg",
"jp": [
"「帽子屋・・・!」"
]
},
{
"id": 11191,
"kind": "msg",
"jp": [
"「それじゃ、帽子屋が",
"その場に・・・」"
]
},
{
"id": 11192,
"kind": "msg",
"jp": [
"「はっきり聞いたわけじゃねえから",
"間違いないとは言えんぞ」"
]
},
{
"id": 11193,
"kind": "msg",
"jp": [
"「他の連中もいたはずだから",
"聞いてみてくれ」"
]
},
{
"id": 11194,
"kind": "msg",
"jp": [
"だけど、その人はおそらく、その場に",
"帽子屋が居ると思って探してたはずだ。"
]
},
{
"id": 11195,
"kind": "msg",
"jp": [
"あてずっぽうで関係ない芝居の打ち上げ",
"なんかで探し回るわけもないし・・・。"
]
},
{
"id": 11196,
"kind": "msg",
"jp": [
"「暗石さん、虹色の愛の架け橋って",
"見た事ありますか?」"
]
},
{
"id": 11197,
"kind": "msg",
"jp": [
"「あー、まあ当時はすげえ",
"流行ったからな、何回かはな」"
]
},
{
"id": 11198,
"kind": "msg",
"jp": [
"「俺はああいう焦れってえ話は",
"あんまり好きじゃねえけど」"
]
},
{
"id": 11199,
"kind": "msg",
"jp": [
"焦れったい話なのか・・・。"
]
},
{
"id": 11200,
"kind": "msg",
"jp": [
"「麻雀地獄伝説って知ってます?」"
]
},
{
"id": 11201,
"kind": "msg",
"jp": [
"「ああ、あれか。",
"一作目でヤクザの役やったなあ」"
]
},
{
"id": 11202,
"kind": "msg",
"jp": [
"「え、暗石さん出てるんですか?」"
]
},
{
"id": 11203,
"kind": "msg",
"jp": [
"「出てきて5分で敵のヤクザに",
"車ごと爆破されるけどな」"
]
},
{
"id": 11204,
"kind": "msg",
"jp": [
"「・・・壮絶な役ですね」"
]
},
{
"id": 11205,
"kind": "msg",
"jp": [
"「暗石さん、",
"『白蛇殺人事件』って話",
"読んだ事あります?」"
]
},
{
"id": 11206,
"kind": "msg",
"jp": [
"「なんだそりゃ?",
"推理小説か?」"
]
},
{
"id": 11207,
"kind": "msg",
"jp": [
"「高遠延二郎の・・・」"
]
},
{
"id": 11208,
"kind": "msg",
"jp": [
"「ああ、高遠か。",
"それは覚えねえなあ、",
"多分読んでねえと思うぜ」"
]
},
{
"id": 11209,
"kind": "msg",
"jp": [
"「あのー、",
"アメフラシ戦記って",
"知ってます?」"
]
},
{
"id": 11210,
"kind": "msg",
"jp": [
"「あめふらし・・・?」"
]
},
{
"id": 11211,
"kind": "msg",
"jp": [
"「戦記って戦の記録の戦記か?",
"どんな戦記だそりゃ」"
]
},
{
"id": 11212,
"kind": "msg",
"jp": [
"「ゲームらしいです。",
"RPGっていうやつ」"
]
},
{
"id": 11213,
"kind": "msg",
"jp": [
"「あー、娘がよくやってる",
"テレビゲームの類か?」"
]
},
{
"id": 11214,
"kind": "msg",
"jp": [
"「しかし、そんな妙なタイトル",
"聞いた事ねぇな」"
]
},
{
"id": 11215,
"kind": "msg",
"jp": [
"「あかつきの白いバラっていう",
"ドラマご存じですか?」"
]
},
{
"id": 11216,
"kind": "msg",
"jp": [
"「そりゃお前、この業界に居りゃ",
"嫌でも知ってる話だからな」"
]
},
{
"id": 11217,
"kind": "msg",
"jp": [
"「お前さんはしかし、",
"放映されてた頃まだガキか」"
]
},
{
"id": 11218,
"kind": "msg",
"jp": [
"「暗石さん、出てたりとか・・・」"
]
},
{
"id": 11219,
"kind": "msg",
"jp": [
"「いや、幸い出てねぇよ」"
]
},
{
"id": 11220,
"kind": "msg",
"jp": [
"「幸い?」"
]
},
{
"id": 11221,
"kind": "msg",
"jp": [
"「あれに出てた役者も撮ったスタッフも",
"業界に残ってる奴ほとんどいねぇし",
"もう死んじまった奴も・・・」"
]
},
{
"id": 11222,
"kind": "msg",
"jp": [
"「あ、あの、そうですか。",
"わかりました」"
]
},
{
"id": 11223,
"kind": "msg",
"jp": [
"なんか怖い話になりそうだった・・・。"
]
},
{
"id": 11224,
"kind": "msg",
"jp": [
"「この館って相当古いですよね」"
]
},
{
"id": 11225,
"kind": "msg",
"jp": [
"「古いんだろうなあ・・・」"
]
},
{
"id": 11226,
"kind": "msg",
"jp": [
"「こういう古い建物ってのは、",
"こう、なんか出そうだよな」"
]
},
{
"id": 11227,
"kind": "msg",
"jp": [
"「な、なんかって・・・」"
]
},
{
"id": 11228,
"kind": "msg",
"jp": [
"「だから夜中に・・・」"
]
},
{
"id": 11229,
"kind": "msg",
"jp": [
"「わああっ!",
"もういいですっ!!」"
]
},
{
"id": 11230,
"kind": "msg",
"jp": [
"「暗石さん、",
"初日に閉じた後、食堂には",
"入ったりしてないですよね」"
]
},
{
"id": 11231,
"kind": "msg",
"jp": [
"「食堂の方には入ってねえぞ。",
"食い物持っていく時台所には",
"入ったけどな」"
]
},
{
"id": 11232,
"kind": "msg",
"jp": [
"「そうですよね」"
]
},
{
"id": 11233,
"kind": "msg",
"jp": [
"「あの、裏庭の井戸なんですけど」"
]
},
{
"id": 11234,
"kind": "msg",
"jp": [
"「・・・死体があったってヤツか」"
]
},
{
"id": 11235,
"kind": "msg",
"jp": [
"「はい、あの・・・",
"のぞいてみたりしました?」"
]
},
{
"id": 11236,
"kind": "msg",
"jp": [
"「するわけねえだろ、",
"んな悪趣味なこと」"
]
},
{
"id": 11237,
"kind": "msg",
"jp": [
"「で、ですよね」"
]
},
{
"id": 11238,
"kind": "msg",
"jp": [
"「暗石さんの部屋にもベランダって",
"ないですよね」"
]
},
{
"id": 11239,
"kind": "msg",
"jp": [
"「ん? ああ、ねえな。",
"向こう側の部屋にしかねえんだろ、",
"女性陣のいる方」"
]
},
{
"id": 11240,
"kind": "msg",
"jp": [
"「そうみたいです。",
"僕らの部屋にもないですし」"
]
},
{
"id": 11241,
"kind": "msg",
"jp": [
"「ねえ方が気楽でいいだろ。",
"あんなもんあると他の部屋から",
"こっちにも入り込めるじゃねえか」"
]
},
{
"id": 11242,
"kind": "msg",
"jp": [
"「居間の外にテラスが",
"ありますよね」"
]
},
{
"id": 11243,
"kind": "msg",
"jp": [
"「あったな。",
"あれがどうした?」"
]
},
{
"id": 11244,
"kind": "msg",
"jp": [
"「晴れてたら気持ちよさそう",
"だなあと思って・・・」"
]
},
{
"id": 11245,
"kind": "msg",
"jp": [
"「雨でも悪くなかったぜ。",
"一服するぶんにはな」"
]
},
{
"id": 11246,
"kind": "msg",
"jp": [
"「あ、そう言えば最初の夜",
"あそこで煙草吸ってたんでしたね」"
]
},
{
"id": 11247,
"kind": "msg",
"jp": [
"「なかなか風情があったがな。",
"今は晴れてても落ちつかねえ",
"だろうな・・・」"
]
},
{
"id": 11248,
"kind": "msg",
"jp": [
"「ここの温室ってすごいですよね」"
]
},
{
"id": 11249,
"kind": "msg",
"jp": [
"「すげえけどよ、",
"植物多すぎじゃねえか。",
"変な伸び方してんのもあったぞ」"
]
},
{
"id": 11250,
"kind": "msg",
"jp": [
"「迷いそうですよね」"
]
},
{
"id": 11251,
"kind": "msg",
"jp": [
"「いや、迷うのはお前くらいだろ」"
]
},
{
"id": 11252,
"kind": "msg",
"jp": [
"僕ってどういうイメージなんだ。"
]
},
{
"id": 11253,
"kind": "msg",
"jp": [
"「暗石さん、台所には何度か",
"入られてますよね」"
]
},
{
"id": 11254,
"kind": "msg",
"jp": [
"「そうだな、最初の日には・・・",
"食料運び込んでからは知らんぞ」"
]
},
{
"id": 11255,
"kind": "msg",
"jp": [
"「あれ以降は一度も?」"
]
},
{
"id": 11256,
"kind": "msg",
"jp": [
"「入ってねえよ」"
]
},
{
"id": 11257,
"kind": "msg",
"jp": [
"「暗石さん、応接室って",
"入った事あります?」"
]
},
{
"id": 11258,
"kind": "msg",
"jp": [
"「応接室?",
"いや、入った事ねえな」"
]
},
{
"id": 11259,
"kind": "msg",
"jp": [
"「娯楽室っていろんなもの",
"置いてありますよね」"
]
},
{
"id": 11260,
"kind": "msg",
"jp": [
"「ああ、こんな状況じゃなけりゃ",
"楽しそうな部屋なんだがな」"
]
},
{
"id": 11261,
"kind": "msg",
"jp": [
"「ダーツとか好きなんですか?」"
]
},
{
"id": 11262,
"kind": "msg",
"jp": [
"「若い頃は結構上手かったんだぜ」"
]
},
{
"id": 11263,
"kind": "msg",
"jp": [
"「へえ・・・。",
"僕、ああいうの全然駄目なんです」"
]
},
{
"id": 11264,
"kind": "msg",
"jp": [
"「あー、鈍そうだもんな、お前」"
]
},
{
"id": 11265,
"kind": "msg",
"jp": [
"「・・・・・はい」"
]
},
{
"id": 11266,
"kind": "msg",
"jp": [
"「あの、書斎の事なんですけど」"
]
},
{
"id": 11267,
"kind": "msg",
"jp": [
"「書斎?",
"あー、入った事ねえぞ、俺は」"
]
},
{
"id": 11268,
"kind": "msg",
"jp": [
"「あ、そうなんですか」"
]
},
{
"id": 11269,
"kind": "msg",
"jp": [
"「あの、一階の物置なんですけど」"
]
},
{
"id": 11270,
"kind": "msg",
"jp": [
"「物置って、お前・・・",
"んなもんいちいちのぞいてねえぞ」"
]
},
{
"id": 11271,
"kind": "msg",
"jp": [
"「暗石さんの部屋って",
"もとから客間なんですかね」"
]
},
{
"id": 11272,
"kind": "msg",
"jp": [
"「多分そうだろうな。",
"元から誰か使ってたにしては",
"タンスも引出しも空だしな」"
]
},
{
"id": 11273,
"kind": "msg",
"jp": [
"「何も無いんですか?」"
]
},
{
"id": 11274,
"kind": "msg",
"jp": [
"「マッチもライターもねえよ。",
"普段はよっぽど使ってねえん",
"だろうな」"
]
},
{
"id": 11275,
"kind": "msg",
"jp": [
"「客間としても多少使ってんなら",
"タオルか何かくらいはどっかに",
"置いてありそうなもんだし」"
]
},
{
"id": 11276,
"kind": "msg",
"jp": [
"「ですよね。",
"この館の持ち主の人以外は",
"滅多に誰も来ないのかな・・」"
]
},
{
"id": 11277,
"kind": "msg",
"jp": [
"「二階に、誰も使ってない",
"客間じゃなさそうな部屋があるじゃ",
"ないですか」"
]
},
{
"id": 11278,
"kind": "msg",
"jp": [
"「どこだ、それ?",
"二階は自分の部屋と便所しか",
"入った事ねえから知らんぞ」"
]
},
{
"id": 11279,
"kind": "msg",
"jp": [
"「二階の奥にある納戸って",
"わかります?」"
]
},
{
"id": 11280,
"kind": "msg",
"jp": [
"「いや、どこにあるのかもしらん」"
]
},
{
"id": 11281,
"kind": "msg",
"jp": [
"「静奈ちゃん達の部屋の前に",
"あるんですけど」"
]
},
{
"id": 11282,
"kind": "msg",
"jp": [
"「それがどうかしたのか?」"
]
},
{
"id": 11283,
"kind": "msg",
"jp": [
"場所も知らないんじゃあ、",
"聞く事ないなあ・・・。"
]
},
{
"id": 11284,
"kind": "msg",
"jp": [
"「地下室って降りたこと",
"ありましたよね」"
]
},
{
"id": 11285,
"kind": "msg",
"jp": [
"「酒取りに行っただけだがな。",
"ボイラーだののある方へは",
"行ってねえからしらんぞ」"
]
},
{
"id": 11286,
"kind": "msg",
"jp": [
"「まさかと思うが、",
"誰か隠れてたりしねえだろうな」"
]
},
{
"id": 11287,
"kind": "msg",
"jp": [
"「怖い事言わないで下さい・・・」"
]
},
{
"id": 11288,
"kind": "msg",
"jp": [
"「地下室の奥に、",
"迷路があったんですけど",
"知ってました?」"
]
},
{
"id": 11289,
"kind": "msg",
"jp": [
"「地下迷路だぁ?",
"んなもんあったのかよ」"
]
},
{
"id": 11290,
"kind": "msg",
"jp": [
"「はい、なんか迷路みたいなのが」"
]
},
{
"id": 11291,
"kind": "msg",
"jp": [
"「とことん見たまんまだな、この家。",
"やっぱそのうち何か出るぞ」"
]
},
{
"id": 11292,
"kind": "msg",
"jp": [
"「で、出なくていいですっ!!」"
]
},
{
"id": 11293,
"kind": "msg",
"jp": [
"「庭にある井戸って、",
"中のぞいた事あります?」"
]
},
{
"id": 11294,
"kind": "msg",
"jp": [
"「井戸ってあれ、",
"ふさいであるんじゃねえのか?」"
]
},
{
"id": 11295,
"kind": "msg",
"jp": [
"「ええ、蓋はしてありました」"
]
},
{
"id": 11296,
"kind": "msg",
"jp": [
"「あるのは知ってたが、",
"蓋開けてまで見ちゃいねえよ」"
]
},
{
"id": 11297,
"kind": "msg",
"jp": [
"「部屋の名前のこと",
"なんですけど・・・」"
]
},
{
"id": 11298,
"kind": "msg",
"jp": [
"「部屋の名前?",
"そう言や、この館の部屋の名前は",
"全部推理作家だとか言う話だったな」"
]
},
{
"id": 11299,
"kind": "msg",
"jp": [
"「着流しと双子の姉の方が",
"なんか盛り上がってたぜ。",
"あと、那須も」"
]
},
{
"id": 11300,
"kind": "msg",
"jp": [
"「那須さんが?」"
]
},
{
"id": 11301,
"kind": "msg",
"jp": [
"「あいつ意外と本読んでるぞ。",
"俺もちょっと驚いたがな」"
]
},
{
"id": 11302,
"kind": "msg",
"jp": [
"「あの、地下室にあった大きな",
"長持なんですけど・・・」"
]
},
{
"id": 11303,
"kind": "msg",
"jp": [
"「長持?",
"んなもんあったのか?」"
]
},
{
"id": 11304,
"kind": "msg",
"jp": [
"「・・・椿くんが",
"入れられてたんです」"
]
},
{
"id": 11305,
"kind": "msg",
"jp": [
"「はぁん、悪趣味なこった」"
]
},
{
"id": 11306,
"kind": "msg",
"jp": [
"「あったの覚えてません?」"
]
},
{
"id": 11307,
"kind": "msg",
"jp": [
"「覚えてねえよ。",
"地下には酒取りに行っただけだから",
"他のもんには用もなかったしな」"
]
},
{
"id": 11308,
"kind": "msg",
"jp": [
"「那須さんが飲んじゃったお茶、",
"台所にあったんですけど暗石さんは",
"同じの飲みました?」"
]
},
{
"id": 11309,
"kind": "msg",
"jp": [
"「どんなやつだ?」"
]
},
{
"id": 11310,
"kind": "msg",
"jp": [
"「緑茶です。",
"ペットボトルの」"
]
},
{
"id": 11311,
"kind": "msg",
"jp": [
"「ああ、それなら飲んでねえよ。",
"緑茶も冷蔵庫にあるのは見たがな",
"冷えた茶は麦茶しか持ってきてねえや」"
]
},
{
"id": 11312,
"kind": "msg",
"jp": [
"「那須さんが飲まされた",
"毒薬なんですけど・・・」"
]
},
{
"id": 11313,
"kind": "msg",
"jp": [
"「やっぱ先に食料かっぱらっといて",
"正解だったってことかね」"
]
},
{
"id": 11314,
"kind": "msg",
"jp": [
"「・・・かもしれません」"
]
},
{
"id": 11315,
"kind": "msg",
"jp": [
"「あいつ警戒心なさそう",
"だったからな・・・」"
]
},
{
"id": 11316,
"kind": "msg",
"jp": [
"「あの、でっかい斧ですけど、",
"暗石さんはどこにあったやつか",
"覚えてます?」"
]
},
{
"id": 11317,
"kind": "msg",
"jp": [
"「斧なあ・・・。",
"見た覚えはあるんだがな」"
]
},
{
"id": 11318,
"kind": "msg",
"jp": [
"「ずっと部屋にこもってたからな、",
"いまいちはっきり覚えてねえんだよな」"
]
},
{
"id": 11319,
"kind": "msg",
"jp": [
"「あのてるてる坊主、",
"効果あるといいですね」"
]
},
{
"id": 11320,
"kind": "msg",
"jp": [
"「・・・なんだそりゃ」"
]
},
{
"id": 11321,
"kind": "msg",
"jp": [
"「あれ?",
"気がつかなかったんですか?」"
]
},
{
"id": 11322,
"kind": "msg",
"jp": [
"「那須さんが居間のテラスに",
"吊したでっかいやつですけど」"
]
},
{
"id": 11323,
"kind": "msg",
"jp": [
"「ああ、あれのことか。",
"いつの間にあんなもん作ったんだか」"
]
},
{
"id": 11324,
"kind": "msg",
"jp": [
"「最初の日の夜ですって。",
"そう言えば暗石さん、あの時居間に",
"降りてたんじゃあ・・・」"
]
},
{
"id": 11325,
"kind": "msg",
"jp": [
"「あそこで一服したときは",
"あんなもんなかったぞ」"
]
},
{
"id": 11326,
"kind": "msg",
"jp": [
"そうか、那須さんがテラスに",
"あれを吊したのは、暗石さんが",
"居間から出た後のことか・・・。"
]
},
{
"id": 11327,
"kind": "msg",
"jp": [
"「温室にあった『復讐』って",
"書いてある紙なんですけど」"
]
},
{
"id": 11328,
"kind": "msg",
"jp": [
"「あれがどうした?」"
]
},
{
"id": 11329,
"kind": "msg",
"jp": [
"「いつからあったのかなと",
"思ってて・・・」"
]
},
{
"id": 11330,
"kind": "msg",
"jp": [
"「だったら俺に聞いても無駄だぞ、",
"温室に入ったのはあの時が初めて",
"だったからな」"
]
},
{
"id": 11331,
"kind": "msg",
"jp": [
"「まあ、ここに来た後館ん中",
"うろうろしてた奴はいたはずだから",
"他の連中に聞いてみるんだな」"
]
},
{
"id": 11332,
"kind": "msg",
"jp": [
"「はい、そうします」"
]
},
{
"id": 11333,
"kind": "msg",
"jp": [
"「温室に置いてあった黒猫の",
"ことなんですけど」"
]
},
{
"id": 11334,
"kind": "msg",
"jp": [
"「ああ、あれなぁ。",
"斑井の奴はまるっきり本気に",
"してなかったが・・・」"
]
},
{
"id": 11335,
"kind": "msg",
"jp": [
"「暗石さんは、",
"危険だと思ったんですか?」"
]
},
{
"id": 11336,
"kind": "msg",
"jp": [
"「冗談にしちゃあタチが",
"悪すぎるだろうよ」"
]
},
{
"id": 11337,
"kind": "msg",
"jp": [
"「斑井はなぁ、自分に都合の悪い事は",
"気がついても頭の中でなかったことに",
"しちまうクセがあったからな」"
]
},
{
"id": 11338,
"kind": "msg",
"jp": [
"気の毒だけど、そうとしか思えない",
"言動が多い人だったよな・・・。"
]
},
{
"id": 11339,
"kind": "msg",
"jp": [
"「ここの電話ってなんで",
"外に通じてないんでしょう?」"
]
},
{
"id": 11340,
"kind": "msg",
"jp": [
"「金持ちが道楽で持ってる別荘",
"みてえだからな、わざと下界から",
"隔離されてんだろうよ」"
]
},
{
"id": 11341,
"kind": "msg",
"jp": [
"「けど、外への連絡手段が",
"1つもないって緊急事態の時",
"困りますよね」"
]
},
{
"id": 11342,
"kind": "msg",
"jp": [
"「今がまさにそうだな」"
]
},
{
"id": 11343,
"kind": "msg",
"jp": [
"「俺も時々自分の携帯見てるが",
"やっぱり電波が届きませんとよ」"
]
},
{
"id": 11344,
"kind": "msg",
"jp": [
"「僕のもです・・・」"
]
},
{
"id": 11345,
"kind": "msg",
"jp": [
"「娯楽室のラジオって",
"暗石さんがつける前に誰か",
"触ってた人いました?」"
]
},
{
"id": 11346,
"kind": "msg",
"jp": [
"「そこまでは・・・・",
"いや、触ってねえかもな」"
]
},
{
"id": 11347,
"kind": "msg",
"jp": [
"「俺がつけた時は切り替えが",
"ラジオじゃなくてカセットデッキの方に",
"入ってたからな」"
]
},
{
"id": 11348,
"kind": "msg",
"jp": [
"「カセット・・・」"
]
},
{
"id": 11349,
"kind": "msg",
"jp": [
"「わざわざ娯楽室で音楽聞いてた",
"奴ってのは覚えがねえからな」"
]
},
{
"id": 11350,
"kind": "msg",
"jp": [
"「あの大時計の音って",
"止まってるんですよね」"
]
},
{
"id": 11351,
"kind": "msg",
"jp": [
"「あぁ、斑井がうるせえって",
"文句言うんで止めたんだろ、確か」"
]
},
{
"id": 11352,
"kind": "msg",
"jp": [
"「何時だったかな。",
"確か、ちょうど御陵が来た時の",
"ことだったから3時頃か」"
]
},
{
"id": 11353,
"kind": "msg",
"jp": [
"「3時ですか。",
"鳴ってすぐ止めたんですか」"
]
},
{
"id": 11354,
"kind": "msg",
"jp": [
"「御陵の案内した後、",
"執事が止めてたぜ」"
]
},
{
"id": 11355,
"kind": "msg",
"jp": [
"「時計より斑井のが",
"うるせえよって顔しながらな」"
]
},
{
"id": 11356,
"kind": "msg",
"jp": [
"・・・なんとなく目に浮かぶなあ。"
]
},
{
"id": 11357,
"kind": "msg",
"jp": [
"「温室に置いてあった",
"玩具のベルなんですけど」"
]
},
{
"id": 11358,
"kind": "msg",
"jp": [
"「どうかしたのか?」"
]
},
{
"id": 11359,
"kind": "msg",
"jp": [
"「暗石さんは",
"あれどっちに見えました?",
"釣鐘か、ベルか・・・」"
]
},
{
"id": 11360,
"kind": "msg",
"jp": [
"「・・・どっちなぁ。",
"釣鐘っつーか普通の鐘かな」"
]
},
{
"id": 11361,
"kind": "msg",
"jp": [
"「人によって見た印象って",
"かなり違うもんですね」"
]
},
{
"id": 11362,
"kind": "msg",
"jp": [
"「そりゃそうだろうな」"
]
},
{
"id": 11363,
"kind": "msg",
"jp": [
"「温室に、",
"長い釘が置いてあったんです。",
"五寸釘っていうやつ」"
]
},
{
"id": 11364,
"kind": "msg",
"jp": [
"「また物騒だな・・・",
"撮影所の道具部屋にならけっこう",
"転がってるがなあ」"
]
},
{
"id": 11365,
"kind": "msg",
"jp": [
"「芝居じゃけっこう使うからな。",
"丑の刻参りの場面とか」"
]
},
{
"id": 11366,
"kind": "msg",
"jp": [
"「・・・そういう",
"使い方なんですね・・・」"
]
},
{
"id": 11367,
"kind": "msg",
"jp": [
"「温室に、今度は手袋が",
"置いてあったんです。",
"白い、女性用のやつでした」"
]
},
{
"id": 11368,
"kind": "msg",
"jp": [
"「手袋・・・手袋なあ」"
]
},
{
"id": 11369,
"kind": "msg",
"jp": [
"「どうかしたんですか?」"
]
},
{
"id": 11370,
"kind": "msg",
"jp": [
"「いや、御陵も双子もんなもん",
"してなかったしな・・・」"
]
},
{
"id": 11371,
"kind": "msg",
"jp": [
"「誰かの持ち物だったって",
"わけじゃないってことですね」"
]
},
{
"id": 11372,
"kind": "msg",
"jp": [
"「温室に、手斧があったんですよ」"
]
},
{
"id": 11373,
"kind": "msg",
"jp": [
"「手斧?」"
]
},
{
"id": 11374,
"kind": "msg",
"jp": [
"「これくらいのサイズの斧です」"
]
},
{
"id": 11375,
"kind": "msg",
"jp": [
"「・・・それなら館のどっかに",
"あったもんかもなぁ」"
]
},
{
"id": 11376,
"kind": "msg",
"jp": [
"「いや、全員荷物はそれなりにあるし",
"持って来れねえ大きさでもないか」"
]
},
{
"id": 11377,
"kind": "msg",
"jp": [
"「そうなんです・・・」"
]
},
{
"id": 11378,
"kind": "msg",
"jp": [
"「温室にまた物が増えてたんです。",
"小さな柵だったんですけど」"
]
},
{
"id": 11379,
"kind": "msg",
"jp": [
"「柵? 柵って何のだ?」"
]
},
{
"id": 11380,
"kind": "msg",
"jp": [
"「よくわかんないですけど",
"園芸とかに使うんじゃないかと」"
]
},
{
"id": 11381,
"kind": "msg",
"jp": [
"「はぁん、なるほどな・・・",
"大して荷物にならんもんばっかりだな」"
]
},
{
"id": 11382,
"kind": "msg",
"jp": [
"「ダンベルって使うことあります?」"
]
},
{
"id": 11383,
"kind": "msg",
"jp": [
"「ねえよ、んなもん」"
]
},
{
"id": 11384,
"kind": "msg",
"jp": [
"「そういや那須がかついで",
"来てたみてえだな」"
]
},
{
"id": 11385,
"kind": "msg",
"jp": [
"「部屋で上げてました」"
]
},
{
"id": 11386,
"kind": "msg",
"jp": [
"「あいつ多分、",
"鍛えるの止めたら息まで",
"止まって死ぬんだな」"
]
},
{
"id": 11387,
"kind": "msg",
"jp": [
"・・・いきなり死なないだろうけど",
"暴れ出しそうな気はする・・・。"
]
},
{
"id": 11388,
"kind": "msg",
"jp": [
"「斑井さんの部屋に、",
"変な杖があったんですよ」"
]
},
{
"id": 11389,
"kind": "msg",
"jp": [
"「なんかこう、魔法使いが",
"持ってそうな形のやつです」"
]
},
{
"id": 11390,
"kind": "msg",
"jp": [
"「なんだそりゃ。",
"飾りなのか?」"
]
},
{
"id": 11391,
"kind": "msg",
"jp": [
"「普通の杖としてはちょっと",
"使いにくそうなんですけど」"
]
},
{
"id": 11392,
"kind": "msg",
"jp": [
"「ふーん?",
"なんなんだろうな」"
]
},
{
"id": 11393,
"kind": "msg",
"jp": [
"「この館ってなんかあちこちに",
"絵が飾ってありますよね」"
]
},
{
"id": 11394,
"kind": "msg",
"jp": [
"「んー?",
"ああ、そういやこの部屋にもあるな」"
]
},
{
"id": 11395,
"kind": "msg",
"jp": [
"「あんま気にしてなかったなあ、",
"金持ちの家ってなぁこんなもんだろ」"
]
},
{
"id": 11396,
"kind": "msg",
"jp": [
"「駐車場の車なんですけど・・・」"
]
},
{
"id": 11397,
"kind": "msg",
"jp": [
"「ああ、那須と斑井のだろ」"
]
},
{
"id": 11398,
"kind": "msg",
"jp": [
"「暗石さんは自分では",
"運転されないんですか?」"
]
},
{
"id": 11399,
"kind": "msg",
"jp": [
"「こんな酒飲むくらいしか",
"することなさそうなところに",
"自分で運転なんかしてこれるか」"
]
},
{
"id": 11400,
"kind": "msg",
"jp": [
"「しかも、飲んでなくても",
"強制的に車は使えなくしてくれる",
"マメな馬鹿野郎までいやがるし」"
]
},
{
"id": 11401,
"kind": "msg",
"jp": [
"「・・・あれって犯人は最初から",
"パンクさせる気だったんでしょうか。",
"車が何台あったとしても」"
]
},
{
"id": 11402,
"kind": "msg",
"jp": [
"「そりゃあ、何が何でも俺達を",
"ここに押し込めときてえらしいから",
"車があっちゃ邪魔だったろうな」"
]
},
{
"id": 11403,
"kind": "msg",
"jp": [
"「地下に、あの・・・",
"蛇がたくさんいたんです・・・」"
]
},
{
"id": 11404,
"kind": "msg",
"jp": [
"「蛇? どんな蛇だ?」"
]
},
{
"id": 11405,
"kind": "msg",
"jp": [
"「なんかいろいろいました」"
]
},
{
"id": 11406,
"kind": "msg",
"jp": [
"「いろいろってなんだよ・・・",
"まあ、こんな館の中に毒のあるような",
"やばいのはいねえとは思うがな」"
]
},
{
"id": 11407,
"kind": "msg",
"jp": [
"「そ、そうですよね?」"
]
},
{
"id": 11408,
"kind": "msg",
"jp": [
"「なんだ、怖ぇのかよ",
"俺なんかガキの頃はよく手づかみで",
"振り回したがなあ」"
]
},
{
"id": 11409,
"kind": "msg",
"jp": [
"「振り回すんですか・・・」"
]
},
{
"id": 11410,
"kind": "msg",
"jp": [
"「生き物見るととりあえず触って",
"いじりたくなるのがガキってもんだろ」"
]
},
{
"id": 11411,
"kind": "msg",
"jp": [
"「お前は・・・",
"そういうタイプじゃなさそうだが」"
]
},
{
"id": 11412,
"kind": "msg",
"jp": [
"「ね、猫なら触れます」"
]
},
{
"id": 11413,
"kind": "msg",
"jp": [
"「自慢になるかそんなもん。",
"・・・犬は?」"
]
},
{
"id": 11414,
"kind": "msg",
"jp": [
"「犬によります。",
"小さい頃追い掛け回された",
"やつだけは、ちょっと・・・」"
]
},
{
"id": 11415,
"kind": "msg",
"jp": [
"「駄目なのかよ。",
"それで追っかけられて噛まれたのか?」"
]
},
{
"id": 11416,
"kind": "msg",
"jp": [
"「いえ、多分犬のほうは",
"じゃれてるだけのつもりだったみたいで",
"噛まれたりはしませんでした」"
]
},
{
"id": 11417,
"kind": "msg",
"jp": [
"「はぁん・・・。",
"ま、でけえ犬に追っかけられりゃ",
"トラウマにもなるかもしれんが」"
]
},
{
"id": 11418,
"kind": "msg",
"jp": [
"「・・・マルチーズ",
"だったんですけど」"
]
},
{
"id": 11419,
"kind": "msg",
"jp": [
"呆れるを通り越して可哀想な目で",
"見られてしまった・・・。"
]
},
{
"id": 11420,
"kind": "msg",
"jp": [
"「台所にカップ麺がたくさん",
"ありますよね」"
]
},
{
"id": 11421,
"kind": "msg",
"jp": [
"「あぁ、あったな。",
"夜食によく食うやつが大量に",
"積んであったの覚えてるよ」"
]
},
{
"id": 11422,
"kind": "msg",
"jp": [
"「よく食べるんですか」"
]
},
{
"id": 11423,
"kind": "msg",
"jp": [
"「手間かからねえからな。",
"最近はインスタントの種類も",
"増えたし・・・」"
]
},
{
"id": 11424,
"kind": "msg",
"jp": [
"「なんか自販機で売ってんのも",
"あるだろ、おでんだの雑炊だの」"
]
},
{
"id": 11425,
"kind": "msg",
"jp": [
"「ああ、ありますね」"
]
},
{
"id": 11426,
"kind": "msg",
"jp": [
"「けっこう美味いのもあったが",
"たまに、とんでもねぇのもあるな」"
]
},
{
"id": 11427,
"kind": "msg",
"jp": [
"「まずかったって",
"ことですか?」"
]
},
{
"id": 11428,
"kind": "msg",
"jp": [
"「まずいも何も食ってねぇよ。",
"だってお前、缶入りの天津飯って",
"さすがに無理があるだろ」"
]
},
{
"id": 11429,
"kind": "msg",
"jp": [
"「た、食べにくそうですね」"
]
},
{
"id": 11430,
"kind": "msg",
"jp": [
"「面白がって若いのが買ってたが",
"熱くて手で持てねぇって",
"困ってたからなぁ・・・」"
]
},
{
"id": 11431,
"kind": "msg",
"jp": [
"「誰が思いつくんでしょうね、",
"そういう変な物って」"
]
},
{
"id": 11432,
"kind": "msg",
"jp": [
"「あれ確か、あの変なもん",
"ばっか作るので有名な会社の",
"新製品だったぞ」"
]
},
{
"id": 11433,
"kind": "msg",
"jp": [
"「なんつったかな、",
"不思議飲料・・じゃねえや",
"社名変わったんだったか」"
]
},
{
"id": 11434,
"kind": "msg",
"jp": [
"「不思議ビバレーツですか?」"
]
},
{
"id": 11435,
"kind": "msg",
"jp": [
"「おう、それだ。",
"変なのは缶ジュースだけじゃ",
"ねえんだな、あの会社」"
]
},
{
"id": 11436,
"kind": "msg",
"jp": [
"「ボウガンの撃ち方って",
"知ってます?」"
]
},
{
"id": 11437,
"kind": "msg",
"jp": [
"「知ってるわけねえだろ。",
"まさか、そんな物騒なもんが",
"この館にあるのか?」"
]
},
{
"id": 11438,
"kind": "msg",
"jp": [
"「物置に・・・",
"あ、でも本当に撃てるのかどうかは",
"わかんないんですけど」"
]
},
{
"id": 11439,
"kind": "msg",
"jp": [
"「ふん、飾りならいいけどな。",
"とっとと隠しといた方が",
"いいんじゃねえのか?」"
]
},
{
"id": 11440,
"kind": "msg",
"jp": [
"「廊下に置いてある",
"家具なんですけど・・・」"
]
},
{
"id": 11441,
"kind": "msg",
"jp": [
"「知らないですか?",
"那須さんが邪魔だからって",
"部屋から出しちゃったやつ」"
]
},
{
"id": 11442,
"kind": "msg",
"jp": [
"「なにやってんだ、あの男は・・・」"
]
},
{
"id": 11443,
"kind": "msg",
"jp": [
"「暗石さんは、睡眠薬って",
"使ったことあります?」"
]
},
{
"id": 11444,
"kind": "msg",
"jp": [
"「俺はねえなあ。",
"この業界、けっこう使ってる奴",
"いるけどな」"
]
},
{
"id": 11445,
"kind": "msg",
"jp": [
"「あいつも使ってただろ、",
"えーと、御陵」"
]
},
{
"id": 11446,
"kind": "msg",
"jp": [
"「ええ、常用してるって」"
]
},
{
"id": 11447,
"kind": "msg",
"jp": [
"「・・・この状況でよく",
"使う気になるもんだな」"
]
},
{
"id": 11448,
"kind": "msg",
"jp": [
"「え?",
"だって、こんな状況だからこそ",
"普段より眠れなさそうですけど」"
]
},
{
"id": 11449,
"kind": "msg",
"jp": [
"「俺はその方がありがてえけどな。",
"人殺しが徘徊してるってところで",
"ぐっすり眠ろうとは思わねえよ」"
]
},
{
"id": 11450,
"kind": "msg",
"jp": [
"「あ、なるほど・・・」"
]
},
{
"id": 11451,
"kind": "msg",
"jp": [
"それもそうか。",
"暗石さんは特に警戒してるから、",
"なおさらかも・・・。"
]
},
{
"id": 11452,
"kind": "msg",
"jp": [
"「暗石さん、これまりもですよね」"
]
},
{
"id": 11453,
"kind": "msg",
"jp": [
"「・・・まりもだな」"
]
},
{
"id": 11454,
"kind": "msg",
"jp": [
"「放っといていいんでしょうか」"
]
},
{
"id": 11455,
"kind": "msg",
"jp": [
"「どこにあったか知らんが今まで",
"無事だったならいいんじゃねえか」"
]
},
{
"id": 11456,
"kind": "msg",
"jp": [
"「しかし、こんな鳴きも動きも",
"しねえもん飼って楽しいもんかね」"
]
},
{
"id": 11457,
"kind": "msg",
"jp": [
"「一応、ある程度育ちは",
"するんじゃないですか?」"
]
},
{
"id": 11458,
"kind": "msg",
"jp": [
"「ふーん?",
"育つと際限なくでかくなるなら",
"飼ってみてえかな」"
]
},
{
"id": 11459,
"kind": "msg",
"jp": [
"自分より大きくなったらかなり",
"怖いと思う・・・。"
]
},
{
"id": 11460,
"kind": "msg",
"jp": [
"「あ、あの・・・",
"赤いカメオの話って・・・」"
]
},
{
"id": 11461,
"kind": "msg",
"jp": [
"「あー、興味なんか持つなよ。",
"呼び寄せちまうぞ」"
]
},
{
"id": 11462,
"kind": "msg",
"jp": [
"「やっぱり本当の話なんですかっ!?」"
]
},
{
"id": 11463,
"kind": "msg",
"jp": [
"「さあなぁ・・・",
"俺は確かめたことねえし」"
]
},
{
"id": 11464,
"kind": "msg",
"jp": [
"「どうしても知りたいってんなら",
"関わったことある奴紹介して",
"やらんでもないが」"
]
},
{
"id": 11465,
"kind": "msg",
"jp": [
"「かか関わったことあるって、",
"実物を見たとか・・・!?」"
]
},
{
"id": 11466,
"kind": "msg",
"jp": [
"「いや、実物かもしれんのを",
"持ってたことがある奴の知り合いだ」"
]
},
{
"id": 11467,
"kind": "msg",
"jp": [
"「プロデューサーなんだけどな、",
"そういやオカルトものの特番もよく",
"担当してたな・・・」"
]
},
{
"id": 11468,
"kind": "msg",
"jp": [
"「え、あ、あの、い、いいですっ、",
"遠慮しますっ!!」"
]
},
{
"id": 11469,
"kind": "msg",
"jp": [
"「そうか?",
"気が変わったらいつでも言えよ」"
]
},
{
"id": 11470,
"kind": "msg",
"jp": [
"変わらないと思う。",
"ていうか変わりたくない。"
]
},
{
"id": 11471,
"kind": "msg",
"jp": [
"「温室の奥の方にこれが",
"隠してあったんです」"
]
},
{
"id": 11472,
"kind": "msg",
"jp": [
"「カセット?",
"何が入ってんだ?」"
]
},
{
"id": 11473,
"kind": "msg",
"jp": [
"「ガラスの割れる音、でした」"
]
},
{
"id": 11474,
"kind": "msg",
"jp": [
"「・・・なるほどな」"
]
},
{
"id": 11475,
"kind": "msg",
"jp": [
"「どうりでなんかこもったような",
"変な音だと思ったぜ。",
"効果音だったわけかい」"
]
},
{
"id": 11476,
"kind": "msg",
"jp": [
"「これ、なんだかわかります?」"
]
},
{
"id": 11477,
"kind": "msg",
"jp": [
"「ん? なんだそりゃ?」"
]
},
{
"id": 11478,
"kind": "msg",
"jp": [
"「地下にあったんですけど",
"なんだかわからないんです」"
]
},
{
"id": 11479,
"kind": "msg",
"jp": [
"「ふーん・・・",
"意味わかんねえな」"
]
},
{
"id": 11480,
"kind": "msg",
"jp": [
"やっぱりわかんないか・・・。"
]
},
{
"id": 11481,
"kind": "msg",
"jp": [
"「応接室に変な仮面が",
"飾ってありますよね」"
]
},
{
"id": 11482,
"kind": "msg",
"jp": [
"「仮面? なんだそりゃ?」"
]
},
{
"id": 11483,
"kind": "msg",
"jp": [
"「あ、見てないですか」"
]
},
{
"id": 11484,
"kind": "msg",
"jp": [
"「見てねえよ、そんなもん。",
"よっぽど異様なもんじゃない限り",
"見てても覚えてねえかもしれんが」"
]
},
{
"id": 11485,
"kind": "msg",
"jp": [
"けっこう異様な仮面だったから、",
"暗石さんは見てないのかな。"
]
},
{
"id": 11486,
"kind": "msg",
"jp": [
"「娯楽室のラジオのデッキに",
"これが入ってて・・・」"
]
},
{
"id": 11487,
"kind": "msg",
"jp": [
"「崖崩れのニュースが",
"録音してありました」"
]
},
{
"id": 11488,
"kind": "msg",
"jp": [
"「なんだと・・・?」"
]
},
{
"id": 11489,
"kind": "msg",
"jp": [
"「でも、僕らがラジオで",
"聞いたニュースとは内容が",
"ずいぶん違うんですよ」"
]
},
{
"id": 11490,
"kind": "msg",
"jp": [
"「・・・ふん、なるほど。",
"犯人の不発弾ってことか」"
]
},
{
"id": 11491,
"kind": "msg",
"jp": [
"「まあ、そんな都合よくマジで",
"崖が崩れてくれるとは思わねえわな」"
]
},
{
"id": 11492,
"kind": "msg",
"jp": [
"「でしょうね。",
"本来はこれを僕らに聞かせて",
"誤魔化すつもりだったんだと・・」"
]
},
{
"id": 11493,
"kind": "msg",
"jp": [
"「・・・よくわからんな。",
"この事件の犯人、用意周到なのか",
"行き当たりばったりなのか」"
]
},
{
"id": 11494,
"kind": "msg",
"jp": [
"「メンツの中に那須みてえな",
"非常識な筋肉が混じってるってのに」"
]
},
{
"id": 11495,
"kind": "msg",
"jp": [
"「あの馬鹿、崖崩れの現場まで",
"見に行きやがったじゃねえか。",
"崩れてなきゃあの時点でアウトだ」"
]
},
{
"id": 11496,
"kind": "msg",
"jp": [
"「で、でも、まさか犯人も",
"歩いていく人が居るとは思わなかったん",
"じゃないですか?」"
]
},
{
"id": 11497,
"kind": "msg",
"jp": [
"「・・・だとしたら犯人は、",
"那須がああいう男だってことは",
"知らなかったってことかね」"
]
},
{
"id": 11498,
"kind": "msg",
"jp": [
"「・・・それは・・・」"
]
},
{
"id": 11499,
"kind": "msg",
"jp": [
"「もしも、俺がこの事件の",
"犯人だったらな・・・」"
]
},
{
"id": 11500,
"kind": "msg",
"jp": [
"「その危険を排除するためにも",
"斑井なんかより真っ先に那須から",
"始末してるぞ」"
]
},
{
"id": 11501,
"kind": "msg",
"jp": [
"「確かに、那須さんがいなかったら",
"嘘のニュースだけでも他の全員は",
"ここに足止め出来るかも・・・」"
]
},
{
"id": 11502,
"kind": "msg",
"jp": [
"「けど犯人はそうしなかった。",
"つまり、那須がああいう奴だって事を",
"知らなかったか・・・」"
]
},
{
"id": 11503,
"kind": "msg",
"jp": [
"「・・・他に、斑井から先に",
"やらなきゃならん理由があったかだ」"
]
},
{
"id": 11504,
"kind": "msg",
"jp": [
"「斑井さんから?」"
]
},
{
"id": 11505,
"kind": "msg",
"jp": [
"「誰から殺すか決めてるのは",
"犯人の方だろうがよ」"
]
},
{
"id": 11506,
"kind": "msg",
"jp": [
"「自分に都合のいい順番に",
"するに決まってるじゃねえか」"
]
},
{
"id": 11507,
"kind": "msg",
"jp": [
"「・・・殺したいほど憎い相手が",
"どんな人か知らないっていうのは",
"変でしょうから・・・」"
]
},
{
"id": 11508,
"kind": "msg",
"jp": [
"「俺もそう思うがな。",
"しかし、斑井が先じゃなきゃいかん",
"理由ってのは思いつかんな」"
]
},
{
"id": 11509,
"kind": "msg",
"jp": [
"「あの、この花なんだか",
"わかりませんか?」"
]
},
{
"id": 11510,
"kind": "msg",
"jp": [
"「花? なんだこりゃ?」"
]
},
{
"id": 11511,
"kind": "msg",
"jp": [
"「温室の『復讐』の紙のところに",
"千切って置いてあったんです」"
]
},
{
"id": 11512,
"kind": "msg",
"jp": [
"「はぁん・・・?",
"そりゃまあ、何の意味もなく",
"置きゃあしねえだろうが・・・」"
]
},
{
"id": 11513,
"kind": "msg",
"jp": [
"「俺は見ただけじゃ",
"何の花かわからんな」"
]
},
{
"id": 11514,
"kind": "msg",
"jp": [
"「あの、インプって知ってます?",
"なんか小さい悪魔みたいなもの",
"らしいんですけど」"
]
},
{
"id": 11515,
"kind": "msg",
"jp": [
"「なんだいきなり?」"
]
},
{
"id": 11516,
"kind": "msg",
"jp": [
"「那須さんが、山道の茂みの中に",
"停まってた車の中にそういうのの",
"飾りが吊ってあったって言ってて」"
]
},
{
"id": 11517,
"kind": "msg",
"jp": [
"「車に・・・?",
"大した趣味だなそりゃ」"
]
},
{
"id": 11518,
"kind": "msg",
"jp": [
"「けっこう変わった人っぽい",
"ですよね・・・」"
]
},
{
"id": 11519,
"kind": "msg",
"jp": [
"「・・・そう思うが、",
"そんなもん吊ってそうな奴に",
"心当たりもあるな」"
]
},
{
"id": 11520,
"kind": "msg",
"jp": [
"「誰ですか?」"
]
},
{
"id": 11521,
"kind": "msg",
"jp": [
"「四倉だ。",
"あいつは、そういう気味の悪いもん",
"ばっか喜んで集めてたからな」"
]
},
{
"id": 11522,
"kind": "msg",
"jp": [
"「オカルトマニアってやつだ。",
"西洋も日本もおかまいなしだったしな」"
]
},
{
"id": 11523,
"kind": "msg",
"jp": [
"「あの、部屋の鍵に何か",
"文字が彫ってないですか?」"
]
},
{
"id": 11524,
"kind": "msg",
"jp": [
"「文字?」"
]
},
{
"id": 11525,
"kind": "msg",
"jp": [
"「・・・ああ、これか。",
"『A』みてえだな」"
]
},
{
"id": 11526,
"kind": "msg",
"jp": [
"「Aですね。",
"ありがとうございます」"
]
},
{
"id": 11527,
"kind": "msg",
"jp": [
"「なんなんだ?",
"そういや部屋の名前と全然",
"関係ねえ文字だよな」"
]
},
{
"id": 11528,
"kind": "msg",
"jp": [
"「他の部屋もそうみたいです。",
"なんか暗号だとか・・・」"
]
},
{
"id": 11529,
"kind": "msg",
"jp": [
"「はぁん?",
"館の持ち主の道楽かなんかか」"
]
},
{
"id": 11530,
"kind": "msg",
"jp": [
"「かもしれません」"
]
},
{
"id": 11531,
"kind": "msg",
"jp": [
"「ふーん?",
"ま、なんでもいいけどよ」"
]
},
{
"id": 11532,
"kind": "msg",
"jp": [
"「暗石さん、携帯持って",
"来てるんでしたっけ」"
]
},
{
"id": 11533,
"kind": "msg",
"jp": [
"「持っちゃいるが、",
"通じてねえぞ」"
]
},
{
"id": 11534,
"kind": "msg",
"jp": [
"「まあ、俺のは写真も撮れねえ",
"古い型だから余計に通じんの",
"かもしれんが」"
]
},
{
"id": 11535,
"kind": "msg",
"jp": [
"「メールもないんですか?」"
]
},
{
"id": 11536,
"kind": "msg",
"jp": [
"「そんなもんついてたって",
"どうせ覚えられん」"
]
},
{
"id": 11537,
"kind": "msg",
"jp": [
"「・・・娘はつけろつけろと",
"うるさいがなあ・・・」"
]
},
{
"id": 11538,
"kind": "msg",
"jp": [
"暗石さんは珍しく困ったような",
"顔をしてため息をついた。"
]
},
{
"id": 11539,
"kind": "msg",
"jp": [
"「暗石さんはここまで",
"タクシーでしたっけ」"
]
},
{
"id": 11540,
"kind": "msg",
"jp": [
"「ああ、駅からな」"
]
},
{
"id": 11541,
"kind": "msg",
"jp": [
"「ただ俺は、前の仕事で九州に",
"いたから他の連中とは逆から",
"来たんでな」"
]
},
{
"id": 11542,
"kind": "msg",
"jp": [
"「そうだったんですか?」"
]
},
{
"id": 11543,
"kind": "msg",
"jp": [
"「・・・だからかな。",
"駅前のタクシー乗り場でも",
"他の奴は見かけなかったな」"
]
},
{
"id": 11544,
"kind": "msg",
"jp": [
"「上りと下りと、駅に着いた",
"時間がずれてたんだろうな」"
]
},
{
"id": 11545,
"kind": "msg",
"jp": [
"「あの、変な事聞きますけど",
"明石焼きって好きですか?」"
]
},
{
"id": 11546,
"kind": "msg",
"jp": [
"「・・・本当に意味わからん",
"質問だな、お前」"
]
},
{
"id": 11547,
"kind": "msg",
"jp": [
"「すみません」"
]
},
{
"id": 11548,
"kind": "msg",
"jp": [
"「嫌いじゃあねえが、",
"俺は普通のたこ焼きのが",
"好きだな」"
]
},
{
"id": 11549,
"kind": "msg",
"jp": [
"「・・・で、それが",
"どうしたんだ?」"
]
},
{
"id": 11550,
"kind": "msg",
"jp": [
"「いえ、あの、",
"特に意味はないです」"
]
},
{
"id": 11551,
"kind": "msg",
"jp": [
"「なんだそりゃ?",
"妙な事言うなよ、",
"食いたくなるだろうが」"
]
},
{
"id": 11552,
"kind": "msg",
"jp": [
"「は、はい」"
]
},
{
"id": 11553,
"kind": "msg",
"jp": [
"「手こねハンバーグって",
"作れます?」"
]
},
{
"id": 11554,
"kind": "msg",
"jp": [
"「あ?」"
]
},
{
"id": 11555,
"kind": "msg",
"jp": [
"「い、いえ、別に事件とは",
"関係ないんですが」"
]
},
{
"id": 11556,
"kind": "msg",
"jp": [
"「・・・あっても嫌だぞ",
"そんなわけのわからん事が」"
]
},
{
"id": 11557,
"kind": "msg",
"jp": [
"「あいにく料理はカレーぐらいしか",
"作れねえよ」"
]
},
{
"id": 11558,
"kind": "msg",
"jp": [
"「揚げだし豆腐って",
"お好きですか?」"
]
},
{
"id": 11559,
"kind": "msg",
"jp": [
"「なんだ、いきなり?」"
]
},
{
"id": 11560,
"kind": "msg",
"jp": [
"「日織が作るの得意だって",
"言ってたんです」"
]
},
{
"id": 11561,
"kind": "msg",
"jp": [
"「着流しが?",
"器用だな、あいつは」"
]
},
{
"id": 11562,
"kind": "msg",
"jp": [
"「けど、豆腐なんか",
"あったかここ?」"
]
},
{
"id": 11563,
"kind": "msg",
"jp": [
"「ないみたいです、",
"残念ながら」"
]
},
{
"id": 11564,
"kind": "msg",
"jp": [
"「ちっ・・・",
"それじゃ山降りてから",
"たかるしかねぇな」"
]
},
{
"id": 11565,
"kind": "msg",
"jp": [
"「地酒持ってってやるから",
"作れって言っとけ」"
]
},
{
"id": 11566,
"kind": "msg",
"jp": [
"「はい、伝えときます」"
]
},
{
"id": 11567,
"kind": "msg",
"jp": [
"「暗石さんって、",
"日にどれくらい煙草吸うんですか?」"
]
},
{
"id": 11568,
"kind": "msg",
"jp": [
"「2箱ってとこじゃねぇかな。",
"なんでだ?」"
]
},
{
"id": 11569,
"kind": "msg",
"jp": [
"「うちの親が、1日1箱くらい",
"吸ってるんで他の人って",
"どうなんだろうと思って」"
]
},
{
"id": 11570,
"kind": "msg",
"jp": [
"「1箱ぐれぇだったら",
"少ねぇ方だろう」"
]
},
{
"id": 11571,
"kind": "msg",
"jp": [
"「そうなんですか。",
"そう言えば先輩には1日3箱",
"空けるって人もいますね」"
]
},
{
"id": 11572,
"kind": "msg",
"jp": [
"「3箱なあ・・・",
"たまに空けちまうな」"
]
},
{
"id": 11573,
"kind": "msg",
"jp": [
"「台本もらったばっかで",
"覚えてる最中とかな」"
]
},
{
"id": 11574,
"kind": "msg",
"jp": [
"「そういう時って",
"本数増えるんですか」"
]
},
{
"id": 11575,
"kind": "msg",
"jp": [
"「なんか考え事してたり",
"集中してえ時ってのが",
"一番増えるんだよ」"
]
},
{
"id": 11576,
"kind": "msg",
"jp": [
"「地下のワインって",
"おいしかったですか?」"
]
},
{
"id": 11577,
"kind": "msg",
"jp": [
"「さすがに、いいもん",
"置いてあったぞ」"
]
},
{
"id": 11578,
"kind": "msg",
"jp": [
"「まだあったから",
"飲みてぇならもらって来いよ」"
]
},
{
"id": 11579,
"kind": "msg",
"jp": [
"「あ、僕飲めないんです」"
]
},
{
"id": 11580,
"kind": "msg",
"jp": [
"「お前、見たまんまだな」"
]
},
{
"id": 11581,
"kind": "msg",
"jp": [
"「え、ええ」"
]
},
{
"id": 11582,
"kind": "msg",
"jp": [
"「あの・・・",
"脚立って好きですか?」"
]
},
{
"id": 11583,
"kind": "msg",
"jp": [
"「生まれて初めて",
"聞かれたぞ、そんな事」"
]
},
{
"id": 11584,
"kind": "msg",
"jp": [
"「好きとか嫌いとか",
"話し合うような代物じゃ",
"ねぇだろ・・・」"
]
},
{
"id": 11585,
"kind": "msg",
"jp": [
"「僕もそう思うん",
"ですけど・・・」"
]
},
{
"id": 11586,
"kind": "msg",
"jp": [
"でも、なぜか好きな人が",
"いるらしいんだよな。",
"ここの当主の人とか・・・。"
]
},
{
"id": 11587,
"kind": "msg",
"jp": [
"「納戸に白い日傘がしまって",
"あったんですけどね」"
]
},
{
"id": 11588,
"kind": "msg",
"jp": [
"「日傘なぁ・・・",
"俺は傘自体好きじゃねぇからな」"
]
},
{
"id": 11589,
"kind": "msg",
"jp": [
"「晴れてる日まで",
"傘さそうって女の気持ちは",
"よくわからんな」"
]
},
{
"id": 11590,
"kind": "msg",
"jp": [
"「日焼けしたくない",
"とかじゃないんですか?」"
]
},
{
"id": 11591,
"kind": "msg",
"jp": [
"「理屈がわからん",
"わけじゃねえよ」"
]
},
{
"id": 11592,
"kind": "msg",
"jp": [
"「ただ、面倒くせえこと",
"よくやるなと思うだけでな。",
"化粧とかもそうだが・・・」"
]
},
{
"id": 11593,
"kind": "msg",
"jp": [
"「・・・けど、かみさんに",
"そう言うと呆れられんだよな」"
]
},
{
"id": 11594,
"kind": "msg",
"jp": [
"暗石さんの奥さんってどんな人",
"なんだろう・・・。",
"ちょっと見てみたい。"
]
},
{
"id": 11595,
"kind": "msg",
"jp": [
"「暗石さん、確かワイン持って",
"来られてましたよね。",
"グラスも持って来てます?」"
]
},
{
"id": 11596,
"kind": "msg",
"jp": [
"「グラスってか、",
"湯飲みなら借りてるが」"
]
},
{
"id": 11597,
"kind": "msg",
"jp": [
"「ゆ、湯飲みですか」"
]
},
{
"id": 11598,
"kind": "msg",
"jp": [
"「一度使ったやつだったから",
"まあ、安全だろうと思ってな」"
]
},
{
"id": 11599,
"kind": "msg",
"jp": [
"とりあえず、ここにはグラスは",
"ないらしい。"
]
},
{
"id": 11600,
"kind": "msg",
"jp": [
"「暗石さん、日織のことって",
"前から知ってました?」"
]
},
{
"id": 11601,
"kind": "msg",
"jp": [
"「あの着流しか?",
"まあ、この中ではよく",
"顔合わせる方だな」"
]
},
{
"id": 11602,
"kind": "msg",
"jp": [
"「そうなんですか」"
]
},
{
"id": 11603,
"kind": "msg",
"jp": [
"「あの通り妙に愛想のいい奴だし",
"なんか懐いて来やがるし・・・」"
]
},
{
"id": 11604,
"kind": "msg",
"jp": [
"「・・・?",
"どうかしたんですか?」"
]
},
{
"id": 11605,
"kind": "msg",
"jp": [
"「あいつなぁ、多分",
"気の遣い方が下手なんだろうな」"
]
},
{
"id": 11606,
"kind": "msg",
"jp": [
"「気の遣い方?」"
]
},
{
"id": 11607,
"kind": "msg",
"jp": [
"「気はきく方なんだよ。",
"ただその方向性が時々、妙な方",
"向いてるっつーか・・・」"
]
},
{
"id": 11608,
"kind": "msg",
"jp": [
"「いや、それだけじゃ",
"ねえのかもしれんが」"
]
},
{
"id": 11609,
"kind": "msg",
"jp": [
"「そもそも、なんでいつも",
"着流しなのかわからんし」"
]
},
{
"id": 11610,
"kind": "msg",
"jp": [
"「テレビ局とか楽屋とかでも",
"あの格好なんですか?」"
]
},
{
"id": 11611,
"kind": "msg",
"jp": [
"「最初は衣装かと思ってたんだが",
"いつ見てもああなんだよな」"
]
},
{
"id": 11612,
"kind": "msg",
"jp": [
"「そんな奴、誰が見たって",
"変わりもんだろうよ」"
]
},
{
"id": 11613,
"kind": "msg",
"jp": [
"「そ、そうですね」"
]
},
{
"id": 11614,
"kind": "msg",
"jp": [
"「ま、本人は人目だとか",
"気にしてねえようだが」"
]
},
{
"id": 11615,
"kind": "msg",
"jp": [
"「・・・嫌いじゃねぇけどな",
"そういうどっか馬鹿な奴は」"
]
},
{
"id": 11616,
"kind": "msg",
"jp": [
"「最近の若いのは、",
"体面気にするいい子ちゃん",
"ばっかりでつまらんからな」"
]
},
{
"id": 11617,
"kind": "msg",
"jp": [
"「暗石さんは、斑井さんのことは",
"よくご存じなんですか?」"
]
},
{
"id": 11618,
"kind": "msg",
"jp": [
"「好きで知ってるわけでも",
"ねえけどな」"
]
},
{
"id": 11619,
"kind": "msg",
"jp": [
"「お互い長いこといるせいで、",
"よく鉢合わせるってだけで」"
]
},
{
"id": 11620,
"kind": "msg",
"jp": [
"「ま、芸歴が長いだけが",
"自慢のオッサンだからな」"
]
},
{
"id": 11621,
"kind": "msg",
"jp": [
"「話しててもつまらんし",
"興味ねえしなあ」"
]
},
{
"id": 11622,
"kind": "msg",
"jp": [
"仲は悪いみたいだな・・・。"
]
},
{
"id": 11623,
"kind": "msg",
"jp": [
"「椿くんのことは、",
"前からご存じでした?」"
]
},
{
"id": 11624,
"kind": "msg",
"jp": [
"「ああ、ちょっと前に何か",
"ドラマに出てたの見たからな」"
]
},
{
"id": 11625,
"kind": "msg",
"jp": [
"「直接は・・・いや、一度あったかな。",
"出番は違ったんでろくに話してねえが",
"同じビデオ映画に出てたことがな」"
]
},
{
"id": 11626,
"kind": "msg",
"jp": [
"「スジはいいと思うんだがな、",
"ちょっと気負いすぎだな、ありゃ」"
]
},
{
"id": 11627,
"kind": "msg",
"jp": [
"「普段から役のまんまなところ",
"とかですか?」"
]
},
{
"id": 11628,
"kind": "msg",
"jp": [
"「ま、若いウチはいろいろ",
"試行錯誤するもんだ」"
]
},
{
"id": 11629,
"kind": "msg",
"jp": [
"暗石さんはちょっと微笑ましげに",
"笑いをかみ殺した。"
]
},
{
"id": 11630,
"kind": "msg",
"jp": [
"「那須さんってあの・・・",
"普段からああなんですか?」"
]
},
{
"id": 11631,
"kind": "msg",
"jp": [
"「・・・まあ、たまには",
"あんな役者が居てもいいんじゃねえか」"
]
},
{
"id": 11632,
"kind": "msg",
"jp": [
"ものすごく複雑そうな顔で、",
"自分に言い聞かせるように呟く。"
]
},
{
"id": 11633,
"kind": "msg",
"jp": [
"これ以上突っ込んで聞くと",
"なぜか僕が怒られそうだ・・・。"
]
},
{
"id": 11634,
"kind": "msg",
"jp": [
"「あの、鈴奈ちゃんって・・・」"
]
},
{
"id": 11635,
"kind": "msg",
"jp": [
"「あ、どっちだ?",
"妹の方だったか?」"
]
},
{
"id": 11636,
"kind": "msg",
"jp": [
"「そうです」"
]
},
{
"id": 11637,
"kind": "msg",
"jp": [
"「んじゃ、口の悪い方だな」"
]
},
{
"id": 11638,
"kind": "msg",
"jp": [
"「悪いんですか?」"
]
},
{
"id": 11639,
"kind": "msg",
"jp": [
"「はっきり物言うタチなんだろ。",
"俺は嫌いじゃねえけどな」"
]
},
{
"id": 11640,
"kind": "msg",
"jp": [
"「・・・しかし、口開かねえと",
"見た目じゃ区別つかんなアイツら」"
]
},
{
"id": 11641,
"kind": "msg",
"jp": [
"「僕も見分けつきません・・・」"
]
},
{
"id": 11642,
"kind": "msg",
"jp": [
"「静奈ちゃんには、ここで会う前",
"お会いした事ありますか?」"
]
},
{
"id": 11643,
"kind": "msg",
"jp": [
"「面と向かって話したのは多分",
"初めてだと思うんだが・・・」"
]
},
{
"id": 11644,
"kind": "msg",
"jp": [
"「一度、出た芝居見てるから",
"覚えてはいたけどな。",
"上手かったからな、あの歳で」"
]
},
{
"id": 11645,
"kind": "msg",
"jp": [
"「静奈ちゃん、上手なんですね」"
]
},
{
"id": 11646,
"kind": "msg",
"jp": [
"「ありゃあ、将来が楽しみだな。",
"すげえ女優に化けるかも知れんぞ」"
]
},
{
"id": 11647,
"kind": "msg",
"jp": [
"「暗石さんって、普段はどんな",
"お芝居に出られてるんですか?」"
]
},
{
"id": 11648,
"kind": "msg",
"jp": [
"「あ?",
"どんなも何も俺はただの",
"大部屋俳優だよ」"
]
},
{
"id": 11649,
"kind": "msg",
"jp": [
"「大部屋・・・?」"
]
},
{
"id": 11650,
"kind": "msg",
"jp": [
"「名前があるような役は",
"滅多に回ってこねえってこった」"
]
},
{
"id": 11651,
"kind": "msg",
"jp": [
"そう言いながらも暗石さんは、",
"どこか誇らしげな顔つきだった。"
]
},
{
"id": 11652,
"kind": "msg",
"jp": [
"それだけ自分の仕事に自信とか",
"誇りを持ってるって事かな。"
]
},
{
"id": 11653,
"kind": "msg",
"jp": [
"「・・・でも、たくさん",
"出られてるんですよね」"
]
},
{
"id": 11654,
"kind": "msg",
"jp": [
"「僕でもどこかで見たこと",
"ある人だなってすぐ思ったくらいだし」"
]
},
{
"id": 11655,
"kind": "msg",
"jp": [
"「まぁ、数だけならな」"
]
},
{
"id": 11656,
"kind": "msg",
"jp": [
"「あの、えーと・・・",
"こんなこと聞くのは失礼ですけど」"
]
},
{
"id": 11657,
"kind": "msg",
"jp": [
"「{磯前/いそまえ}だ」"
]
},
{
"id": 11658,
"kind": "msg",
"jp": [
"「磯前 {忠彦/ただひこ}。",
"一度しか言わねえからな」"
]
},
{
"id": 11659,
"kind": "msg",
"jp": [
"「あ、はいっ!」"
]
},
{
"id": 11660,
"kind": "msg",
"jp": [
"「・・・なんでわかったんですか?",
"僕が名前聞こうとしたの・・・」"
]
},
{
"id": 11661,
"kind": "msg",
"jp": [
"「お前、顔に出すぎだ」"
]
},
{
"id": 11662,
"kind": "msg",
"jp": [
"「・・・・はい」"
]
},
{
"id": 11663,
"kind": "msg",
"jp": [
"そんなにわかりやすいのかな",
"僕って・・・。"
]
},
{
"id": 11664,
"kind": "msg",
"jp": [
"「御陵さんの事は",
"以前からご存じでした?」"
]
},
{
"id": 11665,
"kind": "msg",
"jp": [
"「ああ、何度か同じ芝居に出てるな」"
]
},
{
"id": 11666,
"kind": "msg",
"jp": [
"「もっと売れていい女優なんだが、",
"妙にこぢんまりした地方の劇場で",
"ばっかり会うんだよな・・・」"
]
},
{
"id": 11667,
"kind": "msg",
"jp": [
"「舞台のお仕事が好きなんですかね?」"
]
},
{
"id": 11668,
"kind": "msg",
"jp": [
"「かもな。",
"欲がないのかねえ・・・」"
]
},
{
"id": 11669,
"kind": "msg",
"jp": [
"暗石さんは不思議そうに首をひねった。"
]
},
{
"id": 11670,
"kind": "msg",
"jp": [
"「暗石さんは、南雲さんって",
"どこの役者さんだか知ってますか?」"
]
},
{
"id": 11671,
"kind": "msg",
"jp": [
"「滝プロだとか言ってたな。",
"滝プロの誰なのかまでは知らねえが」"
]
},
{
"id": 11672,
"kind": "msg",
"jp": [
"「まあ、滝プロなら大抵知ってっから",
"お前が南雲じゃねえのはわかってるがな」"
]
},
{
"id": 11673,
"kind": "msg",
"jp": [
"「は、はい。",
"僕じゃないです」"
]
},
{
"id": 11674,
"kind": "msg",
"jp": [
"「わかってるっての」"
]
},
{
"id": 11675,
"kind": "msg",
"jp": [
"「暗石さんは、帽子屋って",
"誰だと思います?」"
]
},
{
"id": 11676,
"kind": "msg",
"jp": [
"「さあなぁ、興味ねえからな」"
]
},
{
"id": 11677,
"kind": "msg",
"jp": [
"「ないんですか?",
"誰だかわかんないのに?」"
]
},
{
"id": 11678,
"kind": "msg",
"jp": [
"「今までの芝居は一応全部見たが",
"脚本はおもしれえからな」"
]
},
{
"id": 11679,
"kind": "msg",
"jp": [
"「どこの誰が書いてようと",
"んなこたぁ、どうだっていいさ」"
]
}
]