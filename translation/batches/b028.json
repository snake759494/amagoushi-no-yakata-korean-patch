[
{
"id": 14620,
"kind": "msg",
"jp": [
"「・・・あ、いや、",
"その前に部屋の名前聞かれたっけ」"
]
},
{
"id": 14621,
"kind": "msg",
"jp": [
"「部屋の名前を聞いてから、",
"部屋まで案内されたわけですか」"
]
},
{
"id": 14622,
"kind": "msg",
"jp": [
"「うん、そうそう。",
"そうだったよ」"
]
},
{
"id": 14623,
"kind": "msg",
"jp": [
"「あの、土砂崩れの手前で",
"見たっていう通行止めの看板の",
"ことなんですけど」"
]
},
{
"id": 14624,
"kind": "msg",
"jp": [
"「うん、なんだい?」"
]
},
{
"id": 14625,
"kind": "msg",
"jp": [
"「看板と、他には何か",
"ありましたか?」"
]
},
{
"id": 14626,
"kind": "msg",
"jp": [
"「うーん・・・",
"土嚢が積んであったくらいかな」"
]
},
{
"id": 14627,
"kind": "msg",
"jp": [
"「土嚢ですか」"
]
},
{
"id": 14628,
"kind": "msg",
"jp": [
"「あれは多分、水につけたら",
"ふくらむタイプのヤツじゃないかな」"
]
},
{
"id": 14629,
"kind": "msg",
"jp": [
"「え?",
"そんなのあるんですか?」"
]
},
{
"id": 14630,
"kind": "msg",
"jp": [
"「うん、普通に土を詰めるヤツは",
"重いから一般で売られてる防災用のは",
"最近はそっちのが多いんじゃないかな」"
]
},
{
"id": 14631,
"kind": "msg",
"jp": [
"土を詰めた重い袋を積み上げるのは",
"時間が掛かるだろうけど、そういうの",
"だったら・・・。"
]
},
{
"id": 14632,
"kind": "msg",
"jp": [
"（持ってくるのも、",
"設置するのも1人や2人でも",
"不可能じゃないか・・・）"
]
},
{
"id": 14633,
"kind": "msg",
"jp": [
"「那須さんは、滝プロって事務所",
"よく知ってます?」"
]
},
{
"id": 14634,
"kind": "msg",
"jp": [
"「滝プロはねえ・・・",
"ああ、そうそう!」"
]
},
{
"id": 14635,
"kind": "msg",
"jp": [
"「若手で1人すごく体格のいい子が",
"いるんだよね」"
]
},
{
"id": 14636,
"kind": "msg",
"jp": [
"「確か、元ラグビー部とかって",
"言ってたかなあ」"
]
},
{
"id": 14637,
"kind": "msg",
"jp": [
"「・・・那須さんって、",
"学生時代は何やってたんですか?」"
]
},
{
"id": 14638,
"kind": "msg",
"jp": [
"「図書委員だったよ」"
]
},
{
"id": 14639,
"kind": "msg",
"jp": [
"「本運ぶのってかなり",
"体力いるんだよ」"
]
},
{
"id": 14640,
"kind": "msg",
"jp": [
"たくさんあると重いもんな、紙だし。",
"そりゃあ那須さんみたいな人がいて",
"くれたら助かるだろう。"
]
},
{
"id": 14641,
"kind": "msg",
"jp": [
"「それで、あの、スポーツは・・・?」"
]
},
{
"id": 14642,
"kind": "msg",
"jp": [
"「いろんな運動部に試合があるたびに",
"呼ばれてたから、どこか1つには",
"入ってなかったんだ」"
]
},
{
"id": 14643,
"kind": "msg",
"jp": [
"そうか、いろんなところから頼りに",
"されてて1つに絞れなかったのか。",
"那須さんらしいような気もする。"
]
},
{
"id": 14644,
"kind": "msg",
"jp": [
"「あの、スズメ芸能って",
"事務所のことなんですが」"
]
},
{
"id": 14645,
"kind": "msg",
"jp": [
"「すずめ・・・",
"どこだっけ、それ?」"
]
},
{
"id": 14646,
"kind": "msg",
"jp": [
"「知らないですか?」"
]
},
{
"id": 14647,
"kind": "msg",
"jp": [
"「聞いたことあるような",
"気がするんだけどなあ。",
"それもつい最近・・・」"
]
},
{
"id": 14648,
"kind": "msg",
"jp": [
"「・・・斑井さんの",
"所属事務所です・・・」"
]
},
{
"id": 14649,
"kind": "msg",
"jp": [
"「あー、それでか!",
"そうだった、本人から聞いたんだ」"
]
},
{
"id": 14650,
"kind": "msg",
"jp": [
"忘れるの早すぎないか・・・?"
]
},
{
"id": 14651,
"kind": "msg",
"jp": [
"「那須さんの所属事務所って",
"どんなところですか?」"
]
},
{
"id": 14652,
"kind": "msg",
"jp": [
"「最近、近くにスポーツジムが",
"出来たんで便利に・・・」"
]
},
{
"id": 14653,
"kind": "msg",
"jp": [
"「・・・あ、もしかして",
"場所の話じゃないのかな」"
]
},
{
"id": 14654,
"kind": "msg",
"jp": [
"「あはは、そうか。",
"そりゃそうだよなあ」"
]
},
{
"id": 14655,
"kind": "msg",
"jp": [
"「ジムが出来て嬉しかった",
"もんだからついね」"
]
},
{
"id": 14656,
"kind": "msg",
"jp": [
"「よ、よかったですね」"
]
},
{
"id": 14657,
"kind": "msg",
"jp": [
"「うん、でも後輩とか",
"マネージャーとか誘っても",
"つきあってくれなくてさ」"
]
},
{
"id": 14658,
"kind": "msg",
"jp": [
"「プールも広いし",
"気持ちいいのにな」"
]
},
{
"id": 14659,
"kind": "msg",
"jp": [
"那須さんに付き合えるほどの",
"体力の持ち主がいないん",
"だろうな・・・。"
]
},
{
"id": 14660,
"kind": "msg",
"jp": [
"「仮面・・愛好会?",
"ルチャドールの",
"ファンクラブか何か?」"
]
},
{
"id": 14661,
"kind": "msg",
"jp": [
"「ル・・・え?」"
]
},
{
"id": 14662,
"kind": "msg",
"jp": [
"「あ、違うのか。",
"それじゃ知らないなあ」"
]
},
{
"id": 14663,
"kind": "msg",
"jp": [
"「はあ、あの・・・",
"ルチャドールって何ですか?」"
]
},
{
"id": 14664,
"kind": "msg",
"jp": [
"「メキシコの",
"プロレスラーのことだよ。",
"マスクマンが多いんだ」"
]
},
{
"id": 14665,
"kind": "msg",
"jp": [
"「あ、ああ、",
"なるほど・・・」"
]
},
{
"id": 14666,
"kind": "msg",
"jp": [
"「不思議ビバレーツって",
"知ってますか?」"
]
},
{
"id": 14667,
"kind": "msg",
"jp": [
"「あ、どっかで聞いたことあるな。",
"なんだったっけ」"
]
},
{
"id": 14668,
"kind": "msg",
"jp": [
"「変な商品が多いので",
"有名なジュースの会社です」"
]
},
{
"id": 14669,
"kind": "msg",
"jp": [
"「・・・ああ、あれか!」"
]
},
{
"id": 14670,
"kind": "msg",
"jp": [
"「だいぶ前に一回ポスターの",
"モデルやったことあるんだった」"
]
},
{
"id": 14671,
"kind": "msg",
"jp": [
"「そうなんですか!?」"
]
},
{
"id": 14672,
"kind": "msg",
"jp": [
"「確か、その会社で初めて",
"出したスポーツドリンクだとか",
"言ってたような気がするな」"
]
},
{
"id": 14673,
"kind": "msg",
"jp": [
"「あ・・・",
"飲んだことあります・・・」"
]
},
{
"id": 14674,
"kind": "msg",
"jp": [
"「あはは、あれまずいよね」"
]
},
{
"id": 14675,
"kind": "msg",
"jp": [
"「え、ええ。",
"申し訳ないですけど、",
"すごい味でした」"
]
},
{
"id": 14676,
"kind": "msg",
"jp": [
"「モデルやった時お礼にって",
"一年分もらっちゃって",
"困ったんだよなあ・・・」"
]
},
{
"id": 14677,
"kind": "msg",
"jp": [
"「い、一年分?」"
]
},
{
"id": 14678,
"kind": "msg",
"jp": [
"「うん、365本」"
]
},
{
"id": 14679,
"kind": "msg",
"jp": [
"「その、それ全部",
"飲んだんですか・・・?」"
]
},
{
"id": 14680,
"kind": "msg",
"jp": [
"「事務所とかで配ろうとしたら",
"みんな逃げちゃったからなあ」"
]
},
{
"id": 14681,
"kind": "msg",
"jp": [
"「・・・でしょうね・・・」"
]
},
{
"id": 14682,
"kind": "msg",
"jp": [
"「今回の脚本って、",
"どんな感じですか?」"
]
},
{
"id": 14683,
"kind": "msg",
"jp": [
"「それがわからないんだよ。",
"まだ最初の場面しかないしね」"
]
},
{
"id": 14684,
"kind": "msg",
"jp": [
"「そっか、どんな話になるのかも",
"想像つかないですよね」"
]
},
{
"id": 14685,
"kind": "msg",
"jp": [
"「うん、それもあるんだけど・・・」"
]
},
{
"id": 14686,
"kind": "msg",
"jp": [
"「他にも何かあるんですか?」"
]
},
{
"id": 14687,
"kind": "msg",
"jp": [
"「一番わからないのは、",
"誰が書いたのかなあってこと」"
]
},
{
"id": 14688,
"kind": "msg",
"jp": [
"「文章にも絵柄と同じでクセって",
"あるもんなんだよ」"
]
},
{
"id": 14689,
"kind": "msg",
"jp": [
"「でも、これだけじゃちょっと",
"誰だかわからないんだよなあ。",
"知らない人のような気はするけど」"
]
},
{
"id": 14690,
"kind": "msg",
"jp": [
"「虹色の愛の架け橋っていう",
"ドラマ知ってますか?」"
]
},
{
"id": 14691,
"kind": "msg",
"jp": [
"「うん、昔見たことあるよ。",
"斑井さんが出てたんだっけ」"
]
},
{
"id": 14692,
"kind": "msg",
"jp": [
"「そうらしいんですけど、",
"どんな話なのか・・・」"
]
},
{
"id": 14693,
"kind": "msg",
"jp": [
"「んー、よく覚えてないけど",
"人捜しの下手な人と、",
"口べたな人が出てきたような・・・」"
]
},
{
"id": 14694,
"kind": "msg",
"jp": [
"どんな話なんだ。"
]
},
{
"id": 14695,
"kind": "msg",
"jp": [
"（・・・というか、那須さんの",
"覚え方が微妙すぎるのか・・・）"
]
},
{
"id": 14696,
"kind": "msg",
"jp": [
"「那須さん、『白夜』って",
"ビデオ映画覚えてますか?」"
]
},
{
"id": 14697,
"kind": "msg",
"jp": [
"「白夜?",
"どんなんだっけ」"
]
},
{
"id": 14698,
"kind": "msg",
"jp": [
"「僕も内容は知らないんですけど",
"その時打ち上げで那須さんに",
"会ったっていう話を聞いたんで・・・」"
]
},
{
"id": 14699,
"kind": "msg",
"jp": [
"「打ち上げかあ。",
"僕、よく友達に誘われて",
"行くからなあ」"
]
},
{
"id": 14700,
"kind": "msg",
"jp": [
"「・・・時々、似たような場所で",
"いくつも宴会やってると間違えて",
"違うのに混じってたりもするけど」"
]
},
{
"id": 14701,
"kind": "msg",
"jp": [
"「え、あの、じゃあもしかして",
"『白夜』の時も・・・」"
]
},
{
"id": 14702,
"kind": "msg",
"jp": [
"「・・・そうだったのかも。",
"なんか話の内容覚えてないし」"
]
},
{
"id": 14703,
"kind": "msg",
"jp": [
"つくづく豪快な人だな。",
"普通、呼んでくれた友達が見当たらない",
"時点で気が付きそうなもんだけど。"
]
},
{
"id": 14704,
"kind": "msg",
"jp": [
"（気付かないのが那須さん",
"なんだろうなあ・・・）"
]
},
{
"id": 14705,
"kind": "msg",
"jp": [
"「うーん、白夜なあ・・・」"
]
},
{
"id": 14706,
"kind": "msg",
"jp": [
"「あ、ひょっとして",
"暗石さんもいたやつかな」"
]
},
{
"id": 14707,
"kind": "msg",
"jp": [
"「それです、多分」"
]
},
{
"id": 14708,
"kind": "msg",
"jp": [
"「そう言えば、暗石さんがいた",
"飲み会に顔出したような",
"覚えがあるからそれかなあ?」"
]
},
{
"id": 14709,
"kind": "msg",
"jp": [
"「その時・・・",
"ここにいる人達がみんないた",
"らしいんですけど覚えてませんか?」"
]
},
{
"id": 14710,
"kind": "msg",
"jp": [
"「え? みんないたの?",
"それは覚えてないなあ」"
]
},
{
"id": 14711,
"kind": "msg",
"jp": [
"「麻雀地獄伝説って話",
"知ってます?」"
]
},
{
"id": 14712,
"kind": "msg",
"jp": [
"「麻雀かぁ・・・",
"僕、苦手なんだよね」"
]
},
{
"id": 14713,
"kind": "msg",
"jp": [
"「なんか上がると怒られるんだよ、",
"捨ててる牌と待ってる牌が",
"あってないとか言われて」"
]
},
{
"id": 14714,
"kind": "msg",
"jp": [
"「・・・はい?」"
]
},
{
"id": 14715,
"kind": "msg",
"jp": [
"「普通、捨てないもの",
"捨ててるんだって。",
"よくわかんないんだけどさ」"
]
},
{
"id": 14716,
"kind": "msg",
"jp": [
"「えーと・・・",
"那須さん、もしかして強いですか」"
]
},
{
"id": 14717,
"kind": "msg",
"jp": [
"「ああ、うん。",
"負けないんだけど、怒られるんだ」"
]
},
{
"id": 14718,
"kind": "msg",
"jp": [
"・・・わけわかんない打ち方なのに",
"強いって事か・・・。"
]
},
{
"id": 14719,
"kind": "msg",
"jp": [
"そりゃ、負けた人は怒るだろうな。"
]
},
{
"id": 14720,
"kind": "msg",
"jp": [
"「那須さん、白蛇殺人事件って",
"話知ってますか?」"
]
},
{
"id": 14721,
"kind": "msg",
"jp": [
"「白蛇・・・",
"えーっと、南雲さんが",
"出てくるやつだっけ?」"
]
},
{
"id": 14722,
"kind": "msg",
"jp": [
"「あ、それです」"
]
},
{
"id": 14723,
"kind": "msg",
"jp": [
"「そうだよね。",
"それはなんとなく覚えて",
"たんだけどなあ・・・」"
]
},
{
"id": 14724,
"kind": "msg",
"jp": [
"「読んだのかなり昔だから",
"どういう話だったかはっきり",
"覚えてないや」"
]
},
{
"id": 14725,
"kind": "msg",
"jp": [
"けど那須さん、作品は読んでるんだ。"
]
},
{
"id": 14726,
"kind": "msg",
"jp": [
"「アメフラシ戦記って",
"知ってます?」"
]
},
{
"id": 14727,
"kind": "msg",
"jp": [
"「え? なんだっけそれ?」"
]
},
{
"id": 14728,
"kind": "msg",
"jp": [
"「ゲームらしいです、",
"RPGの・・・」"
]
},
{
"id": 14729,
"kind": "msg",
"jp": [
"「ああ、うちのマネージャーが",
"買ったけど15分で挫折したって",
"言ってたやつかなあ」"
]
},
{
"id": 14730,
"kind": "msg",
"jp": [
"「じゅ、15分・・・」"
]
},
{
"id": 14731,
"kind": "msg",
"jp": [
"「なんか相当難しいらしいね。",
"ぼく、ゲームはやらないから",
"よく知らないんだけどさ」"
]
},
{
"id": 14732,
"kind": "msg",
"jp": [
"15分で挫折するRPGって。",
"それは相当問題があるんじゃ・・・。"
]
},
{
"id": 14733,
"kind": "msg",
"jp": [
"「あかつきの・・・",
"あー、懐かしいなあ!」"
]
},
{
"id": 14734,
"kind": "msg",
"jp": [
"「ぼく、1話だけ",
"出てるんだよ、あれ」"
]
},
{
"id": 14735,
"kind": "msg",
"jp": [
"「刑事さんが聞き込みに来た",
"アパートで作業してる引っ越し屋の",
"うちの1人がぼくだよ」"
]
},
{
"id": 14736,
"kind": "msg",
"jp": [
"「そ、そうなんですか・・・」"
]
},
{
"id": 14737,
"kind": "msg",
"jp": [
"「でもあれ、再放送ないから",
"もう見られないかもなあ」"
]
},
{
"id": 14738,
"kind": "msg",
"jp": [
"ちょっと見てみたかったけど",
"無理なのか・・・。"
]
},
{
"id": 14739,
"kind": "msg",
"jp": [
"「この館ってずいぶん古いですね。",
"すごく広いし」"
]
},
{
"id": 14740,
"kind": "msg",
"jp": [
"「うん、広いんだけどさあ、",
"トレーニングしようとすると",
"椿くんが怒るんだよね」"
]
},
{
"id": 14741,
"kind": "msg",
"jp": [
"「・・・そりゃそうでしょう」"
]
},
{
"id": 14742,
"kind": "msg",
"jp": [
"「表にランニングに行こうとしても",
"止められるしなあ」"
]
},
{
"id": 14743,
"kind": "msg",
"jp": [
"「危ないですってば!",
"大雨だし足元悪いし・・・」"
]
},
{
"id": 14744,
"kind": "msg",
"jp": [
"「困ったもんだね」"
]
},
{
"id": 14745,
"kind": "msg",
"jp": [
"・・・天候も困ったもんだけど、",
"那須さんも十分困った人だ・・・。"
]
},
{
"id": 14746,
"kind": "msg",
"jp": [
"「食堂ってあの後入ったこと",
"ありますか?」"
]
},
{
"id": 14747,
"kind": "msg",
"jp": [
"「食堂?",
"今は鍵閉まってるんじゃなかったっけ」"
]
},
{
"id": 14748,
"kind": "msg",
"jp": [
"「ええ、閉めてあります」"
]
},
{
"id": 14749,
"kind": "msg",
"jp": [
"「だよね。",
"ぼくは入ってないよ」"
]
},
{
"id": 14750,
"kind": "msg",
"jp": [
"「那須さんが最後に娯楽室に",
"入ったのっていつですか?」"
]
},
{
"id": 14751,
"kind": "msg",
"jp": [
"「娯楽室は・・・",
"多分、和くんがこの部屋に",
"泊まった夜だと思うんだけど」"
]
},
{
"id": 14752,
"kind": "msg",
"jp": [
"「ああ、あの時・・・」"
]
},
{
"id": 14753,
"kind": "msg",
"jp": [
"「うん、確かそのはずだよ。",
"あの後は入ってないよ」"
]
},
{
"id": 14754,
"kind": "msg",
"jp": [
"「あの・・・",
"裏庭の井戸のことで・・・」"
]
},
{
"id": 14755,
"kind": "msg",
"jp": [
"「・・・あれってなんで",
"井戸だったんだろう」"
]
},
{
"id": 14756,
"kind": "msg",
"jp": [
"「いや、南雲さん・・・",
"かもしれない人の死体をさ、",
"なんで井戸に入れたのかなと思って」"
]
},
{
"id": 14757,
"kind": "msg",
"jp": [
"「和くんに見つけられて",
"慌てたのかな」"
]
},
{
"id": 14758,
"kind": "msg",
"jp": [
"「・・・僕にもまだ",
"よくわからないです」"
]
},
{
"id": 14759,
"kind": "msg",
"jp": [
"「だよねえ」"
]
},
{
"id": 14760,
"kind": "msg",
"jp": [
"「那須さんの部屋にも",
"ベランダはないんですね」"
]
},
{
"id": 14761,
"kind": "msg",
"jp": [
"「そうなんだよね。",
"こっち側の部屋にはどこも",
"ついてないみたいだね」"
]
},
{
"id": 14762,
"kind": "msg",
"jp": [
"「ええ、僕らの部屋にもないです」"
]
},
{
"id": 14763,
"kind": "msg",
"jp": [
"「あったら懸垂するんだけどなあ」"
]
},
{
"id": 14764,
"kind": "msg",
"jp": [
"那須さんの部屋にだけは",
"ない方がよかったようだ・・・。"
]
},
{
"id": 14765,
"kind": "msg",
"jp": [
"「居間の外にあるテラスって",
"晴れてたら気持ちよさそうですね」"
]
},
{
"id": 14766,
"kind": "msg",
"jp": [
"「うん、あれいいよね。",
"うちにも欲しいなあ」"
]
},
{
"id": 14767,
"kind": "msg",
"jp": [
"「那須さんの家って",
"庭とかあるんですか?」"
]
},
{
"id": 14768,
"kind": "msg",
"jp": [
"「こんなに広くはないけど",
"一応あるにはあるよ」"
]
},
{
"id": 14769,
"kind": "msg",
"jp": [
"「けど、あんな広いテラスが",
"作れるほどじゃないしなあ」"
]
},
{
"id": 14770,
"kind": "msg",
"jp": [
"「へえ・・・",
"でも一軒家なんですね」"
]
},
{
"id": 14771,
"kind": "msg",
"jp": [
"「うん、古いけどね。",
"でも地下室も無いしリング置けるほど",
"広くもないんだよな・・・」"
]
},
{
"id": 14772,
"kind": "msg",
"jp": [
"置きたいんだ、リング・・・。"
]
},
{
"id": 14773,
"kind": "msg",
"jp": [
"「温室って、あの騒ぎの前に",
"入ったことあるんでしたっけ」"
]
},
{
"id": 14774,
"kind": "msg",
"jp": [
"「温室はないんだよね。",
"和くんが来てからの騒ぎで",
"初めて入ったんだ」"
]
},
{
"id": 14775,
"kind": "msg",
"jp": [
"「あそこって晴れてたら",
"サウナみたいになるのかなあ」"
]
},
{
"id": 14776,
"kind": "msg",
"jp": [
"「え、ええ、まあ・・・",
"かなり暖かいんじゃないかと」"
]
},
{
"id": 14777,
"kind": "msg",
"jp": [
"「そうか、いいかも・・・」"
]
},
{
"id": 14778,
"kind": "msg",
"jp": [
"・・・何がだろう・・・。"
]
},
{
"id": 14779,
"kind": "msg",
"jp": [
"「那須さん、台所って",
"どれくらい使ってます?」"
]
},
{
"id": 14780,
"kind": "msg",
"jp": [
"「台所?",
"よく行くけど、冷蔵庫以外",
"触ったことないなあ」"
]
},
{
"id": 14781,
"kind": "msg",
"jp": [
"「あ、そうなんですか。",
"料理ってあんまりしないんですか?」"
]
},
{
"id": 14782,
"kind": "msg",
"jp": [
"「ちゃんこ鍋なら得意なんだけど、",
"ここで作ってもみんな食べる気",
"しなさそうだしなあ」"
]
},
{
"id": 14783,
"kind": "msg",
"jp": [
"「な、鍋物は・・・そうですね・・・」"
]
},
{
"id": 14784,
"kind": "msg",
"jp": [
"「応接室って",
"のぞいたことあります?」"
]
},
{
"id": 14785,
"kind": "msg",
"jp": [
"「あるよ、最初の日に。",
"なんか変な仮面がある部屋だよね」"
]
},
{
"id": 14786,
"kind": "msg",
"jp": [
"「けど、それ以外は",
"普通の部屋だったなあ」"
]
},
{
"id": 14787,
"kind": "msg",
"jp": [
"「娯楽室っていろんなもの",
"置いてありますね」"
]
},
{
"id": 14788,
"kind": "msg",
"jp": [
"「うーん、でもあんまり",
"ぼくが得意なのはないんだよね」"
]
},
{
"id": 14789,
"kind": "msg",
"jp": [
"「那須さんが得意なのって・・・」"
]
},
{
"id": 14790,
"kind": "msg",
"jp": [
"「せめてビリヤードが",
"あったらなあ」"
]
},
{
"id": 14791,
"kind": "msg",
"jp": [
"「あ、ビリヤードですか」"
]
},
{
"id": 14792,
"kind": "msg",
"jp": [
"（もっと、どう考えても屋内には",
"置いてないだろうっていうようなのを",
"言い出すかと思った・・・）"
]
},
{
"id": 14793,
"kind": "msg",
"jp": [
"「それか、ボウリングとか",
"バスケットのゴールとか」"
]
},
{
"id": 14794,
"kind": "msg",
"jp": [
"（い、一応屋内だけど・・・",
"どっちも屋内にあるけど・・・・）"
]
},
{
"id": 14795,
"kind": "msg",
"jp": [
"「書斎の中ってみました?」"
]
},
{
"id": 14796,
"kind": "msg",
"jp": [
"「うん、見たよ。",
"すごい蔵書だよね」"
]
},
{
"id": 14797,
"kind": "msg",
"jp": [
"「洋書がほとんどみたいだったね。",
"日本語の本が並んでる棚は2つか3つ",
"だったのかな」"
]
},
{
"id": 14798,
"kind": "msg",
"jp": [
"「全部の棚見たんですか?」"
]
},
{
"id": 14799,
"kind": "msg",
"jp": [
"「ざっと背表紙ながめた程度だよ。",
"白い本棚が一番変なのが多かったな」"
]
},
{
"id": 14800,
"kind": "msg",
"jp": [
"「へ、変なの?」"
]
},
{
"id": 14801,
"kind": "msg",
"jp": [
"「何の本だかわからないのが",
"いっぱいあったんだよね。",
"あれ、何なんだろう・・・」"
]
},
{
"id": 14802,
"kind": "msg",
"jp": [
"（どれのことだろ・・・?",
"後で見てみようかな）"
]
},
{
"id": 14803,
"kind": "msg",
"jp": [
"「物置の中って見てみたこと",
"ありますか?」"
]
},
{
"id": 14804,
"kind": "msg",
"jp": [
"「あー、あるよ。",
"最初の日にあちこち開けて",
"みてたから」"
]
},
{
"id": 14805,
"kind": "msg",
"jp": [
"「・・・けど、椿くんに",
"見つかって怒られちゃった」"
]
},
{
"id": 14806,
"kind": "msg",
"jp": [
"「な、何かしたんですか?」"
]
},
{
"id": 14807,
"kind": "msg",
"jp": [
"「重そうな置物持ち上げて",
"みてただけなんだけどなあ」"
]
},
{
"id": 14808,
"kind": "msg",
"jp": [
"・・・そのまま、それで身体を",
"鍛え始めたら困るからじゃあ・・・。"
]
},
{
"id": 14809,
"kind": "msg",
"jp": [
"「那須さんの部屋って、",
"他の人の部屋と特に変わらないん",
"ですかね」"
]
},
{
"id": 14810,
"kind": "msg",
"jp": [
"「そうなんじゃない?",
"基本的に2階はほとんど客間で",
"同じデザインみたいだし」"
]
},
{
"id": 14811,
"kind": "msg",
"jp": [
"「広いですよね。",
"ホテルみたい」"
]
},
{
"id": 14812,
"kind": "msg",
"jp": [
"「んー、でもトレーニング",
"するにはちょっと狭いんだよね」"
]
},
{
"id": 14813,
"kind": "msg",
"jp": [
"「そ、そうでしょうね・・・」"
]
},
{
"id": 14814,
"kind": "msg",
"jp": [
"「向こうの廊下に1部屋だけ他と違う",
"感じの部屋がありますよね」"
]
},
{
"id": 14815,
"kind": "msg",
"jp": [
"「あー、あの開かずの間とか",
"いう名前がついてるやつだよね?」"
]
},
{
"id": 14816,
"kind": "msg",
"jp": [
"「ええ、そうです。",
"入ったことあります?」"
]
},
{
"id": 14817,
"kind": "msg",
"jp": [
"「それがないんだよ。",
"最初の日にあちこちのぞいて",
"回ってたらさ・・・」"
]
},
{
"id": 14818,
"kind": "msg",
"jp": [
"「そのうち椿くんが後ろからずっと",
"ついて来て、なぜか案内してくれたん",
"だけど、あの部屋には入るなって・・」"
]
},
{
"id": 14819,
"kind": "msg",
"jp": [
"それはもしや、案内じゃなくて",
"見張りとしてついて回ってただけ",
"なんじゃあ・・・。"
]
},
{
"id": 14820,
"kind": "msg",
"jp": [
"「2階の奥の方にも",
"納戸がありますね」"
]
},
{
"id": 14821,
"kind": "msg",
"jp": [
"「え? そうなの?」"
]
},
{
"id": 14822,
"kind": "msg",
"jp": [
"「うん、気が付かなかった。",
"何か面白そうなものあった?」"
]
},
{
"id": 14823,
"kind": "msg",
"jp": [
"「いえ、普通の物置",
"みたいでしたけど」"
]
},
{
"id": 14824,
"kind": "msg",
"jp": [
"「そっか、残念だなあ」"
]
},
{
"id": 14825,
"kind": "msg",
"jp": [
"・・・何が入ってることを",
"期待してたんだろう・・・。"
]
},
{
"id": 14826,
"kind": "msg",
"jp": [
"「古い館ってなんで大抵",
"地下室があるんでしょうね」"
]
},
{
"id": 14827,
"kind": "msg",
"jp": [
"「なんでだろう?",
"物置なのかな?」"
]
},
{
"id": 14828,
"kind": "msg",
"jp": [
"「けどここの地下室って",
"館の大きさのわりに狭いよね」"
]
},
{
"id": 14829,
"kind": "msg",
"jp": [
"「・・・そう言えば",
"そうかなあ・・・?」"
]
},
{
"id": 14830,
"kind": "msg",
"jp": [
"「なんか、地下に迷路",
"みたいなのがあって・・・」"
]
},
{
"id": 14831,
"kind": "msg",
"jp": [
"「えっ!?",
"なにそれ、ちょっと見てきていい?」"
]
},
{
"id": 14832,
"kind": "msg",
"jp": [
"「ま、待って下さいっ!」"
]
},
{
"id": 14833,
"kind": "msg",
"jp": [
"「・・・駄目?」"
]
},
{
"id": 14834,
"kind": "msg",
"jp": [
"「あの、へ、下手にですね犯人に",
"地下迷路のこと僕らが気づいてるって",
"ばれると刺激しちゃうかも・・・」"
]
},
{
"id": 14835,
"kind": "msg",
"jp": [
"特に那須さんの場合、",
"なぜか予想以上の大騒ぎに",
"発展しそうな気がする。"
]
},
{
"id": 14836,
"kind": "msg",
"jp": [
"「んー、そっかあ。",
"じゃあ事件が解決してからに",
"した方がいいんだ」"
]
},
{
"id": 14837,
"kind": "msg",
"jp": [
"「そう、そうです」"
]
},
{
"id": 14838,
"kind": "msg",
"jp": [
"事件が解決したら呑気にそんなとこ",
"見学に行ってる場合かどうか",
"わかんないけど・・・。"
]
},
{
"id": 14839,
"kind": "msg",
"jp": [
"「ああ、あったね。",
"開けてみたの?」"
]
},
{
"id": 14840,
"kind": "msg",
"jp": [
"「いえ、開けてはないですけど」"
]
},
{
"id": 14841,
"kind": "msg",
"jp": [
"「ふうん・・・",
"あれって降りられるのかな」"
]
},
{
"id": 14842,
"kind": "msg",
"jp": [
"「お、降りる?」"
]
},
{
"id": 14843,
"kind": "msg",
"jp": [
"「どっかに繋がってたり",
"しないかなあと思ってさ」"
]
},
{
"id": 14844,
"kind": "msg",
"jp": [
"・・・それは井戸じゃなくて",
"何か別のもののような気が。"
]
},
{
"id": 14845,
"kind": "msg",
"jp": [
"「部屋の名前",
"なんですけど・・・」"
]
},
{
"id": 14846,
"kind": "msg",
"jp": [
"「ああ、ここの部屋って",
"全部作家の名前だよね」"
]
},
{
"id": 14847,
"kind": "msg",
"jp": [
"「どういう基準でつけてるのか",
"よくわからないけど」"
]
},
{
"id": 14848,
"kind": "msg",
"jp": [
"「基準?」"
]
},
{
"id": 14849,
"kind": "msg",
"jp": [
"「娯楽室は黄色くないし、",
"日織くんの部屋も赤くないしさ」"
]
},
{
"id": 14850,
"kind": "msg",
"jp": [
"「部屋の名前と内装とは",
"別に関係ないのかな」"
]
},
{
"id": 14851,
"kind": "msg",
"jp": [
"「・・・多分、",
"ないんじゃないかと」"
]
},
{
"id": 14852,
"kind": "msg",
"jp": [
"「だよなあ。",
"でないと風呂場なんか隅っこに",
"いつもおじいさんが座ってるよ」"
]
},
{
"id": 14853,
"kind": "msg",
"jp": [
"「そんな風呂イヤです・・・」"
]
},
{
"id": 14854,
"kind": "msg",
"jp": [
"「あの、地下室にあった",
"長持なんですけど」"
]
},
{
"id": 14855,
"kind": "msg",
"jp": [
"「あれねえ・・・」"
]
},
{
"id": 14856,
"kind": "msg",
"jp": [
"「あれ以前に開けてみたことって",
"あります?」"
]
},
{
"id": 14857,
"kind": "msg",
"jp": [
"「うーん、元からあの場所に",
"あったのは覚えてるんだけど",
"開けたことはなかったな」"
]
},
{
"id": 14858,
"kind": "msg",
"jp": [
"「暗石さんの部屋に、",
"薔薇の絵が置いてあったんですけど」"
]
},
{
"id": 14859,
"kind": "msg",
"jp": [
"「薔薇の絵?",
"暗石さんの部屋に飾ってあった",
"やつとは別に?」"
]
},
{
"id": 14860,
"kind": "msg",
"jp": [
"「なんか応接室にあった絵",
"みたいなんです」"
]
},
{
"id": 14861,
"kind": "msg",
"jp": [
"「へえ、応接室かあ。",
"あの部屋は変な仮面があったって",
"くらいしか覚えてないなあ」"
]
},
{
"id": 14862,
"kind": "msg",
"jp": [
"「暗石さんの・・・",
"あの矢って、弓で撃ったんでしょうか」"
]
},
{
"id": 14863,
"kind": "msg",
"jp": [
"「うーん・・・",
"ぼくもそんなにはっきり見ては",
"いないんだけどさ・・・」"
]
},
{
"id": 14864,
"kind": "msg",
"jp": [
"「たとえ暗石さんが抵抗しなかった",
"としても手で持ってあんなふうに",
"刺すのは無理じゃないかな」"
]
},
{
"id": 14865,
"kind": "msg",
"jp": [
"「じゃあやっぱり射殺・・・?」"
]
},
{
"id": 14866,
"kind": "msg",
"jp": [
"「だと思うんだけど、",
"そうなると今度はどこからどうやって",
"撃ったのかが謎だよね」"
]
},
{
"id": 14867,
"kind": "msg",
"jp": [
"「そうなんですよね。",
"窓も閉まってたし、",
"扉も鍵がかかってました」"
]
},
{
"id": 14868,
"kind": "msg",
"jp": [
"「それもあるんだけどさ、",
"そもそもあんな真正面から額を",
"射抜こうと思ったら・・」"
]
},
{
"id": 14869,
"kind": "msg",
"jp": [
"「よっぽど不意をつかないと",
"普通逃げられるよね」"
]
},
{
"id": 14870,
"kind": "msg",
"jp": [
"「ああ、そうですね」"
]
},
{
"id": 14871,
"kind": "msg",
"jp": [
"「つまり時間を掛けて狙いを定めてる",
"暇はなかったと思うんだよ」"
]
},
{
"id": 14872,
"kind": "msg",
"jp": [
"「暗石さんの意識が無かったなら",
"別だけど、寝てるところを襲われたって",
"感じじゃなかっただろ?」"
]
},
{
"id": 14873,
"kind": "msg",
"jp": [
"暗石さんは床の上に倒れていたし",
"服装は普段着のままで、しかも",
"目を開けたまま亡くなってた・・。"
]
},
{
"id": 14874,
"kind": "msg",
"jp": [
"「・・・じゃあ犯人は、",
"一瞬で狙いを定めて一発で",
"額を射抜いたことに・・・?」"
]
},
{
"id": 14875,
"kind": "msg",
"jp": [
"「うーん・・・",
"狙いを定めたのが一瞬かどうか",
"まではわからないけどね」"
]
},
{
"id": 14876,
"kind": "msg",
"jp": [
"「え?",
"どういう・・・」"
]
},
{
"id": 14877,
"kind": "msg",
"jp": [
"「その時、暗石さんが",
"どこでどんな体勢をしてるかが",
"わかってれば先に構えてられるよ」"
]
},
{
"id": 14878,
"kind": "msg",
"jp": [
"「たとえばぼくだったら、",
"毎朝同じ時間に必ず柔軟をやってるから",
"ある程度予想出来るだろうなあ」"
]
},
{
"id": 14879,
"kind": "msg",
"jp": [
"「・・・暗石さんってそういう",
"毎日必ず同じ行動をする習慣って",
"ありましたっけ」"
]
},
{
"id": 14880,
"kind": "msg",
"jp": [
"「さあ・・・?",
"そこまでは知らないけど」"
]
},
{
"id": 14881,
"kind": "msg",
"jp": [
"あまり習慣化した行動ってしてなさそう",
"なんだよな・・・。"
]
},
{
"id": 14882,
"kind": "msg",
"jp": [
"だったら、あらかじめ暗石さんが",
"部屋のどの辺に立つかなんて",
"知りようがないのか・・・?"
]
},
{
"id": 14883,
"kind": "msg",
"jp": [
"（でも、もしそれが想定できたら",
"ある程度は狙いを定めておける・・・）"
]
},
{
"id": 14884,
"kind": "msg",
"jp": [
"（・・・そんなことが",
"可能だったら、だけど・・・）"
]
},
{
"id": 14885,
"kind": "msg",
"jp": [
"「あの、凶器の・・",
"斧なんですけど・・・」"
]
},
{
"id": 14886,
"kind": "msg",
"jp": [
"「あれさ、ぼく持ってみたこと",
"あるんだけどさ」"
]
},
{
"id": 14887,
"kind": "msg",
"jp": [
"「も、持って?」"
]
},
{
"id": 14888,
"kind": "msg",
"jp": [
"「うん、本物なのかなと思って」"
]
},
{
"id": 14889,
"kind": "msg",
"jp": [
"「見た感じ全体的に鉄製で",
"すごい重そうだったんだけど、",
"持ってみたら意外と軽かった」"
]
},
{
"id": 14890,
"kind": "msg",
"jp": [
"「えーと、それは・・・",
"那須さんの腕力だから軽く感じた",
"わけじゃなくですか?」"
]
},
{
"id": 14891,
"kind": "msg",
"jp": [
"「いや、和くんでも",
"持ち上げられたと思うよ」"
]
},
{
"id": 14892,
"kind": "msg",
"jp": [
"「実際に鉄なのは刃の部分だけで",
"柄はスチールか何かを鈍い色に",
"塗っただけみたいだったから」"
]
},
{
"id": 14893,
"kind": "msg",
"jp": [
"だったら、相当な腕力の持ち主じゃ",
"なければ振り上げたり出来ないって",
"ほどではないんだ。"
]
},
{
"id": 14894,
"kind": "msg",
"jp": [
"「てるてる坊主吊ったりしてた時",
"会ったのって部屋に来た",
"椿くんだけですか?」"
]
},
{
"id": 14895,
"kind": "msg",
"jp": [
"「吊ってたときじゃなくて、",
"外してるときだったら",
"静奈ちゃんに会ったよ」"
]
},
{
"id": 14896,
"kind": "msg",
"jp": [
"「あ、外してるときですか」"
]
},
{
"id": 14897,
"kind": "msg",
"jp": [
"「きつく縛りすぎてなかなか",
"ほどけなくて苦労してたら、",
"静奈ちゃんが来てさ・・・」"
]
},
{
"id": 14898,
"kind": "msg",
"jp": [
"「何か話しました?」"
]
},
{
"id": 14899,
"kind": "msg",
"jp": [
"「夜中に何してんのって",
"不思議がられた」"
]
},
{
"id": 14900,
"kind": "msg",
"jp": [
"そりゃそうだろうな・・・。"
]
},
{
"id": 14901,
"kind": "msg",
"jp": [
"「温室に『復讐』って書いた紙が",
"置いてあったじゃないですか」"
]
},
{
"id": 14902,
"kind": "msg",
"jp": [
"「ああ、あれね。",
"いつ温室に置いたのかな」"
]
},
{
"id": 14903,
"kind": "msg",
"jp": [
"「那須さんは、あの騒ぎの前に",
"温室に入ったことはなかったん",
"でしたっけ」"
]
},
{
"id": 14904,
"kind": "msg",
"jp": [
"「えーと、初日の昼だよね。",
"うん、温室はのぞかなかったな」"
]
},
{
"id": 14905,
"kind": "msg",
"jp": [
"「館の中をあちこち見てたら",
"椿くんが、ほとんど全員揃ったから",
"居間に来いって呼びにきてくれてさ」"
]
},
{
"id": 14906,
"kind": "msg",
"jp": [
"「庭まで見て回る前に台本の",
"読み合わせが始まっちゃってね」"
]
},
{
"id": 14907,
"kind": "msg",
"jp": [
"館の中だけでもけっこうな",
"広さだもんなあ・・・。"
]
},
{
"id": 14908,
"kind": "msg",
"jp": [
"「温室にあった猫の置物って",
"見覚えとかないですか?」"
]
},
{
"id": 14909,
"kind": "msg",
"jp": [
"「ないと思うなあ・・・",
"少なくとも、この館のどこかに",
"飾られてたりはしなかったと思うけど」"
]
},
{
"id": 14910,
"kind": "msg",
"jp": [
"「この館のにしては、",
"安物っぽい感じですよね」"
]
},
{
"id": 14911,
"kind": "msg",
"jp": [
"「そうだよね。",
"じゃあ犯人が持ってきたんだろうなあ」"
]
},
{
"id": 14912,
"kind": "msg",
"jp": [
"「ここの電話が外に通じてたら",
"よかったですよね・・・」"
]
},
{
"id": 14913,
"kind": "msg",
"jp": [
"「そうなんだよ。",
"まさか電話が無いとはなあ」"
]
},
{
"id": 14914,
"kind": "msg",
"jp": [
"「携帯も通じないし・・・」"
]
},
{
"id": 14915,
"kind": "msg",
"jp": [
"「ぼく、携帯持ってないんだよね」"
]
},
{
"id": 14916,
"kind": "msg",
"jp": [
"「え? そうなんですか?」"
]
},
{
"id": 14917,
"kind": "msg",
"jp": [
"「持てって言われてるんだけど、",
"ああいう細かい機械苦手でさあ」"
]
},
{
"id": 14918,
"kind": "msg",
"jp": [
"「特にメールとか、",
"全然わかんなくって」"
]
},
{
"id": 14919,
"kind": "msg",
"jp": [
"「じゃあパソコンは?」"
]
},
{
"id": 14920,
"kind": "msg",
"jp": [
"「ああ、もうまったく駄目。",
"携帯よりさっぱりだな」"
]
},
{
"id": 14921,
"kind": "msg",
"jp": [
"本気で苦手らしく、那須さんは",
"照れくさそうに頭をかいた。"
]
},
{
"id": 14922,
"kind": "msg",
"jp": [
"「娯楽室のラジオって",
"来てから触ったことあります?」"
]
},
{
"id": 14923,
"kind": "msg",
"jp": [
"「ぼくは触ってないよ。",
"あのオーディオでラジオも聞けるのも",
"暗石さんがつけるまで知らなかったし」"
]
},
{
"id": 14924,
"kind": "msg",
"jp": [
"「うん、特に注意してみて",
"なかったからなあ」"
]
},
{
"id": 14925,
"kind": "msg",
"jp": [
"「そうですね・・・。",
"僕も用が無いとそんなに",
"くわしく見ないし」"
]
},
{
"id": 14926,
"kind": "msg",
"jp": [
"「・・・そう言えばぼく、",
"ラジオの仕事って",
"やったことないなあ」"
]
},
{
"id": 14927,
"kind": "msg",
"jp": [
"見た目のインパクトのせいで",
"声だけの仕事が来ないのかな。"
]
},
{
"id": 14928,
"kind": "msg",
"jp": [
"それとも、話す内容がある一定の",
"方向に偏ってるせいかな・・・。"
]
},
{
"id": 14929,
"kind": "msg",
"jp": [
"「でかいよねえ。",
"どれくらい重いのかと思って",
"持ってみようとしたんだけど・・・」"
]
},
{
"id": 14930,
"kind": "msg",
"jp": [
"「持ち上げたんですか!?」"
]
},
{
"id": 14931,
"kind": "msg",
"jp": [
"「いや、それが残念ながら",
"壁に固定されてて動かなかった」"
]
},
{
"id": 14932,
"kind": "msg",
"jp": [
"残念ながら、なのか。"
]
},
{
"id": 14933,
"kind": "msg",
"jp": [
"「温室に、玩具のベルが",
"置いてあったんですが・・・」"
]
},
{
"id": 14934,
"kind": "msg",
"jp": [
"「ベルねえ・・・",
"なんでベルなんだろう?」"
]
},
{
"id": 14935,
"kind": "msg",
"jp": [
"「あれって単なる飾りで",
"鳴らないみたいだよね」"
]
},
{
"id": 14936,
"kind": "msg",
"jp": [
"「そうですね、",
"鳴っても普通のベルみたいな",
"きれいな金属音じゃなさそうですね」"
]
},
{
"id": 14937,
"kind": "msg",
"jp": [
"「てことは、音は重要じゃ",
"ないんだろうね」"
]
},
{
"id": 14938,
"kind": "msg",
"jp": [
"「何でもいいから音が鳴るものが",
"置いておきたかったとかいう",
"わけじゃないんじゃないかな」"
]
},
{
"id": 14939,
"kind": "msg",
"jp": [
"「ああ、なるほど。",
"そうなりますね」"
]
},
{
"id": 14940,
"kind": "msg",
"jp": [
"「温室に、長い釘が",
"置かれてて・・・」"
]
},
{
"id": 14941,
"kind": "msg",
"jp": [
"「釘ってどんなのだっけ?」"
]
},
{
"id": 14942,
"kind": "msg",
"jp": [
"「五寸釘です」"
]
},
{
"id": 14943,
"kind": "msg",
"jp": [
"「あ、あれか。",
"犯人が持ってきたのかな」"
]
},
{
"id": 14944,
"kind": "msg",
"jp": [
"「ええ、多分」"
]
},
{
"id": 14945,
"kind": "msg",
"jp": [
"「普通に売ってるものなのかな。",
"ぼくは買ったことないんだけど」"
]
},
{
"id": 14946,
"kind": "msg",
"jp": [
"「僕もないですよ、そんなの」"
]
},
{
"id": 14947,
"kind": "msg",
"jp": [
"「けど置いてあったってことは",
"どっかから調達してるんだよね」"
]
},
{
"id": 14948,
"kind": "msg",
"jp": [
"この事件のために、どこかから。",
"そう考えるとかなり",
"薄ら寒いものを感じる・・・。"
]
},
{
"id": 14949,
"kind": "msg",
"jp": [
"「温室に白い手袋が",
"置いてありました」"
]
},
{
"id": 14950,
"kind": "msg",
"jp": [
"「手袋ってどんなの?",
"軍手みたいなの?」"
]
},
{
"id": 14951,
"kind": "msg",
"jp": [
"「いえ、女性用のひらひらしてて",
"きれいなやつです」"
]
},
{
"id": 14952,
"kind": "msg",
"jp": [
"「ふうん?",
"礼装用のかな?」"
]
},
{
"id": 14953,
"kind": "msg",
"jp": [
"「多分そうじゃないかと・・・」"
]
},
{
"id": 14954,
"kind": "msg",
"jp": [
"「それじゃあ、たまたま",
"鞄に入れてたりはしないよね」"
]
},
{
"id": 14955,
"kind": "msg",
"jp": [
"「それも、このために用意して",
"持ってきたってことか」"
]
},
{
"id": 14956,
"kind": "msg",
"jp": [
"「そうでしょうね・・・」"
]
},
{
"id": 14957,
"kind": "msg",
"jp": [
"「温室に、手斧が置いて",
"あったんですよ・・・」"
]
},
{
"id": 14958,
"kind": "msg",
"jp": [
"「手斧って、飾りじゃなくて",
"実際使えそうなやつ?」"
]
},
{
"id": 14959,
"kind": "msg",
"jp": [
"「あ・・・",
"ええ、そうみたいです」"
]
},
{
"id": 14960,
"kind": "msg",
"jp": [
"「じゃあ、この家のどこかに",
"飾ってあった武器のひとつって",
"わけじゃないのかな」"
]
},
{
"id": 14961,
"kind": "msg",
"jp": [
"「そうですね、",
"そういうのとは違う感じでした」"
]
},
{
"id": 14962,
"kind": "msg",
"jp": [
"「そうか・・・。",
"手斧くらいなら家にもあるし",
"持って来れなくはないしなあ」"
]
},
{
"id": 14963,
"kind": "msg",
"jp": [
"「家にあるんですか!?」"
]
},
{
"id": 14964,
"kind": "msg",
"jp": [
"「キャンプ用の小さいのがね」"
]
},
{
"id": 14965,
"kind": "msg",
"jp": [
"そうか、キャンプ用品とかなら",
"売ってないこともないのか。"
]
},
{
"id": 14966,
"kind": "msg",
"jp": [
"「温室にこれくらいの",
"小さい柵が置いてあって・・・」"
]
},
{
"id": 14967,
"kind": "msg",
"jp": [
"「柵って何の?",
"鳥かごみたいなもの?」"
]
},
{
"id": 14968,
"kind": "msg",
"jp": [
"「いいえ、囲いになってる",
"わけじゃないんですよ」"
]
},
{
"id": 14969,
"kind": "msg",
"jp": [
"「こう、格子状になったのが",
"一面だけなんです」"
]
},
{
"id": 14970,
"kind": "msg",
"jp": [
"「何に使うものなんだろう?",
"何かの飾りの一部とかかな」"
]
},
{
"id": 14971,
"kind": "msg",
"jp": [
"「そうかもしれません。",
"いくつか組み合わせて",
"使うんじゃないかな」"
]
},
{
"id": 14972,
"kind": "msg",
"jp": [
"「ふうん・・・?",
"けどそれって、見たまんま柵なのかな」"
]
},
{
"id": 14973,
"kind": "msg",
"jp": [
"「柵なのか格子なのか、",
"犯人は何のつもりで置いたのか",
"わかりにくいよね」"
]
},
{
"id": 14974,
"kind": "msg",
"jp": [
"「ああ・・・",
"そう言えばそうですね」"
]
},
{
"id": 14975,
"kind": "msg",
"jp": [
"柵だと決め付けない方が",
"いいのかも・・・。"
]
},
{
"id": 14976,
"kind": "msg",
"jp": [
"「あの、那須さん・・・",
"その、ダンベル・・・」"
]
},
{
"id": 14977,
"kind": "msg",
"jp": [
"「ん? これ?」"
]
},
{
"id": 14978,
"kind": "msg",
"jp": [
"「持ってきたんですか?」"
]
},
{
"id": 14979,
"kind": "msg",
"jp": [
"「うん、4本だけね」"
]
},
{
"id": 14980,
"kind": "msg",
"jp": [
"だけ、じゃないだろう・・・。"
]
},
{
"id": 14981,
"kind": "msg",
"jp": [
"「斑井さんの部屋に、",
"なんか変な形の杖があったの",
"知ってます?」"
]
},
{
"id": 14982,
"kind": "msg",
"jp": [
"「ああ、あれかぁ。",
"あの杖堅いけど、軽いから",
"身体鍛えるのには向いてないよ」"
]
},
{
"id": 14983,
"kind": "msg",
"jp": [
"そこにしか判断基準がないのか",
"那須さん・・・。"
]
},
{
"id": 14984,
"kind": "msg",
"jp": [
"「この館ってたくさん絵が",
"飾ってありますね」"
]
},
{
"id": 14985,
"kind": "msg",
"jp": [
"「そう言えば多いね。",
"この部屋にもあるし・・・」"
]
},
{
"id": 14986,
"kind": "msg",
"jp": [
"「あれってどこだろう?",
"湘南かなあ?」"
]
},
{
"id": 14987,
"kind": "msg",
"jp": [
"「ち、違うと思います。",
"多分どこか外国だと・・・」"
]
},
{
"id": 14988,
"kind": "msg",
"jp": [
"「あー、外国か。",
"そう言えばそうだね」"
]
},
{
"id": 14989,
"kind": "msg",
"jp": [
"・・・描いた人が聞いたらその場で",
"絵筆を叩き折りそうだ・・・。"
]
},
{
"id": 14990,
"kind": "msg",
"jp": [
"「那須さんの車ってかっこいいですね」"
]
},
{
"id": 14991,
"kind": "msg",
"jp": [
"「そうだろ、気に入ってるんだ。",
"でも、まだ喋らないんだよね」"
]
},
{
"id": 14992,
"kind": "msg",
"jp": [
"「走行距離が足りてないのかなあ?」"
]
},
{
"id": 14993,
"kind": "msg",
"jp": [
"もしかして、何かの映画かドラマを見て",
"盛大な勘違いをしてるんじゃあ・・・。"
]
},
{
"id": 14994,
"kind": "msg",
"jp": [
"「・・・斑井さんの車が",
"せめて軽じゃなければなあ」"
]
},
{
"id": 14995,
"kind": "msg",
"jp": [
"「いや、車って普通予備タイヤを",
"1本は乗せてるもんだからさ」"
]
},
{
"id": 14996,
"kind": "msg",
"jp": [
"「あ、そうか。",
"そうですよね」"
]
},
{
"id": 14997,
"kind": "msg",
"jp": [
"「でもサイズが違うからな、",
"ぼくの車と斑井さんの車じゃ」"
]
},
{
"id": 14998,
"kind": "msg",
"jp": [
"「両方のタイヤをどっちかの",
"車につけて走るってのは",
"さすがに無理だろうしね」"
]
},
{
"id": 14999,
"kind": "msg",
"jp": [
"「それなら僕の車は",
"軽ですから、斑井さんのとは",
"合うかもしれませんよ」"
]
},
{
"id": 15000,
"kind": "msg",
"jp": [
"「ああ、和くんの車があったっけ。",
"それなら修理出来るじゃないか!」"
]
},
{
"id": 15001,
"kind": "msg",
"jp": [
"「いえ、でも・・・",
"僕の車どこにあるか",
"わからないんですが」"
]
},
{
"id": 15002,
"kind": "msg",
"jp": [
"「あ、そうだった・・・」"
]
},
{
"id": 15003,
"kind": "msg",
"jp": [
"本気で忘れてたらしい・・・。"
]
},
{
"id": 15004,
"kind": "msg",
"jp": [
"「地下にですね、すごくたくさん",
"蛇がいたんです・・・」"
]
},
{
"id": 15005,
"kind": "msg",
"jp": [
"「へえ、そうなの?」"
]
},
{
"id": 15006,
"kind": "msg",
"jp": [
"「・・・蛇って鶏肉の味に",
"似てるんだよね」"
]
},
{
"id": 15007,
"kind": "msg",
"jp": [
"「そんなにまずくないよ?」"
]
},
{
"id": 15008,
"kind": "msg",
"jp": [
"「・・・と、とって食べたり",
"しないで下さいね・・・」"
]
},
{
"id": 15009,
"kind": "msg",
"jp": [
"「うーん、さすがに料理方法は",
"知らないんだよなあ」"
]
},
{
"id": 15010,
"kind": "msg",
"jp": [
"知らなくていい・・・。",
"うっかり料理して出されたりしたら",
"卒倒しそうだ。"
]
},
{
"id": 15011,
"kind": "msg",
"jp": [
"「那須さんってカップ麺なんて",
"食べないですか、やっぱり」"
]
},
{
"id": 15012,
"kind": "msg",
"jp": [
"「そうだね、インスタントは",
"ほとんど食べないな」"
]
},
{
"id": 15013,
"kind": "msg",
"jp": [
"「ラーメンも普段はほとんど",
"食べないからなあ」"
]
},
{
"id": 15014,
"kind": "msg",
"jp": [
"「そうなんですか。",
"嫌いなんじゃなくて、栄養とか",
"そういう理由でですか?」"
]
},
{
"id": 15015,
"kind": "msg",
"jp": [
"「うん、ラーメン自体は好きだよ」"
]
},
{
"id": 15016,
"kind": "msg",
"jp": [
"「従兄弟が屋台やっててさ、",
"そこのはたまに食べに行くんだ」"
]
},
{
"id": 15017,
"kind": "msg",
"jp": [
"「物置にボウガンが",
"あったんですよ・・・」"
]
},
{
"id": 15018,
"kind": "msg",
"jp": [
"「ボウガン?",
"ボウガンって武器の?」"
]
},
{
"id": 15019,
"kind": "msg",
"jp": [
"「・・・どれくらい",
"威力あるんだろう?",
"勝てるかなあ・・・」"
]
},
{
"id": 15020,
"kind": "msg",
"jp": [
"「いきなり戦おうと",
"しないで下さいっ!!」"
]
},
{
"id": 15021,
"kind": "msg",
"jp": [
"「駄目?」"
]
},
{
"id": 15022,
"kind": "msg",
"jp": [
"「いくらなんでも素手で",
"挑むのは危険ですから・・・」"
]
},
{
"id": 15023,
"kind": "msg",
"jp": [
"「そうかあ、悔しいなあ」"
]
},
{
"id": 15024,
"kind": "msg",
"jp": [
"「あの・・・",
"那須さん、廊下の家具なんですけど」"
]
},
{
"id": 15025,
"kind": "msg",
"jp": [
"「ああ、あれ?",
"ぼくが外に出したやつ?」"
]
},
{
"id": 15026,
"kind": "msg",
"jp": [
"「忘れてないですよね?」"
]
},
{
"id": 15027,
"kind": "msg",
"jp": [
"「あはは、大丈夫大丈夫。",
"帰る時はちゃんと戻すよ」"
]
},
{
"id": 15028,
"kind": "msg",
"jp": [
"「睡眠薬って飲んだことあります?」"
]
},
{
"id": 15029,
"kind": "msg",
"jp": [
"「ぼくはないなあ。",
"寝付きはいいから使おうと",
"思ったこともないし」"
]
},
{
"id": 15030,
"kind": "msg",
"jp": [
"「・・・那須さんって",
"寝付きも寝起きも良さそうですね」"
]
},
{
"id": 15031,
"kind": "msg",
"jp": [
"「うん、どっちもいいよ」"
]
},
{
"id": 15032,
"kind": "msg",
"jp": [
"「・・・でも寝付きは良すぎてさあ。",
"布団に横になると3秒もしないうちに",
"寝ちゃうんだよね」"
]
},
{
"id": 15033,
"kind": "msg",
"jp": [
"・・・うらやましい人だ。"
]
},
{
"id": 15034,
"kind": "msg",
"jp": [
"「地下にまりもが",
"置いてあったんですよ」"
]
},
{
"id": 15035,
"kind": "msg",
"jp": [
"「まりもってクラゲの仲間だっけ」"
]
},
{
"id": 15036,
"kind": "msg",
"jp": [
"「全然違いますっ!!」"
]
},
{
"id": 15037,
"kind": "msg",
"jp": [
"「そうだっけ?",
"なんか似てなかった?」"
]
},
{
"id": 15038,
"kind": "msg",
"jp": [
"「まりもは藻ですよ・・・。",
"緑色で丸っこいやつです」"
]
},
{
"id": 15039,
"kind": "msg",
"jp": [
"「ああ、そうか!",
"なんでだろう、クリオネと",
"間違えてたみたいだ」"
]
},
{
"id": 15040,
"kind": "msg",
"jp": [
"間違えすぎだ・・・。"
]
},
{
"id": 15041,
"kind": "msg",
"jp": [
"「赤いカメオって知ってます・・・?」"
]
},
{
"id": 15042,
"kind": "msg",
"jp": [
"「ええ? 和くんよく知ってるね。",
"それってマスコミにも流れなかった",
"話だったのに」"
]
},
{
"id": 15043,
"kind": "msg",
"jp": [
"「そうなんですか?",
"僕は暗石さんに聞いたんですけど」"
]
},
{
"id": 15044,
"kind": "msg",
"jp": [
"「あー、暗石さんかあ。",
"あの人なら詳しいかもなあ」"
]
},
{
"id": 15045,
"kind": "msg",
"jp": [
"「那須さんもよくご存じ",
"なんですか?」"
]
},
{
"id": 15046,
"kind": "msg",
"jp": [
"「うん、知り合いがあの事件の",
"起きた街の近くに住んでたから」"
]
},
{
"id": 15047,
"kind": "msg",
"jp": [
"「温室の奥にこれがあったんです」"
]
},
{
"id": 15048,
"kind": "msg",
"jp": [
"「ん? カセットテープ?」"
]
},
{
"id": 15049,
"kind": "msg",
"jp": [
"「ああ、これどっかで見たと",
"思ったら百均に売ってるやつだ」"
]
},
{
"id": 15050,
"kind": "msg",
"jp": [
"「ぼくの家の近所の店にあるよ」"
]
},
{
"id": 15051,
"kind": "msg",
"jp": [
"「物置にボウガンがあるんですけど",
"矢がつがえられてないんですよ」"
]
},
{
"id": 15052,
"kind": "msg",
"jp": [
"「え? 矢がないって・・・",
"いつからないの?」"
]
},
{
"id": 15053,
"kind": "msg",
"jp": [
"「それがわからないんです」"
]
},
{
"id": 15054,
"kind": "msg",
"jp": [
"「・・・何かに使ったのかな」"
]
},
{
"id": 15055,
"kind": "msg",
"jp": [
"「そうかあ・・・",
"でも何に使ったのかわからないと",
"なんか気持ち悪いね」"
]
},
{
"id": 15056,
"kind": "msg",
"jp": [
"「物置に・・・",
"矢がなくなってる",
"ボウガンがあって・・・」"
]
},
{
"id": 15057,
"kind": "msg",
"jp": [
"「・・・それ、暗石さんの・・・?」"
]
},
{
"id": 15058,
"kind": "msg",
"jp": [
"「凶器、だと思います」"
]
},
{
"id": 15059,
"kind": "msg",
"jp": [
"「けど、ボウガンって・・・",
"どこから撃ったんだろう?",
"木の上とか?」"
]
},
{
"id": 15060,
"kind": "msg",
"jp": [
"「木の上・・・は、",
"難しいんじゃないかと・・・」"
]
},
{
"id": 15061,
"kind": "msg",
"jp": [
"「そうだよなあ。",
"でもあんなの持ってる人を部屋に",
"入れてくれるとも思えないし」"
]
},
{
"id": 15062,
"kind": "msg",
"jp": [
"「これ、何だと思います?」"
]
},
{
"id": 15063,
"kind": "msg",
"jp": [
"「? なんだいこれ?」"
]
},
{
"id": 15064,
"kind": "msg",
"jp": [
"「地下で拾ったんですけど",
"なんだかわからなくて」"
]
},
{
"id": 15065,
"kind": "msg",
"jp": [
"「ふーん?",
"・・・軽すぎてトレーニング",
"向きじゃあないなあ」"
]
},
{
"id": 15066,
"kind": "msg",
"jp": [
"「・・・トレーニング用品じゃ",
"ないとは思います・・・」"
]
},
{
"id": 15067,
"kind": "msg",
"jp": [
"「だよね。",
"ぼくにもわからないなあ」"
]
},
{
"id": 15068,
"kind": "msg",
"jp": [
"「ああ、あったね」"
]
},
{
"id": 15069,
"kind": "msg",
"jp": [
"「あれって何する用の仮面",
"なんだろう?」"
]
},
{
"id": 15070,
"kind": "msg",
"jp": [
"「お祭り用なのかな。",
"それともやっぱり誰かと戦う時に",
"使うのかな」"
]
},
{
"id": 15071,
"kind": "msg",
"jp": [
"やっぱりって・・・。"
]
},
{
"id": 15072,
"kind": "msg",
"jp": [
"「那須さん、これに見覚え",
"ありませんか?」"
]
},
{
"id": 15073,
"kind": "msg",
"jp": [
"「どれ? 万年筆?」"
]
},
{
"id": 15074,
"kind": "msg",
"jp": [
"「裏庭に落ちてたんですけど」"
]
},
{
"id": 15075,
"kind": "msg",
"jp": [
"「ふーん・・・",
"けっこう古い品だねえ」"
]
},
{
"id": 15076,
"kind": "msg",
"jp": [
"「なんか見たことある気がするけど",
"どこで見たんだったかなあ・・・」"
]
},
{
"id": 15077,
"kind": "msg",
"jp": [
"那須さんはどこで見たのか",
"思い出せないようだ・・・。"
]
},
{
"id": 15078,
"kind": "msg",
"jp": [
"「娯楽室のデッキにこれが",
"入ってたんですよ」"
]
},
{
"id": 15079,
"kind": "msg",
"jp": [
"「なんだいこれ?",
"カセットテープ?」"
]
},
{
"id": 15080,
"kind": "msg",
"jp": [
"「崖崩れのニュースが入ってたんです。",
"僕らが聞いたのとは違うやつが」"
]
},
{
"id": 15081,
"kind": "msg",
"jp": [
"「違うやつって、他でも",
"どこか崖が崩れてるのかい?」"
]
},
{
"id": 15082,
"kind": "msg",
"jp": [
"「いえ、そうじゃなくて",
"犯人が用意した偽物のニュース",
"なんじゃないかと」"
]
},
{
"id": 15083,
"kind": "msg",
"jp": [
"「そんなの役に立つの?",
"本当に崖が崩れてなかったら、",
"見に行ったらすぐばれるのに」"
]
},
{
"id": 15084,
"kind": "msg",
"jp": [
"「いや、あの・・・",
"実際のニュースでもまだ崩れる危険が",
"あるから近寄るなって言って・・・」"
]
},
{
"id": 15085,
"kind": "msg",
"jp": [
"「あ、それ以前に崩れて",
"なかったらそのまま山降りちゃうか」"
]
},
{
"id": 15086,
"kind": "msg",
"jp": [
"「この大嵐の中をですか!?」"
]
},
{
"id": 15087,
"kind": "msg",
"jp": [
"「だって本当に崩れてる場所がどこにも",
"なかったら、そのまま街までたどり着く",
"しかないんじゃない?」"
]
},
{
"id": 15088,
"kind": "msg",
"jp": [
"「・・・街へ着くまでに",
"変だなーとか思わないですかね・・・」"
]
},
{
"id": 15089,
"kind": "msg",
"jp": [
"「ぼくは気づかないと思うなあ」"
]
},
{
"id": 15090,
"kind": "msg",
"jp": [
"いろんな意味で犯人にとって",
"一番予想外だったのは僕じゃなくて",
"那須さんなんじゃないだろうか・・・。"
]
},
{
"id": 15091,
"kind": "msg",
"jp": [
"「この花、なんだかわかりませんか?」"
]
},
{
"id": 15092,
"kind": "msg",
"jp": [
"「花?",
"うーん、あんまり詳しくは",
"ないんだけど、どれどれ・・・」"
]
},
{
"id": 15093,
"kind": "msg",
"jp": [
"「ああ、なんだ。",
"{ 花縮紗/はなしゅくしゃ}じゃないか」"
]
},
{
"id": 15094,
"kind": "msg",
"jp": [
"「花縮紗。",
"和名でいうとね」"
]
},
{
"id": 15095,
"kind": "msg",
"jp": [
"「ジンジャー・リリーって",
"言った方がわかりやすいかな」"
]
},
{
"id": 15096,
"kind": "msg",
"jp": [
"「ジンジャーって、",
"ショウガですか?」"
]
},
{
"id": 15097,
"kind": "msg",
"jp": [
"「うん、葉っぱがショウガに",
"似てるからそう呼ばれるんだった",
"かなあ、確か・・・」"
]
},
{
"id": 15098,
"kind": "msg",
"jp": [
"「でも、これどうしたんだい?",
"地面に落ちてるみたいだけど」"
]
},
{
"id": 15099,
"kind": "msg",
"jp": [
"「ええ、あの・・・",
"温室の『復讐』って紙の側に",
"千切って置いてあったんです」"
]
},
{
"id": 15100,
"kind": "msg",
"jp": [
"「えっ? あそこに・・・?」"
]
},
{
"id": 15101,
"kind": "msg",
"jp": [
"「・・・どういう意味なんでしょう」"
]
},
{
"id": 15102,
"kind": "msg",
"jp": [
"「うーん・・・",
"意味かあ・・・」"
]
},
{
"id": 15103,
"kind": "msg",
"jp": [
"「意味があるとしたら、",
"多分ショウガは関係ないだろうなあ」"
]
},
{
"id": 15104,
"kind": "msg",
"jp": [
"「ぼ、僕もそう思います」"
]
},
{
"id": 15105,
"kind": "msg",
"jp": [
"「ショウガじゃないとしたら",
"赤毛かなあ」"
]
},
{
"id": 15106,
"kind": "msg",
"jp": [
"「赤毛?」"
]
},
{
"id": 15107,
"kind": "msg",
"jp": [
"「ジンジャーには英語だと",
"赤毛の女の人って意味があるんだよ」"
]
},
{
"id": 15108,
"kind": "msg",
"jp": [
"「・・・赤毛・・・の女の人ってでも、",
"ここにはいないみたいですけど」"
]
},
{
"id": 15109,
"kind": "msg",
"jp": [
"「あ、そうか。",
"じゃあ違うのかな」"
]
},
{
"id": 15110,
"kind": "msg",
"jp": [
"「なんだろう?",
"まさか花言葉とか?」"
]
},
{
"id": 15111,
"kind": "msg",
"jp": [
"「花言葉?",
"ジンジャーの花言葉って・・・」"
]
},
{
"id": 15112,
"kind": "msg",
"jp": [
"「あんまりいい意味じゃないよ。",
"『無駄なこと』っていうんだから」"
]
},
{
"id": 15113,
"kind": "msg",
"jp": [
"「・・・・・・あ、あの」"
]
},
{
"id": 15114,
"kind": "msg",
"jp": [
"「あ、いや、もう一つなんか",
"いい意味があった気がする」"
]
},
{
"id": 15115,
"kind": "msg",
"jp": [
"「いえ、多分そっちじゃないと",
"思います・・・だって、置いてったの",
"どう考えても犯人ですよ・・・」"
]
},
{
"id": 15116,
"kind": "msg",
"jp": [
"「・・・ああ、そうか!",
"愛とか信頼とかよくありそうな花言葉の",
"意味で置いてかれても困るよな」"
]
},
{
"id": 15117,
"kind": "msg",
"jp": [
"「困りますよっ!",
"ていうか、意味わかりません」"
]
},
{
"id": 15118,
"kind": "msg",
"jp": [
"「そうか・・・。",
"じゃあ、無駄なことであってるのかな」"
]
},
{
"id": 15119,
"kind": "msg",
"jp": [
"「今上げてくれたものの中じゃ",
"一番あり得そうだと思いますが」"
]
},
{
"id": 15120,
"kind": "msg",
"jp": [
"「けど、どういう意味だろう?",
"なにが無駄なこと、なのかな」"
]
},
{
"id": 15121,
"kind": "msg",
"jp": [
"「そりゃあ・・・犯人が僕らに",
"向けて言ってるんだとしたら・・・」"
]
},
{
"id": 15122,
"kind": "msg",
"jp": [
"「・・・どんなことしたって",
"続けるから無駄だってこと?」"
]
},
{
"id": 15123,
"kind": "msg",
"jp": [
"「それとも、一度や二度邪魔されても",
"他にもやりようはあるから無駄だとか」"
]
},
{
"id": 15124,
"kind": "msg",
"jp": [
"「・・・どっちも嫌ですね・・・」"
]
}
]