]
},
{
"id": 18115,
"kind": "msg",
"jp": [
"「・・・そ、そうかな・・・」"
]
},
{
"id": 18116,
"kind": "msg",
"jp": [
"「えぇやん、モテるやろ?」"
]
},
{
"id": 18117,
"kind": "msg",
"jp": [
"「え!?",
"まさか、全然そんなことないよ?」"
]
},
{
"id": 18118,
"kind": "msg",
"jp": [
"「いや、そんなはずないわ。",
"お兄さん絶対、自覚ないだけや」"
]
},
{
"id": 18119,
"kind": "msg",
"jp": [
"「だって身に覚えが無いよ?」"
]
},
{
"id": 18120,
"kind": "msg",
"jp": [
"「周りに、何かっちゅーとすぐ",
"嘘教えたり、びびらせたりして",
"喜ぶ人おらん?」"
]
},
{
"id": 18121,
"kind": "msg",
"jp": [
"「・・・いっぱいいる」"
]
},
{
"id": 18122,
"kind": "msg",
"jp": [
"「ほら、モテモテや」"
]
},
{
"id": 18123,
"kind": "msg",
"jp": [
"「それモテるって言うの!?」"
]
},
{
"id": 18124,
"kind": "msg",
"jp": [
"「言うの」"
]
},
{
"id": 18125,
"kind": "msg",
"jp": [
"なんか納得いかない・・・。"
]
},
{
"id": 18126,
"kind": "msg",
"jp": [
"「そや!",
"ちょうどよかったわぁ」"
]
},
{
"id": 18127,
"kind": "msg",
"jp": [
"「ちょっと手伝うてぇな。",
"南雲さん来んさらんから、",
"困っとったん」"
]
},
{
"id": 18128,
"kind": "msg",
"jp": [
"「ほら、ここ。",
"これ南雲さんの台詞なん」"
]
},
{
"id": 18129,
"kind": "msg",
"jp": [
"「・・・えーと、",
"まさか、それを・・・」"
]
},
{
"id": 18130,
"kind": "msg",
"jp": [
"「南雲さん役やって」"
]
},
{
"id": 18131,
"kind": "msg",
"jp": [
"「ええええええ!?」"
]
},
{
"id": 18132,
"kind": "msg",
"jp": [
"「ぼっ、僕、演技なんか",
"出来ないよ!?」"
]
},
{
"id": 18133,
"kind": "msg",
"jp": [
"「あぁ、棒読みでええんよ。",
"読んでくれるだけでええから」"
]
},
{
"id": 18134,
"kind": "msg",
"jp": [
"「で、でも・・・」"
]
},
{
"id": 18135,
"kind": "msg",
"jp": [
"「ええやん、ちょっとだけ。",
"助けると思て手伝うてぇな」"
]
},
{
"id": 18136,
"kind": "msg",
"jp": [
"「ね? お願い」"
]
},
{
"id": 18137,
"kind": "msg",
"jp": [
"「じゃあ・・・",
"本当に読むだけだよ?」"
]
},
{
"id": 18138,
"kind": "msg",
"jp": [
"「ありがと、頼むわ!」"
]
},
{
"id": 18139,
"kind": "msg",
"jp": [
"「どこ読めばいいんだっけ?」"
]
},
{
"id": 18140,
"kind": "msg",
"jp": [
"「これ、この2行目から。",
"うち台詞覚えてるから、",
"お兄さんこれ持って読んで」"
]
},
{
"id": 18141,
"kind": "msg",
"jp": [
"「えっと・・・",
"・・・『冗談じゃないぞ。",
"どういう茶番なんだこれは』」"
]
},
{
"id": 18142,
"kind": "msg",
"jp": [
"「『ええい、黙れ。",
"大人しくしていてはこの嵐の中に",
"追い出されかねないだろう』」"
]
},
{
"id": 18143,
"kind": "msg",
"jp": [
"「・・・?",
"もういいの?」"
]
},
{
"id": 18144,
"kind": "msg",
"jp": [
"「あ、この後はまた",
"別の人の台詞なんだね」"
]
},
{
"id": 18145,
"kind": "msg",
"jp": [
"「うん、まあええんやけど。",
"ほんまに棒読みやねー」"
]
},
{
"id": 18146,
"kind": "msg",
"jp": [
"「それでいいって言った",
"じゃないか!?」"
]
},
{
"id": 18147,
"kind": "msg",
"jp": [
"「あは、ええよええよ。",
"ありがとう、助かったわ」"
]
},
{
"id": 18148,
"kind": "msg",
"jp": [
"「わ、わかった。",
"頑張ってみる」"
]
},
{
"id": 18149,
"kind": "msg",
"jp": [
"「ありがとー、お兄さん!」"
]
},
{
"id": 18150,
"kind": "msg",
"jp": [
"「ほな、ここから読んで。",
"うちはもう台詞覚えてるし、",
"台本持っててくれてええから」"
]
},
{
"id": 18151,
"kind": "msg",
"jp": [
"「これ? この2行目から?」"
]
},
{
"id": 18152,
"kind": "msg",
"jp": [
"「えーと、じゃあ・・・」"
]
},
{
"id": 18153,
"kind": "msg",
"jp": [
"「『冗談じゃないぞっ!",
