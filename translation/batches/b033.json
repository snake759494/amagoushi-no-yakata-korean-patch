]
},
{
"id": 18156,
"kind": "msg",
"jp": [
"「・・・っ、くく・・・」"
]
},
{
"id": 18157,
"kind": "msg",
"jp": [
"「あははははっ!",
"かわいいっ!」"
]
},
{
"id": 18158,
"kind": "msg",
"jp": [
