[
{
"id": 17443,
"kind": "msg",
"jp": [
"「おるみたいやけど、",
"そこまで話進んでへんから」"
]
},
{
"id": 17444,
"kind": "msg",
"jp": [
"「・・・でもキャストの中で",
"出てへんの日織さんだけ」"
]
},
{
"id": 17445,
"kind": "msg",
"jp": [
"「あれ、当主・・・?」"
]
},
{
"id": 17446,
"kind": "msg",
"jp": [
"「・・・違う気がする」"
]
},
{
"id": 17447,
"kind": "msg",
"jp": [
"僕もなんとなくそう思う。"
]
},
{
"id": 17448,
"kind": "msg",
"jp": [
"「『絵の中の死』って話に",
"出てくる東雲多岐って人・・・」"
]
},
{
"id": 17449,
"kind": "msg",
"jp": [
"「・・・待って」"
]
},
{
"id": 17450,
"kind": "msg",
"jp": [
"「・・・思い出した、画廊の人」"
]
},
{
"id": 17451,
"kind": "msg",
"jp": [
"「あ、うん、そう」"
]
},
{
"id": 17452,
"kind": "msg",
"jp": [
"「すっきり」"
]
},
{
"id": 17453,
"kind": "msg",
"jp": [
"うんうん、と静奈ちゃんは",
"満足気に頷いた。"
]
},
{
"id": 17454,
"kind": "msg",
"jp": [
"「あのさ、『悪魔の花園』に",
"出てくる方の双子って・・・」"
]
},
{
"id": 17455,
"kind": "msg",
"jp": [
"「・・・似てへんよ」"
]
},
{
"id": 17456,
"kind": "msg",
"jp": [
"「え? 静奈ちゃんと?」"
]
},
{
"id": 17457,
"kind": "msg",
"jp": [
"「鈴も」"
]
},
{
"id": 17458,
"kind": "msg",
"jp": [
"「ふたりとも全然イメージ違うんだ?」"
]
},
{
"id": 17459,
"kind": "msg",
"jp": [
"「うちら、あんなに仲悪くない」"
]
},
{
"id": 17460,
"kind": "msg",
"jp": [
"作中の双子は仲が悪いのか。",
"静奈ちゃんはあまり作中の双子を",
"気に入ってないみたいだな・・・。"
]
},
{
"id": 17461,
"kind": "msg",
"jp": [
"「それに、しぃちゃんは・・・」"
]
},
{
"id": 17462,
"kind": "msg",
"jp": [
"「しぃ・・・?」"
]
},
{
"id": 17463,
"kind": "msg",
"jp": [
"「・・・間違えた。",
"鈴やった」"
]
},
{
"id": 17464,
"kind": "msg",
"jp": [
"「しぃちゃん、って本名?」"
]
},
{
"id": 17465,
"kind": "msg",
"jp": [
"「しのぶ」"
]
},
{
"id": 17466,
"kind": "msg",
"jp": [
"「ふぅん、しのぶちゃんって言うんだ。",
"静奈ちゃんは?」"
]
},
{
"id": 17467,
"kind": "msg",
"jp": [
"「あやめ。",
"{峰塚/みねづか} あやめ」"
]
},
{
"id": 17468,
"kind": "msg",
"jp": [
"「あやめちゃん?",
"あ、なんか聞いたことある」"
]
},
{
"id": 17469,
"kind": "msg",
"jp": [
"「確か・・・大学の先輩が",
"何かの雑誌で・・・」"
]
},
{
"id": 17470,
"kind": "msg",
"jp": [
"「雑誌は、最近たまに載る」"
]
},
{
"id": 17471,
"kind": "msg",
"jp": [
"「そうなんだ。",
"ごめん、僕あんまり知らなくて」"
]
},
{
"id": 17472,
"kind": "msg",
"jp": [
"「・・・知らん人の方がいっぱい",
"驚いてくれるから楽しい」"
]
},
{
"id": 17473,
"kind": "msg",
"jp": [
"・・・僕は特にすぐ騙されるからなぁ。"
]
},
{
"id": 17474,
"kind": "msg",
"jp": [
"「なんかさ、高遠さんの本で",
"虚井家っていうのが出てくる話が",
"あるんだけどさ・・・」"
]
},
{
"id": 17475,
"kind": "msg",
"jp": [
"「・・・あれはねぇ」"
]
},
{
"id": 17476,
"kind": "msg",
"jp": [
"なんで笑顔になるのかな・・・。"
]
},
{
"id": 17477,
"kind": "msg",
"jp": [
"「むかし、外国に実在した人の",
"話でね・・・」"
]
},
{
"id": 17478,
"kind": "msg",
"jp": [
"「待って!",
"それって怖い話だよね!?」"
]
},
{
"id": 17479,
"kind": "msg",
"jp": [
"「いやその、元ネタが聞きたい",
"わけじゃないから、その話は",
"また今度でっ!!」"
]
},
{
"id": 17480,
"kind": "msg",
"jp": [
"危ないところだった・・・。"
]
},
{
"id": 17481,
"kind": "msg",
"jp": [
"「あのさ・・・",
"今時ばあやがいるような家って",
"どんなんだろう?」"
]
},
{
"id": 17482,
"kind": "msg",
"jp": [
"「・・・ばあや」"
]
},
{
"id": 17483,
"kind": "msg",
"jp": [
"「うん。",
"ものすごいお金持ちだよね」"
]
},
{
"id": 17484,
"kind": "msg",
"jp": [
"「・・・うちは、ばあやより",
"セバスチャンがいい」"
]
},
{
"id": 17485,
"kind": "msg",
"jp": [
"「へ?",
"執事って事?」"
]
},
{
"id": 17486,
"kind": "msg",
"jp": [
"「椿くんは違う。",
"あれは邪道」"
]
},
{
"id": 17487,
"kind": "msg",
"jp": [
"「じゃ、邪道なの?」"
]
},
{
"id": 17488,
"kind": "msg",
"jp": [
"「若すぎる。",
"セバスチャンはおじさんがいい」"
]
},
{
"id": 17489,
"kind": "msg",
"jp": [
"何かこだわりがあるらしい。"
]
},
{
"id": 17490,
"kind": "msg",
"jp": [
"「・・・暗石さんのこと",
"なんだけどさ・・・」"
]
},
{
"id": 17491,
"kind": "msg",
"jp": [
"「御陵さんが、朝早くに2階の",
"廊下で見かけたって言ってるんだ」"
]
},
{
"id": 17492,
"kind": "msg",
"jp": [
"「・・・いつの?」"
]
},
{
"id": 17493,
"kind": "msg",
"jp": [
"「最初の日から数えて",
"5日目、かな」"
]
},
{
"id": 17494,
"kind": "msg",
"jp": [
"静奈ちゃんは黙って小首を傾げ",
"ながら指を折って日付を数える。"
]
},
{
"id": 17495,
"kind": "msg",
"jp": [
"「うちは、会わへんかった。",
"鈴と台所に降りたけど」"
]
},
{
"id": 17496,
"kind": "msg",
"jp": [
"「何時頃?」"
]
},
{
"id": 17497,
"kind": "msg",
"jp": [
"「7時半過ぎ」"
]
},
{
"id": 17498,
"kind": "msg",
"jp": [
"「ああ、それならだいぶ後だね。",
"御陵さんが見かけたのって6時半",
"くらいだって言ってた」"
]
},
{
"id": 17499,
"kind": "msg",
"jp": [
"「その時間やったら、うちまだ寝てた。",
"鈴が起こしに来たんが7時過ぎやし」"
]
},
{
"id": 17500,
"kind": "msg",
"jp": [
"なら、静奈ちゃんは6時半に部屋から",
"出ている暗石さんにはまったく気づかな",
"かっただろう・・・。"
]
},
{
"id": 17501,
"kind": "msg",
"jp": [
"「あのさ、部屋の名前のこと",
"なんだけど鈴奈ちゃんが、",
"静奈ちゃんが詳しいからって・・・」"
]
},
{
"id": 17502,
"kind": "msg",
"jp": [
"「不可能犯罪の巨匠」"
]
},
{
"id": 17503,
"kind": "msg",
"jp": [
"「密室トリックの大家」"
]
},
{
"id": 17504,
"kind": "msg",
"jp": [
"「そういう話やないの?」"
]
},
{
"id": 17505,
"kind": "msg",
"jp": [
"「うん、あの、鈴奈ちゃんの部屋と",
"同じ人の別名だとかって話を」"
]
},
{
"id": 17506,
"kind": "msg",
"jp": [
"「ああ、それ」"
]
},
{
"id": 17507,
"kind": "msg",
"jp": [
"「鈴が卿で、うちが博士」"
]
},
{
"id": 17508,
"kind": "msg",
"jp": [
"「書いてたシリーズの名探偵」"
]
},
{
"id": 17509,
"kind": "msg",
"jp": [
"「でも、すごいキャラ似てるん。",
"どっちもおじさんで太ってる」"
]
},
{
"id": 17510,
"kind": "msg",
"jp": [
"「作者も途中でごっちゃになって",
"エピソードが混ざってたりする」"
]
},
{
"id": 17511,
"kind": "msg",
"jp": [
"「それもまたよし」"
]
},
{
"id": 17512,
"kind": "msg",
"jp": [
"「いいんだ!?」"
]
},
{
"id": 17513,
"kind": "msg",
"jp": [
"「お茶目やん」"
]
},
{
"id": 17514,
"kind": "msg",
"jp": [
"そういうもんなのか・・・。"
]
},
{
"id": 17515,
"kind": "msg",
"jp": [
"「藍瀬みきちゃんって知ってる?",
"アイドルの・・・」"
]
},
{
"id": 17516,
"kind": "msg",
"jp": [
"「会うたことない」"
]
},
{
"id": 17517,
"kind": "msg",
"jp": [
"「・・・芝居より、",
"歌とか踊りのが上手いと思う」"
]
},
{
"id": 17518,
"kind": "msg",
"jp": [
"「演技はあんまり",
"上手くないの?」"
]
},
{
"id": 17519,
"kind": "msg",
"jp": [
"「下手やないよ。",
"慣れてへんだけやと思う」"
]
},
{
"id": 17520,
"kind": "msg",
"jp": [
"「そっか。",
"そう言えば、この前の映画が",
"初出演だって言ってたっけ」"
]
},
{
"id": 17521,
"kind": "msg",
"jp": [
"静奈ちゃんはなぜかふっと",
"遠くを見るような顔をした。"
]
},
{
"id": 17522,
"kind": "msg",
"jp": [
"「如月百合子さんって",
"知ってるよね?」"
]
},
{
"id": 17523,
"kind": "msg",
"jp": [
"「いちばん尊敬してるひと」"
]
},
{
"id": 17524,
"kind": "msg",
"jp": [
"「小学校のとき、",
"如月さんが出てる映画観て",
"女優になろうと思ったん」"
]
},
{
"id": 17525,
"kind": "msg",
"jp": [
"「へえ・・・",
"如月さん、どんな役だったの?」"
]
},
{
"id": 17526,
"kind": "msg",
"jp": [
"「戦争に行った旦那さんを",
"待ってる奥さんの役」"
]
},
{
"id": 17527,
"kind": "msg",
"jp": [
"「戦争映画だったんだ。",
"・・・って静奈ちゃん、",
"それ小学校のときに見たの?」"
]
},
{
"id": 17528,
"kind": "msg",
"jp": [
"「生まれて初めて",
"映画観て泣いた」"
]
},
{
"id": 17529,
"kind": "msg",
"jp": [
"小学生が観るにしては",
"重そうな映画だけど、",
"よっぽど感動したんだな・・・。"
]
},
{
"id": 17530,
"kind": "msg",
"jp": [
"「知ってるの?」"
]
},
{
"id": 17531,
"kind": "msg",
"jp": [
"「本で見たことある」"
]
},
{
"id": 17532,
"kind": "msg",
"jp": [
"「・・・友達になりたい」"
]
},
{
"id": 17533,
"kind": "msg",
"jp": [
"「楽しそう」"
]
},
{
"id": 17534,
"kind": "msg",
"jp": [
"「マリアンヌっていう",
"ヒロインの出てくる小説知ってる?」"
]
},
{
"id": 17535,
"kind": "msg",
"jp": [
"「全部読んだ」"
]
},
{
"id": 17536,
"kind": "msg",
"jp": [
"「えっ!?",
"あ、いや・・・そ、そう」"
]
},
{
"id": 17537,
"kind": "msg",
"jp": [
"「・・・言い回しとか台詞が",
"かゆくなるようなんばっかり",
"やから{退/ひ}く人多いけど」"
]
},
{
"id": 17538,
"kind": "msg",
"jp": [
"「ちゃんと読んだら",
"面白いよ、あれ」"
]
},
{
"id": 17539,
"kind": "msg",
"jp": [
"「そうなの・・?」"
]
},
{
"id": 17540,
"kind": "msg",
"jp": [
"「それにあの話、",
"恥ずかしい言い回し全部消したら",
"30ページくらいで終わってまうし」"
]
},
{
"id": 17541,
"kind": "msg",
"jp": [
"それもどうかと思う・・・。"
]
},
{
"id": 17542,
"kind": "msg",
"jp": [
"「ハリー・キッドマンって",
"いう探偵知ってる?」"
]
},
{
"id": 17543,
"kind": "msg",
"jp": [
"「・・・好きやのに」"
]
},
{
"id": 17544,
"kind": "msg",
"jp": [
"「好きやのに、",
"滅多に知ってる人に",
"会わへん・・・」"
]
},
{
"id": 17545,
"kind": "msg",
"jp": [
"「着流しさんが",
"知っててびっくりした」"
]
},
{
"id": 17546,
"kind": "msg",
"jp": [
"「あ、ああ、日織・・・」"
]
},
{
"id": 17547,
"kind": "msg",
"jp": [
"「しかも、家に",
"初版あるって・・・」"
]
},
{
"id": 17548,
"kind": "msg",
"jp": [
"「うらやましい・・・」"
]
},
{
"id": 17549,
"kind": "msg",
"jp": [
"とりあえず、相当好き",
"らしいことはわかった・・・。"
]
},
{
"id": 17550,
"kind": "msg",
"jp": [
"「静奈ちゃん、本物の執事って",
"会ったことある?」"
]
},
{
"id": 17551,
"kind": "msg",
"jp": [
"「ない」"
]
},
{
"id": 17552,
"kind": "msg",
"jp": [
"「会うてみたいけど、",
"どこ行ったらおるかな」"
]
},
{
"id": 17553,
"kind": "msg",
"jp": [
"「え?",
"そりゃやっぱり・・・",
"お金持ちの家じゃない?」"
]
},
{
"id": 17554,
"kind": "msg",
"jp": [
"「最近は喫茶店にも",
"おるらしいけど」"
]
},
{
"id": 17555,
"kind": "msg",
"jp": [
"「でもきっと、見た目普通の",
"おじさんで名前がセバスチャンな",
"人はおらんような気がする」"
]
},
{
"id": 17556,
"kind": "msg",
"jp": [
"「・・・いないだろうね」"
]
},
{
"id": 17557,
"kind": "msg",
"jp": [
"「静奈ちゃんちって",
"兄弟は静奈ちゃんと鈴奈ちゃん",
"だけなの?」"
]
},
{
"id": 17558,
"kind": "msg",
"jp": [
"「お兄さん、弟?」"
]
},
{
"id": 17559,
"kind": "msg",
"jp": [
"「上に、兄か姉が",
"おると見た」"
]
},
{
"id": 17560,
"kind": "msg",
"jp": [
"「・・・当たり」"
]
},
{
"id": 17561,
"kind": "msg",
"jp": [
"「やっぱりー」"
]
},
{
"id": 17562,
"kind": "msg",
"jp": [
"「なんでわかったの?」"
]
},
{
"id": 17563,
"kind": "msg",
"jp": [
"「その顔は日頃上から",
"理不尽な仕打ちをされて",
"耐えてる顔やから」"
]
},
{
"id": 17564,
"kind": "msg",
"jp": [
"「・・・鈴みたいに」"
]
},
{
"id": 17565,
"kind": "msg",
"jp": [
"「姉の愛情表現は",
"ちょっと過激やのん」"
]
},
{
"id": 17566,
"kind": "msg",
"jp": [
"「・・・うちの姉ちゃんと",
"同じ事言ってる・・・」"
]
},
{
"id": 17567,
"kind": "msg",
"jp": [
"世の中の姉ってみんな",
"こうなのか・・・?"
]
},
{
"id": 17568,
"kind": "choice",
"jp": [
"聞いてみる"
]
},
{
"id": 17569,
"kind": "choice",
"jp": [
"やめておく"
]
},
{
"id": 17570,
"kind": "choice",
"jp": [
"信じてほしいと説得する"
]
},
{
"id": 17571,
"kind": "choice",
"jp": [
"警戒してくれと注意する"
]
},
{
"id": 17572,
"kind": "choice",
"jp": [
"諦めて帰る"
]
},
{
"id": 17573,
"kind": "choice",
"jp": [
"人が死ぬのは怖い"
]
},
{
"id": 17574,
"kind": "choice",
"jp": [
"静奈ちゃんを助けたい"
]
},
{
"id": 17575,
"kind": "choice",
"jp": [
"気付いたのに黙ってられない"
]
},
{
"id": 17576,
"kind": "msg",
"jp": [
"「・・・なに」"
]
},
{
"id": 17577,
"kind": "msg",
"jp": [
"「今夜、犯人が狙ってるの",
"静奈ちゃん・・・だと思う」"
]
},
{
"id": 17578,
"kind": "msg",
"jp": [
"静奈ちゃんの表情が曇る。",
"驚いたのか、単に気分を害したのか",
"わからなかった。"
]
},
{
"id": 17579,
"kind": "msg",
"jp": [
"変な沈黙が続いてしまった。",
"どうしよう、信じてくれてない",
"ような気がするんだけど・・・。"
]
},
{
"id": 17580,
"kind": "msg",
"jp": [
"「し・・信じてくれないかな。",
"あの、突拍子も無いこと言ってるし",
"気分も悪いだろうけど・・・」"
]
},
{
"id": 17581,
"kind": "msg",
"jp": [
"「一応、一生懸命考えて",
"本当に危ないと思ったから、",
"あの・・・」"
]
},
{
"id": 17582,
"kind": "msg",
"jp": [
"「だから、あの警戒した方が・・・」"
]
},
{
"id": 17583,
"kind": "msg",
"jp": [
"「・・・いつもしてる」"
]
},
{
"id": 17584,
"kind": "msg",
"jp": [
"「う、うん、だと思うけど",
"今夜は特に・・・」"
]
},
{
"id": 17585,
"kind": "msg",
"jp": [
"「・・・えーと、あの、",
"だから・・気をつけてね」"
]
},
{
"id": 17586,
"kind": "msg",
"jp": [
"「そ、それじゃあ・・・」"
]
},
{
"id": 17587,
"kind": "msg",
"jp": [
"沈黙に耐え切れず、",
"話を切り上げてしまった。"
]
},
{
"id": 17588,
"kind": "msg",
"jp": [
"やっぱり信用してくれないかな。",
"僕、あんまり好かれてもなさそう",
"だしなぁ・・・。"
]
},
{
"id": 17589,
"kind": "msg",
"jp": [
"「なんで、わざわざ言いに来たん?」"
]
},
{
"id": 17590,
"kind": "msg",
"jp": [
"「そりゃあ・・・」"
]
},
{
"id": 17591,
"kind": "msg",
"jp": [
"「だって・・・怖いよ。",
"人が死ぬのって・・・」"
]
},
{
"id": 17592,
"kind": "msg",
"jp": [
"「かっこ悪い話だけど、",
"怖くてしょうがないんだよ」"
]
},
{
"id": 17593,
"kind": "msg",
"jp": [
"「だから、もう・・・",
"誰も死んで欲しくないんだ」"
]
},
{
"id": 17594,
"kind": "msg",
"jp": [
"「・・・・お兄さんて」"
]
},
{
"id": 17595,
"kind": "msg",
"jp": [
"「正直」"
]
},
{
"id": 17596,
"kind": "msg",
"jp": [
"「ご、ごめん・・・。",
"もうちょっと気の利いたこと",
"言えた方がいいんだろうけど」"
]
},
{
"id": 17597,
"kind": "msg",
"jp": [
"「ううん。",
"うち、そういうの好かん」"
]
},
{
"id": 17598,
"kind": "msg",
"jp": [
"「君のため、とか言うの」"
]
},
{
"id": 17599,
"kind": "msg",
"jp": [
"「そ・・そう・・・?」"
]
},
{
"id": 17600,
"kind": "msg",
"jp": [
"「『君』が死んだら『僕』が",
"可哀想やから嫌やって、",
"はっきり言う人の方が好き」"
]
},
{
"id": 17601,
"kind": "msg",
"jp": [
"「助けたいんだよ。",
"静奈ちゃんを・・・」"
]
},
{
"id": 17602,
"kind": "msg",
"jp": [
"「本当だよ。",
"殺されたりして欲しくない」"
]
},
{
"id": 17603,
"kind": "msg",
"jp": [
"「・・・信用出来ない?」"
]
},
{
"id": 17604,
"kind": "msg",
"jp": [
"「・・・嘘は言うてないと思う」"
]
},
{
"id": 17605,
"kind": "msg",
"jp": [
"「けど」"
]
},
{
"id": 17606,
"kind": "msg",
"jp": [
"「け、けど?」"
]
},
{
"id": 17607,
"kind": "msg",
"jp": [
"「・・・お兄さんより、",
"鈴のが強いと思う」"
]
},
{
"id": 17608,
"kind": "msg",
"jp": [
"助ける、というにはあまりにも",
"頼りなさそう・・・ってことかな。",
"我ながら無理もないと思う・・・。"
]
},
{
"id": 17609,
"kind": "msg",
"jp": [
"「だって、気付いたのに黙ってる",
"なんて出来ないよ・・・」"
]
},
{
"id": 17610,
"kind": "msg",
"jp": [
"「僕の推理は間違ってるかも",
"しれないけど、危ないかもしれないのに",
"黙ってるわけにいかないじゃないか」"
]
},
{
"id": 17611,
"kind": "msg",
"jp": [
"「もし何も言わないで静奈ちゃんが",
"死んじゃったりしたら、きっとすごく",
"後悔することになるし・・・」"
]
},
{
"id": 17612,
"kind": "msg",
"jp": [
"「・・・・・そやね」"
]
},
{
"id": 17613,
"kind": "msg",
"jp": [
"静奈ちゃんはこっくりと",
"深く頷いた。"
]
},
{
"id": 17614,
"kind": "msg",
"jp": [
"「うちも、気付いてもうたら",
"とりあえず言うかも」"
]
},
{
"id": 17615,
"kind": "msg",
"jp": [
"「そ、そうだろ?」"
]
},
{
"id": 17616,
"kind": "msg",
"jp": [
"「・・・気はつけとく」"
]
},
{
"id": 17617,
"kind": "msg",
"jp": [
"「いつも、つけてるけど」"
]
},
{
"id": 17618,
"kind": "msg",
"jp": [
"それ以上話す気は無い、",
"とでも言うように",
"静奈ちゃんは目を逸らした。"
]
},
{
"id": 17619,
"kind": "msg",
"jp": [
"「・・・・けど」"
]
},
{
"id": 17620,
"kind": "msg",
"jp": [
"「あ、それは・・・」"
]
},
{
"id": 17621,
"kind": "msg",
"jp": [
"「うん、そう。",
"ちゃんとタイトル覚えてたんや」"
]
},
{
"id": 17622,
"kind": "msg",
"jp": [
"「今夜じゃないかって。",
"静奈ちゃんが、その・・・」"
]
},
{
"id": 17623,
"kind": "msg",
"jp": [
"「・・・・・また?」"
]
},
{
"id": 17624,
"kind": "msg",
"jp": [
"「あ、あの、ごめん。",
"何度も同じこと言って。",
"でも・・・」"
]
},
{
"id": 17625,
"kind": "msg",
"jp": [
"「・・・信じてもらえないかな」"
]
},
{
"id": 17626,
"kind": "msg",
"jp": [
"「・・・・・・さあ」"
]
},
{
"id": 17627,
"kind": "msg",
"jp": [
"ほとんど信じてくれてないな・・・。"
]
},
{
"id": 17628,
"kind": "msg",
"jp": [
"「あの・・・ごめん、何度も。",
"でも今度こそ本当に静奈ちゃんが",
"危ないんじゃな・・・」"
]
},
{
"id": 17629,
"kind": "msg",
"jp": [
"「ないか・・って・・・・」"
]
},
{
"id": 17630,
"kind": "msg",
"jp": [
"部屋の気温が氷点下に下がった",
"かのような目つきで見られた。"
]
},
{
"id": 17631,
"kind": "msg",
"jp": [
"そりゃ、こう何度も何度も同じ事",
"言って失敗してたらそうか・・・。"
]
},
{
"id": 17632,
"kind": "msg",
"jp": [
"「・・・早よ、やんでほしい」"
]
},
{
"id": 17633,
"kind": "msg",
"jp": [
"それ以上の反応はなかった。"
]
},
{
"id": 17634,
"kind": "msg",
"jp": [
"窓の外は見てなかったって",
"ことかな・・・。"
]
},
{
"id": 17635,
"kind": "msg",
"jp": [
"「趣味やないよ」"
]
},
{
"id": 17636,
"kind": "msg",
"jp": [
"「う、うん。",
"それはわかってる・・・」"
]
},
{
"id": 17637,
"kind": "msg",
"jp": [
"自分でもわからないって",
"ことかな・・・。"
]
},
{
"id": 17638,
"kind": "msg",
"jp": [
"「・・・呪うって」"
]
},
{
"id": 17639,
"kind": "msg",
"jp": [
"「呪うって」"
]
},
{
"id": 17640,
"kind": "msg",
"jp": [
"読める、のかな・・・。",
"適当にあしらわれてるような気も",
"するけど。"
]
},
{
"id": 17641,
"kind": "msg",
"jp": [
"特に興味なさそうに頷いた。"
]
},
{
"id": 17642,
"kind": "msg",
"jp": [
"「本物ではない、と思う」"
]
},
{
"id": 17643,
"kind": "msg",
"jp": [
"「うん、僕も・・・」"
]
},
{
"id": 17644,
"kind": "msg",
"jp": [
"「いろんな意味で」"
]
},
{
"id": 17645,
"kind": "msg",
"jp": [
"どういう事だろう。",
"気になったけれど、静奈ちゃんは",
"それ以上話そうとしてくれなかった。"
]
},
{
"id": 17646,
"kind": "msg",
"jp": [
"「女優」"
]
},
{
"id": 17647,
"kind": "msg",
"jp": [
"それ以上は教えて",
"もらえないらしい・・・。"
]
},
{
"id": 17648,
"kind": "msg",
"jp": [
"よく知らないのかな・・・。"
]
},
{
"id": 17649,
"kind": "msg",
"jp": [
"「変」"
]
},
{
"id": 17650,
"kind": "msg",
"jp": [
"「けど、楽しい」"
]
},
{
"id": 17651,
"kind": "msg",
"jp": [
"よくわからなかった・・・。"
]
},
{
"id": 17652,
"kind": "msg",
"jp": [
"「書斎の会報読んだ」"
]
},
{
"id": 17653,
"kind": "msg",
"jp": [
"興味あるってことなのかな。"
]
},
{
"id": 17654,
"kind": "msg",
"jp": [
"「す、好き・・なのかな」"
]
},
{
"id": 17655,
"kind": "msg",
"jp": [
"「うちが気に入ったのって",
"他の会社のはすぐなくなるん」"
]
},
{
"id": 17656,
"kind": "msg",
"jp": [
"「けど、不思議ビバレーツのは",
"なかなか消えへんから好き」"
]
},
{
"id": 17657,
"kind": "msg",
"jp": [
"「他の人も食べるもん",
"作る時は普通の味付けしてる」"
]
},
{
"id": 17658,
"kind": "msg",
"jp": [
"「・・・そ、そっか」"
]
},
{
"id": 17659,
"kind": "msg",
"jp": [
"自分の味覚が人と違うって",
"自覚してるんだ・・・。"
]
},
{
"id": 17660,
"kind": "msg",
"jp": [
"「・・・ちょっと変」"
]
},
{
"id": 17661,
"kind": "msg",
"jp": [
"「変?」"
]
},
{
"id": 17662,
"kind": "msg",
"jp": [
"「うん、変」"
]
},
{
"id": 17663,
"kind": "msg",
"jp": [
"何が変なんだろう・・・。"
]
},
{
"id": 17664,
"kind": "msg",
"jp": [
"「・・・知ってる」"
]
},
{
"id": 17665,
"kind": "msg",
"jp": [
"「見たことあるの?」"
]
},
{
"id": 17666,
"kind": "msg",
"jp": [
"「DVDボックス出てる」"
]
},
{
"id": 17667,
"kind": "msg",
"jp": [
"「へえ、そうなんだ」"
]
},
{
"id": 17668,
"kind": "msg",
"jp": [
"じゃあ未だにファンがいるのかな。"
]
},
{
"id": 17669,
"kind": "msg",
"jp": [
"「・・・そう言えば、斑井さん出てた」"
]
},
{
"id": 17670,
"kind": "msg",
"jp": [
"「うん、最新作だって言ってたよ」"
]
},
{
"id": 17671,
"kind": "msg",
"jp": [
"「・・・知らへん」"
]
},
{
"id": 17672,
"kind": "msg",
"jp": [
"「あ、そう・・・」"
]
},
{
"id": 17673,
"kind": "msg",
"jp": [
"なんだろう、この異常に",
"悔しそうな沈黙は・・・。"
]
},
{
"id": 17674,
"kind": "msg",
"jp": [
"「まだ、見てない」"
]
},
{
"id": 17675,
"kind": "msg",
"jp": [
"なんか悔しそうだ・・・。"
]
},
{
"id": 17676,
"kind": "msg",
"jp": [
"「ここ好き」"
]
},
{
"id": 17677,
"kind": "msg",
"jp": [
"元は何かが入ってたんだとしたら",
"それは何だろう・・・?"
]
},
{
"id": 17678,
"kind": "msg",
"jp": [
"じゃあ、その間に食堂に出入り",
"した人はいないんだろうな。"
]
},
{
"id": 17679,
"kind": "msg",
"jp": [
"「・・・鍵閉まってからは",
"入ってへん」"
]
},
{
"id": 17680,
"kind": "msg",
"jp": [
"「あ、ああ、そう」"
]
},
{
"id": 17681,
"kind": "msg",
"jp": [
"「開けてみたことなんて、ないよね」"
]
},
{
"id": 17682,
"kind": "msg",
"jp": [
"「・・・・・ない」"
]
},
{
"id": 17683,
"kind": "msg",
"jp": [
"それがどうした、という顔を",
"されてしまった。"
]
},
{
"id": 17684,
"kind": "msg",
"jp": [
"「・・・あれ好き」"
]
},
{
"id": 17685,
"kind": "msg",
"jp": [
"じゃあもっと後でいろいろと",
"持ち込まれたのか。"
]
},
{
"id": 17686,
"kind": "msg",
"jp": [
"「うちら以外、あんまり",
"入ってへんのとちゃう」"
]
},
{
"id": 17687,
"kind": "msg",
"jp": [
"・・・他に反応はなかった。"
]
},
{
"id": 17688,
"kind": "msg",
"jp": [
"「・・・? 静奈ちゃん?」"
]
},
{
"id": 17689,
"kind": "msg",
"jp": [
"「触ってへんもん」"
]
},
{
"id": 17690,
"kind": "msg",
"jp": [
"なんか一瞬、目が泳いだような",
"気がするのは気のせいかな。"
]
},
{
"id": 17691,
"kind": "msg",
"jp": [
"「本、読んだ?」"
]
},
{
"id": 17692,
"kind": "msg",
"jp": [
"「・・・洋書が多かった」"
]
},
{
"id": 17693,
"kind": "msg",
"jp": [
"読めなかった、",
"という意味かなあ・・・。"
]
},
{
"id": 17694,
"kind": "msg",
"jp": [
"「あるんだ?」"
]
},
{
"id": 17695,
"kind": "msg",
"jp": [
"「でも、何もないよ」"
]
},
{
"id": 17696,
"kind": "msg",
"jp": [
"まあ、がらくたみたいなもの",
"ばっかりだったよな・・・。"
]
},
{
"id": 17697,
"kind": "msg",
"jp": [
"「・・・ふぅん」"
]
},
{
"id": 17698,
"kind": "msg",
"jp": [
"興味ない、という態度だった。"
]
},
{
"id": 17699,
"kind": "msg",
"jp": [
"「2階のさ、ひとつだけ",
"客間じゃないみたいな部屋あるでしょ」"
]
},
{
"id": 17700,
"kind": "msg",
"jp": [
"「入ったことある?」"
]
},
{
"id": 17701,
"kind": "msg",
"jp": [
"あるだけで、興味はないようだ。"
]
},
{
"id": 17702,
"kind": "msg",
"jp": [
"「中見た?」"
]
},
{
"id": 17703,
"kind": "msg",
"jp": [
"「何もなかった」"
]
},
{
"id": 17704,
"kind": "msg",
"jp": [
"一応、のぞいてはいるんだ。"
]
},
{
"id": 17705,
"kind": "msg",
"jp": [
"「・・・けど、なんもなくて",
"おもしろくない」"
]
},
{
"id": 17706,
"kind": "msg",
"jp": [
"何があればおもしろいんだろう",
"静奈ちゃんの場合・・。"
]
},
{
"id": 17707,
"kind": "msg",
"jp": [
"「使われてないみたいだけど」"
]
},
{
"id": 17708,
"kind": "msg",
"jp": [
"「見取り図に書いてある」"
]
},
{
"id": 17709,
"kind": "msg",
"jp": [
"「・・・そ、そうだね」"
]
},
{
"id": 17710,
"kind": "msg",
"jp": [
"取り付くしまもなかった・・。"
]
},
{
"id": 17711,
"kind": "msg",
"jp": [
"「地下にね、迷路",
"みたいなのがあってさ・・・」"
]
},
{
"id": 17712,
"kind": "msg",
"jp": [
"「地下迷路っ!?」"
]
},
{
"id": 17713,
"kind": "msg",
"jp": [
"「どんなん? 広い?",
"変な仕掛けとかあった?",
"ワニとかおるん?」"
]
},
{
"id": 17714,
"kind": "msg",
"jp": [
"「いないいないっ!",
"ワニなんかいなかったけど」"
]
},
{
"id": 17715,
"kind": "msg",
"jp": [
"なんなんだこの興奮状態は。",
"普段の静奈ちゃんとはえらい違いだ。"
]
},
{
"id": 17716,
"kind": "msg",
"jp": [
"「ワニおらへんの・・・。",
"ほな、ケルベロスとかゴーレムは?」"
]
},
{
"id": 17717,
"kind": "msg",
"jp": [
"「け、ける・・・何?」"
]
},
{
"id": 17718,
"kind": "msg",
"jp": [
"「・・・おらんねんね。",
"罠とかも何もなし?」"
]
},
{
"id": 17719,
"kind": "msg",
"jp": [
"「ないないない」"
]
},
{
"id": 17720,
"kind": "msg",
"jp": [
"「なーんや、",
"普通の通路みたい」"
]
},
{
"id": 17721,
"kind": "msg",
"jp": [
"「た、多分、静奈ちゃんが",
"期待してるような通路ではないと",
"思うよ・・・」"
]
},
{
"id": 17722,
"kind": "msg",
"jp": [
"「じゃあ宝箱もない?」"
]
},
{
"id": 17723,
"kind": "msg",
"jp": [
"「ない、と思うけど」"
]
},
{
"id": 17724,
"kind": "msg",
"jp": [
"「・・・おかしい」"
]
},
{
"id": 17725,
"kind": "msg",
"jp": [
"「こんなに変な物いっぱいある",
"館やのに地下迷路は普通で",
"何もないなんて{間違/まちご}うてる」"
]
},
{
"id": 17726,
"kind": "msg",
"jp": [
"「お兄さん、見つけてないだけで",
"実は謎のアイテムとか",
"こっそり落ちてるかも・・・」"
]
},
{
"id": 17727,
"kind": "msg",
"jp": [
"「謎のアイテムって何!?」"
]
},
{
"id": 17728,
"kind": "msg",
"jp": [
"「謎の門を開く鍵やとか、",
"謎の魔物を召喚するとか、",
"謎の魔法装置を起動するとか」"
]
},
{
"id": 17729,
"kind": "msg",
"jp": [
"「多分、落ちてないと思う・・・」"
]
},
{
"id": 17730,
"kind": "msg",
"jp": [
"「・・・ちぇ。",
"ほんまに普通の通路なん」"
]
},
{
"id": 17731,
"kind": "msg",
"jp": [
"普通と言っていいかどうか微妙だけど、",
"下手なこと言うと今から連れて行け",
"とか言われそうだ・・・。"
]
},
{
"id": 17732,
"kind": "msg",
"jp": [
"「空やった」"
]
},
{
"id": 17733,
"kind": "msg",
"jp": [
"「・・・まだある」"
]
},
{
"id": 17734,
"kind": "msg",
"jp": [
"「あるの?」"
]
},
{
"id": 17735,
"kind": "msg",
"jp": [
"「冷蔵庫に」"
]
},
{
"id": 17736,
"kind": "msg",
"jp": [
"・・・でも、なんか飲む気には",
"なれないよな。"
]
},
{
"id": 17737,
"kind": "msg",
"jp": [
"「・・・・卑怯や」"
]
},
{
"id": 17738,
"kind": "msg",
"jp": [
"「毒って、ずるい」"
]
},
{
"id": 17739,
"kind": "msg",
"jp": [
"他に反応はなかった・・・。"
]
},
{
"id": 17740,
"kind": "msg",
"jp": [
"静奈ちゃんは、ふっと何事か",
"考えるように眉根を寄せた。"
]
},
{
"id": 17741,
"kind": "msg",
"jp": [
"・・・だけど、何も言わなかった。"
]
},
{
"id": 17742,
"kind": "msg",
"jp": [
"「・・・うち知らん」"
]
},
{
"id": 17743,
"kind": "msg",
"jp": [
"「いつからあったんか",
"わからへん」"
]
},
{
"id": 17744,
"kind": "msg",
"jp": [
"「・・・猫、かわいそう」"
]
},
{
"id": 17745,
"kind": "msg",
"jp": [
"それ以外、何も言ってくれなかった。"
]
},
{
"id": 17746,
"kind": "msg",
"jp": [
"「・・・音悪い」"
]
},
{
"id": 17747,
"kind": "msg",
"jp": [
"「ノイズ多い」"
]
},
{
"id": 17748,
"kind": "msg",
"jp": [
"覚えてないって意味かな・・・。"
]
},
{
"id": 17749,
"kind": "msg",
"jp": [
"「1階のホールにある大時計",
"すごいよね」"
]
},
{
"id": 17750,
"kind": "msg",
"jp": [
"・・・会話が終わってしまった。"
]
},
{
"id": 17751,
"kind": "msg",
"jp": [
"興味なさそうに呟かれた・・・。"
]
},
{
"id": 17752,
"kind": "msg",
"jp": [
"「なんだと思う?」"
]
},
{
"id": 17753,
"kind": "msg",
"jp": [
"「・・・うちのんと違う」"
]
},
{
"id": 17754,
"kind": "msg",
"jp": [
"「あ、ああ、そう?」"
]
},
{
"id": 17755,
"kind": "msg",
"jp": [
"「手袋なんか持ってきてへん」"
]
},
{
"id": 17756,
"kind": "msg",
"jp": [
"そっけないなあ・・・。"
]
},
{
"id": 17757,
"kind": "msg",
"jp": [
"「・・・・・ふぅん」"
]
},
{
"id": 17758,
"kind": "msg",
"jp": [
"これといって感想はないらしい。"
]
},
{
"id": 17759,
"kind": "msg",
"jp": [
"「・・・重かった」"
]
},
{
"id": 17760,
"kind": "msg",
"jp": [
"持ってみたのか・・・。"
]
},
{
"id": 17761,
"kind": "msg",
"jp": [
"「けど、あれおもしろくない」"
]
},
{
"id": 17762,
"kind": "msg",
"jp": [
"「ないしょ」"
]
},
{
"id": 17763,
"kind": "msg",
"jp": [
"「きれいだよね」"
]
},
{
"id": 17764,
"kind": "msg",
"jp": [
"「・・・きれいね」"
]
},
{
"id": 17765,
"kind": "msg",
"jp": [
"なんか会話が弾まない・・・。"
]
},
{
"id": 17766,
"kind": "msg",
"jp": [
"「うちらは、送ってもろたし」"
]
},
{
"id": 17767,
"kind": "msg",
"jp": [
"「・・・お兄さん蛇きらい?」"
]
},
{
"id": 17768,
"kind": "msg",
"jp": [
"「怖いよ」"
]
},
{
"id": 17769,
"kind": "msg",
"jp": [
"「ふーん、可愛いのに」"
]
},
{
"id": 17770,
"kind": "msg",
"jp": [
"・・・好きなのか。"
]
},
{
"id": 17771,
"kind": "msg",
"jp": [
"「・・・あんまり食べへん」"
]
},
{
"id": 17772,
"kind": "msg",
"jp": [
"妙に悲しげなのはなぜだろう・・・。"
]
},
{
"id": 17773,
"kind": "msg",
"jp": [
"「・・・・ふうん」"
]
},
{
"id": 17774,
"kind": "msg",
"jp": [
"あまり興味を示しては",
"くれなかった。"
]
},
{
"id": 17775,
"kind": "msg",
"jp": [
"知らないのか・・・。"
]
},
{
"id": 17776,
"kind": "msg",
"jp": [
"即答だった・・・。"
]
},
{
"id": 17777,
"kind": "msg",
"jp": [
"「・・・スライムではないと思う」"
]
},
{
"id": 17778,
"kind": "msg",
"jp": [
"「・・・聞いたことはある」"
]
},
{
"id": 17779,
"kind": "msg",
"jp": [
"「見たことはないけど」"
]
},
{
"id": 17780,
"kind": "msg",
"jp": [
"「な、ない方がいいんじゃない?」"
]
},
{
"id": 17781,
"kind": "msg",
"jp": [
"なんとなく見てみたそうだ・・・。"
]
},
{
"id": 17782,
"kind": "msg",
"jp": [
"「・・・知らん」"
]
},
{
"id": 17783,
"kind": "msg",
"jp": [
"「・・・・どこいったん」"
]
},
{
"id": 17784,
"kind": "msg",
"jp": [
"「矢」"
]
},
{
"id": 17785,
"kind": "msg",
"jp": [
"「それは、まだ・・・」"
]
},
{
"id": 17786,
"kind": "msg",
"jp": [
"「・・・わからへん」"
]
},
{
"id": 17787,
"kind": "msg",
"jp": [
"「うちにはわからへん」"
]
},
{
"id": 17788,
"kind": "msg",
"jp": [
"僕にも何がなんだか・・・。"
]
},
{
"id": 17789,
"kind": "msg",
"jp": [
"「・・・おっちゃんの」"
]
},
{
"id": 17790,
"kind": "msg",
"jp": [
"「やっぱり、暗石さんのだよね・・・」"
]
},
{
"id": 17791,
"kind": "msg",
"jp": [
"「・・・・・さあ」"
]
},
{
"id": 17792,
"kind": "msg",
"jp": [
"ちらりと{一瞥/いちべつ}しただけで首を振る。",
"やっぱり何だかわからないか。"
]
},
{
"id": 17793,
"kind": "msg",
"jp": [
"静奈ちゃんは横目で僕の差し出した",
"携帯の画像をちらりと見た。"
]
},
{
"id": 17794,
"kind": "msg",
"jp": [
"「知らない?」"
]
},
{
"id": 17795,
"kind": "msg",
"jp": [
"「知らへん」"
]
},
{
"id": 17796,
"kind": "msg",
"jp": [
"「・・・違う」"
]
},
{
"id": 17797,
"kind": "msg",
"jp": [
"「悪魔違う」"
]
},
{
"id": 17798,
"kind": "msg",
"jp": [
"「あ、そ、そうなんだ。",
"ごめん、僕よく知らないんだ」"
]
},
{
"id": 17799,
"kind": "msg",
"jp": [
"・・・返事してくれない。",
"気を悪くしたんだろうか・・。"
]
},
{
"id": 17800,
"kind": "msg",
"jp": [
"「うちの部屋のは『L』」"
]
},
{
"id": 17801,
"kind": "msg",
"jp": [
"「あ、Lか。",
"ありがとう・・・」"
]
},
{
"id": 17802,
"kind": "msg",
"jp": [
"「まだ大丈夫」"
]
},
{
"id": 17803,
"kind": "msg",
"jp": [
"「2年くらい経つけど",
"まだ保ってる」"
]
},
{
"id": 17804,
"kind": "msg",
"jp": [
"「ふうん、長持ちしてるね」"
]
},
{
"id": 17805,
"kind": "msg",
"jp": [
"「駅では誰かに会ったり",
"しなかった?」"
]
},
{
"id": 17806,
"kind": "msg",
"jp": [
"「・・・・ううん」"
]
},
{
"id": 17807,
"kind": "msg",
"jp": [
"力強く頷かれた。",
"かなり好きらしい・・・。"
]
},
{
"id": 17808,
"kind": "msg",
"jp": [
"「・・・材料がない・・・」"
]
},
{
"id": 17809,
"kind": "msg",
"jp": [
"心底残念そうにうなだれた。",
"すごく好きなのかな・・・。"
]
},
{
"id": 17810,
"kind": "msg",
"jp": [
"「・・・日本酒飲みたい」"
]
},
{
"id": 17811,
"kind": "msg",
"jp": [
"なんか連想ゲームのように",
"なったようだ・・・。"
]
},
{
"id": 17812,
"kind": "msg",
"jp": [
"なんだろう、今の間は・・・。"
]
},
{
"id": 17813,
"kind": "msg",
"jp": [
"「美味しかった?」"
]
},
{
"id": 17814,
"kind": "msg",
"jp": [
"「うん。",
"まだあると思う」"
]
},
{
"id": 17815,
"kind": "msg",
"jp": [
"「そ・・・そう」"
]
},
{
"id": 17816,
"kind": "msg",
"jp": [
"何のためらいもなく頷かれると",
"かえって驚くな、これ・・・。"
]
},
{
"id": 17817,
"kind": "msg",
"jp": [
"「・・・・ない」"
]
},
{
"id": 17818,
"kind": "msg",
"jp": [
"「・・・たまに」"
]
},
{
"id": 17819,
"kind": "msg",
"jp": [
"「あるけど・・・」"
]
},
{
"id": 17820,
"kind": "msg",
"jp": [
"「・・・・大丈夫」"
]
},
{
"id": 17821,
"kind": "msg",
"jp": [
"「白やないから」"
]
},
{
"id": 17822,
"kind": "msg",
"jp": [
"同じような推理したのかな。",
"そう言えば、猫は斑井さんって",
"最初に言ったの静奈ちゃんだしな。"
]
},
{
"id": 17823,
"kind": "msg",
"jp": [
"「あのてるてる坊主さ・・・」"
]
},
{
"id": 17824,
"kind": "msg",
"jp": [
"「効くかな」"
]
},
{
"id": 17825,
"kind": "msg",
"jp": [
"「ど、どうだろう?」"
]
},
{
"id": 17826,
"kind": "msg",
"jp": [
"「那須さんは、ぼく晴れ男だから",
"大丈夫だよーって言うてた」"
]
},
{
"id": 17827,
"kind": "msg",
"jp": [
"「こんなに雨降るの珍しいって」"
]
},
{
"id": 17828,
"kind": "msg",
"jp": [
"「そんな話してたんだ」"
]
},
{
"id": 17829,
"kind": "msg",
"jp": [
"「2階に吊してるの",
"外してたとき」"
]
},
{
"id": 17830,
"kind": "msg",
"jp": [
"「けど、執事さんに",
"怒られたからって",
"ほどいてはったよ」"
]
},
{
"id": 17831,
"kind": "msg",
"jp": [
"「外して、下に持ってくまで",
"一緒にいたの?」"
]
},
{
"id": 17832,
"kind": "msg",
"jp": [
"「ううん。",
"うち、そのままお手洗い行って",
"出てきたらもう居てなかった」"
]
},
{
"id": 17833,
"kind": "msg",
"jp": [
"「娯楽室のコンポに",
"これが入ってて・・・」"
]
},
{
"id": 17834,
"kind": "msg",
"jp": [
"「・・・テープ?」"
]
},
{
"id": 17835,
"kind": "msg",
"jp": [
"「崖が崩れたっていうニュースが",
"録音してあるんだけど、ラジオで",
"聞いたのと全然内容が違うんだよ」"
]
},
{
"id": 17836,
"kind": "msg",
"jp": [
"「・・・偽物、だと思う」"
]
},
{
"id": 17837,
"kind": "msg",
"jp": [
"「・・・犯人が用意してたん?」"
]
},
{
"id": 17838,
"kind": "msg",
"jp": [
"「多分・・・。",
"本当に崖が崩れるとは思わなかった",
"だろうから・・・」"
]
},
{
"id": 17839,
"kind": "msg",
"jp": [
"「・・・そやろね」"
]
},
{
"id": 17840,
"kind": "msg",
"jp": [
"「けど、それやったら・・・",
"犯人が一番驚いたんは那須さんが",
"歩いて見に行ったことやろね」"
]
},
{
"id": 17841,
"kind": "msg",
"jp": [
"「そりゃそうだろうね。",
"偽物のニュースで誤魔化そうと",
"してたんだから・・・」"
]
},
{
"id": 17842,
"kind": "msg",
"jp": [
"もしも本当に崖が崩れたりして",
"なかったら、すぐに嘘がばれていた",
"はずなのに。"
]
},
{
"id": 17843,
"kind": "msg",
"jp": [
"「・・・犯人のが、",
"うちらよりツイてたんやね・・・」"
]
},
{
"id": 17844,
"kind": "msg",
"jp": [
"「なんか、応接室に変な仮面が",
"飾ってあるよね」"
]
},
{
"id": 17845,
"kind": "msg",
"jp": [
"「・・・あれ、いけんよ」"
]
},
{
"id": 17846,
"kind": "msg",
"jp": [
"「へ? いけ・・・?」"
]
},
{
"id": 17847,
"kind": "msg",
"jp": [
"「駄目ってこと」"
]
},
{
"id": 17848,
"kind": "msg",
"jp": [
"「こっそり外して見てみたけど",
"かぶれるように出来てなかった」"
]
},
{
"id": 17849,
"kind": "msg",
"jp": [
"「・・・かぶってみたかったの?」"
]
},
{
"id": 17850,
"kind": "msg",
"jp": [
"「だって仮面やし」"
]
},
{
"id": 17851,
"kind": "msg",
"jp": [
"よくわからない・・・。"
]
},
{
"id": 17852,
"kind": "msg",
"jp": [
"「・・・よぉ知らへん」"
]
},
{
"id": 17853,
"kind": "msg",
"jp": [
"「あ、そう・・・?」"
]
},
{
"id": 17854,
"kind": "msg",
"jp": [
"なんか会話にならない・・・。"
]
},
{
"id": 17855,
"kind": "msg",
"jp": [
"どういう意味なんだろう・・・。"
]
},
{
"id": 17856,
"kind": "msg",
"jp": [
"「妹」"
]
},
{
"id": 17857,
"kind": "msg",
"jp": [
"「鈴が妹」"
]
},
{
"id": 17858,
"kind": "msg",
"jp": [
"「あ、うん。",
"そっくりだね」"
]
},
{
"id": 17859,
"kind": "msg",
"jp": [
"「あの、静奈ちゃん・・・?」"
]
},
{
"id": 17860,
"kind": "msg",
"jp": [
"「え、あ、そう・・・」"
]
},
{
"id": 17861,
"kind": "msg",
"jp": [
"「・・・一緒に仕事したことある?」"
]
},
{
"id": 17862,
"kind": "msg",
"jp": [
"「これが初めてだったんだ」"
]
},
{
"id": 17863,
"kind": "msg",
"jp": [
"「・・・上手いのに」"
]
},
{
"id": 17864,
"kind": "msg",
"jp": [
"「どこにいるんだろ」"
]
},
{
"id": 17865,
"kind": "msg",
"jp": [
"「会うたことないもん」"
]
},
{
"id": 17866,
"kind": "msg",
"jp": [
"「何冊か読んだ」"
]
},
{
"id": 17867,
"kind": "msg",
"jp": [
"「そうなんだ。",
"おもしろかった?」"
]
},
{
"id": 17868,
"kind": "msg",
"jp": [
"「・・・読んで」"
]
},
{
"id": 17869,
"kind": "msg",
"jp": [
"「え? 僕?」"
]
},
{
"id": 17870,
"kind": "msg",
"jp": [
"「おもしろいから」"
]
},
{
"id": 17871,
"kind": "msg",
"jp": [
"「う、うん、頑張ってみる」"
]
},
{
"id": 17872,
"kind": "msg",
"jp": [
"静奈ちゃんは口を閉ざして",
"何も語ってくれなかった。"
]
},
{
"id": 17873,
"kind": "msg",
"jp": [
"・・・話してくれそうにない。"
]
},
{
"id": 17874,
"kind": "msg",
"jp": [
"何も答えてくれない・・・。"
]
},
{
"id": 17875,
"kind": "msg",
"jp": [
"「暗石さんのこと",
"なんだけど・・・」"
]
},
{
"id": 17876,
"kind": "msg",
"jp": [
"静奈ちゃんは無言のままで",
"ふい、と顔をそらしてしまった。"
]
},
{
"id": 17877,
"kind": "msg",
"jp": [
"何も答えたくない、という",
"ことだろうか・・・。"
]
},
{
"id": 17878,
"kind": "msg",
"jp": [
"「あのさ、南雲さん・・・」"
]
},
{
"id": 17879,
"kind": "msg",
"jp": [
"「どこやろう」"
]
},
{
"id": 17880,
"kind": "msg",
"jp": [
"「まだ着いてへんの?",
"それとも・・・井戸の中?」"
]
},
{
"id": 17881,
"kind": "msg",
"jp": [
"「そ、それは・・・",
"まだわからないけど・・・」"
]
},
{
"id": 17882,
"kind": "msg",
"jp": [
"・・・そう呟くと、静奈ちゃんは",
"黙り込んでしまった。"
]
},
{
"id": 17883,
"kind": "msg",
"jp": [
"「・・・・変な人」"
]
},
{
"id": 17884,
"kind": "msg",
"jp": [
"さっぱりわからない・・・。"
]
},
{
"id": 17885,
"kind": "msg",
"jp": [
"「同じ、事務所の子」"
]
},
{
"id": 17886,
"kind": "msg",
"jp": [
"「ええ子やったん。",
"うちも、鈴も仲良かった」"
]
},
{
"id": 17887,
"kind": "msg",
"jp": [
"あまりに哀しそうな顔をするので",
"それ以上は聞けなかった・・・。"
]
},
{
"id": 17888,
"kind": "msg",
"jp": [
"・・・どう知ってるのかは",
"教えてくれないらしい。"
]
},
{
"id": 17889,
"kind": "msg",
"jp": [
"ちょっとだけ感心したような",
"声だった。"
]
},
{
"id": 17890,
"kind": "msg",
"jp": [
"「・・・・うん。",
"怖い人」"
]
},
{
"id": 17891,
"kind": "msg",
"jp": [
"「こ、怖いの?」"
]
},
{
"id": 17892,
"kind": "msg",
"jp": [
"「・・・聞きたい?」"
]
},
{
"id": 17893,
"kind": "msg",
"jp": [
"ど、どうしよう・・・。"
]
},
{
"id": 17894,
"kind": "msg",
"jp": [
"「・・・き、聞いて",
"みようかな・・・」"
]
},
{
"id": 17895,
"kind": "msg",
"jp": [
"なんでそんな嬉しそうな顔",
"するんだろう・・・。"
]
},
{
"id": 17896,
"kind": "msg",
"jp": [
"「ルロイ伯爵はねえ・・・",
"悪魔召喚しようとしてた",
"黒魔術師やったん」"
]
},
{
"id": 17897,
"kind": "msg",
"jp": [
"「あ、あくま!?」"
]
},
{
"id": 17898,
"kind": "msg",
"jp": [
"「儀式に生け贄捧げたり",
"してたから、旅の修道士に",
"やっつけられてんけどね」"
]
},
{
"id": 17899,
"kind": "msg",
"jp": [
"「死ぬ間際に呪いかけてった",
"らしいよ・・・」"
]
},
{
"id": 17900,
"kind": "msg",
"jp": [
"「の、呪いって・・・」"
]
},
{
"id": 17901,
"kind": "msg",
"jp": [
"「さあ・・・?",
"けど、伯爵の一族はみんな不自然な",
"死に方して絶えたらしいけど・・・」"
]
},
{
"id": 17902,
"kind": "msg",
"jp": [
"「う・・・わ、わかった、",
"ありがとう、もういいよ・・・」"
]
},
{
"id": 17903,
"kind": "msg",
"jp": [
"「・・・うふふ」"
]
},
{
"id": 17904,
"kind": "msg",
"jp": [
"「や、やめとく」"
]
},
{
"id": 17905,
"kind": "msg",
"jp": [
"「・・・・ちぇ」"
]
},
{
"id": 17906,
"kind": "msg",
"jp": [
"つまんなそうだ・・・。"
]
},
{
"id": 17907,
"kind": "msg",
"jp": [
"「好きかも」"
]
},
{
"id": 17908,
"kind": "msg",
"jp": [
"「好き?」"
]
},
{
"id": 17909,
"kind": "msg",
"jp": [
"キャラクターとして気に入ってる",
"という意味なのかな・・・?"
]
},
{
"id": 17910,
"kind": "msg",
"jp": [
"「・・・わりと好き」"
]
},
{
"id": 17911,
"kind": "msg",
"jp": [
"好きなキャラクターらしい。"
]
},
{
"id": 17912,
"kind": "msg",
"jp": [
"「わりと」"
]
},
{
"id": 17913,
"kind": "msg",
"jp": [
"わりと、なのか・・・。"
]
},
{
"id": 17914,
"kind": "msg",
"jp": [
"「あれにも黒猫出てくる」"
]
},
{
"id": 17915,
"kind": "msg",
"jp": [
"なぜか黙り込んでしまった・・・。"
]
},
{
"id": 17916,
"kind": "msg",
"jp": [
"「・・・読めば」"
]
},
{
"id": 17917,
"kind": "msg",
"jp": [
"「本。",
"ちゃんと読めば」"
]
},
{
"id": 17918,
"kind": "msg",
"jp": [
"残念ながら全部読んでる時間は",
"ないよな。",
"本読むの遅いし・・・。"
]
},
{
"id": 17919,
"kind": "msg",
"jp": [
"薦められてしまった。"
]
},
{
"id": 17920,
"kind": "msg",
"jp": [
"「・・・タイトルに",
"苗字入ってるやん」"
]
},
{
"id": 17921,
"kind": "msg",
"jp": [
"「・・・読んだ?」"
]
},
{
"id": 17922,
"kind": "msg",
"jp": [
"「え? あ、まだちゃんと",
"読んでないんだけど」"
]
},
{
"id": 17923,
"kind": "msg",
"jp": [
"「じゃあ教えへん」"
]
},
{
"id": 17924,
"kind": "msg",
"jp": [
"・・・どうやらネタばれ",
"したくないらしい。"
]
},
{
"id": 17925,
"kind": "msg",
"jp": [
"「いや、まだ・・・」"
]
},
{
"id": 17926,
"kind": "msg",
"jp": [
"「読んで」"
]
},
{
"id": 17927,
"kind": "msg",
"jp": [
"「あれはね」"
]
},
{
"id": 17928,
"kind": "msg",
"jp": [
"「事件と関係ないとこの方が",
"おもしろい話」"
]
},
{
"id": 17929,
"kind": "msg",
"jp": [
"「だから読んで」"
]
},
{
"id": 17930,
"kind": "msg",
"jp": [
"どういう推薦なんだ・・・。"
]
},
{
"id": 17931,
"kind": "msg",
"jp": [
"「いいから読んで」"
]
},
{
"id": 17932,
"kind": "msg",
"jp": [
"なんか気圧されてしまった。"
]
},
{
"id": 17933,
"kind": "msg",
"jp": [
"「『棺』に出てくる方の",
"那須さんは信っていうんだよね」"
]
},
{
"id": 17934,
"kind": "msg",
"jp": [
"「・・・書いてある」"
]
},
{
"id": 17935,
"kind": "msg",
"jp": [
"「本に。",
"読んだら書いてある」"
]
},
{
"id": 17936,
"kind": "msg",
"jp": [
"「読んで、感想」"
]
},
{
"id": 17937,
"kind": "msg",
"jp": [
"ちゃんと読んでからじゃないと",
"話してくれそうにないなあ。"
]
},
{
"id": 17938,
"kind": "msg",
"jp": [
"「読んでるんだ?」"
]
},
{
"id": 17939,
"kind": "msg",
"jp": [
"「お兄さんも読めば」"
]
},
{
"id": 17940,
"kind": "msg",
"jp": [
"「『花魁はなぜ殺される』って",
"いう話の・・・」"
]
},
{
"id": 17941,
"kind": "msg",
"jp": [
"「読めば」"
]
},
{
"id": 17942,
"kind": "msg",
"jp": [
"「・・・いや、あの」"
]
},
{
"id": 17943,
"kind": "msg",
"jp": [
"なぜか静奈ちゃんは不機嫌そうな",
"顔になって黙り込んだ。"
]
},
{
"id": 17944,
"kind": "msg",
"jp": [
"嫌いな話なのかな・・・?"
]
},
{
"id": 17945,
"kind": "msg",
"jp": [
"「・・・自分で読んで」"
]
},
{
"id": 17946,
"kind": "msg",
"jp": [
"「ご、ごめん・・・」"
]
},
{
"id": 17947,
"kind": "msg",
"jp": [
"「うん、あるのは",
"見つけたんだけど・・・」"
]
},
{
"id": 17948,
"kind": "msg",
"jp": [
"「じゃあ読めば」"
]
},
{
"id": 17949,
"kind": "msg",
"jp": [
"「・・・なにそれ」"
]
},
{
"id": 17950,
"kind": "msg",
"jp": [
"「いや、どんな家だろうと思って」"
]
},
{
"id": 17951,
"kind": "msg",
"jp": [
"「うちに聞かれても」"
]
},
{
"id": 17952,
"kind": "msg",
"jp": [
"「・・・もう話した」"
]
},
{
"id": 17953,
"kind": "msg",
"jp": [
"「あ、いや・・・」"
]
},
{
"id": 17954,
"kind": "msg",
"jp": [
"「他に知ってること、ないし」"
]
},
{
"id": 17955,
"kind": "msg",
"jp": [
"「必要な情報はそれだけ」"
]
},
{
"id": 17956,
"kind": "msg",
"jp": [
"「あ・・う、うん・・・」"
]
},
{
"id": 17957,
"kind": "msg",
"jp": [
"ふるふる、と無言で首を振る。",
"知らないという事らしい。"
]
},
{
"id": 17958,
"kind": "msg",
"jp": [
"「・・・すごいひと」"
]
},
{
"id": 17959,
"kind": "msg",
"jp": [
"「大女優」"
]
},
{
"id": 17960,
"kind": "msg",
"jp": [
"「う、うん、",
"それは知ってる」"
]
},
{
"id": 17961,
"kind": "msg",
"jp": [
"「尊敬」"
]
},
{
"id": 17962,
"kind": "msg",
"jp": [
"「してるの?」"
]
},
{
"id": 17963,
"kind": "msg",
"jp": [
"「うん。",
"かっこいいから」"
]
},
{
"id": 17964,
"kind": "msg",
"jp": [
"（あ、笑った・・・）"
]
},
{
"id": 17965,
"kind": "msg",
"jp": [
"相当好きな女優さんらしい。"
]
},
{
"id": 17966,
"kind": "msg",
"jp": [
"「名前は」"
]
},
{
"id": 17967,
"kind": "msg",
"jp": [
"・・・それ以上詳しくは",
"知らないって事かな。"
]
},
{
"id": 17968,
"kind": "msg",
"jp": [
"「書斎にある」"
]
},
{
"id": 17969,
"kind": "msg",
"jp": [
"「う、うん、それは知ってる」"
]
},
{
"id": 17970,
"kind": "msg",
"jp": [
"「面白いよ」"
]
},
{
"id": 17971,
"kind": "msg",
"jp": [
"「・・・そう?」"
]
},
{
"id": 17972,
"kind": "msg",
"jp": [
"読んでから話せ、という",
"ことのようだ・・・。"
]
},
{
"id": 17973,
"kind": "msg",
"jp": [
"なんだか寂しそうだ・・・。"
]
},
{
"id": 17974,
"kind": "msg",
"jp": [
"ふるふる、と無言で首を振られた。",
"ないらしい。"
]
},
{
"id": 17975,
"kind": "msg",
"jp": [
"会話が続かなかった・・・。"
]
},
{
"id": 17976,
"kind": "msg",
"jp": [
"「ここに、みんなを呼んだの",
"本当に帽子屋だと思う?」"
]
},
{
"id": 17977,
"kind": "msg",
"jp": [
"「・・・うちらを呼び集めたんは",
"犯人なんやろうと思う」"
]
},
{
"id": 17978,
"kind": "msg",
"jp": [
"「けど、それが帽子屋と別人か",
"どうかはわからへん。",
"同じ人なんかもしれへん」"
]
},
{
"id": 17979,
"kind": "msg",
"jp": [
"「まだやった」"
]
},
{
"id": 17980,
"kind": "msg",
"jp": [
"「お礼」"
]
},
{
"id": 17981,
"kind": "msg",
"jp": [
"「お礼?」"
]
},
{
"id": 17982,
"kind": "msg",
"jp": [
"「夕べの」"
]
},
{
"id": 17983,
"kind": "msg",
"jp": [
"「夕べって?」"
]
},
{
"id": 17984,
"kind": "msg",
"jp": [
"「心配してくれてた」"
]
},
{
"id": 17985,
"kind": "msg",
"jp": [
"「無事」"
]
},
{
"id": 17986,
"kind": "msg",
"jp": [
"「けど・・・」"
]
},
{
"id": 17987,
"kind": "msg",
"jp": [
"「ほんまに、うちやったんかな」"
]
},
{
"id": 17988,
"kind": "msg",
"jp": [
"「うちやったとしたら、",
"何で無事やったんやろう」"
]
},
{
"id": 17989,
"kind": "msg",
"jp": [
"「犯人の、気が変わった?」"
]
},
{
"id": 17990,
"kind": "msg",
"jp": [
"「もしそうやったら、",
"犯人はなんでかうちらの話",
"知ってたことになる」"
]
},
{
"id": 17991,
"kind": "msg",
"jp": [
"「う、うん。",
"でも、廊下で話してたし・・・」"
]
},
{
"id": 17992,
"kind": "msg",
"jp": [
"「じゃあ、あの時",
"犯人が近くにおった?」"
]
},
{
"id": 17993,
"kind": "msg",
"jp": [
"「・・・それ嫌やね」"
]
},
{
"id": 17994,
"kind": "msg",
"jp": [
"「・・・ところで」"
]
},
{
"id": 17995,
"kind": "msg",
"jp": [
"「ごらんの通り静奈さんは無事です」"
]
},
{
"id": 17996,
"kind": "msg",
"jp": [
"「・・・夕べ、うちが危ない",
"言うたん、お兄さんやん」"
]
},
{
"id": 17997,
"kind": "msg",
"jp": [
"「あ、ああ、うん」"
]
},
{
"id": 17998,
"kind": "msg",
"jp": [
"「・・・けど・・・・」"
]
},
{
"id": 17999,
"kind": "msg",
"jp": [
"「・・・やっぱりいい」"
]
},
{
"id": 18000,
"kind": "msg",
"jp": [
"・・・なんだったんだろう。",
"気になるけど話してくれそうに",
"なかった・・・。"
]
},
{
"id": 18001,
"kind": "msg",
"jp": [
"「・・・ところで、問題です」"
]
},
{
"id": 18002,
"kind": "msg",
"jp": [
"「夕べも、うちの部屋には",
"何事も起きませんでした」"
]
},
{
"id": 18003,
"kind": "msg",
"jp": [
"「なぜでしょう」"
]
},
{
"id": 18004,
"kind": "msg",
"jp": [
"「1番、犯人の気が変わった」"
]
},
{
"id": 18005,
"kind": "msg",
"jp": [
"「2番、推理が間違ってる」"
]
},
{
"id": 18006,
"kind": "msg",
"jp": [
"「3番」"
]
},
{
"id": 18007,
"kind": "msg",
"jp": [
"「3番があるの!?」"
]
},
{
"id": 18008,
"kind": "msg",
"jp": [
"「ある」"
]
},
{
"id": 18009,
"kind": "msg",
"jp": [
"「・・・どんなの?」"
]
},
{
"id": 18010,
"kind": "msg",
"jp": [
"「3番、犯人はお兄さん」"
]
},
{
"id": 18011,
"kind": "msg",
"jp": [
"「ぼ、僕!?」"
]
},
{
"id": 18012,
"kind": "msg",
"jp": [
"「狙ってない相手にわざと危ないよって",
"言うといて別の人を殺す作戦」"
]
},
{
"id": 18013,
"kind": "msg",
"jp": [
"「ち、違う違う違う!",
"僕じゃないよ!!」"
]
},
{
"id": 18014,
"kind": "msg",
"jp": [
"「・・・うちもそう",
"思てたんやけど」"
]
},
{
"id": 18015,
"kind": "msg",
"jp": [
"「思っ・・・てた?」"
]
},
{
"id": 18016,
"kind": "msg",
"jp": [
"「お兄さん、うちが危ないて",
"どういう推理してそない結論出したん",
"やろうって考えたら・・・」"
]
},
{
"id": 18017,
"kind": "msg",
"jp": [
"「・・・他に思いつかへんかった」"
]
},
{
"id": 18018,
"kind": "msg",
"jp": [
"「だから聞いてみた」"
]
},
{
"id": 18019,
"kind": "msg",
"jp": [
"「ち、違うよ・・・。",
"僕じゃないよ、本当に・・・」"
]
},
{
"id": 18020,
"kind": "msg",
"jp": [
"「・・・ほな、",
"うちが危ないっていう根拠は何?」"
]
},
{
"id": 18021,
"kind": "msg",
"jp": [
"「根拠・・・は、その・・・",
"だから、書斎で本を・・・」"
]
},
{
"id": 18022,
"kind": "msg",
"jp": [
"「書斎で、何か言われた?」"
]
},
{
"id": 18023,
"kind": "msg",
"jp": [
"「着流しさん、",
"ずっと書斎におるよね」"
]
},
{
"id": 18024,
"kind": "msg",
"jp": [
"「し、静奈ちゃん・・!」"
]
},
{
"id": 18025,
"kind": "msg",
"jp": [
"「そんな、あの、",
"日織は・・だって・・・",
"ずっと僕と同じ部屋に・・・」"
]
},
{
"id": 18026,
"kind": "msg",
"jp": [
"「{だ/・}{か/・}{ら/・}」"
]
},
{
"id": 18027,
"kind": "msg",
"jp": [
"「だから・・・?」"
]
},
{
"id": 18028,
"kind": "msg",
"jp": [
"「ふたりだけ、アリバイがある」"
]
},
{
"id": 18029,
"kind": "msg",
"jp": [
"それは――",
"日織が、最初に言ったことだ。"
]
},
{
"id": 18030,
"kind": "msg",
"jp": [
"やっぱりそれをみんな",
"怪しんでる・・・?"
]
},
{
"id": 18031,
"kind": "msg",
"jp": [
"「けど、お兄さんは見てると",
"どうもほんまに単なる迷子っぽい」"
]
},
{
"id": 18032,
"kind": "msg",
"jp": [
"「え・・じゃあ・・・",
"日織・・日織、だけ・・・?」"
]
},
{
"id": 18033,
"kind": "msg",
"jp": [
"「そう見える」"
]
},
{
"id": 18034,
"kind": "msg",
"jp": [
"「一見、表立って",
"うろちょろしてるんは",
"お兄さんの方やけど・・・」"
]
},
{
"id": 18035,
"kind": "msg",
"jp": [
"「・・・斑井さんの時から",
"お兄さんの考えてることの",
"根拠って着流しさんが出所やから」"
]
},
{
"id": 18036,
"kind": "msg",
"jp": [
"「あの、死んだ時間がいつ頃",
"だとかっていう話・・・?」"
]
},
{
"id": 18037,
"kind": "msg",
"jp": [
"「だから、今もずっと",
"そうなんかなと思える」"
]
},
{
"id": 18038,
"kind": "msg",
"jp": [
"「そ、そんなことないよ!?",
"そりゃ、相談はしてるけど、",
"でも・・・」"
]
},
{
"id": 18039,
"kind": "msg",
"jp": [
"「僕は、日織の言うとおりに",
"動いてるわけじゃ・・・」"
]
},
{
"id": 18040,
"kind": "msg",
"jp": [
"「・・・でもそれは、",
"うちらにはわからへん」"
]
},
{
"id": 18041,
"kind": "msg",
"jp": [
"「だからね」"
]
},
{
"id": 18042,
"kind": "msg",
"jp": [
"「根拠のわからへん推理に",
"固執してると怪しい人に見える」"
]
},
{
"id": 18043,
"kind": "msg",
"jp": [
"「・・・そ・・そっか」"
]
},
{
"id": 18044,
"kind": "msg",
"jp": [
"「泣かへんの」"
]
},
{
"id": 18045,
"kind": "msg",
"jp": [
"「え、いや、泣いてないよ」"
]
},
{
"id": 18046,
"kind": "msg",
"jp": [
"「うち、怒ってるわけやないん」"
]
},
{
"id": 18047,
"kind": "msg",
"jp": [
"「いじめてるけど」"
]
},
{
"id": 18048,
"kind": "msg",
"jp": [
"「お兄さん」"
]
},
{
"id": 18049,
"kind": "msg",
"jp": [
"「ほんまに、着流しさんは",
"犯人やないと思うんやったら",
"推理やり直した方がええと思う」"
]
},
{
"id": 18050,
"kind": "msg",
"jp": [
"「でないと、うち以外の人にも",
"着流しさんがどんどん他の人にも",
"疑われるだけやと思う」"
]
},
{
"id": 18051,
"kind": "msg",
"jp": [
"「・・・うち以外、ってことは",
"静奈ちゃんはまだ疑ってるの」"
]
},
{
"id": 18052,
"kind": "msg",
"jp": [
"「うん。",
"着流しさんだけやないけど」"
]
},
{
"id": 18053,
"kind": "msg",
"jp": [
"「・・・日織は・・・",
"日織は犯人じゃないよ・・・」"
]
},
{
"id": 18054,
"kind": "msg",
"jp": [
"「それはずるいよ」"
]
},
{
"id": 18055,
"kind": "msg",
"jp": [
"「お兄さんは、うちが危ないて",
"言うからにはどこかに犯人が",
"おると思てるんでしょ」"
]
},
{
"id": 18056,
"kind": "msg",
"jp": [
"「具体的に誰か1人を",
"疑うてるわけやなくても",
"犯人はおると思ってる」"
]
},
{
"id": 18057,
"kind": "msg",
"jp": [
"「そ・・そりゃあ・・・」"
]
},
{
"id": 18058,
"kind": "msg",
"jp": [
"「自分も誰かを疑うてるんやから",
"他の人が誰か疑うてるのを",
"証拠もなしに止めるのは無理」"
]
},
{
"id": 18059,
"kind": "msg",
"jp": [
"「うちには、今のところ",
"着流しさんを容疑者から外す",
"だけの理由が思いつかへん」"
]
},
{
"id": 18060,
"kind": "msg",
"jp": [
"「・・・・うん。",
"わかった、ごめん」"
]
},
{
"id": 18061,
"kind": "msg",
"jp": [
"「・・・誰も・・・」"
]
},
{
"id": 18062,
"kind": "msg",
"jp": [
"「誰も、犯人や",
"なかったらええのにね」"
]
},
{
"id": 18063,
"kind": "msg",
"jp": [
"「実は地下室に謎の殺人鬼が",
"潜んでただけやとか・・・」"
]
},
{
"id": 18064,
"kind": "msg",
"jp": [
"「だけ、じゃないよそれ!?",
"むちゃくちゃ怖いよっ!!」"
]
},
{
"id": 18065,
"kind": "msg",
"jp": [
"「最後はうちか御陵さんが",
"斧持って戦うんかな」"
]
},
{
"id": 18066,
"kind": "msg",
"jp": [
"「なんかホラー映画の",
"最後の方って女1人しか",
"生き残ってないやん」"
]
},
{
"id": 18067,
"kind": "msg",
"jp": [
"「それじゃあ",
"僕、死んでるじゃん!」"
]
},
{
"id": 18068,
"kind": "msg",
"jp": [
"「てことは、殺人鬼は",
"犯人じゃなさそう」"
]
},
{
"id": 18069,
"kind": "msg",
"jp": [
"どういう意味だろう・・・。"
]
},
{
"id": 18070,
"kind": "msg",
"jp": [
"「ところでね」"
]
},
{
"id": 18071,
"kind": "msg",
"jp": [
"「お兄さん、夕べの推理",
"あってたと思う?」"
]
},
{
"id": 18072,
"kind": "msg",
"jp": [
"「え・・・",
"夕べのって、あの・・・」"
]
},
{
"id": 18073,
"kind": "msg",
"jp": [
"「うちが危ないっていうやつ」"
]
},
{
"id": 18074,
"kind": "msg",
"jp": [
"「い、一応・・・",
"ちゃんと考えたんだけど」"
]
},
{
"id": 18075,
"kind": "msg",
"jp": [
"「うちは・・・」"
]
},
{
"id": 18076,
"kind": "msg",
"jp": [
"「うちは、間違うてると",
"・・・思いたい」"
]
},
{
"id": 18077,
"kind": "msg",
"jp": [
"「思いたい・・・?」"
]
},
{
"id": 18078,
"kind": "msg",
"jp": [
"「・・・って、",
"どういう・・・・」"
]
},
{
"id": 18079,
"kind": "msg",
"jp": [
"ふる、と小さく首を横に",
"振られてしまった。"
]
},
{
"id": 18080,
"kind": "msg",
"jp": [
"答えてはくれなさそう",
"だった・・・。"
]
},
{
"id": 18081,
"kind": "msg",
"jp": [
"「・・・ところで、お兄さん」"
]
},
{
"id": 18082,
"kind": "msg",
"jp": [
"「本気で、まだうちが",
"危ないと思てる?」"
]
},
{
"id": 18083,
"kind": "msg",
"jp": [
"「あ、あの、それは・・・」"
]
},
{
"id": 18084,
"kind": "msg",
"jp": [
"なんだか残念そうな",
"顔をされてしまった・・・。"
]
},
{
"id": 18085,
"kind": "msg",
"jp": [
"「・・・あのね」"
]
},
{
"id": 18086,
"kind": "msg",
"jp": [
"「夕べうちが狙われてたて",
"言うのん・・・・」"
]
},
{
"id": 18087,
"kind": "msg",
"jp": [
"「あ、う、うん」"
]
},
{
"id": 18088,
"kind": "msg",
"jp": [
"「・・・やっぱり、いい」"
]
},
{
"id": 18089,
"kind": "msg",
"jp": [
"なんなんだろう・・・?"
]
},
{
"id": 18090,
