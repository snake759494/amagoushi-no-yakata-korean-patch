{
"id": 8042,
"kind": "msg",
"jp": [
"『いつの間に・・・",
"亡くなってたんやろう?』"
]
},
{
"id": 8043,
"kind": "msg",
"jp": [
"「それがはっきりしなくて・・・",
"鈴奈ちゃんは、暗石さんに",
"最後に会ったのっていつ?」"
]
},
{
"id": 8044,
"kind": "msg",
"jp": [
"『うち?",
"うちは、そやね・・・』"
]
},
{
"id": 8045,
"kind": "msg",
"jp": [
"『多分、夜トイレの前で",
"会うたんが最後かな』"
]
},
{
"id": 8046,
"kind": "msg",
"jp": [
"『あの・・・那須さんのお茶に",
"毒が入れられてたって時』"
]
},
{
"id": 8047,
"kind": "msg",
"jp": [
"「ああ、あの日か・・・」"
]
},
{
"id": 8048,
"kind": "msg",
"jp": [
"『それっきりかな・・・』"
]
},
{
"id": 8049,
"kind": "msg",
"jp": [
"「・・・・そう」"
]
},
{
"id": 8050,
"kind": "msg",
"jp": [
"『・・・ほなね。",
"連絡ありがとう』"
]
},
{
"id": 8051,
"kind": "msg",
"jp": [
"『あ、でも・・・",
"夕べはうちらの番やなかったんや』"
]
},
{
"id": 8052,
"kind": "msg",
"jp": [
"「ご・・ごめん・・・。",
"本当に、ごめん」"
]
},
{
"id": 8053,
"kind": "msg",
"jp": [
"『しゃあないやん・・・",
"お兄さんかて、ほんまの警察や",
"あらへんねやし』"
]
},
{
"id": 8054,
"kind": "msg",
"jp": [
"『暗石さんには気の毒",
"やったけど・・・』"
]
},
{
"id": 8055,
"kind": "msg",
"jp": [
"『ああ、責めてるんと違うよ?",
"もう気にせんといて、ね?』"
]
},
{
"id": 8056,
"kind": "msg",
"jp": [
"『そんなに頑張らんでもええやん。",
"もう、お兄さんも自分の安全だけ",
"気ぃつけてた方がええよ』"
]
},
{
"id": 8057,
"kind": "msg",
"jp": [
"「・・・うん、ありがと」"
]
},
{
"id": 8058,
"kind": "msg",
"jp": [
"『ほなね・・・』"
]
},
{
"id": 8059,
"kind": "msg",
"jp": [
"鈴奈ちゃんにも電話を掛けて",
"みたが・・・。"
]
},
{
"id": 8060,
"kind": "msg",
"jp": [
"やっぱり誰も出なかった。",
"仕方ないな・・・。"
]
},
{
"id": 8061,
"kind": "msg",
"jp": [
"『・・・・・・・はい』"
]
},
{
"id": 8062,
"kind": "msg",
"jp": [
"「あ、静奈ちゃん?",
"和ですけど・・・」"
]
},
{
"id": 8063,
"kind": "msg",
"jp": [
"『どう?』"
]
},
{
"id": 8064,
"kind": "msg",
"jp": [
"扉を壊す、と知らせられていただけに",
"静奈ちゃんはためらいもせず",
"聞いてきた。"
]
},
{
"id": 8065,
"kind": "msg",
"jp": [
"「・・・ダメだった・・・。",
"亡くなってた・・・」"
]
},
{
"id": 8066,
"kind": "msg",
"jp": [
"『・・・そう』"
]
},
{
"id": 8067,
"kind": "msg",
"jp": [
"普段からあまり抑揚の無い声が",
"いっそう無機質に響く。"
]
},
{
"id": 8068,
"kind": "msg",
"jp": [
"『・・・・いつ?』"
]
},
{
"id": 8069,
"kind": "msg",
"jp": [
"「え、あ、それが・・・」"
]
},
{
"id": 8070,
"kind": "msg",
"jp": [
"『・・・ああ、そやね。",
"ずっと部屋におったし・・・』"
]
},
{
"id": 8071,
"kind": "msg",
"jp": [
"「う、うん。",
"断定出来ないんだ・・・」"
]
},
{
"id": 8072,
"kind": "msg",
"jp": [
"『うちなんか、部屋にこもる",
"言いんさってから会うてへん』"
]
},
{
"id": 8073,
"kind": "msg",
"jp": [
"『みんなで・・・",
"引きずり出したらよかったね』"
]
},
{
"id": 8074,
"kind": "msg",
"jp": [
"「・・・そうかもね・・・」"
]
},
{
"id": 8075,
"kind": "msg",
"jp": [
"『・・・・・・・』"
]
},
{
"id": 8076,
"kind": "msg",
"jp": [
"『・・・ほな・・・』"
]
},
{
"id": 8077,
"kind": "msg",
"jp": [
"『・・・・・・』"
]
},
{
"id": 8078,
"kind": "msg",
"jp": [
"『・・・間違えた?』"
]
},
{
"id": 8079,
"kind": "msg",
"jp": [
"「え・・・あ、うん・・・",
"ごめん、僕が間違ってた」"
]
},
{
"id": 8080,
"kind": "msg",
"jp": [
"『そう・・・",
"やったら、うちらまだなんや・・・』"
]
},
{
"id": 8081,
"kind": "msg",
"jp": [
"「ごめん、あの・・・」"
]
},
{
"id": 8082,
"kind": "msg",
"jp": [
"『・・・ええの。",
"違う気がしてたから』"
]
},
{
"id": 8083,
"kind": "msg",
"jp": [
"『お兄さん、向いてへんと思う』"
]
},
{
"id": 8084,
"kind": "msg",
"jp": [
"「・・・・う、うん」"
]
},
{
"id": 8085,
"kind": "msg",
"jp": [
"『ほなね』"
]
},
{
"id": 8086,
"kind": "msg",
"jp": [
"頷いたときには、",
"電話はもう切れていた・・・。"
]
},
{
"id": 8087,
"kind": "msg",
"jp": [
"静奈ちゃんは出てくれないかな・・・。"
]
},
{
"id": 8088,
"kind": "msg",
"jp": [
"やっぱりダメか・・・。",
"出てくれそうにない。"
]
},
{
"id": 8089,
"kind": "msg",
"jp": [
"『はい、もしもし・・・』"
]
},
{
"id": 8090,
"kind": "msg",
"jp": [
"「御陵さんですか?",
"一柳ですけど・・・」"
]
},
{
"id": 8091,
"kind": "msg",
"jp": [
"『ああ、一柳さん。",
"あの、どうなりました?",
"さっきの件・・・』"
]
},
{
"id": 8092,
"kind": "msg",
"jp": [
"「暗石さん・・・",
"亡くなってました・・・」"
]
},
{
"id": 8093,
"kind": "msg",
"jp": [
"受話器の向こうで息を飲む",
"音が聞こえた。"
]
},
{
"id": 8094,
"kind": "msg",
"jp": [
"『そう・・ですか・・・』"
]
},
{
"id": 8095,
"kind": "msg",
"jp": [
"『警戒して、お返事なさらないだけなら",
"いいのにって、思ってましたのに・・』"
]
},
{
"id": 8096,
"kind": "msg",
"jp": [
"『それで、あの・・・",
"いつから・・・』"
]
},
{
"id": 8097,
"kind": "msg",
"jp": [
"「それが・・・",
"正確にはよくわからないんです。",
"ずっと部屋にいただけに・・・」"
]
},
{
"id": 8098,
"kind": "msg",
"jp": [
"『まあ・・・』"
]
},
{
"id": 8099,
"kind": "msg",
"jp": [
"「御陵さん、暗石さんは部屋に",
"こもった後でお会いしたことって",
"ありますか?」"
]
},
{
"id": 8100,
"kind": "msg",
"jp": [
"『お会いしたことは・・・",
"あ、でも、お見かけしただけなら』"
]
},
{
"id": 8101,
"kind": "msg",
"jp": [
"「あるんですか?",
"いつですか、それ」"
]
},
{
"id": 8102,
"kind": "msg",
"jp": [
"『今朝早くです。",
"6時半頃だったかしら・・・』"
]
},
{
"id": 8103,
"kind": "msg",
"jp": [
"「今朝? どこでですか?」"
]
},
{
"id": 8104,
"kind": "msg",
"jp": [
"『昨日の朝早くです。",
"6時半頃だったかしら・・・』"
]
},
{
"id": 8105,
"kind": "msg",
"jp": [
"「昨日の・・?」"
]
},
{
"id": 8106,
"kind": "msg",
"jp": [
"『2階の廊下ですわ。",
"私、早くに目が覚めてしまって、",
"部屋を出たんです・・・』"
]
},
{
"id": 8107,
"kind": "msg",
"jp": [
"『その時、暗石さんが",
"お手洗いに入って行かれるのを",
"見かけましたわ』"
]
},
{
"id": 8108,
"kind": "msg",
"jp": [
"「そうなんですか・・・",
"その後、御陵さんは台所かどこかに?」"
]
},
{
"id": 8109,
"kind": "msg",
"jp": [
"『・・・居間におりました。",
"何をしていたというわけでも",
"ないのですけれど・・・』"
]
},
{
"id": 8110,
"kind": "msg",
"jp": [
"『だんだん、お部屋でじっとして",
"いるのも息が詰まる気がしてきて・・』"
]
},
{
"id": 8111,
"kind": "msg",
"jp": [
"「・・・そうですよね・・」"
]
},
{
"id": 8112,
"kind": "msg",
"jp": [
"『ええ・・・』"
]
},
{
"id": 8113,
"kind": "msg",
"jp": [
"『すみません、それじゃあ・・・』"
]
},
{
"id": 8114,
"kind": "msg",
"jp": [
"「・・・はい。",
"失礼します・・・」"
]
},
{
"id": 8115,
"kind": "msg",
"jp": [
"『あら・・?",
"待って下さい、一柳さん』"
]
},
{
"id": 8116,
"kind": "msg",
"jp": [
"『あの、夕べは確か、",
"私が・・・って・・・』"
]
},
{
"id": 8117,
"kind": "msg",
"jp": [
"「すみません!",
"僕のミスです・・・」"
]
},
{
"id": 8118,
"kind": "msg",
"jp": [
"『・・・・・・・・』"
]
},
{
"id": 8119,
"kind": "msg",
"jp": [
"「ごめんなさい・・・。",
"僕が間違ってたんです」"
]
},
{
"id": 8120,
"kind": "msg",
"jp": [
"「てっきり御陵さんが狙われてると",
"思い込んでて・・・」"
]
},
{
"id": 8121,
"kind": "msg",
"jp": [
"『本当に狙われてたのは、",
"暗石さんだったんですね・・・』"
]
},
{
"id": 8122,
"kind": "msg",
"jp": [
"「・・・そうだったみたいです」"
]
},
{
"id": 8123,
"kind": "msg",
"jp": [
"『暗石さん・・・お気の毒に・・・』"
]
},
{
"id": 8124,
"kind": "msg",
"jp": [
"『ああ、でも一柳さんの",
"せいじゃありませんわよ』"
]
},
{
"id": 8125,
"kind": "msg",
"jp": [
"『あなたは本来関係ない立場",
"なのに、どうにかしようとして",
"下さってますもの』"
]
},
{
"id": 8126,
"kind": "msg",
"jp": [
"「・・・でも、間違えましたし。",
"すみません役に立てなくて」"
]
},
{
"id": 8127,
"kind": "msg",
"jp": [
"『お気になさらないで。",
"あなたのせいじゃありません』"
]
},
{
"id": 8128,
"kind": "msg",
"jp": [
"「・・・ありがとうございます」"
]
},
{
"id": 8129,
"kind": "msg",
"jp": [
"『でも、もうあまり気負い",
"すぎないで下さいね』"
]
},
{
"id": 8130,
"kind": "msg",
"jp": [
"『犯人は何を考えてるか",
"わかりませんもの、",
"もう危険なことはしないで』"
]
},
{
"id": 8131,
"kind": "msg",
"jp": [
"「・・・はい・・・。",
"すみませんでした・・・」"
]
},
{
"id": 8132,
"kind": "msg",
"jp": [
"『いいえ、それじゃ・・・』"
]
},
{
"id": 8133,
"kind": "msg",
"jp": [
"『はい、もしもし?』"
]
},
{
"id": 8134,
"kind": "msg",
"jp": [
"「あ、那須さん。",
"すみません、和ですけど・・・」"
]
},
{
"id": 8135,
"kind": "msg",
"jp": [
"『ああ、和くんか・・・。",
"どうしたの?』"
]
},
{
"id": 8136,
"kind": "msg",
"jp": [
"「あの、実はちょっと聞いて",
"おきたいことがあって・・・」"
]
},
{
"id": 8137,
"kind": "msg",
"jp": [
"『なんだい?』"
]
},
{
"id": 8138,
"kind": "msg",
"jp": [
"「那須さんが・・・",
"最後に暗石さんに会ったのって",
"いつになりますか?」"
]
},
{
"id": 8139,
"kind": "msg",
"jp": [
"『ぼくが・・・?",
"うーん、そうだなあ・・・』"
]
},
{
"id": 8140,
"kind": "msg",
"jp": [
"『多分、みんなと同じじゃないかな。",
"暗石さんが部屋にこもるって言った",
"あの日会ったのが・・・』"
]
},
{
"id": 8141,
"kind": "msg",
"jp": [
"『確かそうだと思うよ。",
"あんまり役に立たなくてごめんな』"
]
},
{
"id": 8142,
"kind": "msg",
"jp": [
"「いえ、いいんです。",
"お疲れのところすみません」"
]
},
{
"id": 8143,
"kind": "msg",
"jp": [
"『いや、大丈夫だよ。",
"悪かったね心配掛けて』"
]
},
{
"id": 8144,
"kind": "msg",
"jp": [
"「いいえ、ゆっくり休んで下さい」"
]
},
{
"id": 8145,
"kind": "msg",
"jp": [
"『うん、ありがとう。",
"それじゃあね』"
]
},
{
"id": 8146,
"kind": "msg",
"jp": [
"『もしもし?』"
]
},
{
"id": 8147,
"kind": "msg",
"jp": [
"待っていたのか、椿くんは",
"すぐに電話に出てくれた。"
]
},
{
"id": 8148,
"kind": "msg",
"jp": [
"『和か? 日織はどうした?』"
]
},
{
"id": 8149,
"kind": "msg",
"jp": [
"「大丈夫、一緒にいるよ。",
"日織は・・・大丈夫だけど・・・」"
]
},
{
"id": 8150,
"kind": "msg",
"jp": [
"『・・・オッサンか』"
]
},
{
"id": 8151,
"kind": "msg",
"jp": [
"「うん・・・。",
"やっぱり、亡くなってた・・・」"
]
},
{
"id": 8152,
"kind": "msg",
"jp": [
"『ちっ・・・!",
"なんだよ、人一倍警戒してた",
"クセによ・・・』"
]
},
{
"id": 8153,
"kind": "msg",
"jp": [
"『・・・オッサン下手したら",
"いつ死んだのかわかんねーんじゃ",
"ねえのか?』"
]
},
{
"id": 8154,
"kind": "msg",
"jp": [
"「うん・・・",
"はっきりわからないと思う」"
]
},
{
"id": 8155,
"kind": "msg",
"jp": [
"「椿くんは、暗石さんが部屋に",
"こもるって言ってから会ってない?」"
]
},
{
"id": 8156,
"kind": "msg",
"jp": [
"『・・・会ってねえな。",
"あれが最後になっちまった・・・』"
]
},
{
"id": 8157,
"kind": "msg",
"jp": [
"『・・・すまねえな。",
"役に立たなくてよ』"
]
},
{
"id": 8158,
"kind": "msg",
"jp": [
"「ううん、僕だって・・・",
"暗石さん亡くなってたの",
"さっきまで気付かなかったし」"
]
},
{
"id": 8159,
"kind": "msg",
"jp": [
"『しょうがねーよ。",
"お前だけのせいじゃねーんだ』"
]
},
{
"id": 8160,
"kind": "msg",
"jp": [
"『あんま、落ち込むな。",
"日織にも言っとけ』"
]
},
{
"id": 8161,
"kind": "msg",
"jp": [
"『じゃーな』"
]
},
{
"id": 8162,
"kind": "msg",
"jp": [
"次は誰に掛けよう・・・?"
]
},
{
"id": 8163,
"kind": "msg",
"jp": [
"「ねえ、椿くん」"
]
},
{
"id": 8164,
"kind": "msg",
"jp": [
"「なんだよ?」"
]
},
{
"id": 8165,
"kind": "msg",
"jp": [
"「那須さん、あの・・・」"
]
},
{
"id": 8166,
"kind": "msg",
"jp": [
"「なんだい?」"
]
},
{
"id": 8167,
"kind": "msg",
"jp": [
"「鈴奈ちゃん、あのさ」"
]
},
{
"id": 8168,
"kind": "msg",
"jp": [
"「ねえ、静奈ちゃん」"
]
},
{
"id": 8169,
"kind": "msg",
"jp": [
"「・・・・」"
]
},
{
"id": 8170,
"kind": "msg",
"jp": [
"「あのー、御陵さん」"
]
},
{
"id": 8171,
"kind": "msg",
"jp": [
"「なんでしょう?」"
]
},
{
"id": 8172,
"kind": "msg",
"jp": [
"「日織、あのさ」"
]
},
{
"id": 8173,
"kind": "msg",
"jp": [
"「夕べは部屋に帰って",
"すぐに寝ちゃったの?」"
]
},
{
"id": 8174,
"kind": "msg",
"jp": [
"「・・・すぐ寝るつもり",
"だったんだがな」"
]
},
{
"id": 8175,
"kind": "msg",
"jp": [
"「何かあったの?」"
]
},
{
"id": 8176,
"kind": "msg",
"jp": [
"「トイレに行こうとしたら、",
"吹き抜けの手すりに人影みてーなのが",
"見えて驚いてさ」"
]
},
{
"id": 8177,
"kind": "msg",
"jp": [
"「よく見たらあれだった」"
]
},
{
"id": 8178,
"kind": "msg",
"jp": [
"そう言って、テラスに",
"ぶら下がっている",
"てるてる坊主を親指で示す。"
]
},
{
"id": 8179,
"kind": "msg",
"jp": [
"「どーせ、あの馬鹿の仕業だろうと",
"思って不気味だから他のトコに",
"吊せって部屋まで言いにいったよ」"
]
},
{
"id": 8180,
"kind": "msg",
"jp": [
"「そうだったんだ・・・。",
"それって夜中に?」"
]
},
{
"id": 8181,
"kind": "msg",
"jp": [
"「いや、部屋に戻ってまだ",
"そんなには・・・」"
]
},
{
"id": 8182,
"kind": "msg",
"jp": [
"「ああ、そうだ。",
"部屋から出る時、時計見たんだ",
"11時20分だったな」"
]
},
{
"id": 8183,
"kind": "msg",
"jp": [
"「夜に会って話した人って",
"那須さんだけだった?」"
]
},
{
"id": 8184,
"kind": "msg",
"jp": [
"「んー、そのはずだけど?",
"他のヤツ見かけた覚えねえな」"
]
},
{
"id": 8185,
"kind": "msg",
"jp": [
"「じゃあ那須さんの部屋に",
"いたのってどれくらい?」"
]
},
{
"id": 8186,
"kind": "msg",
"jp": [
"「中まで入ってねえよ。",
"ドアのとこで一言二言話して",
"すぐ自分の部屋に戻ったし」"
]
},
{
"id": 8187,
"kind": "msg",
"jp": [
"「そっか。",
"そもそも何しに部屋から",
"出たんだっけ」"
]
},
{
"id": 8188,
"kind": "msg",
"jp": [
"「トイレだっての。",
"とりあえず行ってから部屋に戻る",
"前に筋肉んとこ行ったんだよ」"
]
},
{
"id": 8189,
"kind": "msg",
"jp": [
"・・・すっかり名前じゃないもので",
"呼ばれてる・・・。"
]
},
{
"id": 8190,
"kind": "msg",
"jp": [
"「夕べはすぐに",
"寝ちゃいました?」"
]
},
{
"id": 8191,
"kind": "msg",
"jp": [
"「まさか!",
"ちゃんと寝る前にいつも通り",
"腕立てと腹筋と背筋と・・・」"
]
},
{
"id": 8192,
"kind": "msg",
"jp": [
"「あと、てるてる坊主作ってたし。",
"ほら、あそこにあるやつ」"
]
},
{
"id": 8193,
"kind": "msg",
"jp": [
"そう言って那須さんは、テラスの",
"ひさしにぶら下がったタオルで出来た",
"てるてる坊主を指さした。"
]
},
{
"id": 8194,
"kind": "msg",
"jp": [
"「最初、2階の吹き抜けの手すりに",
"吊ってあったんだけどさ」"
]
},
{
"id": 8195,
"kind": "msg",
"jp": [
"「椿くんから、人影みたいに見えて",
"不気味だからよせって怒られてね」"
]
},
{
"id": 8196,
"kind": "msg",
"jp": [
"「・・・でしょうね」"
]
},
{
"id": 8197,
"kind": "msg",
"jp": [
"暗い廊下であんなのがぼんやり",
"見えたら、僕だったら悲鳴上げる。"
]
},
{
"id": 8198,
"kind": "msg",
"jp": [
"「あの、それって何時頃ですか?",
"てるてる坊主吊ってたのって」"
]
},
{
"id": 8199,
"kind": "msg",
"jp": [
"「最初に吊るしたの?",
"11時過ぎだったと思うよ」"
]
},
{
"id": 8200,
"kind": "msg",
"jp": [
"「その時は部屋から誰か",
"出てきたとかってことは",
"なかったんですか」"
]
},
{
"id": 8201,
"kind": "msg",
"jp": [
"「うん、誰も・・・」"
]
},
{
"id": 8202,
"kind": "msg",
"jp": [
"「ああ、でもそう言えば",
"会ったんじゃないけど",
"下に誰かいたの見かけたなあ」"
]
},
{
"id": 8203,
"kind": "msg",
"jp": [
"「下って吹き抜けの?",
"1階のロビーのことですか?」"
]
},
{
"id": 8204,
"kind": "msg",
"jp": [
"「なんか、台所の方に向かって",
"行くのがちらっと見えたんだけど」"
]
},
{
"id": 8205,
"kind": "msg",
"jp": [
"「体型からして、",
"斑井さんだったと思うんだよね」"
]
},
{
"id": 8206,
"kind": "msg",
"jp": [
"「・・・ああいう体型の人は",
"斑井さんだけですもんね」"
]
},
{
"id": 8207,
"kind": "msg",
"jp": [
"「それが・・・",
"11時過ぎのことですか?」"
]
},
{
"id": 8208,
"kind": "msg",
"jp": [
"「うん、そう。",
"11時・・・15分か",
"そこらじゃないかな」"
]
},
{
"id": 8209,
"kind": "msg",
"jp": [
"て、ことは斑井さんが亡くなったのは",
"それより後のことなんだ・・・。"
]
},
{
"id": 8210,
"kind": "msg",
"jp": [
"「てるてる坊主って",
"椿くんに怒られてすぐに",
"吊るしなおしたんですか?」"
]
},
{
"id": 8211,
"kind": "msg",
"jp": [
"「うん、そうだよ。",
"朝までになんとかしとけって",
"言われちゃったし」"
]
},
{
"id": 8212,
"kind": "msg",
"jp": [
"「でしょうね・・・",
"なおしに行ったのは",
"何時頃だったか覚えてます?」"
]
},
{
"id": 8213,
"kind": "msg",
"jp": [
"「えーと、スクワットの1セット目が",
"終わったとこだったから、11時半って",
"ところじゃないかな」"
]
},
{
"id": 8214,
"kind": "msg",
"jp": [
"なんかすごい基準で",
"時間が計られてる・・・。"
]
},
{
"id": 8215,
"kind": "msg",
"jp": [
"「夕べは、すぐ寝ちゃいました?」"
]
},
{
"id": 8216,
"kind": "msg",
"jp": [
"「いや、ライターが切れちまってな、",
"火種を探しに降りたんだよ。",
"11時をちょっと過ぎた頃だったか」"
]
},
{
"id": 8217,
"kind": "msg",
"jp": [
"「最初、娯楽室に行こうと思ったんだが",
"そう言や居間でマッチ見かけたっての",
"思い出して居間で探して一服したな」"
]
},
{
"id": 8218,
"kind": "msg",
"jp": [
"「ここでですか?」"
]
},
{
"id": 8219,
"kind": "msg",
"jp": [
"「部屋ん中で吸うと",
"執事がうるせえから",
"そこのテラスでな」"
]
},
{
"id": 8220,
"kind": "msg",
"jp": [
"「マッチもいつの間にか片付けて",
"やがって探すのに苦労したぜ」"
]
},
{
"id": 8221,
"kind": "msg",
"jp": [
"「その時、他に誰か来たり",
"しませんでした?」"
]
},
{
"id": 8222,
"kind": "msg",
"jp": [
"「・・・いや、",
"誰も来なかったが・・・」"
]
},
{
"id": 8223,
"kind": "msg",
"jp": [
"「? あの・・・?」"
]
},
{
"id": 8224,
"kind": "msg",
"jp": [
"「いや、なんでもねえ。",
"誰も来なかったぜ」"
]
},
{
"id": 8225,
"kind": "msg",
"jp": [
"「はあ・・・」"
]
},
{
"id": 8226,
"kind": "msg",
"jp": [
"「暗石さんがテラスに",
"いたのってどれくらいでした?」"
]
},
{
"id": 8227,
"kind": "msg",
"jp": [
"「探すのに手間取って、",
"その後2、3本吸ったから・・・」"
]
},
{
"id": 8228,
"kind": "msg",
"jp": [
"「まあ、20分以上は",
"いたんじゃねえかな」"
]
},
{
"id": 8229,
"kind": "msg",
"jp": [
"「20分以上ですか」"
]
},
{
"id": 8230,
"kind": "msg",
"jp": [
"「30分てこたぁねえと",
"思うが、まあそんなもんだ」"
]
},
{
"id": 8231,
"kind": "msg",
"jp": [
"「御陵さんが、台所に行くとき",
"暗石さんが居間の方へ行くの",
"見かけたそうなんですけど」"
]
},
{
"id": 8232,
"kind": "msg",
"jp": [
"「暗石さんは、御陵さんのこと",
"気がつかなかったですか?」"
]
},
{
"id": 8233,
"kind": "msg",
"jp": [
"「へえ・・・?",
"オレは気がつかなかったな」"
]
},
{
"id": 8234,
"kind": "msg",
"jp": [
"「そうですか」"
]
},
{
"id": 8235,
"kind": "msg",
"jp": [
"「夕べは、すぐに寝ちゃった?」"
]
},
{
"id": 8236,
"kind": "msg",
"jp": [
"「ううん、お姉ちゃんの部屋で",
"しばらく喋ってた」"
]
},
{
"id": 8237,
"kind": "msg",
"jp": [
"「ずっと静奈ちゃんの",
"部屋にいたんだ?」"
]
},
{
"id": 8238,
"kind": "msg",
"jp": [
"「うん、そう・・・あ、違うわ",
"一回トイレ行った」"
]
},
{
"id": 8239,
"kind": "msg",
"jp": [
"「それで戻ってきた時、部屋の前で",
"御陵さんに会うたんであいさつして",
"うちはすぐ部屋に入ったん」"
]
},
{
"id": 8240,
"kind": "msg",
"jp": [
"「御陵さんかぁ・・・。",
"御陵さんは出てきたとこだったの?」"
]
},
{
"id": 8241,
"kind": "msg",
"jp": [
"「うん、出てきたとこみたい",
"そのまま廊下歩いてったし。",
"どこ行ったんか知らんけど」"
]
},
{
"id": 8242,
"kind": "msg",
"jp": [
"「そっか。",
"それって何時頃だった?」"
]
},
{
"id": 8243,
"kind": "msg",
"jp": [
"「11時ちょっと過ぎかなぁ。",
"多分、5分くらい」"
]
},
{
"id": 8244,
"kind": "msg",
"jp": [
"「静奈ちゃんの部屋から",
"戻ったのっていつ頃?」"
]
},
{
"id": 8245,
"kind": "msg",
"jp": [
"「11時半くらいやったかな。",
"お姉ちゃんがトイレ行くって言うから",
"ほな、うちもう戻るわって」"
]
},
{
"id": 8246,
"kind": "msg",
"jp": [
"「一緒に出て、うちはすぐ",
"そのまま部屋に戻って寝たん」"
]
},
{
"id": 8247,
"kind": "msg",
"jp": [
"「部屋にいる時、外から",
"誰かの話し声とか聞こえた?」"
]
},
{
"id": 8248,
"kind": "msg",
"jp": [
"「うーん、",
"別に聞こえんかったと思うけど。",
"うちの部屋、奥の方やしね」"
]
},
{
"id": 8249,
"kind": "msg",
"jp": [
"「夕べ、すぐに寝ちゃった?」"
]
},
{
"id": 8250,
"kind": "msg",
"jp": [
"「起きてたの?」"
]
},
{
"id": 8251,
"kind": "msg",
"jp": [
"「鈴と喋ってたん。",
"一緒に部屋に戻って、",
"11時半くらいまで」"
]
},
{
"id": 8252,
"kind": "msg",
"jp": [
"「それで、トイレ行こうと思て",
"部屋出たらなんか声がしたから",
"見に行ったら那須さんやった」"
]
},
{
"id": 8253,
"kind": "msg",
"jp": [
"「吹き抜けんとこに吊った",
"てるてる坊主ほどいてた。",
"そこはアカンて怒られたからって」"
]
},
{
"id": 8254,
"kind": "msg",
"jp": [
"「そ、そう・・・」"
]
},
{
"id": 8255,
"kind": "msg",
"jp": [
"普通は夜中の廊下で遭遇する",
"光景じゃないよな、それ・・・。"
]
},
{
"id": 8256,
"kind": "msg",
"jp": [
"「それで、鈴奈ちゃんは",
"その時部屋に戻ったんだ?」"
]
},
{
"id": 8257,
"kind": "msg",
"jp": [
"「・・・その前に一回",
"トイレ行ったけど、その時は",
"5分くらいで戻ってきた」"
]
},
{
"id": 8258,
"kind": "msg",
"jp": [
"「那須さん、てるてる坊主",
"どこに持っていくとかって",
"言ってた?」"
]
},
{
"id": 8259,
"kind": "msg",
"jp": [
"「どこがいいかなって言うから",
"普通は窓の外に吊るんと",
"違うのんて言うた」"
]
},
{
"id": 8260,
"kind": "msg",
"jp": [
"「ふうん、そうするって?」"
]
},
{
"id": 8261,
"kind": "msg",
"jp": [
"「うん、じゃあ外から",
"探してみようって」"
]
},
{
"id": 8262,
"kind": "msg",
"jp": [
"「出てったの?」"
]
},
{
"id": 8263,
"kind": "msg",
"jp": [
"「そこまで見てへん。",
"すぐトイレ行って部屋戻ったし」"
]
},
{
"id": 8264,
"kind": "msg",
"jp": [
"「トイレから戻った後は、",
"部屋にいて何か変な物音とか",
"聞こえたりした?」"
]
},
{
"id": 8265,
"kind": "msg",
"jp": [
"「・・・・・・屍達の唄」"
]
},
{
"id": 8266,
"kind": "msg",
"jp": [
"「これ」"
]
},
{
"id": 8267,
"kind": "msg",
"jp": [
"にこ、と笑いながら静奈ちゃんは",
"ポケットからMDを取り出した。"
]
},
{
"id": 8268,
"kind": "msg",
"jp": [
"最近流行りのバンドの名前と、",
"曲のタイトルらしきものが",
"並んでいた・・・。"
]
},
{
"id": 8269,
"kind": "msg",
"jp": [
"「・・・ロック?」"
]
},
{
"id": 8270,
"kind": "msg",
"jp": [
"「好き」"
]
},
{
"id": 8271,
"kind": "msg",
"jp": [
"「そ、そっか・・・。",
"音楽聴いてたんだね?」"
]
},
{
"id": 8272,
"kind": "msg",
"jp": [
"「風の音、うるさいし」"
]
},
{
"id": 8273,
"kind": "msg",
"jp": [
"「聴きながら寝ちゃったんだ?」"
]
},
{
"id": 8274,
"kind": "msg",
"jp": [
"「・・・エンドレスにしてた」"
]
},
{
"id": 8275,
"kind": "msg",
"jp": [
"・・・風の音よりにぎやかな曲",
"ばっかりのような気がするけど。",
"よく眠れるなぁ、それで・・・。"
]
},
{
"id": 8276,
"kind": "msg",
"jp": [
"「夕べは、眠れました?」"
]
},
{
"id": 8277,
"kind": "msg",
"jp": [
"「・・・いえ、あまり・・・」"
]
},
{
"id": 8278,
"kind": "msg",
"jp": [
"「そうですよね・・・。",
"じゃあ、何か変な物音とか・・・」"
]
},
{
"id": 8279,
"kind": "msg",
"jp": [
"「さあ、そこまでは・・・」"
]
},
{
"id": 8280,
"kind": "msg",
"jp": [
"「どうしても喉が渇いて、",
"台所に飲み物をいただきに行ったの",
"ですけど何もありませんでしたし」"
]
},
{
"id": 8281,
"kind": "msg",
"jp": [
"「それって何時頃ですか?」"
]
},
{
"id": 8282,
"kind": "msg",
"jp": [
"「多分11時過ぎです。",
"そう言えば、部屋を出た時に",
"鈴奈さんにお会いしましたわ」"
]
},
{
"id": 8283,
"kind": "msg",
"jp": [
"「ちょうど、お部屋に戻られた",
"ところのようでした」"
]
},
{
"id": 8284,
"kind": "msg",
"jp": [
"「鈴奈ちゃんはすぐに部屋に",
"入ってったんですか?」"
]
},
{
"id": 8285,
"kind": "msg",
"jp": [
"「そうです。",
"私は、そのまま台所に・・・」"
]
},
{
"id": 8286,
"kind": "msg",
"jp": [
"「どれくらい台所に",
"おられました?」"
]
},
{
"id": 8287,
"kind": "msg",
"jp": [
"「ええと・・・",
"10分、いえ15分くらいかしら」"
]
},
{
"id": 8288,
"kind": "msg",
"jp": [
"「温かいものが飲みたくて",
"ミルクを温めていただきましたの」"
]
},
{
"id": 8289,
"kind": "msg",
"jp": [
"「台所に行かれた時とか戻る時に",
"斑井さんを見かけたりとか",
"しませんでした?」"
]
},
{
"id": 8290,
"kind": "msg",
"jp": [
"「いいえ、部屋を出た時に",
"鈴奈さんにお会いした以外は",
"どなたにも会ってませんわ」"
]
},
{
"id": 8291,
"kind": "msg",
"jp": [
"「斑井さんにももちろん",
"お会いしてませんわ。",
"食堂は開けませんでしたし」"
]
},
{
"id": 8292,
"kind": "msg",
"jp": [
"「なんか物音がしたとか",
"そんなことも?」"
]
},
{
"id": 8293,
"kind": "msg",
"jp": [
"「物音は・・・",
"聞こえませんでしたわ。",
"雨の音が激しかったですし」"
]
},
{
"id": 8294,
"kind": "msg",
"jp": [
"「あ、でも・・・台所へ行くとき",
"ホールから暗石さんが居間の方へ",
"向かうのは、お見かけしました」"
]
},
{
"id": 8295,
"kind": "msg",
"jp": [
"「暗石さんですか」"
]
},
{
"id": 8296,
"kind": "msg",
"jp": [
"「ええ、見かけただけで",
"話したりはしてませんけれど」"
]
},
{
"id": 8297,
"kind": "msg",
"jp": [
"「それ以外には特に",
"変わったことは何もありません",
"でしたけれど」"
]
},
{
"id": 8298,
"kind": "msg",
"jp": [
"「日織はずっと部屋で",
"寝てたよなぁ・・・」"
]
},
{
"id": 8299,
"kind": "msg",
"jp": [
"「{和/なご}さんもでしょ。",
"まあ、ろくに眠れませんでしたが」"
]
},
{
"id": 8300,
"kind": "msg",
"jp": [
"だけど、そのおかげで僕らは",
"お互いにお互いが犯人じゃ",
"ないことを知っている・・・。"
]
},
{
"id": 8301,
"kind": "msg",
"jp": [
"「日織はさ、廊下の物音とか",
"何か話し声とか聞こえた?」"
]
},
{
"id": 8302,
"kind": "msg",
"jp": [
"「ええ、かすかにですけどね。",
"多分ありゃあ那須さんか椿さんかな、",
"よく通ってでけえ声だから」"
]
}
]