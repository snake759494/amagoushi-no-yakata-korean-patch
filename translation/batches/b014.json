[
{
"id": 7784,
"kind": "msg",
"jp": [
"「そうだな・・・。",
"うん、そこはもうちょっと",
"じっくり考えてみる」"
]
},
{
"id": 7785,
"kind": "msg",
"jp": [
"「・・・じゃあその次ですか。",
"温室のアレですかね」"
]
},
{
"id": 7786,
"kind": "msg",
"jp": [
"「『復讐』か・・・」"
]
},
{
"id": 7787,
"kind": "msg",
"jp": [
"「もしも全員が犯人の復讐に",
"関係あるんだったら、動機はそんなに",
"昔の事が発端じゃないはずだよな」"
]
},
{
"id": 7788,
"kind": "msg",
"jp": [
"「何十年も前の話じゃ、椿くんとか",
"まだ生まれてないわけだし」"
]
},
{
"id": 7789,
"kind": "msg",
"jp": [
"「そういうことになりますね」"
]
},
{
"id": 7790,
"kind": "msg",
"jp": [
"「けど、ここ最近のことなら俺でも",
"覚えてそうなもんなんですが・・・」"
]
},
{
"id": 7791,
"kind": "msg",
"jp": [
"「ぴんと来ないってことは、",
"自分とは関係ない話だと思ってる",
"ようなことなんじゃないかな」"
]
},
{
"id": 7792,
"kind": "msg",
"jp": [
"「ああ・・・。",
"具体的に聞かれたらわかるけど、",
"心当たりとして自覚してねえとか?」"
]
},
{
"id": 7793,
"kind": "msg",
"jp": [
"「{和/なご}さん、何か思い当たるようなこと",
"見つけたんですかい?」"
]
},
{
"id": 7794,
"kind": "msg",
"jp": [
"「ううん、人を殺したくなる",
"理由になりそうな話なんて、",
"どこからも出てこなかったよ」"
]
},
{
"id": 7795,
"kind": "msg",
"jp": [
"「そりゃまあ、犯人には何か",
"あったんでしょうが聞かれても",
"答えねえでしょうし・・・」"
]
},
{
"id": 7796,
"kind": "msg",
"jp": [
"「心当たりがある人がいたとしても",
"他人に言えねえような内容だったら",
"やっぱ答えちゃくれねえでしょう」"
]
},
{
"id": 7797,
"kind": "msg",
"jp": [
"「だよね・・・。",
"それじゃ調べようがないから、",
"どのみちわかんないか」"
]
},
{
"id": 7798,
"kind": "msg",
"jp": [
"「しかし、人を殺そうだなんて",
"よっぽどの理由がねえと思いつかねえ",
"でしょうよ、普通なら」"
]
},
{
"id": 7799,
"kind": "msg",
"jp": [
"「それほどの大事なら、どっかで",
"断片だけでも聞くなり見るなり",
"しそうなもんですがねえ」"
]
},
{
"id": 7800,
"kind": "msg",
"jp": [
"「けど、ここには僕らしかいない",
"わけだし、誰も言わないこととか",
"知らないことは調べようがないよ」"
]
},
{
"id": 7801,
"kind": "msg",
"jp": [
"「まあ、聞こえの悪いラジオ",
"くらいしか情報源もねえですからね」"
]
},
{
"id": 7802,
"kind": "msg",
"jp": [
"「多少古いのなら書斎に雑誌も",
"ありましたが・・・」"
]
},
{
"id": 7803,
"kind": "msg",
"jp": [
"「雑誌ねぇ・・・」"
]
},
{
"id": 7804,
"kind": "msg",
"jp": [
"「間違いなくこれだろうって",
"確信まではないんだけど・・・」"
]
},
{
"id": 7805,
"kind": "msg",
"jp": [
"「なんか気になることが",
"あったんですかい?」"
]
},
{
"id": 7806,
"kind": "msg",
"jp": [
"「藍瀬みきって子のこと」"
]
},
{
"id": 7807,
"kind": "msg",
"jp": [
"「藍瀬?",
"あのアイドルの?」"
]
},
{
"id": 7808,
"kind": "msg",
"jp": [
"「なんか、帽子屋の推薦で",
"オーディション受かったとかって",
"話があっただろ」"
]
},
{
"id": 7809,
"kind": "msg",
"jp": [
"「ああ、そういや・・・」"
]
},
{
"id": 7810,
"kind": "msg",
"jp": [
"「で、なんで藍瀬さんなんです?",
"オーディションが何か関係あるん",
"ですかい?」"
]
},
{
"id": 7811,
"kind": "msg",
"jp": [
"「あ、うん。",
"落選した子が自殺してるって",
"記事を見かけたから」"
]
},
{
"id": 7812,
"kind": "msg",
"jp": [
"「その子の無念を晴らすってのが",
"復讐の動機ってことですか」"
]
},
{
"id": 7813,
"kind": "msg",
"jp": [
"「あれ、でも肝心の",
"藍瀬さんと関係ある人が",
"ここにゃいませんぜ」"
]
},
{
"id": 7814,
"kind": "msg",
"jp": [
"「なんで俺らなのかって",
"ところがわかりませんが・・・」"
]
},
{
"id": 7815,
"kind": "msg",
"jp": [
"「あ、そ、そっか」"
]
},
{
"id": 7816,
"kind": "msg",
"jp": [
"藍瀬みきちゃんが恨まれてるなら",
"本人も関係者も誰一人",
"ここにいないのって変だよな・・・。"
]
},
{
"id": 7817,
"kind": "msg",
"jp": [
"「池内梨奈さんっていう子。",
"あの、オーディションに落ちて",
"自殺しちゃったっていう・・・」"
]
},
{
"id": 7818,
"kind": "msg",
"jp": [
"「自殺、ですかい」"
]
},
{
"id": 7819,
"kind": "msg",
"jp": [
"「そのオーディションって",
"優勝者に帽子屋の推薦があったって",
"噂のある、あれですか」"
]
},
{
"id": 7820,
"kind": "msg",
"jp": [
"「うん、そう。",
"あれがなんか気になってるんだ」"
]
},
{
"id": 7821,
"kind": "msg",
"jp": [
"「・・・それを恨みに思うとしたら",
"梨奈さんの家族とか恋人とかですかね」"
]
},
{
"id": 7822,
"kind": "msg",
"jp": [
"「しかし、それで恨まれるのって",
"優勝した子とか、それを推薦したらしい",
"帽子屋とかですよね」"
]
},
{
"id": 7823,
"kind": "msg",
"jp": [
"「犯人が復讐だって言ってんのは",
"間違いなくここにいる俺らに対して",
"なんでしょうが・・・」"
]
},
{
"id": 7824,
"kind": "msg",
"jp": [
"「日織には思いつく接点ってない?」"
]
},
{
"id": 7825,
"kind": "msg",
"jp": [
"「俺ら、年代もバラバラですし",
"役者になった時期も全然別ですしね」"
]
},
{
"id": 7826,
"kind": "msg",
"jp": [
"「今までどういう仕事してたのかも",
"よく知らねえ人もいるしなあ」"
]
},
{
"id": 7827,
"kind": "msg",
"jp": [
"そう言えば、昔何をしてたとかって",
"話はあんまり聞いてないなあ。"
]
},
{
"id": 7828,
"kind": "msg",
"jp": [
"「・・・そう言えば御陵さんなんて",
"元アイドルなんだよな。",
"その頃の名前が・・・」"
]
},
{
"id": 7829,
"kind": "msg",
"jp": [
"「なんだっけ。",
"如月百合子さん?」"
]
},
{
"id": 7830,
"kind": "msg",
"jp": [
"「そりゃ現役の大女優ですぜ」"
]
},
{
"id": 7831,
"kind": "msg",
"jp": [
"「あれ? そっか」"
]
},
{
"id": 7832,
"kind": "msg",
"jp": [
"御陵さんはなんて名前だっけな。",
"忘れちゃった・・・。"
]
},
{
"id": 7833,
"kind": "msg",
"jp": [
"「確か、里江みどりさんって",
"言うんだったかな」"
]
},
{
"id": 7834,
"kind": "msg",
"jp": [
"「俺が聞き覚えねえってことは",
"かなり昔の話なんですかねえ」"
]
},
{
"id": 7835,
"kind": "msg",
"jp": [
"「うん、多分。",
"それに、売れ始めた頃突然",
"やめちゃったみたいだし」"
]
},
{
"id": 7836,
"kind": "msg",
"jp": [
"「へえ・・・?」"
]
},
{
"id": 7837,
"kind": "msg",
"jp": [
"「えーと・・・",
"絹田ユリ・・だっけ」"
]
},
{
"id": 7838,
"kind": "msg",
"jp": [
"「それ、高遠延二郎の小説に",
"出てくる女優ですぜ」"
]
},
{
"id": 7839,
"kind": "msg",
"jp": [
"「えっ? そうだっけ・・・",
"じゃあ何か間違えて覚えてるんだ」"
]
},
{
"id": 7840,
"kind": "msg",
"jp": [
"御陵さんの方はなんていう",
"名前だったかなあ・・・。"
]
},
{
"id": 7841,
"kind": "msg",
"jp": [
"「あ、ごめん。",
"なんか話がそれた」"
]
},
{
"id": 7842,
"kind": "msg",
"jp": [
"「えっと・・・",
"接点の話だったよな」"
]
},
{
"id": 7843,
"kind": "msg",
"jp": [
"「事務所だって違うわけだろ。",
"どういう必然性があって、",
"この人選だったんだろう・・・」"
]
},
{
"id": 7844,
"kind": "msg",
"jp": [
"「俺が忘れてるだけで、",
"何か関係あるんでしょうけどねえ」"
]
},
{
"id": 7845,
"kind": "msg",
"jp": [
"「撮影時期が別だっただけで、",
"実は同じ作品に出てたなんてことは",
"けっこうありますし」"
]
},
{
"id": 7846,
"kind": "msg",
"jp": [
"「そっか・・・。",
"そういうのきっちり覚えてそうな",
"人っていうと・・・」"
]
},
{
"id": 7847,
"kind": "msg",
"jp": [
"「一番芸歴が長い斑井さんか、",
"出演作がダントツで多い暗石さん",
"辺りですかねえ」"
]
},
{
"id": 7848,
"kind": "msg",
"jp": [
"「あの二人はそりが合わねえだけに",
"顔合わせた時のことは余計に",
"覚えてそうな感じでしたから」"
]
},
{
"id": 7849,
"kind": "msg",
"jp": [
"「ああ、なるほど」"
]
},
{
"id": 7850,
"kind": "msg",
"jp": [
"よりにもよって真っ先に殺されて",
"いなくなっちゃった人と、",
"部屋に閉じこもっちゃった人か・・・。"
]
},
{
"id": 7851,
"kind": "msg",
"jp": [
"「いや、もう一つだけあるよ。",
"今ここにいる全員が揃ってたことが",
"あるっていうの」"
]
},
{
"id": 7852,
"kind": "msg",
"jp": [
"「なんだっけ。",
"『虹色の愛の架け橋』?」"
]
},
{
"id": 7853,
"kind": "msg",
"jp": [
"「・・・えーと、",
"それ出てたの斑井さんだけですが」"
]
},
{
"id": 7854,
"kind": "msg",
"jp": [
"「しかも椿さんとか",
"生まれてねえと思いますぜ」"
]
},
{
"id": 7855,
"kind": "msg",
"jp": [
"「そ、そうだった。",
"それじゃなくて、なんか打ち上げの時",
"みんな来てたっていう・・・」"
]
},
{
"id": 7856,
"kind": "msg",
"jp": [
"「・・・あ、『白夜』だ!",
"暗石さんが言ってた」"
]
},
{
"id": 7857,
"kind": "msg",
"jp": [
"「全然違うじゃねえですかい」"
]
},
{
"id": 7858,
"kind": "msg",
"jp": [
"なんで虹色の方が出て",
"きちゃったんだろう・・・。"
]
},
{
"id": 7859,
"kind": "msg",
"jp": [
"「『白夜』って舞台の打ち上げに",
"ここにいる全員が揃ってたっていう話",
"暗石さんから聞いたよ」"
]
},
{
"id": 7860,
"kind": "msg",
"jp": [
"「『白夜』ですか・・・」"
]
},
{
"id": 7861,
"kind": "msg",
"jp": [
"「今回の脚本だっけ」"
]
},
{
"id": 7862,
"kind": "msg",
"jp": [
"「そりゃ・・・",
"今回送られてきた脚本ですから",
"揃ってますが・・・」"
]
},
{
"id": 7863,
"kind": "msg",
"jp": [
"「え? あ、違う!",
"今回のじゃなくて・・・」"
]
},
{
"id": 7864,
"kind": "msg",
"jp": [
"「・・・なんだっけ、ほら。",
"打ち上げの席に今いる人達が",
"みんな来てたっていう・・」"
]
},
{
"id": 7865,
"kind": "msg",
"jp": [
"「ああ、思い出した!",
"『白夜』だ!」"
]
},
{
"id": 7866,
"kind": "msg",
"jp": [
"「あぁ、『白夜』ですかい」"
]
},
{
"id": 7867,
"kind": "msg",
"jp": [
"「うん、暗石さんが",
"そう言ってた」"
]
},
{
"id": 7868,
"kind": "msg",
"jp": [
"「確かに『白夜』の打ち上げには",
"俺もいましたし、ここにいる人達も",
"ほぼ揃ってたと思いますが・・・」"
]
},
{
"id": 7869,
"kind": "msg",
"jp": [
"「四倉さんもいたんだよね」"
]
},
{
"id": 7870,
"kind": "msg",
"jp": [
"「ああ、そうですね。",
"四倉さんもいたな・・・」"
]
},
{
"id": 7871,
"kind": "msg",
"jp": [
"「けど、揃ってたからって",
"これといって誰かに恨まれるような",
"騒ぎが起きた覚えはねえですぜ?」"
]
},
{
"id": 7872,
"kind": "msg",
"jp": [
"「そうなんだよな。",
"何か騒ぎが起きてたら誰かが",
"覚えてるだろうし・・・」"
]
},
{
"id": 7873,
"kind": "msg",
"jp": [
"「暗石さんも俺らがみんな",
"来てたって事しか言ってねえんで?」"
]
},
{
"id": 7874,
"kind": "msg",
"jp": [
"「うん、その話聞いたのは",
"別のこと話しててふっと暗石さんが",
"思い出してくれたんだけど」"
]
},
{
"id": 7875,
"kind": "msg",
"jp": [
"・・・そう言えば打ち上げの時の事って",
"全員に聞いて回ったわけじゃないなあ。"
]
},
{
"id": 7876,
"kind": "msg",
"jp": [
"「いや、それが・・・",
"その打ち上げに『帽子屋』が",
"来てたかもしれないって」"
]
},
{
"id": 7877,
"kind": "msg",
"jp": [
"「帽子屋が・・・?」"
]
},
{
"id": 7878,
"kind": "msg",
"jp": [
"「ここに日織達を集めたのも",
"帽子屋を名乗る誰かだったわけだろ」"
]
},
{
"id": 7879,
"kind": "msg",
"jp": [
"「他に接点が思いつかねえだけに",
"無関係とも思えませんね」"
]
},
{
"id": 7880,
"kind": "msg",
"jp": [
"「・・・なんか想像以上に",
"いろいろ疑問が残ってる・・・」"
]
},
{
"id": 7881,
"kind": "msg",
"jp": [
"「あれから1週間しか経ってねえのに",
"この騒ぎですからねえ」"
]
},
{
"id": 7882,
"kind": "msg",
"jp": [
"「1週間かぁ・・・。",
"なんかもう1年くらい",
"閉じこめられてる気がする」"
]
},
{
"id": 7883,
"kind": "msg",
"jp": [
"「・・・いろいろありすぎましたよ」"
]
},
{
"id": 7884,
"kind": "msg",
"jp": [
"1年どころか、一生分のひどい目に",
"まとめてあったんじゃないかって",
"くらいだけど。"
]
},
{
"id": 7885,
"kind": "msg",
"jp": [
"「まあ、迎えは来れるかどうか",
"わかりませんが荷物だけは",
"まとめときましょう」"
]
},
{
"id": 7886,
"kind": "msg",
"jp": [
"「だね。",
"僕、ほとんどないけど」"
]
},
{
"id": 7887,
"kind": "msg",
"jp": [
"「忘れ物ねえか見といた方が",
"いいですぜ。",
"取りに来れるかどうか怪しいですし」"
]
},
{
"id": 7888,
"kind": "msg",
"jp": [
"「うん、部屋に戻ってみる。",
"ごちそうさま」"
]
},
{
"id": 7889,
"kind": "msg",
"jp": [
"「はい、俺は書斎にいますんで」"
]
},
{
"id": 7890,
"kind": "msg",
"jp": [
"（部屋に戻って、もう一度だけ",
"頭の整理しておこうかな・・・）"
]
},
{
"id": 7891,
"kind": "msg",
"jp": [
"わかんないことあるし、ダメかも",
"しれないけど気になるしなぁ。"
]
},
{
"id": 7892,
"kind": "msg",
"jp": [
"1週間もいたから、なんとなく",
"馴染んじゃったけど・・・。"
]
},
{
"id": 7893,
"kind": "msg",
"jp": [
"（・・・1週間・・・）"
]
},
{
"id": 7894,
"kind": "msg",
"jp": [
"本当だったら、迎えが来て",
"みんな帰れるはずの日だ。"
]
},
{
"id": 7895,
"kind": "msg",
"jp": [
"犯人は、何を考えてるだろう。",
"このまま、僕らを帰してもいいと",
"思ってるだろうか。"
]
},
{
"id": 7896,
"kind": "msg",
"jp": [
"（・・・思わないよな、普通）"
]
},
{
"id": 7897,
"kind": "msg",
"jp": [
"だったら・・・。"
]
},
{
"id": 7898,
"kind": "msg",
"jp": [
"こんなことを始めた人が誰なのか",
"自分で見つけ出すしかないのか。"
]
},
{
"id": 7899,
"kind": "msg",
"jp": [
"もう、終わりにして下さいって、",
"止めるために・・・。"
]
},
{
"id": 7900,
"kind": "msg",
"jp": [
"「・・・ダメか」"
]
},
{
"id": 7901,
"kind": "msg",
"jp": [
"どうしても、犯人はこの人だと",
"断定出来ない・・・。"
]
},
{
"id": 7902,
"kind": "msg",
"jp": [
"（断定したとしても、",
"あってるかどうか自信ないし・・・）"
]
},
{
"id": 7903,
"kind": "msg",
"jp": [
"・・・正直言って、あなたが犯人だ",
"なんて言うの怖いし。"
]
},
{
"id": 7904,
"kind": "msg",
"jp": [
"やっぱり、僕にはこんなこと",
"向いてないんだ・・・。"
]
},
{
"id": 7905,
"kind": "msg",
"jp": [
"（大人しく、どうにか助けが",
"来るのを待つしかないか・・・）"
]
},
{
"id": 7906,
