[
{
"id": 19817,
"kind": "msg",
"jp": [
"「あ、そうなの?",
"ごめん・・・」"
]
},
{
"id": 19818,
"kind": "msg",
"jp": [
"「知らん、読んでへん」"
]
},
{
"id": 19819,
"kind": "msg",
"jp": [
"「どんなのかな、と思って・・・」"
]
},
{
"id": 19820,
"kind": "msg",
"jp": [
"「そんなんうちに聞かれても」"
]
},
{
"id": 19821,
"kind": "msg",
"jp": [
"そりゃそうだな・・・。"
]
},
{
"id": 19822,
"kind": "msg",
"jp": [
"「・・・そんなん",
"うちに聞かれてもわからん」"
]
},
{
"id": 19823,
"kind": "msg",
"jp": [
"「もう・・・",
"あれ以上話すことなんかないってば」"
]
},
{
"id": 19824,
"kind": "msg",
"jp": [
"「・・・覚えてへん。",
"見取り図でも探して調べて」"
]
},
{
"id": 19825,
"kind": "msg",
"jp": [
"ぷい、と顔を背けられてしまった。"
]
},
{
"id": 19826,
"kind": "msg",
"jp": [
"「・・・当たり前やん」"
]
},
{
"id": 19827,
"kind": "msg",
"jp": [
"「・・・好かん」"
]
},
{
"id": 19828,
"kind": "msg",
"jp": [
"「・・・聞いた事ある",
"気がするけどわからん」"
]
},
{
"id": 19829,
"kind": "msg",
"jp": [
"「あるわけないやん」"
]
},
{
"id": 19830,
"kind": "msg",
"jp": [
"・・・そっけなかった。"
]
},
{
"id": 19831,
"kind": "msg",
"jp": [
"「・・・お姉ちゃんが",
"どうかした?」"
]
},
{
"id": 19832,
"kind": "msg",
"jp": [
"「え、いや、別に」"
]
},
{
"id": 19833,
"kind": "msg",
"jp": [
"「コナかけんように」"
]
},
{
"id": 19834,
"kind": "msg",
"jp": [
"「そうや、お兄さん。",
"夕べ、うちが狙われてるて",
"言うてたけどさあ」"
]
},
{
"id": 19835,
"kind": "msg",
"jp": [
"「・・・なんか違わへん?",
"うち、なんともなかったし」"
]
},
{
"id": 19836,
"kind": "msg",
"jp": [
"「いや別に、謝らんでええねんけど",
"もし何か勘違いしてんねやったら、",
"早めに修正した方がええんちゃう?」"
]
},
{
"id": 19837,
"kind": "msg",
"jp": [
"「ああ、そうや。",
"あのさぁ、お兄さん」"
]
},
{
"id": 19838,
"kind": "msg",
"jp": [
"「夕べうちが危ないとか",
"言うてたやん?」"
]
},
{
"id": 19839,
"kind": "msg",
"jp": [
"「あれって犯人に",
"気付かれたりしてへん?」"
]
},
{
"id": 19840,
"kind": "msg",
"jp": [
"「は、犯人に?」"
]
},
{
"id": 19841,
"kind": "msg",
"jp": [
"「だって狙われてたわりには",
"あんまりにも何も起こらなさ",
"すぎやない?」"
]
},
{
"id": 19842,
"kind": "msg",
"jp": [
"「警戒してるん犯人が気付いて",
"計画変えたとか違う?」"
]
},
{
"id": 19843,
"kind": "msg",
"jp": [
"「え、そ、それは・・・」"
]
},
{
"id": 19844,
"kind": "msg",
"jp": [
"「なんとなく、",
"あんまり危ない危ない騒いだら",
"よけい危ない気がするわ」"
]
},
{
"id": 19845,
"kind": "msg",
"jp": [
"「・・・よかった。",
"わりと普通やね」"
]
},
{
"id": 19846,
"kind": "msg",
"jp": [
"「なんかもっと落ち込んでる",
"かと思とったんやけど」"
]
},
{
"id": 19847,
"kind": "msg",
"jp": [
"「僕が?」"
]
},
{
"id": 19848,
"kind": "msg",
"jp": [
"「だって夕べもうちのこと",
"危ないとか言うててさ」"
]
},
{
"id": 19849,
"kind": "msg",
"jp": [
"「あ、えっと・・・」"
]
},
{
"id": 19850,
"kind": "msg",
"jp": [
"「・・・うちが狙われてる",
"言うのんやっぱりお兄さんの",
"気のせいなん違うかなぁ」"
]
},
{
"id": 19851,
"kind": "msg",
"jp": [
"「なんかこう、そういう",
"危険そうな気配すらないんよ。",
"やっぱ違うんやない?」"
]
},
{
"id": 19852,
"kind": "msg",
"jp": [
"「う、うん・・・。",
"そう、なのかも・・・」"
]
},
{
"id": 19853,
"kind": "msg",
"jp": [
"僕の考え違いなのかな。",
"鈴奈ちゃんが危ないと思ったん",
"だけどな・・・。"
]
},
{
"id": 19854,
"kind": "msg",
"jp": [
"「あー、そうや。",
"お兄さんまたうちが危ない",
"とか言うてたけどさぁ」"
]
},
{
"id": 19855,
"kind": "msg",
"jp": [
"「ほんまにちゃんと考えてる?",
"まともに推理して出た結論とは",
"思えんくなってんねんけど」"
]
},
{
"id": 19856,
"kind": "msg",
"jp": [
"「うちに謝ったって",
"しゃあないやん。",
"うちは何ともなってへんのに」"
]
},
{
"id": 19857,
"kind": "msg",
"jp": [
"一応ちゃんと考えたんだけど。",
"やっぱり何か勘違いしてるのかな。"
]
},
{
"id": 19858,
"kind": "msg",
"jp": [
"「・・・あぁ、ほんでな、",
"夕べもうちが危なかったとか",
"言うてたけどさ」"
]
},
{
"id": 19859,
"kind": "msg",
"jp": [
"「お兄さんちょっと",
"なんていうか・・・」"
]
},
{
"id": 19860,
"kind": "msg",
"jp": [
"なんか心配されてる・・・。"
]
},
{
"id": 19861,
"kind": "msg",
"jp": [
"「・・・そや、",
"お兄さんちょっと休みや」"
]
},
{
"id": 19862,
"kind": "msg",
"jp": [
"「夕べもまたうちが危ないとか",
"言うてたやんか。",
"ちょっと神経参ってるんやろ」"
]
},
{
"id": 19863,
"kind": "msg",
"jp": [
"「・・・い、いや、あの」"
]
},
{
"id": 19864,
"kind": "msg",
"jp": [
"「ええから休みって。",
"もういらんこと考えん方がええよ」"
]
},
{
"id": 19865,
"kind": "msg",
"jp": [
"怒るとか呆れるとかじゃなくて",
"同情されてるらしい・・・。"
]
},
{
