]
},
{
"id": 19875,
"kind": "msg",
"jp": [
"「えっと、椿・・・くん?」"
]
},
{
"id": 19876,
"kind": "msg",
"jp": [
"「あ?",
"・・・いや、はい、なんでしょう」"
]
},
{
"id": 19877,
"kind": "msg",
"jp": [
"ぼーっと考え事をしていたらしい",
"椿くんは慌てて険しい表情を作り",
"堅い口調で答える。"
]
},
{
"id": 19878,
"kind": "msg",
"jp": [
"「僕は役者じゃないんだから",
"普通に話してくれていいのに」"
]
},
{
"id": 19879,
"kind": "msg",
"jp": [
"「・・・撮影が終わるまでは",
"私は執事ですので」"
]
},
{
"id": 19880,
"kind": "msg",
"jp": [
"「素に戻っちゃうと",
"やりにくくなるものなの?」"
]
},
{
"id": 19881,
"kind": "msg",
"jp": [
"「人それぞれでしょうが、",
"私はいちいち思考を切り替えたく",
"ないものですから」"
]
},
{
"id": 19882,
"kind": "msg",
"jp": [
"「ふぅん・・・?",
"じゃあ他の仕事のときもずっと",
"役柄のまんまでいるんだ?」"
]
},
{
"id": 19883,
"kind": "msg",
"jp": [
"「・・・ええ、まあ」"
]
},
{
"id": 19884,
"kind": "msg",
"jp": [
"「普段はここまで極端な役は",
"あまり来ませんが・・・」"
]
},
{
"id": 19885,
"kind": "msg",
"jp": [
"そう言って少し疲れたように",
"ため息をつく。"
]
},
{
"id": 19886,
"kind": "msg",
"jp": [
"やっぱり堅苦しい口調をずっと",
"続けるのは辛いのかな。"
]
},
{
"id": 19887,
"kind": "msg",
"jp": [
"「いつもは、",
"どういう役が多いの?」"
]
},
{
"id": 19888,
"kind": "msg",
"jp": [
"「・・・どんな役だと思われますか?」"
]
},
{
"id": 19889,
"kind": "msg",
"jp": [
"「え? えっと、そうだね・・・」"
]
},
{
"id": 19890,
"kind": "msg",
"jp": [
"「不良っぽい高校生とか・・・」"
]
},
{
"id": 19891,
"kind": "msg",
"jp": [
"「ははっ、当たりだよ」"
]
},
{
"id": 19892,
"kind": "msg",
"jp": [
"思わず吹きだしながら、",
"椿くんが笑顔を垣間見せた。"
]
},
{
"id": 19893,
"kind": "msg",
"jp": [
"「まあ、年が年だから学生は",
"しょーがねえけど、来る役来る役",
"不良なんだよなあ」"
]
},
{
"id": 19894,
"kind": "msg",
"jp": [
"「・・・いえ、今は執事ですが」"
]
},
{
"id": 19895,
"kind": "msg",
"jp": [
"「あはは・・・」"
]
},
{
"id": 19896,
"kind": "msg",
"jp": [
"でも、どう考えても学生の方が",
"似合ってるよなあ。"
]
},
{
"id": 19897,
"kind": "msg",
"jp": [
"「生徒会長、とか?」"
]
},
{
"id": 19898,
"kind": "msg",
"jp": [
"「違った?」"
]
},
{
"id": 19899,
"kind": "msg",
"jp": [
"「そ、そんな風に見えるか?",
"違うどころか正反対だぞ、",
"オレ普段、不良役ばっかなのに」"
]
},
{
"id": 19900,
"kind": "msg",
"jp": [
"「あ、多分、今の格好とか",
"喋り方のせいでそういう印象に",
"なってるのかもしれないけど」"
]
},
{
"id": 19901,
"kind": "msg",
"jp": [
"「て、ことはオレ、",
"けっこうイケてんのか」"
]
},
{
"id": 19902,
"kind": "msg",
"jp": [
"「そういうイメージに",
"なってるってことは執事役も",
"なんとかなりそうじゃん」"
]
},
{
"id": 19903,
"kind": "msg",
"jp": [
"「すっげー似合わねーし、",
"マジでどうしようかと思ってたんだよ」"
]
},
{
"id": 19904,
"kind": "msg",
"jp": [
"「おう、ちょっと自信ついたぜ。",
"サンキュな」"
]
},
{
"id": 19905,
"kind": "msg",
"jp": [
"「・・・っと、",
"ありがとうございます、だな」"
]
},
{
"id": 19906,
"kind": "msg",
"jp": [
"改めて言い直して、椿くんは",
"いたずらっぽく笑った。"
]
},
{
"id": 19907,
"kind": "msg",
"jp": [
"「・・・王子様・・・とか」"
]
},
{
"id": 19908,
"kind": "msg",
"jp": [
"「どこの国のだよっ!?」"
]
},
{
"id": 19909,
"kind": "msg",
"jp": [
"「だ、だって、僕・・・",
"芝居とかあんまり知らないから」"
]
},
{
"id": 19910,
"kind": "msg",
"jp": [
"「そういう問題なのか?",
"つーか、執事よりあり得ねーだろ",
"どんな王子だ、オレ」"
]
},
{
"id": 19911,
"kind": "msg",
"jp": [
"「・・・お城抜け出して",
"街中で暴れてそうな・・・」"
]
},
{
"id": 19912,
"kind": "msg",
"jp": [
"「それはな、日本ではどっちかつーと",
"王子じゃなくて将軍のやることだ」"
]
},
{
"id": 19913,
"kind": "msg",
"jp": [
"「お奉行さまもやってるよ」"
]
},
{
"id": 19914,
"kind": "msg",
"jp": [
"「どっちにしろ王子じゃ",
"ねーだろ」"
]
},
{
"id": 19915,
"kind": "msg",
"jp": [
"「・・・まあ、今の私は",
"執事ですので関係ございませんが」"
]
},
{
"id": 19916,
"kind": "msg",
"jp": [
"「・・・ところで一柳さま」"
]
},
{
"id": 19917,
"kind": "msg",
"jp": [
"「ご用件は?",
"何か用がおありだったのでは",
"ないのですか」"
]
},
{
"id": 19918,
"kind": "msg",
"jp": [
"「別に用事はないんだけど」"
]
},
{
"id": 19919,
"kind": "msg",
"jp": [
"「なんだそりゃ?",
"・・・あー、いや」"
]
},
{
"id": 19920,
"kind": "msg",
"jp": [
"「用がないなら大人しく",
"しやがって下さい」"
]
},
{
"id": 19921,
"kind": "msg",
"jp": [
"「あの、それなんか",
"日本語おかしい・・・」"
]
},
{
"id": 19922,
"kind": "msg",
"jp": [
"「お前が話し掛けるからだっ!",
"あー、もー、やっと慣れてきてたのに」"
]
},
{
"id": 19923,
"kind": "msg",
"jp": [
"「用ってわけじゃなかったんだ。",
"ちょっと話してみたかっただけで」"
]
},
{
"id": 19924,
"kind": "msg",
"jp": [
"「一番年が近そうだったから」"
]
},
{
"id": 19925,
"kind": "msg",
"jp": [
"「おいくつですか、一柳さま」"
]
},
{
"id": 19926,
"kind": "msg",
"jp": [
"「僕は21だよ。",
"椿くんは?」"
]
},
{
"id": 19927,
"kind": "msg",
"jp": [
"「18です。",
"まあ、確かに近いですが・・・」"
]
},
{
"id": 19928,
"kind": "msg",
"jp": [
"「・・・寂しがりか、お前」"
]
},
{
"id": 19929,
"kind": "msg",
"jp": [
"「わ、わりと」"
]
},
{
"id": 19930,
"kind": "msg",
"jp": [
"「変な奴・・・」"
]
},
{
"id": 19931,
"kind": "msg",
"jp": [
"ちょっと不審がられたかも・・・。"
]
},
{
"id": 19932,
"kind": "msg",
"jp": [
"「ちゃんと挨拶しとこうと思って」"
]
},
{
"id": 19933,
"kind": "msg",
"jp": [
"「挨拶?」"
]
},
{
"id": 19934,
"kind": "msg",
"jp": [
"「さっきはなんだか",
"なし崩しに泊めてもらえることに",
"なったからさ」"
]
},
{
"id": 19935,
"kind": "msg",
"jp": [
"「ふぅん?",
"得体の知れない登場の仕方",
"だったわりにマトモな奴だな、お前」"
]
},
{
"id": 19936,
"kind": "msg",
"jp": [
"「いえいえ、お気になさらず。",
"常識的な方とわかって安心しました」"
]
},
{
"id": 19937,
"kind": "msg",
"jp": [
"「そう? よかった」"
]
},
{
"id": 19938,
"kind": "msg",
"jp": [
"「あ、そうだ。",
"ついでにひとつ聞いてもいい?」"
]
},
{
"id": 19939,
"kind": "msg",
"jp": [
"「この館って個人の別荘か何か",
"らしいって聞いたんだけどさ」"
]
},
{
"id": 19940,
"kind": "msg",
"jp": [
"「さようでございますが」"
]
},
{
"id": 19941,
"kind": "msg",
"jp": [
"「ずいぶん不便なところに",
"建ってるよね。",
"周りに何もなさそうだし」"
]
},
{
"id": 19942,
"kind": "msg",
"jp": [
"「別荘なんてそんなもんだろ。",
"・・・あ、いや、ものでしょう」"
]
},
{
"id": 19943,
"kind": "msg",
"jp": [
"「そうかもね。",
"でも、広いし古いし、夜一人に",
"なったらちょっと怖そう・・・」"
]
},
{
"id": 19944,
"kind": "msg",
"jp": [
"「・・・そう言えば、夜1人で",
"館の中を歩くと誰かが付いてくるような",
"気配がするとか・・・」"
]
},
{
"id": 19945,
"kind": "msg",
"jp": [
"「ほ、本当にっ!?",
"出るの? なんか出るの!?」"
]
},
{
"id": 19946,
"kind": "msg",
"jp": [
"「冗談です」"
]
},
{
"id": 19947,
"kind": "msg",
"jp": [
"「怖がるかなと思ったけど、",
"予想以上のリアクションだなぁ」"
]
},
{
"id": 19948,
"kind": "msg",
"jp": [
"「・・・君ちょっと",
"性格悪いね・・・」"
]
},
{
"id": 19949,
"kind": "msg",
"jp": [
"「ひでーな、おちゃめな",
"冗談じゃねーかよ」"
]
},
{
"id": 19950,
"kind": "msg",
"jp": [
"「だって苦手なんだもん",
"怖い話・・・」"
]
},
{
"id": 19951,
"kind": "msg",
"jp": [
"「あーもー、悪かったよ。",
"んなに怖がると思わなかったんだって」"
]
},
{
"id": 19952,
"kind": "msg",
"jp": [
"「やっぱり役者さんだよね。",
"思いっきり本気にしちゃったよ」"
]
},
{
"id": 19953,
"kind": "msg",
"jp": [
"「そ、そうかぁ?",
"お前が人一倍怖がりなだけだろ」"
]
},
{
"id": 19954,
"kind": "msg",
"jp": [
"「それもあるだろうけど、",
"顔色ひとつ変えずに言うんだもん」"
]
},
