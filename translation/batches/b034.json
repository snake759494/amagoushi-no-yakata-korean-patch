]
},
{
"id": 18300,
"kind": "msg",
"jp": [
"「え、あの、内容って」"
]
},
{
"id": 18301,
"kind": "msg",
"jp": [
"「あらすじでは鈴奈が死んだことに",
"なってるけど、実は犯人が鈴奈で",
"死んでるのが静奈ってオチ」"
]
},
{
"id": 18302,
"kind": "msg",
"jp": [
"「・・・・え」"
]
},
{
"id": 18303,
"kind": "msg",
"jp": [
"「せやから、うちは危ないとしたら",
"お姉ちゃんの方やと思うねんけど」"
]
},
{
"id": 18304,
"kind": "msg",
"jp": [
"「静奈ちゃんに危険は無いと思うよ。",
"危ないのは鈴奈ちゃんの方で」"
]
},
{
"id": 18305,
"kind": "msg",
"jp": [
"「・・・そうなん?」"
]
},
{
"id": 18306,
"kind": "msg",
"jp": [
"「けど、この話のオチって",
"実は死んでたのは姉の静奈の方",
"でした、やんか?」"
]
},
{
"id": 18307,
"kind": "msg",
"jp": [
"「双子の入れ替わりってやつ。",
"それでもうちのが危ないん?",
"お姉ちゃんやなくて?」"
]
},
{
"id": 18308,
"kind": "msg",
"jp": [
"「そ・・そういう話だったら、",
"静奈ちゃんの方が危ないかも・・・」"
]
},
{
"id": 18309,
"kind": "msg",
"jp": [
"「そやろ?",
"やったらうちと話してる場合と",
"違うって」"
]
},
{
"id": 18310,
"kind": "msg",
"jp": [
"「え、あ、ああ、そうか」"
]
},
{
"id": 18311,
"kind": "msg",
"jp": [
"「・・・ごめん。",
"ちょっともう一回頭整理してくる」"
]
},
{
"id": 18312,
"kind": "msg",
"jp": [
"・・・参ったな。",
"考え直さなきゃ・・・。"
]
},
{
"id": 18313,
"kind": "msg",
"jp": [
"「・・・いや、それでも",
"今日は鈴奈ちゃんのが危ないと思う」"
]
},
{
"id": 18314,
"kind": "msg",
"jp": [
"「呼ばれてる以上は二人とも",
"危ないんじゃないかな」"
]
},
{
"id": 18315,
"kind": "msg",
"jp": [
"「・・・そっか。",
"それやったら先に死んでたと",
"思われてた鈴奈が先か」"
]
},
{
"id": 18316,
"kind": "msg",
"jp": [
"「そうなんじゃないかな」"
]
},
{
"id": 18317,
"kind": "msg",
"jp": [
"「いや、静奈ちゃんもまったく",
"危険がないわけじゃないけど」"
]
},
{
"id": 18318,
"kind": "msg",
"jp": [
"「ただ、今日狙われてるのは",
"鈴奈ちゃんの方だと思う」"
]
},
{
"id": 18319,
"kind": "msg",
"jp": [
"「うちが先、ってことか」"
]
},
{
"id": 18320,
"kind": "msg",
"jp": [
"「・・・そやな。",
"二人とも狙う気やったら順番は",
"そうなるんかも・・・」"
]
},
{
"id": 18321,
"kind": "msg",
"jp": [
"「鈴奈ちゃんもそう思う?」"
]
},
{
"id": 18322,
"kind": "msg",
"jp": [
"「原作はさ、実は死んでたんは",
"姉の静奈の方でしたってオチやから」"
]
},
{
"id": 18323,
"kind": "msg",
"jp": [
"「けど、双子どっちも狙うんなら、",
"最初は死んでるのは鈴奈の方やと",
"思われてたんやしうちが先かな」"
]
},
{
"id": 18324,
"kind": "msg",
"jp": [
"「うん、そう思う」"
]
},
{
"id": 18325,
"kind": "msg",
"jp": [
"「・・・なるほどね。",
"お姉ちゃんの推理とほぼ同じか」"
]
},
{
"id": 18326,
"kind": "msg",
"jp": [
"「うん。",
"大幅に食い違ってるようやったら、",
"信用しづらいとこやけど・・・」"
]
},
{
"id": 18327,
"kind": "msg",
"jp": [
"「考え方の方向としては、一緒やね。",
"ただ、なあ・・・」"
]
},
{
"id": 18328,
"kind": "msg",
"jp": [
"「ただ・・?",
"どこか変なところあった?」"
]
},
{
"id": 18329,
"kind": "msg",
"jp": [
"「いや・・・」"
]
},
{
"id": 18330,
"kind": "msg",
"jp": [
"「なんか引っかかるなら言ってよ。",
"間違ってたら他の人が死んじゃうかも",
"しれないわけだし・・・」"
]
},
{
"id": 18331,
"kind": "msg",
"jp": [
"「・・・1人で考えて駄目でも",
"何人かで意見出し合ったら",
"なんとかなるかもしれない」"
]
},
{
"id": 18332,
"kind": "msg",
"jp": [
"なぜかふと妙な顔つきになり",
"鈴奈ちゃんは首を傾げた。"
]
},
{
"id": 18333,
"kind": "msg",
"jp": [
"「お兄さんさあ・・・」"
]
},
{
"id": 18334,
"kind": "msg",
"jp": [
"「変な人やね」"
]
},
{
"id": 18335,
"kind": "msg",
"jp": [
"「だってさ、お兄さんて元はと",
"言えば単なる迷子で何も関係",
"あらへん人やんか」"
]
},
{
"id": 18336,
"kind": "msg",
"jp": [
"「そない必死にならんでもそれこそ",
"部屋に閉じこもってたら助かりそうな",
"もんやのに・・・」"
]
},
{
"id": 18337,
"kind": "msg",
"jp": [
"「え、でも、それじゃ",
"朝起きるたびに誰か死んでるし」"
]
},
{
"id": 18338,
"kind": "msg",
"jp": [
"「自分は無事やん。",
"関係ないねんから」"
]
},
{
"id": 18339,
"kind": "msg",
"jp": [
"「・・・そんなの怖いから嫌だ」"
]
},
{
"id": 18340,
"kind": "msg",
"jp": [
"「どんだけヘタレやねん、アンタ!?」"
]
},
{
"id": 18341,
"kind": "msg",
"jp": [
"「だって怖いじゃないか!",
"人が殺されるんだよ!?」"
]
},
{
"id": 18342,
"kind": "msg",
"jp": [
"「お兄さんの怖いの基準が",
"よぉわからんわ・・・」"
]
},
{
"id": 18343,
"kind": "msg",
"jp": [
"「自分が危ないことするより",
"他人が死ぬの怖いんかいな」"
]
},
{
"id": 18344,
"kind": "msg",
"jp": [
"「いや、どっちも怖いけど」"
]
},
{
"id": 18345,
"kind": "msg",
"jp": [
"「なんかもう呆れるん通り越して",
"どっか突き抜けるわ」"
]
},
{
"id": 18346,
"kind": "msg",
"jp": [
"「そうかな・・・?」"
]
},
{
"id": 18347,
"kind": "msg",
"jp": [
"「・・・僕1人だけ",
"助かっても嬉しくないよ・・・」"
]
},
{
"id": 18348,
"kind": "msg",
"jp": [
"「だって一生忘れられそうに",
"ないだろ、こんなの」"
]
},
{
"id": 18349,
"kind": "msg",
"jp": [
"「犯人が許せないとか、そんな",
"格好いい話じゃ全然ないから",
"呆れるかもしれないけど・・・」"
]
},
{
"id": 18350,
"kind": "msg",
"jp": [
"「今、部屋に閉じこもって何も",
"見ないようにしてやり過ごして",
"それで助かったとしてもさ」"
]
},
{
"id": 18351,
"kind": "msg",
"jp": [
"「・・・その後はずっと、",
"もっと辛いような気がする」"
]
},
{
"id": 18352,
"kind": "msg",
"jp": [
"「・・・まあ、",
"盛大なトラウマにはなるやろね」"
]
},
{
"id": 18353,
"kind": "msg",
"jp": [
"「それやったら、残りの人生で",
"背負い込む重荷は一つでも減らしとけ",
"言うことやね」"
]
},
{
"id": 18354,
"kind": "msg",
"jp": [
"「・・・そう、だね。",
"情けないけど・・・」"
]
},
{
"id": 18355,
"kind": "msg",
"jp": [
"「ええやん」"
]
},
{
"id": 18356,
"kind": "msg",
"jp": [
"「生きて帰れた後のこと",
"考えられるだけ、",
"まだポジティブやんか」"
]
},
{
"id": 18357,
"kind": "msg",
"jp": [
"「ポジティブ・・・?」"
]
},
{
"id": 18358,
"kind": "msg",
"jp": [
"「とりあえず明日の朝まだ",
"生きてるかどうかしか",
"興味なくなってるうちらよりは」"
]
},
{
"id": 18359,
"kind": "msg",
"jp": [
"「・・・生きて帰った後かぁ」"
]
},
{
"id": 18360,
"kind": "msg",
"jp": [
"「そんなこと、考えるんも",
"忘れてたわ・・・」"
]
},
{
"id": 18361,
"kind": "msg",
"jp": [
"「・・・ちょっと」"
]
},
{
"id": 18362,
"kind": "msg",
"jp": [
"「泣かんといてや」"
]
},
{
"id": 18363,
"kind": "msg",
"jp": [
"「え、な、泣いてないよ!?」"
]
},
{
"id": 18364,
"kind": "msg",
"jp": [
"「今、泣き出す寸前みたいな",
"顔してたで」"
]
},
{
"id": 18365,
"kind": "msg",
"jp": [
"「・・・泣いてないよ」"
]
},
{
"id": 18366,
"kind": "msg",
"jp": [
"「まだ」"
]
},
{
"id": 18367,
"kind": "msg",
"jp": [
"「まだって何!?」"
]
},
{
"id": 18368,
"kind": "msg",
"jp": [
"「ま、まだ大丈夫だから!",
"だから、そんな・・・・」"
]
},
{
"id": 18369,
"kind": "msg",
"jp": [
"「・・・もう、帰れないみたいなこと",
"言わないで・・・なんとかしようよ」"
]
},
{
"id": 18370,
"kind": "msg",
"jp": [
"「・・・あー、もう・・・」"
]
},
{
"id": 18371,
"kind": "msg",
"jp": [
"「かなわんわ・・・」"
]
},
{
"id": 18372,
"kind": "msg",
"jp": [
"「何もしないでいて",
"気が付いたら僕が犯人に",
"されてたら嫌だし」"
]
},
{
"id": 18373,
"kind": "msg",
"jp": [
"「なんやそれっ!?」"
]
},
{
"id": 18374,
"kind": "msg",
"jp": [
"「だ、だって、僕だけ全然関係ないって",
"ことは一番怪しまれそうじゃないか!」"
]
},
{
"id": 18375,
"kind": "msg",
"jp": [
"「そ・・そらまあ・・・",
"自分が犯人の行動阻止して回ってりゃ",
"疑われんやろうけど・・・」"
]
},
{
"id": 18376,
"kind": "msg",
"jp": [
"「・・・けど、お兄さん。",
"それ思ってても口に出して",
"宣言せん方がええと思うわ・・・」"
]
},
{
"id": 18377,
"kind": "msg",
"jp": [
"さすがに本音過ぎた、かな・・・。"
]
},
{
"id": 18378,
"kind": "msg",
"jp": [
"「信用しとくわ」"
]
},
{
"id": 18379,
"kind": "msg",
"jp": [
"「真面目に心配して言うて",
"くれてんのは確かみたいやしね」"
]
},
{
"id": 18380,
"kind": "msg",
"jp": [
"「う、うん、そりゃあ・・・」"
]
},
{
"id": 18381,
"kind": "msg",
"jp": [
"「・・・・やから」"
]
},
{
"id": 18382,
"kind": "msg",
"jp": [
"「信用するから言うんやけど、",
"どっちがより危ないか言うたら",
"お姉ちゃんの方やと思うで」"
]
},
{
"id": 18383,
"kind": "msg",
"jp": [
"「え・・・?",
"それは、なんで・・・」"
]
},
{
"id": 18384,
"kind": "msg",
"jp": [
"「・・・お兄さん馬鹿正直やし",
"約束は守ってくれるやんな」"
]
},
{
"id": 18385,
"kind": "msg",
"jp": [
"「約束?」"
]
},
{
"id": 18386,
"kind": "msg",
"jp": [
"「守るの? 守らんの?」"
]
},
{
"id": 18387,
"kind": "msg",
"jp": [
"「ま、守る守る」"
]
},
{
"id": 18388,
"kind": "msg",
"jp": [
"「ほな・・・",
"絶対ここだけの話にしてや?」"
]
},
{
"id": 18389,
"kind": "msg",
"jp": [
"「たとえ着流しのお兄さんにでも",
"言うの禁止やからね」"
]
},
{
"id": 18390,
"kind": "msg",
"jp": [
"「お兄さんやお姉ちゃんの言う通り",
"『悪魔の花園』の見立てやとしたら、",
"ほんまに危ないんはお姉ちゃんだけや」"
]
},
{
"id": 18391,
"kind": "msg",
"jp": [
"「どういう意味・・・?」"
]
},
{
"id": 18392,
"kind": "msg",
"jp": [
"「・・・{僕/・}{は/・}{妹/・}{や/・}{な/・}{い/・}から」"
]
},
{
"id": 18393,
"kind": "msg",
"jp": [
"「{男/・}やから。",
"・・・{弟/・}やねん、{僕/・}」"
]
},
{
"id": 18394,
"kind": "msg",
"jp": [
"「ええええええええええ!?」"
]
},
{
"id": 18395,
"kind": "msg",
"jp": [
"「でかい声だすなっ!",
"言うなよ、絶対言うなよ!?」"
]
},
{
"id": 18396,
"kind": "msg",
"jp": [
"「え、あの、え?",
"お、おと・・・おとうと?」"
]
},
{
"id": 18397,
"kind": "msg",
"jp": [
"「だ、だって、その、あの、",
"服・・とか、それ・・・」"
]
},
{
"id": 18398,
"kind": "msg",
"jp": [
"「好きで着てるんちゃうわ。",
"趣味ちゃうからな?",
"それだけは言うとくぞ?」"
]
},
{
"id": 18399,
"kind": "msg",
"jp": [
"「う、うんうんうん」"
]
},
{
"id": 18400,
"kind": "msg",
"jp": [
"とりあえず頷いておかないと",
"絞め殺されそうだった・・・。"
]
},
{
"id": 18401,
"kind": "msg",
"jp": [
"「お姉ちゃんの影武者やねん、僕。",
"世間的には『峰塚あやめ』って女優は",
"1人ってことになってるけど・・・」"
]
},
{
"id": 18402,
"kind": "msg",
"jp": [
"「・・・実際は僕とお姉ちゃんの",
"2人で一役やってんねん」"
]
},
{
"id": 18403,
"kind": "msg",
"jp": [
"「なんでそんな事に・・・?」"
]
},
{
"id": 18404,
"kind": "msg",
"jp": [
"「最初はお姉ちゃんが風邪引いて",
"撮影行けんようになった時、",
"僕が代わりに行ったんがきっかけ」"
]
},
{
"id": 18405,
"kind": "msg",
"jp": [
"「それが見事にまるっきりバレへん",
"かったもんやから、うちの事務所の",
"社長が面白がってもうて・・・」"
]
},
{
"id": 18406,
"kind": "msg",
"jp": [
"「続けることになっちゃったの?」"
]
},
{
"id": 18407,
"kind": "msg",
"jp": [
"「うん・・・。",
"最初はすぐ種明かししてネタにする",
"とか言うてたんやけどなあ・・・」"
]
},
{
"id": 18408,
"kind": "msg",
"jp": [
"「お姉ちゃんも面白がってるし、",
"僕も芝居は好きやからええねんけど」"
]
},
{
"id": 18409,
"kind": "msg",
"jp": [
"「・・・さすがにもう2年くらい",
"やってるから、そこそこ知ってる人は",
"知ってる話になってきたけどな」"
]
},
{
"id": 18410,
"kind": "msg",
"jp": [
"「あ・・・",
"じゃあ、今回のこの館への",
"招待は・・・」"
]
},
{
"id": 18411,
"kind": "msg",
"jp": [
"「そらびっくりしたよ。",
"なんせちゃんと『峰塚あやめ』宛に",
"2通招待状来たんやもん」"
]
},
{
"id": 18412,
"kind": "msg",
"jp": [
"「2通・・・そうなんだ・・・」"
]
},
{
"id": 18413,
"kind": "msg",
"jp": [
"「でも、それなら鈴奈ちゃ・・・",
"いや・・鈴奈、くん?」"
]
},
{
"id": 18414,
"kind": "msg",
"jp": [
"「とりあえず人前では",
"ちゃん付けにしといて。",
"でないとバレる」"
]
},
{
"id": 18415,
"kind": "msg",
"jp": [
"「あ、うん。",
"でもさ、招待状がちゃんと2通",
"来たって事はやっぱり・・・」"
]
},
{
"id": 18416,
"kind": "msg",
"jp": [
"「・・・静奈ちゃんだけが",
"狙われてるわけじゃないんじゃない?」"
]
},
{
"id": 18417,
"kind": "msg",
"jp": [
"「僕もやばい?」"
]
},
{
"id": 18418,
"kind": "msg",
"jp": [
"「うん、だって2人いるって",
"犯人の方は知ってるわけだろ」"
]
},
{
"id": 18419,
"kind": "msg",
"jp": [
"「男でも関係ないかな」"
]
},
{
"id": 18420,
"kind": "msg",
"jp": [
"「それは、2人いるって知ってる",
"人なら誰でも知ってる話なの?」"
]
},
{
"id": 18421,
"kind": "msg",
"jp": [
"「いや・・そうか・・・。",
"そこまで知ってるのは社長とか",
"事務所の内部だけ、かな・・・」"
]
},
{
"id": 18422,
"kind": "msg",
"jp": [
"「だったら、さすがに犯人も",
"知らないんじゃないかな」"
]
},
{
"id": 18423,
"kind": "msg",
"jp": [
"「・・・そっか。",
"そうやな・・・・」"
]
},
{
"id": 18424,
"kind": "msg",
"jp": [
"「うん、わかった。",
"お兄さんの言うこと聞いとくわ」"
]
},
{
"id": 18425,
"kind": "msg",
"jp": [
"「なんでそっちが礼言うかなぁ、",
"ほんま、調子狂うわ・・・」"
]
},
{
"id": 18426,
"kind": "msg",
"jp": [
"「けど、とりあえず今晩は",
"警戒して起きとくとして、",
"他にすることある?」"
]
},
{
"id": 18427,
"kind": "msg",
"jp": [
"「いや、鈴奈ちゃん達はいいよ、",
"下手に動き回ると危険だし」"
]
},
{
"id": 18428,
"kind": "msg",
"jp": [
"「うーん、そうやね・・。",
"待つだけってのもストレスたまるけど",
"お兄さんがそない言うんやったら」"
]
},
{
"id": 18429,
"kind": "msg",
"jp": [
"「見立てに使われそうな物は",
"僕が隠しておくからさ」"
]
},
{
"id": 18430,
"kind": "msg",
"jp": [
"「・・・悪いね。",
"何から何まで」"
]
},
{
"id": 18431,
"kind": "msg",
"jp": [
"「いいよ、そんなの。",
"みんなで生きて帰ろうよ」"
]
},
{
"id": 18432,
"kind": "msg",
"jp": [
"「ほな、僕お姉ちゃんにも",
"話しとくわ」"
]
},
{
"id": 18433,
"kind": "msg",
"jp": [
"「うん、よろしく」"
]
},
{
"id": 18434,
"kind": "msg",
"jp": [
"よかった、信用してもらえて。",
"あの様子なら十分警戒してくれる",
"だろうし・・・。"
]
},
{
"id": 18435,
"kind": "msg",
"jp": [
"（・・・最後の最後に",
"僕の方が驚いたけど・・・）"
]
},
{
"id": 18436,
"kind": "msg",
"jp": [
"・・・どう見ても女の子にしか",
"見えないんだけどなあ。"
]
},
{
"id": 18437,
"kind": "msg",
"jp": [
"「・・・ま、ええわ。",
"わかった気はつけとくから」"
]
},
{
"id": 18438,
"kind": "msg",
"jp": [
"「わざわざありがとう」"
]
},
{
"id": 18439,
"kind": "msg",
"jp": [
"なんか唐突に話を切られたような。",
"まるっきり信用されてないわけじゃ",
"なさそうだけど・・・。"
]
},
{
"id": 18440,
"kind": "msg",
"jp": [
"「あの・・・",
"実は、2度も同じ事言い出して",
"申し訳ないんだけど・・・」"
]
},
{
"id": 18441,
"kind": "msg",
"jp": [
"「・・・まさか、またうちが",
"危ないとか言い出す気?」"
]
},
{
"id": 18442,
"kind": "msg",
"jp": [
"「ちゃんと最初から考えなおしたから、",
"だから、えーと・・・」"
]
},
{
"id": 18443,
"kind": "msg",
"jp": [
"「んー、まあとりあえず",
"気はつけとくけど」"
]
},
{
"id": 18444,
"kind": "msg",
"jp": [
"「お兄さんも、あんまり",
"根詰めんときや」"
]
},
{
"id": 18445,
"kind": "msg",
"jp": [
"どうも、いまいち本気で取り合って",
"くれてない気がする。"
]
},
{
"id": 18446,
"kind": "msg",
"jp": [
"まあ、しょうがないか・・・。"
]
},
{
"id": 18447,
"kind": "msg",
"jp": [
"「・・・じ、実はさ・・・」"
]
},
{
"id": 18448,
"kind": "msg",
"jp": [
"「何度も悪いんだけど、あの・・・",
"今度こそ本当に・・・」"
]
},
{
"id": 18449,
"kind": "msg",
"jp": [
"「だからあの、犯人が」"
]
},
{
"id": 18450,
"kind": "msg",
"jp": [
"「あー、はいはい。",
"わかってるわかってる」"
]
},
{
"id": 18451,
"kind": "msg",
"jp": [
"「気ぃつけてるって。",
"大丈夫やから」"
]
},
{
"id": 18452,
"kind": "msg",
"jp": [
"僕の推理はもうほとんど当てにされて",
"ないみたいだ・・・。"
]
},
{
"id": 18453,
"kind": "msg",
"jp": [
"（こう何度も間違えちゃなあ・・・）"
]
},
{
"id": 18454,
"kind": "msg",
"jp": [
"「あのさ、事件のことなんだけど」"
]
},
{
"id": 18455,
"kind": "msg",
"jp": [
"「なんかわかったん?」"
]
},
{
"id": 18456,
"kind": "msg",
"jp": [
"「いや、ほら夕べは静奈ちゃんが",
"危ないって言っただろ?」"
]
},
{
"id": 18457,
"kind": "msg",
"jp": [
"「うん・・・って何?",
"まだ何かヤバいん?」"
]
},
{
"id": 18458,
"kind": "msg",
"jp": [
"「何かって、鈴奈ちゃんが」"
]
},
{
"id": 18459,
"kind": "msg",
"jp": [
"「え? うち? うちが!?」"
]
},
{
"id": 18460,
"kind": "msg",
"jp": [
"「うん、だって静奈ちゃんだけを",
"狙うなら二人とも招待しる必要は",
"ないだろうし」"
]
},
{
"id": 18461,
"kind": "msg",
"jp": [
"「・・・そう、なんかな」"
]
},
{
"id": 18462,
"kind": "msg",
"jp": [
"「うん、でも確かに夕べは",
"お兄さんの言うとおり何か変やったし",
"お姉ちゃん無事やったもんな・・・」"
]
},
{
"id": 18463,
"kind": "msg",
"jp": [
"「信用してもらえる?」"
]
},
{
"id": 18464,
"kind": "msg",
"jp": [
"「・・・わかった。",
"今晩も警戒しとくわ」"
]
},
{
"id": 18465,
"kind": "msg",
"jp": [
"「ありがとう!",
"僕も夜になったら廊下で見張る",
"くらいのことはするから」"
]
},
{
"id": 18466,
"kind": "msg",
"jp": [
"「大丈夫なん?",
"お兄さんちゃんと寝てる?」"
]
},
{
"id": 18467,
"kind": "msg",
"jp": [
"「朝からしばらく休んだから",
"もう大丈夫だよ」"
]
},
{
"id": 18468,
"kind": "msg",
"jp": [
"「気ぃつけてや。",
"うっかり寝てもうたら、お兄さんのが",
"危ないやろうから・・・」"
]
},
{
"id": 18469,
"kind": "msg",
"jp": [
"「う、うん、気をつける」"
]
},
{
"id": 18470,
"kind": "msg",
"jp": [
"「何かあったら大声だしてや。",
"うちら、お姉ちゃんとどっちかは",
"起きとくようにするから」"
]
},
{
"id": 18471,
"kind": "msg",
"jp": [
"「ほな、お姉ちゃんにも",
"話しとくから」"
]
},
{
"id": 18472,
"kind": "msg",
"jp": [
"「わかった、それじゃあ",
"気をつけてね」"
]
},
{
"id": 18473,
"kind": "msg",
"jp": [
"よかった、すぐに信じてもらえて。",
"今夜も無事に済めばいいなぁ・・・。"
]
},
{
"id": 18474,
"kind": "msg",
"jp": [
"「雨、ちっともやまないね」"
]
},
{
"id": 18475,
"kind": "msg",
"jp": [
"「ほんまやねぇ。",
"ここに来る前の日は晴れてたのに」"
]
},
{
"id": 18476,
"kind": "msg",
"jp": [
"「そうだよね。",
"来た日からだよね、急に降りだしたの」"
]
},
{
"id": 18477,
"kind": "msg",
"jp": [
"「いきなりどしゃぶりなったもん、",
"びっくりするわ」"
]
},
{
"id": 18478,
"kind": "msg",
"jp": [
"「・・・最初は喜んでてんけどな。",
"台本どおりや、すごいなーって」"
]
},
{
"id": 18479,
"kind": "msg",
"jp": [
"「崖崩れ、早く復旧するといいね」"
]
},
{
"id": 18480,
"kind": "msg",
"jp": [
"「あれってさ、",
"ほんまに雨で崩れたん?」"
]
},
{
"id": 18481,
"kind": "msg",
"jp": [
"「え!?",
"そりゃ、さすがに人の手で起こすには",
"規模が大きすぎるんじゃ・・・」"
]
},
{
"id": 18482,
"kind": "msg",
"jp": [
"「ほな偶然なんかぁ・・・",
"嫌やわ、なんか偶然まで犯人の",
"味方してるみたいで」"
]
},
{
"id": 18483,
"kind": "msg",
"jp": [
"「あぁ・・・そうだね」"
]
},
{
"id": 18484,
"kind": "msg",
"jp": [
"人災じゃないかって疑ってるというより",
"何か不気味なものを感じてるのか・・。"
]
},
{
"id": 18485,
"kind": "msg",
"jp": [
"「温室に灯りがついてたの",
"すぐ気が付いた?」"
]
},
{
"id": 18486,
"kind": "msg",
"jp": [
"「うん、変な音がして",
"すぐに窓から外見たから」"
]
},
{
"id": 18487,
"kind": "msg",
"jp": [
"「そっか。",
"音で気が付いたんだ」"
]
},
{
"id": 18488,
"kind": "msg",
"jp": [
"「音がするまではカーテン",
"閉めてあったから外見て",
"なかったしなぁ」"
]
},
{
"id": 18489,
"kind": "msg",
"jp": [
"「あのさ・・・",
"鈴奈ちゃんの、その格好って・・・」"
]
},
{
"id": 18490,
"kind": "msg",
"jp": [
"「趣味と違うからな、これは!?」"
]
},
{
"id": 18491,
"kind": "msg",
"jp": [
"「あ、うん。",
"そうなんだろうけど、",
"普段からその・・・」"
]
},
{
"id": 18492,
"kind": "msg",
"jp": [
"「しゃあないやんか!",
"仕事や、仕事!」"
]
},
{
"id": 18493,
"kind": "msg",
"jp": [
"「・・・言うてもこない長いこと",
"ずーっと女のふりし続けるんなんか",
"初めてやけど・・・」"
]
},
{
"id": 18494,
"kind": "msg",
"jp": [
"「いっぺんやってみるか?",
"あんた似合うで、多分」"
]
},
{
"id": 18495,
"kind": "msg",
"jp": [
"「えええ遠慮しとく!」"
]
},
{
"id": 18496,
"kind": "msg",
"jp": [
"「静奈ちゃんの夢遊病って",
"ひんぱんにあることなの?」"
]
},
{
"id": 18497,
"kind": "msg",
"jp": [
"「しょっちゅう、",
"言うわけやないんよ。",
"年に何回かってくらい」"
]
},
{
"id": 18498,
"kind": "msg",
"jp": [
"「それがまた、こんな時に・・・」"
]
},
{
"id": 18499,
"kind": "msg",
"jp": [
"「そうなんよ、",
"よりにもよって危ないときに。",
"血の気引いたわ、もう・・・」"
]
},
{
"id": 18500,
"kind": "msg",
"jp": [
"「そういう時って、",
"起こしたらすぐ起きるの?」"
]
},
{
"id": 18501,
"kind": "msg",
"jp": [
"「ううん、しばらくかかるよ。",
"実際、2階につれて上がってからよ",
"目ぇ覚ましたん」"
]
},
{
"id": 18502,
"kind": "msg",
"jp": [
"「ここどこ、なんでうちこんな所に",
"・・・とかってボケたこと言うてたわ」"
]
},
{
"id": 18503,
"kind": "msg",
"jp": [
"「な、なんか力抜けそうだね」"
]
},
{
"id": 18504,
"kind": "msg",
"jp": [
"「抜ける抜ける。",
"こっちは心配してんのにさあ」"
]
},
{
"id": 18505,
"kind": "msg",
"jp": [
"「腹立つから、また寝ぼけて",
"変なとこで寝てたんやって",
"怒鳴ってもーた」"
]
},
{
"id": 18506,
"kind": "msg",
"jp": [
"・・・まあ、気持ちはわかる。"
]
},
{
"id": 18507,
"kind": "msg",
"jp": [
"「そういえば、怒鳴っとったん",
"2階のホールやったのに",
"お兄さん、出てけえへんかったね」"
]
},
{
"id": 18508,
"kind": "msg",
"jp": [
"「そんなうるさなかったんかな?",
"まあ、すぐに着流しのお兄さんに",
"とめられたのもあるやろけど」"
]
},
{
"id": 18509,
"kind": "msg",
"jp": [
"「ま、ええか」"
]
},
{
"id": 18510,
"kind": "msg",
"jp": [
"「これ、なんて",
"書いてあるかわかる?」"
]
},
{
"id": 18511,
"kind": "msg",
"jp": [
"「えー?」"
]
},
{
"id": 18512,
"kind": "msg",
"jp": [
"「・・・なにこれ。",
"何語かもわからんねんけど」"
]
},
{
"id": 18513,
"kind": "msg",
"jp": [
"「何の文章なん、これ?」"
]
},
{
"id": 18514,
"kind": "msg",
"jp": [
"「なんか地下のボイラー室の",
"壁に彫ってあったんだよ」"
]
},
{
"id": 18515,
"kind": "msg",
"jp": [
"「へ? あんなとこに?」"
]
},
{
"id": 18516,
"kind": "msg",
"jp": [
"「ふーん、なんなんやろね」"
]
},
{
"id": 18517,
"kind": "msg",
"jp": [
"「部屋割りって最初から",
"決められてたんだよね?」"
]
},
{
"id": 18518,
"kind": "msg",
"jp": [
"「うん、なんか招待状に",
"書いてあってんけど・・・」"
]
},
{
"id": 18519,
"kind": "msg",
"jp": [
"「宿泊室なになに、みたいな",
"書き方やってさ、一瞬それが",
"部屋の名前やってわからんかった」"
]
},
{
"id": 18520,
"kind": "msg",
"jp": [
"「・・・お姉ちゃんがすぐに",
"お揃いお揃い騒ぎ出したから",
"名前らしいて気が付いたけどさ」"
]
},
{
"id": 18521,
"kind": "msg",
"jp": [
"「お揃い?」"
]
},
{
"id": 18522,
"kind": "msg",
"jp": [
"「対になってるらしいで",
"うちらの部屋」"
]
},
{
"id": 18523,
"kind": "msg",
"jp": [
"「ふぅん、そうなんだ」"
]
},
{
"id": 18524,
"kind": "msg",
"jp": [
"「那須さんが見たっていう",
"通行止めの看板だけどさ・・・」"
]
},
{
"id": 18525,
"kind": "msg",
"jp": [
"「あー、あれ絶対",
"本物と違うやろ」"
]
},
{
"id": 18526,
"kind": "msg",
"jp": [
"「やっぱりそう思う?」"
]
},
{
"id": 18527,
"kind": "msg",
"jp": [
"「うん、だって土砂崩れの",
"こっち側ってこの館しか",
"ないんやから」"
]
},
{
"id": 18528,
"kind": "msg",
"jp": [
"「・・・けど、本物の小道具",
"やった可能性はあるかなあ」"
]
},
{
"id": 18529,
"kind": "msg",
"jp": [
"「この撮影がホンマやったらって",
"前提になってまうけどね」"
]
},
{
"id": 18530,
"kind": "msg",
"jp": [
"「今回の芝居で使う用に",
"運び込まれてたんを誰かが",
"利用したとか・・・ないか、やっぱ」"
]
},
{
"id": 18531,
"kind": "msg",
"jp": [
"「それだと、芝居用の小道具を",
"事前に運んできた人がいる",
"ことになるもんね」"
]
},
{
"id": 18532,
"kind": "msg",
"jp": [
"「うん、でもうちらの前に",
"スタッフが来てたとかいう話は",
"聞いてへんし、違うんやろな」"
]
},
{
"id": 18533,
"kind": "msg",
"jp": [
"「滝プロさんって事務所は",
"よく知ってるところなの?」"
]
},
{
"id": 18534,
"kind": "msg",
"jp": [
"「滝プロさんかぁ・・・",
"何回か一緒に仕事して知ってる人は",
"おるけどそんなに仲ええ人はおらんわ」"
]
},
{
"id": 18535,
"kind": "msg",
"jp": [
"「スズメ芸能ってどういう",
"事務所なの?」"
]
},
{
"id": 18536,
"kind": "msg",
"jp": [
"「スズメ・・・",
"ああ、斑井さんとこね」"
]
},
{
"id": 18537,
"kind": "msg",
"jp": [
"「名前だけはよぉ聞くんやけど",
"うちはあんまり知らんわ。",
"知り合いもおらんし」"
]
},
{
"id": 18538,
"kind": "msg",
"jp": [
"「鈴奈ちゃんの事務所って",
"どんなとこ?」"
]
},
{
"id": 18539,
"kind": "msg",
"jp": [
"「うちはなぁ・・・」"
]
},
{
"id": 18540,
"kind": "msg",
"jp": [
"「? なに?」"
]
},
{
"id": 18541,
"kind": "msg",
"jp": [
"「なんつーか、社長がいわゆる",
"名物社長ってやつでな」"
]
},
{
"id": 18542,
"kind": "msg",
"jp": [
"「下手したらタレントより",
"有名かもしれへん」"
]
},
{
"id": 18543,
"kind": "msg",
"jp": [
"「変な人やし喋りも上手いし",
"よぉバラエティ出てんで。",
"クイズ番組とかな」"
]
},
{
"id": 18544,
"kind": "msg",
"jp": [
"「・・・あの、もしかして",
"いつもテンガロンハットかぶってる",
"ものすごく陽気なおじさん?」"
]
},
{
"id": 18545,
"kind": "msg",
"jp": [
"「それや」"
]
},
{
"id": 18546,
"kind": "msg",
"jp": [
"「あ・・あの人、",
"鈴奈ちゃんとこの社長さん",
"だったんだ・・・」"
]
},
{
"id": 18547,
"kind": "msg",
"jp": [
"「言うとくけど、",
"変なんは社長だけやで!?」"
]
},
{
"id": 18548,
"kind": "msg",
"jp": [
"「事務所全体があんなテンションな",
"わけやないからな?」"
]
},
{
"id": 18549,
"kind": "msg",
"jp": [
"「う、うん、わかった」"
]
},
{
"id": 18550,
"kind": "msg",
"jp": [
"「それにな、社長かて",
"四六時中ふざけてるわけや",
"ないんやから」"
]
},
{
"id": 18551,
"kind": "msg",
"jp": [
"「真面目になったら",
"別人やろ言うくらい",
"カッコええんやから」"
]
},
{
"id": 18552,
"kind": "msg",
"jp": [
"「ホンマやで?」"
]
},
{
"id": 18553,
"kind": "msg",
"jp": [
"なんだかんだ言って社長さんを",
"慕ってはいるらしい。"
]
},
{
"id": 18554,
"kind": "msg",
"jp": [
"「あー、お姉ちゃんが",
"書斎になんかあったって",
"言うてたなあ」"
]
},
{
"id": 18555,
"kind": "msg",
"jp": [
"「うん、会報があるよ」"
]
},
{
"id": 18556,
"kind": "msg",
"jp": [
"「ちらっと聞いたけど",
"それより次の号のが",
"読んでみたいわ」"
]
},
{
"id": 18557,
"kind": "msg",
"jp": [
"「なんでって・・・」"
]
},
{
"id": 18558,
"kind": "msg",
"jp": [
"「あんた読んだんやろ?",
"気にならんかった?」"
]
},
{
"id": 18559,
"kind": "msg",
"jp": [
"「気になるっていうか",
"よくわからなかった」"
]
},
{
"id": 18560,
"kind": "msg",
"jp": [
"「んー、そういうもんか。",
"まあ、全然興味なかったら",
"そうかもなぁ・・・」"
]
},
{
"id": 18561,
"kind": "msg",
"jp": [
"なんだか残念そうだ・・・。"
]
},
{
"id": 18562,
"kind": "msg",
"jp": [
"「ま、まさかファンやとか",
"新製品が出るの待ちわびてる",
"マニアやとか・・・」"
]
},
{
"id": 18563,
"kind": "msg",
"jp": [
"「違う違う違うっ!」"
]
},
{
"id": 18564,
"kind": "msg",
"jp": [
"「むしろ出ないで欲しい。",
"出ると姉ちゃんが必ず僕にも",
"土産に買ってくるから・・・」"
]
},
{
"id": 18565,
"kind": "msg",
"jp": [
"「なんや仲間かー」"
]
},
{
"id": 18566,
"kind": "msg",
"jp": [
"「うちのお姉ちゃんも",
"あの会社大好きでな・・・」"
]
},
{
"id": 18567,
"kind": "msg",
"jp": [
"「・・・ああ・・・」"
]
},
{
"id": 18568,
"kind": "msg",
"jp": [
"「ほんまに、",
"なんであの時潰れて",
"くれんかったんやろ」"
]
},
{
"id": 18569,
"kind": "msg",
"jp": [
"「あの時って?」"
]
},
{
"id": 18570,
"kind": "msg",
"jp": [
"「なんか一時期もめたやろ。",
"どっかに吸収されたとか、",
"社名変わったとか何とか」"
]
},
{
"id": 18571,
"kind": "msg",
"jp": [
"「そう言えば、",
"なんかニュースで見たような」"
]
},
{
"id": 18572,
"kind": "msg",
"jp": [
"「・・・けど、潰れてたら",
"潰れてたでお姉ちゃん",
"落ち込んだやろうしなぁ・・」"
]
},
{
"id": 18573,
"kind": "msg",
"jp": [
"落ち込むほど好きなのか・・・。"
]
},
{
"id": 18574,
"kind": "msg",
"jp": [
"「今回の脚本ってどんな感じ?」"
]
},
{
"id": 18575,
"kind": "msg",
"jp": [
"「どんなって言うか、",
"まだ全然話が見えへんからなぁ」"
]
},
{
"id": 18576,
"kind": "msg",
"jp": [
"「なんせ今んとこ、",
"うちらが双子である必然性が",
"なんなんかもわからんし」"
]
},
{
"id": 18577,
"kind": "msg",
"jp": [
"「あ、そっか。",
"何の意味もなく双子って変だね」"
]
},
{
"id": 18578,
"kind": "msg",
"jp": [
"「うん、あり得へんことは",
"ないやろうけど・・・」"
]
},
{
"id": 18579,
"kind": "msg",
"jp": [
"「どっちにしろこの続きが無いと",
"なんとも言われへんわ」"
]
},
{
"id": 18580,
"kind": "msg",
"jp": [
"「鈴奈ちゃん、『白夜』っていう",
"ビデオ映画覚えてる?」"
]
},
{
"id": 18581,
"kind": "msg",
"jp": [
"「うん、まあ",
"お姉ちゃん出てたし」"
]
},
{
"id": 18582,
"kind": "msg",
"jp": [
"「それの打ち上げなんだけど」"
]
},
{
"id": 18583,
"kind": "msg",
"jp": [
"「あ、あー・・・打ち上げね。",
"打ち上げはー・・・うちが・・・」"
]
},
{
"id": 18584,
"kind": "msg",
"jp": [
"「鈴奈ちゃんが行ったんだ?」"
]
},
{
"id": 18585,
"kind": "msg",
"jp": [
"「・・・しゃあないやん。",
"お姉ちゃんが見たいドラマあるから",
"嫌やって駄々こねるから!」"
]
},
{
"id": 18586,
"kind": "msg",
"jp": [
"「あ、いや、あの、",
"それについて追求したいわけじゃ",
"なくて、どっちでもいいんだけど」"
]
},
{
"id": 18587,
"kind": "msg",
"jp": [
"「ほな、なにが・・・」"
]
},
{
"id": 18588,
"kind": "msg",
"jp": [
"「・・・あ、思い出した!",
"あの打ち上げのとき帽子屋来てた",
"らしいとかいう話のこと?」"
]
},
{
"id": 18589,
"kind": "msg",
"jp": [
"「帽子屋らしい人いたの?」"
]
},
{
"id": 18590,
"kind": "msg",
"jp": [
"「ううん、うちはかなり",
"後になってから聞いてん」"
]
},
{
"id": 18591,
"kind": "msg",
"jp": [
"「同じ事務所の人に、",
"帽子屋来てたらしいけど会うたんかって",
"聞かれて初めて知ったくらい」"
]
},
{
"id": 18592,
"kind": "msg",
"jp": [
"「そっか・・・。",
"その場にいた人の誰だったかなんて",
"予想つかない?」"
]
},
{
"id": 18593,
"kind": "msg",
"jp": [
"「つかんよ、そんなん。",
"あの時おった人言うても・・・」"
]
},
{
"id": 18594,
"kind": "msg",
"jp": [
"「・・・あれ、暗石さん出てた、",
"御陵さん出てた、それに・・・」"
]
},
{
"id": 18595,
"kind": "msg",
"jp": [
"「・・・なんか、ここに集まってる人",
"みんなおったんちゃうか・・・」"
]
},
{
"id": 18596,
"kind": "msg",
"jp": [
"「みんな居た?",
"間違いない?」"
]
},
{
"id": 18597,
"kind": "msg",
"jp": [
"「んー、打ち上げやし飲んでたし、",
"絶対間違いないとまでは",
"言い切る自信ないけど・・・」"
]
},
{
"id": 18598,
"kind": "msg",
"jp": [
"「おったと思うわ。",
"しかもかなり最後の方まで残ってた",
"面子やった気がする」"
]
},
{
"id": 18599,
"kind": "msg",
"jp": [
"「・・・最後の方まで・・・か」"
]
},
{
"id": 18600,
"kind": "msg",
"jp": [
"「『虹色の愛の架け橋』って",
"どんなドラマだったの?」"
]
},
{
"id": 18601,
"kind": "msg",
"jp": [
"「あー、あれかぁ。",
"ごめん、うち見たことないねん」"
]
},
{
"id": 18602,
"kind": "msg",
"jp": [
"「なんか昔すごい流行ったらしいから",
"お姉ちゃんはレンタルで借りてきて",
"見てたけどさ」"
]
},
{
"id": 18603,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは一緒に",
"見なかったの?」"
]
},
{
"id": 18604,
"kind": "msg",
"jp": [
"「ああいうメロドラマって",
"あんまり好きやないねん」"
]
},
{
"id": 18605,
"kind": "msg",
"jp": [
"「自分が役で演じるぶんには",
"ええねんけど見てたらイライラ",
"してもうてアカンわ」"
]
},
{
"id": 18606,
"kind": "msg",
"jp": [
"「『麻雀地獄伝説』って知ってる?",
"なんかビデオ映画らしいんだけど」"
]
},
{
"id": 18607,
"kind": "msg",
"jp": [
"「違う違う!",
"原作は漫画やねん、あれは」"
]
},
{
"id": 18608,
"kind": "msg",
"jp": [
"「言うとくけど原作の方が",
"100倍おもろいからね」"
]
},
{
"id": 18609,
"kind": "msg",
"jp": [
"「だいたい、石澤ってあんな優男や",
"ないし台詞かてもっと頭良さそうに",
"喋ってもらわんと・・・」"
]
},
{
"id": 18610,
"kind": "msg",
"jp": [
"「ま、待って、あの",
"石澤って誰?」"
]
},
{
"id": 18611,
"kind": "msg",
"jp": [
"「主人公や主人公!",
"ビデオの方だけ見て判断せんといてや",
"原作はもっとかっこええねんからね」"
]
},
{
"id": 18612,
"kind": "msg",
"jp": [
"・・・なんかものすごい",
"こだわりがあるらしい。"
]
},
{
"id": 18613,
"kind": "msg",
"jp": [
"「高遠延二郎の『白蛇殺人事件』って",
"話読んだことある?」"
]
},
{
"id": 18614,
"kind": "msg",
"jp": [
"「うちは読んでへんわ。",
"お姉ちゃんやったら知ってる",
"かもしれへんけど・・・」"
]
},
{
"id": 18615,
"kind": "msg",
"jp": [
"「普段からそんなに小説とか",
"読むほう違うからなあ、うちは」"
]
},
{
"id": 18616,
"kind": "msg",
"jp": [
"「ふーん、そっか・・・」"
]
},
{
"id": 18617,
"kind": "msg",
"jp": [
"「知ってるー!",
"うち解いたもん、根性で!」"
]
},
{
"id": 18618,
"kind": "msg",
"jp": [
"「こ、根性?」"
]
},
{
"id": 18619,
"kind": "msg",
"jp": [
"「気合いと根性と",
"不屈の精神がないと",
"解けん、あのゲームは」"
]
},
{
"id": 18620,
"kind": "msg",
"jp": [
"「うちのお姉ちゃんみたいな",
"変わった趣味の人以外はな」"
]
},
{
"id": 18621,
"kind": "msg",
"jp": [
"「そうなの・・・?」"
]
},
{
"id": 18622,
"kind": "msg",
"jp": [
"「どこの世界にうっかり",
"使ったらラスボス召喚してまう",
"アイテム出てくるゲームがあるよ」"
]
},
{
"id": 18623,
"kind": "msg",
"jp": [
"「そんなの呼んじゃったら",
"どうなるの!?」"
]
},
{
"id": 18624,
"kind": "msg",
"jp": [
"「戦闘になるよ、もちろん。",
"まあ、大抵負けるけど」"
]
},
{
"id": 18625,
"kind": "msg",
"jp": [
"「か、勝てる場合ってあるの?」"
]
},
{
"id": 18626,
"kind": "msg",
"jp": [
"「その時点で勝てるくらいの",
"レベルにまで鍛えてたらね」"
]
},
{
"id": 18627,
"kind": "msg",
"jp": [
"「けど、封印のお札っていう",
"アイテムないとボスの強さ半端や",
"ないからな・・・」"
]
},
{
"id": 18628,
"kind": "msg",
"jp": [
"「レベル90以上あっても",
"30分戦うて勝てるかどうか",
"五分なんやって」"
]
},
{
"id": 18629,
"kind": "msg",
"jp": [
"「・・・あの、それ",
"もし倒しちゃったら",
"どうなるの・・・?」"
]
},
{
"id": 18630,
"kind": "msg",
"jp": [
"「ラスボスのところに、",
"実はボスじゃないごっつい弱い",
"影武者が座ってるらしいで」"
]
},
{
"id": 18631,
"kind": "msg",
"jp": [
"「うちは普通にしか",
"攻略したことないから",
"試してへんねんけど」"
]
},
{
"id": 18632,
"kind": "msg",
"jp": [
"「・・・なんで最後のボスを",
"途中で倒せるなんて設定に",
"したんだろう・・・」"
]
},
{
"id": 18633,
"kind": "msg",
"jp": [
"「それが謎なんよね」"
]
},
{
"id": 18634,
"kind": "msg",
"jp": [
"「噂ではなんかのバグでボスが",
"呼び出せるようになってもうたから",
"シナリオの方変えたとか」"
]
},
{
"id": 18635,
"kind": "msg",
"jp": [
"「対応間違ってない、それ!?」"
]
},
{
"id": 18636,
"kind": "msg",
"jp": [
"「うちもそう思うけど、",
"なんか色々事情があったんやろ」"
]
},
{
"id": 18637,
"kind": "msg",
"jp": [
"「あのゲーム出した会社、",
"あれ1本だけで潰れたから",
"真相はもう永遠の謎やし」"
]
},
{
"id": 18638,
"kind": "msg",
"jp": [
"何があったんだろう・・・。"
]
},
{
"id": 18639,
"kind": "msg",
"jp": [
"「・・・ああ、なんか",
"あの都市伝説みたいなドラマ?」"
]
},
{
"id": 18640,
"kind": "msg",
"jp": [
"「そんな話なの?」"
]
},
{
"id": 18641,
"kind": "msg",
"jp": [
"「いや、内容は普通の",
"サスペンス物らしいけどさ」"
]
},
{
"id": 18642,
"kind": "msg",
"jp": [
"「見たら呪われるとかいう",
"噂が流れて大騒ぎに・・・」"
]
},
{
"id": 18643,
"kind": "msg",
"jp": [
"「あ、いや、わかった。",
"もういい、ありがとう」"
]
},
{
"id": 18644,
"kind": "msg",
"jp": [
"「ヘタレやな、アンタ・・・」"
]
},
{
"id": 18645,
"kind": "msg",
"jp": [
"「この館ってずいぶん古いよね」"
]
},
{
"id": 18646,
"kind": "msg",
"jp": [
"「古いんはええねんけど",
"なんでこんな変な形なんやろ」"
]
},
{
"id": 18647,
"kind": "msg",
"jp": [
"「廊下とか曲がりまくってるし",
"えらいひねくれた形やと思えへん?」"
]
},
{
"id": 18648,
"kind": "msg",
"jp": [
"「それもそうだね」"
]
},
{
"id": 18649,
"kind": "msg",
"jp": [
"「まあ、お姉ちゃん喜んでたけど。",
"なんか変なもん好きやから」"
]
},
{
"id": 18650,
"kind": "msg",
"jp": [
"「あの後、食堂に入ったこと",
"なんてないよね?」"
]
},
{
"id": 18651,
"kind": "msg",
"jp": [
"「ないない。",
"閉めた後、鍵も娯楽室に戻して",
"あるんでしょ?」"
]
},
{
"id": 18652,
"kind": "msg",
"jp": [
"「うん、そうしてる」"
]
},
{
"id": 18653,
"kind": "msg",
"jp": [
"「ほな、誰も入ってへんのとちゃう?",
"わざわざ入らないかん用事が",
"あるとも思えへんし」"
]
},
{
"id": 18654,
"kind": "msg",
"jp": [
"「娯楽室なんだけどさ、",
"窓の近くになんか濡れたあとが",
"あったんだけど何だと思う?」"
]
},
{
"id": 18655,
"kind": "msg",
"jp": [
"「窓の近く?",
"窓の近くねえ・・・」"
]
},
{
"id": 18656,
"kind": "msg",
"jp": [
"「うーん、あの部屋の窓って",
"どんなんやったっけ。",
"あんま近寄ってないから覚えてへん」"
]
},
{
"id": 18657,
"kind": "msg",
"jp": [
"「あのさ、裏庭の井戸",
"なんだけど・・・」"
]
},
{
"id": 18658,
"kind": "msg",
"jp": [
"「あー、井戸なぁ・・・",
"悪いけどうち、ほとんど近寄った",
"こともあらへんから」"
]
},
{
"id": 18659,
"kind": "msg",
"jp": [
"「・・・お兄さんも",
"よぉあんなとこのぞいたね」"
]
},
{
"id": 18660,
"kind": "msg",
"jp": [
"「僕だって半分日織に",
"引きずってかれたような",
"ものだけどさ・・・」"
]
},
{
"id": 18661,
"kind": "msg",
"jp": [
"「けど、結局は中まで",
"降りたわけやろ?」"
]
},
{
"id": 18662,
"kind": "msg",
"jp": [
"「だって、何が入ってるか",
"わかんないままでいるのも怖いし」"
]
},
{
"id": 18663,
"kind": "msg",
"jp": [
"「・・・なんでホラー映画で",
"わざわざ変な物音のした方に行って",
"墓穴掘る人がおるんかわかったわ」"
]
},
{
"id": 18664,
"kind": "msg",
"jp": [
"「ここのベランダって向こう側の",
"部屋までずっと繋がってるんだよね」"
]
},
{
"id": 18665,
"kind": "msg",
"jp": [
"「そのはずやねんけどなあ、",
"間にある戸が開かへんから意味無いわ」"
]
},
{
"id": 18666,
"kind": "msg",
"jp": [
"「そうだね。",
"いつから開かないのかな」"
]
},
{
"id": 18667,
"kind": "msg",
"jp": [
"「錆びてたんやろ?",
"ほな、かなり前からなんちゃう?」"
]
},
{
"id": 18668,
"kind": "msg",
"jp": [
"「この家の人も開かへんように",
"なってんの気が付いてないんかも」"
]
},
{
"id": 18669,
"kind": "msg",
"jp": [
"「だろうね。",
"気が付いてたらなおすだろうし」"
]
},
{
"id": 18670,
"kind": "msg",
"jp": [
"「居間の外にあるテラスって",
"晴れてたら気持ちよさそうだね」"
]
},
{
"id": 18671,
"kind": "msg",
"jp": [
"「そやろね。",
"那須さんがやたらええなーって",
"うらやましがってたわ」"
]
},
{
"id": 18672,
"kind": "msg",
"jp": [
"「うちにも欲しいとか言うてたけど",
"どんな家住んではるんやろ?」"
]
},
{
"id": 18673,
"kind": "msg",
"jp": [
"「・・・なんかスポーツジム",
"みたいなのしか想像できない・・・」"
]
},
{
"id": 18674,
"kind": "msg",
"jp": [
"「どこのプロレスラーの豪邸なんよ」"
]
},
{
"id": 18675,
"kind": "msg",
"jp": [
"「・・・けど那須さんやしなあ。",
"自分ちの地下にリングとか組んでても",
"納得してまいそうやわ」"
]
},
{
"id": 18676,
"kind": "msg",
"jp": [
"本当にありそうだ・・・。"
]
},
{
"id": 18677,
"kind": "msg",
"jp": [
"「温室って入ったことあった?",
"騒ぎが起きる前のことだけど」"
]
},
{
"id": 18678,
"kind": "msg",
"jp": [
"「来てすぐうろうろした時に",
"のぞいてみただけかなぁ」"
]
},
{
"id": 18679,
"kind": "msg",
"jp": [
"「あんま興味ないから",
"そないじっくり見てへんけど」"
]
},
{
"id": 18680,
"kind": "msg",
"jp": [
"「そっか。",
"花とか好きじゃないの?」"
]
},
{
"id": 18681,
"kind": "msg",
"jp": [
"「・・・まあね」"
]
},
{
"id": 18682,
"kind": "msg",
"jp": [
"「ここの台所って広くて",
"使いやすそうだね」"
]
}
]