[
{
"id": 20836,
"kind": "msg",
"jp": [
"「異常に好きなワケじゃ",
"ねーからな?」"
]
},
{
"id": 20837,
"kind": "msg",
"jp": [
"「ごく一般的な意味で",
"好きな食べ物の1つに",
"入るって意味でな?」"
]
},
{
"id": 20838,
"kind": "msg",
"jp": [
"なんなんだ・・・?"
]
},
{
"id": 20839,
"kind": "msg",
"jp": [
"「無茶言うな」"
]
},
{
"id": 20840,
"kind": "msg",
"jp": [
"「あ、あの作ってくれって",
"言ってるワケじゃないよ?」"
]
},
{
"id": 20841,
"kind": "msg",
"jp": [
"「当たり前だ、",
"んなもん日織に頼めよ」"
]
},
{
"id": 20842,
"kind": "msg",
"jp": [
"材料がないと思う・・・。"
]
},
{
"id": 20843,
"kind": "msg",
"jp": [
"「唐突だな、お前。",
"なんだよ食いたくなったのか?」"
]
},
{
"id": 20844,
"kind": "msg",
"jp": [
"「いや、ちょっと",
"日織が得意だって言うから」"
]
},
{
"id": 20845,
"kind": "msg",
"jp": [
"「マジで?",
"あー、豆腐は置いてねーな",
"さすがに・・・」"
]
},
{
"id": 20846,
"kind": "msg",
"jp": [
"「・・・オレまで食いたくなって",
"きたじゃねーかよ、てめえっ!」"
]
},
{
"id": 20847,
"kind": "msg",
"jp": [
"「椿くんは煙草・・・",
"あ、吸うわけないか」"
]
},
{
"id": 20848,
"kind": "msg",
"jp": [
"「不良は役だけだっつーの。",
"酒くらい飲んだ事あるけど",
"煙草はねーなぁ」"
]
},
{
"id": 20849,
"kind": "msg",
"jp": [
"「多分、吸わねーだろうな。",
"喉痛めっと嫌だし」"
]
},
{
"id": 20850,
"kind": "msg",
"jp": [
"「役者さんだもんね」"
]
},
{
"id": 20851,
"kind": "msg",
"jp": [
"「ああ、けど先輩でさ、",
"普段全然吸わない人なんだけど",
"ヘビースモーカーな役が来てさ」"
]
},
{
"id": 20852,
"kind": "msg",
"jp": [
"「くわえ煙草で喋る場面で",
"むせまくってNG連発して",
"大変だったらしいんだよなぁ」"
]
},
{
"id": 20853,
"kind": "msg",
"jp": [
"「・・・そういう",
"苦労もあるんだ・・・」"
]
},
{
"id": 20854,
"kind": "msg",
"jp": [
"「酒ならそれっぽい色してりゃ",
"アルコール入ってなくても",
"誤魔化せるけど煙草はなぁ」"
]
},
{
"id": 20855,
"kind": "msg",
"jp": [
"役者さんてつくづく大変だ・・・。"
]
},
{
"id": 20856,
"kind": "msg",
"jp": [
"「地下にあるワインって",
"どんなの?」"
]
},
{
"id": 20857,
"kind": "msg",
"jp": [
"「さあ?",
"わりといいやつらしいけど",
"オレは飲めねーし知らねえや」"
]
},
{
"id": 20858,
"kind": "msg",
"jp": [
"「飲めないんだっけ?」"
]
},
{
"id": 20859,
"kind": "msg",
"jp": [
"「お前、オレの歳",
"忘れてるだろ」"
]
},
{
"id": 20860,
"kind": "msg",
"jp": [
"「・・・ああ!",
"20歳前だったっけ」"
]
},
{
"id": 20861,
"kind": "msg",
"jp": [
"「18だよ。",
"飲んだ事ねぇとは言わねーが",
"一応まだ飲めない歳だからな」"
]
},
{
"id": 20862,
"kind": "msg",
"jp": [
"「・・・多分ここで飲んだら",
"御陵さん辺りに叱られそうな",
"気がするし・・・」"
]
},
{
"id": 20863,
"kind": "msg",
"jp": [
"「あー・・・",
"そうかもね」"
]
},
{
"id": 20864,
"kind": "msg",
"jp": [
"真面目そうだもんな、御陵さん。"
]
},
{
"id": 20865,
"kind": "msg",
"jp": [
"「あのさ・・・",
"変な事聞くけど、脚立って・・・」"
]
},
{
"id": 20866,
"kind": "msg",
"jp": [
"「な、なんだよ!?",
"ないだろ、ここには?」"
]
},
{
"id": 20867,
"kind": "msg",
"jp": [
"「ないはずだぞ、",
"あれのコレクションは確か",
"信州の方の別荘に・・・」"
]
},
{
"id": 20868,
"kind": "msg",
"jp": [
"「コ、コレクション?」"
]
},
{
"id": 20869,
"kind": "msg",
"jp": [
"「え、あ、いや、",
"オレのじゃねーぞ!?」"
]
},
{
"id": 20870,
"kind": "msg",
"jp": [
"「ここの変態当主のだからな!",
"オレは知らんぞ!?」"
]
},
{
"id": 20871,
"kind": "msg",
"jp": [
"「・・・えーと、",
"あの、コレクションって",
"脚立の・・・?」"
]
},
{
"id": 20872,
"kind": "msg",
"jp": [
"「なんか知らんが、",
"有名な映画のロケに使われたヤツとか",
"どっかの廃屋にあったやつとかな」"
]
},
{
"id": 20873,
"kind": "msg",
"jp": [
"いろんな物集める人が",
"いるもんだな・・・。"
]
},
{
"id": 20874,
"kind": "msg",
"jp": [
"「納戸にしまってある",
"白い傘って普段使ってないもの?」"
]
},
{
"id": 20875,
"kind": "msg",
"jp": [
"「傘? んなもんあったっけ?」"
]
},
{
"id": 20876,
"kind": "msg",
"jp": [
"「知らない?",
"レースのついた日傘」"
]
},
{
"id": 20877,
"kind": "msg",
"jp": [
"「・・・思い出した。",
"それ、縁起悪いからって",
"しまってあった奴だ」"
]
},
{
"id": 20878,
"kind": "msg",
"jp": [
"「え、縁起?」"
]
},
{
"id": 20879,
"kind": "msg",
"jp": [
"「なんか、その傘さして",
"出歩くと必ず何かしら事故に",
"あうとかして怪我するらしい」"
]
},
{
"id": 20880,
"kind": "msg",
"jp": [
"そんなの部屋に隠しておいて",
"大丈夫かな、僕・・・。"
]
},
{
"id": 20881,
"kind": "msg",
"jp": [
"「ワイングラスって、",
"2階の物置にしまってあった",
"あれだけかな?」"
]
},
{
"id": 20882,
"kind": "msg",
"jp": [
"「グラスなんか",
"台所にもいくらでも",
"あるんじゃねーの?」"
]
},
{
"id": 20883,
"kind": "msg",
"jp": [
"「普通のグラスはいいんだよ。",
"ワイングラスだけで」"
]
},
{
"id": 20884,
"kind": "msg",
"jp": [
"「・・・すまんがオレは",
"本物の執事じゃねーんだよ。",
"んなもん区別つくか」"
]
},
{
"id": 20885,
"kind": "msg",
"jp": [
"「いや、待てよ?」"
]
},
{
"id": 20886,
"kind": "msg",
"jp": [
"「そーいや、ちょと前に",
"グラス大量に割ったんじゃ",
"なかったかな・・・」"
]
},
{
"id": 20887,
"kind": "msg",
"jp": [
"「割った?」"
]
},
{
"id": 20888,
"kind": "msg",
"jp": [
"「滅多に使わねーって食器を",
"たまに洗っとこうと思って",
"一斉に洗ってて割ったらしい」"
]
},
{
"id": 20889,
"kind": "msg",
"jp": [
"「見あたらねーんだったら",
"その時割れちまったから",
"ないんじゃねーかな」"
]
},
{
"id": 20890,
"kind": "msg",
"jp": [
"「わかった、ありがとう」"
]
},
{
"id": 20891,
"kind": "msg",
"jp": [
"「あのさ、椿くん」"
]
},
{
"id": 20892,
"kind": "msg",
"jp": [
"「日織に、ここに来る前に",
"会ったことある?」"
]
},
{
"id": 20893,
"kind": "msg",
"jp": [
"「確かあったと思うけどな。",
"それがどうかしたか?」"
]
},
{
"id": 20894,
"kind": "msg",
"jp": [
"「普段からああなの?」"
]
},
{
"id": 20895,
"kind": "msg",
"jp": [
"「・・・オレが覚えてる限りじゃ、",
"いつもあんなヤツだな」"
]
},
{
"id": 20896,
"kind": "msg",
"jp": [
"「まあ、変なヤツだけど",
"悪いやつじゃなさそうだから",
"いいんじゃね?」"
]
},
{
"id": 20897,
"kind": "msg",
"jp": [
"やっぱりちょっと変わった人だと",
"思われてるのか、日織・・・。"
]
},
{
"id": 20898,
"kind": "msg",
"jp": [
"「あのさ、斑井さんの",
"ことなんだけど・・・」"
]
},
{
"id": 20899,
"kind": "msg",
"jp": [
"「あー、うるせえだろ。",
"下手に話し掛けると延々と自慢話",
"聞かされる羽目になるぜ」"
]
},
{
"id": 20900,
"kind": "msg",
"jp": [
"「・・・いつもああなの?」"
]
},
{
"id": 20901,
"kind": "msg",
"jp": [
"「そーだよ。",
"業界内だけでは無駄に有名人」"
]
},
{
"id": 20902,
"kind": "msg",
"jp": [
"「あのオッサン、演技が下手なわけじゃ",
"ねーんだけどなあ・・・」"
]
},
{
"id": 20903,
"kind": "msg",
"jp": [
"「もしかして、あの性格で",
"かなり損してるんじゃ・・・」"
]
},
{
"id": 20904,
"kind": "msg",
"jp": [
"「オレもそう思う。",
"もうちっとマトモだったらもっと",
"仕事来るんじゃねーの」"
]
},
{
"id": 20905,
"kind": "msg",
"jp": [
"「椿くんってさ・・・」"
]
},
{
"id": 20906,
"kind": "msg",
"jp": [
"「なんでございましょう?」"
]
},
{
"id": 20907,
"kind": "msg",
"jp": [
"「・・・その喋り方疲れない?」"
]
},
{
"id": 20908,
"kind": "msg",
"jp": [
"「疲れるも何も私はしちゅ、執・・・",
"えー、執事でございますから・・・」"
]
},
{
"id": 20909,
"kind": "msg",
"jp": [
"「あの、今・・・途中で・・・」"
]
},
{
"id": 20910,
"kind": "msg",
"jp": [
"「失礼致しました。",
"えー、ですから・・・この喋り方は・・・」"
]
},
{
"id": 20911,
"kind": "msg",
"jp": [
"「・・・だー、もう面倒くせえっ!!」"
]
},
{
"id": 20912,
"kind": "msg",
"jp": [
"「や、やっぱり面倒なん・・・」"
]
},
{
"id": 20913,
"kind": "msg",
"jp": [
"「当たり前だろうが!",
"なんでオレがこんな役なんだよ!?」"
]
},
{
"id": 20914,
"kind": "msg",
"jp": [
"「僕に言われてもっ!?」"
]
},
{
"id": 20915,
"kind": "msg",
"jp": [
"「明らかにミスキャストだと",
"思わねーか!? あぁ!?」"
]
},
{
"id": 20916,
"kind": "msg",
"jp": [
"「・・・思う」"
]
},
{
"id": 20917,
"kind": "msg",
"jp": [
"「だよなあ・・・」"
]
},
{
"id": 20918,
"kind": "msg",
"jp": [
"「何を思ってオレに執事役なんか",
"振りやがったんだか心底不思議だ」"
]
},
{
"id": 20919,
"kind": "msg",
"jp": [
"・・・僕も不思議だ。"
]
},
{
"id": 20920,
"kind": "msg",
"jp": [
"「あのさ、那須さんって・・・」"
]
},
{
"id": 20921,
"kind": "msg",
"jp": [
"「筋肉がどうした?」"
]
},
{
"id": 20922,
"kind": "msg",
"jp": [
"「いや、あの、筋肉のことが",
"聞きたいわけじゃなくてさ」"
]
},
{
"id": 20923,
"kind": "msg",
"jp": [
"「だってアイツ、",
"筋肉のことしか頭にないぞ」"
]
},
{
"id": 20924,
"kind": "msg",
"jp": [
"「ないのっ!?」"
]
},
{
"id": 20925,
"kind": "msg",
"jp": [
"「あるように見えるのか」"
]
},
{
"id": 20926,
"kind": "msg",
"jp": [
"「筋肉でいいんだよ、あれは。",
"どうせ脳みそどころか血管から神経まで",
"筋肉で出来てんだから」"
]
},
{
"id": 20927,
"kind": "msg",
"jp": [
"「それ人類じゃないと思う・・・」"
]
},
{
"id": 20928,
"kind": "msg",
"jp": [
"「人類に見えるのか」"
]
},
{
"id": 20929,
"kind": "msg",
"jp": [
"「・・・い、一応」"
]
},
{
"id": 20930,
"kind": "msg",
"jp": [
"「お前いいヤツだな」"
]
},
{
"id": 20931,
"kind": "msg",
"jp": [
"「オレにはあれが同じ生き物だとは",
"どうしても思えん」"
]
},
{
"id": 20932,
"kind": "msg",
"jp": [
"確かにちょっと思えないかも・・・。"
]
},
{
"id": 20933,
"kind": "msg",
"jp": [
"「あれで30過ぎてるってのも",
"いまいち信じられんし・・・」"
]
},
{
"id": 20934,
"kind": "msg",
"jp": [
"「・・・一見、年わからないね」"
]
},
{
"id": 20935,
"kind": "msg",
"jp": [
"「33だとよ」"
]
},
{
"id": 20936,
"kind": "msg",
"jp": [
"そう言われればそれくらいに",
"見える気もする。"
]
},
{
"id": 20937,
"kind": "msg",
"jp": [
"（けど、20代って言われても",
"40代って言われてもなんとなく",
"納得してしまいそうな・・・）"
]
},
{
"id": 20938,
"kind": "msg",
"jp": [
"「鈴奈ちゃん達ってそっくりだよね」"
]
},
{
"id": 20939,
"kind": "msg",
"jp": [
"「見分けつかねーよ、",
"オレなんかしょっちゅう",
"間違えてばっかだ」"
]
},
{
"id": 20940,
"kind": "msg",
"jp": [
"「間違えると、",
"やっぱり怒られる?」"
]
},
{
"id": 20941,
"kind": "msg",
"jp": [
"「いや、笑われる」"
]
},
{
"id": 20942,
"kind": "msg",
"jp": [
"「わ、笑われるの?」"
]
},
{
"id": 20943,
"kind": "msg",
"jp": [
"「どうも、面白がってんな",
"あの双子は・・・」"
]
},
{
"id": 20944,
"kind": "msg",
"jp": [
"「あの分じゃ普段から",
"入れ替わったりして遊んでそうだぜ」"
]
},
{
"id": 20945,
"kind": "msg",
"jp": [
"本気でお互いがお互いのフリしてたら",
"見分けつかないだろうなぁ・・・。"
]
},
{
"id": 20946,
"kind": "msg",
"jp": [
"「静奈ちゃんって変わった雰囲気の子",
"だけど、お芝居は上手みたいだね」"
]
},
{
"id": 20947,
"kind": "msg",
"jp": [
"「ああ、あいつは上手いよ",
"うちの社長も誉めてた」"
]
},
{
"id": 20948,
"kind": "msg",
"jp": [
"「へえ、そうなんだ?」"
]
},
{
"id": 20949,
"kind": "msg",
"jp": [
"「なんつーか天性の役者",
"なんだよな・・・」"
]
},
{
"id": 20950,
"kind": "msg",
"jp": [
"「舞台で見るとよくわかるぜ。",
"出てきただけで空気が変わるから」"
]
},
{
"id": 20951,
"kind": "msg",
"jp": [
"「空気が?」"
]
},
{
"id": 20952,
"kind": "msg",
"jp": [
"「華があるってやつだろ。",
"いるじゃん、その場にいるだけで",
"なんか目立つってやつ」"
]
},
{
"id": 20953,
"kind": "msg",
"jp": [
"「ああ、なんとなくわかる」"
]
},
{
"id": 20954,
"kind": "msg",
"jp": [
"「ああいうのは、身につけようとして",
"つくもんじゃねえからなあ」"
]
},
{
"id": 20955,
"kind": "msg",
"jp": [
"椿くんは、ちょっとうらやましそうに",
"見えた。"
]
},
{
"id": 20956,
"kind": "msg",
"jp": [
"「あのさ、暗石さんって・・・」"
]
},
{
"id": 20957,
"kind": "msg",
"jp": [
"「あー、さすがにお前でも",
"知ってるだろ、あの人は!」"
]
},
{
"id": 20958,
"kind": "msg",
"jp": [
"「来てみたらいたから",
"すげー、びびったぜ!」"
]
},
{
"id": 20959,
"kind": "msg",
"jp": [
"「だってお前、大ベテランだぞ?",
"ああいう人がいねーと芝居ってのは",
"成り立たねんだよ」"
]
},
{
"id": 20960,
"kind": "msg",
"jp": [
"「・・・椿くんは、",
"暗石さんのこと尊敬してるんだ」"
]
},
{
"id": 20961,
"kind": "msg",
"jp": [
"「わ、悪いかよ!",
"当たり前だろ、あの人尊敬してねえ",
"役者なんかいねーよ!」"
]
},
{
"id": 20962,
"kind": "msg",
"jp": [
"なんか思ってたより凄い人なんだ",
"暗石さんって・・・。"
]
},
{
"id": 20963,
"kind": "msg",
"jp": [
"「御陵さんっておっとりしてるねえ」"
]
},
{
"id": 20964,
"kind": "msg",
"jp": [
"「あー、あの人なあ。",
"いい人なんだろうけど・・・」"
]
},
{
"id": 20965,
"kind": "msg",
"jp": [
"「苦手なの?」"
]
},
{
"id": 20966,
"kind": "msg",
"jp": [
"「苦手ってほどじゃねえが、",
"ちょっとマイペースすぎて調子狂うな」"
]
},
{
"id": 20967,
"kind": "msg",
"jp": [
"「ときどき、突拍子もなく",
"変なこと言うし・・・」"
]
},
{
"id": 20968,
"kind": "msg",
"jp": [
"「変なこと?」"
]
},
{
"id": 20969,
"kind": "msg",
"jp": [
"「びっくりするようなこと",
"知らなかったりするんだよ」"
]
},
{
"id": 20970,
"kind": "msg",
"jp": [
"「最初にここに到着するなり、",
"山の中を走るのにもお金のいる",
"道があるんですね、だってさ」"
]
},
{
"id": 20971,
"kind": "msg",
"jp": [
"「・・・有料道路のことだよね」"
]
},
{
"id": 20972,
"kind": "msg",
"jp": [
"「あと、台所でカップ麺見て",
"まあ珍しい、とか言ってたな」"
]
},
{
"id": 20973,
"kind": "msg",
"jp": [
"「珍しい!?」"
]
},
{
"id": 20974,
"kind": "msg",
"jp": [
"「食ったことないんじゃねえ?",
"実はすげえお嬢育ちだとかって",
"噂だけど、マジかもな」"
]
},
{
"id": 20975,
"kind": "msg",
"jp": [
"「椿くんは、南雲さん役の人",
"誰だか知ってたの?」"
]
},
{
"id": 20976,
"kind": "msg",
"jp": [
"「いや、誰かは知らねえよ。",
"事務所で滝プロからも誰か来るらしい",
"とか聞いてただけでな」"
]
},
{
"id": 20977,
"kind": "msg",
"jp": [
"「今、ここにいるメンツには",
"滝プロ所属はいねーから、",
"南雲ってのがそうなのかと・・・」"
]
},
{
"id": 20978,
"kind": "msg",
"jp": [
"「ああ、そういうことか」"
]
},
{
"id": 20979,
"kind": "msg",
"jp": [
"「まあ、滝プロったって",
"いろいろいるしなあ」"
]
},
{
"id": 20980,
"kind": "msg",
"jp": [
"「役柄から、どの人かって",
"想像つかない?」"
]
},
{
"id": 20981,
"kind": "msg",
"jp": [
"「オレに執事役なんか振ってくる",
"キャスティングでどうやって",
"想像しろってんだ」"
]
},
{
"id": 20982,
"kind": "msg",
"jp": [
"「・・・それもそうだね」"
]
},
{
"id": 20983,
"kind": "msg",
"jp": [
"「あのさ、帽子屋って・・・」"
]
},
{
"id": 20984,
"kind": "msg",
"jp": [
"「雇い主のことは話せません」"
]
},
{
"id": 20985,
"kind": "msg",
"jp": [
"「や、雇い主?」"
]
},
{
"id": 20986,
"kind": "msg",
"jp": [
"「私をここへ招いたのは",
"帽子屋ですから」"
]
},
{
"id": 20987,
"kind": "msg",
"jp": [
"「ああ、そういう意味か。",
"会ったことは・・ないんだよね」"
]
},
{
"id": 20988,
"kind": "msg",
"jp": [
"「ございません。",
"・・っつーかな、聞かれたって",
"オレもよく知らねんだよ」"
]
},
{
"id": 20989,
"kind": "msg",
"jp": [
"「椿くんは、高遠延二郎の本",
"読んだことある?」"
]
},
{
"id": 20990,
"kind": "msg",
"jp": [
"「え、あー・・・」"
]
},
{
"id": 20991,
"kind": "msg",
"jp": [
"「・・・読んでない?」"
]
},
{
"id": 20992,
"kind": "msg",
"jp": [
"「いや、読もうとはしたんだ。",
"椿って名前が出てきてるやつ",
"くらいはと思ってさ」"
]
},
{
"id": 20993,
"kind": "msg",
"jp": [
"「なんとか館の殺人、とかって",
"タイトルだし今回の芝居と",
"関係あるのかもしれねーし」"
]
},
{
"id": 20994,
"kind": "msg",
"jp": [
"「頑張って読もうとはしたんだ",
"けどな・・・途中で挫折した」"
]
},
{
"id": 20995,
"kind": "msg",
"jp": [
"「難しかったの?」"
]
},
{
"id": 20996,
"kind": "msg",
"jp": [
"「大量に字が並んでると",
"それだけで疲れないか?」"
]
},
{
"id": 20997,
"kind": "msg",
"jp": [
"「・・・台本は?」"
]
},
{
"id": 20998,
"kind": "msg",
"jp": [
"「ああ、それは平気だ。",
"台詞が多いから」"
]
},
{
"id": 20999,
"kind": "msg",
"jp": [
"・・・多いというか、ほとんど台詞",
"なんじゃないだろうか。"
]
},
{
"id": 21000,
"kind": "msg",
"jp": [
"「あのさ、斑井さんのこと",
"なんだけど・・・」"
]
},
{
"id": 21001,
"kind": "msg",
"jp": [
"「うっとうしいオッサンだったけどな",
"何も殺すことねーよな」"
]
},
{
"id": 21002,
"kind": "msg",
"jp": [
"「つーか、ああいう",
"うるさいのが急にいなくなると",
"無駄にへこむんだよ、こっちが」"
]
},
{
"id": 21003,
"kind": "msg",
"jp": [
"「・・・生きてる時は",
"うぜーなあと思ってたんだがなあ」"
]
},
{
"id": 21004,
"kind": "msg",
"jp": [
"「でも普通、それくらいで",
"殺したりしないよね」"
]
},
{
"id": 21005,
"kind": "msg",
"jp": [
"「そんなことやってたら",
"あのオッサンもう50年は前に",
"死んでるぞ」"
]
},
{
"id": 21006,
"kind": "msg",
"jp": [
"「あ、あの、それ多分",
"産まれてないんじゃ・・・」"
]
},
{
"id": 21007,
"kind": "msg",
"jp": [
"「あの・・・",
"那須さんのことなんだけどね」"
]
},
{
"id": 21008,
"kind": "msg",
"jp": [
"「・・・殺しても死なねえと",
"思ってたのにな・・・」"
]
},
{
"id": 21009,
"kind": "msg",
"jp": [
"「あんだけ鍛えてたって",
"毒じゃあ、どうしようもねえんだな」"
]
},
{
"id": 21010,
"kind": "msg",
"jp": [
"「だからちったぁ警戒しろって",
"言ったのに、鍵も掛けねえから・・・」"
]
},
{
"id": 21011,
"kind": "msg",
"jp": [
"「暗石さんなんだけどさ・・・」"
]
},
{
"id": 21012,
"kind": "msg",
"jp": [
"「・・・あれだけ警戒してたのに",
"あっけねえもんだな」"
]
},
{
"id": 21013,
"kind": "msg",
"jp": [
"「しかも引きこもってたから",
"いつ死んだのかもよくわかんねー",
"じゃねえかよ・・・」"
]
},
{
"id": 21014,
"kind": "msg",
"jp": [
"問題はそこなんだよな。",
"暗石さんは一体、いつ・・・。"
]
},
{
"id": 21015,
"kind": "msg",
"jp": [
"「・・・鈴奈ちゃん、なんだけど」"
]
},
{
"id": 21016,
"kind": "msg",
"jp": [
"「ああ、あいつ・・・",
"静奈の方はまだ部屋か」"
]
},
{
"id": 21017,
"kind": "msg",
"jp": [
"「出てこないよ」"
]
},
{
"id": 21018,
"kind": "msg",
"jp": [
"「大丈夫なのか?",
"その、片方は殺されちまったけど",
"もう1人は・・・」"
]
},
{
"id": 21019,
"kind": "msg",
"jp": [
"「片方だけですむのか?」"
]
},
{
"id": 21020,
"kind": "msg",
"jp": [
"「・・・わからない・・・」"
]
},
{
"id": 21021,
"kind": "msg",
"jp": [
"「・・・くそっ、",
"いつまで続くんだよ・・・」"
]
},
{
"id": 21022,
"kind": "msg",
"jp": [
"「・・・静奈ちゃん、なんだけど」"
]
},
{
"id": 21023,
"kind": "msg",
"jp": [
"「ああ、あいつ・・・",
"妹の方はまだ部屋か」"
]
},
{
"id": 21024,
"kind": "msg",
"jp": [
"「うん、出てこない・・・」"
]
},
{
"id": 21025,
"kind": "msg",
"jp": [
"「あのさ、南雲さんのこと",
"なんだけど・・・」"
]
},
{
"id": 21026,
"kind": "msg",
"jp": [
"「・・・やっぱ、もう",
"死んでんのかな・・・」"
]
},
{
"id": 21027,
"kind": "msg",
"jp": [
"「井戸の中のあれ、",
"そうじゃねーの?」"
]
},
{
"id": 21028,
"kind": "msg",
"jp": [
"「椿くんは、あの人が",
"南雲さんだと思う?」"
]
},
{
"id": 21029,
"kind": "msg",
"jp": [
"「思う、つーか・・・",
"ぶっちゃけオレ四倉さんじゃねーかと",
"思ってんだけど」"
]
},
{
"id": 21030,
"kind": "msg",
"jp": [
"「え、あの、それは南雲さんが?",
"それとも・・・井戸の・・・」"
]
},
{
"id": 21031,
"kind": "msg",
"jp": [
"「両方だよ両方。",
"井戸の中のが四倉さんで、",
"南雲役で呼ばれてたんじゃねーかって」"
]
},
{
"id": 21032,
"kind": "msg",
"jp": [
"「ああ・・」"
]
},
{
"id": 21033,
"kind": "msg",
"jp": [
"「だってよ、それ以外でこの館で",
"死体になってるってあり得ねーだろ」"
]
},
{
"id": 21034,
"kind": "msg",
"jp": [
"「そうじゃなかったら全然関係ねえ",
"オッサンがなぜか死んでたってことに",
"なっちまうじゃねーか」"
]
},
{
"id": 21035,
"kind": "msg",
"jp": [
"「・・・ただ、どっちにしろ",
"駐車場には誰だかわからん奴が",
"いたことにはなるんだけどよ」"
]
},
{
"id": 21036,
"kind": "msg",
"jp": [
"「四倉さんが犯人ってのよりは",
"得体の知れないのが暴れてるって方が",
"まだあり得そうなんだよな・・・」"
]
},
{
"id": 21037,
"kind": "msg",
"jp": [
"「四倉さんは犯人っぽく",
"ないってこと?」"
]
},
{
"id": 21038,
"kind": "msg",
"jp": [
"「つーかオレ、四倉さんに",
"復讐とか言われる覚えが全然",
"ねーんだもんよ」"
]
},
{
"id": 21039,
"kind": "msg",
"jp": [
"「そっか・・・。",
"四倉さんが犯人だとここにいる",
"全員を恨んでる事になるよね」"
]
},
{
"id": 21040,
"kind": "msg",
"jp": [
"「恨まれるほど親しくした",
"覚えもねーしなあ・・・」"
]
},
{
"id": 21041,
"kind": "msg",
"jp": [
"「椿くんは、四倉欣治さんって",
"人のことよく知ってる?」"
]
},
{
"id": 21042,
"kind": "msg",
"jp": [
"「よくは知らねえな・・・。",
"滝プロ所属ってことと、あとは",
"ちょっと変わり者ってくらいしか」"
]
},
{
"id": 21043,
"kind": "msg",
"jp": [
"「趣味がな。",
"心霊スポットめぐりだった」"
]
},
{
"id": 21044,
"kind": "msg",
"jp": [
"あまり、お近づきになりたくない人",
"みたいだ・・・。"
]
},
{
"id": 21045,
"kind": "msg",
"jp": [
"「池内梨奈さんって人",
"知らない?」"
]
},
{
"id": 21046,
"kind": "msg",
"jp": [
"「池内・・・?",
"誰だっけ、どっかで名前聞いたこと",
"あるような・・・」"
]
},
{
"id": 21047,
"kind": "msg",
"jp": [
"「なんか、ちょっと前に",
"自殺しちゃったって・・・」"
]
},
{
"id": 21048,
"kind": "msg",
"jp": [
"「あっ、思い出した!",
"そうだニュースで見たんだ」"
]
},
{
"id": 21049,
"kind": "msg",
"jp": [
"「周りも結構騒いでたからな、",
"それで覚えてたのか・・・」"
]
},
{
"id": 21050,
"kind": "msg",
"jp": [
"「直接は知らない?」"
]
},
{
"id": 21051,
"kind": "msg",
"jp": [
"「ああ、知らねえやつだよ」"
]
},
{
"id": 21052,
"kind": "msg",
"jp": [
"「いや、そう言えば",
"あいつすげえショック",
"受けてたな・・・」"
]
},
{
"id": 21053,
"kind": "msg",
"jp": [
"「・・・そんな面識とか",
"ないはずなのに・・・」"
]
},
{
"id": 21054,
"kind": "msg",
"jp": [
"「誰が?」"
]
},
{
"id": 21055,
"kind": "msg",
"jp": [
"「みき・・・あ、いや",
"ちょっと知り合いがな」"
]
},
{
"id": 21056,
"kind": "msg",
"jp": [
"「気にすんな、",
"お前の知らない奴だよ」"
]
},
{
"id": 21057,
"kind": "msg",
"jp": [
"「・・・?",
"うん・・・」"
]
},
{
"id": 21058,
"kind": "msg",
"jp": [
"「里江みどりさんって人",
"知ってる?」"
]
},
{
"id": 21059,
"kind": "msg",
"jp": [
"「里江・・・?",
"誰だそれ?」"
]
},
{
"id": 21060,
"kind": "msg",
"jp": [
"「かなり昔のアイドルみたい」"
]
},
{
"id": 21061,
"kind": "msg",
"jp": [
"「知らねえよ。",
"聞いたことねえし、もう引退",
"してんじゃねーの?」"
]
},
{
"id": 21062,
"kind": "msg",
"jp": [
"「あのさ、御陵さんって昔、",
"アイドルだったんだって」"
]
},
{
"id": 21063,
"kind": "msg",
"jp": [
"「アイドルぅ!?",
"へ、へえ・・・そうなのか・・・」"
]
},
{
"id": 21064,
"kind": "msg",
"jp": [
"「いやまあ、美人だしな。",
"ふーん・・・・」"
]
},
{
"id": 21065,
"kind": "msg",
"jp": [
"「その当時のことは、",
"全然知らない?」"
]
},
{
"id": 21066,
"kind": "msg",
"jp": [
"「今初めて聞いたよ。",
"アイドルねえ・・・」"
]
},
{
"id": 21067,
"kind": "msg",
"jp": [
"「なんでやめちまったんだろ。",
"今は小せえ舞台の仕事ばっか",
"やってるよな」"
]
},
{
"id": 21068,
"kind": "msg",
"jp": [
"「お芝居の方が好きなんじゃない?」"
]
},
{
"id": 21069,
"kind": "msg",
"jp": [
"「そうなのかね。",
"まあ、アイドルの方ですげー売れてたら",
"嫌でも事務所が辞めさせねーだろけど」"
]
},
{
"id": 21070,
"kind": "msg",
"jp": [
"「そういうもんなの?」"
]
},
{
"id": 21071,
"kind": "msg",
"jp": [
"「そりゃそうだろ。",
"儲かってたら、稼げるだけ稼がせるさ」"
]
},
{
"id": 21072,
"kind": "msg",
"jp": [
"「椿くん、ルロイ伯爵って",
"知ってる?」"
]
},
{
"id": 21073,
"kind": "msg",
"jp": [
"「っ・・・",
"お、お前それ・・・」"
]
},
{
"id": 21074,
"kind": "msg",
"jp": [
"「あー・・・まあいいや、",
"ばれちゃしょーがねえ」"
]
},
{
"id": 21075,
"kind": "msg",
"jp": [
"「そうだよ、この館は元はその",
"危ねえ伯爵さまのお城だったのさ」"
]
},
{
"id": 21076,
"kind": "msg",
"jp": [
"「あ、危ない!?」"
]
},
{
"id": 21077,
"kind": "msg",
"jp": [
"「・・・んだよ、知ってて",
"聞いたんじゃねーのか?」"
]
},
{
"id": 21078,
"kind": "msg",
"jp": [
"「危ないってどう危ないの?",
"館の構造が危ないの?」"
]
},
{
"id": 21079,
"kind": "msg",
"jp": [
"「そーじゃなくて、ルロイって",
"伯爵がヤバいオッサンだったってこと」"
]
},
{
"id": 21080,
"kind": "msg",
"jp": [
"「黒魔術とか生け贄とか、",
"悪魔召喚するとかなんかそんなん」"
]
},
{
"id": 21081,
"kind": "msg",
"jp": [
"「この館でっ!?」"
]
},
{
"id": 21082,
"kind": "msg",
"jp": [
"「やってたとしても、この館には",
"そんな儀式みたいなもん出来そうな",
"部屋ねーから大丈夫だろ」"
]
},
{
"id": 21083,
"kind": "msg",
"jp": [
"「伯爵の城ったって、もっとでかいのの",
"ほんの一部持ってきただけなんだから」"
]
},
{
"id": 21084,
"kind": "msg",
"jp": [
"「そ・・そっか・・・」"
]
},
{
"id": 21085,
"kind": "msg",
"jp": [
"「ただ、その伯爵の呪いは",
"未だにこの館に残ってる",
"とかいう噂だけど」"
]
},
{
"id": 21086,
"kind": "msg",
"jp": [
"「そう言えば、",
"そんなこと言ってたね・・・」"
]
},
{
"id": 21087,
"kind": "msg",
"jp": [
"「さすがに、今この館で",
"起きてることは伯爵の呪いじゃ",
"ねーだろうと思うけどな」"
]
},
{
"id": 21088,
"kind": "msg",
"jp": [
"「の・・呪われてるって言うか",
"誰かに伯爵が乗り移ってるとか",
"そんなことはないよね・・・?」"
]
},
{
"id": 21089,
"kind": "msg",
"jp": [
"「怖いこと言うなっ!",
"そんなんだったら今の当主が",
"まず生きてねーだろうが」"
]
},
{
"id": 21090,
"kind": "msg",
"jp": [
"「そ、そっか。",
"今の当主の人は元気なんだ」"
]
},
{
"id": 21091,
"kind": "msg",
"jp": [
"「もしかして、",
"この館にはあんまり来ないの?」"
]
},
{
"id": 21092,
"kind": "msg",
"jp": [
"「逆だ。",
"すっかり気に入っちまって",
"しょっちゅう入り浸ってる」"
]
},
{
"id": 21093,
"kind": "msg",
"jp": [
"「オークションでルロイ伯爵家",
"ゆかりの品とか落札したりな」"
]
},
{
"id": 21094,
"kind": "msg",
"jp": [
"「まー、興味あるなら",
"書斎あさってみろよ」"
]
},
{
"id": 21095,
"kind": "msg",
"jp": [
"「多分、その手の本なら",
"けっこう転がってるはずだから」"
]
},
{
"id": 21096,
"kind": "msg",
"jp": [
"「高遠さんの小説に出てくる",
"北速水涼介って知ってる?」"
]
},
{
"id": 21097,
"kind": "msg",
"jp": [
"「ああ、それ主人公だろ?",
"名探偵っていうやつ」"
]
},
{
"id": 21098,
"kind": "msg",
"jp": [
"「・・・けどなんか、",
"変な奴だったような・・・」"
]
},
{
"id": 21099,
"kind": "msg",
"jp": [
"「かなり変わった人みたいだね」"
]
},
{
"id": 21100,
"kind": "msg",
"jp": [
"「オレが読んだ話だと、依頼人の家に",
"泊り込む事になったとき、その家の",
"飼い猫と一緒に寝るって駄々こねてた」"
]
},
{
"id": 21101,
"kind": "msg",
"jp": [
"「あの・・・",
"それ、仕事で行ったんだよね?」"
]
},
{
"id": 21102,
"kind": "msg",
"jp": [
"「仕事だよ、もちろん。",
"そんなことしてんのに、",
"事件だけはちゃんと解決すんだよな」"
]
},
{
"id": 21103,
"kind": "msg",
"jp": [
"「きっと生まれつき才能とか能力とか",
"全部が推理力に偏ってんだな、あいつ」"
]
},
{
"id": 21104,
"kind": "msg",
"jp": [
"「・・・だろうね・・・」"
]
},
{
"id": 21105,
"kind": "msg",
"jp": [
"「こっちの日織じゃなくて、",
"原作の方の日織諒って知ってる?」"
]
},
{
"id": 21106,
"kind": "msg",
"jp": [
"「あー、高遠の方のやつ?",
"あいつ馬鹿だよなあ」"
]
},
{
"id": 21107,
"kind": "msg",
"jp": [
"「馬鹿なの?」"
]
},
{
"id": 21108,
"kind": "msg",
"jp": [
"「だって、あの変な探偵に",
"振り回されすぎだろ。",
"なんで面倒見ちまうんだか」"
]
},
{
"id": 21109,
"kind": "msg",
"jp": [
"「まあ、涼介って放っとくと",
"何もしねーから干からびて死んでそうで",
"怖いのかも知れんけど」"
]
},
{
"id": 21110,
"kind": "msg",
"jp": [
"「お人よしなのかな」"
]
},
{
"id": 21111,
"kind": "msg",
"jp": [
"「・・・だろうな。",
"現実にもたまにいるよな",
"やたら世話好きなやつ」"
]
},
{
"id": 21112,
"kind": "msg",
"jp": [
"・・・こっちの日織にもちょっと",
"似てるかもしれない・・・。"
]
},
{
"id": 21113,
"kind": "msg",
"jp": [
"「陣野警部って人知ってる?",
"高遠さんの話に出てくる人」"
]
},
{
"id": 21114,
"kind": "msg",
"jp": [
"「あー、名前だけは・・・",
"そのオッサンが出てくる話は",
"あんまり読んでねーんだよな」"
]
},
{
"id": 21115,
"kind": "msg",
"jp": [
"「読んだことあるやつに聞いたら",
"渋いオッサンでかっこいいって話",
"なんだけどな」"
]
},
{
"id": 21116,
"kind": "msg",
"jp": [
"「・・・主役がアレだから、",
"まあ、1人くらいはマトモな奴が",
"レギュラーに居ないとやばいよな」"
]
},
{
"id": 21117,
"kind": "msg",
"jp": [
"「そういう問題なの・・・?」"
]
},
{
"id": 21118,
"kind": "msg",
"jp": [
"「だってお前、涼介って",
"オレらと別の時空に半分はみ出して",
"生きてんのかってくらい常識ないぞ」"
]
},
{
"id": 21119,
"kind": "msg",
"jp": [
"「・・・そうなんだ・・・」"
]
},
{
"id": 21120,
"kind": "msg",
"jp": [
"「高遠さんの小説でさ、",
"波積駿二って人が出てくる話",
"覚えてる?」"
]
},
{
"id": 21121,
"kind": "msg",
"jp": [
"「波積? 誰だそれ?」"
]
},
{
"id": 21122,
"kind": "msg",
"jp": [
"「あ、知らないか」"
]
},
{
"id": 21123,
"kind": "msg",
"jp": [
"「高遠のって全部読んで",
"ねーからな、オレは」"
]
},
{
"id": 21124,
"kind": "msg",
"jp": [
"「高遠さんの方の斑井さんって",
"重雄さんって言うんだよね」"
]
},
{
"id": 21125,
"kind": "msg",
"jp": [
"「へえ? そんな名前なの?」"
]
},
{
"id": 21126,
"kind": "msg",
"jp": [
"「なんてったっけ黒猫が",
"どーとかいう話だよな。",
"読んでねえけど」"
]
},
{
"id": 21127,
"kind": "msg",
"jp": [
"「『黒猫の毒』だよ」"
]
},
{
"id": 21128,
"kind": "msg",
"jp": [
"「猫が毒持ってたら怖ぇな」"
]
},
{
"id": 21129,
"kind": "msg",
"jp": [
"「怖いよ!",
"僕もう500回くらい死んでるよ」"
]
},
{
"id": 21130,
"kind": "msg",
"jp": [
"「・・・どんだけ噛まれてんだ」"
]
},
{
"id": 21131,
"kind": "msg",
"jp": [
"「うちの猫、遊ぶのに夢中になると",
"かじってくるんだよ、手とか足とか。",
"うちの親は噛まれないのに・・・」"
]
},
{
"id": 21132,
"kind": "msg",
"jp": [
"「お前それ、絶対猫はお前は",
"噛んでもいい相手だと思ってるぞ」"
]
},
{
"id": 21133,
"kind": "msg",
"jp": [
"「なんでー!?",
"僕が家に居るときは、",
"餌の用意するのも僕なのに!」"
]
},
{
"id": 21134,
"kind": "msg",
"jp": [
"「親じゃねーのかよ!?",
"そりゃお前噛んでいいどころか",
"下僕だと思われてるって!」"
]
},
{
"id": 21135,
"kind": "msg",
"jp": [
"「な、なんだよ",
"そこまで泣きそうな顔",
"しなくても・・・」"
]
},
{
"id": 21136,
"kind": "msg",
"jp": [
"「いや、ちょっと・・・",
"姉ちゃんと同じ事言われたから」"
]
},
{
"id": 21137,
"kind": "msg",
"jp": [
"「姉貴と?」"
]
},
{
"id": 21138,
"kind": "msg",
"jp": [
"「あんたってありとあらゆる猫に",
"初対面で下僕扱いされるねって」"
]
},
{
"id": 21139,
"kind": "msg",
"jp": [
"「・・・されんの?」"
]
},
{
"id": 21140,
"kind": "msg",
"jp": [
"「なんかベンチとかに座ってたら",
"どこからか来た知らない猫が",
"膝に乗っかって寝たりする」"
]
},
{
"id": 21141,
"kind": "msg",
"jp": [
"「あきらめろ。",
"そういう体質なんだわ、お前」"
]
},
{
"id": 21142,
"kind": "msg",
"jp": [
"「黒園龍哉っていう人",
"知らない?」"
]
},
{
"id": 21143,
"kind": "msg",
"jp": [
"「黒園って誰だ?",
"聞いたことねーけど」"
]
},
{
"id": 21144,
"kind": "msg",
"jp": [
"「高遠さんの話に出てくる人」"
]
},
{
"id": 21145,
"kind": "msg",
"jp": [
"「なんだ、そんなもん",
"覚えてねーよ。",
"多分読んでねーし」"
]
},
{
"id": 21146,
"kind": "msg",
"jp": [
"「古折みづえっていう人が",
"出てくる話でさ・・・」"
]
},
{
"id": 21147,
"kind": "msg",
"jp": [
"「話? なんの?」"
]
},
{
"id": 21148,
"kind": "msg",
"jp": [
"「あ、高遠さんの」"
]
},
{
"id": 21149,
"kind": "msg",
"jp": [
"「あー、読んだかな・・・",
"覚えてねーや、その名前」"
]
},
{
"id": 21150,
"kind": "msg",
"jp": [
"「高遠さんの話に出てくる",
"佐伯老人っていう人・・・」"
]
},
{
"id": 21151,
"kind": "msg",
"jp": [
"「誰だよそれ?",
"多分、読んでねーぞその話」"
]
},
{
"id": 21152,
"kind": "msg",
"jp": [
"「そっか、じゃあいいや」"
]
},
{
"id": 21153,
"kind": "msg",
"jp": [
"「読んでねえ話のが多いぞ、オレ。",
"日織あたりに聞いた方が詳しいって」"
]
},
{
"id": 21154,
"kind": "msg",
"jp": [
"「暁生光起っていう人",
"覚えてる?」"
]
},
{
"id": 21155,
"kind": "msg",
"jp": [
"「誰だそれ?」"
]
},
{
"id": 21156,
"kind": "msg",
"jp": [
"「高遠さんの小説に出てくる",
"画家の人なんだけど」"
]
},
{
"id": 21157,
"kind": "msg",
"jp": [
"「画家ぁ?",
"画家が出てくる話なんか",
"読んだっけなあ・・・」"
]
},
{
"id": 21158,
"kind": "msg",
"jp": [
"「覚えてねーや、悪ぃけど」"
]
},
{
"id": 21159,
"kind": "msg",
"jp": [
"「滝重三郎っていう人",
"覚えてない?」"
]
},
{
"id": 21160,
"kind": "msg",
"jp": [
"「滝重って・・・",
"どっかで聞いたな、その名前」"
]
},
{
"id": 21161,
"kind": "msg",
"jp": [
"「誰だったかなあ・・・",
"えーと・・・」"
]
},
{
"id": 21162,
"kind": "msg",
"jp": [
"「高遠さんの小説に出て",
"来るんだけど・・・」"
]
},
{
"id": 21163,
"kind": "msg",
"jp": [
"「いや、それじゃねえ。",
"そうじゃなくて・・・」"
]
},
{
"id": 21164,
"kind": "msg",
"jp": [
"「・・・あ、思い出した!",
"中学ん時の英語の先生と",
"同じ名前だ!」"
]
},
{
"id": 21165,
"kind": "msg",
"jp": [
"「あー、すっきりした」"
]
},
{
"id": 21166,
"kind": "msg",
"jp": [
"「・・・おう、そうだ。",
"高遠の方は読んでないから知らねーぞ」"
]
},
{
"id": 21167,
"kind": "msg",
"jp": [
"「小此木っていう古物屋さん",
"覚えてないかな」"
]
},
{
"id": 21168,
"kind": "msg",
"jp": [
"「おこのぎ?",
"誰だそれ?」"
]
},
{
"id": 21169,
"kind": "msg",
"jp": [
"「えーと、高遠さんの小説に",
"出てくるんだけど」"
]
},
{
"id": 21170,
"kind": "msg",
"jp": [
"「・・・いたっけ、そんな奴。",
"全然覚えてねーや」"
]
},
{
"id": 21171,
"kind": "msg",
"jp": [
"「じゃあ読んでない話",
"なのかな?」"
]
},
{
"id": 21172,
"kind": "msg",
"jp": [
"「いや、読んでても覚えて",
"ないかもしれん」"
]
},
{
"id": 21173,
"kind": "msg",
"jp": [
"「原作の方の那須さんって",
"信さんって名前なんだね」"
]
},
{
"id": 21174,
"kind": "msg",
"jp": [
"「そうだっけ?",
"ああ、それ読んでねーや」"
]
},
{
"id": 21175,
"kind": "msg",
"jp": [
"「・・・なあ、まさかと思うけど",
"原作の那須もあんなんなのか」"
]
},
{
"id": 21176,
"kind": "msg",
"jp": [
"「いや、あの、僕もちゃんと",
"読んでないけど違うと思う」"
]
},
{
"id": 21177,
"kind": "msg",
"jp": [
"「そうか・・・。",
"まあ、そうだよな推理小説なんだし",
"あんな奴出るわけ・・・」"
]
},
{
"id": 21178,
"kind": "msg",
"jp": [
"「・・・普通出ないよな。",
"なんであの筋肉はこんな推理小説じみた",
"騒ぎに巻き込まれてやがるんだ」"
]
},
{
"id": 21179,
"kind": "msg",
"jp": [
"「な、なんでって、そりゃ多分",
"犯人が呼んだからじゃ・・・」"
]
},
{
"id": 21180,
"kind": "msg",
"jp": [
"「おかしいぞ犯人。",
"あんなもん呼ぶなら、もっとこう",
"無駄に爽やかな騒ぎ起こせってんだよ」"
]
},
{
"id": 21181,
"kind": "msg",
"jp": [
"「・・・爽やかな殺人犯って",
"あんまりいないと思う・・・」"
]
},
{
"id": 21182,
"kind": "msg",
"jp": [
"「だって腹立つじゃねーか!",
"どう考えても間違ってるだろ!?」"
]
},
{
"id": 21183,
"kind": "msg",
"jp": [
"「うん、まあ、小説なら",
"おかしいだろうけど・・・」"
]
},
{
"id": 21184,
"kind": "msg",
"jp": [
"「・・・・くそっ。",
"わかってるよ、小説じゃあねーよ」"
]
},
{
"id": 21185,
"kind": "msg",
"jp": [
"「・・・けどよ」"
]
},
{
"id": 21186,
"kind": "msg",
"jp": [
"「この犯人、なんかこう",
"高遠っぽいこといろいろやってるだろ」"
]
},
{
"id": 21187,
"kind": "msg",
"jp": [
"「温室に変なもの置いたり、",
"死体をいじくったりさ」"
]
},
{
"id": 21188,
"kind": "msg",
"jp": [
"「ああ、うん」"
]
},
{
"id": 21189,
"kind": "msg",
"jp": [
"「高遠みたいな、不気味で",
"おどろおどろしい雰囲気にしたかったん",
"だったら・・・」"
]
},
{
"id": 21190,
"kind": "msg",
"jp": [
"「那須がその雰囲気ぶち壊してんの",
"見て頭抱えてっかもな。",
"だったらざまーみろなんだが」"
]
},
{
"id": 21191,
"kind": "msg",
"jp": [
"「・・・そうかもね」"
]
},
{
"id": 21192,
"kind": "msg",
"jp": [
"「高遠さんの話に出てくる",
"ともえって女の人さ・・・」"
]
},
{
"id": 21193,
"kind": "msg",
"jp": [
"「あー・・・",
"なんか映画になったことある話に",
"出てくんだよな、確か」"
]
},
{
"id": 21194,
"kind": "msg",
"jp": [
"「なんだっけ、なんとかの島",
"だったよな」"
]
},
{
"id": 21195,
"kind": "msg",
"jp": [
"「『忘れじの島』だよ」"
]
},
{
"id": 21196,
"kind": "msg",
"jp": [
"「あー、それそれ。",
"一番面白いって薦められてんだけど",
"まだ読んでねーんだよな・・・」"
]
},
{
"id": 21197,
"kind": "msg",
"jp": [
"「ともえってのがなあ」"
]
},
{
"id": 21198,
"kind": "msg",
"jp": [
"「ともえが、何?」"
]
},
{
"id": 21199,
"kind": "msg",
"jp": [
"「・・・おふくろと同じ名前なんだ」"
]
},
{
"id": 21200,
"kind": "msg",
"jp": [
"「それは・・・ちょっと気になる",
"かもしれないね・・・」"
]
},
{
"id": 21201,
"kind": "msg",
"jp": [
"「なるだろ、オレの本名は",
"そうそう出てこねーけど、",
"親は多いんだよな・・・」"
]
},
{
"id": 21202,
"kind": "msg",
"jp": [
"「お前も自分の名前はあんま",
"ない名前だよな」"
]
},
{
"id": 21203,
"kind": "msg",
"jp": [
"「うん、僕も親も、",
"同じ名前の人って聞いたこと",
"ないなあ・・・」"
]
},
{
"id": 21204,
"kind": "msg",
"jp": [
"「親の名前も珍しいのか?」"
]
},
{
"id": 21205,
"kind": "msg",
"jp": [
"「父親が統率の統の字で『まとむ』、",
"母親が鳥の鶴って書いて『つう』だよ」"
]
},
{
"id": 21206,
"kind": "msg",
"jp": [
"「こ・・個性的だな・・・",
"つうか、お前のおふくろさん",
"はた織って飛んできそうじゃねえ?」"
]
},
{
"id": 21207,
"kind": "msg",
"jp": [
"「ボタンつけようとしたら",
"自分の指縫う人だから大丈夫",
"だと思う・・・」"
]
},
{
"id": 21208,
"kind": "msg",
"jp": [
"「・・・そうか、よかったな」"
]
},
{
"id": 21209,
"kind": "msg",
"jp": [
"・・・なんか違う気がする・・。",
"何の話だったっけ。"
]
},
{
"id": 21210,
"kind": "msg",
"jp": [
"「原作の御陵さんは、花織さんって",
"いう名前だったよね」"
]
},
{
"id": 21211,
"kind": "msg",
"jp": [
"「あー、確かそうだったかな。",
"まだ読んでねえけど」"
]
},
{
"id": 21212,
"kind": "msg",
"jp": [
"「・・・けど、あれも御陵さん",
"死んじまう話だよな・・・」"
]
},
{
"id": 21213,
"kind": "msg",
"jp": [
"「高遠さんの話に出てくる",
"暗石丈治って人さあ・・・」"
]
},
{
"id": 21214,
"kind": "msg",
"jp": [
"「オッサンが出てくるやつ?",
"それ、読んでねーや」"
]
},
{
"id": 21215,
"kind": "msg",
"jp": [
"「自分の読むのが精一杯",
"だったしさあ・・・」"
]
},
{
"id": 21216,
"kind": "msg",
"jp": [
"「つーか、名前使ってるだけで",
"内容はあんま関係なさそうじゃねえ?」"
]
},
{
"id": 21217,
"kind": "msg",
"jp": [
"「うん、そうみたいだね」"
]
},
{
"id": 21218,
"kind": "msg",
"jp": [
"「高遠さんの小説にも",
"女優さんが出てくるんだよね、",
"絹田ユリって人」"
]
},
{
"id": 21219,
"kind": "msg",
"jp": [
"「へえ、そうなのか?",
"聞いたことない名前だし",
"知らねー話みたいだけど・・・」"
]
},
{
"id": 21220,
"kind": "msg",
"jp": [
"「『花魁はなぜ殺される』って",
"いう話だったと思うよ」"
]
},
{
"id": 21221,
"kind": "msg",
"jp": [
"「あ、全然知らねーわ」"
]
},
{
"id": 21222,
"kind": "msg",
"jp": [
"「原作の椿くんは執事じゃなくて",
"当主なんだよね」"
]
},
{
"id": 21223,
"kind": "msg",
"jp": [
"「そーなんだよ、なんでオレ",
"執事になってんだっての」"
]
},
{
"id": 21224,
"kind": "msg",
"jp": [
"「・・・まあ、その、",
"原作の方もまだ読んでる途中",
"なんだけどさ・・・」"
]
},
{
"id": 21225,
"kind": "msg",
"jp": [
"「えーと、今・・・",
"涼介達が棺開けさせろって館の",
"他の奴ともめてるとこかな」"
]
},
{
"id": 21226,
"kind": "msg",
"jp": [
"「あの、それってかなり",
"序盤なんじゃ・・・」"
]
},
{
"id": 21227,
"kind": "msg",
"jp": [
"「しょうがねーだろ!",
"苦手なんだよ、長い文章読むの!」"
]
},
{
"id": 21228,
"kind": "msg",
"jp": [
"「・・・台本は?",
"かなり長いのもあるんじゃないの?」"
]
},
{
"id": 21229,
"kind": "msg",
"jp": [
"「台本はほら、ほとんど台詞だろ。",
"小説ってなんか台詞以外がだらだら",
"長いじゃねーか」"
]
},
{
"id": 21230,
"kind": "msg",
"jp": [
"「ああ、そっか。",
"なるほど・・・」"
]
},
{
"id": 21231,
"kind": "msg",
"jp": [
"「それにさ、原作の椿ってオッサン",
"別にオレの役と全然関係なさそうだし」"
]
},
{
"id": 21232,
"kind": "msg",
"jp": [
"「うん、まあ当主だしね」"
]
},
{
"id": 21233,
"kind": "msg",
"jp": [
"「・・・ここの館の当主とも",
"似ても似つかねーけどな」"
]
},
{
"id": 21234,
"kind": "msg",
"jp": [
"「あんなの1人いりゃ十分だ」"
]
},
{
"id": 21235,
"kind": "msg",
"jp": [
"・・・それは原作の椿氏のことなのか",
"こっちの当主の人のことなのか。"
]
},
{
"id": 21236,
"kind": "msg",
"jp": [
"「あのさ、高遠さんの話に出てくる",
"東雲多岐っていう人・・・」"
]
},
{
"id": 21237,
"kind": "msg",
"jp": [
"「しのの・・・何?」"
]
},
{
"id": 21238,
"kind": "msg",
"jp": [
"「東雲多岐さん。",
"えーと、『絵の中の死』って話に",
"出てくる人なんだけど」"
]
},
{
"id": 21239,
"kind": "msg",
"jp": [
"「・・・あれ『しののめ』って",
"読むのか・・・」"
]
},
{
"id": 21240,
"kind": "msg",
"jp": [
"「・・・・へ?」"
]
},
{
"id": 21241,
"kind": "msg",
"jp": [
"「わ、わかんねーだろ、",
"知り合いにでもいなきゃ普段使う",
"ような漢字でもねえんだし!」"
]
},
{
"id": 21242,
"kind": "msg",
"jp": [
"「・・・お前の名前だって",
"最初から聞いてねーと読めねえぞ」"
]
},
{
"id": 21243,
"kind": "msg",
"jp": [
"「あ、それはよくある。",
"特に名前の方は大抵なんて読むのって",
"聞かれる」"
]
},
{
"id": 21244,
"kind": "msg",
"jp": [
"「だろうなあ・・・」"
]
},
{
"id": 21245,
"kind": "msg",
"jp": [
"「原作の方の静奈ちゃんと",
"鈴奈ちゃんって・・・」"
]
},
{
"id": 21246,
"kind": "msg",
"jp": [
"「原作って高遠の?",
"読んでねーってばよ、そんなの」"
]
},
{
"id": 21247,
"kind": "msg",
"jp": [
"「原作でも双子なのか、あいつら?」"
]
},
{
"id": 21248,
"kind": "msg",
"jp": [
"「推理小説ってなんか、",
"双子とか三つ子とかよく出てくるな」"
]
},
{
"id": 21249,
"kind": "msg",
"jp": [
"「入れ替わったりすんのに",
"便利だからか?」"
]
},
{
"id": 21250,
"kind": "msg",
"jp": [
"「まあ・・・",
"書く人にとってはそうなのかも」"
]
},
{
"id": 21251,
"kind": "msg",
"jp": [
"「ふーん、災難だな双子も」"
]
},
{
"id": 21252,
"kind": "msg",
"jp": [
"「そう言えばそうだね・・・」"
]
},
{
"id": 21253,
"kind": "msg",
"jp": [
"「高遠さんの書いた話で",
"虚井家って一族が出てくるやつが",
"あるんだけど・・・」"
]
},
{
"id": 21254,
"kind": "msg",
"jp": [
"「あの、一冊だけ書斎の",
"机の方にあるやつか?」"
]
},
{
"id": 21255,
"kind": "msg",
"jp": [
"「うん、それ。",
"あれ、なんで一冊だけ机の方に",
"置いてあるんだろう?」"
]
},
{
"id": 21256,
"kind": "msg",
"jp": [
"「・・・机の本棚はな、",
"当主が特に気に入ってるやつばっか",
"並んでるんだ・・・」"
]
},
{
"id": 21257,
"kind": "msg",
"jp": [
"・・・けど、なんで微妙な表情になって",
"目をそらすんだろう・・・。"
]
},
{
"id": 21258,
"kind": "msg",
"jp": [
"「この館の元の当主の人んちって",
"ばあやなんているのかな」"
]
},
{
"id": 21259,
"kind": "msg",
"jp": [
"「ばあやぁ?",
"何世紀の館だそりゃ」"
]
},
{
"id": 21260,
"kind": "msg",
"jp": [
"「やっぱり、さすがに",
"ばあやはいないんだ」"
]
},
{
"id": 21261,
"kind": "msg",
"jp": [
"「いねーだろ、普通。",
"今時そんなもん実在すんのか?」"
]
},
{
"id": 21262,
"kind": "msg",
"jp": [
"「するみたいだよ、それが」"
]
},
{
"id": 21263,
"kind": "msg",
"jp": [
"「・・・どうせ雇うなら",
"ばあやよりメイドだよなあ」"
]
},
{
"id": 21264,
"kind": "msg",
"jp": [
"「そういう問題・・・?」"
]
},
{
"id": 21265,
"kind": "msg",
"jp": [
"「い、言っとくけどなんか",
"最近流行ってるそーいう喫茶店とか",
"通ってねーからな?」"
]
},
{
"id": 21266,
"kind": "msg",
"jp": [
"「言ってないって、そんなこと」"
]
},
{
"id": 21267,
"kind": "msg",
"jp": [
"「ばーさんよりはねーちゃんの方が",
"いいってだけの話だからな?」"
]
},
{
"id": 21268,
"kind": "msg",
"jp": [
"「わかってるってば・・・」"
]
},
{
"id": 21269,
"kind": "msg",
"jp": [
"「どうせならメイドより",
"バニーガールとかのがいいし」"
]
},
{
"id": 21270,
"kind": "msg",
"jp": [
"「呆れんなよっ!?",
"普通だろ、男なんだから!」"
]
},
{
"id": 21271,
"kind": "msg",
"jp": [
"「う、うん、まあ・・・」"
]
},
{
"id": 21272,
"kind": "msg",
"jp": [
"なんでバニーガールの話に・・・。"
]
},
{
"id": 21273,
"kind": "msg",
"jp": [
"「本物じゃねえだろ、",
"わかってるさ・・・」"
]
},
{
"id": 21274,
"kind": "msg",
"jp": [
"「本物って、今回みんなを",
"呼び集めたのがってこと?」"
]
},
{
"id": 21275,
"kind": "msg",
"jp": [
"「どう考えても偽者だろ。",
"騙されたんだよ、オレ達は」"
]
},
{
"id": 21276,
"kind": "msg",
"jp": [
"「くそっ・・・",
"話がうますぎると思ったんだよ」"
]
},
{
"id": 21277,
"kind": "msg",
"jp": [
"「暗石さんの・・・",
"ことなんだけど」"
]
},
{
"id": 21278,
"kind": "msg",
"jp": [
"「オッサンの?",
"なんかわかったのか?」"
]
},
{
"id": 21279,
"kind": "msg",
"jp": [
"「実は、最後に暗石さんの姿",
"見たの御陵さんらしくてさ」"
]
},
{
"id": 21280,
"kind": "msg",
"jp": [
"「朝早く、廊下でトイレに行くのを",
"見かけたって言ってるんだけど・・・」"
]
},
{
"id": 21281,
"kind": "msg",
"jp": [
"「朝っていつのだ?」"
]
},
{
"id": 21282,
"kind": "msg",
"jp": [
"「えーと、最初の日から数えて",
"5日目の朝かな・・・?」"
]
},
{
"id": 21283,
"kind": "msg",
"jp": [
"「5日目・・・ああ、わかった。",
"けど、それだったらオレはもう部屋に",
"こもってた頃だなぁ・・・」"
]
},
{
"id": 21284,
"kind": "msg",
"jp": [
"「朝早くって何時ぐらいだ?」"
]
},
{
"id": 21285,
"kind": "msg",
"jp": [
"「6時半くらいだって」"
]
},
{
"id": 21286,
"kind": "msg",
"jp": [
"「そうかぁ・・・。",
"じゃあ、部屋から出てねーな。",
"まだ寝てるわ、オレ」"
]
},
{
"id": 21287,
"kind": "msg",
"jp": [
"「椿くんの部屋の名前って",
"なんだったっけ」"
]
},
{
"id": 21288,
"kind": "msg",
"jp": [
"「クイーンだよ」"
]
},
{
"id": 21289,
"kind": "msg",
"jp": [
"「それって、まんま女王って",
"意味なのかな」"
]
},
{
"id": 21290,
"kind": "msg",
"jp": [
"「直訳すりゃそうだろうけど、",
"ここの部屋って全部作家の名前",
"らしいからな」"
]
},
{
"id": 21291,
"kind": "msg",
"jp": [
"「オレの部屋は",
"国名シリーズとかいうの",
"書いた人なんだと」"
]
},
{
"id": 21292,
"kind": "msg",
"jp": [
"「ふうん?」"
]
},
{
"id": 21293,
"kind": "msg",
"jp": [
"「藍瀬みきちゃんて子",
"知ってる?」"
]
},
{
"id": 21294,
"kind": "msg",
"jp": [
"「ああ、あいつか」"
]
},
{
"id": 21295,
"kind": "msg",
"jp": [
"「知り合いなの?」"
]
},
{
"id": 21296,
"kind": "msg",
"jp": [
"「何度か同じドラマで",
"クラスメイトだったんだよ」"
]
},
{
"id": 21297,
"kind": "msg",
"jp": [
"「クラスメイト?」"
]
},
{
"id": 21298,
"kind": "msg",
"jp": [
"「学園ドラマでな。",
"同じクラスの生徒役ってのが",
"何回か続いたことあって・・・」"
]
},
{
"id": 21299,
"kind": "msg",
"jp": [
"「しかし、あの頃はオレと",
"大差ない脇役だったのに",
"ずいぶん差があいちまったなぁ」"
]
},
{
"id": 21300,
"kind": "msg",
"jp": [
"「なんか突然人気出たよね」"
]
},
{
"id": 21301,
"kind": "msg",
"jp": [
"「帽子屋ブランドは",
"伊達じゃねーってこったろ」"
]
},
{
"id": 21302,
"kind": "msg",
"jp": [
"「・・・けど、あいつ",
"その事言うと嫌がるんだよな」"
]
},
{
"id": 21303,
"kind": "msg",
"jp": [
"「嫌がるってなんで?」"
]
},
{
"id": 21304,
"kind": "msg",
"jp": [
"「うーん・・・",
"嫌がるっつーか・・・」"
]
},
{
"id": 21305,
"kind": "msg",
"jp": [
"「実力じゃなくて帽子屋の",
"名前だけで売れたみたいに",
"思われるのが嫌なのかな」"
]
},
{
"id": 21306,
"kind": "msg",
"jp": [
"「オレも最初はそうなのかと",
"思ったんだけどよ」"
]
},
{
"id": 21307,
"kind": "msg",
"jp": [
"「どうも、なんか違う",
"気がしてな・・・」"
]
},
{
"id": 21308,
"kind": "msg",
"jp": [
"「違うって?」"
]
},
{
"id": 21309,
"kind": "msg",
"jp": [
"「実力じゃねーって思われんのが",
"嫌ならなんかもっと反発するとか",
"怒るとかあるだろ」"
]
},
{
"id": 21310,
"kind": "msg",
"jp": [
"「でもあいつ、ただ辛そうに",
"話題を変えようとするんだよ」"
]
},
{
"id": 21311,
"kind": "msg",
"jp": [
"「普段から、そんな風に",
"あんまり怒ったりしない子なの?」"
]
},
{
"id": 21312,
"kind": "msg",
"jp": [
"「いや全然。",
"普段はもっとはっきり物言う",
"気の強ぇやつだぜ」"
]
},
{
"id": 21313,
"kind": "msg",
"jp": [
"「この話題に限ってだけ",
"妙に歯切れが悪いから",
"なんか気になるんだよな」"
]
},
{
"id": 21314,
"kind": "msg",
"jp": [
"「ふうん・・・",
"そりゃ気になるね」"
]
},
{
"id": 21315,
"kind": "msg",
"jp": [
"「如月百合子さんって",
"女優さん知ってる?」"
]
},
{
"id": 21316,
"kind": "msg",
"jp": [
"「当然だろ、",
"大女優じゃねーかよ」"
]
},
{
"id": 21317,
"kind": "msg",
"jp": [
"「・・・つーか、初めて",
"ドラマで台詞ある役やった時",
"世話になったからなー」"
]
},
{
"id": 21318,
"kind": "msg",
"jp": [
"「ガチガチに緊張してたら",
"すっと近寄ってきてさ」"
]
},
{
"id": 21319,
"kind": "msg",
"jp": [
"「『あんた、何硬くなってんの。",
"いい眼してるのに、もったいない』",
"・・・って言われたんだよ」"
]
},
{
"id": 21320,
"kind": "msg",
"jp": [
"「眼?」"
]
},
{
"id": 21321,
"kind": "msg",
"jp": [
"「眼に力があるんだってさ。",
"最近の若い俳優には少なくなった",
"とかって言ってたな」"
]
},
{
"id": 21322,
"kind": "msg",
"jp": [
"「オレもちゃんと理解してる",
"わけじゃねーんだけどさ・・・」"
]
},
{
"id": 21323,
"kind": "msg",
"jp": [
"「確かに古い映画観ると、",
"今、大御所になってる役者って",
"若い頃から目つきが違うんだよな」"
]
},
{
"id": 21324,
"kind": "msg",
"jp": [
"「それでまあ、なんとなく",
"ちょっと自信ついたってーか」"
]
},
{
"id": 21325,
"kind": "msg",
"jp": [
"「・・・なんでこんな話に",
"なってんだよ!?」"
]
},
{
"id": 21326,
"kind": "msg",
"jp": [
"「な、なんで怒るのさ?」"
]
},
{
"id": 21327,
"kind": "msg",
"jp": [
"「うるせーな、",
"だから、まあ、アレだ。",
"いい人なんだよ如月さんは」"
]
},
{
"id": 21328,
"kind": "msg",
"jp": [
"「それでいいだろ、もう!」"
]
},
{
"id": 21329,
"kind": "msg",
"jp": [
"「・・・なんだ、照れてるのか」"
]
},
{
"id": 21330,
"kind": "msg",
"jp": [
"「なんか言ったか!?」"
]
},
{
"id": 21331,
"kind": "msg",
"jp": [
"「なんでもない、なんでもない」"
]
},
{
"id": 21332,
"kind": "msg",
"jp": [
"「あのさ、成瀬公康って",
"言う人・・・」"
]
},
{
"id": 21333,
"kind": "msg",
"jp": [
"「聞くな!」"
]
},
{
"id": 21334,
"kind": "msg",
"jp": [
"「オレに聞くな。",
"頼むからオレに聞かないでくれ」"
]
},
{
"id": 21335,
"kind": "msg",
"jp": [
"「オレだってわけわかんねーんだ、",
"聞かれても困る」"
]
},
{
"id": 21336,
"kind": "msg",
"jp": [
"なんか避けたい、というより",
"どこか恥ずかしそうなのは",
"なんでだろう・・・。"
]
},
{
"id": 21337,
"kind": "msg",
"jp": [
"「あのさ、マリアンヌって・・・」"
]
},
{
"id": 21338,
"kind": "msg",
"jp": [
"「お、お前、まさか",
"あれ読んだの?」"
]
},
{
"id": 21339,
"kind": "msg",
"jp": [
"「え? ああ、ちらっと",
"あらすじだけ・・・」"
]
},
{
"id": 21340,
"kind": "msg",
"jp": [
"「そうか・・・。",
"いや、オレ無理矢理貸されて",
"読めって言われた事あってな」"
]
},
{
"id": 21341,
"kind": "msg",
"jp": [
"「読んだの?」"
]
},
{
"id": 21342,
"kind": "msg",
"jp": [
"「・・・無理だった・・・」"
]
},
{
"id": 21343,
"kind": "msg",
"jp": [
"「薔薇のような唇がどーとか",
"小鳥のさえずりのような声だとか",
"3行に1回そんな描写ばっかでな」"
]
},
{
"id": 21344,
"kind": "msg",
"jp": [
"「しかも会話って会話が全部",
"全身かきむしりたくなるような",
"恥ずかしい台詞だらけで・・・」"
]
},
{
"id": 21345,
"kind": "msg",
"jp": [
"「好きな奴は好きなんだろうけど",
"オレには無理だった・・・」"
]
},
{
"id": 21346,
"kind": "msg",
"jp": [
"軽くトラウマになってそうな",
"表情だった・・・。"
]
},
{
"id": 21347,
"kind": "msg",
"jp": [
"「ハリー・キッドマンていう",
"探偵知ってる?」"
]
},
{
"id": 21348,
"kind": "msg",
"jp": [
"「ハリー・・・?",
"映画に出てくる刑事なら",
"知ってっけど」"
]
},
{
"id": 21349,
"kind": "msg",
"jp": [
"「それ、キッドマンて",
"名前じゃなかったような気が」"
]
},
{
"id": 21350,
"kind": "msg",
"jp": [
"「あー、そっか。",
"そう言やそうだったな」"
]
},
{
"id": 21351,
"kind": "msg",
"jp": [
"探偵の方は全然知らない",
"ようだった。"
]
},
{
"id": 21352,
"kind": "msg",
"jp": [
"「本物の執事の人って",
"会ったことある?」"
]
},
{
"id": 21353,
"kind": "msg",
"jp": [
"「さすがにねーよ。",
"一応、調べようとはしたん",
"だけどな・・・」"
]
},
{
"id": 21354,
"kind": "msg",
"jp": [
"「ネットで検索掛けたら",
"なんかどうしたらいいのか",
"わからんもんがヒットしてな」"
]
}
]