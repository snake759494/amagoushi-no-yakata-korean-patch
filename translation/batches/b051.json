[
{
"id": 25182,
"kind": "msg",
"jp": [
"いじめられたというか、",
"自業自得だし・・・。"
]
},
{
"id": 25183,
"kind": "msg",
"jp": [
"「考え事なら、せめて部屋に",
"戻ってからにして下さいな」"
]
},
{
"id": 25184,
"kind": "msg",
"jp": [
"「大丈夫ですかい?",
"ちゃんと休んだ方がいいですぜ、",
"なんか顔色も良くねえし」"
]
},
{
"id": 25185,
"kind": "msg",
"jp": [
"「・・・うん、そうする」"
]
},
{
"id": 25186,
"kind": "msg",
"jp": [
"実際その方がいいんだろうな。",
"ひょっとしたら、疲れがたまりすぎて",
"まともに頭が働いてないのかも。"
]
},
{
"id": 25187,
"kind": "msg",
"jp": [
"日織にうながされるままに、",
"部屋に戻る・・・。"
]
},
{
"id": 25188,
"kind": "msg",
"jp": [
"「それじゃあ、おやすみなさい」"
]
},
{
"id": 25189,
"kind": "msg",
"jp": [
"・・・布団に潜り込んではみたが、",
"やっぱり双子のことが気になって",
"眠れそうになかった。"
]
},
{
"id": 25190,
"kind": "msg",
"jp": [
"（こう何回も外してると、本当に",
"間違ってるかもって気がしてきた）"
]
},
{
"id": 25191,
"kind": "msg",
"jp": [
"（でも、やっぱり見張ってた",
"ほうがいいかなぁ・・・）"
]
},
{
"id": 25192,
"kind": "msg",
"jp": [
"なんか、あっさり頷いてくれた。",
"さんざん失敗してるから、もう",
"信用されないかと・・・。"
]
},
{
"id": 25193,
"kind": "msg",
"jp": [
"「つまり、今夜は安全」"
]
},
{
"id": 25194,
"kind": "msg",
"jp": [
"「だって、お兄さんが危ない言うたら",
"何も起きへんもん」"
]
},
{
"id": 25195,
"kind": "msg",
"jp": [
"「・・・そう言えば、そやね」"
]
},
{
"id": 25196,
"kind": "msg",
"jp": [
"「うん、今日も大丈夫やわ。",
"ほな、おやすみ」"
]
},
{
"id": 25197,
"kind": "msg",
"jp": [
"「・・・・ねむい」"
]
},
{
"id": 25198,
"kind": "msg",
"jp": [
"双子はさっさと部屋に戻って行った。",
"自業自得とは言え、まるっきり信用",
"されてない・・・。"
]
},
{
"id": 25199,
"kind": "msg",
"jp": [
"（・・・なんか、本当に",
"外してる気がしてきた・・・）"
]
},
{
"id": 25200,
"kind": "msg",
"jp": [
"「・・・{和/なご}さん?",
"なんでそんなとこで黄昏れてんです?」"
]
},
{
"id": 25201,
"kind": "msg",
"jp": [
"「え・・いや・・・」"
]
},
{
"id": 25202,
"kind": "msg",
"jp": [
"「なんか顔色が変ですけど」"
]
},
{
"id": 25203,
"kind": "msg",
"jp": [
"「な、なんでもないよ。",
"もう寝る・・・」"
]
},
{
"id": 25204,
"kind": "msg",
"jp": [
"「そうして下さい。",
"ゆっくり休むんですぜ」"
]
},
{
"id": 25205,
"kind": "msg",
"jp": [
"本気でちゃんと寝た方が",
"よさそうな気がしてきた。"
]
},
{
"id": 25206,
"kind": "msg",
"jp": [
"「あ、うん。",
"おやすみ・・・」"
]
},
{
"id": 25207,
"kind": "msg",
"jp": [
"何も考える気力がわかない。",
"もう、今夜は本当に寝てしまおう。"
]
},
{
"id": 25208,
"kind": "msg",
"jp": [
"のろのろとベッドにもぐり込み、",
"頭まで布団をかぶる。"
]
},
{
"id": 25209,
"kind": "msg",
"jp": [
"（やっぱり、僕なんかがこんな",
"わけわかんない事件のこと考える",
"なんて無謀なのかも・・・）"
]
},
{
"id": 25210,
"kind": "msg",
"jp": [
"（大人しくしといた方が",
"いいのかなぁ・・・）"
]
},
{
"id": 25211,
"kind": "msg",
"jp": [
"落ち込みながら横になっている",
"うちに、意識までが暗く沈んで",
"行く・・・。"
]
},
{
"id": 25212,
"kind": "msg",
"jp": [
"明日は何もなければいいのに。",
"もう、こんなのイヤだ・・・。"
]
},
{
"id": 25213,
"kind": "msg",
"jp": [
"食事を終えて風呂に入ると、",
"2階へ戻ってくる。"
]
},
{
"id": 25214,
"kind": "msg",
"jp": [
"「あ、おった」"
]
},
{
"id": 25215,
"kind": "msg",
"jp": [
"「あれ、静奈ちゃん」"
]
},
{
"id": 25216,
"kind": "msg",
"jp": [
"ひらひらと手を振りながら静奈ちゃんが",
"小走りに駆け寄ってくる。",
"後ろから鈴奈ちゃんもついてきている。"
]
},
{
"id": 25217,
"kind": "msg",
"jp": [
"「どうしました、二人して」"
]
},
{
"id": 25218,
"kind": "msg",
"jp": [
"「お姉ちゃんから聞いてんけどさ、",
"今晩また見張ってくれる言うてる",
"らしいやん」"
]
},
{
"id": 25219,
"kind": "msg",
"jp": [
"「ああ、うん。",
"だって今夜は・・・」"
]
},
{
"id": 25220,
"kind": "msg",
"jp": [
"「うち」"
]
},
{
"id": 25221,
"kind": "msg",
"jp": [
"静奈ちゃんは頷きながら自分を",
"指差した。"
]
},
{
"id": 25222,
"kind": "msg",
"jp": [
"「それは昨日も聞いたからうちも",
"危ないかなと思てるんやけどさ」"
]
},
{
"id": 25223,
"kind": "msg",
"jp": [
"「お兄さんら二人とも二日続けて廊下で",
"徹夜てさすがに辛いやろ」"
]
},
{
"id": 25224,
"kind": "msg",
"jp": [
"「いや、一応朝から寝たから",
"大丈夫だと思うけど」"
]
},
{
"id": 25225,
"kind": "msg",
"jp": [
"「・・・目の下、隈あるけど」"
]
},
{
"id": 25226,
"kind": "msg",
"jp": [
"「確かに{和/なご}さんの顔色は",
"よくはねぇですぜ」"
]
},
{
"id": 25227,
"kind": "msg",
"jp": [
"「せやから、うちら夜中までは",
"二人とも起きてるしその間くらいは",
"お兄さんらも休んどいてぇな」"
]
},
{
"id": 25228,
"kind": "msg",
"jp": [
"「なら、俺は先に廊下に",
"いましょうか?」"
]
},
{
"id": 25229,
"kind": "msg",
"jp": [
"「廊下に1人は、危険と思う」"
]
},
{
"id": 25230,
"kind": "msg",
"jp": [
"「・・・犯人、昨日失敗してるし",
"ちょっと無茶しても突破しようとか",
"思うかもしれへん」"
]
},
{
"id": 25231,
"kind": "msg",
"jp": [
"「う、うん、昨日より危ないかも」"
]
},
{
"id": 25232,
"kind": "msg",
"jp": [
"「うちら起きてるから、",
"夜中くらいまでは二人とも寝てて」"
]
},
{
"id": 25233,
"kind": "msg",
"jp": [
"「うちらがどっちか寝る時になったら",
"頼むから、そうしてぇな。",
"まだ時間早いしさ」"
]
},
{
"id": 25234,
"kind": "msg",
"jp": [
"「そうですねぇ・・・。",
"確かにまだ他の人も部屋では起きて",
"そうな時間ですが・・・」"
]
},
{
"id": 25235,
"kind": "msg",
"jp": [
"「そう。",
"だから今のうち」"
]
},
{
"id": 25236,
"kind": "msg",
"jp": [
"僕よりむしろ日織の方が今朝もあんまり",
"寝てない気がするんだよな。",
"休むなら今のうちか・・・。"
]
},
{
"id": 25237,
"kind": "msg",
"jp": [
"「うちらが交代で休む時には",
"呼ばせてもらうからさ」"
]
},
{
"id": 25238,
"kind": "msg",
"jp": [
"「・・・わかった。",
"じゃあ、どっちかが寝る時には",
"内線で呼んでくれる?」"
]
},
{
"id": 25239,
"kind": "msg",
"jp": [
"「遠慮しねえで、ちゃんと",
"起こして下さいよ」"
]
},
{
"id": 25240,
"kind": "msg",
"jp": [
"「うん、起こす」"
]
},
{
"id": 25241,
"kind": "msg",
"jp": [
"「そうさせてもらうわ。",
"いろいろ世話になって悪いけど」"
]
},
{
"id": 25242,
"kind": "msg",
"jp": [
"「いいよ、そんなの」"
]
},
{
"id": 25243,
"kind": "msg",
"jp": [
"「ええ、こんな事態ですからね。",
"お互い様でしょ」"
]
},
{
"id": 25244,
"kind": "msg",
"jp": [
"「それじゃ{和/なご}さん、",
"今のうちに休んで下さいな」"
]
},
{
"id": 25245,
"kind": "msg",
"jp": [
"「アンタもや、アンタも」"
]
},
{
"id": 25246,
"kind": "msg",
"jp": [
"「そうだよ、",
"寝てないのは一緒なんだから」"
]
},
{
"id": 25247,
"kind": "msg",
"jp": [
"「はいはい。",
"そうさせてもらいますって」"
]
},
{
"id": 25248,
"kind": "msg",
"jp": [
"「ほな、また後で」"
]
},
{
"id": 25249,
"kind": "msg",
"jp": [
"「うん、気をつけてね」"
]
},
{
"id": 25250,
"kind": "msg",
"jp": [
"・・・夜中までは後数時間。",
"それまで少しだけ仮眠をとって、",
"そなえることにする。"
]
},
{
"id": 25251,
"kind": "msg",
"jp": [
"今夜さえ乗り切れば明日はこれまでと",
"違うはずだから・・・。"
]
},
{
"id": 25252,
"kind": "msg",
"jp": [
"・・・本当なら、迎えが来るはずの、",
"終わりの日のはずだから・・・。"
]
},
{
"id": 25253,
"kind": "msg",
"jp": [
"「僕、部屋の外で",
"見張ってようか?」"
]
},
{
"id": 25254,
"kind": "msg",
"jp": [
"「廊下?」"
]
},
{
"id": 25255,
"kind": "msg",
"jp": [
"「それ、よけい危なくない?",
"なんか物音しても、お兄さんかなと思て",
"気ぃつかへんかもしれへんやん」"
]
},
{
"id": 25256,
"kind": "msg",
"jp": [
"「起きとく」"
]
},
{
"id": 25257,
"kind": "msg",
"jp": [
"「そやね。",
"2人で何とかするわ」"
]
},
{
"id": 25258,
"kind": "msg",
"jp": [
"「ほなね、お兄さん」"
]
},
{
"id": 25259,
"kind": "msg",
"jp": [
"「うん・・・気をつけてね」"
]
},
{
"id": 25260,
"kind": "msg",
"jp": [
"そう言って、双子は部屋に",
"戻って行った。"
]
},
{
"id": 25261,
"kind": "msg",
"jp": [
"（・・・大丈夫かな・・・）"
]
},
{
"id": 25262,
"kind": "msg",
"jp": [
"「ありゃ、{和/なご}さん",
"部屋に戻ってなかったんですかい」"
]
},
{
"id": 25263,
"kind": "msg",
"jp": [
"「あ、日織・・・」"
]
},
{
"id": 25264,
"kind": "msg",
"jp": [
"「ちゃんと寝て下さいよ。",
"{和/なご}さん、すっかり忘れて",
"そうですけど怪我人なんですから」"
]
},
{
"id": 25265,
"kind": "msg",
"jp": [
"「う、うん。",
"トイレ行ったらすぐ戻るから」"
]
},
{
"id": 25266,
"kind": "msg",
"jp": [
"「そうですか。",
"それじゃ、おやすみなさい」"
]
},
{
"id": 25267,
"kind": "msg",
"jp": [
"・・・日織も部屋へ戻っていき、",
"1人その場に残される。"
]
},
{
"id": 25268,
"kind": "msg",
"jp": [
"（ああ言われても、やっぱり",
"放っておくのは心配だよな・・・）"
]
},
{
"id": 25269,
"kind": "msg",
"jp": [
"こっそり部屋の前で見張らせて",
"もらおうかな・・・。"
]
},
{
"id": 25270,
"kind": "msg",
"jp": [
"（何も起きなければいいんだけど・・）"
]
},
{
"id": 25271,
"kind": "msg",
"jp": [
"何も起きないな。",
"その方がいいんだけど・・・。"
]
},
{
"id": 25272,
"kind": "msg",
"jp": [
"何があってもいいように、",
"そーっと腰を浮かせる。"
]
},
{
"id": 25273,
"kind": "msg",
"jp": [
"誰か部屋から出たみたいだけど、",
"トイレか、下に水でも飲みに行った",
"のかな・・・。"
]
},
{
"id": 25274,
"kind": "msg",
"jp": [
"音を立てないように、再び廊下に",
"腰を下ろした・・・。"
]
},
{
"id": 25275,
"kind": "msg",
"jp": [
"何か倒れた・・・!",
"さっきより派手な音が聞こえて、僕は",
"立ち上がり廊下の角を曲がった。"
]
},
{
"id": 25276,
"kind": "msg",
"jp": [
"同じ姿勢でじっとしていると辛いので、",
"なんとか音を立てないように居ずまいを",
"正す。"
]
},
{
"id": 25277,
"kind": "msg",
"jp": [
"（背中も痛いし・・・）"
]
},
{
"id": 25278,
"kind": "msg",
"jp": [
"もたれているのも壁なので、背中や",
"頭の後ろも痛くなってくる。"
]
},
{
"id": 25279,
"kind": "msg",
"jp": [
"けど、ここで諦めるわけには。",
"なんとか朝まで起きてないと・・・。"
]
},
{
"id": 25280,
"kind": "msg",
"jp": [
"（・・・何も来ませんように・・・）"
]
},
{
"id": 25281,
"kind": "msg",
"jp": [
"願いが通じてるのかはよくわからない",
"けど、廊下は死後の世界かと思うほど",
"静まりかえっている。"
]
},
{
"id": 25282,
"kind": "msg",
"jp": [
"もしかして、僕が気付かなかっただけで",
"犯人は近くまで来たけど、もう引き返し",
"てたりして・・・。"
]
},
{
"id": 25283,
"kind": "msg",
"jp": [
"（だといいなぁ・・・）"
]
},
{
"id": 25284,
"kind": "msg",
"jp": [
"（このまま、朝まで無事に",
"終わってくれれば・・・）"
]
},
{
"id": 25285,
"kind": "msg",
"jp": [
"「僕、部屋の前で",
"見張ってるよ」"
]
},
{
"id": 25286,
"kind": "msg",
"jp": [
"「みはる?」"
]
},
{
"id": 25287,
"kind": "msg",
"jp": [
"「うん、だってその方が",
"安全じゃないか」"
]
},
{
"id": 25288,
"kind": "msg",
"jp": [
"「なんぼなんでも悪いわ。",
"それやったら僕が、お姉ちゃんの",
"部屋に泊まるから」"
]
},
{
"id": 25289,
"kind": "msg",
"jp": [
"「・・・鈴、ソファね」"
]
},
{
"id": 25290,
"kind": "msg",
"jp": [
"「わかってるて・・・」"
]
},
{
"id": 25291,
"kind": "msg",
"jp": [
"「いや、でも2人だけじゃ",
"やっぱり危ないよ」"
]
},
{
"id": 25292,
"kind": "msg",
"jp": [
"「これでも男やで、",
"大丈夫やってば」"
]
},
{
"id": 25293,
"kind": "msg",
"jp": [
"「・・・でもお尻痛そう」"
]
},
{
"id": 25294,
"kind": "msg",
"jp": [
"「お姉ちゃん、そういう問題",
"{違/ちゃ}うから・・・」"
]
},
{
"id": 25295,
"kind": "msg",
"jp": [
"「それくらい大丈夫だよ。",
"朝になったら寝かせてもらうし」"
]
},
{
"id": 25296,
"kind": "msg",
"jp": [
"「いや、だから・・・」"
]
},
{
"id": 25297,
"kind": "msg",
"jp": [
"「なんぼなんでも悪いわ。",
"それやったらうちが、お姉ちゃんの",
"部屋に泊まるから」"
]
},
{
"id": 25298,
"kind": "msg",
"jp": [
"「大丈夫やってば」"
]
},
{
"id": 25299,
"kind": "msg",
"jp": [
"「あぁ、この人こうなったら",
"何言っても聞きませんぜ」"
]
},
{
"id": 25300,
"kind": "msg",
"jp": [
"いつの間にか1階から戻って来た",
"日織が後ろからひらひらと手を振る。"
]
},
{
"id": 25301,
"kind": "msg",
"jp": [
"「そない言わんと止めてや。",
"あんた保護者やろ」"
]
},
{
"id": 25302,
"kind": "msg",
"jp": [
"「ええ、ですから付き添います」"
]
},
{
"id": 25303,
"kind": "msg",
"jp": [
"「あの、日織?」"
]
},
{
"id": 25304,
"kind": "msg",
"jp": [
"「保護者同伴の護衛・・・」"
]
},
{
"id": 25305,
"kind": "msg",
"jp": [
"「静奈ちゃんっ!」"
]
},
{
"id": 25306,
"kind": "msg",
"jp": [
"「役に立つんか立たんのか",
"よぉわからんねんけど」"
]
},
{
"id": 25307,
"kind": "msg",
"jp": [
"「大丈夫ですって。",
"俺、けっこう鍛えてますから」"
]
},
{
"id": 25308,
"kind": "msg",
"jp": [
"「だから、日織・・・」"
]
},
{
"id": 25309,
"kind": "msg",
"jp": [
"「もう・・・しゃあないなぁ。",
"ほんまに何か来たら止めてや?」"
]
},
{
"id": 25310,
"kind": "msg",
"jp": [
"「防波堤」"
]
},
{
"id": 25311,
"kind": "msg",
"jp": [
"「はいはい、",
"任せといて下さいな」"
]
},
{
"id": 25312,
"kind": "msg",
"jp": [
"「ねえ、{和/なご}さん?」"
]
},
{
"id": 25313,
"kind": "msg",
"jp": [
"「・・・もう、それでいい」"
]
},
{
"id": 25314,
"kind": "msg",
"jp": [
"「拗ねた」"
]
},
{
"id": 25315,
"kind": "msg",
"jp": [
"「慰めときます」"
]
},
{
"id": 25316,
"kind": "msg",
"jp": [
"「・・・ほんまに大丈夫",
"なんかいな・・・」"
]
},
{
"id": 25317,
"kind": "msg",
"jp": [
"「・・・鈴、行こ」"
]
},
{
"id": 25318,
"kind": "msg",
"jp": [
"「うん、ほな頼むで」"
]
},
{
"id": 25319,
"kind": "msg",
"jp": [
"「ええ、おやすみなさい。",
"そちらも気をつけて」"
]
},
{
"id": 25320,
"kind": "msg",
"jp": [
"「おやすみ、また朝にね」"
]
},
{
"id": 25321,
"kind": "msg",
"jp": [
"そう言って、双子は揃って",
"静奈ちゃんの部屋へと入って",
"行った・・・。"
]
},
{
"id": 25322,
"kind": "msg",
"jp": [
"「ほら、{和/なご}さん。",
"そんな顔してないで」"
]
},
{
"id": 25323,
"kind": "msg",
"jp": [
"「だってー!",
"なんだよぉ、保護者って!」"
]
},
{
"id": 25324,
"kind": "msg",
"jp": [
"「んなとっから否定してたら",
"話が脱線してしょうがねえでしょう」"
]
},
{
"id": 25325,
"kind": "msg",
"jp": [
"「そうだけどぉ・・・」"
]
},
{
"id": 25326,
"kind": "msg",
"jp": [
"「お嬢さん方だって、うかつに",
"護衛なんか頼んで{和/なご}さんに",
"何かあったらと思ってたでしょうし」"
]
},
{
"id": 25327,
"kind": "msg",
"jp": [
"「2人いるなら大丈夫かも、と",
"思ってもなかなか『そうですか』",
"とも言えねえでしょう」"
]
},
{
"id": 25328,
"kind": "msg",
"jp": [
"「・・・そりゃそうだね」"
]
},
{
"id": 25329,
"kind": "msg",
"jp": [
"「ちょいと茶化した方が",
"受け入れやすいってことも",
"あるじゃねえですか」"
]
},
{
"id": 25330,
"kind": "msg",
"jp": [
"「第一、お嬢さん方が危ねえって",
"気付いたの{和/なご}さんなんですから、",
"立派なもんじゃねえですか」"
]
},
{
"id": 25331,
"kind": "msg",
"jp": [
"「いや、それは・・・まあ・・・」"
]
},
{
"id": 25332,
"kind": "msg",
"jp": [
"「さあさあ、ここまで来て",
"出し抜かれるわけには行きませんぜ」"
]
},
{
"id": 25333,
"kind": "msg",
"jp": [
"「うん、もちろんだよ!",
"これで鈴奈ちゃんに何かあったら、",
"それこそ・・・」"
]
},
{
"id": 25334,
"kind": "msg",
"jp": [
"「だったら、早いところ",
"どっかで見張りましょうや」"
]
},
{
"id": 25335,
"kind": "msg",
"jp": [
"「そうだね。",
"こんなとこで話してる場合じゃない」"
]
},
{
"id": 25336,
"kind": "msg",
"jp": [
"「・・・単純な人だ・・・」"
]
},
{
"id": 25337,
"kind": "msg",
"jp": [
"「え? 何か言った?」"
]
},
{
"id": 25338,
"kind": "msg",
"jp": [
"「いえいえ。",
"誰か近づいてきてもすぐバレねえように",
"そっちの一番奥にいましょうか」"
]
},
{
"id": 25339,
"kind": "msg",
"jp": [
"「うん、そうしよ」"
]
},
{
"id": 25340,
"kind": "msg",
"jp": [
"双子の部屋が並んでいる廊下の、",
"静奈ちゃんの部屋がある側の",
"突き当たりに陣取ることにする。"
]
},
{
"id": 25341,
"kind": "msg",
"jp": [
"「ここでいいか」"
]
},
{
"id": 25342,
"kind": "msg",
"jp": [
"「そうですね。",
"じゃあ、朝まで頑張りますか」"
]
},
{
"id": 25343,
"kind": "msg",
"jp": [
"壁にもたれて、廊下に座り込む。"
]
},
{
"id": 25344,
"kind": "msg",
"jp": [
"（独りきりで見張ってるより",
"よっぽど安心だな・・・）"
]
},
{
"id": 25345,
"kind": "msg",
"jp": [
"なんか上手いことごまかされた",
"ような気はするけど・・・。"
]
},
{
"id": 25346,
"kind": "msg",
"jp": [
"「・・・・・いい」"
]
},
{
"id": 25347,
"kind": "msg",
"jp": [
"「いい?」"
]
},
{
"id": 25348,
"kind": "msg",
"jp": [
"「危ないから」"
]
},
{
"id": 25349,
"kind": "msg",
"jp": [
"「けど、何か物音しても、",
"お兄さんやと思て安心してたら",
"犯人やったら嫌やん」"
]
},
{
"id": 25350,
"kind": "msg",
"jp": [
"「う・・・あ、そうか・・・」"
]
},
{
"id": 25351,
"kind": "msg",
"jp": [
"「だから、いい」"
]
},
{
"id": 25352,
"kind": "msg",
"jp": [
"「大丈夫、うちもついてるし」"
]
},
{
"id": 25353,
"kind": "msg",
"jp": [
"「本当に大丈夫?」"
]
},
{
"id": 25354,
"kind": "msg",
"jp": [
"「叫ぶ」"
]
},
{
"id": 25355,
"kind": "msg",
"jp": [
"「さ、さけぶ?」"
]
},
{
"id": 25356,
"kind": "msg",
"jp": [
"「何か来たら」"
]
},
{
"id": 25357,
"kind": "msg",
"jp": [
"「そやね。",
"思いっきり叫ぶから助けに来て」"
]
},
{
"id": 25358,
"kind": "msg",
"jp": [
"「う、うん、わかった。",
"じゃあ、気をつけてね」"
]
},
{
"id": 25359,
"kind": "msg",
"jp": [
"「お兄さんも」"
]
},
{
"id": 25360,
"kind": "msg",
"jp": [
"「ほなね、おやすみ」"
]
},
{
"id": 25361,
"kind": "msg",
"jp": [
"双子はそう言って、部屋に戻って",
"行った。"
]
},
{
"id": 25362,
"kind": "msg",
"jp": [
"（・・・本当に大丈夫",
"かなぁ・・・）"
]
},
{
"id": 25363,
"kind": "msg",
"jp": [
"「あれ、{和/なご}さん?",
"まだ部屋に戻ってなかったん",
"ですかい?」"
]
},
{
"id": 25364,
"kind": "msg",
"jp": [
"「そろそろ休んだ方がいいですぜ。",
"あんた一応怪我人なんですから」"
]
},
{
"id": 25365,
"kind": "msg",
"jp": [
"「う、うん。",
"もう休むよ」"
]
},
{
"id": 25366,
"kind": "msg",
"jp": [
"「トイレ行ったらすぐ寝るから",
"先に戻ってって」"
]
},
{
"id": 25367,
"kind": "msg",
"jp": [
"「そうですか。",
"じゃ、おやすみなさい」"
]
},
{
"id": 25368,
"kind": "msg",
"jp": [
"日織も部屋に戻っていき、廊下には",
"僕だけになった。"
]
},
{
"id": 25369,
"kind": "msg",
"jp": [
"（やっぱり見張ろう・・・）"
]
},
{
"id": 25370,
"kind": "msg",
"jp": [
"何もしないでいて、朝になって",
"大変なことになってたら絶対",
"嫌だし・・・。"
]
},
{
"id": 25371,
"kind": "msg",
"jp": [
"（だ、誰か出て来る?）"
]
},
{
"id": 25372,
"kind": "msg",
"jp": [
"慌てて廊下を引き返し、",
"トイレの中から様子をうかがう。"
]
},
{
"id": 25373,
"kind": "msg",
"jp": [
"「・・・・やの?」"
]
},
{
"id": 25374,
"kind": "msg",
"jp": [
"「うん・・・・その方が・・・」"
]
},
{
"id": 25375,
"kind": "msg",
"jp": [
"（・・・静奈ちゃん達だ・・・）"
]
},
{
"id": 25376,
"kind": "msg",
"jp": [
"寝巻き姿の双子が部屋を出てきて",
"ちょうど廊下の真中辺りで",
"何か喋っている。"
]
},
{
"id": 25377,
"kind": "msg",
"jp": [
"（何してるんだろう・・?）"
]
},
{
"id": 25378,
"kind": "msg",
"jp": [
"「・・・気ぃつけて」"
]
},
{
"id": 25379,
"kind": "msg",
"jp": [
"「わかってるて。",
"任せといてぇな」"
]
},
{
"id": 25380,
"kind": "msg",
"jp": [
"「うん・・・。",
"ほな、うち寝る」"
]
},
{
"id": 25381,
"kind": "msg",
"jp": [
"「うん、おやすみ。",
"そっちも気ぃつけてね」"
]
},
{
"id": 25382,
"kind": "msg",
"jp": [
"（あ、戻っちゃった・・・）"
]
},
{
"id": 25383,
"kind": "msg",
"jp": [
"（何の話してたんだろう?",
"出てきてすぐ帰っちゃったし・・・）"
]
},
{
"id": 25384,
"kind": "msg",
"jp": [
"それに・・・。",
"なんか微妙な違和感を感じた気が",
"するんだけど気のせいかな。"
]
},
{
"id": 25385,
"kind": "msg",
"jp": [
"よくわからないけど、とりあえず",
"見つからずにはすんだみたいだ。"
]
},
{
"id": 25386,
"kind": "msg",
"jp": [
"（それじゃあ・・・）"
]
},
{
"id": 25387,
"kind": "msg",
"jp": [
"そーっと音を立てないように、",
"静奈ちゃんの部屋の前に行く。"
]
},
{
"id": 25388,
"kind": "msg",
"jp": [
"（この突き当たりにいれば",
"大丈夫だよな・・・）"
]
},
{
"id": 25389,
"kind": "msg",
"jp": [
"廊下の突き当たりの壁にもたれて、",
"膝を抱えてしゃがみ込む。"
]
},
{
"id": 25390,
"kind": "msg",
"jp": [
"（・・・誰も来ませんように・・・）"
]
},
{
"id": 25391,
"kind": "msg",
"jp": [
"（それに、何も起きません",
"ように・・・）"
]
},
{
"id": 25392,
"kind": "msg",
"jp": [
"（・・・やっぱり、見張ろう）"
]
},
{
"id": 25393,
"kind": "msg",
"jp": [
"何もしないで静奈ちゃんにもしもの",
"ことがあったらと思うと・・・。"
]
},
{
"id": 25394,
"kind": "msg",
"jp": [
"（部屋の前でこっそり・・・）"
]
},
{
"id": 25395,
"kind": "msg",
"jp": [
"「!!」"
]
},
{
"id": 25396,
"kind": "msg",
"jp": [
"（だ、誰か出てきた・・・!）"
]
},
{
"id": 25397,
"kind": "msg",
"jp": [
"あたふたとトイレに行くフリをして",
"駆け込んでみる。"
]
},
{
"id": 25398,
"kind": "msg",
"jp": [
"「・・・誰かおった?」"
]
},
{
"id": 25399,
"kind": "msg",
"jp": [
"「トイレ・・・」"
]
},
{
"id": 25400,
"kind": "msg",
"jp": [
"「ああ、なんや」"
]
},
{
"id": 25401,
"kind": "msg",
"jp": [
"（静奈ちゃん達か・・・）"
]
},
{
"id": 25402,
"kind": "msg",
"jp": [
"こっち来たらどうしよう。",
"誤魔化すしかないけど・・・。"
]
},
{
"id": 25403,
"kind": "msg",
"jp": [
"「・・・・・やのに・・・」"
]
},
{
"id": 25404,
"kind": "msg",
"jp": [
"「でも・・・ろ? ええから・・・」"
]
},
{
"id": 25405,
"kind": "msg",
"jp": [
"（・・・何かもめてる・・・?）"
]
},
{
"id": 25406,
"kind": "msg",
"jp": [
"双子は声をひそめて何かを",
"話し合ってるようだ。"
]
},
{
"id": 25407,
"kind": "msg",
"jp": [
"（・・・何話してるのかなぁ）"
]
},
{
"id": 25408,
"kind": "msg",
"jp": [
"気になるし、そろそろ出ないと",
"変かなぁ・・・。"
]
},
{
"id": 25409,
"kind": "msg",
"jp": [
"（・・・思い切って出てみよ）"
]
},
{
"id": 25410,
"kind": "msg",
"jp": [
"手を洗うフリをして水を流し、",
"トイレから出ると、2人並んだ",
"寝巻き姿に出くわした。"
]
},
{
"id": 25411,
"kind": "msg",
"jp": [
"「お兄さんやったん」"
]
},
{
"id": 25412,
"kind": "msg",
"jp": [
"「あれ、どうかしたの?」"
]
},
{
"id": 25413,
"kind": "msg",
"jp": [
"「ううん、なんでもないよ」"
]
},
{
"id": 25414,
"kind": "msg",
"jp": [
"「うん、もう寝るとこ」"
]
},
{
"id": 25415,
"kind": "msg",
"jp": [
"「うん、寝る・・・おやすみ・・・」"
]
},
{
"id": 25416,
"kind": "msg",
"jp": [
"そう言って静奈ちゃんは、するりと",
"部屋の中に消えていった。"
]
},
{
"id": 25417,
"kind": "msg",
"jp": [
"「えーと・・・",
"おやすみ、鈴奈ちゃん」"
]
},
{
"id": 25418,
"kind": "msg",
"jp": [
"「・・・あ、うん。",
"おやすみ、お兄さん」"
]
},
{
"id": 25419,
"kind": "msg",
"jp": [
"鈴奈ちゃんは頷いて、自分の部屋に",
"戻っていく。"
]
},
{
"id": 25420,
"kind": "msg",
"jp": [
"（・・・?",
"なんか変だったような・・・）"
]
},
{
"id": 25421,
"kind": "msg",
"jp": [
"でも、とりあえず怪しまれずには",
"すんだみたいだ・・・。"
]
},
{
"id": 25422,
"kind": "msg",
"jp": [
"（それじゃ、こっそり部屋の前に",
"行って見張ってよう・・・）"
]
},
{
"id": 25423,
"kind": "msg",
"jp": [
"静奈ちゃんの部屋の前に移動して、",
"壁際に腰を下ろす。"
]
},
{
"id": 25424,
"kind": "msg",
"jp": [
"（・・・ふぅ・・・・）"
]
},
{
"id": 25425,
"kind": "msg",
"jp": [
"このまま、朝まで何事もなければ",
"いいんだけど・・・。"
]
},
{
"id": 25426,
"kind": "msg",
"jp": [
"「大丈夫だよね。",
"2人とも起きてるなら」"
]
},
{
"id": 25427,
"kind": "msg",
"jp": [
"「大丈夫よ。",
"うちがついてるし心配せんといて」"
]
},
{
"id": 25428,
"kind": "msg",
"jp": [
"「そっか、じゃあおやすみ」"
]
},
{
"id": 25429,
"kind": "msg",
"jp": [
"双子は部屋に戻っていった。",
"ちょっと心配だけど、お互いに",
"見張ってるなら大丈夫だろう。"
]
},
{
"id": 25430,
"kind": "msg",
"jp": [
"「うん、もう戻るよ」"
]
},
{
"id": 25431,
"kind": "msg",
"jp": [
"日織にせかされて、そのまま",
"部屋に戻る。"
]
},
{
"id": 25432,
"kind": "msg",
"jp": [
"挨拶してベッドの端に腰掛ける。",
"とはいえ・・・。"
]
},
{
"id": 25433,
"kind": "msg",
"jp": [
"（・・・・ふぅ）"
]
},
{
"id": 25434,
"kind": "msg",
"jp": [
"やっぱり双子のことがちょっと",
"気になるなぁ・・・。"
]
},
{
"id": 25435,
"kind": "msg",
"jp": [
"（何か起きる前に犯人が",
"わかれば早いんだけど・・・）"
]
},
{
"id": 25436,
"kind": "msg",
"jp": [
"そう簡単にいくわけないよな。",
"どうしよう・・・"
]
},
{
"id": 25437,
"kind": "msg",
"jp": [
"（・・・とりあえず、寝よ）"
]
},
{
"id": 25438,
"kind": "msg",
"jp": [
"僕に出来ることは、もうないだろうし。",
"日織の言うとおり身体を休めておいた",
"ほうがいいよな。"
]
},
{
"id": 25439,
"kind": "msg",
"jp": [
"服を脱いで、明かりを消すとベッドに",
"もぐり込んだ。"
]
},
{
"id": 25440,
"kind": "msg",
"jp": [
"（もうちょっとだけ、考えて",
"みようかな・・・）"
]
},
{
"id": 25441,
"kind": "msg",
"jp": [
"何か思いつくかもしれないし。"
]
},
{
"id": 25442,
"kind": "msg",
"jp": [
"（ちょっとは整理出来たと",
"思うんだけど・・・）"
]
},
{
"id": 25443,
"kind": "msg",
"jp": [
"やっぱり、犯人が誰かまでは",
"ぴんと来ないな・・・。"
]
},
{
"id": 25444,
"kind": "msg",
"jp": [
"（仕方ないか・・・）"
]
},
{
"id": 25445,
"kind": "msg",
"jp": [
"（そろそろ寝よう。",
"本当に傷に障るようだったら",
"困るし・・・）"
]
},
{
"id": 25446,
"kind": "msg",
"jp": [
"明かりを消して、ベッドに横になる。"
]
},
{
"id": 25447,
"kind": "msg",
"jp": [
"なかなか寝付けなかったけれど、",
"何度か寝返りを打っているうちに",
"意識が遠のいていった・・・。"
]
},
{
"id": 25448,
"kind": "msg",
"jp": [
"・・・考えてみたら、僕の推理自体が",
"また外れてる可能性も高いんだよな。"
]
},
{
"id": 25449,
"kind": "msg",
"jp": [
"そう思うと、どんどん自信が無くなって",
"きてしまった。"
]
},
{
"id": 25450,
"kind": "msg",
"jp": [
"（・・・そうだよな）"
]
},
{
"id": 25451,
"kind": "msg",
"jp": [
"根本的に間違ってたら、見張ってても",
"意味無いし・・・。"
]
},
{
"id": 25452,
"kind": "msg",
"jp": [
"（・・・もう寝ちゃおうか・・・）"
]
},
{
"id": 25453,
"kind": "msg",
"jp": [
"（寝よ・・・）"
]
},
{
"id": 25454,
"kind": "msg",
"jp": [
"疲れてるのに起きてたって、",
"明日が辛くなるだけだ。"
]
},
{
"id": 25455,
"kind": "msg",
"jp": [
"明かりを消してベッドに横になる。",
"すぐに頭がぼんやりしてきて、",
"眠りに落ちていく・・・。"
]
},
{
"id": 25456,
"kind": "msg",
"jp": [
"・・・・・・・。",
"・・・・・。"
]
},
{
"id": 25457,
"kind": "msg",
"jp": [
"事件のことが気になって、すぐに横に",
"なる気にはなれない。"
]
},
{
"id": 25458,
"kind": "msg",
"jp": [
"（犯人さえわかれば、もうこんな",
"騒ぎは終わりに出来るのに・・・）"
]
},
{
"id": 25459,
"kind": "msg",
"jp": [
"だからって、こんな大事なのに",
"当てずっぽでアンタがやったんだろ",
"なんて言えないし・・・。"
]
},
{
"id": 25460,
"kind": "msg",
"jp": [
"（・・・うーん・・・）"
]
},
{
"id": 25461,
"kind": "msg",
"jp": [
"「・・・・はぁ・・・」"
]
},
{
"id": 25462,
"kind": "msg",
"jp": [
"やっぱり犯人が誰かなんてそうそう",
"わかるもんじゃないか。"
]
},
{
"id": 25463,
"kind": "msg",
"jp": [
"（うわ、もうこんな時間だ・・・）"
]
},
{
"id": 25464,
"kind": "msg",
"jp": [
"そろそろ寝よう。",
"明かりを消して、布団にもぐり込む。"
]
},
{
"id": 25465,
"kind": "msg",
"jp": [
"目がさえてしまったのか、なかなか",
"眠れなかったけど、じっと目を閉じて",
"いると・・・。"
]
},
{
"id": 25466,
"kind": "msg",
"jp": [
"かなり近い距離から扉の音が聞こえて",
"一瞬固まってしまう。"
]
},
{
"id": 25467,
"kind": "msg",
"jp": [
"しかし双子の部屋はどちらも開く",
"気配もしない・・・。"
]
},
{
"id": 25468,
"kind": "msg",
"jp": [
"（・・・双子じゃない。",
"てことはこっち側の部屋には",
"あと御陵さんしかいないはず）"
]
},
{
"id": 25469,
"kind": "msg",
"jp": [
"こっちに来る様子もないし・・・・。",
"御陵さんがトイレにでも行ったの",
"かもしれない・・・。"
]
},
{
"id": 25470,
"kind": "msg",
"jp": [
"（・・・っ!?）"
]
},
{
"id": 25471,
"kind": "msg",
"jp": [
"なんだあの音・・・?",
"時計の音みたいだけど・・・。"
]
},
{
"id": 25472,
"kind": "msg",
"jp": [
"（玄関前の大時計・・・?）"
]
},
{
"id": 25473,
"kind": "msg",
"jp": [
"けど、あれは鳴らないはずじゃ",
"なかったっけ・・・。"
]
},
{
"id": 25474,
"kind": "msg",
"jp": [
"（気になるけど、ここを",
"動くわけにも・・・）"
]
},
{
"id": 25475,
"kind": "msg",
"jp": [
"どうしようかと逡巡しているうちに",
"時計の音はやみ、廊下はまた静かに",
"なった。"
]
},
{
"id": 25476,
"kind": "msg",
"jp": [
"（・・・こっちには誰も",
"来ないみたいだけど・・・）"
]
},
{
"id": 25477,
"kind": "msg",
"jp": [
"（なんでいきなり時計が・・・）"
]
},
{
"id": 25478,
"kind": "msg",
"jp": [
"・・・やっぱり気になるし、ちょっとだけ",
"見に行ってみようか。"
]
},
{
"id": 25479,
"kind": "msg",
"jp": [
"暗い廊下をそろそろと歩いていくと・・・"
]
},
{
"id": 25480,
"kind": "msg",
"jp": [
"開いてる・・・。",
"あそこは、空き部屋のはずなのに。"
]
},
{
"id": 25481,
"kind": "msg",
"jp": [
"（な、なんで開いてるんだ・・・?）"
]
},
{
"id": 25482,
"kind": "msg",
"jp": [
"そう言えば時計が鳴る前に、扉が開く音が",
"聞こえたけど、あれが・・・?"
]
},
{
"id": 25483,
"kind": "msg",
"jp": [
"「{和/なご}さん?",
"何してんです、そんなとこで」"
]
},
{
"id": 25484,
"kind": "msg",
"jp": [
"いきなり声を掛けられて、",
"悲鳴を上げそうになった。"
]
},
{
"id": 25485,
"kind": "msg",
"jp": [
"「あ、すいません驚かせちまって」"
]
},
{
"id": 25486,
"kind": "msg",
"jp": [
"「ひ・・日織・・・」"
]
},
{
"id": 25487,
"kind": "msg",
"jp": [
"「なんでここに・・・」"
]
},
{
"id": 25488,
"kind": "msg",
"jp": [
"「さっき急に時計が鳴ったでしょう。",
"飛び起きたら、{和/なご}さんが見あたらねえし",
"気になって見に行ったんですが」"
]
},
{
"id": 25489,
"kind": "msg",
"jp": [
"「時計、どうだった?」"
]
},
{
"id": 25490,
"kind": "msg",
"jp": [
"「ああ、戻してきました」"
]
},
{
"id": 25491,
"kind": "msg",
"jp": [
"「戻して?」"
]
},
{
"id": 25492,
"kind": "msg",
"jp": [
"「8時になってたんで」"
]
},
{
"id": 25493,
"kind": "msg",
"jp": [
"「は、8時?」"
]
},
{
"id": 25494,
"kind": "msg",
"jp": [
"「あの時計、元々朝の8時から",
"夜の8時までしか鳴りませんからね」"
]
},
{
"id": 25495,
"kind": "msg",
"jp": [
"「で、この部屋は?」"
]
},
{
"id": 25496,
"kind": "msg",
"jp": [
"「わかんないんだよ。",
"時計が鳴る少し前に扉の開く音が",
"したことは確かなんだけど」"
]
},
{
"id": 25497,
"kind": "msg",
"jp": [
"「・・・ふうん?",
"中、調べてみます?」"
]
},
{
"id": 25498,
"kind": "msg",
"jp": [
"「だ、誰か居たら",
"どうすんるんだよ!?」"
]
},
{
"id": 25499,
"kind": "msg",
"jp": [
"「じゃあ、ちょいとのぞくだけに",
"しときますか」"
]
},
{
"id": 25500,
"kind": "msg",
"jp": [
"「・・・どうしても?」"
]
},
{
"id": 25501,
"kind": "msg",
"jp": [
"「何かいるかいないかわかんねえまま",
"放っておくのも嫌でしょう」"
]
},
{
"id": 25502,
"kind": "msg",
"jp": [
"日織はそっと室内に足を踏み入れて",
"周りを見回した。"
]
},
{
"id": 25503,
"kind": "msg",
"jp": [
"「それじゃ・・・",
"目も覚めちまったことだし、",
"なんなら交代しますか?」"
]
},
{
"id": 25504,
"kind": "msg",
"jp": [
"「むしろ日織は朝からちゃんと",
"起きられるようにまだ寝ておいて。",
"僕は多分、昼間で起きられないから」"
]
},
{
"id": 25505,
"kind": "msg",
"jp": [
"「そうですかい?",
"朝になったらちゃんと",
"休んで下さいよ」"
]
},
{
"id": 25506,
"kind": "msg",
"jp": [
"「あと、何かあったら",
"とりあえず思いっきり叫んで",
"助け呼んで下さい」"
]
},
{
"id": 25507,
"kind": "msg",
"jp": [
"僕もこっそり静奈ちゃんの部屋の",
"前へと戻る・・・。"
]
},
{
"id": 25508,
"kind": "msg",
"jp": [
"（・・・なんでバレたんだろう）"
]
},
{
"id": 25509,
"kind": "msg",
"jp": [
"食事と風呂をすませて、2階の",
"部屋に戻る。"
]
},
{
"id": 25510,
"kind": "msg",
"jp": [
"一応挨拶はしてベッドには横になる。",
"だけどすんなり眠るというわけには",
"いかなかった。"
]
},
{
"id": 25511,
"kind": "msg",
"jp": [
"（・・・・どうしようかな）"
]
},
{
"id": 25512,
"kind": "msg",
"jp": [
"静奈ちゃんは、部屋に籠もった",
"まんまだけど・・・。"
]
},
{
"id": 25513,
"kind": "msg",
"jp": [
"（危険な気がするんだよな・・・）"
]
},
{
"id": 25514,
"kind": "msg",
"jp": [
"誰が来たって、扉は開けそうに",
"ないけど・・・。"
]
},
{
"id": 25515,
"kind": "msg",
"jp": [
"（・・・やっぱり心配だ）"
]
},
{
"id": 25516,
"kind": "msg",
"jp": [
"せめて、朝まで部屋の前で",
"見張っていよう。"
]
},
{
"id": 25517,
"kind": "msg",
"jp": [
"（日織は・・・",
"もう寝てるな・・・）"
]
},
{
"id": 25518,
"kind": "msg",
"jp": [
"起こさないようにそーっと",
"部屋から忍び出た。"
]
},
{
"id": 25519,
"kind": "msg",
"jp": [
"足音を忍ばせて、静奈ちゃんの部屋の",
"前まで行く。"
]
},
{
"id": 25520,
"kind": "msg",
"jp": [
"そっと扉に耳を近づけてみたが、",
"中から物音は聞こえなかった。"
]
},
{
"id": 25521,
"kind": "msg",
"jp": [
"（・・・部屋にはいるのかな・・）"
]
},
{
"id": 25522,
"kind": "msg",
"jp": [
"しばらくそうしていると、微かな",
"衣擦れの音がした。"
]
},
{
"id": 25523,
"kind": "msg",
"jp": [
"（いるみたいだ・・・）"
]
},
{
"id": 25524,
"kind": "msg",
"jp": [
"（それじゃ、朝までここにいよう）"
]
},
{
"id": 25525,
"kind": "msg",
"jp": [
"（無事だってわかるまで、",
"なんとか・・・）"
]
},
{
"id": 25526,
"kind": "msg",
"jp": [
"（・・・やめた方がいいかな）"
]
},
{
"id": 25527,
"kind": "msg",
"jp": [
"あの様子なら、誰も部屋に近寄らせない",
"だろうし・・・。"
]
},
{
"id": 25528,
"kind": "msg",
"jp": [
"（下手に刺激すると、もっとひどい",
"ことになりそうなんだよな・・・）"
]
},
{
"id": 25529,
"kind": "msg",
"jp": [
"（・・・けど・・・）"
]
},
{
"id": 25530,
"kind": "msg",
"jp": [
"誰があんな事を・・・・。",
"それさえわかれば、もうこんなこと",
"止められるのに・・・。"
]
},
{
"id": 25531,
"kind": "msg",
"jp": [
"（かなり考えて、整理してみた",
"つもりなんだけど・・・）"
]
},
{
"id": 25532,
"kind": "msg",
"jp": [
"やっぱり、犯人が名指し出来るほどの",
"自信はないなぁ・・・。"
]
},
{
"id": 25533,
"kind": "msg",
"jp": [
"（やっぱり、僕には無理なのかな。",
"犯人を見つけるだなんて・・・）"
]
},
{
"id": 25534,
"kind": "msg",
"jp": [
"（・・・もう休もう・・・）"
]
},
{
"id": 25535,
"kind": "msg",
"jp": [
"予定通りなら、明日には迎えが",
"来るはずだから・・・。"
]
},
{
"id": 25536,
"kind": "msg",
"jp": [
"誰かの事務所の人が、僕らが",
"ここに閉じこめられてるって",
"気付いてくれるよな・・・。"
]
},
{
"id": 25537,
"kind": "msg",
"jp": [
"（・・・早く明日に",
"ならないかな・・・）"
]
},
{
"id": 25538,
"kind": "msg",
"jp": [
"（明日になれば・・・）"
]
},
{
"id": 25539,
"kind": "msg",
"jp": [
"（な、なに・・・!?）"
]
},
{
"id": 25540,
"kind": "msg",
"jp": [
"みしって・・・。",
"今、なんか変な音がした・・・。"
]
},
{
"id": 25541,
"kind": "msg",
"jp": [
"（ま、まただ・・・!）"
]
},
{
"id": 25542,
"kind": "msg",
"jp": [
"（足音とかじゃなかった。",
"なんだろう、今の・・・）"
]
},
{
"id": 25543,
"kind": "msg",
"jp": [
"不安になり、思わず腰を浮かす。",
"辺りを見回してみたが、音の源が",
"どこなのかもわからない。"
]
},
{
"id": 25544,
"kind": "msg",
"jp": [
"「うわ・・・!」"
]
},
{
"id": 25545,
"kind": "msg",
"jp": [
"いきなり廊下が揺れて、",
"倒れそうになる。"
]
},
{
"id": 25546,
"kind": "msg",
"jp": [
"（なにこれ、地震・・・!?）"
]
},
{
"id": 25547,
"kind": "msg",
"jp": [
"「{和/なご}さん!",
"{和/なご}さんっ!?」"
]
},
{
"id": 25548,
"kind": "msg",
"jp": [
"「日織!?」"
]
},
{
"id": 25549,
"kind": "msg",
"jp": [
"呼ぶ声が聞こえて、そちらへ",
"走ろうとした途端――"
]
},
{
"id": 25550,
"kind": "msg",
"jp": [
"黒くて大きな影が目の前を",
"おおっていた。"
]
},
{
"id": 25551,
"kind": "msg",
"jp": [
"それが何だったのかわかるよりも",
"早く、僕の意識は途絶えていた・・・。"
]
},
{
"id": 25552,
"kind": "msg",
"jp": [
"「僕、外で",
"見張ってようか?」"
]
},
{
"id": 25553,
"kind": "msg",
"jp": [
"「・・・夜通し?」"
]
},
{
"id": 25554,
"kind": "msg",
"jp": [
"「うん、もちろん」"
]
},
{
"id": 25555,
"kind": "msg",
"jp": [
"「一応、犯人が使いそうだと思った物は",
"始末したけど、その方が安全だし」"
]
},
{
"id": 25556,
"kind": "msg",
"jp": [
"「そりゃそやけど・・・。",
"そんなん、お兄さんが危ないやん」"
]
},
{
"id": 25557,
"kind": "msg",
"jp": [
"「それやったら、",
"うちがお姉ちゃんの",
"部屋に泊まるわ」"
]
},
{
"id": 25558,
"kind": "msg",
"jp": [
"「お泊まりお泊まり」"
]
},
{
"id": 25559,
"kind": "msg",
"jp": [
"「・・・遊びに行くんと",
"{違/ちゃ}うで・・・?」"
]
},
{
"id": 25560,
"kind": "msg",
"jp": [
"「うん、鈴はソファね」"
]
},
{
"id": 25561,
"kind": "msg",
"jp": [
"「・・・こんな女、",
"本気で一晩中守るて?」"
]
},
{
"id": 25562,
"kind": "msg",
"jp": [
"「え、えーと・・・",
"じゃあ僕は廊下にでも・・・」"
]
},
{
"id": 25563,
"kind": "msg",
"jp": [
"「人の話聞いてたか、あんた?」"
]
},
{
"id": 25564,
"kind": "msg",
"jp": [
"「外でええの?」"
]
},
{
"id": 25565,
"kind": "msg",
"jp": [
"「うん、いいよ。",
"さすがに女の子の部屋に泊まり込む",
"わけには・・・」"
]
},
{
"id": 25566,
"kind": "msg",
"jp": [
"「女の子ねぇ・・・」"
]
},
{
"id": 25567,
"kind": "msg",
"jp": [
"「なに」"
]
},
{
"id": 25568,
"kind": "msg",
"jp": [
"「いや、別に。",
"けど、お兄さんやっぱり外は",
"危ないやろ」"
]
},
{
"id": 25569,
"kind": "msg",
"jp": [
"「だ、大丈夫。",
"何か近づいてきたら悲鳴上げるから」"
]
},
{
"id": 25570,
"kind": "msg",
"jp": [
"「・・・それ、普通守られる方の",
"台詞やと思うねんけど」"
]
},
{
"id": 25571,
"kind": "msg",
"jp": [
"「すいませんねえ、",
"この人にしてみたら",
"精一杯じゃねえかと」"
]
},
{
"id": 25572,
"kind": "msg",
"jp": [
"「なんとなくわかる」"
]
},
{
"id": 25573,
"kind": "msg",
"jp": [
"「ありがと・・・って、日織?」"
]
},
{
"id": 25574,
"kind": "msg",
"jp": [
"「あんた、どっから湧いたん・・・」"
]
},
{
"id": 25575,
"kind": "msg",
"jp": [
"「階段からです。",
"まあ、部屋に2人でいて廊下にも",
"2人いりゃ安全でしょう」"
]
},
{
"id": 25576,
"kind": "msg",
"jp": [
"「いつの間に数に入ったんだ、日織」"
]
},
{
"id": 25577,
"kind": "msg",
"jp": [
"「細かいことは気にしねえで。",
"お嬢さんの安全のためです」"
]
},
{
"id": 25578,
"kind": "msg",
"jp": [
"「・・・いや、そうなんだけど」"
]
},
{
"id": 25579,
"kind": "msg",
"jp": [
"「ちゅうか、あんた止める気は",
"全然無いねんな・・・」"
]
},
{
"id": 25580,
"kind": "msg",
"jp": [
"「そりゃもう、{和/なご}さん",
"こうなったら聞きゃしませんから」"
]
},
{
"id": 25581,
"kind": "msg",
"jp": [
"「放っといたら、勝手に朝まで",
"廊下に張りついてるのがオチです」"
]
},
{
"id": 25582,
"kind": "msg",
"jp": [
"「・・・結果同じ」"
]
},
{
"id": 25583,
"kind": "msg",
"jp": [
"「同じです」"
]
},
{
"id": 25584,
"kind": "msg",
"jp": [
"「保護者同伴も?」"
]
},
{
"id": 25585,
"kind": "msg",
"jp": [
"「保護者って何?」"
]
},
{
"id": 25586,
"kind": "msg",
"jp": [
"「・・・お兄さん、",
"世の中には知らん方が幸せな",
"ことってあるねんで」"
]
},
{
"id": 25587,
"kind": "msg",
"jp": [
"「ど、どういう意味!?」"
]
},
{
"id": 25588,
"kind": "msg",
"jp": [
"「・・・じゃあ、お願い」"
]
},
{
"id": 25589,
"kind": "msg",
"jp": [
"「はい、お願いされました」"
]
},
{
"id": 25590,
"kind": "msg",
"jp": [
"「あ? え?」"
]
},
{
"id": 25591,
"kind": "msg",
"jp": [
"「護衛」"
]
},
{
"id": 25592,
"kind": "msg",
"jp": [
"「あ・・うん、もちろん!",
"大丈夫、朝まで寝ないから!」"
]
},
{
"id": 25593,
"kind": "msg",
"jp": [
"「誰か来ても追っ払うからと",
"ちゃうんかいな」"
]
},
{
"id": 25594,
"kind": "msg",
"jp": [
"「それは俺の仕事ですから。",
"この人にそんな勇ましいこと",
"期待しねえで下さい」"
]
},
{
"id": 25595,
"kind": "msg",
"jp": [
"「過保護」"
]
},
{
"id": 25596,
"kind": "msg",
"jp": [
"なんとなく、知らない方が幸せな",
"ことの意味がわかった・・・。"
]
},
{
"id": 25597,
"kind": "msg",
"jp": [
"「じゃ、鈴奈さんが静奈さんの",
"部屋に泊まるってことで」"
]
},
{
"id": 25598,
"kind": "msg",
"jp": [
"「俺と{和/なご}さんは廊下で",
"見張ってますから」"
]
},
{
"id": 25599,
"kind": "msg",
"jp": [
"「いいよ」"
]
},
{
"id": 25600,
"kind": "msg",
"jp": [
"「わかったわかった・・・。",
"ほんま、何かあったら追っ払うてや」"
]
},
{
"id": 25601,
"kind": "msg",
"jp": [
"「任せて下さい」"
]
},
{
"id": 25602,
"kind": "msg",
"jp": [
"「・・・悲鳴上げてね」"
]
},
{
"id": 25603,
"kind": "msg",
"jp": [
"自分で言ったとはいえ、頼まれ方が",
"普通の護衛にはあり得ない内容に",
"なってる・・・。"
]
},
{
"id": 25604,
"kind": "msg",
"jp": [
"「ほな行こ、お姉ちゃん」"
]
},
{
"id": 25605,
"kind": "msg",
"jp": [
"「うん、また朝にね」"
]
},
{
"id": 25606,
"kind": "msg",
"jp": [
"「おやすみ、朝に会おうね」"
]
},
{
"id": 25607,
"kind": "msg",
"jp": [
"双子は揃って静奈ちゃんの部屋に",
"入っていった。"
]
},
{
"id": 25608,
"kind": "msg",
"jp": [
"「さーて、俺らもその辺に",
"陣取りますか」"
]
},
{
"id": 25609,
"kind": "msg",
"jp": [
"「あのさぁ・・・」"
]
},
{
"id": 25610,
"kind": "msg",
"jp": [
"「なんか、ごめんな。",
"巻き込んじゃって」"
]
},
{
"id": 25611,
"kind": "msg",
"jp": [
"「俺が勝手に割り込んだのに",
"何言ってんですか、あんたは」"
]
},
{
"id": 25612,
"kind": "msg",
"jp": [
"「だって、心配してくれたんだろ?",
"また無茶してると思って」"
]
},
{
"id": 25613,
"kind": "msg",
"jp": [
"「もちろんそうです」"
]
},
{
"id": 25614,
"kind": "msg",
"jp": [
"「・・・ご・・・」"
]
},
{
"id": 25615,
"kind": "msg",
"jp": [
"「はいはい、ごめんはナシです。",
"言ったでしょうが、俺は勝手に",
"割り込んだんですってば」"
]
},
{
"id": 25616,
"kind": "msg",
"jp": [
"「みんな無事な方が",
"いいじゃねえですかい」"
]
},
{
"id": 25617,
"kind": "msg",
"jp": [
"「そりゃそうだけど」"
]
},
{
"id": 25618,
"kind": "msg",
"jp": [
"「だったら、お嬢さん方だけじゃ",
"なくて{和/なご}さんも無事でねえと」"
]
},
{
"id": 25619,
"kind": "msg",
"jp": [
"「せっかく生き残ってんですから、",
"生きて帰りましょうや」"
]
},
{
"id": 25620,
"kind": "msg",
"jp": [
"「あと、たった2日じゃねえですか」"
]
},
{
"id": 25621,
"kind": "msg",
"jp": [
"「ね。",
"頑張りましょう」"
]
},
{
"id": 25622,
"kind": "msg",
"jp": [
"「じゃ、その辺にいますか。",
"角曲がったとこなら、誰か近づいて",
"来てもすぐバレねえし」"
]
},
{
"id": 25623,
"kind": "msg",
"jp": [
"静奈ちゃん達の部屋が並ぶ廊下の",
"一番奥に座り込む。"
]
},
{
"id": 25624,
"kind": "msg",
"jp": [
"「犯人が、こりゃ無理だと思って",
"引き上げてくれりゃいいんですがね」"
]
},
{
"id": 25625,
"kind": "msg",
"jp": [
"「・・・日織ってさあ」"
]
},
{
"id": 25626,
"kind": "msg",
"jp": [
"「本当に、来ても追っ払える",
"くらい強い?」"
]
},
{
"id": 25627,
"kind": "msg",
"jp": [
"「・・・強いから安心して下さい」"
]
},
{
"id": 25628,
"kind": "msg",
"jp": [
"「那須さんとどっちが強い?」"
]
},
{
"id": 25629,
"kind": "msg",
"jp": [
"「真剣使っていいなら、なんとか」"
]
},
{
"id": 25630,
"kind": "msg",
"jp": [
"「勝てるんだ!?」"
]
},
{
"id": 25631,
"kind": "msg",
"jp": [
"「・・・そっちに驚くんですかい」"
]
},
{
"id": 25632,
"kind": "msg",
"jp": [
"「いや、だって」"
]
},
{
"id": 25633,
"kind": "msg",
"jp": [
"「大丈夫ですって、並大抵の",
"相手だったら負けませんから」"
]
},
{
"id": 25634,
"kind": "msg",
"jp": [
"「何もないのが一番いいけどね」"
]
},
{
"id": 25635,
"kind": "msg",
"jp": [
"本当に・・・。",
"朝まで、何もなければ",
"いいんだけど・・・。"
]
},
{
"id": 25636,
"kind": "msg",
"jp": [
"（静奈ちゃん、鈴奈ちゃん、",
"きっと会おうね・・・）"
]
},
{
"id": 25637,
"kind": "msg",
"jp": [
"（朝になったら、元気で・・・）"
]
},
{
"id": 25638,
"kind": "msg",
"jp": [
"ふと気になって、階段を上った所で",
"足を止めた。"
]
},
{
"id": 25639,
"kind": "msg",
"jp": [
"「ボイラー消したっけ?」"
]
},
{
"id": 25640,
"kind": "msg",
"jp": [
"「ああ、大丈夫ですよ。",
"ちゃんと消しました」"
]
},
{
"id": 25641,
"kind": "msg",
"jp": [
"悲鳴に近い声で意味不明の",
"返事をして部屋から転がり出た。"
]
},
{
"id": 25642,
"kind": "msg",
"jp": [
"「だ、誰か・・・日織っ・・・!",
"助けて・・・っ!!」"
]
},
{
"id": 25643,
"kind": "msg",
"jp": [
"走る、というより這うような姿勢で",
"ひたすら逃げる。"
]
},
{
"id": 25644,
"kind": "msg",
"jp": [
"後ろから御陵さんが追って来てるのか",
"どうかも見てる余裕がなかった。"
]
},
{
"id": 25645,
"kind": "msg",
"jp": [
"「ひお・・・あああ、いたー!",
"よかったー!!」"
]
},
{
"id": 25646,
"kind": "msg",
"jp": [
"「どうしたん・・・・」"
]
},
{
"id": 25647,
"kind": "msg",
"jp": [
"「そっ、それが、あの・・・」"
]
},
{
"id": 25648,
"kind": "msg",
"jp": [
"「・・・日織・・・?」"
]
},
{
"id": 25649,
"kind": "msg",
"jp": [
"日織は僕ではなく、その後ろにいる",
"{誰/・}{か/・}を見ていた。",
"ひどく、強ばった表情で・・・。"
]
},
{
"id": 25650,
"kind": "msg",
"jp": [
"「・・・{和/なご}さん、下がって」"
]
},
{
"id": 25651,
"kind": "msg",
"jp": [
"「み・・・御陵さん・・・」"
]
},
{
"id": 25652,
"kind": "msg",
"jp": [
"血の気のない、何の表情も",
"浮かんでいない顔で・・・。"
]
},
{
"id": 25653,
"kind": "msg",
"jp": [
"御陵さんが、そこに立っていた。"
]
},
{
"id": 25654,
"kind": "msg",
"jp": [
"「ごめんなさいね・・・」"
]
},
{
"id": 25655,
"kind": "msg",
"jp": [
"「この館は、",
"もうすぐ崩れるの・・・」"
]
},
{
"id": 25656,
"kind": "msg",
"jp": [
"「く、崩れる!?」"
]
},
{
"id": 25657,
"kind": "msg",
"jp": [
"「何言ってんです、あんた・・・?」"
]
},
{
"id": 25658,
"kind": "msg",
"jp": [
"「最後の楔も抜くから」"
]
},
{
"id": 25659,
"kind": "msg",
"jp": [
"「だから、もう終わり」"
]
},
{
"id": 25660,
"kind": "msg",
"jp": [
"「な・・・",
"なんのこと・・・?」"
]
},
{
"id": 25661,
"kind": "msg",
"jp": [
"「・・・さよなら」"
]
},
{
"id": 25662,
"kind": "msg",
"jp": [
"「あっ!",
"御陵さんっ!?」"
]
},
{
"id": 25663,
"kind": "msg",
"jp": [
"御陵さんは身を翻し、僕らを残して",
"階段を駆け降りていった。"
]
},
{
"id": 25664,
"kind": "msg",
"jp": [
"「ちょっ・・・",
"待って下さいよ!!」"
]
},
{
"id": 25665,
"kind": "msg",
"jp": [
"慌てて追いかけた僕を",
"日織が追ってくる。"
]
},
{
"id": 25666,
"kind": "msg",
"jp": [
"「御陵さん、どこ!?」"
]
},
{
"id": 25667,
"kind": "msg",
"jp": [
"「{和/なご}さん、危ねえから・・・!」"
]
},
{
"id": 25668,
"kind": "msg",
"jp": [
"「でも崩れるって!",
"とっ、止めないと、",
"もっと危ないんじゃない!?」"
]
},
{
"id": 25669,
"kind": "msg",
"jp": [
"「確かにヤバそうですが・・・」"
]
},
{
"id": 25670,
"kind": "msg",
"jp": [
"「・・・なんかヤな音が」"
]
},
{
"id": 25671,
"kind": "msg",
"jp": [
"「どうしようっ!?",
"く、崩れ・・・本当に崩れる!?」"
]
},
{
"id": 25672,
"kind": "msg",
"jp": [
"「どうするったって・・・",
"最後の楔とかって",
"なんのことだか・・・」"
]
},
{
"id": 25673,
"kind": "msg",
"jp": [
"「{和/なご}さん、",
"なんだかわかります?」"
]
},
{
"id": 25674,
"kind": "msg",
"jp": [
"「だっ、誰か・・・!",
"日織ーっ!! 助けてー!!」"
]
},
{
"id": 25675,
"kind": "msg",
"jp": [
"「あああ、日織っ!",
"どうしよう、御陵さんがっ!!」"
]
},
{
"id": 25676,
"kind": "msg",
"jp": [
"「御陵さんって・・・」"
]
},
{
"id": 25677,
"kind": "msg",
"jp": [
"「わあぁっ!?」"
]
},
{
"id": 25678,
"kind": "msg",
"jp": [
"「な・・・",
"なんです、今の!?」"
]
},
{
"id": 25679,
"kind": "msg",
"jp": [
"「くっ、崩れ、崩れるんだよ!",
"楔で、館が・・・!」"
]
},
{
"id": 25680,
"kind": "msg",
"jp": [
"「いや、{和/なご}さん落ち着いて。",
"何がなんだかさっぱり」"
]
},
{
"id": 25681,
"kind": "msg",
"jp": [
"「御陵さんが、館崩すって言って、",
"最後の楔が・・・」"
]
},
{
"id": 25682,
"kind": "msg",
"jp": [
"「御陵さん、が・・・",
"犯人だったってことですかい」"
]
},
{
"id": 25683,
"kind": "msg",
"jp": [
"「そっ、そう!",
"そうなんだけどっ・・・」"
]
},
{
"id": 25684,
"kind": "msg",
"jp": [
"「わーっ!?",
"揺れてる! 揺れてるっ!!」"
]
},
{
"id": 25685,
"kind": "msg",
"jp": [
"「で、どうすりゃいいんです。",
"楔ってのはなんのことです?」"
]
},
{
"id": 25686,
"kind": "choice",
"jp": [
"わかった"
]
},
{
"id": 25687,
"kind": "choice",
"jp": [
"無理だ"
]
},
{
"id": 25688,
"kind": "choice",
"jp": [
"赤から"
]
},
{
"id": 25689,
"kind": "choice",
"jp": [
"青から"
]
},
{
"id": 25690,
"kind": "choice",
"jp": [
"1階は関係ない"
]
},
{
"id": 25691,
"kind": "choice",
"jp": [
"1階だけ探せばいい"
]
},
{
"id": 25692,
"kind": "msg",
"jp": [
"「わ、わ、わかんない!",
"さっぱり!!」"
]
},
{
"id": 25693,
"kind": "msg",
"jp": [
"「そいじゃ、逃げた方が",
"いいってことですね」"
]
},
{
"id": 25694,
"kind": "msg",
"jp": [
"「え、えっと・・・これ!?」"
]
},
{
"id": 25695,
"kind": "msg",
"jp": [
"「どう見ても楔にゃ見えませんって!",
"ちょいと見せて下さいな」"
]
},
{
"id": 25696,
"kind": "msg",
"jp": [
"「えええ、",
"だって他に持ってる物って・・・」"
]
},
{
"id": 25697,
"kind": "msg",
"jp": [
"「・・・これじゃねえんで?」"
]
},
{
"id": 25698,
"kind": "msg",
"jp": [
"「楔みたいだね」"
]
},
{
"id": 25699,
"kind": "msg",
"jp": [
"「でしょう。",
"けど、6本もあるとはなぁ・・・」"
]
},
{
"id": 25700,
"kind": "msg",
"jp": [
"「こりゃ・・・",
"俺ら二人じゃ間に合いそうに",
"ねえですぜ」"
]
},
{
"id": 25701,
"kind": "msg",
"jp": [
"「で、でもそれじゃ崩れ・・・」"
]
},
{
"id": 25702,
"kind": "msg",
"jp": [
"「どう見ても楔にゃ見えませんって!",
"逃げた方がいいってことですね」"
]
},
{
"id": 25703,
"kind": "msg",
"jp": [
"「え、く、楔・・・",
"楔って・・・」"
]
},
{
"id": 25704,
"kind": "msg",
"jp": [
"「ああっ、これ!?",
"なんか地下で拾ってそのまんま",
"もって来ちゃったんだけど」"
]
},
{
"id": 25705,
"kind": "msg",
"jp": [
"「それって・・・",
"6本もあるんですかい!?」"
]
},
{
"id": 25706,
"kind": "msg",
"jp": [
"「・・・あるね」"
]
},
{
"id": 25707,
"kind": "msg",
"jp": [
"「どっかにはめ込まなきゃ",
"いけねえんでしょう、これ」"
]
},
{
"id": 25708,
"kind": "msg",
"jp": [
"大きな横揺れが起きて、",
"バランスを崩してしまう。"
]
},
{
"id": 25709,
"kind": "msg",
"jp": [
"「いっ・・て・・・」"
]
},
{
"id": 25710,
"kind": "msg",
"jp": [
"「日織・・・うわ!?」"
]
},
{
"id": 25711,
"kind": "msg",
"jp": [
"顔を上げようとすると、",
"すぐ目の前に何かが落ちてきた。"
]
},
{
"id": 25712,
"kind": "msg",
"jp": [
"「わ、わっ・・・!?」"
]
},
{
"id": 25713,
"kind": "msg",
"jp": [
"「つかまって!",
"走りますぜ!!」"
]
},
{
"id": 25714,
"kind": "msg",
"jp": [
"「えっ・・・わぁっ!?」"
]
},
{
"id": 25715,
"kind": "msg",
"jp": [
"驚くほど強い力で引き起こされた。",
"何がなんだかわからず引っ張られる",
"ままに必死に走る・・・。"
]
},
{
"id": 25716,
"kind": "msg",
"jp": [
"「日織!",
"日織ーっ!? どこー!?」"
]
},
{
"id": 25717,
"kind": "msg",
"jp": [
"揺れる階段を転げ落ちそうに",
"なりながら駆け降りる。"
]
},
{
"id": 25718,
"kind": "msg",
"jp": [
"「ひお・・・うわぁっ!?」"
]
},
{
"id": 25719,
"kind": "msg",
"jp": [
"盛大な揺れに階段を踏み外して",
"2、3段を滑り落ちた。"
]
},
{
"id": 25720,
"kind": "msg",
"jp": [
"「痛ぁ・・・」"
]
},
{
"id": 25721,
"kind": "msg",
"jp": [
"「{和/なご}さん!?",
"大丈夫ですかい?」"
]
},
{
"id": 25722,
"kind": "msg",
"jp": [
"「こ、腰打った・・・」"
]
},
{
"id": 25723,
"kind": "msg",
"jp": [
"「おっと」"
]
},
{
"id": 25724,
"kind": "msg",
"jp": [
"「ま、また揺れてる!",
"ねえこれ、逃げた方がよくない!?」"
]
},
{
"id": 25725,
"kind": "msg",
"jp": [
"「俺もそう思います。",
"この音、ただ事じゃねえでしょう」"
]
},
{
"id": 25726,
"kind": "msg",
"jp": [
"もの凄い音と同時に、",
"床が波打つように歪んで軋む。"
]
},
{
"id": 25727,
"kind": "msg",
"jp": [
"「て、てて、天井っ・・・",
"ひびがっ・・・!!」"
]
},
{
"id": 25728,
"kind": "msg",
"jp": [
"「ええ、こりゃもう駄目です!",
"逃げますぜ!!」"
]
},
{
"id": 25729,
"kind": "msg",
"jp": [
"座り込んだままの僕の腕を引き、",
"日織は走り出した。"
]
},
{
"id": 25730,
"kind": "msg",
"jp": [
"「う、わ・・・!!」"
]
},
{
"id": 25731,
"kind": "msg",
"jp": [
"「僕にもわかんないよ!",
"楔って言われても・・・」"
]
},
{
"id": 25732,
"kind": "msg",
"jp": [
"「それじゃ逃げるしか",
"なさそうですね」"
]
},
{
"id": 25733,
"kind": "msg",
"jp": [
"「う、うん!",
"あ、でも他の人・・・」"
]
},
{
"id": 25734,
"kind": "msg",
"jp": [
"突然激しい横揺れが起きて",
"足元をすくわれた。"
]
},
{
"id": 25735,
"kind": "msg",
"jp": [
"「痛っ・・・」"
]
},
{
"id": 25736,
"kind": "msg",
"jp": [
"「大丈夫ですかい?",
"ほら、捕まって」"
]
},
{
"id": 25737,
"kind": "msg",
"jp": [
"「っ・・・",
"あ、足くじいた、かも」"
]
},
{
"id": 25738,
"kind": "msg",
"jp": [
"立ち上がろうとすると、足首に",
"変な痛みが走って上手く立てなかった。"
]
},
{
"id": 25739,
"kind": "msg",
"jp": [
"振動とともに頭上から埃が降ってくる。",
"壁も窓もびりびりと震えて、館全体が",
"異様な不協和音を奏でてるみたいだ。"
]
},
{
"id": 25740,
"kind": "msg",
"jp": [
"「悠長に話してる暇は",
"なさそうですね・・・!」"
]
},
{
"id": 25741,
"kind": "msg",
"jp": [
"「ちょっと待ってて下さい」"
]
},
{
"id": 25742,
"kind": "msg",
"jp": [
"そう言うと日織は玄関脇の",
"内線電話に飛びついた。"
]
},
{
"id": 25743,
"kind": "msg",
"jp": [
"「・・・あ、まだいましたか!",
"逃げて下さい、崩れますから!」"
]
},
{
"id": 25744,
"kind": "msg",
"jp": [
"「ええ、早く!",
"俺ら先に出ますからね!?」"
]
},
{
"id": 25745,
"kind": "msg",
"jp": [
"そうか、他の人・・・。",
"地震か何かだと思って",
"まだ部屋にいたんだ・・・。"
]
},
{
"id": 25746,
"kind": "msg",
"jp": [
"だんだん揺れが強くなってる。",
"みんな間に合うかな・・・。"
]
},
{
"id": 25747,
"kind": "msg",
"jp": [
"「行きますぜ、{和/なご}さん!」"
]
},
{
"id": 25748,
"kind": "msg",
"jp": [
"「え・・・わぁっ!?」"
]
},
{
"id": 25749,
"kind": "msg",
"jp": [
"日織が僕の横にしゃがみ込んだかと",
"思うと、あっという間に",
"担ぎ上げられていた。"
]
},
{
"id": 25750,
"kind": "msg",
"jp": [
"「う、わ・・・」"
]
},
{
"id": 25751,
"kind": "msg",
"jp": [
"地面が沈むような感覚がした。",
"そして、視界の隅で、あの大時計が",
"ゆっくりと倒れようとして――"
]
},
{
"id": 25752,
"kind": "msg",
"jp": [
"「く、楔・・・",
"ああっ、これ!?」"
]
},
{
"id": 25753,
"kind": "msg",
"jp": [
"「地下室で拾ったやつ!」"
]
},
{
"id": 25754,
"kind": "msg",
"jp": [
"「・・・これっぽいですね」"
]
},
{
"id": 25755,
"kind": "msg",
"jp": [
"「こいつをはめ直せば",
"いいってことですかい」"
]
},
{
"id": 25756,
"kind": "msg",
"jp": [
"「た、多分・・・でも・・・」"
]
},
{
"id": 25757,
"kind": "msg",
"jp": [
"「数が多いな。",
"俺ら二人じゃあ・・・」"
]
},
{
"id": 25758,
"kind": "msg",
"jp": [
"「おおい、和くん! 日織くん!」"
]
},
{
"id": 25759,
"kind": "msg",
"jp": [
"「なんだぁ、こりゃあ!?",
"地震じゃねーだろ!?」"
]
},
{
"id": 25760,
"kind": "msg",
"jp": [
"「那須さん、椿くん!!」"
]
},
{
"id": 25761,
"kind": "msg",
"jp": [
"「よかった、無事でしたか」"
]
},
{
"id": 25762,
"kind": "msg",
"jp": [
"「・・・暗石さんは?」"
]
},
{
"id": 25763,
"kind": "msg",
"jp": [
"「それが、一応声掛けたんだけど",
"返事もしてくれなくてさ」"
]
},
{
"id": 25764,
"kind": "msg",
"jp": [
"「こりゃあ、俺らだけで",
"なんとかするしかなさそうですね」"
]
}
]