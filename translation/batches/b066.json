[
{
"id": 32538,
"kind": "msg",
"jp": [
"「なんでもありませんーっ!」"
]
},
{
"id": 32539,
"kind": "msg",
"jp": [
"「ど、どうしたんだろう・・・」"
]
},
{
"id": 32540,
"kind": "msg",
"jp": [
"「なんだ?",
"御陵の奴、なんで半泣きで",
"逃げてったんだ?」"
]
},
{
"id": 32541,
"kind": "msg",
"jp": [
"「さあ・・・?",
"密室がどうとか言って",
"ましたけど・・・」"
]
},
{
"id": 32542,
"kind": "msg",
"jp": [
"「なんか、さっきから",
"様子が変なんですよね」"
]
},
{
"id": 32543,
"kind": "msg",
"jp": [
"「・・・無理もないんですけど」"
]
},
{
"id": 32544,
"kind": "msg",
"jp": [
"「え?",
"どうしてだい?」"
]
},
{
"id": 32545,
"kind": "msg",
"jp": [
"「那須さんがいきなり",
"生き返ったからですよっ!?」"
]
},
{
"id": 32546,
"kind": "msg",
"jp": [
"廊下からとはいえ、",
"ばっちり見てただろうしなぁ・・。"
]
},
{
"id": 32547,
"kind": "msg",
"jp": [
"「・・・本当にそれだけか?」"
]
},
{
"id": 32548,
"kind": "msg",
"jp": [
"「あの動揺っぷりは",
"ただ事じゃねえぞ」"
]
},
{
"id": 32549,
"kind": "msg",
"jp": [
"「御陵があの状態じゃ、",
"小僧はもっと動揺してても",
"おかしくねえと思うが?」"
]
},
{
"id": 32550,
"kind": "msg",
"jp": [
"「そ、それもそうですね」"
]
},
{
"id": 32551,
"kind": "msg",
"jp": [
"自分で言うのもなんだけど。",
"僕は毒飲んだところから",
"見てたもんな。"
]
},
{
"id": 32552,
"kind": "msg",
"jp": [
"「でも、じゃあ御陵さんは",
"なんであんなに・・・?」"
]
},
{
"id": 32553,
"kind": "msg",
"jp": [
"「あの女が犯人なんじゃねえか?」"
]
},
{
"id": 32554,
"kind": "msg",
"jp": [
"「さっきからぎゃーぎゃー",
"騒いでた話じゃ、那須は毒を",
"盛られてたらしいじゃねえか」"
]
},
{
"id": 32555,
"kind": "msg",
"jp": [
"「まだお腹痛いよ、ちょっと」"
]
},
{
"id": 32556,
"kind": "msg",
"jp": [
"「それだけで済むって",
"お前どういう・・・いや、",
"まあ、それはいいや」"
]
},
{
"id": 32557,
"kind": "msg",
"jp": [
"「しかし、その状況で",
"一番うろたえるのは",
"毒盛った犯人だろうよ」"
]
},
{
"id": 32558,
"kind": "msg",
"jp": [
"毒殺したはずの人が、",
"平然と起きあがってきたら",
"呆然とするよな・・・。"
]
},
{
"id": 32559,
"kind": "msg",
"jp": [
"「もしかして・・・",
"御陵さんが犯人かも・・・」"
]
},
{
"id": 32560,
"kind": "msg",
"jp": [
"「御陵さんが?",
"なんで?」"
]
},
{
"id": 32561,
"kind": "msg",
"jp": [
"「だって、毒殺したはずの",
"那須さんが生きてて一番驚くのは",
"犯人じゃないですか?」"
]
},
{
"id": 32562,
"kind": "msg",
"jp": [
"「・・・ああ!",
"それもそうだね」"
]
},
{
"id": 32563,
"kind": "msg",
"jp": [
"それも、飲んだのに効かなかった",
"なんて信じられないだろうな。"
]
},
{
"id": 32564,
"kind": "msg",
"jp": [
"（実際、目の前で見た僕も",
"信じられないんだから・・・）"
]
},
{
"id": 32565,
"kind": "msg",
"jp": [
"「うーん、でも",
"御陵さんが犯人って",
"ぴんと来ないなあ」"
]
},
{
"id": 32566,
"kind": "msg",
"jp": [
"「よし!",
"本人に聞いてみよう!」"
]
},
{
"id": 32567,
"kind": "msg",
"jp": [
"「そうですね・・・って",
"<fs 120>えええ!?<fs>」"
]
},
{
"id": 32568,
"kind": "msg",
"jp": [
"「ちょ、ちょっと待って",
"那須さーんっ!?」"
]
},
{
"id": 32569,
"kind": "msg",
"jp": [
"「おーい、御陵さーん!」"
]
},
{
"id": 32570,
"kind": "msg",
"jp": [
"「な、那須さんっ!!",
"ドアノブもがないで下さいよ!?」"
]
},
{
"id": 32571,
"kind": "msg",
"jp": [
"「開けちゃ駄目なのかい?」"
]
},
{
"id": 32572,
"kind": "msg",
"jp": [
"「御陵さーん!!",
"犯人ですかー?」"
]
},
{
"id": 32573,
"kind": "msg",
"jp": [
"「那須さん、ドアっ!",
"叩きすぎ!!",
"変な音してるっ!?」"
]
},
{
"id": 32574,
"kind": "msg",
"jp": [
"「・・・なんか",
"みしって言ったね」"
]
},
{
"id": 32575,
"kind": "msg",
"jp": [
"「ぶち抜かないで",
"下さいね!?」"
]
},
{
"id": 32576,
"kind": "msg",
"jp": [
"「だって御陵さんが",
"返事してくれないんだよ」"
]
},
{
"id": 32577,
"kind": "msg",
"jp": [
"「御陵さんってばー、",
"犯人なのー!?」"
]
},
{
"id": 32578,
"kind": "msg",
"jp": [
"「<fs 120>もういやーっ!!<fs>」"
]
},
{
"id": 32579,
"kind": "msg",
"jp": [
"「こんなの予想してないー!",
"どうしてこんな事にーっ!?」"
]
},
{
"id": 32580,
"kind": "msg",
"jp": [
"「・・・なんか泣いてるよ?」"
]
},
{
"id": 32581,
"kind": "msg",
"jp": [
"泣きたくもなるかも。",
"毒飲ませても効かないって",
"予想してるわけないよな。"
]
},
{
"id": 32582,
"kind": "msg",
"jp": [
"「僕のせいかなあ?」"
]
},
{
"id": 32583,
"kind": "msg",
"jp": [
"「ある意味そうですが",
"那須さんの責任じゃないです」"
]
},
{
"id": 32584,
"kind": "msg",
"jp": [
"「? なんだい、それ?」"
]
},
{
"id": 32585,
"kind": "msg",
"jp": [
"「その、つまり頑丈すぎた",
"だけなんで・・・」"
]
},
{
"id": 32586,
"kind": "msg",
"jp": [
"「<fs 110>頑丈どころじゃないわよー!<fs>",
"<fs 110>人間じゃないわっ!!<fs>」"
]
},
{
"id": 32587,
"kind": "msg",
"jp": [
"「もういやー!!",
"梨奈ぁ、助けてー!!」"
]
},
{
"id": 32588,
"kind": "msg",
"jp": [
"「・・・梨奈って誰だろう?」"
]
},
{
"id": 32589,
"kind": "msg",
"jp": [
"「おい、どうだ?",
"犯人だったのか?」"
]
},
{
"id": 32590,
"kind": "msg",
"jp": [
"「多分そうみたい",
"なんですけど・・・」"
]
},
{
"id": 32591,
"kind": "msg",
"jp": [
"「・・・もう何も",
"しないかもしれません」"
]
},
{
"id": 32592,
"kind": "msg",
"jp": [
"「なんでだ」"
]
},
{
"id": 32593,
"kind": "msg",
"jp": [
"「泣いちゃってます」"
]
},
{
"id": 32594,
"kind": "msg",
"jp": [
"「みんな嫌いー!",
"なんで生き返るのよぉー!」"
]
},
{
"id": 32595,
"kind": "msg",
"jp": [
"「やけ起こして暴れられても",
"困るんだが」"
]
},
{
"id": 32596,
"kind": "msg",
"jp": [
"「暴れ出したら",
"取り押さえれば良くない?」"
]
},
{
"id": 32597,
"kind": "msg",
"jp": [
"「お前が取り押さえたら",
"それこそ大惨事になりかねん」"
]
},
{
"id": 32598,
"kind": "msg",
"jp": [
"「体格差ありすぎですよね・・・」"
]
},
{
"id": 32599,
"kind": "msg",
"jp": [
"「どうしましょう?」"
]
},
{
"id": 32600,
"kind": "msg",
"jp": [
"「それこそタンスか何かで",
"扉ふさいどけ」"
]
},
{
"id": 32601,
"kind": "msg",
"jp": [
"「御陵が出てこれなきゃ、",
"俺らは安全だろうが」"
]
},
{
"id": 32602,
"kind": "msg",
"jp": [
"「そうか、なるほど!」"
]
},
{
"id": 32603,
"kind": "msg",
"jp": [
"「閉じこめるんですか?」"
]
},
{
"id": 32604,
"kind": "msg",
"jp": [
"「あ、でも、ベランダから",
"飛び降りたら出られるなあ」"
]
},
{
"id": 32605,
"kind": "msg",
"jp": [
"「飛び降りて無事なのは",
"お前くらいだと思うが・・・」"
]
},
{
"id": 32606,
"kind": "msg",
"jp": [
"「まあ、ロープか何か",
"ありゃ出られん事もねえか」"
]
},
{
"id": 32607,
"kind": "msg",
"jp": [
"「じゃあベランダの扉も",
"タンスでふさがないと」"
]
},
{
"id": 32608,
"kind": "msg",
"jp": [
"「こんな雨の中に出したら",
"家具が傷んじゃいますよ!」"
]
},
{
"id": 32609,
"kind": "msg",
"jp": [
"「ロープか、その代わりに",
"なりそうなもんがなけりゃ",
"大丈夫だと思うがな」"
]
},
{
"id": 32610,
"kind": "msg",
"jp": [
"「・・・空き部屋に入って",
"調べてみます」"
]
},
{
"id": 32611,
"kind": "msg",
"jp": [
"「ああ、こっち側の部屋",
"ベランダもつながってん",
"だったな」"
]
},
{
"id": 32612,
"kind": "msg",
"jp": [
"「全部の部屋の扉の前に",
"タンス置いとけよ。",
"じゃあ、おやすみ」"
]
},
{
"id": 32613,
"kind": "msg",
"jp": [
"「えーと、いくついるのかな。",
"僕の部屋のも持ってくるね!」"
]
},
{
"id": 32614,
"kind": "msg",
"jp": [
"「あ、あの、那須さ・・・」"
]
},
{
"id": 32615,
"kind": "msg",
"jp": [
"「・・・いいのかなぁ」"
]
},
{
"id": 32616,
"kind": "msg",
"jp": [
"「・・・まあ。",
"いいんじゃねえですかい?」"
]
},
{
"id": 32617,
"kind": "msg",
"jp": [
"「少なくとも、これ以上",
"犠牲者は出ねえでしょ」"
]
},
{
"id": 32618,
"kind": "msg",
"jp": [
"「那須さんがふさいじまわねえ",
"うちに調べちまいましょう」"
]
},
{
"id": 32619,
"kind": "msg",
"jp": [
"「・・・そうしよう」"
]
},
{
"id": 32620,
"kind": "msg",
"jp": [
"調べると、縄梯子があったので",
"それは僕らの部屋に隠してしまう",
"ことになった。",
" ",
"そして、那須さんがタンスを",
"担いできて空き部屋や双子の部屋の",
"扉も全部ふさいでしまい・・・"
]
},
{
"id": 32621,
"kind": "msg",
"jp": [
"「・・・ほな、おやすみ」"
]
},
{
"id": 32622,
"kind": "msg",
"jp": [
"「ごめんねえ、",
"お兄さん、着流しさん」"
]
},
{
"id": 32623,
"kind": "msg",
"jp": [
"・・・扉をふさぐことに",
"なった結果、僕と日織が",
"部屋を追い出された。"
]
},
{
"id": 32624,
"kind": "msg",
"jp": [
"「いいよ、僕らは",
"居間のソファで寝るから」"
]
},
{
"id": 32625,
"kind": "msg",
"jp": [
"「鈴奈ちゃん達は女の子",
"なんだからちゃんとベッドで",
"寝た方が・・・」"
]
},
{
"id": 32626,
"kind": "msg",
"jp": [
"「し、静奈ちゃん?",
"なんで笑うの?」"
]
},
{
"id": 32627,
"kind": "msg",
"jp": [
"「あははははは",
"なんでもない、なんでもない」"
]
},
{
"id": 32628,
"kind": "msg",
"jp": [
"「うんうん。",
"女の子女の子」"
]
},
{
"id": 32629,
"kind": "msg",
"jp": [
"「ほな、おやすみっ!」"
]
},
{
"id": 32630,
"kind": "msg",
"jp": [
"なんだったんだろう、",
"さっきの奇妙な笑顔・・・。"
]
},
{
"id": 32631,
"kind": "msg",
"jp": [
"「・・・おにーさーん」"
]
},
{
"id": 32632,
"kind": "msg",
"jp": [
"「お腹すいたー」"
]
},
{
"id": 32633,
"kind": "msg",
"jp": [
"「・・・あ、",
"静奈ちゃん」"
]
},
{
"id": 32634,
"kind": "msg",
"jp": [
"「やあ、{和/なご}さん。",
"起きましたかい?」"
]
},
{
"id": 32635,
"kind": "msg",
"jp": [
"「ふぁ・・・うん。",
"今、何時?」"
]
},
{
"id": 32636,
"kind": "msg",
"jp": [
"「もう、お昼過ぎてる」"
]
},
{
"id": 32637,
"kind": "msg",
"jp": [
"「うわ、本当?",
"ずいぶん寝てたんだな」"
]
},
{
"id": 32638,
"kind": "msg",
"jp": [
"「今朝、ベランダにおった」"
]
},
{
"id": 32639,
"kind": "msg",
"jp": [
"「<fs 110>えっ!? 見たの?<fs>」"
]
},
{
"id": 32640,
"kind": "msg",
"jp": [
"「うん。",
"けど、目が合うたら",
"すぐ部屋に逃げ込んだ」"
]
},
{
"id": 32641,
"kind": "msg",
"jp": [
"「ベランダからはさすがに",
"出ようとしなかったのか」"
]
},
{
"id": 32642,
"kind": "msg",
"jp": [
"「けど、危ないよ静奈ちゃん。",
"もし御陵さんが飛び降りてきたり",
"したら一人じゃあ・・・」"
]
},
{
"id": 32643,
"kind": "msg",
"jp": [
"「大丈夫、うちボウガン",
"構えとったから」"
]
},
{
"id": 32644,
"kind": "msg",
"jp": [
"「だって出てこられたら",
"困るやんか」"
]
},
{
"id": 32645,
"kind": "msg",
"jp": [
"「そりゃそうだけどね・・・」"
]
},
{
"id": 32646,
"kind": "msg",
"jp": [
"「はいはい、",
"何か昼飯作りますかね」"
]
},
{
"id": 32647,
"kind": "msg",
"jp": [
"「わーい」"
]
},
{
"id": 32648,
"kind": "msg",
"jp": [
"「あれ、電話だ」"
]
},
{
"id": 32649,
"kind": "msg",
"jp": [
"「誰やろ」"
]
},
{
"id": 32650,
"kind": "msg",
"jp": [
"「出てみるよ」"
]
},
{
"id": 32651,
"kind": "msg",
"jp": [
"「もしもし?」"
]
},
{
"id": 32652,
"kind": "msg",
"jp": [
"『・・・一柳、さん?』"
]
},
{
"id": 32653,
"kind": "msg",
"jp": [
"「へ!?",
"あ、み、御陵さん?」"
]
},
{
"id": 32654,
"kind": "msg",
"jp": [
"「御陵さんからですかい」"
]
},
{
"id": 32655,
"kind": "msg",
"jp": [
"「う、うん。",
"あの、御陵さん・・・?」"
]
},
{
"id": 32656,
"kind": "msg",
"jp": [
"『・・・ごめんなさい、",
"私が犯人です・・・』"
]
},
{
"id": 32657,
"kind": "msg",
"jp": [
"『もうしませんっ!!",
"反省しました、自首します!』"
]
},
{
"id": 32658,
"kind": "msg",
"jp": [
"『だから、もう・・・",
"許して下さい・・・",
"・・・怖いです・・・』"
]
},
{
"id": 32659,
"kind": "msg",
"jp": [
"「え、あの、怖いって・・・",
"ああ、閉じこめてるから?」"
]
},
{
"id": 32660,
"kind": "msg",
"jp": [
"『だって、",
"だって庭に・・・!』"
]
},
{
"id": 32661,
"kind": "msg",
"jp": [
"「庭?」"
]
},
{
"id": 32662,
"kind": "msg",
"jp": [
"「あ、もしかして庭って",
"今も誰か見張ってるの?」"
]
},
{
"id": 32663,
"kind": "msg",
"jp": [
"「那須さんが。",
"さっき見たら斧担いで",
"スクワットしてた」"
]
},
{
"id": 32664,
"kind": "msg",
"jp": [
"犯人だけど。",
"御陵さんは本当に犯人",
"だったんだけど。"
]
},
{
"id": 32665,
"kind": "msg",
"jp": [
"なんだか心底、",
"同情してしまった・・・。"
]
},
{
"id": 32666,
"kind": "msg",
"jp": [
"『<fs 110>もう許してーっ!!<fs>",
"<fs 110>私が悪かったですぅ・・!<fs>』"
]
},
{
"id": 32667,
"kind": "msg",
"jp": [
"ざひょう"
]
},
{
"id": 32668,
"kind": "msg",
"jp": [
"このホールだけで、僕の家の",
"1階部分が入ってしまいそうだ。"
]
},
{
"id": 32669,
"kind": "msg",
"jp": [
"やっぱり書斎へ行こう。"
]
},
{
"id": 32670,
"kind": "msg",
"jp": [
"この本棚はほとんど洋書ばかりの",
"ようだ。",
"読める本を探そう。"
]
},
{
"id": 32671,
"kind": "msg",
"jp": [
"この本棚に並んでいるのは英語でも",
"なさそうな外国語の本だ。",
"読める本を探そう。"
]
},
{
"id": 32672,
"kind": "msg",
"jp": [
"（・・・違うよ、本当は違う）"
]
},
{
"id": 32673,
"kind": "msg",
"jp": [
"そう信じたいのに、頭では",
"もう、日織が犯人だとしか",
"考えられなかった。"
]
},
{
"id": 32674,
"kind": "msg",
"jp": [
"恐る恐る受話器を手にとった。"
]
},
{
"id": 32675,
"kind": "msg",
"jp": [
"・・・",
"喉のすぐ奥まで来ていた",
"言葉を飲み込む。"
]
},
