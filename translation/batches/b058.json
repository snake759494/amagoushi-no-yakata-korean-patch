"kind": "msg",
"jp": [
"「館さえ出られたらええんか、",
"死んでも罪だけは別の人に",
"被せられたらええんか・・・」"
]
},
{
"id": 29178,
"kind": "msg",
"jp": [
"「・・・死んでも・・・?」"
]
},
{
"id": 29179,
"kind": "msg",
"jp": [
"「もしもそうやとしたら、",
"犯人はお兄さんに指摘された",
"時点で・・・」"
]
},
{
"id": 29180,
"kind": "msg",
"jp": [
"「その場は逃げおおせても、",
"かなり強引に幕を引こうと",
"すると思う」"
]
},
{
"id": 29181,
"kind": "msg",
"jp": [
"「幕を・・・って、",
"どういう・・・」"
]
},
{
"id": 29182,
"kind": "msg",
"jp": [
"「そこまでは",
"うちにもわからへん」"
]
},
{
"id": 29183,
"kind": "msg",
"jp": [
"僕が負けたらその時は、",
"今までの苦労も何もかもが",
"全部なかったことになる。"
]
},
{
"id": 29184,
"kind": "msg",
"jp": [
"そんなことになったら、",
"せっかく助かった静奈ちゃんも",
"危ないんだ・・・。"
]
},
{
"id": 29185,
"kind": "msg",
"jp": [
"「・・・{和/なご}たん」"
]
},
{
"id": 29186,
"kind": "msg",
"jp": [
"「助けて」"
]
},
{
"id": 29187,
"kind": "msg",
"jp": [
"「負けない・・・",
"・・・ように、頑張る」"
]
},
{
"id": 29188,
"kind": "msg",
"jp": [
"「君の笑顔のために絶対",
"勝ってみせるよー、とか",
"言わへんとこが素敵」"
]
},
{
"id": 29189,
"kind": "msg",
"jp": [
"「い、言えない言えない」"
]
},
{
"id": 29190,
"kind": "msg",
"jp": [
"特に前半にくっついてた",
"大昔の青春ドラマみたいな",
"台詞は絶対言えない。"
]
},
{
"id": 29191,
"kind": "msg",
"jp": [
"・・・恥ずかしすぎる。"
]
},
{
"id": 29192,
"kind": "msg",
"jp": [
"「・・・・あのね」"
]
},
{
"id": 29193,
"kind": "msg",
"jp": [
"「頑張って」"
]
},
{
"id": 29194,
"kind": "msg",
"jp": [
"「うちの推理は、",
"途中でハズレたから」"
]
},
{
"id": 29195,
"kind": "msg",
"jp": [
"「推理・・・?」"
]
},
{
"id": 29196,
"kind": "msg",
"jp": [
"「考え直そうとしたけど",
"間に合わへん」"
]
},
{
"id": 29197,
"kind": "msg",
"jp": [
"「だからもう、",
"お兄さんしかおらん」"
]
},
{
"id": 29198,
"kind": "msg",
"jp": [
"「・・・が、頑張ってみる」"
]
},
{
"id": 29199,
"kind": "msg",
"jp": [
"「大丈夫?」"
]
},
{
"id": 29200,
"kind": "msg",
"jp": [
"「頑張れそう?」"
]
},
{
"id": 29201,
"kind": "msg",
"jp": [
"「う、うん、頑張る」"
]
},
{
"id": 29202,
"kind": "msg",
"jp": [
"・・・心配されてる、",
"ような気がする・・・。"
]
},
{
"id": 29203,
"kind": "msg",
"jp": [
"「・・・うちね」"
]
},
{
"id": 29204,
"kind": "msg",
"jp": [
"「人、励ますのん下手なん」"
]
},
{
"id": 29205,
"kind": "msg",
"jp": [
"「・・・頑張れって、",
"言い過ぎたらあかんて聞くし」"
]
},
{
"id": 29206,
"kind": "msg",
"jp": [
"「あ、あの、静奈ちゃん、",
"心配してくれてるっていうのは",
"わかるよ・・・?」"
]
},
{
"id": 29207,
"kind": "msg",
"jp": [
"「頑張ってくれる?」"
]
},
{
"id": 29208,
"kind": "msg",
"jp": [
"「うん、頑張るから」"
]
},
{
"id": 29209,
"kind": "msg",
"jp": [
"あ、笑った・・・。"
]
},
{
"id": 29210,
"kind": "msg",
"jp": [
"「・・・思いつかんの」"
]
},
{
"id": 29211,
"kind": "msg",
"jp": [
"「へ? 何を?」"
]
},
{
"id": 29212,
"kind": "msg",
"jp": [
"「励ます方法」"
]
},
{
"id": 29213,
"kind": "msg",
"jp": [
"もしかして、あれからずっと",
"考えてたのか・・・。"
]
},
{
"id": 29214,
"kind": "msg",
"jp": [
"「歌おうかとも",
"思たんやけど」"
]
},
{
"id": 29215,
"kind": "msg",
"jp": [
"「う、歌?」"
]
},
{
"id": 29216,
"kind": "msg",
"jp": [
"「うちの十八番は",
"やめとけって鈴が」"
]
},
{
"id": 29217,
"kind": "msg",
"jp": [
"「・・・十八番って",
"ちなみに何なの?」"
]
},
{
"id": 29218,
"kind": "msg",
"jp": [
"「ドナドナ」"
]
},
{
"id": 29219,
"kind": "msg",
"jp": [
"「どこが応援歌やねんて言われた」"
]
},
{
"id": 29220,
"kind": "msg",
"jp": [
"「う、うん、まあ、",
"明るい歌じゃないしね・・・」"
]
},
{
"id": 29221,
"kind": "msg",
"jp": [
"それ以前の問題のような",
"気がするけど・・・。",
"追求はしないでおこう。"
]
},
{
"id": 29222,
"kind": "msg",
"jp": [
"「そんなわけで",
"歌はやめとく」"
]
},
{
"id": 29223,
"kind": "msg",
"jp": [
"「・・・あの、本当に",
"気持ちだけでいいよ?」"
]
},
{
"id": 29224,
"kind": "msg",
"jp": [
"「・・・頑張れる?」"
]
},
{
"id": 29225,
"kind": "msg",
"jp": [
"「うん、頑張れる」"
]
},
{
"id": 29226,
"kind": "msg",
"jp": [
"「・・・・じゃあ」"
]
},
{
"id": 29227,
"kind": "msg",
"jp": [
"「信じる」"
]
},
{
"id": 29228,
"kind": "msg",
"jp": [
"鈴奈ちゃんの部屋の前だ。"
]
},
{
"id": 29229,
"kind": "msg",
"jp": [
"「部屋にいるかな?」"
]
},
{
"id": 29230,
"kind": "msg",
"jp": [
"「鈴奈ちゃん?",
"あの、和ですけど」"
]
},
{
"id": 29231,
"kind": "msg",
"jp": [
"「あっ、お兄さん?」"
]
},
{
"id": 29232,
"kind": "msg",
"jp": [
"「ええとこに来てくれたわ!",
"ねえ、ちょっと見てよ」"
]
},
{
"id": 29233,
"kind": "msg",
"jp": [
"「へ? な、なに・・・え?」"
]
},
{
"id": 29234,
"kind": "msg",
"jp": [
"鈴奈ちゃんは僕の腕を掴むと、",
"部屋の中へずんずん引っ張っていく。"
]
},
{
"id": 29235,
"kind": "msg",
"jp": [
"「あの、鈴奈ちゃん?」"
]
},
{
"id": 29236,
"kind": "msg",
"jp": [
"「なにをおろおろしてんのよ。",
"部屋と違うの、ベランダ」"
]
},
{
"id": 29237,
"kind": "msg",
"jp": [
"「そう、そこに戸があるでしょ」"
]
},
{
"id": 29238,
"kind": "msg",
"jp": [
"「戸って・・・」"
]
},
{
"id": 29239,
"kind": "msg",
"jp": [
"「どこ見てんのよ!",
"天井に向かって戸がついてる",
"わけないでしょーが?」"
]
},
{
"id": 29240,
"kind": "msg",
"jp": [
"「いてぇっ!?」"
]
},
{
"id": 29241,
"kind": "msg",
"jp": [
"後頭部を掴んで、ぐい、と",
"無理矢理右を向かされた。"
]
},
{
"id": 29242,
"kind": "msg",
"jp": [
"「そこよ、そこ。",
"お姉ちゃんの部屋の方」"
]
},
{
"id": 29243,
"kind": "msg",
"jp": [
"「あ、ああ、これ?」"
]
},
{
"id": 29244,
"kind": "msg",
"jp": [
"静奈ちゃんの部屋のベランダとの",
"間を仕切る戸のことらしかった。"
]
},
{
"id": 29245,
"kind": "msg",
"jp": [
"「それ、開かへんのよ。",
"なんとかならへん?」"
]
},
{
"id": 29246,
"kind": "msg",
"jp": [
"「開かないの?",
"なんでだろう・・・」"
]
},
{
"id": 29247,
"kind": "msg",
"jp": [
"変な音がした首を撫でながら",
"ベランダに出てみる。"
]
},
{
"id": 29248,
"kind": "msg",
"jp": [
"外は相変わらずの雨なので、",
"ベランダにもずいぶん吹き込んでいる。",
"片手で顔にひさしを作って戸を調べた。"
]
},
{
"id": 29249,
"kind": "msg",
"jp": [
"「ああ、これ・・・",
"蝶番が錆びちゃってるんだ」"
]
},
{
"id": 29250,
"kind": "msg",
"jp": [
"「えぇ～?」"
]
},
{
"id": 29251,
"kind": "msg",
"jp": [
"露骨に不満そうな声を出して、",
"鈴奈ちゃんは僕の指差した所を",
"のぞき込む。"
]
},
{
"id": 29252,
"kind": "msg",
"jp": [
"戸には鍵らしきものはなかったが",
"蝶番には無惨に錆が浮いていて",
"びくとも動かなかった。"
]
},
{
"id": 29253,
"kind": "msg",
"jp": [
"「うわ、ホンマやぁ。",
"どうしようもないのん、これ」"
]
},
{
"id": 29254,
"kind": "msg",
"jp": [
"「無理に開けようとすると、",
"戸の方にひびが入ったりしそうだよ」"
]
},
{
"id": 29255,
"kind": "msg",
"jp": [
"「なんやぁ、こっから出入り出来たら",
"いちいち部屋の扉鍵開けたり閉めたり",
"せんで楽やったのにぃ・・・」"
]
},
{
"id": 29256,
"kind": "msg",
"jp": [
"「部屋からベランダに出る戸にも",
"鍵ついてないの?」"
]
},
{
"id": 29257,
"kind": "msg",
"jp": [
"「ついてへんみたい。",
"探したけどなかったわ」"
]
},
{
"id": 29258,
"kind": "msg",
"jp": [
"「ふうん、ちょっと物騒な",
"気もするけど・・・」"
]
},
{
"id": 29259,
"kind": "msg",
"jp": [
"「まぁ、普段やったらこんな山奥やし",
"泥棒もわざわざ来ぇへんのやろけどね。",
"下から登れそうな足場もないし・・」"
]
},
{
"id": 29260,
"kind": "msg",
"jp": [
"鈴奈ちゃんはぶつぶつ言いながら",
"部屋の中に戻って行く。"
]
},
{
"id": 29261,
"kind": "msg",
"jp": [
"「あ、もぉええよ。",
"ありがとう、お兄さんも入って・・」"
]
},
{
"id": 29262,
"kind": "msg",
"jp": [
"「あっと、ちょお待って。",
"タオル貸すから拭いて」"
]
},
{
"id": 29263,
"kind": "msg",
"jp": [
"「そんまま入ったらうちの部屋が",
"濡れるやないの」"
]
},
{
"id": 29264,
"kind": "msg",
"jp": [
"真顔で言ってからそっぽを向いて",
"タオルを探しに行く。"
]
},
{
"id": 29265,
"kind": "msg",
"jp": [
"照れくさいのか、本気で言ってるのか",
"微妙なところだなあ・・・。"
]
},
{
"id": 29266,
"kind": "msg",
"jp": [
"「はい、どうぞ」"
]
},
{
"id": 29267,
"kind": "msg",
"jp": [
"「ありがとう、借りるね」"
]
},
{
"id": 29268,
"kind": "msg",
"jp": [
"そっけなく投げ渡されたタオルで",
"髪と身体を拭いて、鈴奈ちゃんの",
"部屋の中に戻る。"
]
},
{
"id": 29269,
"kind": "msg",
"jp": [
"「・・・ああ、そや。",
"お兄さん何の用やったん?」"
]
},
{
"id": 29270,
"kind": "msg",
"jp": [
"「あ、えっとね・・・」"
]
},
{
"id": 29271,
"kind": "msg",
"jp": [
"「はいー?」"
]
},
{
"id": 29272,
"kind": "msg",
"jp": [
"「和ですけどー」"
]
},
{
"id": 29273,
"kind": "msg",
"jp": [
"「あ、お兄さん?",
"ちょぉ待ってすぐ開けるわ」"
]
},
{
"id": 29274,
"kind": "msg",
"jp": [
"「いらっしゃーい」"
]
},
{
"id": 29275,
"kind": "msg",
"jp": [
"「何? 何かお話?」"
]
},
{
"id": 29276,
"kind": "msg",
"jp": [
"「うん、あのね・・・」"
]
},
{
"id": 29277,
"kind": "msg",
"jp": [
"「えっと、和です」"
]
},
{
"id": 29278,
"kind": "msg",
"jp": [
"「ああ・・・ちょお待って」"
]
},
{
"id": 29279,
"kind": "msg",
"jp": [
"「どうぞ」"
]
},
{
"id": 29280,
"kind": "msg",
"jp": [
"「え、入っていいの?」"
]
},
{
"id": 29281,
"kind": "msg",
"jp": [
"「・・・お姉ちゃん助けてくれたし」"
]
},
{
"id": 29282,
"kind": "msg",
"jp": [
"そうか、ちょっと信用して",
"もらえるようになったんだ。"
]
},
{
"id": 29283,
"kind": "msg",
"jp": [
"「ありがとう、",
"鈴奈ちゃん」"
]
},
{
"id": 29284,
"kind": "msg",
"jp": [
"「な、なにがやねんな?",
"うちは、姉の恩人に礼も言えん",
"恩知らずやないだけです!」"
]
},
{
"id": 29285,
"kind": "msg",
"jp": [
"思いっきり顔が赤い。",
"相当照れくさいみたいだ。"
]
},
{
"id": 29286,
"kind": "msg",
"jp": [
"「ちょっと!",
"何笑とんのっ!?」"
]
},
{
"id": 29287,
"kind": "msg",
"jp": [
"「えっ?",
"笑ってないよ?」"
]
},
{
"id": 29288,
"kind": "msg",
"jp": [
"「嘘や、目が笑とったやん!」"
]
},
{
"id": 29289,
"kind": "msg",
"jp": [
"「笑ってないよ、本当に」"
]
},
{
"id": 29290,
"kind": "msg",
"jp": [
"「いーや、笑っとった!」"
]
},
{
"id": 29291,
"kind": "msg",
"jp": [
"「笑ってないってば!」"
]
},
{
"id": 29292,
"kind": "msg",
"jp": [
"「強情やな、アンタも!」"
]
},
{
"id": 29293,
"kind": "msg",
"jp": [
"「鈴奈ちゃんこそ・・・」"
]
},
{
"id": 29294,
"kind": "msg",
"jp": [
"「・・・まあ、ええけど。",
"アンタが頑固にお姉ちゃんが狙われる",
"言うてたから無事やったんやし・・・」"
]
},
{
"id": 29295,
"kind": "msg",
"jp": [
"「いや、頑固って」"
]
},
{
"id": 29296,
"kind": "msg",
"jp": [
"「頑固やないの。",
"うちお兄さんのこと全然信じて",
"へんかったのに」"
]
},
{
"id": 29297,
"kind": "msg",
"jp": [
"「ちょっと、落ち込まんとってよ。",
"未だに信じてへんわけちゃうってば」"
]
},
{
"id": 29298,
"kind": "msg",
"jp": [
"「今は信じてくれてるんだ?」"
]
},
{
"id": 29299,
"kind": "msg",
"jp": [
"「・・・お姉ちゃん生きてるもん」"
]
},
{
"id": 29300,
"kind": "msg",
"jp": [
"「うん。",
"・・・よかったね」"
]
},
{
"id": 29301,
"kind": "msg",
"jp": [
"「信じてなくて」"
]
},
{
"id": 29302,
"kind": "msg",
"jp": [
"「うち、ちょっと意地になってた。",
"正直言うて、第一印象あんま良ぉ",
"なかったから、それでずっと・・・」"
]
},
{
"id": 29303,
"kind": "msg",
"jp": [
"「い、いいよ、そんなの。",
"印象悪かったって言うのは",
"僕が悪かったんだろうし」"
]
},
{
"id": 29304,
"kind": "msg",
"jp": [
"「・・・お人好しやね",
"お兄さんは・・・」"
]
},
{
"id": 29305,
"kind": "msg",
"jp": [
"「そうやって!」"
]
},
{
"id": 29306,
"kind": "msg",
"jp": [
"「あーもー、",
"恥ずかしい話は終わり!」"
]
},
{
"id": 29307,
"kind": "msg",
"jp": [
"「・・・で、ええよね?",
"何か用やったんやろ?」"
]
},
{
"id": 29308,
"kind": "msg",
"jp": [
"「和です、ちょっといい?」"
]
},
{
"id": 29309,
"kind": "msg",
"jp": [
"「ああ、お兄さんか」"
]
},
{
"id": 29310,
"kind": "msg",
"jp": [
"「どないしたん?」"
]
},
{
"id": 29311,
"kind": "msg",
"jp": [
"「・・・アンタか」"
]
},
{
"id": 29312,
"kind": "msg",
"jp": [
"「・・・1人?」"
]
},
{
"id": 29313,
"kind": "msg",
"jp": [
"「で、何?」"
]
},
{
"id": 29314,
"kind": "msg",
"jp": [
"「鈴奈ちゃん? いる?」"
]
},
{
"id": 29315,
"kind": "msg",
"jp": [
"「・・・おるけど。",
"何か用なん?」"
]
},
{
"id": 29316,
"kind": "msg",
"jp": [
"「うん、ちょっとだけ",
"話聞かせてもらえる?」"
]
},
{
"id": 29317,
"kind": "msg",
"jp": [
"「ほんまにちょっとにしてや」"
]
},
{
"id": 29318,
"kind": "msg",
"jp": [
"「悪いけどちょっと",
"部屋見せてもらっていい?」"
]
},
{
"id": 29319,
"kind": "msg",
"jp": [
"「部屋? なんで?」"
]
},
{
"id": 29320,
"kind": "msg",
"jp": [
"「あ、物に触ったりしないから。",
"他の部屋とどう違うのか見たくて」"
]
},
{
"id": 29321,
"kind": "msg",
"jp": [
"「ふぅん・・・?",
"まあ、ええけど」"
]
},
{
"id": 29322,
"kind": "msg",
"jp": [
"「ごめん、部屋の中見せて",
"欲しいんだけど」"
]
},
{
"id": 29323,
"kind": "msg",
"jp": [
"「触らんかったらええよ。",
"どうぞ」"
]
},
{
"id": 29324,
"kind": "msg",
"jp": [
"「・・・嫌」"
]
},
{
"id": 29325,
"kind": "msg",
"jp": [
"（勝手に見せてもらっちゃって",
"ごめんね・・・）"
]
},
{
"id": 29326,
"kind": "msg",
"jp": [
"「あ、そうだ。",
"もう一ついい?」"
]
},
{
"id": 29327,
"kind": "msg",
"jp": [
"「ええよ、なに?」"
]
},
{
"id": 29328,
"kind": "msg",
"jp": [
"「・・・ありがとう。",
"それじゃあ」"
]
},
{
"id": 29329,
"kind": "msg",
"jp": [
"「もうええのん?」"
]
},
{
"id": 29330,
"kind": "msg",
"jp": [
"「うん、また来るかも知れないけど」"
]
},
{
"id": 29331,
"kind": "msg",
"jp": [
"「別にええよ、暇やし。",
"ほなねー」"
]
},
{
"id": 29332,
"kind": "msg",
"jp": [
"「・・・もうええかな」"
]
},
{
"id": 29333,
"kind": "msg",
"jp": [
"「ん、ほなね」"
]
},
{
"id": 29334,
"kind": "msg",
"jp": [
"「もうええでしょ。",
"そろそろ出てって」"
]
},
{
"id": 29335,
"kind": "msg",
"jp": [
"ベッドはきちんと整えられている。"
]
},
{
"id": 29336,
"kind": "msg",
"jp": [
"サイドテーブルの上にはメモ帳らしき",
"物とボールペンが置いてある。"
]
},
{
"id": 29337,
"kind": "msg",
"jp": [
"「それ、動かへんのよ。",
"電池切れてるみたい」"
]
},
{
"id": 29338,
"kind": "msg",
"jp": [
"レコードがあるが、",
"電池が切れているらしく動かない。"
]
},
{
"id": 29339,
"kind": "msg",
"jp": [
"外国の大きな橋の絵が飾られている。"
]
},
{
"id": 29340,
"kind": "msg",
"jp": [
"テーブルの上には伏せた手鏡とポーチが",
"置いてあった。"
]
},
{
"id": 29341,
"kind": "msg",
"jp": [
"「こら、触らんとってよ」"
]
},
{
"id": 29342,
"kind": "msg",
"jp": [
"ちょっと慌てたような様子で",
"鈴奈ちゃんがそれを拾い上げて",
"鞄にしまう。"
]
},
{
"id": 29343,
"kind": "msg",
"jp": [
"「あ、うん。",
"それって化粧品なの?」"
]
},
{
"id": 29344,
"kind": "msg",
"jp": [
"「んー、まあね」"
]
},
{
"id": 29345,
"kind": "msg",
"jp": [
"内線電話だ"
]
},
{
"id": 29346,
"kind": "msg",
"jp": [
"ベランダへの扉だ。",
"外の戸は錆びていて開かない。"
]
},
{
"id": 29347,
"kind": "msg",
"jp": [
"「なあ、お兄さん大丈夫なん?」"
]
},
{
"id": 29348,
"kind": "msg",
"jp": [
"「え?",
"大丈夫って何が?」"
]
},
{
"id": 29349,
"kind": "msg",
"jp": [
"「・・・なんつーか",
"緊張感ないよな、あんた」"
]
},
{
"id": 29350,
"kind": "msg",
"jp": [
"「え・・えーと・・・」"
]
},
{
"id": 29351,
"kind": "msg",
"jp": [
"「犯人や犯人!",
"さんざん邪魔してんねんから",
"危ないんとちゃうの?」"
]
},
{
"id": 29352,
"kind": "msg",
"jp": [
"「あ、そういう意味か」"
]
},
{
"id": 29353,
"kind": "msg",
"jp": [
"「・・・あんたひょっとして",
"那須さんと親子ちゃうの」"
]
},
{
"id": 29354,
"kind": "msg",
"jp": [
"「そんなわけないだろっ!?」"
]
},
{
"id": 29355,
"kind": "msg",
"jp": [
"「だって時々似てるで」"
]
},
{
"id": 29356,
"kind": "msg",
"jp": [
"「ああ、筋肉以外は」"
]
},
{
"id": 29357,
"kind": "msg",
"jp": [
"「それは言われなくても",
"わかる・・・」"
]
},
{
"id": 29358,
"kind": "msg",
"jp": [
"「へこまんといてよ、",
"うちがいじめたみたいやん」"
]
},
{
"id": 29359,
"kind": "msg",
"jp": [
"「いじめたじゃないかー!」"
]
},
{
"id": 29360,
"kind": "msg",
"jp": [
"「いじめてないわっ!",
"人聞きの悪い!」"
]
},
{
"id": 29361,
"kind": "msg",
"jp": [
"「・・・あー、もう",
"何の話やったか忘れたやん」"
]
},
{
"id": 29362,
"kind": "msg",
"jp": [
"「僕のせいなの・・・?」"
]
},
{
"id": 29363,
"kind": "msg",
"jp": [
"「まあ、ええわ。",
"思い出したらで」"
]
},
{
"id": 29364,
"kind": "msg",
"jp": [
"「・・・あ、思い出した!」"
]
},
{
"id": 29365,
"kind": "msg",
"jp": [
"「途中で何の話か",
"わからんようになったやつ」"
]
},
{
"id": 29366,
"kind": "msg",
"jp": [
"「あ、ああ、",
"なんかいじめられたような」"
]
},
{
"id": 29367,
"kind": "msg",
"jp": [
"「いじめてない言うてる",
"やないのっ!?」"
]
},
{
"id": 29368,
"kind": "msg",
"jp": [
"「・・・ヘタレ」"
]
},
{
"id": 29369,
"kind": "msg",
"jp": [
"「だって怒鳴るから・・・」"
]
},
{
"id": 29370,
"kind": "msg",
"jp": [
"「また何の話やったか",
"忘れたやんかー!」"
]
},
{
"id": 29371,
"kind": "msg",
"jp": [
"「だからそれ、",
"僕のせいなの!?」"
]
},
{
"id": 29372,
"kind": "msg",
"jp": [
"「今回のははっきり",
"お兄さんのせいやろ」"
]
},
{
"id": 29373,
"kind": "msg",
"jp": [
"「そ、そうかなぁ・・・」"
]
},
{
"id": 29374,
"kind": "msg",
"jp": [
"「・・・まあ、ええわ。",
"そのうち思い出すやろ」"
]
},
{
"id": 29375,
"kind": "msg",
"jp": [
"「・・・なぁ、",
"思い出せんのやけど」"
]
},
{
"id": 29376,
"kind": "msg",
"jp": [
"「最初、何の話しよったっけ」"
]
},
{
"id": 29377,
"kind": "msg",
"jp": [
"「なんか僕が那須さんに",
"似てるとかって言われた」"
]
},
{
"id": 29378,
"kind": "msg",
"jp": [
"「それはあんたの緊張感が",
"ない言う話の後じゃろがっ!」"
]
},
{
"id": 29379,
"kind": "msg",
"jp": [
"「いちいち謝らんでええの!」"
]
},
{
"id": 29380,
"kind": "msg",
"jp": [
"「あー、何の話",
"やったかなぁ・・・」"
]
},
{
"id": 29381,
"kind": "msg",
"jp": [
"思い出してくれるまで",
"怒られるのかな、僕。"
]
},
{
"id": 29382,
"kind": "msg",
"jp": [
"「・・・あ、そうや」"
]
},
{
"id": 29383,
"kind": "msg",
"jp": [
"「なっ、なに?」"
]
},
{
"id": 29384,
"kind": "msg",
"jp": [
"「いきなり怯えるて",
"どういうことよ」"
]
},
{
"id": 29385,
"kind": "msg",
"jp": [
"「だってまた思い出せない",
"とか言い出すんじゃないの?」"
]
},
{
"id": 29386,
"kind": "msg",
"jp": [
"「その話とちゃうって・・・」"
]
},
{
"id": 29387,
"kind": "msg",
"jp": [
"「・・・あーっ! そうや!」"
]
},
{
"id": 29388,
"kind": "msg",
"jp": [
"「思い出した、",
"お兄さん大丈夫なん?」"
]
},
{
"id": 29389,
"kind": "msg",
"jp": [
"「は? え? 僕?」"
]
},
{
"id": 29390,
"kind": "msg",
"jp": [
"「だからー、",
"お兄さんずっと犯人の",
"邪魔しよるわけやん?」"
]
},
{
"id": 29391,
"kind": "msg",
"jp": [
"「今度はお兄さんが狙われたり",
"せんのかなと思て」"
]
},
{
"id": 29392,
"kind": "msg",
"jp": [
"「あ、ああ、",
"そう言えばそうだね」"
]
},
{
"id": 29393,
"kind": "msg",
"jp": [
"「考えてなかったん!?」"
]
},
{
"id": 29394,
"kind": "msg",
"jp": [
"「え・・・",
"だって僕は高遠さんの本に",
"出て来ないし・・・」"
]
},
{
"id": 29395,
"kind": "msg",
"jp": [
"「そんなんで安心",
"してたんかいな!?」"
]
},
{
"id": 29396,
"kind": "msg",
"jp": [
"「・・・でも無事だよ」"
]
},
{
"id": 29397,
"kind": "msg",
"jp": [
"「なんかわかった」"
]
},
{
"id": 29398,
"kind": "msg",
"jp": [
"「なんで犯人は自分の邪魔する",
"お兄さん放ったらかしに",
"してんねやろと思ててんけど」"
]
},
{
"id": 29399,
"kind": "msg",
"jp": [
"「・・・{舐/な}めてたんやな」"
]
},
{
"id": 29400,
"kind": "msg",
"jp": [
"「だってお兄さん、",
"めっちゃ頼りないもん」"
]
},
{
"id": 29401,
"kind": "msg",
"jp": [
"「そ、そんなはっきり・・・」"
]
},
{
"id": 29402,
"kind": "msg",
"jp": [
"「だから無事やってんで」"
]
},
{
"id": 29403,
"kind": "msg",
"jp": [
"「どういう意味?」"
]
},
{
"id": 29404,
"kind": "msg",
"jp": [
"「犯人もまさかお兄さんが",
"こない頑張るとは思て",
"なかったんやないかな」"
]
},
{
"id": 29405,
"kind": "msg",
"jp": [
"「それで、多少邪魔されても",
"大した事ないと思て放ってたら",
"被害甚大、みたいな」"
]
},
{
"id": 29406,
"kind": "msg",
"jp": [
"「甚大、かなぁ」"
]
},
{
"id": 29407,
"kind": "msg",
"jp": [
"「当たり前やろ!",
"あんた、犯人と何賭けて",
"喧嘩してるか自覚ないんか?」"
]
},
{
"id": 29408,
"kind": "msg",
"jp": [
"「か、賭けて?」"
]
},
{
"id": 29409,
"kind": "msg",
"jp": [
"「うちらの命」"
]
},
{
"id": 29410,
"kind": "msg",
"jp": [
"「人殺そうとしてた奴に",
"殺させへんかったんやで」"
]
},
{
"id": 29411,
"kind": "msg",
"jp": [
"「これ以上強烈な",
"カウンターないやろ。",
"もっと自信持ってや」"
]
},
{
"id": 29412,
"kind": "msg",
"jp": [
"「それとも・・・",
"うちが生きてるだけじゃ",
"実感あらへん?」"
]
},
{
"id": 29413,
"kind": "msg",
"jp": [
"「う、ううん。",
"そんなことない」"
]
},
{
"id": 29414,
"kind": "msg",
"jp": [
"「朝が来て、",
"誰もいなくなってないと",
"すごくほっとするんだ」"
]
},
{
"id": 29415,
"kind": "msg",
"jp": [
"「・・・本当は",
"当たり前のことの",
"はずなのに・・・」"
]
},
{
"id": 29416,
"kind": "msg",
"jp": [
"「そやな・・・」"
]
},
{
"id": 29417,
"kind": "msg",
"jp": [
"「昨日まで普通に{居/お}った人が",
"{居/お}りんさらんのは・・・嫌やわ」"
]
},
{
"id": 29418,
"kind": "msg",
"jp": [
"「そやから、お兄さんも",
"居らんようにならんとってよ」"
]
},
{
"id": 29419,
"kind": "msg",
"jp": [
"「え? 僕は・・・」"
]
},
{
"id": 29420,
"kind": "msg",
"jp": [
"「あのね、お兄さん。",
"いくらなんでも犯人はもう",
"舐めてへんと思うで」"
]
},
{
"id": 29421,
"kind": "msg",
"jp": [
"「油断せんとってよ、",
"お願いやから」"
]
},
{
"id": 29422,
"kind": "msg",
"jp": [
"「最後の最後で",
"逆転負けなんか嫌やで」"
]
},
{
"id": 29423,
"kind": "msg",
"jp": [
"「・・・うん、わかった。",
"ありがとう鈴奈ちゃん」"
]
},
{
"id": 29424,
"kind": "msg",
"jp": [
"「ほんまに頼むからね」"
]
},
{
"id": 29425,
"kind": "msg",
"jp": [
"「こんな大事な話やのに",
"思い出せんくらい緊張感ないて",
"あり得へんわ、普通・・・」"
]
},
{
"id": 29426,
"kind": "msg",
"jp": [
"「そ、それって",
"僕のせいなの・・・?」"
]
},
{
"id": 29427,
"kind": "msg",
"jp": [
"「だって現に忘れて・・・」"
]
},
{
"id": 29428,
"kind": "msg",
"jp": [
"「・・・ちょお待って。",
"うちさっき、何か違う話",
"しようとしてへんかった?」"
]
},
{
"id": 29429,
"kind": "msg",
"jp": [
"「・・・ま、ええか」"
]
},
{
"id": 29430,
"kind": "msg",
"jp": [
"「いいの?」"
]
},
{
"id": 29431,
"kind": "msg",
"jp": [
"「大事な方は思い出したから」"
]
},
{
"id": 29432,
"kind": "msg",
"jp": [
"「今忘れたんは、",
"またいつか思い出したら話すわ」"
]
},
{
"id": 29433,
"kind": "msg",
"jp": [
"「・・・うん。",
"じゃあ、楽しみにしてる」"
]
},
{
"id": 29434,
"kind": "msg",
"jp": [
"「・・・けどなぁ、",
"ものごっつうしょうもない事",
"やったような気がするんよ」"
]
},
{
"id": 29435,
"kind": "msg",
"jp": [
"「台無しじゃないかっ!?」"
]
},
{
"id": 29436,
"kind": "msg",
"jp": [
"「なにが」"
]
},
{
"id": 29437,
"kind": "msg",
"jp": [
"「なんかこう、",
"しんみりした雰囲気とか",
"どっか行っちゃったよ!?」"
]
},
{
"id": 29438,
"kind": "msg",
"jp": [
"「・・・そんなもん",
"恥ずかしいからいらん」"
]
},
{
"id": 29439,
"kind": "msg",
"jp": [
"照れ隠しだったのかなぁ。",
"聞いたら怒られそうだけど。"
]
},
{
"id": 29440,
"kind": "msg",
"jp": [
"「・・・あのさぁ」"
]
},
{
"id": 29441,
"kind": "msg",
"jp": [
"「お兄さんて我慢強い方?」"
]
},
{
"id": 29442,
"kind": "msg",
"jp": [
"「ううん、全然」"
]
},
{
"id": 29443,
"kind": "msg",
"jp": [
"「即答かいな」"
]
},
{
"id": 29444,
"kind": "msg",
"jp": [
"「だって怖いとすぐ逃げるし",
"全然我慢強くないよ?」"
]
},
{
"id": 29445,
"kind": "msg",
"jp": [
"「お兄さんそれ",
"心底本気で言うてる?」"
]
},
{
"id": 29446,
"kind": "msg",
"jp": [
"「自覚ないんや・・・」"
]
},
{
"id": 29447,
"kind": "msg",
"jp": [
"「ああ、ええねん。",
"独り言やから気にせんとって」"
]
},
{
"id": 29448,
"kind": "msg",
"jp": [
"「あのさ、お兄さん」"
]
},
{
"id": 29449,
"kind": "msg",
"jp": [
"「執着心て強い方?」"
]
},
{
"id": 29450,
"kind": "msg",
"jp": [
"「あの、我慢強いとか",
"執着心とか質問の意味が",
"よくわかんないんだけど・・・」"
]
},
{
"id": 29451,
"kind": "msg",
"jp": [
"「意味は気にせんでええねん」"
]
},
{
"id": 29452,
"kind": "msg",
"jp": [
"「ほんまにヘタレやなぁ。",
"年下ににらまれただけで",
"なんで萎縮するんな」"
]
},
{
"id": 29453,
"kind": "msg",
"jp": [
"「だって・・・",
"鈴奈ちゃんの声怖かった・・・」"
]
},
{
"id": 29454,
"kind": "msg",
"jp": [
"「どこまで気ぃ弱いねんっ!」"
]
},
{
"id": 29455,
"kind": "msg",
"jp": [
"「・・・こんなヘタレが・・・」"
]
},
{
"id": 29456,
"kind": "msg",
"jp": [
"「あーあー、",
"独り言独り言」"
]
},
{
"id": 29457,
"kind": "msg",
"jp": [
"・・・なんなんだろう?"
]
},
{
"id": 29458,
"kind": "msg",
"jp": [
"「・・・なあ、お兄さん」"
]
},
{
"id": 29459,
"kind": "msg",
"jp": [
"「なんでいきなり",
"びびっとるんな」"
]
},
{
"id": 29460,
"kind": "msg",
"jp": [
"「だってなんかまた",
"変なこと聞くんじゃないの?」"
]
},
{
"id": 29461,
"kind": "msg",
"jp": [
"「変なことって何よ。",
"まだ頑張っとんのかなーと",
"思ただけやん」"
]
},
{
"id": 29462,
"kind": "msg",
"jp": [
"「まだって?」"
]
},
{
"id": 29463,
"kind": "msg",
"jp": [
"「犯人の邪魔してやろう作戦」"
]
},
{
"id": 29464,
"kind": "msg",
"jp": [
"「さ、作戦ってほどのものじゃ",
"ないけど、まあ・・・」"
]
},
{
"id": 29465,
"kind": "msg",
"jp": [
"「・・・・別に」"
]
},
{
"id": 29466,
"kind": "msg",
"jp": [
"「・・・ちょっと",
"見直しても・・・」"
]
},
{
"id": 29467,
"kind": "msg",
"jp": [
"「あー、なんでもない!",
"独り言独り言独り言っ!」"
]
},
{
"id": 29468,
"kind": "msg",
"jp": [
"「? う、うん」"
]
},
{
"id": 29469,
"kind": "msg",
"jp": [
"ここは食堂だ"
]
},
{
"id": 29470,
"kind": "msg",
"jp": [
"大きなテーブルがある。"
]
},
{
"id": 29471,
"kind": "msg",
"jp": [
"古そうな椅子が並んでいる。"
]
},
{
"id": 29472,
"kind": "msg",
"jp": [
"なんだあれ・・・?",
"何か椅子の上に乗ってる・・・。"
]
},
{
"id": 29473,
"kind": "msg",
"jp": [
"変な並べ方をされた椅子の上に",
"何かが乗っかっているような。"
]
},
{
"id": 29474,
"kind": "msg",
"jp": [
"何気なく近づいてみる・・・"
]
},
{
"id": 29475,
"kind": "msg",
"jp": [
"「ま・・・斑井さ・・・ん?」"
]
},
{
"id": 29476,
"kind": "msg",
"jp": [
"かっと見開いた目が、",
"こっちを見ている。"
]
},
{
"id": 29477,
"kind": "msg",
"jp": [
"この顔は、間違いなく斑井さん、",
"だけど・・・けど・・・"
]
},
{
"id": 29478,
"kind": "msg",
"jp": [
"妙に存在感のある怖い顔の",
"彫刻が飾られている・・・。"
]
},
{
"id": 29479,
"kind": "msg",
"jp": [
"裏庭の見える広々とした窓だ。"
]
},
{
"id": 29480,
"kind": "msg",
"jp": [
"（これって、配膳用のテーブル",
"なのかな・・・?）"
]
},
{
"id": 29481,
"kind": "msg",
"jp": [
"配膳用のテーブルのようだ。"
]
},
{
"id": 29482,
"kind": "msg",
"jp": [
"（このカウンターみたい",
"なのは・・・ああ、バーなのか）"
]
},
{
"id": 29483,
"kind": "msg",
"jp": [
"洋酒がたくさん並んでいた。"
]
},
{
"id": 29484,
"kind": "msg",
"jp": [
"カウンターバーがある。"
]
},
{
"id": 29485,
"kind": "msg",
"jp": [
"台所へ通じている扉だ。"
]
},
{
"id": 29486,
"kind": "msg",
"jp": [
"燭台が置いてある。"
]
},
{
"id": 29487,
"kind": "msg",
"jp": [
"この椅子には頭部が固定されている。"
]
},
{
"id": 29488,
"kind": "msg",
"jp": [
"こちらの椅子には両脚がくくられていた。"
]
},
{
"id": 29489,
"kind": "msg",
"jp": [
"首に縄が食い込んでいる。",
"椅子に縛りつけてあるようだ。"
]
},
{
"id": 29490,
"kind": "msg",
"jp": [
"両脚と椅子を縛りつけている縄だ。"
]
},
{
"id": 29491,
"kind": "msg",
"jp": [
"胸元に血の染みが広がっている。",
"かなり出血したようだ・・・。"
]
},
{
"id": 29492,
"kind": "msg",
"jp": [
"床の上には血などで",
"汚れた部分は見あたらない。"
]
},
{
"id": 29493,
"kind": "msg",
"jp": [
"カッと目を見開いて、斜め上を",
"見上げている。"
]
},
{
"id": 29494,
"kind": "msg",
"jp": [
"あまり見てると目があってしまって",
"怖い・・・。"
]
},
{
"id": 29495,
"kind": "msg",
"jp": [
"両腕も縄で身体に縛り付けてある。",
"椅子から落ちないようにかな・・・。"
]
},
{
"id": 29496,
"kind": "msg",
"jp": [
"「さ、どうぞ」"
]
},
{
"id": 29497,
"kind": "msg",
"jp": [
"「へえ・・・",
"でっかい本棚・・・」"
]
},
{
"id": 29498,
"kind": "msg",
"jp": [
"くるりと室内を見回してみる。"
]
},
{
"id": 29499,
"kind": "msg",
"jp": [
"並んでいる本棚には、文庫本から",
"雑誌までさまざまな本が並べて",
"あるようだった。"
]
},
{
"id": 29500,
"kind": "msg",
"jp": [
"「ええと、見取り図はどこだったかな。",
"ちょいとその辺見てて下さいや」"
]
},
{
"id": 29501,
"kind": "msg",
"jp": [
"「おかしいな、",
"見取り図どこいっちまったんだか」"
]
},
{
"id": 29502,
"kind": "msg",
"jp": [
"「見当たらないの?」"
]
},
{
"id": 29503,
"kind": "msg",
"jp": [
"「机の上に置いてあった",
"はずなんですがね・・・」"
]
},
{
"id": 29504,
"kind": "msg",
"jp": [
"「探しますから、",
"適当に本でも読んで待ってて",
"もらえますかい」"
]
},
{
"id": 29505,
"kind": "msg",
"jp": [
"奥の棚にある洋書は英語では",
"なさそうだから、読めないな。"
]
},
{
"id": 29506,
"kind": "msg",
"jp": [
"日本語の本がある本棚を調べて",
"みることにしよう。"
]
},
{
"id": 29507,
"kind": "msg",
"jp": [
"「・・・確か、ここにいるみんなの",
"名前ってこの高遠って人の話に出てくる",
"登場人物の名前なんだよね?」"
]
},
{
"id": 29508,
"kind": "msg",
"jp": [
"「・・・猫は・・・」"
]
},
{
"id": 29509,
"kind": "msg",
"jp": [
"「あ、あの、",
"夕べ、静奈ちゃんが言ってた",
"本ってなんてタイトルだっけ」"
]
},
{
"id": 29510,
"kind": "msg",
"jp": [
"「『黒猫の毒』ですかい?」"
]
},
{
"id": 29511,
"kind": "msg",
"jp": [
"「そう、それ。",
"ここにある?」"
]
},
{
"id": 29512,
"kind": "msg",
"jp": [
"「ありますぜ。",
"そこの茶色い本棚に文庫が",
"並んでます」"
]
},
{
"id": 29513,
"kind": "msg",
"jp": [
"「ああ、これだね」"
]
},
{
"id": 29514,
"kind": "msg",
"jp": [
"（・・・ああ、また。",
"思い出さないように",
"してたのに・・・）"
]
},
{
"id": 29515,
"kind": "msg",
"jp": [
"あの一言がなぜか",
"頭にこびりついてる。"
]
},
{
"id": 29516,
"kind": "msg",
"jp": [
"なんでこんなに気になるのか",
"わからないからよけいに怖いし。"
]
},
{
"id": 29517,
"kind": "msg",
"jp": [
"「・・・ちょっと見てみようかな」"
]
},
{
"id": 29518,
"kind": "msg",
"jp": [
"「そうしてて下さいな。",
"俺は見取り図探しますんで」"
]
},
{
"id": 29519,
"kind": "msg",
"jp": [
"「関係ありそうなのって、",
"この茶色い本棚だけ?」"
]
},
{
"id": 29520,
"kind": "msg",
"jp": [
"「高遠作品はほとんどそこに",
"固まってるみてえですね」"
]
},
{
"id": 29521,
"kind": "msg",
"jp": [
"「確かその中に著作リストが",
"あったんじゃねえかな。",
"著作解説とかいうタイトルの」"
]
},
{
"id": 29522,
"kind": "msg",
"jp": [
"「著作リストね・・・」"
]
},
{
"id": 29523,
"kind": "msg",
"jp": [
"「あのさ・・・」"
]
},
{
"id": 29524,
"kind": "msg",
"jp": [
"「本の内容って、その・・・",
"やっぱり・・・怖い?」"
]
},
{
"id": 29525,
"kind": "msg",
"jp": [
"「えーと・・・",
"まあ、苦手な人は苦手なんじゃ",
"ねえかとは思いますが・・・」"
]
},
{
"id": 29526,
"kind": "msg",
"jp": [
"「そ、そっか・・・",
"でも、頑張ってみ・・・」"
]
},
{
"id": 29527,
"kind": "msg",
"jp": [
"「あー、あったあった」"
]
},
{
"id": 29528,
"kind": "msg",
"jp": [
"「え?",
"見取り図見つかったの?」"
]
}
]