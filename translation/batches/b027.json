[
{
"id": 14062,
"kind": "msg",
"jp": [
"「そうらしいですわ。",
"私もよく知らなかったもの",
"ですから・・・」"
]
},
{
"id": 14063,
"kind": "msg",
"jp": [
"「原作がお好きな方と話していて",
"なんだか話がかみ合わないのがなぜか",
"途中まで気が付かなくて・・・」"
]
},
{
"id": 14064,
"kind": "msg",
"jp": [
"・・・僕も似たような事",
"やってしまいそうな気がする。"
]
},
{
"id": 14065,
"kind": "msg",
"jp": [
"「本物の執事さんって",
"会った事あります?」"
]
},
{
"id": 14066,
"kind": "msg",
"jp": [
"「ええ、親戚の家に",
"おられますから」"
]
},
{
"id": 14067,
"kind": "msg",
"jp": [
"「でも、もうご高齢で",
"後を継がれる方がおられなくて",
"お困りらしいのですわ」"
]
},
{
"id": 14068,
"kind": "msg",
"jp": [
"「代々世襲制だったそうなの",
"ですけれど、お子さんは娘さん",
"ばかりでもう嫁がれたとか」"
]
},
{
"id": 14069,
"kind": "msg",
"jp": [
"なんか別世界の話を聞いてる",
"みたいだ・・・。"
]
},
{
"id": 14070,
"kind": "msg",
"jp": [
"「御陵さんってご兄弟は",
"いらっしゃるんですか?」"
]
},
{
"id": 14071,
"kind": "msg",
"jp": [
"「いいえ、私は一人娘ですの」"
]
},
{
"id": 14072,
"kind": "msg",
"jp": [
"「でも、親戚が多かったので",
"子どもの頃はよく従兄弟に",
"遊んでもらいましたわ」"
]
},
{
"id": 14073,
"kind": "msg",
"jp": [
"「ああ、うちも親戚は",
"やたら多いです」"
]
},
{
"id": 14074,
"kind": "msg",
"jp": [
"「なんか親同士が仲良くて",
"しょっちゅう集まるんで」"
]
},
{
"id": 14075,
"kind": "msg",
"jp": [
"「あら、楽しそうで",
"いいじゃありませんの」"
]
},
{
"id": 14076,
"kind": "msg",
"jp": [
"「私は、もうずいぶん",
"従兄弟にも会ってませんわ。",
"どうしているかしら・・・」"
]
},
{
"id": 14077,
"kind": "msg",
"jp": [
"御陵さんは少し寂しそうに",
"目を伏せた。"
]
},
{
"id": 14078,
"kind": "msg",
"jp": [
"「・・・ええ、でも・・・",
"まだ当分かかるのでしょう?」"
]
},
{
"id": 14079,
"kind": "msg",
"jp": [
"「そうみたいです・・・」"
]
},
{
"id": 14080,
"kind": "msg",
"jp": [
"「いえ、私はさっぱり。",
"みなさんの声で起きるまではまったく",
"気がつきませんでしたわ」"
]
},
{
"id": 14081,
"kind": "msg",
"jp": [
"「ええ、まあ・・・",
"どんな服装かにもよりますけれど」"
]
},
{
"id": 14082,
"kind": "msg",
"jp": [
"「た、たとえば女装とか」"
]
},
{
"id": 14083,
"kind": "msg",
"jp": [
"「・・・あの、一柳さんは",
"その・・・お似合いかとは思います",
"けれど・・・なぜ今・・・」"
]
},
{
"id": 14084,
"kind": "msg",
"jp": [
"「あああ、あの、僕がやりたい",
"わけじゃなくてですね!?」"
]
},
{
"id": 14085,
"kind": "msg",
"jp": [
"「あ、あら? 違いまして?」"
]
},
{
"id": 14086,
"kind": "msg",
"jp": [
"「違いますっ!",
"ただのたとえ話ですっ!!」"
]
},
{
"id": 14087,
"kind": "msg",
"jp": [
"「そうですの・・・",
"いえ、お似合いだとは思うんですが",
"なぜ私に聞くのかしらと・・・」"
]
},
{
"id": 14088,
"kind": "msg",
"jp": [
"「似合わなくていいです・・・」"
]
},
{
"id": 14089,
"kind": "msg",
"jp": [
"変なこと聞くんじゃなかった。"
]
},
{
"id": 14090,
"kind": "msg",
"jp": [
"「御陵さん、",
"この文章読めますか?」"
]
},
{
"id": 14091,
"kind": "msg",
"jp": [
"「・・・いえ、",
"わかりませんけれど・・・?」"
]
},
{
"id": 14092,
"kind": "msg",
"jp": [
"「そうでしたわね。",
"招待状に書かれてましたわ」"
]
},
{
"id": 14093,
"kind": "msg",
"jp": [
"最初っからあの調子だったのか、",
"あの2人・・・。"
]
},
{
"id": 14094,
"kind": "msg",
"jp": [
"「那須さんが見たっていう",
"土砂崩れのこっち側に",
"あったっていうあれですけど」"
]
},
{
"id": 14095,
"kind": "msg",
"jp": [
"「あ・・・",
"ああ、あれは・・・」"
]
},
{
"id": 14096,
"kind": "msg",
"jp": [
"「私・・・私には・・・",
"恐ろしくて何も考えられません」"
]
},
{
"id": 14097,
"kind": "msg",
"jp": [
"「いえ、お仕事でご一緒する以外は",
"特に詳しいと言うほどのことは・・・」"
]
},
{
"id": 14098,
"kind": "msg",
"jp": [
"「さあ・・・",
"私も斑井さんの所属事務所だと",
"いうことくらいしか・・・」"
]
},
{
"id": 14099,
"kind": "msg",
"jp": [
"「ごく普通の事務所ですわよ。",
"どちらかというと",
"歌手の方が多いという程度で」"
]
},
{
"id": 14100,
"kind": "msg",
"jp": [
"御陵さんみたいな女優さんは",
"少ないのかな。"
]
},
{
"id": 14101,
"kind": "msg",
"jp": [
"「仮面・・・?",
"いえ、存じませんわ」"
]
},
{
"id": 14102,
"kind": "msg",
"jp": [
"やっぱり、そんな有名な団体じゃ",
"ないんだろうな・・・。"
]
},
{
"id": 14103,
"kind": "msg",
"jp": [
"「・・・どこかで聞いたような",
"気はするんですけれど・・・」"
]
},
{
"id": 14104,
"kind": "msg",
"jp": [
"「ごめんなさい、",
"よく知らないと思いますわ」"
]
},
{
"id": 14105,
"kind": "msg",
"jp": [
"まあ、御陵さんが好んで買う",
"商品はなさそうな会社だもんな。"
]
},
{
"id": 14106,
"kind": "msg",
"jp": [
"「よくわかりませんわ、",
"続きを読まないことには」"
]
},
{
"id": 14107,
"kind": "msg",
"jp": [
"「やっぱりそうですか・・・」"
]
},
{
"id": 14108,
"kind": "msg",
"jp": [
"でも、暗石さんの話とも",
"ほとんど一致してるよな・・・。"
]
},
{
"id": 14109,
"kind": "msg",
"jp": [
"「ええ、名作ですわ」"
]
},
{
"id": 14110,
"kind": "msg",
"jp": [
"「私、大好きでしたもの」"
]
},
{
"id": 14111,
"kind": "msg",
"jp": [
"「へえ・・・",
"斑井さんも出てたんですよね」"
]
},
{
"id": 14112,
"kind": "msg",
"jp": [
"「え、あ・・・",
"そうですわ、ええ」"
]
},
{
"id": 14113,
"kind": "msg",
"jp": [
"・・・なんで目を逸らすんだろう。"
]
},
{
"id": 14114,
"kind": "msg",
"jp": [
"「いえ・・・",
"見たことありません」"
]
},
{
"id": 14115,
"kind": "msg",
"jp": [
"「いえ・・・",
"存じませんわ」"
]
},
{
"id": 14116,
"kind": "msg",
"jp": [
"「いえ、存じませんわ」"
]
},
{
"id": 14117,
"kind": "msg",
"jp": [
"「ええ・・・",
"でも、よく覚えてませんわ」"
]
},
{
"id": 14118,
"kind": "msg",
"jp": [
"「え? ええ・・・",
"そうみたいですわね」"
]
},
{
"id": 14119,
"kind": "msg",
"jp": [
"（なんか、うわの空だな・・・。",
"あまり興味ない話だったかな）"
]
},
{
"id": 14120,
"kind": "msg",
"jp": [
"「まさか、ありませんわ」"
]
},
{
"id": 14121,
"kind": "msg",
"jp": [
"「私はありませんわ」"
]
},
{
"id": 14122,
"kind": "msg",
"jp": [
"「そ、そんなところ・・・",
"近寄りもしませんわ」"
]
},
{
"id": 14123,
"kind": "msg",
"jp": [
"「ええ、ありますわね。",
"この雨ですからあまり意味は",
"ありませんけど」"
]
},
{
"id": 14124,
"kind": "msg",
"jp": [
"「・・・ええ。",
"でも、この雨じゃあ・・・」"
]
},
{
"id": 14125,
"kind": "msg",
"jp": [
"「ええ、お昼のうちに。",
"でも、その時は何も変な物は",
"ありませんでしたけど」"
]
},
{
"id": 14126,
"kind": "msg",
"jp": [
"「・・・ええ、まあ。",
"広くて使いやすいですわ」"
]
},
{
"id": 14127,
"kind": "msg",
"jp": [
"なんとなく、それがどうしたんだと",
"言いたげな不審な顔をされた・・・。"
]
},
{
"id": 14128,
"kind": "msg",
"jp": [
"「・・・ええ。",
"最初の日に一度だけ」"
]
},
{
"id": 14129,
"kind": "msg",
"jp": [
"「ええ・・・",
"あまり好きじゃないので",
"よく見てませんけれど・・・」"
]
},
{
"id": 14130,
"kind": "msg",
"jp": [
"「私、最初の日に一度のぞいた",
"きりでよく見てないんです」"
]
},
{
"id": 14131,
"kind": "msg",
"jp": [
"「まあ、そうですの。",
"存じませんでした」"
]
},
{
"id": 14132,
"kind": "msg",
"jp": [
"「ええ、そのようですわ」"
]
},
{
"id": 14133,
"kind": "msg",
"jp": [
"（・・・なんかそっけないな）"
]
},
{
"id": 14134,
"kind": "msg",
"jp": [
"「2階に、開かずの間とかいう",
"部屋がありますよね」"
]
},
{
"id": 14135,
"kind": "msg",
"jp": [
"「ええと・・・",
"多分、私そのお部屋には入ったこと",
"ありませんけれど」"
]
},
{
"id": 14136,
"kind": "msg",
"jp": [
"「さあ・・・?",
"見てませんけれど」"
]
},
{
"id": 14137,
"kind": "msg",
"jp": [
"「いいえ、ございませんわ」"
]
},
{
"id": 14138,
"kind": "msg",
"jp": [
"「・・・え、あの・・・」"
]
},
{
"id": 14139,
"kind": "msg",
"jp": [
"「それはまさか、私に",
"見に行けと・・・?」"
]
},
{
"id": 14140,
"kind": "msg",
"jp": [
"「あ、いえ、違います。",
"そんなことないです」"
]
},
{
"id": 14141,
"kind": "msg",
"jp": [
"「ああ、よかった・・・。",
"そんな壊そうな所、嫌ですわ」"
]
},
{
"id": 14142,
"kind": "msg",
"jp": [
"「えーと、開けてみた事って・・・」"
]
},
{
"id": 14143,
"kind": "msg",
"jp": [
"「いえ、ありませんわ」"
]
},
{
"id": 14144,
"kind": "msg",
"jp": [
"「・・・確か、作家のお名前が",
"つけられているとか」"
]
},
{
"id": 14145,
"kind": "msg",
"jp": [
"「私はそれくらいしか",
"存じませんけれど・・・」"
]
},
{
"id": 14146,
"kind": "msg",
"jp": [
"あまり興味なさそうな口調だった。"
]
},
{
"id": 14147,
"kind": "msg",
"jp": [
"「・・・あんな・・・私、あんなもの",
"触ったこともないです・・・」"
]
},
{
"id": 14148,
"kind": "msg",
"jp": [
"「あ、そ、そうですか」"
]
},
{
"id": 14149,
"kind": "msg",
"jp": [
"「・・・私も飲みました・・・」"
]
},
{
"id": 14150,
"kind": "msg",
"jp": [
"「ええ、でも・・・",
"無事だったみたいです・・・」"
]
},
{
"id": 14151,
"kind": "msg",
"jp": [
"「わ、私、そんな・・・",
"恐ろしいこと聞かれても・・・」"
]
},
{
"id": 14152,
"kind": "msg",
"jp": [
"「あ、そ、そうですね。",
"すみません・・・」"
]
},
{
"id": 14153,
"kind": "msg",
"jp": [
"「薔薇の・・・?」"
]
},
{
"id": 14154,
"kind": "msg",
"jp": [
"「応接室にあったものみたい",
"なんですが」"
]
},
{
"id": 14155,
"kind": "msg",
"jp": [
"「・・・そう。",
"私は覚えてませんけれど・・・」"
]
},
{
"id": 14156,
"kind": "msg",
"jp": [
"「・・・恐ろしいことですわ。",
"とても・・・」"
]
},
{
"id": 14157,
"kind": "msg",
"jp": [
"「・・・やめて、お願い・・・」"
]
},
{
"id": 14158,
"kind": "msg",
"jp": [
"「え、あ、すみません・・・」"
]
},
{
"id": 14159,
"kind": "msg",
"jp": [
"「あれが、何か・・?」"
]
},
{
"id": 14160,
"kind": "msg",
"jp": [
"「昼間にはあんなの",
"なかったんですよね?」"
]
},
{
"id": 14161,
"kind": "msg",
"jp": [
"「ええ、もちろんです。",
"ありませんでした」"
]
},
{
"id": 14162,
"kind": "msg",
"jp": [
"「・・・わかりませんわ。",
"私には、誰が何のつもりであんな・・」"
]
},
{
"id": 14163,
"kind": "msg",
"jp": [
"「いいえ、私はございません」"
]
},
{
"id": 14164,
"kind": "msg",
"jp": [
"「・・・ええ、そうですわね」"
]
},
{
"id": 14165,
"kind": "msg",
"jp": [
"ぼんやりとした返事だった。",
"あまり興味はないようだ。"
]
},
{
"id": 14166,
"kind": "msg",
"jp": [
"「そうですわね。",
"素敵ですわ」"
]
},
{
"id": 14167,
"kind": "msg",
"jp": [
"・・・なんとなく、気のない口調だ。"
]
},
{
"id": 14168,
"kind": "msg",
"jp": [
"「なんなのかしら。",
"さっぱりわかりませんわ」"
]
},
{
"id": 14169,
"kind": "msg",
"jp": [
"「一体なんなんでしょう?",
"何かの儀式のつもりなのかしら」"
]
},
{
"id": 14170,
"kind": "msg",
"jp": [
"「・・・わかりません」"
]
},
{
"id": 14171,
"kind": "msg",
"jp": [
"「まあ、今度は手袋ですか。",
"何が何だかわかりませんわね」"
]
},
{
"id": 14172,
"kind": "msg",
"jp": [
"「・・・嫌だわ・・・",
"もう、やめてくれないかしら・・・」"
]
},
{
"id": 14173,
"kind": "msg",
"jp": [
"「・・・意味がわかりませんわね」"
]
},
{
"id": 14174,
"kind": "msg",
"jp": [
"「・・・だんべる・・・」"
]
},
{
"id": 14175,
"kind": "msg",
"jp": [
"「あの、よくわかりません」"
]
},
{
"id": 14176,
"kind": "msg",
"jp": [
"「え?",
"あ、はあ・・・そうですか」"
]
},
{
"id": 14177,
"kind": "msg",
"jp": [
"そりゃまあ、御陵さんにダンベルの事",
"なんか聞いても知らないよな・・・。"
]
},
{
"id": 14178,
"kind": "msg",
"jp": [
"「いえ、知りませんけど」"
]
},
{
"id": 14179,
"kind": "msg",
"jp": [
"「ええ・・・。",
"きれいな絵ですわね」"
]
},
{
"id": 14180,
"kind": "msg",
"jp": [
"なんかそっけない口調だった・・・。"
]
},
{
"id": 14181,
"kind": "msg",
"jp": [
"「そのはずですけれど、",
"それが・・・?」"
]
},
{
"id": 14182,
"kind": "msg",
"jp": [
"「あ、いえ・・・",
"パンクしちゃって気の毒だなと」"
]
},
{
"id": 14183,
"kind": "msg",
"jp": [
"やっぱり、誰がパンクさせたのか",
"考えると怖いのかな。"
]
},
{
"id": 14184,
"kind": "msg",
"jp": [
"「まあ、いやだわ・・・",
"蛇って苦手です、怖くて」"
]
},
{
"id": 14185,
"kind": "msg",
"jp": [
"「僕もです・・・」"
]
},
{
"id": 14186,
"kind": "msg",
"jp": [
"「ええ、食べたことないです」"
]
},
{
"id": 14187,
"kind": "msg",
"jp": [
"「え、まったくですか?」"
]
},
{
"id": 14188,
"kind": "msg",
"jp": [
"「ありませんわ」"
]
},
{
"id": 14189,
"kind": "msg",
"jp": [
"・・・ないのか。",
"作り方も知らないかもなあ・・・。"
]
},
{
"id": 14190,
"kind": "msg",
"jp": [
"「まあ・・・いやだわ、",
"そんな怖いもの・・・」"
]
},
{
"id": 14191,
"kind": "msg",
"jp": [
"「使えるのかどうかは",
"わからないんですけど」"
]
},
{
"id": 14192,
"kind": "msg",
"jp": [
"「使えないことを",
"祈るしかありませんわね」"
]
},
{
"id": 14193,
"kind": "msg",
"jp": [
"「・・・ああ、ありましたわね。",
"あれは一体・・・?」"
]
},
{
"id": 14194,
"kind": "msg",
"jp": [
"「那須さんの部屋のらしいです」"
]
},
{
"id": 14195,
"kind": "msg",
"jp": [
"「・・・まあ、那須さんなら・・・」"
]
},
{
"id": 14196,
"kind": "msg",
"jp": [
"一瞬不思議そうな顔をしたが",
"なんだか納得したらしい。"
]
},
{
"id": 14197,
"kind": "msg",
"jp": [
"・・・どういう解釈をしたんだろう。"
]
},
{
"id": 14198,
"kind": "msg",
"jp": [
"「不眠症なんです。",
"それでお医者様に・・・」"
]
},
{
"id": 14199,
"kind": "msg",
"jp": [
"「ええ・・・。",
"そう見えますけれど」"
]
},
{
"id": 14200,
"kind": "msg",
"jp": [
"何を聞いてるんだ、僕は。"
]
},
{
"id": 14201,
"kind": "msg",
"jp": [
"「噂程度なら・・・",
"でも多分、迷信でしょうね」"
]
},
{
"id": 14202,
"kind": "msg",
"jp": [
"本当だったら嫌すぎる。",
