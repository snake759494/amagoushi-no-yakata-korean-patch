]
},
{
"id": 14429,
"kind": "msg",
"jp": [
"「そうかあ、でもいなくなってたん",
"だから生きてたんだろうなあ」"
]
},
{
"id": 14430,
"kind": "msg",
"jp": [
"「そうかも・・・",
"しれないですね」"
]
},
{
"id": 14431,
"kind": "msg",
"jp": [
"「うん、無事だといいねえ」"
]
},
{
"id": 14432,
"kind": "msg",
"jp": [
"一応、頷きはしたけれど・・・。"
]
},
{
"id": 14433,
"kind": "msg",
"jp": [
"そもそも僕が夢でも見たのかもしれない",
"という可能性の方が高いよなあ・・・。"
]
},
{
"id": 14434,
"kind": "msg",
"jp": [
"「・・・もっとちゃんと",
"声掛ければよかったですね、僕・・・」"
]
},
{
"id": 14435,
"kind": "msg",
"jp": [
"「え? ああ、ごめん!",
"君を責めてるわけじゃないんだよ」"
]
},
{
"id": 14436,
"kind": "msg",
"jp": [
"「驚いただろうし、君だって",
"その場で倒れちゃったんだからさ」"
]
},
{
"id": 14437,
"kind": "msg",
"jp": [
"「え、ええ、でも・・・」"
]
},
{
"id": 14438,
"kind": "msg",
"jp": [
"「いいよいいよ、",
"死体が歩くわけないんだから",
"きっと無事だよ、うん」"
]
},
{
"id": 14439,
"kind": "msg",
"jp": [
"「・・・だといいですね」"
]
},
{
"id": 14440,
"kind": "msg",
"jp": [
"でも、生きてたら僕の声にもうちょっと",
"何か反応してたんじゃないかな。"
]
},
{
"id": 14441,
"kind": "msg",
"jp": [
"それ以前に、僕の見間違いか倒れた時に",
"夢でも見たかって可能性の方が高いかも",
"しれないんだけど。"
]
},
{
"id": 14442,
"kind": "msg",
"jp": [
"「そんなはずないですよ。",
"生きてたらもうちょっと何か反応が",
"あってもいいだろうし・・・」"
]
},
{
"id": 14443,
"kind": "msg",
"jp": [
"「えぇ? でも死んじゃってたら",
"いなくなるわけないじゃないか」"
]
},
{
"id": 14444,
"kind": "msg",
"jp": [
"「え、あ、まあ・・・」"
]
},
{
"id": 14445,
"kind": "msg",
"jp": [
"「そうだろ?",
"生きててほしいと思うよ、",
"無事でいてくれることを祈ろう」"
]
},
{
"id": 14446,
"kind": "msg",
"jp": [
"「・・・そう言えば和くんは",
"役者さんじゃないんだっけ」"
]
},
{
"id": 14447,
"kind": "msg",
"jp": [
"「ないです、ただの迷子です」"
]
},
{
"id": 14448,
"kind": "msg",
"jp": [
"「迷子かあ、迷子は大変だよね。",
"ぼくもたまにやっちゃうんだよな」"
]
},
{
"id": 14449,
"kind": "msg",
"jp": [
"「名前が似てるだけの全然違う",
