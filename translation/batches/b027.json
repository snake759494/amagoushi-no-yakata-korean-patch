]
},
{
"id": 14458,
"kind": "msg",
"jp": [
"「だから盛大に遅刻はしちゃったけど",
"なんとかなるもんだよ、うん」"
]
},
{
"id": 14459,
"kind": "msg",
"jp": [
"それでなんとかなるのはきっと",
"那須さんくらいだろう・・・。"
]
},
{
"id": 14460,
"kind": "msg",
"jp": [
"（少なくとも僕は途中で",
"力尽きるな・・・）"
]
},
{
"id": 14461,
"kind": "msg",
"jp": [
"「迷子とは何か違うものの",
"ような気がしますが・・・」"
]
},
{
"id": 14462,
"kind": "msg",
"jp": [
"「あ、やっぱり?",
"なんか誰に話しても",
"そう言われちゃうんだよなあ」"
]
},
{
"id": 14463,
"kind": "msg",
"jp": [
"「だってそれ、駅を間違えてる理由が",
"方向感覚関係ないじゃないですか」"
]
},
{
"id": 14464,
"kind": "msg",
"jp": [
"「・・・ああ、なるほど!",
"そう言えばそうだなあ」"
]
},
{
"id": 14465,
"kind": "msg",
"jp": [
"「そうか、物の名前覚えるのが",
"苦手なんだよな、ぼくは」"
]
},
{
"id": 14466,
"kind": "msg",
"jp": [
"・・・それはわかる。",
"さっきも僕の名前間違えてたし。"
]
},
{
"id": 14467,
"kind": "msg",
"jp": [
"「あの時も結局、もの凄く遅れたけど",
"目的地までは着いたしなあ」"
]
},
{
"id": 14468,
"kind": "msg",
"jp": [
"「着いてよかったですね・・・」"
]
},
{
"id": 14469,
"kind": "msg",
"jp": [
"「うん、なんだか運はいいんだよ」"
]
},
{
"id": 14470,
"kind": "msg",
"jp": [
"それはうらやましい・・・。"
]
},
{
"id": 14471,
"kind": "msg",
"jp": [
"「僕はそこまでは酷くないですけど」"
]
},
{
"id": 14472,
"kind": "msg",
"jp": [
"「え? そう?」"
]
},
{
"id": 14473,
"kind": "msg",
"jp": [
"「そうかぁ・・・やっぱりぼくの",
"間違い方って酷いのか・・・」"
]
},
{
"id": 14474,
"kind": "msg",
"jp": [
"あ、ちょっとへこんじゃった。",
"悪いこと言っちゃったかな・・・。"
]
},
{
"id": 14475,
"kind": "msg",
"jp": [
"「・・・ん? そう言えば",
"何か用事なんじゃなかったっけ?」"
]
},
{
"id": 14476,
"kind": "msg",
"jp": [
"「あ、えっと・・・",
"那須さんってここまで車で",
"来られてるんですよね」"
]
},
{
"id": 14477,
"kind": "msg",
"jp": [
"「うん、そうだよ。",
"表に停めてあるよ」"
]
},
{
"id": 14478,
"kind": "msg",
"jp": [
"「僕、途中に置いて来ちゃったんで",
"すみませんけど明日、僕の車の所まで",
"乗せてってもらえないですか?」"
]
},
{
"id": 14479,
"kind": "msg",
"jp": [
"「ああ、なんだそんなことか。",
"かまわないよ、もちろん」"
]
},
{
"id": 14480,
"kind": "msg",
"jp": [
"「けど、置いて来ちゃったって",
"故障してるわけじゃないの?」"
]
},
{
"id": 14481,
"kind": "msg",
"jp": [
"「はい、故障じゃないです。",
"ガソリンがやばいなと思って",
"降りて歩いただけなんで」"
]
},
{
"id": 14482,
"kind": "msg",
"jp": [
"「そうか、じゃあどっちにしろ",
"山から降りるまでガソリンが保つか",
"どうかわからないんだ」"
]
},
{
"id": 14483,
"kind": "msg",
"jp": [
"「もし、足りなさそうだったら",
"一旦ぼくの車で街まで降りるといいよ」"
]
},
{
"id": 14484,
"kind": "msg",
"jp": [
"「いいんですか?」"
]
},
{
"id": 14485,
"kind": "msg",
"jp": [
"「いいさ、確か病院にも行かないと",
"いけないんだろ?」"
]
},
{
"id": 14486,
"kind": "msg",
"jp": [
"「だったら車の様子見て病院行って、",
"車は街から修理屋にでも連絡して",
"取りに行ってもらったらどうだい?」"
]
},
{
"id": 14487,
"kind": "msg",
"jp": [
"「ありがとうございます、",
"そうしてもらえたら助かります」"
]
},
{
"id": 14488,
"kind": "msg",
"jp": [
"「すみません、なんだか",
"迷惑ばっかり・・・」"
]
},
{
"id": 14489,
"kind": "msg",
"jp": [
"「何言ってるんだい、",
"困った時はお互い様だよ」"
]
},
{
"id": 14490,
"kind": "msg",
"jp": [
"「それじゃ、明日は早めに",
"起きて街まで行こうね」"
]
},
{
"id": 14491,
"kind": "msg",
"jp": [
"「はい、よろしくお願いします」"
]
},
{
"id": 14492,
"kind": "msg",
"jp": [
"そう言って那須さんはまた",
"身体を動かし始めた。"
]
},
{
"id": 14493,
"kind": "msg",
"jp": [
"（ちょっと変わってるけど",
"いい人だなあ・・・）"
]
},
{
"id": 14494,
"kind": "msg",
"jp": [
"「えーと、那須さん」"
]
},
{
"id": 14495,
"kind": "msg",
"jp": [
"「ん? なんだい?」"
]
},
{
"id": 14496,
"kind": "choice",
"jp": [
"思う"
]
},
{
"id": 14497,
"kind": "choice",
"jp": [
"思わない"
]
},
{
"id": 14498,
"kind": "choice",
"jp": [
"ちゃんと忠告する"
]
},
{
"id": 14499,
"kind": "choice",
"jp": [
"言わないでおく"
]
},
{
"id": 14500,
"kind": "choice",
"jp": [
"見立ての本を暗示してる"
]
},
{
"id": 14501,
"kind": "choice",
"jp": [
"演じる役柄を暗示してる"
]
},
{
"id": 14502,
"kind": "msg",
"jp": [
"「あのですね、実は今夜・・・」"
]
},
{
"id": 14503,
"kind": "msg",
"jp": [
"「今夜? 何かあるのかい?」"
]
},
{
"id": 14504,
"kind": "msg",
"jp": [
"「夜はね、寝る前にはそこのマシンを",
"扉の前に置いてふさいでるんだけど」"
]
},
{
"id": 14505,
"kind": "msg",
"jp": [
"「・・・あの",
"トレーニングマシンですか・・・?」"
]
},
{
"id": 14506,
"kind": "msg",
"jp": [
"確かにあんなものが扉の前にあっては",
"鍵が開いてても入れないだろうけど。"
]
},
{
"id": 14507,
"kind": "msg",
"jp": [
"「まあ、もし強引に誰かが入って",
"来たとしても、ちょっとやそっとじゃ",
"負けないと思うし」"
]
},
{
"id": 14508,
"kind": "msg",
"jp": [
"「だから大丈夫だと思うよ」"
]
},
{
"id": 14509,
"kind": "msg",
"jp": [
"「えーと、じゃあ・・・",
"夜は絶対、扉を開けないように",
"して下さいね」"
]
},
{
"id": 14510,
"kind": "msg",
"jp": [
"「ああ、そうするよ。",
"ありがとう!」"
]
},
{
"id": 14511,
"kind": "msg",
"jp": [
"・・・この人は大丈夫だな。",
"並大抵の相手では、返り討ちにあうのが",
"オチだ、きっと。"
]
},
{
"id": 14512,
"kind": "msg",
"jp": [
"「い、いえ、あのでも・・・",
"犯人がですね、今日狙ってるのは",
"那須さんだと思うんですよ」"
]
},
{
"id": 14513,
"kind": "msg",
"jp": [
"「ぼく?」"
]
},
{
"id": 14514,
"kind": "msg",
"jp": [
"「そうです、あの、信じられない",
"かもしれないですけど・・・」"
]
},
{
"id": 14515,
"kind": "msg",
"jp": [
"「・・・そうか。",
"ぼくなのか・・・」"
]
},
{
"id": 14516,
"kind": "msg",
"jp": [
"「あの、那須さん・・?」"
]
},
{
"id": 14517,
"kind": "msg",
"jp": [
"「し、信用してもらえるんですか」"
]
},
{
"id": 14518,
"kind": "msg",
"jp": [
"「うん、だって和くんは",
"まさか冗談でそんな趣味の悪い",
"ことは言わないだろうし」"
]
},
{
"id": 14519,
"kind": "msg",
"jp": [
"「言いません言いません」"
]
},
{
"id": 14520,
"kind": "msg",
"jp": [
"「でも、なんでぼくだって",
"わかったんだい?」"
]
},
{
"id": 14521,
"kind": "msg",
"jp": [
"「あの、温室に変なものが",
"置いてあったじゃないですか」"
]
},
{
"id": 14522,
"kind": "msg",
"jp": [
"「あれが次に誰を狙うかを",
"示してるようなんです」"
]
},
{
"id": 14523,
"kind": "msg",
"jp": [
"「あれが?」"
]
},
{
"id": 14524,
"kind": "msg",
"jp": [
"「・・・えーと、自分ではその、",
"どういうふうにぼくを暗示してるのか",
"わからないんだけど・・・」"
]
},
{
"id": 14525,
"kind": "msg",
"jp": [
"「直接、那須さんのことを",
"暗示してるわけじゃないんですよ」"
]
},
{
"id": 14526,
"kind": "msg",
"jp": [
"「? どういうこと?」"
]
},
{
"id": 14527,
"kind": "msg",
"jp": [
"「那須さんじゃなくて、",
"那須さんの役柄の方を",
"暗示してるんだと思うんです」"
]
},
{
"id": 14528,
"kind": "msg",
"jp": [
"「役って、今のこの『那須』って役?」"
]
},
{
"id": 14529,
"kind": "msg",
"jp": [
"「でも、脚本は冒頭部分しかないから",
"どういう役なのか良くわからない",
"ままなんだけど・・・」"
]
},
{
"id": 14530,
"kind": "msg",
"jp": [
"「ええ、まあ、そうなんですけど」"
]
},
{
"id": 14531,
"kind": "msg",
"jp": [
"「ふーん・・・?",
"うん、まあよくわからないけど",
"とにかく危ないって事だね」"
]
},
{
"id": 14532,
"kind": "msg",
"jp": [
"「わかった、気をつけるよ。",
"わざわざありがとうね」"
]
},
{
"id": 14533,
"kind": "msg",
"jp": [
"なんか、いまいち危機感を持って",
"もらえてないような・・・。"
]
},
{
"id": 14534,
"kind": "msg",
"jp": [
"「黒猫が、斑井さんの出てくる",
"『黒猫の毒』って作品を暗示",
"してたのと同じで・・・」"
]
},
{
"id": 14535,
"kind": "msg",
"jp": [
"「ああ、じゃあぼくも本なのかい?」"
]
},
{
"id": 14536,
"kind": "msg",
"jp": [
"「ええ、そうです。",
"那須さんのはえーっと・・・」"
]
},
{
"id": 14537,
"kind": "msg",
"jp": [
"手帳を開いて、今日の日付に書き込んだ",
"本のタイトルを見る。"
]
},
{
"id": 14538,
"kind": "msg",
"jp": [
"「え? これ?」"
]
},
{
"id": 14539,
"kind": "msg",
"jp": [
"那須さんが横から手帳をのぞきこんで",
"首をかしげる。"
]
},
{
"id": 14540,
"kind": "msg",
"jp": [
"「ええ、そうですけど・・・」"
]
},
{
"id": 14541,
"kind": "msg",
"jp": [
"「・・・ふーん?",
"なんか、ぼくにはどうしてこれ",
"なのかがよくわからないけど・・・」"
]
},
{
"id": 14542,
"kind": "msg",
"jp": [
"「まあいいや。",
"危ないってのはわかったから",
"一応気はつけておくよ」"
]
},
{
"id": 14543,
"kind": "msg",
"jp": [
"「わざわざありがとうね」"
]
},
{
"id": 14544,
"kind": "msg",
"jp": [
"「・・・『湖畔の館』か。",
"ぼくと同じ名前の人が出てくる話だな」"
]
},
{
"id": 14545,
"kind": "msg",
"jp": [
"「そうなんです。",
"犯人は、斑井さんの時と同じように",
"温室でそれを暗示して・・・」"
]
},
{
"id": 14546,
"kind": "msg",
"jp": [
"「・・・現場も、この本と似た状況に",
"見立てようとすると思うんです」"
]
},
{
"id": 14547,
"kind": "msg",
"jp": [
"那須さんは感心したように",
"頷きながら黙って聞いてくれた。"
]
},
{
"id": 14548,
"kind": "msg",
"jp": [
"「へえ・・・なるほどなあ。",
"すごいな、和くんは」"
]
},
{
"id": 14549,
"kind": "msg",
"jp": [
"「でも、大丈夫だと思うよ」"
]
},
{
"id": 14550,
"kind": "msg",
"jp": [
"「今夜、犯人が来ても多分部屋には",
"入れないだろうし、入ってきても",
"戦って勝てばいいわけだろ?」"
]
},
{
"id": 14551,
"kind": "msg",
"jp": [
"「そ、それはそうなんですが」"
]
},
{
"id": 14552,
"kind": "msg",
"jp": [
"「うん、なら平気だ!",
"負けない自信はあるから!」"
]
},
{
"id": 14553,
"kind": "msg",
"jp": [
"・・・そういう問題、なのか。",
"いや、なにか違うような・・・。"
]
},
{
"id": 14554,
"kind": "msg",
"jp": [
"「でも、ありがとうね。",
"ちゃんと気をつけておくよ」"
]
},
{
"id": 14555,
"kind": "msg",
"jp": [
"「え、あ、いえ」"
]
},
{
"id": 14556,
"kind": "msg",
"jp": [
"「それじゃ、トレーニング中",
"だったから・・・あ、一緒にやる?」"
]
},
{
"id": 14557,
"kind": "msg",
"jp": [
"「いえっ! え、遠慮します!」"
]
},
{
"id": 14558,
"kind": "msg",
"jp": [
"「そうかい?",
"やりたくなったらいつでも",
"言ってくれていいからね」"
]
},
{
"id": 14559,
"kind": "msg",
"jp": [
"「は・・・・・はい」"
]
},
{
"id": 14560,
"kind": "msg",
"jp": [
"信じてはくれてるみたいだけど",
"大丈夫かな・・・。"
]
},
{
"id": 14561,
"kind": "msg",
"jp": [
"（物理的には負けないような",
"気がするけど・・・）"
]
},
{
"id": 14562,
"kind": "msg",
"jp": [
"・・・犯人が真正面から挑んで",
"来るとも思えない。"
]
},
{
"id": 14563,
"kind": "msg",
"jp": [
"夜になったら、改めてもう一度",
"話してみるか・・・。"
]
},
{
"id": 14564,
"kind": "msg",
"jp": [
"「あの・・・",
"実は、今日狙われてるのは",
"那須さんじゃないかと・・・」"
]
},
{
"id": 14565,
"kind": "msg",
"jp": [
"「え? またぼくなの?」"
]
},
{
"id": 14566,
"kind": "msg",
"jp": [
"「す、すいませんっ!",
"でも、間違いないと思います!」"
]
},
{
"id": 14567,
"kind": "msg",
"jp": [
"「うーん・・・",
"わかった、気をつけとくよ」"
]
},
{
"id": 14568,
"kind": "msg",
"jp": [
"「和くんも気をつけるんだよ。",
"それじゃあね」"
]
},
{
"id": 14569,
"kind": "msg",
"jp": [
"・・・なんか、いまいち",
"本気にされてないような。"
]
},
{
"id": 14570,
"kind": "msg",
"jp": [
"（大丈夫かなぁ・・・）"
]
},
{
"id": 14571,
"kind": "msg",
"jp": [
"那須さんなら大抵の相手には",
"負けないだろうけど・・・。"
]
},
{
"id": 14572,
"kind": "msg",
"jp": [
"「・・・前も",
"そう言ってなかったっけ?」"
]
},
{
"id": 14573,
"kind": "msg",
"jp": [
"「は、はい!",
"すみません、前のは、あの・・」"
]
},
{
"id": 14574,
"kind": "msg",
"jp": [
"「うーん・・・",
"まあ、一応気はつけとくよ」"
]
},
{
"id": 14575,
"kind": "msg",
"jp": [
"「それじゃ、和くんも",
"気をつけなよ」"
]
},
{
"id": 14576,
"kind": "msg",
"jp": [
"・・・やっぱり信用してもらえて",
"なさそうだ・・・。"
]
},
{
"id": 14577,
"kind": "msg",
"jp": [
"「・・・雨、ちっとも",
"やまないですね」"
]
},
{
"id": 14578,
"kind": "msg",
"jp": [
"「うーん、困るよねえ。",
"ランニングにも行けないし」"
]
},
{
"id": 14579,
"kind": "msg",
"jp": [
"困るポイントが何か違う・・・。"
]
},
{
"id": 14580,
"kind": "msg",
"jp": [
"「崖崩れって、相当ひどい",
"状態だったんですか?」"
]
},
{
"id": 14581,
"kind": "msg",
"jp": [
"「うん、乗り越えるのは",
"さすがに無理そうだった」"
]
},
{
"id": 14582,
"kind": "msg",
"jp": [
"「あ、あの、歩いて帰れるか",
"とかじゃなくてですね」"
]
},
{
"id": 14583,
"kind": "msg",
"jp": [
"「あ、違うの?」"
]
},
{
"id": 14584,
"kind": "msg",
"jp": [
"「じゃなくて、この辺にも",
"被害が広がってきたり",
"しないのかなって・・・」"
]
},
{
"id": 14585,
"kind": "msg",
"jp": [
"「この辺は大丈夫じゃないかな。",
"けっこう離れてたし」"
]
},
{
"id": 14586,
"kind": "msg",
"jp": [
"それだけは安心していいのかな。",
"でも復旧してくれないとなあ・・・。"
]
},
{
"id": 14587,
"kind": "msg",
"jp": [
"「那須さん、温室に灯りが",
"ついてたの気がつきました?」"
]
},
{
"id": 14588,
"kind": "msg",
"jp": [
"「いや、それが指立て伏せしてる",
"最中だったから全然気付かなくてさ」"
]
},
{
"id": 14589,
"kind": "msg",
"jp": [
"「・・・指立て・・・」"
]
},
{
"id": 14590,
"kind": "msg",
"jp": [
"「知らない?",
"えっと、こうやって・・・」"
]
},
{
"id": 14591,
"kind": "msg",
"jp": [
"「あ、いえっ!",
"やり方は知ってますっ!」"
]
},
{
"id": 14592,
"kind": "msg",
"jp": [
"「そう? あれは始めると",
"集中しちゃって、呼ばれても",
"気付かないことあるんだよね」"
]
},
{
"id": 14593,
"kind": "msg",
"jp": [
"「あの・・・",
"ずっと女装したまますごすのって",
"かなり大変でしょうね・・・?」"
]
},
{
"id": 14594,
"kind": "msg",
"jp": [
"「ああ、あれは大変だよ」"
]
},
{
"id": 14595,
"kind": "msg",
"jp": [
"「・・・え、あの、",
"やったことあるんですか?」"
]
},
{
"id": 14596,
"kind": "msg",
"jp": [
"「うん、仕事であるよ。",
"スカートって動きにくいんだ」"
]
},
{
"id": 14597,
"kind": "msg",
"jp": [
"「・・・撮影中走ろうとして",
"2枚も破いちゃって怒られたなあ」"
]
},
{
"id": 14598,
"kind": "msg",
"jp": [
"那須さんがはけるサイズの",
"スカートってあるんだ・・・。"
]
},
{
"id": 14599,
"kind": "msg",
"jp": [
"「静奈ちゃんが寝ぼけて",
"部屋から出て歩き回ってた",
"らしいんですよ」"
]
},
{
"id": 14600,
"kind": "msg",
"jp": [
"「へ?",
"寝たままって夢遊病とか?」"
]
},
{
"id": 14601,
"kind": "msg",
"jp": [
"「そうみたいです。",
"朝早くにうろうろしてて・・・」"
]
},
{
"id": 14602,
"kind": "msg",
"jp": [
"「え? 朝っていつの?」"
]
},
{
"id": 14603,
"kind": "msg",
"jp": [
"「ここに来て3日目のです」"
]
},
{
"id": 14604,
"kind": "msg",
"jp": [
"「じゃあ、あれ寝てたんだ!",
"へー、全然気がつかなかった」"
]
},
{
"id": 14605,
"kind": "msg",
"jp": [
"「朝、ランニングに出る時に",
"ホールから階段を降りてくるのが",
"ちらっと見えたんだよ」"
]
},
{
"id": 14606,
"kind": "msg",
"jp": [
"「静奈ちゃんがですか?」"
]
},
{
"id": 14607,
"kind": "msg",
"jp": [
"「だと思うよ。",
"双子のどっちかだったのは",
"確かだから」"
]
},
{
"id": 14608,
"kind": "msg",
"jp": [
"「けど、夢遊病って",
"見ただけじゃ寝てるなんて",
"わかんないもんだね」"
]
},
{
"id": 14609,
"kind": "msg",
"jp": [
"「そんなに普通に",
"見えるものなんですか」"
]
},
{
"id": 14610,
"kind": "msg",
"jp": [
"「よく見ればわかるのかも",
"しれないけどね。",
"遠目じゃわからなかったよ」"
]
},
{
"id": 14611,
"kind": "msg",
"jp": [
"「これ、なんて書いてあるか",
"読めますか?」"
]
},
{
"id": 14612,
"kind": "msg",
"jp": [
"「どれどれ?",
"えーっと・・・・」"
]
},
{
"id": 14613,
"kind": "msg",
"jp": [
"「・・・ごめん、読めない。",
"英語じゃないみたいだし」"
]
},
{
"id": 14614,
"kind": "msg",
"jp": [
"「何の文章なんだい、これ?」"
]
},
{
