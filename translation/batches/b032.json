[
{
"id": 16811,
"kind": "msg",
"jp": [
"「それとも、物を置いた人が",
"悪いことになって逮捕される?」"
]
},
{
"id": 16812,
"kind": "msg",
"jp": [
"「明らかに危ない場所に",
"置いてあったなら罪になるかも",
"しれないけど・・・」"
]
},
{
"id": 16813,
"kind": "msg",
"jp": [
"「普通は危なくない場所で",
"しかも誰が置いたかはっきり",
"わからんかったら?」"
]
},
{
"id": 16814,
"kind": "msg",
"jp": [
"「そりゃあ・・・",
"誰かが逮捕されるとかいう",
"ことにはならないんじゃないかな」"
]
},
{
"id": 16815,
"kind": "msg",
"jp": [
"「そうやんね。",
"けど、もし・・・」"
]
},
{
"id": 16816,
"kind": "msg",
"jp": [
"「・・・誰かおったら?",
"こいつが悪いって確信するような",
"相手が誰か見つかったら?」"
]
},
{
"id": 16817,
"kind": "msg",
"jp": [
"「そ、それは・・・",
"警察に言った方が」"
]
},
{
"id": 16818,
"kind": "msg",
"jp": [
"「危なくない場所で、",
"誰が置いたかも証明出来へんのに?」"
]
},
{
"id": 16819,
"kind": "msg",
"jp": [
"「え・・・",
"確信してるのは本人だけって事?」"
]
},
{
"id": 16820,
"kind": "msg",
"jp": [
"「そう。",
"警察に言うても無駄なんは",
"当然わかってる」"
]
},
{
"id": 16821,
"kind": "msg",
"jp": [
"「でも、誰かのせいにする",
"理由だけは何らかの形で",
"手に入れてしまった人」"
]
},
{
"id": 16822,
"kind": "msg",
"jp": [
"「・・・なんで、",
"急にそんなこと・・・」"
]
},
{
"id": 16823,
"kind": "msg",
"jp": [
"「・・・あったから」"
]
},
{
"id": 16824,
"kind": "msg",
"jp": [
"「誰も、責めようがなくて",
"責めたくなくて、",
"泣いたことがあったから」"
]
},
{
"id": 16825,
"kind": "msg",
"jp": [
"「もしあの時、誰かが悪いって",
"確信してたらその誰かのこと",
"恨んだかな・・と思たん」"
]
},
{
"id": 16826,
"kind": "msg",
"jp": [
"「静奈ちゃんだったら・・・",
"もし誰か責める相手を見つけたら",
"・・・殺そうと思う?」"
]
},
{
"id": 16827,
"kind": "msg",
"jp": [
"「事による」"
]
},
{
"id": 16828,
"kind": "msg",
"jp": [
"「もし、鈴が死んで",
"それが誰かのせいやったら",
"・・・殺すかも」"
]
},
{
"id": 16829,
"kind": "msg",
"jp": [
"「もしくは呪う」"
]
},
{
"id": 16830,
"kind": "msg",
"jp": [
"「の、呪う!?」"
]
},
{
"id": 16831,
"kind": "msg",
"jp": [
"「お兄さん、知らんの?」"
]
},
{
"id": 16832,
"kind": "msg",
"jp": [
"「呪いってほんまに",
"かけられるんよ」"
]
},
{
"id": 16833,
"kind": "msg",
"jp": [
"「なんで満面の笑顔なの!?」"
]
},
{
"id": 16834,
"kind": "msg",
"jp": [
"「なんとなく」"
]
},
{
"id": 16835,
"kind": "msg",
"jp": [
"どこまでが本気で",
"どこからが冗談だったのか",
"よくわからない・・・。"
]
},
{
"id": 16836,
"kind": "msg",
"jp": [
"「温室にあった、",
"黒猫の置物ってさ・・・」"
]
},
{
"id": 16837,
"kind": "msg",
"jp": [
"「・・・かわいそう」"
]
},
{
"id": 16838,
"kind": "msg",
"jp": [
"「かわいいのに、",
"変なことに使われて猫が",
"かわいそう」"
]
},
{
"id": 16839,
"kind": "msg",
"jp": [
"「静奈ちゃんは、",
"ここの内線電話よく使う?」"
]
},
{
"id": 16840,
"kind": "msg",
"jp": [
"「うん、部屋出る時とかに",
"鈴と『出るよー』って」"
]
},
{
"id": 16841,
"kind": "msg",
"jp": [
"「けど、音悪いん。",
"ずっとざらざら変なノイズみたいな",
"音が混じってて気持ち悪い」"
]
},
{
"id": 16842,
"kind": "msg",
"jp": [
"「ノイズか。",
"なんでだろうね」"
]
},
{
"id": 16843,
"kind": "msg",
"jp": [
"「娯楽室のラジオって",
"初日から誰か触ってる人いた?」"
]
},
{
"id": 16844,
"kind": "msg",
"jp": [
"「うちは触ってへんし、",
"触ってる人も見た覚えないけど」"
]
},
{
"id": 16845,
"kind": "msg",
"jp": [
"「そっかぁ」"
]
},
{
"id": 16846,
"kind": "msg",
"jp": [
"「犯人は、ラジオだけは",
"通じるの知ってたんやろか」"
]
},
{
"id": 16847,
"kind": "msg",
"jp": [
"「あれでニュース聞かんかったら",
"うちら崖が崩れてんの知らんかったよ」"
]
},
{
"id": 16848,
"kind": "msg",
"jp": [
"「そう、だよね・・・」"
]
},
{
"id": 16849,
"kind": "msg",
"jp": [
"だとしても、崖が崩れたのだけは",
"間違いなく偶然なはずだけど・・・。"
]
},
{
"id": 16850,
"kind": "msg",
"jp": [
"「1階のホールにある",
"大時計すごいよね」"
]
},
{
"id": 16851,
"kind": "msg",
"jp": [
"「かっこいい」"
]
},
{
"id": 16852,
"kind": "msg",
"jp": [
"「うん、映画みたいだ」"
]
},
{
"id": 16853,
"kind": "msg",
"jp": [
"「・・・おとぎ話みたいにさ、",
"あの中に誰か隠れたり出来へん?」"
]
},
{
"id": 16854,
"kind": "msg",
"jp": [
"「えっ!?",
"あの中には・・・ちょっと難しいん",
"じゃないかなあ・・・」"
]
},
{
"id": 16855,
"kind": "msg",
"jp": [
"「・・・小ヤギとちゃうしね」"
]
},
{
"id": 16856,
"kind": "msg",
"jp": [
"・・・ヤギでも無理だと思う。"
]
},
{
"id": 16857,
"kind": "msg",
"jp": [
"「温室にあったベルって",
"何かの飾りかな」"
]
},
{
"id": 16858,
"kind": "msg",
"jp": [
"「クリスマスツリー?」"
]
},
{
"id": 16859,
"kind": "msg",
"jp": [
"「そんな感じだよね」"
]
},
{
"id": 16860,
"kind": "msg",
"jp": [
"「西洋の鐘が欲しかったんやったら、",
"ツリーの飾りって",
"一番手に入れやすいかも」"
]
},
{
"id": 16861,
"kind": "msg",
"jp": [
"「ああ、そうかもね」"
]
},
{
"id": 16862,
"kind": "msg",
"jp": [
"犯人が持って来ようと思ったら",
"その辺で買えたってことか・・。"
]
},
{
"id": 16863,
"kind": "msg",
"jp": [
"「温室に置かれてた",
"でっかい釘なんだけどさ」"
]
},
{
"id": 16864,
"kind": "msg",
"jp": [
"「・・・釘」"
]
},
{
"id": 16865,
"kind": "msg",
"jp": [
"「うん、見たよね」"
]
},
{
"id": 16866,
"kind": "msg",
"jp": [
"「わら人形打つやつみたい」"
]
},
{
"id": 16867,
"kind": "msg",
"jp": [
"「温室にね、手袋が",
"置いてあったんだけど」"
]
},
{
"id": 16868,
"kind": "msg",
"jp": [
"「白い、女の人が使う",
"やつだと思うんだけどさ」"
]
},
{
"id": 16869,
"kind": "msg",
"jp": [
"「・・・ドレス用のかな」"
]
},
{
"id": 16870,
"kind": "msg",
"jp": [
"「ああ、そんな感じだった」"
]
},
{
"id": 16871,
"kind": "msg",
"jp": [
"「そんな衣装の人は",
"いてへんと思う・・・」"
]
},
{
"id": 16872,
"kind": "msg",
"jp": [
"「今回の脚本に?」"
]
},
{
"id": 16873,
"kind": "msg",
"jp": [
"「うん。",
"普段出かけるのにも",
"使いそうにないし・・・」"
]
},
{
"id": 16874,
"kind": "msg",
"jp": [
"「温室に、手斧が増えてたんだ」"
]
},
{
"id": 16875,
"kind": "msg",
"jp": [
"「・・・・・斧?」"
]
},
{
"id": 16876,
"kind": "msg",
"jp": [
"「うん、小型のだけど」"
]
},
{
"id": 16877,
"kind": "msg",
"jp": [
"「斧なんや・・・ふぅん・・・」"
]
},
{
"id": 16878,
"kind": "msg",
"jp": [
"「どうしたの?」"
]
},
{
"id": 16879,
"kind": "msg",
"jp": [
"「・・・ううん。",
"なんでもない」"
]
},
{
"id": 16880,
"kind": "msg",
"jp": [
"「温室に柵が置いてあったよ。",
"なんか、小さいの」"
]
},
{
"id": 16881,
"kind": "msg",
"jp": [
"「・・・飾り?」"
]
},
{
"id": 16882,
"kind": "msg",
"jp": [
"「そうなのかな。",
"園芸用か何かだと思うんだけど」"
]
},
{
"id": 16883,
"kind": "msg",
"jp": [
"「・・・温室の花壇って",
"柵なかった気がする」"
]
},
{
"id": 16884,
"kind": "msg",
"jp": [
"「うん、あの温室にあった物",
"じゃないと思う」"
]
},
{
"id": 16885,
"kind": "msg",
"jp": [
"「ほな、犯人が持って来たんや」"
]
},
{
"id": 16886,
"kind": "msg",
"jp": [
"「多分ね・・・」"
]
},
{
"id": 16887,
"kind": "msg",
"jp": [
"「・・・うち、持てんかった」"
]
},
{
"id": 16888,
"kind": "msg",
"jp": [
"「持ってみたんだ」"
]
},
{
"id": 16889,
"kind": "msg",
"jp": [
"「両手でよいしょってしたら",
"やっと持てた」"
]
},
{
"id": 16890,
"kind": "msg",
"jp": [
"「そんなに重いんだ・・・」"
]
},
{
"id": 16891,
"kind": "msg",
"jp": [
"「お兄さんにはお勧めせえへん。",
"なんか足の上に落としそう」"
]
},
{
"id": 16892,
"kind": "msg",
"jp": [
"相当どんくさいイメージなのかな",
"僕って・・・。"
]
},
{
"id": 16893,
"kind": "msg",
"jp": [
"「斑井さんの部屋に",
"変な杖があったんだけどさ」"
]
},
{
"id": 16894,
"kind": "msg",
"jp": [
"「あの、魔法使いの杖",
"みたいなん?」"
]
},
{
"id": 16895,
"kind": "msg",
"jp": [
"「うん、そうそう。",
"変な形のやつ」"
]
},
{
"id": 16896,
"kind": "msg",
"jp": [
"「・・・って知ってるの?」"
]
},
{
"id": 16897,
"kind": "msg",
"jp": [
"「斑井さんが自慢してた」"
]
},
{
"id": 16898,
"kind": "msg",
"jp": [
"「帽子屋からの指示に、",
"部屋に秘密の小道具があるけど",
"黙っとくように言われたって」"
]
},
{
"id": 16899,
"kind": "msg",
"jp": [
"「黙ってないじゃないか」"
]
},
{
"id": 16900,
"kind": "msg",
"jp": [
"「斑井さんやし」"
]
},
{
"id": 16901,
"kind": "msg",
"jp": [
"見も蓋もなく静奈ちゃんは",
"言い切った。"
]
},
{
"id": 16902,
"kind": "msg",
"jp": [
"「けどあれ、変な形やけど",
"普通の杖やったよ」"
]
},
{
"id": 16903,
"kind": "msg",
"jp": [
"「振ってみたけど",
"何も出てこんかった」"
]
},
{
"id": 16904,
"kind": "msg",
"jp": [
"「何か出てきたら怖いじゃないか!」"
]
},
{
"id": 16905,
"kind": "msg",
"jp": [
"「呪文も唱えたのに・・・」"
]
},
{
"id": 16906,
"kind": "msg",
"jp": [
"「な、なんの?」"
]
},
{
"id": 16907,
"kind": "msg",
"jp": [
"「・・・・ひみつ」"
]
},
{
"id": 16908,
"kind": "msg",
"jp": [
"一体何を呼び出そうとしたんだ",
"この子は・・・。"
]
},
{
"id": 16909,
"kind": "msg",
"jp": [
"「この館って絵が多いよね。",
"どこの部屋にもあるし」"
]
},
{
"id": 16910,
"kind": "msg",
"jp": [
"「お花の絵、きれい。",
"応接室のやつとか」"
]
},
{
"id": 16911,
"kind": "msg",
"jp": [
"「お兄さんの部屋のはなに?」"
]
},
{
"id": 16912,
"kind": "msg",
"jp": [
"「僕らの部屋・・・",
"そう言えば絵はなかったなあ」"
]
},
{
"id": 16913,
"kind": "msg",
"jp": [
"「駐車場にある車は斑井さんと",
"那須さんのなんだよね」"
]
},
{
"id": 16914,
"kind": "msg",
"jp": [
"「・・・そやったと思う。",
"うちら、送ってもろたし」"
]
},
{
"id": 16915,
"kind": "msg",
"jp": [
"「お兄さんの車、どんなん?」"
]
},
{
"id": 16916,
"kind": "msg",
"jp": [
"「僕のは普通の軽だよ」"
]
},
{
"id": 16917,
"kind": "msg",
"jp": [
"「ちっこいの?」"
]
},
{
"id": 16918,
"kind": "msg",
"jp": [
"「うん、小さいよ」"
]
},
{
"id": 16919,
"kind": "msg",
"jp": [
"「・・・うちも免許欲しい」"
]
},
{
"id": 16920,
"kind": "msg",
"jp": [
"「持ってないんだ?」"
]
},
{
"id": 16921,
"kind": "msg",
"jp": [
"「鈴とか、お母さんが",
"やめとけって・・・」"
]
},
{
"id": 16922,
"kind": "msg",
"jp": [
"「歩きながら物考えるクセが",
"あって時々転んだり迷ったりするから",
"車でも同じ事しそうやって」"
]
},
{
"id": 16923,
"kind": "msg",
"jp": [
"「あ、危なそうだね・・・」"
]
},
{
"id": 16924,
"kind": "msg",
"jp": [
"「地下にさ・・・",
"蛇がいっぱいいたんだよ」"
]
},
{
"id": 16925,
"kind": "msg",
"jp": [
"「蛇・・・」"
]
},
{
"id": 16926,
"kind": "msg",
"jp": [
"「静奈ちゃんは、蛇平気?」"
]
},
{
"id": 16927,
"kind": "msg",
"jp": [
"「飼いたい」"
]
},
{
"id": 16928,
"kind": "msg",
"jp": [
"「・・・けど、鈴が嫌がる」"
]
},
{
"id": 16929,
"kind": "msg",
"jp": [
"気持ちはわかる・・・。"
]
},
{
"id": 16930,
"kind": "msg",
"jp": [
"「静奈ちゃんは、",
"カップ麺なんて普段食べる?",
"台所にいっぱいあるけど」"
]
},
{
"id": 16931,
"kind": "msg",
"jp": [
"（な、なんで悲しそうな顔に",
"なるんだろう・・・?）"
]
},
{
"id": 16932,
"kind": "msg",
"jp": [
"「・・・うちが気に入るやつ、",
"すぐ店からなくなるん」"
]
},
{
"id": 16933,
"kind": "msg",
"jp": [
"「なんでやろう。",
"この前も『欧風とんこつブラボー』が",
"近所の店からなくなってた・・・」"
]
},
{
"id": 16934,
"kind": "msg",
"jp": [
"キワモノ過ぎてマニアにしか",
"売れなさそうな名前だ・・・。"
]
},
{
"id": 16935,
"kind": "msg",
"jp": [
"「物置の棚の中にさ、",
"ボウガンがあったんだ」"
]
},
{
"id": 16936,
"kind": "msg",
"jp": [
"「・・・ボウガン?",
"クロスボウのこと?」"
]
},
{
"id": 16937,
"kind": "msg",
"jp": [
"「同じ物なの?",
"よくわかんないけど銃みたいに",
"撃つ弓だったよ」"
]
},
{
"id": 16938,
"kind": "msg",
"jp": [
"「なんで物置なんやろ。",
"他にも武器あるし、飾ってるのに」"
]
},
{
"id": 16939,
"kind": "msg",
"jp": [
"「入れ物が壊れてたんだ。",
"それでじゃないかな」"
]
},
{
"id": 16940,
"kind": "msg",
"jp": [
"「あのさ、廊下に1つだけ",
"放り出されてる家具があるでしょ」"
]
},
{
"id": 16941,
"kind": "msg",
"jp": [
"「うちと鈴の部屋のんと",
"違うけど・・・」"
]
},
{
"id": 16942,
"kind": "msg",
"jp": [
"「あれ那須さんの部屋のだよ。",
"家から持ってきたトレーニングマシン",
"置くのに邪魔だから出したんだって」"
]
},
{
"id": 16943,
"kind": "msg",
"jp": [
"なぜ無言なんだろうと思ったら、",
"静奈ちゃんはうつむいて笑いを",
"かみ殺していた・・・。"
]
},
{
"id": 16944,
"kind": "msg",
"jp": [
"「静奈ちゃんは、睡眠薬って",
"使うことあるの?」"
]
},
{
"id": 16945,
"kind": "msg",
"jp": [
"「うちはないけど・・・",
"御陵さんが持ってはったね」"
]
},
{
"id": 16946,
"kind": "msg",
"jp": [
"「うん。",
"普段から使ってるみたい」"
]
},
{
"id": 16947,
"kind": "msg",
"jp": [
"「・・・御陵さんて、",
"のん気なんか繊細なんか",
"よぉわからん・・・」"
]
},
{
"id": 16948,
"kind": "msg",
"jp": [
"そう言えばそうだ・・・。"
]
},
{
"id": 16949,
"kind": "msg",
"jp": [
"「ねえ、これってまりもだよね」"
]
},
{
"id": 16950,
"kind": "msg",
"jp": [
"「・・・マリアンヌ・・・」"
]
},
{
"id": 16951,
"kind": "msg",
"jp": [
"「名前、だと思う?」"
]
},
{
"id": 16952,
"kind": "msg",
"jp": [
"「うちの子はビリーとチャック」"
]
},
{
"id": 16953,
"kind": "msg",
"jp": [
"「家で飼うてる」"
]
},
{
"id": 16954,
"kind": "msg",
"jp": [
"意外と多いのか、まりも愛好家って。"
]
},
{
"id": 16955,
"kind": "msg",
"jp": [
"「あの・・・静奈ちゃん、",
"赤いカメオって知ってる・・・?」"
]
},
{
"id": 16956,
"kind": "msg",
"jp": [
"「呪われるやつ?」"
]
},
{
"id": 16957,
"kind": "msg",
"jp": [
"「知ってるんだ・・・」"
]
},
{
"id": 16958,
"kind": "msg",
"jp": [
"「持ってたら変な死に方",
"するっていうやつでしょ」"
]
},
{
"id": 16959,
"kind": "msg",
"jp": [
"「・・・そう言えば四倉さんが",
"探してみたことあるとかって",
"聞いたことが・・・」"
]
},
{
"id": 16960,
"kind": "msg",
"jp": [
"「えっ!?",
"そ、そうなの!?」"
]
},
{
"id": 16961,
"kind": "msg",
"jp": [
"「見つかったんかどうかは",
"知らんけど」"
]
},
{
"id": 16962,
"kind": "msg",
"jp": [
"「・・・本当にあるのかな」"
]
},
{
"id": 16963,
"kind": "msg",
"jp": [
"「あるんやったらちょっと",
"見てみたいかも」"
]
},
{
"id": 16964,
"kind": "msg",
"jp": [
"「僕は遠慮したいよ・・・」"
]
},
{
"id": 16965,
"kind": "msg",
"jp": [
"「これさ、温室の奥にあったんだけど",
"静奈ちゃん見覚えない?」"
]
},
{
"id": 16966,
"kind": "msg",
"jp": [
"「・・・うちMDしか持ってへん」"
]
},
{
"id": 16967,
"kind": "msg",
"jp": [
"「あ、そうなんだ。",
"じゃあ知らないよね・・・」"
]
},
{
"id": 16968,
"kind": "msg",
"jp": [
"「何が入ってるのん」"
]
},
{
"id": 16969,
"kind": "msg",
"jp": [
"「・・・ガラスの割れる音」"
]
},
{
"id": 16970,
"kind": "msg",
"jp": [
"「だけ?」"
]
},
{
"id": 16971,
"kind": "msg",
"jp": [
"「うん、最後の方に",
"それだけ入ってた」"
]
},
{
"id": 16972,
"kind": "msg",
"jp": [
"「・・・ふうん」"
]
},
{
"id": 16973,
"kind": "msg",
"jp": [
"「物置に、矢がなくなってる",
"ボウガンがあるんだけどさ・・・」"
]
},
{
"id": 16974,
"kind": "msg",
"jp": [
"「それって、撃ったってこと?」"
]
},
{
"id": 16975,
"kind": "msg",
"jp": [
"「かもしれない」"
]
},
{
"id": 16976,
"kind": "msg",
"jp": [
"「・・・何に使ったか",
"調べた方がええんとちゃう」"
]
},
{
"id": 16977,
"kind": "msg",
"jp": [
"「物置にボウガンがあったよ。",
"矢がつがえられてなかった・・・」"
]
},
{
"id": 16978,
"kind": "msg",
"jp": [
"「・・・それ、",
"暗石さんの・・・?」"
]
},
{
"id": 16979,
"kind": "msg",
"jp": [
"「うん、凶器だと思う。",
"他に弓なんてないし」"
]
},
{
"id": 16980,
"kind": "msg",
"jp": [
"「・・・・けどさ」"
]
},
{
"id": 16981,
"kind": "msg",
"jp": [
"「普通、そんなん持って部屋に",
"入ってったら逃げるよね」"
]
},
{
"id": 16982,
"kind": "msg",
"jp": [
"「どうやって撃ったんやろう。",
"暗石さん、一番警戒してたのに」"
]
},
{
"id": 16983,
"kind": "msg",
"jp": [
"「これに見覚えある?」"
]
},
{
"id": 16984,
"kind": "msg",
"jp": [
"「・・・暗石のおっちゃんの",
"やと思う・・・」"
]
},
{
"id": 16985,
"kind": "msg",
"jp": [
"「やっぱり・・・?」"
]
},
{
"id": 16986,
"kind": "msg",
"jp": [
"「どこにあったん」"
]
},
{
"id": 16987,
"kind": "msg",
"jp": [
"「庭に落ちてた。",
"暗石さんの部屋の真下あたり」"
]
},
{
"id": 16988,
"kind": "msg",
"jp": [
"「・・・おっちゃんの部屋の下。",
"てことは、娯楽室の前ってこと」"
]
},
{
"id": 16989,
"kind": "msg",
"jp": [
"「うん、そうなるね」"
]
},
{
"id": 16990,
"kind": "msg",
"jp": [
"「なんでそんなことに",
"あったんやろう・・・」"
]
},
{
"id": 16991,
"kind": "msg",
"jp": [
"「うち、おっちゃんが部屋にこもる前",
"まだ胸にその万年筆差してあんのん",
"見たん覚えてる・・・」"
]
},
{
"id": 16992,
"kind": "msg",
"jp": [
"「だよね。",
"いつ庭に落ちたんだろう・・・?」"
]
},
{
"id": 16993,
"kind": "msg",
"jp": [
"「あのさ、これなんだと思う?」"
]
},
{
"id": 16994,
"kind": "msg",
"jp": [
"「・・・?",
"なにこれ・・・・」"
]
},
{
"id": 16995,
"kind": "msg",
"jp": [
"「・・・どっかに刺すの?",
"なんで番号ついてんの?」"
]
},
{
"id": 16996,
"kind": "msg",
"jp": [
"「それがわかんないんだ。",
"何に使うものなのかも、さっぱり」"
]
},
{
"id": 16997,
"kind": "msg",
"jp": [
"「番号順に刺さんと",
"爆発するとか・・・」"
]
},
{
"id": 16998,
"kind": "msg",
"jp": [
"「何が!?」"
]
},
{
"id": 16999,
"kind": "msg",
"jp": [
"「さあ。",
"でも意味もなく番号つける",
"ことはないと思う」"
]
},
{
"id": 17000,
"kind": "msg",
"jp": [
"「どっかに刺すんか、",
"組み立てるんかはわからんけど",
"その数字はきっと意味があると思う」"
]
},
{
"id": 17001,
"kind": "msg",
"jp": [
"でもやっぱり、何に使うのか",
"わからないんだよな。"
]
},
{
"id": 17002,
"kind": "msg",
"jp": [
"「これ、何の花だかわかる?」"
]
},
{
"id": 17003,
"kind": "msg",
"jp": [
"携帯に画像を呼び出しディスプレイを",
"向けると、静奈ちゃんは身を乗り出して",
"のぞきこんできた。"
]
},
{
"id": 17004,
"kind": "msg",
"jp": [
"「・・・・わからへん」"
]
},
{
"id": 17005,
"kind": "msg",
"jp": [
"「そっかぁ・・・」"
]
},
{
"id": 17006,
"kind": "msg",
"jp": [
"「これ、咲いてるんちゃうよね」"
]
},
{
"id": 17007,
"kind": "msg",
"jp": [
"「うん、千切られて落ちてた。",
"温室の・・・あの、黒猫とか",
"置いてあるところに」"
]
},
{
"id": 17008,
"kind": "msg",
"jp": [
"「・・・ほな、犯人が?」"
]
},
{
"id": 17009,
"kind": "msg",
"jp": [
"「かもしれない。",
"けど、何の花かもわからないと",
"どういう意味なのか・・・」"
]
},
{
"id": 17010,
"kind": "msg",
"jp": [
"「そやろね」"
]
},
{
"id": 17011,
"kind": "msg",
"jp": [
"「けど、うちも鈴もそういうのは",
"さっぱりやから他の人に聞いてみた",
"方がええと思う」"
]
},
{
"id": 17012,
"kind": "msg",
"jp": [
"「そっか。",
"じゃあそうしてみるよ」"
]
},
{
"id": 17013,
"kind": "msg",
"jp": [
"「あのさ、インプって知ってる?",
"小さい悪魔みたいな・・・」"
]
},
{
"id": 17014,
"kind": "msg",
"jp": [
"「それ、後の方の話」"
]
},
{
"id": 17015,
"kind": "msg",
"jp": [
"「元はイギリスの妖精なん。",
"小鬼みたいなんでイタズラするん」"
]
},
{
"id": 17016,
"kind": "msg",
"jp": [
"「そ・・そうなんだ」"
]
},
{
"id": 17017,
"kind": "msg",
"jp": [
"「・・・それが、なんでか",
"魔女の使い魔とか言われだして",
"なんか悪魔みたいなんになったん」"
]
},
{
"id": 17018,
"kind": "msg",
"jp": [
"「・・・で、インプが",
"どないしたん?」"
]
},
{
"id": 17019,
"kind": "msg",
"jp": [
"「あ、ああ、那須さんが",
"山道の途中にあった車の中に",
"そういう飾りがついてたって」"
]
},
{
"id": 17020,
"kind": "msg",
"jp": [
"「・・・悪魔の方の?」"
]
},
{
"id": 17021,
"kind": "msg",
"jp": [
"「みたいだよ。",
"三角の尻尾でコウモリみたいな",
"羽根が生えてたって」"
]
},
{
"id": 17022,
"kind": "msg",
"jp": [
"「四倉さんは、",
"そっちの方が好きそう」"
]
},
{
"id": 17023,
"kind": "msg",
"jp": [
"「好きなんだ・・・」"
]
},
{
"id": 17024,
"kind": "msg",
"jp": [
"「最近のインプは、黒魔術師とか",
"邪教の司祭とかが召喚する魔族って",
"いうのが多いから」"
]
},
{
"id": 17025,
"kind": "msg",
"jp": [
"「四倉さん、そういうの大好きやし」"
]
},
{
"id": 17026,
"kind": "msg",
"jp": [
"「そ、そういうのって・・・」"
]
},
{
"id": 17027,
"kind": "msg",
"jp": [
"「黒魔術とか」"
]
},
{
"id": 17028,
"kind": "msg",
"jp": [
"「えーと、じゃあ・・・",
"車にそういうの飾ってても・・・」"
]
},
{
"id": 17029,
"kind": "msg",
"jp": [
"「誰も不思議に思わへん。",
"四倉さんらしい」"
]
},
{
"id": 17030,
"kind": "msg",
"jp": [
"「そ・・・そう・・・」"
]
},
{
"id": 17031,
"kind": "msg",
"jp": [
"「部屋の鍵にアルファベットが",
"彫ってあると思うんだけど・・・」"
]
},
{
"id": 17032,
"kind": "msg",
"jp": [
"「暗号でしょ」"
]
},
{
"id": 17033,
"kind": "msg",
"jp": [
"「あ、うん、まあね」"
]
},
{
"id": 17034,
"kind": "msg",
"jp": [
"「える」"
]
},
{
"id": 17035,
"kind": "msg",
"jp": [
"「うちの部屋。",
"『L』て彫ってある」"
]
},
{
"id": 17036,
"kind": "msg",
"jp": [
"「ああ、Lか。",
"ありがとう」"
]
},
{
"id": 17037,
"kind": "msg",
"jp": [
"「がんばれー」"
]
},
{
"id": 17038,
"kind": "msg",
"jp": [
"「静奈ちゃんはもう",
"解いたんだっけ」"
]
},
{
"id": 17039,
"kind": "msg",
"jp": [
"「だから見守ってあげる」"
]
},
{
"id": 17040,
"kind": "msg",
"jp": [
"「あ、ありがとう。",
"頑張ってみる・・・」"
]
},
{
"id": 17041,
"kind": "msg",
"jp": [
"「静奈ちゃんの携帯って",
"どんなの?」"
]
},
{
"id": 17042,
"kind": "msg",
"jp": [
"「まだ大丈夫、と思う」"
]
},
{
"id": 17043,
"kind": "msg",
"jp": [
"「もう2年経つけど",
"まだいける」"
]
},
{
"id": 17044,
"kind": "msg",
"jp": [
"「へえ、長持ちしてるね」"
]
},
{
"id": 17045,
"kind": "msg",
"jp": [
"「時々勝手にマナーモードになったり",
"何度か押さんと反応のないキーが",
"あったりするけど大丈夫」"
]
},
{
"id": 17046,
"kind": "msg",
"jp": [
"「それ、大丈夫なの・・・?」"
]
},
{
"id": 17047,
"kind": "msg",
"jp": [
"「だいじょーぶ。",
"電話は出来る」"
]
},
{
"id": 17048,
"kind": "msg",
"jp": [
"そりゃそうだろうけど。",
"微妙に不便そうだ・・・。"
]
},
{
"id": 17049,
"kind": "msg",
"jp": [
"「静奈ちゃん達は",
"タクシーで来たんだよね」"
]
},
{
"id": 17050,
"kind": "msg",
"jp": [
"「けど、他の人らがタクシーに",
"乗った駅とは違う駅からやと思う」"
]
},
{
"id": 17051,
"kind": "msg",
"jp": [
"「そうなんだ。",
"じゃあ、他の人達に途中で",
"会ったりはしなかったんだ」"
]
},
{
"id": 17052,
"kind": "msg",
"jp": [
"「会うてないよ」"
]
},
{
"id": 17053,
"kind": "msg",
"jp": [
"「明石焼きって好き?」"
]
},
{
"id": 17054,
"kind": "msg",
"jp": [
"「大好物」"
]
},
{
"id": 17055,
"kind": "msg",
"jp": [
"「そ、そんなに?」"
]
},
{
"id": 17056,
"kind": "msg",
"jp": [
"「出汁が好き」"
]
},
{
"id": 17057,
"kind": "msg",
"jp": [
"「・・・ああ、食べたい」"
]
},
{
"id": 17058,
"kind": "msg",
"jp": [
"相当好きらしい・・・。"
]
},
{
"id": 17059,
"kind": "msg",
"jp": [
"「手こねハンバーグ",
"作れる?」"
]
},
{
"id": 17060,
"kind": "msg",
"jp": [
"「食べたい?」"
]
},
{
"id": 17061,
"kind": "msg",
"jp": [
"「え、いや、多分",
"材料がないと・・・って",
"なんで笑うの・・・?」"
]
},
{
"id": 17062,
"kind": "msg",
"jp": [
"「作るんも食べるんも",
"好きなんやけど、",
"鈴が怖がって・・・」"
]
},
{
"id": 17063,
"kind": "msg",
"jp": [
"「こ、怖・・・?」"
]
},
{
"id": 17064,
"kind": "msg",
"jp": [
"「当たり付きにする",
"だけやのに」"
]
},
{
"id": 17065,
"kind": "msg",
"jp": [
"「・・・あの、当たりって",
"もしかしてハンバーグの中に",
"なにか・・・」"
]
},
{
"id": 17066,
"kind": "msg",
"jp": [
"「うふふ」"
]
},
{
"id": 17067,
"kind": "msg",
"jp": [
"何が入ってるんだろう。",
"間違っても当たりとは呼ばないような",
"物が入ってそうな気が・・・。"
]
},
{
"id": 17068,
"kind": "msg",
"jp": [
"「揚げだし豆腐って好き?」"
]
},
{
"id": 17069,
"kind": "msg",
"jp": [
"「熱燗があれば、なおさらに」"
]
},
{
"id": 17070,
"kind": "msg",
"jp": [
"「・・・し、渋いね」"
]
},
{
"id": 17071,
"kind": "msg",
"jp": [
"「日本酒飲みたい・・・」"
]
},
{
"id": 17072,
"kind": "msg",
"jp": [
"「静奈ちゃんは煙草",
"吸わないよね」"
]
},
{
"id": 17073,
"kind": "msg",
"jp": [
"「うん。",
"吸う人は好き」"
]
},
{
"id": 17074,
"kind": "msg",
"jp": [
"「マナーが悪くなければ」"
]
},
{
"id": 17075,
"kind": "msg",
"jp": [
"「暗石のおっちゃんみたいに",
"灰皿のあるとこで吸う人は好き」"
]
},
{
"id": 17076,
"kind": "msg",
"jp": [
"「・・・暗石さんが",
"煙草吸ってるとこは",
"かっこいいよね」"
]
},
{
"id": 17077,
"kind": "msg",
"jp": [
"「うん!」"
]
},
{
"id": 17078,
"kind": "msg",
"jp": [
"ものすごい勢いで",
"同意された・・・。"
]
},
{
"id": 17079,
"kind": "msg",
"jp": [
"「地下室のワインって",
"飲んでみた?」"
]
},
{
"id": 17080,
"kind": "msg",
"jp": [
"「鈴が取ってきてくれた。",
"美味しかった」"
]
},
{
"id": 17081,
"kind": "msg",
"jp": [
"「そっか・・・",
"きつくなかった?」"
]
},
{
"id": 17082,
"kind": "msg",
"jp": [
"「ううん、軽く飲めたよ」"
]
},
{
"id": 17083,
"kind": "msg",
"jp": [
"「・・・お兄さんもしかして",
"ものすご弱いん?」"
]
},
{
"id": 17084,
"kind": "msg",
"jp": [
"「な、なんで笑うの・・?」"
]
},
{
"id": 17085,
"kind": "msg",
"jp": [
"「料理に入れても酔う?」"
]
},
{
"id": 17086,
"kind": "msg",
"jp": [
"「か、勘弁して、",
"おもしろくないから!」"
]
},
{
"id": 17087,
"kind": "msg",
"jp": [
"「すぐ寝ちゃうだけだから!",
"歌ったり踊ったりしないから!」"
]
},
{
"id": 17088,
"kind": "msg",
"jp": [
"「脱いだりも?」"
]
},
{
"id": 17089,
"kind": "msg",
"jp": [
"「しないしないっ!」"
]
},
{
"id": 17090,
"kind": "msg",
"jp": [
"何を企んでたんだ・・・。"
]
},
{
"id": 17091,
"kind": "msg",
"jp": [
"「あのさ・・・",
"脚立って好き・・・?」"
]
},
{
"id": 17092,
"kind": "msg",
"jp": [
"「・・・聞いといて",
"なんで驚くのん」"
]
},
{
"id": 17093,
"kind": "msg",
"jp": [
"「いや・・・その・・・」"
]
},
{
"id": 17094,
"kind": "msg",
"jp": [
"「かわいいやん、脚立」"
]
},
{
"id": 17095,
"kind": "msg",
"jp": [
"「か・・・」"
]
},
{
"id": 17096,
"kind": "msg",
"jp": [
"「万能やし」"
]
},
{
"id": 17097,
"kind": "msg",
"jp": [
"「万能・・・うん、まあ・・・」"
]
},
{
"id": 17098,
"kind": "msg",
"jp": [
"そうか・・・。",
"ものすごく脚立が好きな人って",
"いるもんなんだ・・・。"
]
},
{
"id": 17099,
"kind": "msg",
"jp": [
"「静奈ちゃん、日傘って使う?」"
]
},
{
"id": 17100,
"kind": "msg",
"jp": [
"「・・・たまに、やけど」"
]
},
{
"id": 17101,
"kind": "msg",
"jp": [
"「今は持ってきてる?」"
]
},
{
"id": 17102,
"kind": "msg",
"jp": [
"「あるよ」"
]
},
{
"id": 17103,
"kind": "msg",
"jp": [
"「それって・・・」"
]
},
{
"id": 17104,
"kind": "msg",
"jp": [
"「大丈夫」"
]
},
{
"id": 17105,
"kind": "msg",
"jp": [
"「ピンクの金魚もよう」"
]
},
{
"id": 17106,
"kind": "msg",
"jp": [
"「・・・か、かわいいね」"
]
},
{
"id": 17107,
"kind": "msg",
"jp": [
"「うん。",
"お気に入り」"
]
},
{
"id": 17108,
"kind": "msg",
"jp": [
"「お兄さん探してるん",
"白い傘やろ」"
]
},
{
"id": 17109,
"kind": "msg",
"jp": [
"「うん・・・って、え?",
"気が付いてたのか・・・」"
]
},
{
"id": 17110,
"kind": "msg",
"jp": [
"そう言えば、最初に",
"猫は斑井さんって言い出したのも",
"この子だったもんなあ・・・。"
]
},
{
"id": 17111,
"kind": "msg",
"jp": [
"「静奈ちゃん、台所で",
"ワイングラス見たことある?」"
]
},
{
"id": 17112,
"kind": "msg",
"jp": [
"「地下のワイン飲むとき",
"鈴が探したけどなかったって」"
]
},
{
"id": 17113,
"kind": "msg",
"jp": [
"「そっか、ありがとう」"
]
},
{
"id": 17114,
"kind": "msg",
"jp": [
"「・・・もしかして",
"どっかにあったん」"
]
},
{
"id": 17115,
"kind": "msg",
"jp": [
"「物置の棚の中には",
"1セットあったよ」"
]
},
{
"id": 17116,
"kind": "msg",
"jp": [
"「・・・無罪かな」"
]
},
{
"id": 17117,
"kind": "msg",
"jp": [
"「な、なにが?」"
]
},
{
"id": 17118,
"kind": "msg",
"jp": [
"「ひみつ」"
]
},
{
"id": 17119,
"kind": "msg",
"jp": [
"「あのさ、日織のことなんだけど」"
]
},
{
"id": 17120,
"kind": "msg",
"jp": [
"「着物かっこいい」"
]
},
{
"id": 17121,
"kind": "msg",
"jp": [
"「着流し好き」"
]
},
{
"id": 17122,
"kind": "msg",
"jp": [
"「えーと、じゃあ元から",
"知ってるんだ日織のこと」"
]
},
{
"id": 17123,
"kind": "msg",
"jp": [
"「何回か、仕事してる」"
]
},
{
"id": 17124,
"kind": "msg",
"jp": [
"「初めて会うたとき、",
"呉服屋の若旦那か何かの役かと",
"思ったら{違/ちご}た」"
]
},
{
"id": 17125,
"kind": "msg",
"jp": [
"「だって時代劇の仕事で",
"着流し着てたら衣装やと思うやん」"
]
},
{
"id": 17126,
"kind": "msg",
"jp": [
"「そりゃそうだね・・・。",
"実際は日織は何の役だったの?」"
]
},
{
"id": 17127,
"kind": "msg",
"jp": [
"「御用提灯持って押し寄せてくる",
"南町奉行所の中の人のどれか」"
]
},
{
"id": 17128,
"kind": "msg",
"jp": [
"「・・・静奈ちゃんは?」"
]
},
{
"id": 17129,
"kind": "msg",
"jp": [
"「誘拐されてどっかに売られに行く",
"船に閉じ込められてた町娘の1人」"
]
},
{
"id": 17130,
"kind": "msg",
"jp": [
"「あの、それ・・・",
"お互いに同じ話に出てたこと",
"覚えてるもんなの・・・?」"
]
},
{
"id": 17131,
"kind": "msg",
"jp": [
"「うちは覚えてたよ。",
"次会うたときも着流しやったから",
"すぐわかった」"
]
},
{
"id": 17132,
"kind": "msg",
"jp": [
"印象に残りやすい奴ではあるよな、",
"日織は・・・。"
]
},
{
"id": 17133,
"kind": "msg",
"jp": [
"「あの、斑井さんってさ・・・」"
]
},
{
"id": 17134,
"kind": "msg",
"jp": [
"「いつもああいう人なの?」"
]
},
{
"id": 17135,
"kind": "msg",
"jp": [
"「でも、この前見たドラマの役は",
"上手やった、すごく」"
]
},
{
"id": 17136,
"kind": "msg",
"jp": [
"「へえ? どんな役?」"
]
},
{
"id": 17137,
"kind": "msg",
"jp": [
"「水死体」"
]
},
{
"id": 17138,
"kind": "msg",
"jp": [
"「ほんまよ?」"
]
},
{
"id": 17139,
"kind": "msg",
"jp": [
"なんかリアクションに困る・・・。"
]
},
{
"id": 17140,
"kind": "msg",
"jp": [
"「あのさ、椿くんって・・・」"
]
},
{
"id": 17141,
"kind": "msg",
"jp": [
"「観察中」"
]
},
{
"id": 17142,
"kind": "msg",
"jp": [
"「学生じゃない役、",
"初めて見るのん」"
]
},
{
"id": 17143,
"kind": "msg",
"jp": [
"「あ、そうなんだ」"
]
},
{
"id": 17144,
"kind": "msg",
"jp": [
"「興味ある」"
]
},
{
"id": 17145,
"kind": "msg",
"jp": [
"だから観察中なのか。"
]
},
{
"id": 17146,
"kind": "msg",
"jp": [
"「那須さんって普段は",
"どういう役やってるのかな」"
]
},
{
"id": 17147,
"kind": "msg",
"jp": [
"「お芝居出てんの",
"見たことないから」"
]
},
{
"id": 17148,
"kind": "msg",
"jp": [
"「うん、初めて見た」"
]
},
{
"id": 17149,
"kind": "msg",
"jp": [
"普段から、あんまり役者さんの",
"仕事はしてないのかな・・・。"
]
},
{
"id": 17150,
"kind": "msg",
"jp": [
"「鈴奈ちゃんとは",
"双子なんだよね」"
]
},
{
"id": 17151,
"kind": "msg",
"jp": [
"「うん、うちがお姉ちゃん」"
]
},
{
"id": 17152,
"kind": "msg",
"jp": [
"「そっか。",
"そっくりだね」"
]
},
{
"id": 17153,
"kind": "msg",
"jp": [
"なぜか嬉しそうに笑った。",
"なんでだろう・・・。"
]
},
{
"id": 17154,
"kind": "msg",
"jp": [
"「あのさ、静奈ちゃんって・・・」"
]
},
{
"id": 17155,
"kind": "msg",
"jp": [
"「ふふっ、いややわぁ",
"お兄さんてば」"
]
},
{
"id": 17156,
"kind": "msg",
"jp": [
"「うちのことホンマに",
"お姉ちゃんや思て話してたん?」"
]
},
{
"id": 17157,
"kind": "msg",
"jp": [
"「え、あ、す、鈴奈ちゃん!?」"
]
},
{
"id": 17158,
"kind": "msg",
"jp": [
"「あ・・・・え?」"
]
},
{
"id": 17159,
"kind": "msg",
"jp": [
"「静奈でした」"
]
},
{
"id": 17160,
"kind": "msg",
"jp": [
"やっぱり、よくわからないよ",
"この子・・・。"
]
},
{
"id": 17161,
"kind": "msg",
"jp": [
"「暗石さんってずいぶん",
"ベテランらしいね」"
]
},
{
"id": 17162,
"kind": "msg",
"jp": [
"「渋い」"
]
},
{
"id": 17163,
"kind": "msg",
"jp": [
"「渋いおっちゃん」"
]
},
{
"id": 17164,
"kind": "msg",
"jp": [
"「浪人とか用心棒とか",
"すごい上手いん」"
]
},
{
"id": 17165,
"kind": "msg",
"jp": [
"「で、絶対主役の上様とか",
"お奉行さんに斬られるん」"
]
},
{
"id": 17166,
"kind": "msg",
"jp": [
"「・・・斬ってみたい」"
]
},
{
"id": 17167,
"kind": "msg",
"jp": [
"「袈裟斬りで」"
]
},
{
"id": 17168,
"kind": "msg",
"jp": [
"そういうもんなのか。",
"役者さんって・・・。"
]
},
{
"id": 17169,
"kind": "msg",
"jp": [
"「御陵さんってきれいな人なのに",
"あんまりテレビで見ないね」"
]
},
{
"id": 17170,
"kind": "msg",
"jp": [
"「うん、上手いのに」"
]
},
{
"id": 17171,
"kind": "msg",
"jp": [
"「演技も上手なんだ?」"
]
},
{
"id": 17172,
"kind": "msg",
"jp": [
"「上手いよ。",
"でもテレビほとんど出えへん」"
]
},
{
"id": 17173,
"kind": "msg",
"jp": [
"「・・・舞台が好きなんかも」"
]
},
{
"id": 17174,
"kind": "msg",
"jp": [
"「南雲さんって人・・・",
"来ないね」"
]
},
{
"id": 17175,
"kind": "msg",
"jp": [
"「もう来ててどっかに",
"おったりして」"
]
},
{
"id": 17176,
"kind": "msg",
"jp": [
"「静奈ちゃんっ!?",
"こ、怖いこと言わないで・・・」"
]
},
{
"id": 17177,
"kind": "msg",
"jp": [
"「だって、お兄さんが",
"つまずいた人とちゃうのん」"
]
},
{
"id": 17178,
"kind": "msg",
"jp": [
"「・・・かも、しれないとは",
"思うんだけど・・・」"
]
},
{
"id": 17179,
"kind": "msg",
"jp": [
"「あれっきり見あたらなく",
"なっちゃったし」"
]
},
{
"id": 17180,
"kind": "msg",
"jp": [
"「そやね。",
"どこ行きんさったんやろ」"
]
},
{
"id": 17181,
"kind": "msg",
"jp": [
"「静奈ちゃんはさ、",
"帽子屋ってどんな人だと思う?」"
]
},
{
"id": 17182,
"kind": "msg",
"jp": [
"「・・・変な人」"
]
},
{
"id": 17183,
"kind": "msg",
"jp": [
"「へ、変?」"
]
},
{
"id": 17184,
"kind": "msg",
"jp": [
"「やったらええのに」"
]
},
{
"id": 17185,
"kind": "msg",
"jp": [
"「変な人の方がいいの?」"
]
},
{
"id": 17186,
"kind": "msg",
"jp": [
"「覆面作家やから。",
"中の人が普通やったらがっかり」"
]
},
{
"id": 17187,
"kind": "msg",
"jp": [
"「・・・ああ、そうかも」"
]
},
{
"id": 17188,
"kind": "msg",
"jp": [
"「あ、けどね」"
]
},
{
"id": 17189,
"kind": "msg",
"jp": [
"「うちは帽子屋やないよ」"
]
},
{
"id": 17190,
"kind": "msg",
"jp": [
"それはつまり、自分が変な人に",
"分類されると言う自覚があるのか。"
]
},
{
"id": 17191,
"kind": "msg",
"jp": [
"「多分、同じくらい",
"ミステリマニアやけど」"
]
},
{
"id": 17192,
"kind": "msg",
"jp": [
"「最初の映画の中で、",
"高遠さんの本の有名な場面の",
"パロディが入ってた」"
]
},
{
"id": 17193,
"kind": "msg",
"jp": [
"「しかも相当マニアやないと",
"パロディやって気がつかへん",
"ようなのが」"
]
},
{
"id": 17194,
"kind": "msg",
"jp": [
"「静奈ちゃんは、高遠延二郎さんの",
"ことは知ってる?」"
]
},
{
"id": 17195,
"kind": "msg",
"jp": [
"「うん、好き」"
]
},
{
"id": 17196,
"kind": "msg",
"jp": [
"「静奈って名前の人の",
"出てくるやつは?」"
]
},
{
"id": 17197,
"kind": "msg",
"jp": [
"「『悪魔の花園』?",
"読んだよ」"
]
},
{
"id": 17198,
"kind": "msg",
"jp": [
"「どうせやったら静奈より",
"他にやってみたい役ある」"
]
},
{
"id": 17199,
"kind": "msg",
"jp": [
"「けど難しい」"
]
},
{
"id": 17200,
"kind": "msg",
"jp": [
"「特撮が」"
]
},
{
"id": 17201,
"kind": "msg",
"jp": [
"「特撮!?」"
]
},
{
"id": 17202,
"kind": "msg",
"jp": [
"「トリックが普通に撮影するの",
"多分無理やから」"
]
},
{
"id": 17203,
"kind": "msg",
"jp": [
"「今まで映画化されたんも、",
"トリック変わってた」"
]
},
{
"id": 17204,
"kind": "msg",
"jp": [
"どんなトリックなんだ・・・。"
]
},
{
"id": 17205,
"kind": "msg",
"jp": [
"「あの、ね・・・",
"斑井さんのことなんだけど」"
]
},
{
"id": 17206,
"kind": "msg",
"jp": [
"「だから言うたのに」"
]
},
{
"id": 17207,
"kind": "msg",
"jp": [
"「{猫/・}{は/・}{斑/・}{井/・}{さ/・}{ん/・}って",
"言うたのに」"
]
},
{
"id": 17208,
"kind": "msg",
"jp": [
"そうだった。",
"あの黒猫の置き物の意味を最初に",
"言い当てたのは彼女だった・・・。"
]
},
{
"id": 17209,
"kind": "msg",
"jp": [
"「椿くん、なんだけど」"
]
},
{
"id": 17210,
"kind": "msg",
"jp": [
"「何か、その・・・",
"彼と話したこととかで",
"覚えてることってない?」"
]
},
{
"id": 17211,
"kind": "msg",
"jp": [
"「・・・何か隠してた、気がする」"
]
},
{
"id": 17212,
"kind": "msg",
"jp": [
"「隠してた?」"
]
},
{
"id": 17213,
"kind": "msg",
"jp": [
"「時々、何か言いかけて",
"慌てて言い直してることあったから」"
]
},
{
"id": 17214,
"kind": "msg",
"jp": [
"隠してること・・・。",
"椿くんが隠してたかもしれない",
"ことってなんだろう。"
]
},
{
"id": 17215,
"kind": "msg",
"jp": [
"「あの、那須さんのことで・・・",
"何か覚えてることってある?」"
]
},
{
"id": 17216,
"kind": "msg",
"jp": [
"「・・・鍵」"
]
},
{
"id": 17217,
"kind": "msg",
"jp": [
"「鍵?」"
]
},
{
"id": 17218,
"kind": "msg",
"jp": [
"「那須さん、いっつも部屋に",
"鍵掛けてへんかったみたい」"
]
},
{
"id": 17219,
"kind": "msg",
"jp": [
"「ああ・・・」"
]
},
{
"id": 17220,
"kind": "msg",
"jp": [
"そうだったな。",
"だから、いつの間にか毒なんか・・・。"
]
},
{
"id": 17221,
"kind": "msg",
"jp": [
"「暗石さんのことで・・・」"
]
},
{
"id": 17222,
"kind": "msg",
"jp": [
"「・・・どうやって部屋に",
"入ったんやろう」"
]
},
{
"id": 17223,
"kind": "msg",
"jp": [
"「それ、なんだよね」"
]
},
{
"id": 17224,
"kind": "msg",
"jp": [
"「お兄さんにもわからへんの」"
]
},
{
"id": 17225,
"kind": "msg",
"jp": [
"「うん・・・",
"僕もまだよくわからない」"
]
},
{
"id": 17226,
"kind": "msg",
"jp": [
"「あのさ、井戸の中の・・・」"
]
},
{
"id": 17227,
"kind": "msg",
"jp": [
"「・・・南雲さんかな」"
]
},
{
"id": 17228,
"kind": "msg",
"jp": [
"「静奈ちゃんは、あの人が",
"南雲さんだと思う?」"
]
},
{
"id": 17229,
"kind": "msg",
"jp": [
"「あの人・・・」"
]
},
{
"id": 17230,
"kind": "msg",
"jp": [
"「いつ、井戸に落ちたん?」"
]
},
{
"id": 17231,
"kind": "msg",
"jp": [
"「それが、まだわからないんだよ」"
]
},
{
"id": 17232,
"kind": "msg",
"jp": [
"「・・・自分で落ちたんや",
"ないよね・・・・。",
"落ちただけであんなに顔が・・・」"
]
},
{
"id": 17233,
"kind": "msg",
"jp": [
"「それに・・・",
"井戸の蓋は閉まってたし」"
]
},
{
"id": 17234,
"kind": "msg",
"jp": [
"「・・・そやね。",
"落ちた人が自分で閉められる",
"わけないんや・・・」"
]
},
{
"id": 17235,
"kind": "msg",
"jp": [
"「で、あの・・・",
"静奈ちゃんは南雲さんだと思う?」"
]
},
{
"id": 17236,
"kind": "msg",
"jp": [
"「・・・・・ううん」"
]
},
{
"id": 17237,
"kind": "msg",
"jp": [
"「だって、白蛇どこにも",
"出てきてへんから」"
]
},
{
"id": 17238,
"kind": "msg",
"jp": [
"「白蛇って、南雲さんの",
"出てくる小説?」"
]
},
{
"id": 17239,
"kind": "msg",
"jp": [
"「そう、白蛇殺人事件」"
]
},
{
"id": 17240,
"kind": "msg",
"jp": [
"「井戸とか関係ないし。",
"南雲さんやったら井戸なんかに",
"おらへんと思う」"
]
},
{
"id": 17241,
"kind": "msg",
"jp": [
"「じゃあ、もし南雲さんが殺されると",
"したらどこになるのかな」"
]
},
{
"id": 17242,
"kind": "msg",
"jp": [
"「・・・ほんまやったら、",
"白蛇の奉ってある祠の中で首吊ってる",
"ことになるんやけど・・・」"
]
},
{
"id": 17243,
"kind": "msg",
"jp": [
"「ほ、ほこら?」"
]
},
{
"id": 17244,
"kind": "msg",
"jp": [
"「うん、ほんで首吊り死体の足元に",
"蛇がしゃーって言うてるん。",
"しかも頭の2つある白蛇」"
]
},
{
"id": 17245,
"kind": "msg",
"jp": [
"「そのまんまにしようと思たら",
"けっこう大変やね」"
]
},
{
"id": 17246,
"kind": "msg",
"jp": [
"「四倉欣治さんって人には",
"会ったことある?」"
]
},
{
"id": 17247,
"kind": "msg",
"jp": [
"「どんな人?」"
]
},
{
"id": 17248,
"kind": "msg",
"jp": [
"「オカルト大好きおじさん」"
]
},
{
"id": 17249,
"kind": "msg",
"jp": [
"「幽霊とか呪いとか因縁とか",
"そんなんばっかし載ってる雑誌",
"読んでた」"
]
},
{
"id": 17250,
"kind": "msg",
"jp": [
"「外国のおばけが出るお城とかにも",
"行ったことあるんやって」"
]
},
{
"id": 17251,
"kind": "msg",
"jp": [
"「静奈ちゃん、",
"池内梨奈さんって知ってる?」"
]
},
{
"id": 17252,
"kind": "msg",
"jp": [
"「ニュース見たん?」"
]
},
{
"id": 17253,
"kind": "msg",
"jp": [
"「あ、ううん。",
"書斎に雑誌があってさ・・・」"
]
},
{
"id": 17254,
"kind": "msg",
"jp": [
"「・・・仲良かった」"
]
},
{
"id": 17255,
"kind": "msg",
"jp": [
"「同じ、事務所の子",
"うちも鈴も、仲良かった」"
]
},
{
"id": 17256,
"kind": "msg",
"jp": [
"「うちらのが年上やから",
"せんぱい、て呼んで懐いて",
"くれてたん」"
]
},
{
"id": 17257,
"kind": "msg",
"jp": [
"「会うたらいつも、じっと顔見て",
"うちか鈴か当てますよーって」"
]
},
{
"id": 17258,
"kind": "msg",
"jp": [
"「・・・けど、",
"いっぺんも当たったことなくて",
"いつも今度こそ当てる・・・って」"
]
},
{
"id": 17259,
"kind": "msg",
"jp": [
"「・・・言うてたのに」"
]
},
{
"id": 17260,
"kind": "msg",
"jp": [
"「オーディションの後も",
"落ち込んでたけど・・・」"
]
},
{
"id": 17261,
"kind": "msg",
"jp": [
"「・・・また次のやつ",
"頑張りますよーって、",
"言うてたのに・・・」"
]
},
{
"id": 17262,
"kind": "msg",
"jp": [
"「突然・・・だったの?」"
]
},
{
"id": 17263,
"kind": "msg",
"jp": [
"「優勝したみきちゃん、",
"帽子屋が推薦したらしいって話が",
"事務所で噂になった、後・・・」"
]
},
{
"id": 17264,
"kind": "msg",
"jp": [
"「・・・部屋からふらって",
"出て行ったんやって・・・」"
]
},
{
"id": 17265,
"kind": "msg",
"jp": [
"「すごいショックやった",
"みたいやから、しばらくそっと",
"しとこうって言うてたら・・」"
]
},
{
"id": 17266,
"kind": "msg",
"jp": [
"「・・・・・屋上に」"
]
},
{
"id": 17267,
"kind": "msg",
"jp": [
"「・・・みんな、すぐ追いかければ",
"よかったって・・・泣いてた」"
]
},
{
"id": 17268,
"kind": "msg",
"jp": [
"「お葬式のとき・・・",
"事務所のみんなも梨奈ちゃんの",
"お父さんとお母さんも・・・」"
]
},
{
"id": 17269,
"kind": "msg",
"jp": [
"「みんなして、",
"お互いずっと謝ってたん」"
]
},
{
"id": 17270,
"kind": "msg",
"jp": [
"「・・・誰も悪くないのに」"
]
},
{
"id": 17271,
"kind": "msg",
"jp": [
"「梨奈ちゃんが死んでしもた",
"原因つくった人がはっきり誰か",
"わかってても・・・」"
]
},
{
"id": 17272,
"kind": "msg",
"jp": [
"「・・・その人って、",
"やっぱり罪にはならへんの」"
]
},
{
"id": 17273,
"kind": "msg",
"jp": [
"「それは・・・",
"法律的には難しいんじゃ",
"ないかな・・・」"
]
},
{
"id": 17274,
"kind": "msg",
"jp": [
"「この場合、梨奈さんに",
"殺意があってやった事じゃ",
"ないだろうし」"
]
},
{
"id": 17275,
"kind": "msg",
"jp": [
"「だから、みんな",
"謝るしかなかったんかな」"
]
},
{
"id": 17276,
"kind": "msg",
"jp": [
"「誰かが梨奈ちゃんを",
"死なせようとしたわけやないから",
"『犯人』て{居/お}らんやん」"
]
},
{
"id": 17277,
"kind": "msg",
"jp": [
"「原因になった人は{居/お}るかも",
"しれへんけど・・・」"
]
},
{
"id": 17278,
"kind": "msg",
"jp": [
"「死んでしもたんは、",
"梨奈ちゃん{本/・}{人/・}{が/・}{し/・}{た/・}{こ/・}{と/・}",
"やったから」"
]
},
{
"id": 17279,
"kind": "msg",
"jp": [
"「けど、梨奈ちゃんに",
"なんで死んだんって怒れる人は",
"居らんかった」"
]
},
{
"id": 17280,
"kind": "msg",
"jp": [
"「・・・だって、",
"みんな梨奈ちゃんのこと",
"責めたくないもん」"
]
},
{
"id": 17281,
"kind": "msg",
"jp": [
"「うちもそう。",
"梨奈ちゃんはええ子やったもん、",
"悪くないって思いたかった」"
]
},
{
"id": 17282,
"kind": "msg",
"jp": [
"「・・・そりゃあ・・・」"
]
},
{
"id": 17283,
"kind": "msg",
"jp": [
"「わかってるん。",
"ほんまは、梨奈ちゃんも",
"悪いことしたんは」"
]
},
{
"id": 17284,
"kind": "msg",
"jp": [
"「・・・みんなを泣かしたから」"
]
},
{
"id": 17285,
"kind": "msg",
"jp": [
"「けど・・・あの時はね、",
"みんな泣いてた、あの時は・・・」"
]
},
{
"id": 17286,
"kind": "msg",
"jp": [
"「梨奈ちゃんが悪いって",
"言われんのは・・・",
"どうしても嫌やった」"
]
},
{
"id": 17287,
"kind": "msg",
"jp": [
"「だからみんな謝ってたん。",
"悪いんは梨奈ちゃんやないよって",
"言う代わりに・・・」"
]
},
{
"id": 17288,
"kind": "msg",
"jp": [
"「あれは、みんなして",
"梨奈ちゃんのこと自分の中で",
"かばってたんやと思う」"
]
},
{
"id": 17289,
"kind": "msg",
"jp": [
"「梨奈ちゃんを責めるより",
"自分を責める方が、",
"まだ辛くなかったから」"
]
},
{
"id": 17290,
"kind": "msg",
"jp": [
"「いい子だったんだね、",
"梨奈さんは・・・」"
]
},
{
"id": 17291,
"kind": "msg",
"jp": [
"「みんながかばいたく",
"なるような人だったんだ」"
]
},
{
"id": 17292,
"kind": "msg",
"jp": [
"「・・・泣かした?」"
]
},
{
"id": 17293,
"kind": "msg",
"jp": [
"「ごめんね、",
"重たい話聞かせて」"
]
},
{
"id": 17294,
"kind": "msg",
"jp": [
"「え、いや、聞いたのは",
"僕の方だし・・・っていうか",
"泣いてないから」"
]
},
{
"id": 17295,
"kind": "msg",
"jp": [
"「泣き顔やったよ」"
]
},
{
"id": 17296,
"kind": "msg",
"jp": [
"「泣いてないってば!」"
]
},
{
"id": 17297,
"kind": "msg",
"jp": [
"「・・・そういうことに",
"しといてあげる」"
]
},
{
"id": 17298,
"kind": "msg",
"jp": [
"（全然信じてないな・・・）"
]
},
{
"id": 17299,
"kind": "msg",
"jp": [
"「あのさ、里江みどりさんって",
"知ってる?」"
]
},
{
"id": 17300,
"kind": "msg",
"jp": [
"「思い出した」"
]
},
{
"id": 17301,
"kind": "msg",
"jp": [
"「里江みどりって、",
"お父さんが写真集持ってるん。",
"内緒やけど」"
]
},
{
"id": 17302,
"kind": "msg",
"jp": [
"「・・・御陵さんが」"
]
},
{
"id": 17303,
"kind": "msg",
"jp": [
"「誰かに似てると思てたん。",
"あの写真集の見開きの",
"ページに載ってる写真や」"
]
},
{
"id": 17304,
"kind": "msg",
"jp": [
"「どんな写真?」"
]
},
{
"id": 17305,
"kind": "msg",
"jp": [
"「晴れ着姿で羽子板持ってる」"
]
},
{
"id": 17306,
"kind": "msg",
"jp": [
"「お正月の写真なんだ」"
]
},
{
"id": 17307,
"kind": "msg",
"jp": [
"「ひまわり畑で」"
]
},
{
"id": 17308,
"kind": "msg",
"jp": [
"「わからへん。",
"どういう意図なんか謎やから",
"すごいはっきり覚えてるん」"
]
},
{
"id": 17309,
"kind": "msg",
"jp": [
"「・・・まあ、",
"なんか妙に印象に残りそうな",
"写真だよね・・・」"
]
},
{
"id": 17310,
"kind": "msg",
"jp": [
"「今の御陵さんの髪型、",
"あの写真と同じアップに",
"結ってるからそっくり」"
]
},
{
"id": 17311,
"kind": "msg",
"jp": [
"「・・・けどあれ、",
"本人な気がする・・・」"
]
},
{
"id": 17312,
"kind": "msg",
"jp": [
"「本人って・・・」"
]
},
{
"id": 17313,
"kind": "msg",
"jp": [
"「若い頃の御陵さん",
"かなぁって」"
]
},
{
"id": 17314,
"kind": "msg",
"jp": [
"「そんな話聞いたことないから",
"ほんまにそうでも内緒にしてるん",
"やろうけど」"
]
},
{
"id": 17315,
"kind": "msg",
"jp": [
"「御陵さんって昔アイドル",
"だったんだって」"
]
},
{
"id": 17316,
"kind": "msg",
"jp": [
"「えっ?",
"知ってたの?」"
]
},
{
"id": 17317,
"kind": "msg",
"jp": [
"「ううん、昔のアイドルで",
"似てる人が・・・」"
]
},
{
"id": 17318,
"kind": "msg",
"jp": [
"「・・・そう言えば",
"書斎にあった",
"古い雑誌にも・・・」"
]
},
{
"id": 17319,
"kind": "msg",
"jp": [
"「ど、どうしたの?」"
]
},
{
"id": 17320,
"kind": "msg",
"jp": [
"「・・・ここの館の",
"持ち主の人ってものすごい",
"趣味広いなと思って」"
]
},
{
"id": 17321,
"kind": "msg",
"jp": [
"「確かにそうだね・・・」"
]
},
{
"id": 17322,
"kind": "msg",
"jp": [
"「静奈ちゃんさ、",
"ルロイ伯爵って知ってる?」"
]
},
{
"id": 17323,
"kind": "msg",
"jp": [
"「あ、あの、そのめちゃくちゃ",
"嬉しそうな笑顔は・・・」"
]
},
{
"id": 17324,
"kind": "msg",
"jp": [
"「あのね、ルロイ伯爵はね",
"昔の中欧貴族の人でね」"
]
},
{
"id": 17325,
"kind": "msg",
"jp": [
"「・・・黒魔術師やってん」"
]
},
{
"id": 17326,
"kind": "msg",
"jp": [
"「黒・・・魔術って・・・」"
]
},
{
"id": 17327,
"kind": "msg",
"jp": [
"「悪魔召喚しようとしてたん」"
]
},
{
"id": 17328,
"kind": "msg",
"jp": [
"「領地から美少年ばっかし",
"さらってきて儀式の生け贄に",
"しててね・・・」"
]
},
{
"id": 17329,
"kind": "msg",
"jp": [
"「ちょ、ちょっと待って!",
"なんか怖い話になってない!?」"
]
},
{
"id": 17330,
"kind": "msg",
"jp": [
"「血ぃ抜いて魔法陣とか",
"書いてたんやって」"
]
},
{
"id": 17331,
"kind": "msg",
"jp": [
"「でね、最後は奥さんまで",
"生け贄に捧げようとしたん",
"やけど・・・」"
]
},
{
"id": 17332,
"kind": "msg",
"jp": [
"「わかった、もういい!",
"もうやめてー!」"
]
},
{
"id": 17333,
"kind": "msg",
"jp": [
"「旅の修道士にやっつけられて",
"死んでもうたんやって」"
]
},
{
"id": 17334,
"kind": "msg",
"jp": [
"「・・・あ。",
"よ、よかった・・・負けたんだ」"
]
},
{
"id": 17335,
"kind": "msg",
"jp": [
"「・・・けど、断末魔に吐いた",
"呪いの言葉のせいで伯爵の一族は",
"みんな変死したらしいよ・・・」"
]
},
{
"id": 17336,
"kind": "msg",
"jp": [
"「み、みんな・・・",
"て、ことはもう、その人の子孫",
"とかはいないんだ、よね・・・?」"
]
},
{
"id": 17337,
"kind": "msg",
"jp": [
"「さあ!?」"
]
},
{
"id": 17338,
"kind": "msg",
"jp": [
"「子孫は知らんけど、",
"伯爵はなんか呪いの儀式したら",
"蘇るとかって言い伝えが」"
]
},
{
"id": 17339,
"kind": "msg",
"jp": [
"「蘇らなくていいーっ!!",
"も、もうやめて、お願い・・・」"
]
},
{
"id": 17340,
"kind": "msg",
"jp": [
"聞くんじゃなかった・・・。"
]
},
{
"id": 17341,
"kind": "msg",
"jp": [
"「北速水涼介って知ってる?」"
]
},
{
"id": 17342,
"kind": "msg",
"jp": [
"「好みのタイプ」"
]
},
{
"id": 17343,
"kind": "msg",
"jp": [
"「そ、そうなの!?」"
]
},
{
"id": 17344,
"kind": "msg",
"jp": [
"「へえ・・・",
"どんなところが?」"
]
},
{
"id": 17345,
"kind": "msg",
"jp": [
"「猫の集会に混じってみたいからって",
"公園で三日くらい野宿してたとこ」"
]
},
{
"id": 17346,
"kind": "msg",
"jp": [
"あまり、その辺にはいそうにない",
"タイプだな・・・。"
]
},
{
"id": 17347,
"kind": "msg",
"jp": [
"「日織諒って知ってる?",
"こっちの日織じゃなくて、",
"高遠さんの本に出てくるほう」"
]
},
{
"id": 17348,
"kind": "msg",
"jp": [
"「ワトスンさん?」"
]
},
{
"id": 17349,
"kind": "msg",
"jp": [
"「かわいい」"
]
},
{
"id": 17350,
"kind": "msg",
"jp": [
"「あの日織さんはかわいい。",
"・・・うちも欲しい」"
]
},
{
"id": 17351,
"kind": "msg",
"jp": [
"欲しいってなんだ・・・?"
]
},
{
"id": 17352,
"kind": "msg",
"jp": [
"「陣野警部知ってる?",
"涼介シリーズに出てくる人」"
]
},
{
"id": 17353,
"kind": "msg",
"jp": [
"「・・・かっこいい」"
]
},
{
"id": 17354,
"kind": "msg",
"jp": [
"「好きなんだ?」"
]
},
{
"id": 17355,
"kind": "msg",
"jp": [
"「あんなお父さん欲しい」"
]
},
{
"id": 17356,
"kind": "msg",
"jp": [
"「そうなの?",
"静奈ちゃんのお父さんって・・・」"
]
},
{
"id": 17357,
"kind": "msg",
"jp": [
"「もうちょっと",
"年取ったら似てくるかも」"
]
},
{
"id": 17358,
"kind": "msg",
"jp": [
"「期待期待」"
]
},
{
"id": 17359,
"kind": "msg",
"jp": [
"「えっと、波積駿二って人",
"覚えてる?」"
]
},
{
"id": 17360,
"kind": "msg",
"jp": [
"「・・・そう言えば、",
"あれにも黒猫出てくる」"
]
},
{
"id": 17361,
"kind": "msg",
"jp": [
"「なんで『黒猫の毒』の方",
"{使/つこ}たんやろう」"
]
},
{
"id": 17362,
"kind": "msg",
"jp": [
"「・・・そうだね。",
"なんでだろう」"
]
},
{
"id": 17363,
"kind": "msg",
"jp": [
"なんか『黒猫の毒』の方が",
"都合がいいことでもあるんだろうか。"
]
},
{
"id": 17364,
"kind": "msg",
"jp": [
"「高遠さんの本に出てくる方の",
"斑井さんって覚えてる?」"
]
},
{
"id": 17365,
"kind": "msg",
"jp": [
"「うん。",
"猫にたたられた人」"
]
},
{
"id": 17366,
"kind": "msg",
"jp": [
"「た・・・たたられたんだ」"
]
},
{
"id": 17367,
"kind": "msg",
"jp": [
"「読んだらわかるよ。",
"おもしろいから読んで」"
]
},
{
"id": 17368,
"kind": "msg",
"jp": [
"「高遠延二郎の本にさ、",
"黒園龍哉って人が出てくる",
"話があるんだけど・・・」"
]
},
{
"id": 17369,
"kind": "msg",
"jp": [
"「・・・『灰色の仮面』」"
]
},
{
"id": 17370,
"kind": "msg",
"jp": [
"「あ、そうそう、それ」"
]
},
{
"id": 17371,
"kind": "msg",
"jp": [
"「うちやったら、あの本使う」"
]
},
{
"id": 17372,
"kind": "msg",
"jp": [
"「小道具多いから。",
"見立てに使いやすいと思う」"
]
},
{
"id": 17373,
"kind": "msg",
"jp": [
"なんで使わなかったのかな。",
"なんか理由があるんだろうか。"
]
},
{
"id": 17374,
"kind": "msg",
"jp": [
"「えーっと、古折みづえって",
"いう人が出てくる・・・」"
]
},
{
"id": 17375,
"kind": "msg",
"jp": [
"「『古折家の悪夢』」"
]
},
{
"id": 17376,
"kind": "msg",
"jp": [
"「あ、そうだっけ」"
]
},
{
"id": 17377,
"kind": "msg",
"jp": [
"「・・・うん。",
"悲しい話」"
]
},
{
"id": 17378,
"kind": "msg",
"jp": [
"「みづえさん、涼介のこと",
"好きやったみたいなん」"
]
},
{
"id": 17379,
"kind": "msg",
"jp": [
"「・・・可哀想な人」"
]
},
{
"id": 17380,
"kind": "msg",
"jp": [
"「ええと、『鬼の密室』って",
"話に出でてくる佐伯さんていう",
"おじいさんさ・・・」"
]
},
{
"id": 17381,
"kind": "msg",
"jp": [
"「ああ、あのおじいちゃん好き」"
]
},
{
"id": 17382,
"kind": "msg",
"jp": [
"「・・・悪い人やったけど」"
]
},
{
"id": 17383,
"kind": "msg",
"jp": [
"「悪い人なんだ」"
]
},
{
"id": 17384,
"kind": "msg",
"jp": [
"「うん。",
"すっごい恨まれてたん」"
]
},
{
"id": 17385,
"kind": "msg",
"jp": [
"「あの、『死神の鎌』って",
"話に出てくる暁生って人さ」"
]
},
{
"id": 17386,
"kind": "msg",
"jp": [
"「・・・死神につかれてた人?」"
]
},
{
"id": 17387,
"kind": "msg",
"jp": [
"「つかれてるの・・・?」"
]
},
{
"id": 17388,
"kind": "msg",
"jp": [
"「・・・うふ」"
]
},
{
"id": 17389,
"kind": "msg",
"jp": [
"「あ、あのっ!",
"怖い話になるんだったら・・・」"
]
},
{
"id": 17390,
"kind": "msg",
"jp": [
"「じゃあ読んで」"
]
},
{
"id": 17391,
"kind": "msg",
"jp": [
"「『名も無き悪魔』って話に",
"出てくる滝重とかいう人さあ」"
]
},
{
"id": 17392,
"kind": "msg",
"jp": [
"「・・・滝重・・・」"
]
},
{
"id": 17393,
"kind": "msg",
"jp": [
"「覚えてない?」"
]
},
{
"id": 17394,
"kind": "msg",
"jp": [
"「・・・見張られてた人?」"
]
},
{
"id": 17395,
"kind": "msg",
"jp": [
"「うん、そう。",
"なんかそんな依頼してくる人」"
]
},
{
"id": 17396,
"kind": "msg",
"jp": [
"「あ、思い出した。",
"涼介がむっちゃ喜んでた話や」"
]
},
{
"id": 17397,
"kind": "msg",
"jp": [
"「なんで喜んでたの?」"
]
},
{
"id": 17398,
"kind": "msg",
"jp": [
"「日織くんがいつも通り",
"不幸やったから」"
]
},
{
"id": 17399,
"kind": "msg",
"jp": [
"・・・その解釈は正しいんだろうか。",
"なんか微妙に歪んでる気が・・・。"
]
},
{
"id": 17400,
"kind": "msg",
"jp": [
"「ええと、小此木っていう",
"古物商の人が出てくる話でさ・・・」"
]
},
{
"id": 17401,
"kind": "msg",
"jp": [
"「・・・な、なに?」"
]
},
{
"id": 17402,
"kind": "msg",
"jp": [
"「読んでみて」"
]
},
{
"id": 17403,
"kind": "msg",
"jp": [
"「え? その話?」"
]
},
{
"id": 17404,
"kind": "msg",
"jp": [
"「うん。",
"『壺の中の謎』」"
]
},
{
"id": 17405,
"kind": "msg",
"jp": [
"「おもしろいから。",
"ぜひ読んで」"
]
},
{
"id": 17406,
"kind": "msg",
"jp": [
"「・・・なんか、妙に熱心に",
"薦めるけど・・・」"
]
},
{
"id": 17407,
"kind": "msg",
"jp": [
"「うふ」"
]
},
{
"id": 17408,
"kind": "msg",
"jp": [
"・・・なんか嫌な予感がする。"
]
},
{
"id": 17409,
"kind": "msg",
"jp": [
"「『湖畔の館』に出てくる方の",
"那須さんは信っていうんだよね」"
]
},
{
"id": 17410,
"kind": "msg",
"jp": [
"「あっちの那須さんは",
"細い人やった」"
]
},
{
"id": 17411,
"kind": "msg",
"jp": [
"「うん、まあ・・・",
"こっちの那須さんに比べたら",
"大抵の人は細いよね・・・」"
]
},
{
"id": 17412,
"kind": "msg",
"jp": [
"「お兄さん二人ぶんくらい",
"ありそうやもんね」"
]
},
{
"id": 17413,
"kind": "msg",
"jp": [
"二人分で足りるんだろうか・・・。"
]
},
{
"id": 17414,
"kind": "msg",
"jp": [
"「『忘れじの島』に出てくる",
"ともえっていう人って・・・」"
]
},
{
"id": 17415,
"kind": "msg",
"jp": [
"「・・・やりたい」"
]
},
{
"id": 17416,
"kind": "msg",
"jp": [
"「ともえ役。",
"やってみたい」"
]
},
{
"id": 17417,
"kind": "msg",
"jp": [
"「ゆらーり、やねんて」"
]
},
{
"id": 17418,
"kind": "msg",
"jp": [
"「ゆら・・・な、なにそれ?」"
]
},
{
"id": 17419,
"kind": "msg",
"jp": [
"「この世のものではないような",
"ゆらぁりとした存在感って",
"本に書いてあるん」"
]
},
{
"id": 17420,
"kind": "msg",
"jp": [
"「ゆらーり」"
]
},
{
"id": 17421,
"kind": "msg",
"jp": [
"「・・・なんか難しそうだね」"
]
},
{
"id": 17422,
"kind": "msg",
"jp": [
"「ゆらーり。",
"どんなんかなぁ・・・」"
]
},
{
"id": 17423,
"kind": "msg",
"jp": [
"よっぽど気に入ってるらしい・・。"
]
},
{
"id": 17424,
"kind": "msg",
"jp": [
"「高遠さんの本に出てくる",
"御陵さんってさ・・・」"
]
},
{
"id": 17425,
"kind": "msg",
"jp": [
"「・・・あぁ、あの人。",
"こっちの御陵さんにちょっと似てる」"
]
},
{
"id": 17426,
"kind": "msg",
"jp": [
"「うん、多分ここにおる",
"全員のなかで一番近い」"
]
},
{
"id": 17427,
"kind": "msg",
"jp": [
"「『忌まわしい花』に出てくる",
"暗石丈治って人なんだけどね」"
]
},
{
"id": 17428,
"kind": "msg",
"jp": [
"「・・・・なんでやろ」"
]
},
{
"id": 17429,
"kind": "msg",
"jp": [
"「あの話、他のに比べて",
"けっこうマイナーなん」"
]
},
{
"id": 17430,
"kind": "msg",
"jp": [
"「なんであれ選んだんかな。",
"他の作品じゃなくて」"
]
},
{
"id": 17431,
"kind": "msg",
"jp": [
"「・・・なんでだろうね」"
]
},
{
"id": 17432,
"kind": "msg",
"jp": [
"選んだのは犯人だろうから、",
"何か理由があるのかなあ・・・。"
]
},
{
"id": 17433,
"kind": "msg",
"jp": [
"「ええと、絹田ユリって人",
"覚えてる?」"
]
},
{
"id": 17434,
"kind": "msg",
"jp": [
"「行方不明になった女優さん」"
]
},
{
"id": 17435,
"kind": "msg",
"jp": [
"「『花魁はなぜ殺される』に",
"出てくる人でしょ」"
]
},
{
"id": 17436,
"kind": "msg",
"jp": [
"「うん、そう。",
"よく覚えてるね」"
]
},
{
"id": 17437,
"kind": "msg",
"jp": [
"「あの話好き」"
]
},
{
"id": 17438,
"kind": "msg",
"jp": [
"「・・・けど、女優さんやけど",
"今回の話には関係ないみたいやね」"
]
},
{
"id": 17439,
"kind": "msg",
"jp": [
"そういう基準で役名を選んでる",
"わけではないんだろうな・・・。"
]
},
{
"id": 17440,
"kind": "msg",
"jp": [
"「『鐘楼館の殺人』に出てくる",
"椿って人はさ・・・」"
]
},
{
"id": 17441,
"kind": "msg",
"jp": [
"「・・・あっちの椿さんは",
"執事やなかったと思う」"
]
},
{
"id": 17442,
"kind": "msg",
"jp": [
"「うん、当主って書いてあったんだけど",
"今回の脚本には当主って出てきてないん",
"だったっけ?」"
]
}
]