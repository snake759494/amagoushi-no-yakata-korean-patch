[
{
"id": 27683,
"kind": "msg",
"jp": [
"「どちらの部屋にもベランダを通って",
"出入り出来る御陵さんだけなんです」"
]
},
{
"id": 27684,
"kind": "msg",
"jp": [
"「あなたは・・・",
"とんだ招かれざる客ね」"
]
},
{
"id": 27685,
"kind": "msg",
"jp": [
"「あなたの言う通りよ。",
"犯人は、私です」"
]
},
{
"id": 27686,
"kind": "msg",
"jp": [
"なぜか、言葉が出なかった。",
"その結論に辿り着いたのは僕なのに、",
"ついさっき、そう指摘したのに。"
]
},
{
"id": 27687,
"kind": "msg",
"jp": [
"御陵さんの口からそうだ、と",
"言われた途端、ひどく悲しくて",
"信じられない気持ちになった・・・。"
]
},
{
"id": 27688,
"kind": "msg",
"jp": [
"「あなたさえ・・・",
"あなたさえ来なければ・・・」"
]
},
{
"id": 27689,
"kind": "msg",
"jp": [
"「・・・・・・え」"
]
},
{
"id": 27690,
"kind": "msg",
"jp": [
"「あなたさえ来なければ、",
"全部上手く行ってたのに・・・」"
]
},
{
"id": 27691,
"kind": "msg",
"jp": [
"すう、と細くて白い手が",
"伸びてくる。"
]
},
{
"id": 27692,
"kind": "msg",
"jp": [
"「やっ・・・嫌ですっ!!」"
]
},
{
"id": 27693,
"kind": "msg",
"jp": [
"「は?",
"あの、どうしてその",
"場所が・・・?」"
]
},
{
"id": 27694,
"kind": "msg",
"jp": [
"「何をおっしゃってますの?",
"わけがわかりませんけれど」"
]
},
{
"id": 27695,
"kind": "msg",
"jp": [
"「えっ? あれ・・・」"
]
},
{
"id": 27696,
"kind": "msg",
"jp": [
"「あ、あの、すみません!",
"えっと・・・・」"
]
},
{
"id": 27697,
"kind": "msg",
"jp": [
"自分が何を言おうとしていたのか",
"わからなくなってきた。"
]
},
{
"id": 27698,
"kind": "msg",
"jp": [
"「・・・それが・・・?」"
]
},
{
"id": 27699,
"kind": "msg",
"jp": [
"「何か証拠になるような品が",
"あったのではありませんの?」"
]
},
{
"id": 27700,
"kind": "msg",
"jp": [
"「証拠・・・っていうか、",
"これは、その・・・」"
]
},
{
"id": 27701,
"kind": "msg",
"jp": [
"おかしいな、なんで間違えたんだろう。",
"動揺して焦る僕を見て、御陵さんは",
"呆れたように溜息を吐く。"
]
},
{
"id": 27702,
"kind": "msg",
"jp": [
"「・・・一柳さん。",
"もうやめて下さらない?」"
]
},
{
"id": 27703,
"kind": "msg",
"jp": [
"「あなたは恐怖のあまり自分の",
"考えた答えが正しいと思い込みたい",
"だけだとしか思えませんわ」"
]
},
{
"id": 27704,
"kind": "msg",
"jp": [
"「そんな、僕は・・・」"
]
},
{
"id": 27705,
"kind": "msg",
"jp": [
"「だってそうでしょう?",
"証拠になっていないものまで",
"持ち出してくるなんて・・・」"
]
},
{
"id": 27706,
"kind": "msg",
"jp": [
"「・・・は?",
"あの、その時間帯の動きは、",
"というお話でしたわよね?」"
]
},
{
"id": 27707,
"kind": "msg",
"jp": [
"「じゃあ・・・",
"それは何の証拠になりますの?」"
]
},
{
"id": 27708,
"kind": "msg",
"jp": [
"不安になって、もう一度自分で",
"出したものを見直してみる。"
]
},
{
"id": 27709,
"kind": "msg",
"jp": [
"（あれ・・なんで・・・?）"
]
},
{
"id": 27710,
"kind": "msg",
"jp": [
"「変でしょう?」"
]
},
{
"id": 27711,
"kind": "msg",
"jp": [
"何も言い返せなくて、口ごもる。"
]
},
{
"id": 27712,
"kind": "msg",
"jp": [
"「何をおっしゃってるのかしら。",
"意味がわかりませんけれど・・・」"
]
},
{
"id": 27713,
"kind": "msg",
"jp": [
"「え、あの・・・だから・・・」"
]
},
{
"id": 27714,
"kind": "msg",
"jp": [
"あれ・・・?",
"自分でもなんだかおかしいような",
"気がしてきた。"
]
},
{
"id": 27715,
"kind": "msg",
"jp": [
"「変でしょう?",
"筋が通っていませんわ」"
]
},
{
"id": 27716,
"kind": "msg",
"jp": [
"言い返せなかった・・・。"
]
},
{
"id": 27717,
"kind": "msg",
"jp": [
"「ね、もうやめましょう。",
"こんなお話・・・私も少し疲れました」"
]
},
{
"id": 27718,
"kind": "msg",
"jp": [
"「何も聞かなかった事にします。",
"ですから、お引き取りになって」"
]
},
{
"id": 27719,
"kind": "msg",
"jp": [
"「もう、お話しすることはありません。",
"お部屋にお戻り下さい」"
]
},
{
"id": 27720,
"kind": "msg",
"jp": [
"「・・・すみません・・・」"
]
},
{
"id": 27721,
"kind": "msg",
"jp": [
"御陵さんは僕に背を向けて",
"拒絶の意思を示す。"
]
},
{
"id": 27722,
"kind": "msg",
"jp": [
"どうしようもなくなり、",
"僕は頭を下げて部屋を出た・・・。"
]
},
{
"id": 27723,
"kind": "msg",
"jp": [
"じっくり考えたつもりだったのに。",
"なんでこんなことに・・・。"
]
},
{
"id": 27724,
"kind": "choice",
"jp": [
"はい!"
]
},
{
"id": 27725,
"kind": "choice",
"jp": [
"いいえ・・・"
]
},
