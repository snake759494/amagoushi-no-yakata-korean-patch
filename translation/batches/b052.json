[
{
"id": 25765,
"kind": "msg",
"jp": [
"「あ、いた! 和っ!!」"
]
},
{
"id": 25766,
"kind": "msg",
"jp": [
"「よぉ、生きてたか」"
]
},
{
"id": 25767,
"kind": "msg",
"jp": [
"「椿くん! 暗石さんも!」"
]
},
{
"id": 25768,
"kind": "msg",
"jp": [
"「・・・助かった。",
"この人数ならなんとか",
"なるんじゃねえですかい」"
]
},
{
"id": 25769,
"kind": "msg",
"jp": [
"「おーい!",
"二人とも無事かい!?」"
]
},
{
"id": 25770,
"kind": "msg",
"jp": [
"「那須さんっ!」"
]
},
{
"id": 25771,
"kind": "msg",
"jp": [
"「おい、坊主こりゃ何の騒ぎだ?",
"地震じゃねえだろ、この揺れ」"
]
},
{
"id": 25772,
"kind": "msg",
"jp": [
"「暗石さんも・・・",
"これなら、なんとか間に合う",
"かもしれませんぜ」"
]
},
{
"id": 25773,
"kind": "msg",
"jp": [
"「あー、いたぜ!」"
]
},
{
"id": 25774,
"kind": "msg",
"jp": [
"「やあ、よかった!",
"二人とも無事だったかい?」"
]
},
{
"id": 25775,
"kind": "msg",
"jp": [
"「椿くん、那須さん!」"
]
},
{
"id": 25776,
"kind": "msg",
"jp": [
"「引きこもりも",
"引っ張り出して来たぜ」"
]
},
{
"id": 25777,
"kind": "msg",
"jp": [
"「うるせえな、この騒ぎじゃ",
"こもってる方がやべえだろうが」"
]
},
{
"id": 25778,
"kind": "msg",
"jp": [
"「こりゃ助かった。",
"全員でかかりゃなんとかなるかも",
"しれませんぜ、{和/なご}さん」"
]
},
{
"id": 25779,
"kind": "msg",
"jp": [
"「なにが!?",
"なんとかって何のこと!?」"
]
},
{
"id": 25780,
"kind": "msg",
"jp": [
"「・・・揺れる、ゆれ、あ」"
]
},
{
"id": 25781,
"kind": "msg",
"jp": [
"「うわっ、静奈ちゃん!?」"
]
},
{
"id": 25782,
"kind": "msg",
"jp": [
"「お、お姉ちゃんっ!?",
"さっきからこけすぎやで!」"
]
},
{
"id": 25783,
"kind": "msg",
"jp": [
"「だって、揺れる・・・」"
]
},
{
"id": 25784,
"kind": "msg",
"jp": [
"「ほら、もう・・・捕まって」"
]
},
{
"id": 25785,
"kind": "msg",
"jp": [
"「で、どうすんの?",
"なんか崩れそうやん、逃げへんの?」"
]
},
{
"id": 25786,
"kind": "msg",
"jp": [
"「まだ崩れないように",
"止める方法がありそうなんだよ」"
]
},
{
"id": 25787,
"kind": "msg",
"jp": [
"「ほんま?」"
]
},
{
"id": 25788,
"kind": "msg",
"jp": [
"「ええ、ですが・・・",
"お二人は先に外へ逃げて下さい」"
]
},
{
"id": 25789,
"kind": "msg",
"jp": [
"「はぁ!? なんで!?」"
]
},
{
"id": 25790,
"kind": "msg",
"jp": [
"「だって、危ないよ?」"
]
},
{
"id": 25791,
"kind": "msg",
"jp": [
"「・・・みんな危ないやん」"
]
},
{
"id": 25792,
"kind": "msg",
"jp": [
"「でも、女の子だし。",
"それに、僕らが失敗したら・・・」"
]
},
{
"id": 25793,
"kind": "msg",
"jp": [
"「・・・何が起こったのか誰にも",
"わからないままになっちゃうし」"
]
},
{
"id": 25794,
"kind": "msg",
"jp": [
"「それって・・・",
"何が起こったかわかってんのん」"
]
},
{
"id": 25795,
"kind": "msg",
"jp": [
"「犯人は、御陵さんだった」"
]
},
{
"id": 25796,
"kind": "msg",
"jp": [
"「もし、僕らが失敗したら",
"誰か救助の人が来たら言って」"
]
},
{
"id": 25797,
"kind": "msg",
"jp": [
"「・・・御陵さん、どこなん」"
]
},
{
"id": 25798,
"kind": "msg",
"jp": [
"「地下室・・・」"
]
},
{
"id": 25799,
"kind": "msg",
"jp": [
"「なんとか館が崩れるの阻止して、",
"つれて逃げるから、二人は先に行って」"
]
},
{
"id": 25800,
"kind": "msg",
"jp": [
"「え、でも・・・!",
"崩れるの止めるって、それ、",
"人数おった方がええんとちゃうの?」"
]
},
{
"id": 25801,
"kind": "msg",
"jp": [
"「俺らは、これだけいりゃ",
"なんとかなりますって」"
]
},
{
"id": 25802,
"kind": "msg",
"jp": [
"「お二人さんは最後の保険",
"なんですから、先行って下さい」"
]
},
{
"id": 25803,
"kind": "msg",
"jp": [
"「・・・行くよ、鈴」"
]
},
{
"id": 25804,
"kind": "msg",
"jp": [
"「でも・・・!」"
]
},
{
"id": 25805,
"kind": "msg",
"jp": [
"「うち鈍いもん。",
"こない揺れてたら役に立たれへん」"
]
},
{
"id": 25806,
"kind": "msg",
"jp": [
"「・・・ほな、",
"お姉ちゃんだけ先に・・・」"
]
},
{
"id": 25807,
"kind": "msg",
"jp": [
"「そんな歩くだけで大変そうな人",
"1人で行かせねえで下さいよ」"
]
},
{
"id": 25808,
"kind": "msg",
"jp": [
"「約束して、絶対出てくるって」"
]
},
{
"id": 25809,
"kind": "msg",
"jp": [
"「・・・うん。",
"すぐ行くから先に行ってて」"
]
},
{
"id": 25810,
"kind": "msg",
"jp": [
"「ほら」"
]
},
{
"id": 25811,
"kind": "msg",
"jp": [
"「・・・もう・・・!",
"ええよ、わかったよ!!」"
]
},
{
"id": 25812,
"kind": "msg",
"jp": [
"「行くよ、お姉ちゃん!」"
]
},
{
"id": 25813,
"kind": "msg",
"jp": [
"「・・・待って、揺れる」"
]
},
{
"id": 25814,
"kind": "msg",
"jp": [
"（よかった・・・）"
]
},
{
"id": 25815,
"kind": "msg",
"jp": [
"（これでもし、僕らが失敗しても",
"間違った人が疑われたままになる",
"ことだけはない・・・）"
]
},
{
"id": 25816,
"kind": "msg",
"jp": [
"「あ・・・そうだ、",
"鈴奈ちゃんは!?」"
]
},
{
"id": 25817,
"kind": "msg",
"jp": [
"「・・・一応、電話してみますか」"
]
},
{
"id": 25818,
"kind": "msg",
"jp": [
"日織は急いでホールの壁際にある",
"内線電話に飛びついた。"
]
},
{
"id": 25819,
"kind": "msg",
"jp": [
"「・・・・どう?」"
]
},
{
"id": 25820,
"kind": "msg",
"jp": [
"「・・・応答ないですね」"
]
},
{
"id": 25821,
"kind": "msg",
"jp": [
"「部屋にいるのかな・・・」"
]
},
{
"id": 25822,
"kind": "msg",
"jp": [
"「もう出てるなら、ここに",
"降りてくるでしょうが・・・」"
]
},
{
"id": 25823,
"kind": "msg",
"jp": [
"やっぱり、静奈ちゃんの側を",
"離れないのか・・・。"
]
},
{
"id": 25824,
"kind": "msg",
"jp": [
"「こうなったら、なんとか",
"崩れるのを阻止して部屋から",
"引っ張り出すほかねえでしょう」"
]
},
{
"id": 25825,
"kind": "msg",
"jp": [
"「あ・・・!",
"静奈ちゃんってまだ部屋に",
"いるんじゃ・・・?」"
]
},
{
"id": 25826,
"kind": "msg",
"jp": [
"「・・・そうか。",
"ちょいと電話してみましょう」"
]
},
{
"id": 25827,
"kind": "msg",
"jp": [
"日織は急いで壁際にある",
"内線電話に飛びついた。"
]
},
{
"id": 25828,
"kind": "msg",
"jp": [
"「・・・・どう?",
"出てくれない・・・?」"
]
},
{
"id": 25829,
"kind": "msg",
"jp": [
"「コールはしてますが",
"取ってはくれねえですね」"
]
},
{
"id": 25830,
"kind": "msg",
"jp": [
"「・・・こりゃあもう、",
"とっとと楔を何とかする方が",
"早えでしょう」"
]
},
{
"id": 25831,
"kind": "msg",
"jp": [
"多分、鈴奈ちゃんの側を離れないの",
"だろうから、説得したり無理に扉を",
"こじ開けてる時間はない・・・。"
]
},
{
"id": 25832,
"kind": "msg",
"jp": [
"「・・・そういや",
"双子のお嬢さんたちは・・・」"
]
},
{
"id": 25833,
"kind": "msg",
"jp": [
"「駄目、だった・・・。",
"もう二人とも・・・」"
]
},
{
"id": 25834,
"kind": "msg",
"jp": [
"「・・・・そうですか」"
]
},
{
"id": 25835,
"kind": "msg",
"jp": [
"「よし、じゃあとっとと",
"やっちまいましょう」"
]
},
{
"id": 25836,
"kind": "msg",
"jp": [
"「こんな場合ですから現場保存とか",
"言ってられねえし亡くなった方の",
"いる所も探すってことで・・・」"
]
},
{
"id": 25837,
"kind": "msg",
"jp": [
"「場所の指示は",
"頼みますぜ、{和/なご}さん」"
]
},
{
"id": 25838,
"kind": "msg",
"jp": [
"「ええっ!? 僕!?」"
]
},
{
"id": 25839,
"kind": "msg",
"jp": [
"「全員が思いつくまま探してちゃ",
"効率悪いでしょう。",
"アンタはここに残って司令塔です」"
]
},
{
"id": 25840,
"kind": "msg",
"jp": [
"「わ、わかった。",
"頑張る・・・」"
]
},
{
"id": 25841,
"kind": "msg",
"jp": [
"「ええ、よろしく」"
]
},
{
"id": 25842,
"kind": "msg",
"jp": [
"「無理だよ、そんなー!」"
]
},
{
"id": 25843,
"kind": "msg",
"jp": [
"「そういうわけですんで・・・」"
]
},
{
"id": 25844,
"kind": "msg",
"jp": [
"「え、あの、無理・・・」"
]
},
{
"id": 25845,
"kind": "msg",
"jp": [
"無理って言ってるのに。",
"誰も聞いてない・・・。"
]
},
{
"id": 25846,
"kind": "msg",
"jp": [
"（や・・やるしかないのか・・・）"
]
},
{
"id": 25847,
"kind": "msg",
"jp": [
"「ええと、",
"誰がどれ持って行きましょう」"
]
},
{
"id": 25848,
"kind": "msg",
"jp": [
"「着流し、お前も残れ」"
]
},
{
"id": 25849,
"kind": "msg",
"jp": [
"「6本なら3人で2本ずつで",
"ちょうどいいじゃねえか」"
]
},
{
"id": 25850,
"kind": "msg",
"jp": [
"「お前は残って、もうヤベエって",
"ことになったら坊主担いで逃げろ」"
]
},
{
"id": 25851,
"kind": "msg",
"jp": [
"「あー、確かに和は1人で",
"置いとくと逃げ遅れそうだな」"
]
},
{
"id": 25852,
"kind": "msg",
"jp": [
"「うん、そうだね。",
"それがいいんじゃないかな」"
]
},
{
"id": 25853,
"kind": "msg",
"jp": [
"「わかりました、それじゃあ",
"楔の方はお任せします」"
]
},
{
"id": 25854,
"kind": "msg",
"jp": [
"「ああ、任せといてくれよ!」"
]
},
{
"id": 25855,
"kind": "msg",
"jp": [
"「坊主、お前は何が何でも",
"生き残れよ」"
]
},
{
"id": 25856,
"kind": "msg",
"jp": [
"「この館で何があったのか、",
"誰よりも真相に近いところに",
"いるのはお前なんだからな」"
]
},
{
"id": 25857,
"kind": "msg",
"jp": [
"「まー、オレだって",
"死ぬ気はねーからな。",
"頼んだぜ、和!」"
]
},
{
"id": 25858,
"kind": "msg",
"jp": [
"「う、うん・・・。",
"わかった、頑張る!」"
]
},
{
"id": 25859,
"kind": "msg",
"jp": [
"「えっと、とりあえずこの楔が",
"はまりそうなところを探せば",
"いいんだよね?」"
]
},
{
"id": 25860,
"kind": "msg",
"jp": [
"「ええ、そうです。",
"連絡は内線で取り合いましょう、",
"幸いどこの部屋も通じてますし」"
]
},
{
"id": 25861,
"kind": "msg",
"jp": [
"「・・・なあ、筋肉は放っとくと",
"無い部屋延々と探してそうだぞ」"
]
},
{
"id": 25862,
"kind": "msg",
"jp": [
"「あ、あの・・・",
"それじゃ長いこと返事が無いなと",
"思ったら指示出しなおすよ・・・」"
]
},
{
"id": 25863,
"kind": "msg",
"jp": [
"「そうしてくれ。",
"オレ達の方も違うかも知れねえと",
"思ったらすぐ言ってこいよ」"
]
},
{
"id": 25864,
"kind": "msg",
"jp": [
"「なんか赤と青とあるけど",
"どっちからはめればいいのかな」"
]
},
{
"id": 25865,
"kind": "msg",
"jp": [
"「え、ど、どっちって",
"それじゃあ・・・」"
]
},
{
"id": 25866,
"kind": "msg",
"jp": [
"「えーと、赤からで」"
]
},
{
"id": 25867,
"kind": "msg",
"jp": [
"「青からにして下さい」"
]
},
{
"id": 25868,
"kind": "msg",
"jp": [
"「それじゃあ・・・",
"ちょうど3人ですね、1人2本ずつ",
"持って手分けしますか」"
]
},
{
"id": 25869,
"kind": "msg",
"jp": [
"「それじゃ、みなさん",
"1人2本ずつ取って下さいな」"
]
},
{
"id": 25870,
"kind": "msg",
"jp": [
"「{和/なご}さん、指示よろしく」"
]
},
{
"id": 25871,
"kind": "msg",
"jp": [
"「連絡は内線で取り合いましょう。",
"幸いこの館、内線だけはどこの部屋でも",
"通じてますからね」"
]
},
{
"id": 25872,
"kind": "msg",
"jp": [
"「{和/なご}さん、あんたは長いこと連絡が",
"ないなと思ったり、他の所かも",
"しれねえって思いついたら・・・」"
]
},
{
"id": 25873,
"kind": "msg",
"jp": [
"「・・・すぐに、",
"指示出しなおして下さいね」"
]
},
{
"id": 25874,
"kind": "msg",
"jp": [
"「わかった、頑張る!」"
]
},
{
"id": 25875,
"kind": "msg",
"jp": [
"「・・・で、えーと、",
"これ赤と青どっちから",
"はめるんだろう・・」"
]
},
{
"id": 25876,
"kind": "msg",
"jp": [
"「それは統一しときましょうか。",
"{和/なご}さん決めてくださいな」"
]
},
{
"id": 25877,
"kind": "msg",
"jp": [
"「え、僕が?",
"それじゃあ、えーっと・・・」"
]
},
{
"id": 25878,
"kind": "msg",
"jp": [
"「んじゃ、オレは1番と",
"4番もらってくぞ。",
"とりあえず食堂見てくるからな!」"
]
},
{
"id": 25879,
"kind": "msg",
"jp": [
"「んじゃ、オレは2番と",
"4番もらってくぞ。",
"とりあえず食堂見てくるからな!」"
]
},
{
"id": 25880,
"kind": "msg",
"jp": [
"「んじゃ、オレは2番と",
"5番もらってくぞ。",
"とりあえず食堂見てくるからな!」"
]
},
{
"id": 25881,
"kind": "msg",
"jp": [
"「んじゃ、オレは3番と",
"6番もらってくぞ。",
"とりあえず食堂見てくるからな!」"
]
},
{
"id": 25882,
"kind": "msg",
"jp": [
"「んじゃ、オレは3番と",
"5番もらってくぞ。",
"とりあえず食堂見てくるからな!」"
]
},
{
"id": 25883,
"kind": "msg",
"jp": [
"「んじゃ、オレは1番と",
"6番もらってくぞ。",
"とりあえず食堂見てくるからな!」"
]
},
{
"id": 25884,
"kind": "msg",
"jp": [
"「んじゃ、オレは3番と",
"4番もらってくぞ。",
"とりあえず食堂見てくるからな!」"
]
},
{
"id": 25885,
"kind": "msg",
"jp": [
"「よし、じゃあ行ってくる!」"
]
},
{
"id": 25886,
"kind": "msg",
"jp": [
"「あ、え、那須さん?」"
]
},
{
"id": 25887,
"kind": "msg",
"jp": [
"楔を掴んで2階に",
"駆け上がってしまった。"
]
},
{
"id": 25888,
"kind": "msg",
"jp": [
"那須さんは2番と5番の楔を掴んで",
"2階に駆け上がっていった。"
]
},
{
"id": 25889,
"kind": "msg",
"jp": [
"那須さんは3番と6番の楔を掴んで",
"2階に駆け上がっていった。"
]
},
{
"id": 25890,
"kind": "msg",
"jp": [
"那須さんは1番と6番の楔を掴んで",
"2階に駆け上がっていった。"
]
},
{
"id": 25891,
"kind": "msg",
"jp": [
"那須さんは1番と4番の楔を掴んで",
"2階に駆け上がっていった。"
]
},
{
"id": 25892,
"kind": "msg",
"jp": [
"那須さんは3番と5番の楔を掴んで",
"2階に駆け上がっていった。"
]
},
{
"id": 25893,
"kind": "msg",
"jp": [
"那須さんは2番と6番の楔を掴んで",
"2階に駆け上がっていった。"
]
},
{
"id": 25894,
"kind": "msg",
"jp": [
"那須さんは1番と5番の楔を掴んで",
"2階に駆け上がっていった。"
]
},
{
"id": 25895,
"kind": "msg",
"jp": [
"「どれでもいいから、よこせ」"
]
},
{
"id": 25896,
"kind": "msg",
"jp": [
"「あ、じゃあこれ",
"お願いします」"
]
},
{
"id": 25897,
"kind": "msg",
"jp": [
"「俺ぁ、地下に居るからな。",
"頼んだぞ、坊主」"
]
},
{
"id": 25898,
"kind": "msg",
"jp": [
"「3番と6番だな」"
]
},
{
"id": 25899,
"kind": "msg",
"jp": [
"「1番と5番だな」"
]
},
{
"id": 25900,
"kind": "msg",
"jp": [
"「3番と4番だな」"
]
},
{
"id": 25901,
"kind": "msg",
"jp": [
"「2番と5番だな」"
]
},
{
"id": 25902,
"kind": "msg",
"jp": [
"「1番と6番だな」"
]
},
{
"id": 25903,
"kind": "msg",
"jp": [
"「2番と4番だな」"
]
},
{
"id": 25904,
"kind": "msg",
"jp": [
"「3番と5番だな」"
]
},
{
"id": 25905,
"kind": "msg",
"jp": [
"「2番と6番だな」"
]
},
{
"id": 25906,
"kind": "msg",
"jp": [
"「なら、残りは俺ですね」"
]
},
{
"id": 25907,
"kind": "msg",
"jp": [
"「また嫌な音がして",
"きましたね・・・」"
]
},
{
"id": 25908,
"kind": "msg",
"jp": [
"「急ぎましょう、{和/なご}さん。",
"この楔、どこにはめ込みゃいいか",
"なんか思いつく事ありますかい?」"
]
},
{
"id": 25909,
"kind": "msg",
"jp": [
"「ど、どこ?",
"えーと、どこって言われても」"
]
},
{
"id": 25910,
"kind": "msg",
"jp": [
"「落ち着いて思い出して下さいや。",
"楔以外に何か関係ありそうなもの",
"なんて拾ってねえですか?」"
]
},
{
"id": 25911,
"kind": "msg",
"jp": [
"「袋の中身は楔だけだし",
"他には何も持ってないよ」"
]
},
{
"id": 25912,
"kind": "msg",
"jp": [
"館中くまなく捜索してまわった",
"わけじゃないからなあ。"
]
},
{
"id": 25913,
"kind": "msg",
"jp": [
"何かあったとしても今からじゃ",
"探してる暇ないし・・・。"
]
},
{
"id": 25914,
"kind": "msg",
"jp": [
"「それじゃあ、",
"勘でやるしかねえですね」"
]
},
{
"id": 25915,
"kind": "msg",
"jp": [
"「勘・・・」"
]
},
{
"id": 25916,
"kind": "msg",
"jp": [
"間に合うんだろうか。",
"でも手がかりがない以上",
"他に方法がない・・・。"
]
},
{
"id": 25917,
"kind": "msg",
"jp": [
"「あ、そうだ!",
"地下で見つけた見取り図が",
"あったんだった!」"
]
},
{
"id": 25918,
"kind": "msg",
"jp": [
"「見取り図ですかい?」"
]
},
{
"id": 25919,
"kind": "msg",
"jp": [
"「ほら、これ。",
"メモもあったけど何語か",
"わかんないんだよ」"
]
},
{
"id": 25920,
"kind": "msg",
"jp": [
"「・・・こりゃラテン語じゃ",
"ねえかなあ・・・」"
]
},
{
"id": 25921,
"kind": "msg",
"jp": [
"「ラテン語!?",
"日織、読めるの?」"
]
},
{
"id": 25922,
"kind": "msg",
"jp": [
"「うーん・・・",
"さすがに暗記してる単語って",
"少ねえんですよね」"
]
},
{
"id": 25923,
"kind": "msg",
"jp": [
"「たかが6行とはいえ",
"今から訳してちゃ",
"間に合わねえでしょう」"
]
},
{
"id": 25924,
"kind": "msg",
"jp": [
"「6行って、もしかしてこれ!?",
"地下に降りる階段に落ちてたやつ」"
]
},
{
"id": 25925,
"kind": "msg",
"jp": [
"「見せて下さいな」"
]
},
{
"id": 25926,
"kind": "msg",
"jp": [
"「どう?」"
]
},
{
"id": 25927,
"kind": "msg",
"jp": [
"「俺に読める範囲ではメモの内容と",
"共通してるみてえですね。",
"多分、このラテン語の和訳でしょう」"
]
},
{
"id": 25928,
"kind": "msg",
"jp": [
"「ただ、これを訳したもんだとしても",
"どういう意味なんでしょう?」"
]
},
{
"id": 25929,
"kind": "msg",
"jp": [
"「この変な詩が楔を差し込む",
"場所のヒントになってるのかな」"
]
},
{
"id": 25930,
"kind": "msg",
"jp": [
"「暗号ってやつですかい」"
]
},
{
"id": 25931,
"kind": "msg",
"jp": [
"「うん、楔の数とも合ってるし」"
]
},
{
"id": 25932,
"kind": "msg",
"jp": [
"「はめ込み方の指示、とか?」"
]
},
{
"id": 25933,
"kind": "msg",
"jp": [
"「・・・マフィンの焼ける匂いが",
"するようなはめ込み方ってなんです」"
]
},
{
"id": 25934,
"kind": "msg",
"jp": [
"「い、意味わかんないね。",
"違うよな・・・じゃあ・・・」"
]
},
{
"id": 25935,
"kind": "msg",
"jp": [
"「これは関係ないんじゃ",
"ないかなあ・・・」"
]
},
{
"id": 25936,
"kind": "msg",
"jp": [
"「そうですかね?",
"でも、意味もなくついてるって",
"のも変な話じゃねえですかい?」"
]
},
{
"id": 25937,
"kind": "msg",
"jp": [
"「んー、そっか。",
"それじゃあ・・・」"
]
},
{
"id": 25938,
"kind": "msg",
"jp": [
"「あ、もしかしてこれが",
"楔を差し込む場所を示してる",
"とかいうことはねえですかい?」"
]
},
{
"id": 25939,
"kind": "msg",
"jp": [
"「場所?」"
]
},
{
"id": 25940,
"kind": "msg",
"jp": [
"「ええ、場所を示すヒントってぇか",
"暗号みてえなもんじゃねえかと」"
]
},
{
"id": 25941,
"kind": "msg",
"jp": [
"「あー、なるほど。",
"そうだね、それはありそうだ」"
]
},
{
"id": 25942,
"kind": "msg",
"jp": [
"「この詩が場所を",
"示してるとして・・・」"
]
},
{
"id": 25943,
"kind": "msg",
"jp": [
"「じゃあこの楔の番号は、",
"詩の一行目から順番ってこと",
"なんでしょうかね」"
]
},
{
"id": 25944,
"kind": "msg",
"jp": [
"「そうだね、数字についての",
"記述は無いし・・・」"
]
},
{
"id": 25945,
"kind": "msg",
"jp": [
"「色はどうなんでしょう、",
"赤と青とありますけど・・・」"
]
},
{
"id": 25946,
"kind": "msg",
"jp": [
"「これは・・・」"
]
},
{
"id": 25947,
"kind": "msg",
"jp": [
"「詩の中には色について",
"何も書いてないから、",
"特に意味はないんじゃないかなあ」"
]
},
{
"id": 25948,
"kind": "msg",
"jp": [
"「そうですかねえ?",
"じゃあ、なんで二色あるんだか」"
]
},
{
"id": 25949,
"kind": "msg",
"jp": [
"「えっと・・・",
"同じ色のが続き番号で3本ずつ",
"あるわけだから・・・」"
]
},
{
"id": 25950,
"kind": "msg",
"jp": [
"「赤は赤、青は青で3本ずつ",
"同時にはめ込む、とか?」"
]
},
{
"id": 25951,
"kind": "msg",
"jp": [
"「はあ、なるほど。",
"3本一組ってことですね」"
]
},
{
"id": 25952,
"kind": "msg",
"jp": [
"「えーと・・・",
"赤と青と、交互にはめていくとか?」"
]
},
{
"id": 25953,
"kind": "msg",
"jp": [
"「交互だと番号がばらばらに",
"なっちまいますぜ?」"
]
},
{
"id": 25954,
"kind": "msg",
"jp": [
"「赤と青はそれぞれ続き番号に",
"なってるみてえですから」"
]
},
{
"id": 25955,
"kind": "msg",
"jp": [
"「あれ? そっか・・・」"
]
},
{
"id": 25956,
"kind": "msg",
"jp": [
"赤の一番からはめ込んでいった場合",
"次にどれをはめ込めばいいのか、",
"何のヒントもないことになってしまう。"
]
},
{
"id": 25957,
"kind": "msg",
"jp": [
"「じゃあ、なんなんだろう。",
"えーっと・・・」"
]
},
{
"id": 25958,
"kind": "msg",
"jp": [
"「日織は何か思いつく?」"
]
},
{
"id": 25959,
"kind": "msg",
"jp": [
"「うーん・・・",
"同じ色のが続き番号で3つずつ",
"あるってことは・・・」"
]
},
{
"id": 25960,
"kind": "msg",
"jp": [
"「やっぱ赤と青で3本一組って",
"ことじゃねえですかい?」"
]
},
{
"id": 25961,
"kind": "msg",
"jp": [
"「一組?」"
]
},
{
"id": 25962,
"kind": "msg",
"jp": [
"「赤は赤、青は青で3本ずつ",
"順にはめ込んでみるのはどうです」"
]
},
{
"id": 25963,
"kind": "msg",
"jp": [
"「そっか、それかも。",
"色別にはめ込んでみよう」"
]
},
{
"id": 25964,
"kind": "msg",
"jp": [
"「わかりました、",
"じゃ、3本一組ってことで」"
]
},
{
"id": 25965,
"kind": "msg",
"jp": [
"「えーと、楔は3本一組で色別に、",
"場所はこの詩を手がかりに、だね」"
]
},
{
"id": 25966,
"kind": "msg",
"jp": [
"「他に手がかりになりそうな",
"もんは、もうないんでしょう?」"
]
},
{
"id": 25967,
"kind": "msg",
"jp": [
"「うん、残念ながらね。",
"これだけでやるしかなさそう」"
]
},
{
"id": 25968,
"kind": "msg",
"jp": [
"「ま、しょうがねえですね」"
]
},
{
"id": 25969,
"kind": "msg",
"jp": [
"「見取り図の2階と地下にだけ",
"ついてる×印はなんでしょう?」"
]
},
{
"id": 25970,
"kind": "msg",
"jp": [
"「・・・わかんない」"
]
},
{
"id": 25971,
"kind": "msg",
"jp": [
"「けど、なんか意味があるん",
"でしょうねえ。",
"落書きって事はねえでしょうし」"
]
},
{
"id": 25972,
"kind": "msg",
"jp": [
"「1階だけ探せば",
"いいんじゃないかな」"
]
},
{
"id": 25973,
"kind": "msg",
"jp": [
"「×印だし、2階や地下には",
"差し込める穴がないってことじゃ?」"
]
},
{
"id": 25974,
"kind": "msg",
"jp": [
"「ああ、そうですね。",
"なら1階にしぼって行きましょう」"
]
},
{
"id": 25975,
"kind": "msg",
"jp": [
"「1階だけ印がないから、",
"1階は関係ないってことかな?」"
]
},
{
"id": 25976,
"kind": "msg",
"jp": [
"「そうですかい?",
"それなら逆に1階に×つけませんかね」"
]
},
{
"id": 25977,
"kind": "msg",
"jp": [
"「あ、それもそうか。",
"うーん・・・」"
]
},
{
"id": 25978,
"kind": "msg",
"jp": [
"「・・・なんだろう?",
"意味あるのかな」"
]
},
{
"id": 25979,
"kind": "msg",
"jp": [
"「×印ってこたぁ、やっぱ",
"2階と地下には差し込むところが",
"ねえってことなんじゃあ?」"
]
},
{
"id": 25980,
"kind": "msg",
"jp": [
"「そうなのかな。",
"だったら1階だけ探せばいいって",
"ことになるけど」"
]
},
{
"id": 25981,
"kind": "msg",
"jp": [
"「館崩すような装置ですからね、",
"やっぱ2階より1階に仕掛けが",
"ありそうな気はしますよ」"
]
},
{
"id": 25982,
"kind": "msg",
"jp": [
"「それもそうだね。",
"じゃあ1階に絞って探そう」"
]
},
{
"id": 25983,
"kind": "msg",
"jp": [
"「どっちにしろ、そろそろ一度",
"連絡とってみた方がいいでしょう」"
]
},
{
"id": 25984,
"kind": "msg",
"jp": [
"「うん、えっと電話・・・」"
]
},
{
"id": 25985,
"kind": "msg",
"jp": [
"「内線はそこですぜ」"
]
},
{
"id": 25986,
"kind": "msg",
"jp": [
"「連絡は頼みます。",
"時間もねえし俺も便所辺りから",
"見てきますから」"
]
},
{
"id": 25987,
"kind": "msg",
"jp": [
"「わかった!」"
]
},
{
"id": 25988,
"kind": "msg",
"jp": [
"（ええと、まずは・・・）"
]
},
{
"id": 25989,
"kind": "msg",
"jp": [
"からばこ"
]
},
{
"id": 25990,
"kind": "msg",
"jp": [
"演出用"
]
},
{
"id": 25991,
"kind": "msg",
"jp": [
"「・・・さん!",
"{和/なご}さん!?」"
]
},
{
"id": 25992,
"kind": "msg",
"jp": [
"「・・・・う・・」"
]
},
{
"id": 25993,
"kind": "msg",
"jp": [
"「{和/なご}さん!",
"気が付きましたかい?」"
]
},
{
"id": 25994,
"kind": "msg",
"jp": [
"「ひ・・・おり・・・?」"
]
},
{
"id": 25995,
"kind": "msg",
"jp": [
"目を開けようとすると、刺すような",
"冷たさがまぶたに落ちてきた。"
]
},
{
"id": 25996,
"kind": "msg",
"jp": [
"「ここ・・・外・・・?」"
]
},
{
"id": 25997,
"kind": "msg",
"jp": [
"「ええ・・・なんとかね」"
]
},
{
"id": 25998,
"kind": "msg",
"jp": [
"日織に支えられながら、",
"なんとか身体を半分だけ起こす。"
]
},
{
"id": 25999,
"kind": "msg",
"jp": [
"空はまだ、どんよりと曇ったままで",
"細い雨の糸を幾筋も降らせていた。"
]
},
{
"id": 26000,
"kind": "msg",
"jp": [
"「・・・館、が・・・」"
]
},
{
"id": 26001,
"kind": "msg",
"jp": [
"そこに、館はもうなかった。"
]
},
{
"id": 26002,
"kind": "msg",
"jp": [
"迷い込んだその夜からあんなに",
"いろんなことがあった館。"
]
},
{
"id": 26003,
"kind": "msg",
"jp": [
"最後の最後まで悲しいことばかり",
"起きた館が・・・。"
]
},
{
"id": 26004,
"kind": "msg",
"jp": [
"「崩れちまいましたよ・・・。",
"もう、瓦礫の山です・・・」"
]
},
{
"id": 26005,
"kind": "msg",
"jp": [
"・・・残らなかったんだ。",
"何一つ・・・。"
]
},
{
"id": 26006,
"kind": "msg",
"jp": [
"みんな崩れて、砕けて、",
"こなごなになってしまった。"
]
},
{
"id": 26007,
"kind": "msg",
"jp": [
"「・・・僕・・・僕は、・・・」"
]
},
{
"id": 26008,
"kind": "msg",
"jp": [
"「なにも・・・僕、何も出来なかった。",
"助け・・られ、なかった・・・」"
]
},
{
"id": 26009,
"kind": "msg",
"jp": [
"「{和/なご}さん、もういいんですよ」"
]
},
{
"id": 26010,
"kind": "msg",
"jp": [
"「もう、全部終わっちまったんです。",
"あんたが悩むことも、もう・・・」"
]
},
{
"id": 26011,
"kind": "msg",
"jp": [
"「・・・何もありませんから」"
]
},
{
"id": 26012,
"kind": "msg",
"jp": [
"くらり、と風景が揺れる。",
"まるで暗い水の中を",
"漂っているかのように・・・。"
]
},
{
"id": 26013,
"kind": "msg",
"jp": [
"意識が・・・。"
]
},
{
"id": 26014,
"kind": "msg",
"jp": [
"また、途切れそうに・・・。"
]
},
{
"id": 26015,
"kind": "msg",
"jp": [
"「・・・大丈夫ですぜ。",
"もう心配ねえから、",
"救助・・・るまで・・休・・・」"
]
},
{
"id": 26016,
"kind": "msg",
"jp": [
"日織の声も、最後まで聞こえなかった。"
]
},
{
"id": 26017,
"kind": "msg",
"jp": [
"「・・・さんっ!?",
"ねえ、お兄さんってば!」"
]
},
{
"id": 26018,
"kind": "msg",
"jp": [
"「・・・え・・・・」"
]
},
{
"id": 26019,
"kind": "msg",
"jp": [
"「・・・生きてた」"
]
},
{
"id": 26020,
"kind": "msg",
"jp": [
"「ああ、もう!",
"やっと目ぇ開けたぁ!!」"
]
},
{
"id": 26021,
"kind": "msg",
"jp": [
"「・・・あ・・・」"
]
},
{
"id": 26022,
"kind": "msg",
"jp": [
"同じ顔が並んで僕の顔を",
"のぞき込んでいた。"
]
},
{
"id": 26023,
"kind": "msg",
"jp": [
"（僕は・・・どうしたんだっけ）"
]
},
{
"id": 26024,
"kind": "msg",
"jp": [
"（ここ・・・外・・・?）"
]
},
{
"id": 26025,
"kind": "msg",
"jp": [
"首をめぐらせて見ると、日織がいた。",
"何かの糸が切れたように疲れた顔で",
"地面に座り込んでいる。"
]
},
{
"id": 26026,
"kind": "msg",
"jp": [
"そして、その後ろに・・・。"
]
},
{
"id": 26027,
"kind": "msg",
"jp": [
"「・・・館・・・・・」"
]
},
{
"id": 26028,
"kind": "msg",
"jp": [
"「崩れてもうた・・・」"
]
},
{
"id": 26029,
"kind": "msg",
"jp": [
"「もう・・アカンかと思たわ。",
"そしたら、お兄さんらが",
"飛び出して来て・・・」"
]
},
{
"id": 26030,
"kind": "msg",
"jp": [
"「飛び出して・・・?」"
]
},
{
"id": 26031,
"kind": "msg",
"jp": [
"・・・覚えてなかった。",
"館がとんでもなく揺れ出したような",
"記憶はぼんやりとあるけれど・・・。"
]
},
{
"id": 26032,
"kind": "msg",
"jp": [
"「僕ら・・・だけなの・・・」"
]
},
{
"id": 26033,
"kind": "msg",
"jp": [
"「・・・すいません。",
"本当に・・・あんただけが",
