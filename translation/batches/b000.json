" "
]
},
{
"id": 436,
"kind": "sub",
"jp": [
"小太りの男:なんだって?"
]
},
{
"id": 437,
"kind": "sub",
"jp": [
"青年:お引き取り下さい"
]
},
{
"id": 438,
"kind": "sub",
"jp": [
"粗暴な男:おいおい、こんな大嵐の中を"
]
},
{
"id": 439,
"kind": "sub",
"jp": [
"     引き返せってのか?"
]
},
{
"id": 440,
"kind": "sub",
"jp": [
"小太りの男:そういう問題じゃないだろう!"
]
},
{
"id": 441,
"kind": "sub",
"jp": [
"      招待状を送りつけておいて、"
]
},
{
"id": 442,
"kind": "sub",
"jp": [
"      なんだね、その言い草は!?"
]
},
{
"id": 443,
"kind": "sub",
"jp": [
"青年:ですから、当家ではお招きした"
]
},
{
"id": 444,
"kind": "sub",
"jp": [
"   覚えはないと・・・"
]
},
{
"id": 445,
"kind": "sub",
"jp": [
"女性:でも、確かにこうして招待状が・・・"
]
},
{
"id": 446,
"kind": "sub",
"jp": [
"少女A:わ、わたしたちも・・・"
]
},
{
"id": 447,
"kind": "sub",
"jp": [
"    ね、ねえさま?"
]
},
{
"id": 448,
"kind": "sub",
"jp": [
"少女B:ええ、ほら。 同じ物でしょ?"
]
},
{
"id": 449,
"kind": "sub",
"jp": [
"青年:そのようですが、私には"
]
},
{
"id": 450,
"kind": "sub",
"jp": [
"   見覚えがございません"
]
},
{
"id": 451,
"kind": "sub",
"jp": [
"小太りの男:ええい、君では話にならんよ!"
]
},
{
"id": 452,
"kind": "sub",
"jp": [
"      主人を呼びたまえ、主人を!"
]
},
{
"id": 453,
"kind": "sub",
"jp": [
"青年:あいにく、主人はどなたとも"
]
},
{
"id": 454,
"kind": "sub",
"jp": [
"   お会いになりません"
]
},
{
"id": 455,
"kind": "sub",
"jp": [
"少女A:そんな・・・"
]
},
{
"id": 456,
"kind": "sub",
"jp": [
"女性:いったい、どういうことなの?"
]
},
{
"id": 457,
"kind": "sub",
"jp": [
"少女B:決まってるじゃない"
]
},
{
"id": 458,
"kind": "sub",
"jp": [
"少女A:ねえさま・・・?"
]
},
{
"id": 459,
"kind": "sub",
"jp": [
"少女B:あたしたち、騙されたのよ"
]
},
{
"id": 460,
"kind": "msg",
"jp": [
"・・・暗い。"
]
},
{
"id": 461,
"kind": "msg",
"jp": [
"墨絵の中に迷い込んだかのような",
"山奥深い木々の迷路・・・。"
]
},
{
"id": 462,
"kind": "msg",
"jp": [
"ぬかるみに足を取られて乱れ、",
"すべる足音が、雨音に混じって",
"不快なノイズのようだ。"
]
},
{
"id": 463,
"kind": "msg",
"jp": [
"どこまで・・・。"
]
},
{
"id": 464,
"kind": "msg",
"jp": [
"一体、どこまで続くのか。"
]
},
{
"id": 465,
"kind": "msg",
"jp": [
"こんな・・・。"
]
},
{
"id": 466,
"kind": "msg",
"jp": [
"・・・・暗い・・・。"
]
},
{
"id": 467,
"kind": "msg",
"jp": [
"<fs 120>「うっ・・・わああぁっ!?」<fs>"
]
},
{
"id": 468,
"kind": "msg",
"jp": [
"「・・・・あ～あ・・・。",
"とうとう転んじゃった・・・」"
]
},
{
"id": 469,
"kind": "msg",
"jp": [
"真っ暗だし、足場は悪いし、出来るだけ",
"神経を尖らせて注意して歩いてたつもり",
"だったのになあ。"
]
},
{
"id": 470,
"kind": "msg",
"jp": [
"「・・・・よっ、と・・うわ」"
]
},
{
"id": 471,
"kind": "msg",
"jp": [
"あやうくまた足を滑らせそうになり、",
"手近な木にすがりつく。"
]
},
{
"id": 472,
"kind": "msg",
"jp": [
"樹上に生い茂っているはずの葉は、",
"これほどの豪雨の前には気休めにも",
"なってくれなかった。"
]
},
{
"id": 473,
"kind": "msg",
"jp": [
"「もうちょっと近いと思ったん",
"だけど・・・」"
]
},
{
"id": 474,
"kind": "msg",
"jp": [
"行く手を確かめようにも、叩きつける",
"雨粒に視界を遮られてほとんど見えない。"
]
},
{
"id": 475,
"kind": "msg",
"jp": [
"眼鏡をぬぐってみたけれど、",
"すぐにびしょ濡れになってかえって",
"見えにくくなるばかりだった。"
]
},
{
"id": 476,
"kind": "msg",
"jp": [
"「明かりが見えたと思ったんだけど",
"気のせいだったのかなぁ・・・」"
]
},
{
"id": 477,
"kind": "msg",
"jp": [
"「・・・やっぱり、朝まで車で",
"じっとしてるべきだったかも・・・」"
]
},
{
"id": 478,
"kind": "msg",
"jp": [
"「・・・・・・・」"
]
},
{
"id": 479,
"kind": "msg",
"jp": [
"濡れた服は気持ち悪いし、寒いし、",
"それになにより・・・。"
]
},
{
"id": 480,
"kind": "msg",
"jp": [
"「わああああ、ごめんなさいっ!?」"
]
},
{
"id": 481,
"kind": "msg",
"jp": [
"「・<w>・<w>・<w>・<w>・<w>・<w>・<w>・<w>」"
]
},
{
"id": 482,
"kind": "msg",
"jp": [
"・・・誰に謝ってるんだ、僕。"
]
},
{
"id": 483,
"kind": "msg",
"jp": [
"恐る恐る顔を上げると、雷の音は",
"もうやんでいた。"
]
},
{
"id": 484,
"kind": "msg",
"jp": [
"「・・・やっぱり怖い・・・」"
]
},
{
"id": 485,
"kind": "msg",
"jp": [
"寒いより冷たいより、なによりも",
"ここにじっとしてるのが怖い。"
]
},
{
"id": 486,
"kind": "msg",
"jp": [
"「・・・車に戻ろうかな」"
]
},
{
"id": 487,
"kind": "msg",
"jp": [
"急に不安になってきて、",
"残してきた車の方を振り返る。"
]
},
{
"id": 488,
"kind": "msg",
"jp": [
"「・・・・・・え?」"
]
},
{
"id": 489,
"kind": "msg",
"jp": [
"車は、影も形も見えなかった。"
]
},
{
"id": 490,
"kind": "msg",
"jp": [
"「あ・・・あれ・・・?",
"そんなに離れたっけ・・・」"
]
},
{
"id": 491,
"kind": "msg",
"jp": [
"ものの数分も歩いてないと",
"思ったんだけど・・・。"
]
},
{
"id": 492,
"kind": "msg",
"jp": [
"暗いのと、ひどい雨のせいで、",
"少し先も見えなくなってるの",
"かもしれない。"
]
},
{
"id": 493,
"kind": "msg",
"jp": [
"「・・・・・・・・・・」"
]
},
{
"id": 494,
"kind": "msg",
"jp": [
"「もしかして・・・また迷った?」"
]
},
{
"id": 495,
"kind": "msg",
"jp": [
"ただでさえ、見知らぬ山道に迷い込んで",
"日が暮れてしまったというのに。"
]
},
{
"id": 496,
"kind": "msg",
"jp": [
"どうせこの嵐じゃ車を走らせるのも",
"危ないし、ガソリンも尽きかけてるから",
"と思って明かりを目指してみたけど。"
]
},
{
"id": 497,
"kind": "msg",
"jp": [
"「・・・車も明かりも、どっちも",
"見あたらなくなってる・・・」"
]
},
{
"id": 498,
"kind": "msg",
"jp": [
"・・・・・・・どうしよう。"
]
},
{
"id": 499,
"kind": "msg",
"jp": [
"「な・・・なんで僕って・・・」"
]
},
{
"id": 500,
"kind": "msg",
"jp": [
"いつもこうなんだろう・・・。",
"間の悪いときには、必ずもっと",
"間の悪いことが重なって起きる。"
]
},
{
"id": 501,
"kind": "msg",
"jp": [
"「大学が休みの間、長期のバイトが",
"決まったはずなのに・・・」"
]
},
{
"id": 502,
"kind": "msg",
"jp": [
"「・・・・・・・・」"
]
},
{
"id": 503,
"kind": "msg",
"jp": [
"「ううっ・・・",
"ひでえ、ひでえよ・・・」"
]
},
{
"id": 504,
"kind": "msg",
"jp": [
"「あ、あの・・・・",
"この辺にペンションが・・・」"
]
},
{
"id": 505,
"kind": "msg",
"jp": [
"「ここだよ、ここ!",
"ひでえだろう、まだローンが",
"残ってたのにさあ・・・」"
]
},
{
"id": 506,
"kind": "msg",
"jp": [
"「こ、この・・・あの、焼け跡・・・」"
]
},
{
"id": 507,
"kind": "msg",
"jp": [
"「<fs 130>全<w>焼<w>だよ!<fs>",
"<fs 90>ああ、俺の城が～・・・<fs>」"
]
},
{
"id": 508,
"kind": "msg",
"jp": [
"「・・・バイト先が消し炭に",
"なってたし・・・」"
]
},
{
"id": 509,
"kind": "msg",
"jp": [
"「暇になっちゃったからドライブして",
"帰ろうと思っただけなのに・・・」"
]
},
{
"id": 510,
"kind": "msg",
"jp": [
"・・・昼頃から崩れた天気は",
"ここまで悪化しなくてもという勢いで",
"どんどん嵐になって、今じゃこれだし。"
]
},
{
"id": 511,
"kind": "msg",
"jp": [
"「おまけに、道に迷うし」"
]
},
{
"id": 512,
"kind": "msg",
"jp": [
"「明かりが見えたから、",
"誰かいると思ってほっとしたのに",
"車まで見失って・・・」"
]
},
{
"id": 513,
"kind": "msg",
"jp": [
"というか、もう車どころか・・・。"
]
},
{
"id": 514,
"kind": "msg",
"jp": [
"・・・自分が歩いてきた方向も",
"よくわからない・・・。"
]
},
{
"id": 515,
"kind": "msg",
"jp": [
"（足元も見えにくいし、変な方へ",
"歩いちゃったら危ないかも・・・?）"
]
},
{
"id": 516,
"kind": "msg",
"jp": [
"なんかもう、これ以上悲惨な状況って",
"ちょっとないんじゃないかと思うくらい",
"ヤバいことになってる・・・。"
]
},
{
"id": 517,
"kind": "msg",
"jp": [
"「本当に、どうしよう・・・」"
]
},
{
"id": 518,
"kind": "msg",
"jp": [
"「・・・やっぱり、",
"車まで戻ってみよう・・・」"
]
},
{
"id": 519,
"kind": "msg",
"jp": [
"手探りで木に掴まりながら、",
"おそるおそる引き返そうとした。"
]
},
{
"id": 520,
"kind": "msg",
"jp": [
"「えっと・・・真っ直ぐ行けば",
"いいはずなんだけど・・・」"
]
},
{
"id": 521,
"kind": "msg",
"jp": [
"「・・・み、見あたらない・・・」"
]
},
{
"id": 522,
"kind": "msg",
"jp": [
"変だ・・・いくらなんでも、",
"車らしきものの影くらい見えたって",
"いいはずなのに・・・。"
]
},
{
"id": 523,
"kind": "msg",
"jp": [
"（・・・これ以上戻ったら、",
"もっと迷っちゃうかも・・・）"
]
},
{
"id": 524,
"kind": "msg",
"jp": [
"（いや、でも・・・あるかどうか",
"わからない建物探すよりは・・・）"
]
},
{
"id": 525,
"kind": "msg",
"jp": [
"絶対あるはずの、車の方がまだ",
"ましなんじゃないかな。",
"うん、きっとそうだ。"
]
},
{
"id": 526,
"kind": "msg",
"jp": [
"そう信じて、更に進んでみた",
"けれど・・・。"
]
},
{
"id": 527,
"kind": "msg",
"jp": [
"「・・・・・ない。",
"ないよ、どうしよう・・・」"
]
},
{
"id": 528,
"kind": "msg",
"jp": [
"「どこ行ったんだよ、僕の車・・・!」"
]
},
{
"id": 529,
"kind": "msg",
"jp": [
"いい知れない恐怖に駆られて、思わず",
"足を速める。"
]
},
{
"id": 530,
"kind": "msg",
"jp": [
"「えっ・・・」"
]
},
{
"id": 531,
"kind": "msg",
"jp": [
"急に、足下の土がごっそりと",
"無くなった。"
]
},
{
"id": 532,
"kind": "msg",
"jp": [
"<fs 120>「わああああああっ!?」<fs>"
]
},
{
"id": 533,
"kind": "msg",
"jp": [
"落ちる――そう思った瞬間、",
"すうっと気が遠くなった。"
]
},
{
"id": 534,
"kind": "msg",
"jp": [
"「・・・・・・・・・・",
"・・・・・・・・・・・・・・」"
]
},
{
"id": 535,
"kind": "msg",
"jp": [
"「・・・・・・・・・・",
"・・・・・・・・・・・・・・",
"・・・・・・・・・・あれ?」"
]
},
{
"id": 536,
"kind": "msg",
"jp": [
"・・・・・・僕、生きてる?"
]
},
{
"id": 537,
"kind": "msg",
"jp": [
"「き、気絶してただけか・・・」"
]
},
{
"id": 538,
"kind": "msg",
"jp": [
"危なかった。",
"慌てて変な方へ歩き出しちゃってた",
"みたいだ。"
]
},
{
"id": 539,
"kind": "msg",
"jp": [
"（死ぬような高さじゃなくて",
"助かった・・・けど・・・）"
]
},
{
"id": 540,
"kind": "msg",
"jp": [
"もうちょっと慎重にいかないと",
"駄目だな。"
]
},
{
"id": 541,
"kind": "msg",
"jp": [
"どうしよう・・・。"
]
},
{
"id": 542,
"kind": "msg",
"jp": [
"「だ・・・誰かいませんかー?」"
]
},
{
"id": 543,
"kind": "msg",
"jp": [
"なんだか不安になって、",
"暗闇に向かって叫んでいた。"
]
},
{
"id": 544,
"kind": "msg",
"jp": [
"「誰かー!",
"いたら返事してー!」"
]
},
{
"id": 545,
"kind": "msg",
"jp": [
"「誰か・・・・・・」"
]
},
{
"id": 546,
"kind": "msg",
"jp": [
"・・・当然、返事はなかった。"
]
},
