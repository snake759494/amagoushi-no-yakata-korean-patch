"jp": [
"「どこって、{帽/・}{子/・}{屋/・}{か/・}{ら/・}出てきたに",
"決まってるじゃねえですか」"
]
},
{
"id": 681,
"kind": "msg",
"jp": [
"「・・・ごめんなさい。",
"意味がわかりません」"
]
},
{
"id": 682,
"kind": "msg",
"jp": [
"「わからない?",
"忘れちまってんですかい?」"
]
},
{
"id": 683,
"kind": "msg",
"jp": [
"「忘れるも何も、最初から・・・",
"知らない、と・・・思うんだけど」"
]
},
{
"id": 684,
"kind": "msg",
"jp": [
"「頭打った拍子に、",
"飛んじまったんですかね?」"
]
},
{
"id": 685,
"kind": "msg",
"jp": [
"「頭?」"
]
},
{
"id": 686,
"kind": "msg",
"jp": [
"「倒れてたって言ったでしょ、",
"どっかに頭ぶつけたみてえですぜ。",
"一応冷やしときましたがね」"
]
},
{
"id": 687,
"kind": "msg",
"jp": [
"「頭・・・・」"
]
},
{
"id": 688,
"kind": "msg",
"jp": [
"<fs 120>「・・・っあ、あああ、そうだ!」<fs>"
]
},
{
"id": 689,
"kind": "msg",
"jp": [
"「わっ、ちょっと!",
"まだ起きあがっちゃあ・・・」"
]
},
{
"id": 690,
"kind": "msg",
"jp": [
"「それどころじゃ・・・いてっ」"
]
},
{
"id": 691,
"kind": "msg",
"jp": [
"「ほらほら、言わんこっちゃねえ。",
"まだ痛むんでしょう、",
"いきなり起きちゃいけませんや」"
]
},
{
"id": 692,
"kind": "msg",
"jp": [
"「だ、だって、死んでる人が・・・」"
]
},
{
"id": 693,
"kind": "msg",
"jp": [
"「はあ?」"
]
},
{
"id": 694,
"kind": "msg",
"jp": [
"「・・・・・あ、起きんさった」"
]
},
{
"id": 695,
"kind": "msg",
"jp": [
"「あぁ、よかったわぁ。",
"お兄さん、大丈夫?」"
]
},
{
"id": 696,
"kind": "msg",
"jp": [
"「え? え?」"
]
},
{
"id": 697,
"kind": "msg",
"jp": [
"「ちっとも起きんさらんから、",
"心配しとったんよ。",
"もう、お加減はええの?」"
]
},
{
"id": 698,
"kind": "msg",
"jp": [
"「あ、うん・・・まあ・・・」"
]
},
{
"id": 699,
"kind": "msg",
"jp": [
"突然、同じ顔の少女がひょっこりと",
"顔を出したので、唖然とする。"
]
},
{
"id": 700,
"kind": "msg",
"jp": [
"まだ視界がおかしい、というわけでは",
"ないらしい。",
"どうやら双子・・・のようだ。"
]
},
{
"id": 701,
"kind": "msg",
"jp": [
"「えーと、こっちが<co 0f0>{鈴/すず}{奈/な}<co>さん・・・で",
"あってますかい?」"
]
},
{
"id": 702,
"kind": "msg",
"jp": [
"「うん、当たり。",
"こんばんは、お兄さん」"
]
},
{
"id": 703,
"kind": "msg",
"jp": [
"「うちは、鈴奈いいます。",
"こちらが姉の<co 0f0>{静/しず}{奈/な}<co>」"
]
},
{
"id": 704,
"kind": "msg",
"jp": [
"静奈、と呼ばれた少女は眠そうな目をした",
"ままでぺこん、とお辞儀をした。"
]
},
{
"id": 705,
"kind": "msg",
"jp": [
"「もう、お姉ちゃんは・・・」"
]
},
{
"id": 706,
"kind": "msg",
"jp": [
"「すみません、姉はいっつもこんなんで。",
"悪気はないんで、",
"許してつかぁさいねぇ?」"
]
},
{
"id": 707,
"kind": "msg",
"jp": [
"「は・・・はぁ・・・」"
]
},
{
"id": 708,
"kind": "msg",
"jp": [
"双子の話す方言は、昼間山に入り込む",
"前にこの辺りの土地で耳にしたものに",
"似た響きだった。"
]
},
{
"id": 709,
"kind": "msg",
"jp": [
"地元の人なのかな・・・。",
"だけど、さっきぼんやり聞いた口論は",
"こんな言葉じゃなかったような・・・。"
]
},
{
"id": 710,
"kind": "msg",
"jp": [
"「・・・お目覚めでございますか」"
]
},
{
"id": 711,
"kind": "msg",
"jp": [
"「ああ、<co 0f0>{椿/つばき}<co>さん。",
"ついさっき気がついたばっかり",
"なんですがね」"
]
},
{
"id": 712,
"kind": "msg",
"jp": [
"日織の背後に現れたのは、",
"さっき口論していた中で妙に冷静だった",
"人と同じ声だった。"
]
},
{
"id": 713,
"kind": "msg",
"jp": [
"（なんか妙にかしこまった",
"格好だなぁ・・・）"
]
},
{
"id": 714,
"kind": "msg",
"jp": [
"まだ若そうなのに。",
"それにあの眼鏡、度が入ってないし。"
]
},
{
"id": 715,
"kind": "msg",
"jp": [
"「当家の執事で、椿と申します。",
"お待ちしておりました、南雲さま」"
]
},
{
"id": 716,
"kind": "msg",
"jp": [
"「な・・・南雲って・・・",
"だから僕は南雲じゃないってば!」"
]
},
{
"id": 717,
"kind": "msg",
"jp": [
"「・・・は?」"
]
},
{
"id": 718,
"kind": "msg",
"jp": [
"「僕は一柳和・・・って、いや、",
"それどころじゃないんだってば!",
"死んでる人がいたんだから!」"
]
},
{
"id": 719,
"kind": "msg",
"jp": [
"「何がいた、ですって?」"
]
},
{
"id": 720,
"kind": "msg",
"jp": [
"「死んでる人が!",
"表で、人が死んでたんだよ!」"
]
},
{
"id": 721,
"kind": "msg",
"jp": [
"ざわ、と室内の空気が一変した。",
"遠巻きに様子を見ていた他の人達の視線が",
"僕の方へ集中する。"
]
},
{
"id": 722,
"kind": "msg",
"jp": [
"「・・・確かですかい?」"
]
},
{
"id": 723,
"kind": "msg",
"jp": [
"「間違いないよ、だって僕、",
"その人につまずいちゃって・・・」"
]
},
{
"id": 724,
"kind": "msg",
"jp": [
"「おい、そりゃ大変じゃないか!",
"君、どこだいその人は?」"
]
},
{
"id": 725,
"kind": "msg",
"jp": [
"駆け寄って来たのは、大柄な男性だった。",
"がしっ、と大きな手で僕の肩をつかみ、",
"真剣な顔でまくし立てる。"
]
},
{
"id": 726,
"kind": "msg",
"jp": [
"「まだ息があったらえらいことだよ、",
"早く捜して見つけないと!!」"
]
},
{
"id": 727,
"kind": "msg",
"jp": [
"「さあ、案内してくれ!",
"裏口の方だね? すぐ外かな?",
"まあいい、さあ行こう!」"
]
},
{
"id": 728,
"kind": "msg",
"jp": [
"「え、あの、はい」"
]
},
{
"id": 729,
"kind": "msg",
"jp": [
"太い腕でひょい、と立ち上がらされて",
"有無を言わさず引きずって行かれる。"
]
},
{
"id": 730,
"kind": "msg",
"jp": [
"「ちょっとちょっと、<co 0f0>{那/な}{須/す}<co>さん!",
"無茶しねえで下さいよ、その人",
"怪我人なんですぜ?」"
]
},
{
"id": 731,
"kind": "msg",
"jp": [
"「んっ? あ、忘れてた!",
"すまん、大丈夫かい?」"
]
},
{
"id": 732,
"kind": "msg",
"jp": [
"「・・・・・・ええ」"
]
},
{
"id": 733,
"kind": "msg",
"jp": [
"「そうか、じゃあ行こう!」"
]
},
{
"id": 734,
"kind": "msg",
"jp": [
"<fs 120>「え、えええ?」<fs>"
]
},
{
"id": 735,
"kind": "msg",
"jp": [
"「担げばいいってもんでも",
"ありませんって!」"
]
},
{
"id": 736,
"kind": "msg",
"jp": [
"「まったく、那須さんは",
"しょうがねえなぁ・・・」"
]
},
{
"id": 737,
"kind": "msg",
"jp": [
"「うわっ、まだすごい雨だなあ!」"
]
},
{
"id": 738,
"kind": "msg",
"jp": [
"那須さん、と言うらしい人は、",
"妙に嬉しそうに嵐の空をながめる。"
]
},
{
"id": 739,
"kind": "msg",
"jp": [
"「うわぁっ!?」"
]
},
{
"id": 740,
"kind": "msg",
"jp": [
"「おお、雷だ!",
"今の見た? きれいな稲光だったなあ」"
]
},
{
"id": 741,
"kind": "msg",
"jp": [
"「確かに見事なもんでしたがね、",
"嬉しそうに言わねえで下さいよ」"
]
},
{
"id": 742,
"kind": "msg",
"jp": [
"やれやれ、といった調子で言いながら",
"日織は、身をすくめる僕に苦笑いして",
"見せた。"
]
},
{
"id": 743,
"kind": "msg",
"jp": [
"「・・・豪快な人ですね」"
]
},
{
"id": 744,
"kind": "msg",
"jp": [
"「見物に行きたいっての",
"必死に止めたんですよ、さっきも」"
]
},
{
"id": 745,
"kind": "msg",
"jp": [
"「まあ、おかげで廊下で騒いで",
"ましたから、あんたが倒れたらしい",
"物音も聞こえたんですがね」"
]
},
{
"id": 746,
"kind": "msg",
"jp": [
"運が良かったのかもしれないけど、",
"なんだかなぁ・・・。"
]
},
{
"id": 747,
"kind": "msg",
"jp": [
"「ちょいと、那須さん。",
"嵐見物に来たんじゃねえでしょう」"
]
},
{
"id": 748,
"kind": "msg",
"jp": [
"「傘も大して役に立たねえし、",
"早くしねえとまたずぶぬれに",
"なっちまいますぜ」"
]
},
{
"id": 749,
"kind": "msg",
"jp": [
"「ああ、そうだった!",
"さっき風呂に入ったばかりなのにな、",
"すっかり忘れてた!」"
]
},
{
"id": 750,
"kind": "msg",
"jp": [
"「えーと・・・なんだっけ?」"
]
},
{
"id": 751,
"kind": "msg",
"jp": [
"「人が死んでたんですけど!?」"
]
},
{
"id": 752,
"kind": "msg",
"jp": [
"「そうか、それだ!",
"よし、行こう!」"
]
},
{
"id": 753,
"kind": "msg",
"jp": [
"「行こうって、どこへです」"
]
},
{
"id": 754,
"kind": "msg",
"jp": [
"「・・・どこだい?」"
]
},
{
"id": 755,
"kind": "msg",
"jp": [
"「え、えーと・・・。",
"僕は・・・あ、そうだ、あの井戸!",
"あっちから来たんだ」"
]
},
{
"id": 756,
"kind": "msg",
"jp": [
"「で、この辺で死んでる人に",
"つまずいちゃって・・・」"
]
},
{
"id": 757,
"kind": "msg",
"jp": [
"・・・と、指さした所にあるのは、",
"ぬかるんだ地面だけだった。"
]
},
{
"id": 758,
"kind": "msg",
"jp": [
"「あれ!?」"
]
},
{
"id": 759,
"kind": "msg",
"jp": [
"「何もないように見えるんだけど」"
]
},
{
"id": 760,
"kind": "msg",
"jp": [
"「あ・・・あれ・・・?」"
]
},
{
"id": 761,
"kind": "msg",
"jp": [
"「ここって、ちょうど",
"あんたが倒れてた辺りですぜ」"
]
},
{
"id": 762,
"kind": "msg",
"jp": [
"「うん、そうだった。",
"裏口のすぐ側だったな」"
]
},
{
"id": 763,
"kind": "msg",
"jp": [
"「こ、こんな近くだったの!?」"
]
},
{
"id": 764,
"kind": "msg",
"jp": [
"「そうですぜ。",
"俺らが来たときから、他には誰も",
"見あたりませんでしたが」"
]
},
{
"id": 765,
"kind": "msg",
"jp": [
"「で、死んでる人はどこだい?」"
]
},
{
"id": 766,
"kind": "msg",
"jp": [
"「え、あの・・・僕、その人に",
"つまずいた後すぐに気を失っちゃった",
"みたいで・・・」"
]
},
{
"id": 767,
"kind": "msg",
"jp": [
"「・・・だったら、一緒に倒れて",
"ねえとおかしいでしょう」"
]
},
{
"id": 768,
"kind": "msg",
"jp": [
"「・・・・・そうですよね」"
]
},
{
"id": 769,
"kind": "msg",
"jp": [
"「ん? じゃあその人はどこに",
"行っちゃったんだ?」"
]
},
{
"id": 770,
"kind": "msg",
"jp": [
"「さあ・・・死人が歩いて",
"いなくなるわけもねえですし」"
]
},
{
"id": 771,
"kind": "msg",
"jp": [
"「こ、怖いこと言わないで!」"
]
},
{
"id": 772,
"kind": "msg",
"jp": [
"「そうか!",
"いなくなったってことは、",
"死んでなかったんだな!」"
]
},
{
"id": 773,
"kind": "msg",
"jp": [
"「生きてたとしたって、",
"どこ行くんですかい」"
]
},
{
"id": 774,
"kind": "msg",
"jp": [
"「・・・・病院とか?」"
]
},
{
"id": 775,
"kind": "msg",
"jp": [
"「近くにあるんですか?」"
]
},
{
"id": 776,
"kind": "msg",
"jp": [
"「あったら、とっくにあんたも",
"担ぎ込んでまさぁね」"
]
},
{
"id": 777,
"kind": "msg",
"jp": [
"「ふもとの街まで降りなきゃ",
"ありませんぜ」"
]
},
{
"id": 778,
"kind": "msg",
"jp": [
"「歩いて行っちゃったのか。",
"無謀だなあ、ぼくでも遠慮するよ」"
]
},
{
"id": 779,
"kind": "msg",
"jp": [
"「なんでそれで納得出来るんですか、",
"あんたって人は・・・」"
]
},
{
"id": 780,
"kind": "msg",
"jp": [
"「だって死んでたなら、ここに",
"居なきゃおかしいじゃないか?」"
]
},
{
"id": 781,
"kind": "msg",
"jp": [
"「そりゃそうなんですがね。",
"死体があったってぇのは、",
"確かにこの辺りですかい?」"
]
},
{
"id": 782,
"kind": "msg",
"jp": [
"「うん、だってあの井戸の横を",
"通ってこっちに来たのは確かに",
"覚えてるし・・・」"
]
},
{
"id": 783,
"kind": "msg",
"jp": [
"でも、何度見回してみてもそこには",
"死体なんて存在しない。"
]
},
{
"id": 784,
"kind": "msg",
"jp": [
"「・・・なんで、",
"いなくなってるんだよ・・・」"
]
},
{
"id": 785,
"kind": "msg",
"jp": [
"確かに見たのに。",
"つまずいたときの感触も、水に濡れた",
"背広の色もはっきり覚えてるのに。"
]
},
{
"id": 786,
"kind": "msg",
"jp": [
"「水くさい人だなぁ。",
"こんな時間に歩いて帰らなくても、",
"泊まってけばいいのに」"
]
},
{
"id": 787,
"kind": "msg",
"jp": [
"「そういう問題じゃ",
"ねえでしょう・・・」"
]
},
{
"id": 788,
"kind": "msg",
"jp": [
"「何か見つかりましたか?」"
]
},
{
"id": 789,
"kind": "msg",
"jp": [
"「いやあ、どうやら歩いて・・・」"
]
},
{
"id": 790,
"kind": "msg",
"jp": [
"「見あたりませんや、",
"俺らも戻りますよ」"
]
},
{
"id": 791,
"kind": "msg",
"jp": [
"かえって混乱させそうな那須さんの",
"言葉を日織がさえぎった。"
]
},
{
"id": 792,
"kind": "msg",
"jp": [
"「さ、一柳さん。",
"戻りましょう」"
]
},
{
"id": 793,
"kind": "msg",
"jp": [
"「う、うん・・・。",
"あの、でも僕・・・」"
]
},
{
"id": 794,
"kind": "msg",
"jp": [
"「そんな顔しなさんなって。",
"俺はあんたが嘘ついてるとは",
"思ってませんぜ」"
]
},
{
"id": 795,
"kind": "msg",
"jp": [
"「え、でも・・・」"
]
},
{
"id": 796,
"kind": "msg",
"jp": [
"「確かに、死体はありませんがね。",
"頭打ってる間に、悪い夢でも",
"見ちまったんじゃねえですかい?」"
]
},
{
"id": 797,
"kind": "msg",
"jp": [
"「夢・・・?",
"そ、そうかな・・・」"
]
},
{
"id": 798,
"kind": "msg",
"jp": [
"それにしては、異常にリアルな感触が",
"残ってるんだけど・・・。"
]
},
{
"id": 799,
"kind": "msg",
"jp": [
"「とりあえず戻りましょう。",
"こんなとこにいて、",
"傷に響いちゃいけねえや」"
]
}
]