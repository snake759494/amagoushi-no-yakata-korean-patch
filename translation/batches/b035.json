[
{
"id": 18683,
"kind": "msg",
"jp": [
"「あー、そうなんちゃう?」"
]
},
{
"id": 18684,
"kind": "msg",
"jp": [
"「うち普段は料理とかほとんど",
"せぇへんから知らんけど」"
]
},
{
"id": 18685,
"kind": "msg",
"jp": [
"「あれ、そうなの?」"
]
},
{
"id": 18686,
"kind": "msg",
"jp": [
"「お姉ちゃんはわりと好きやから",
"まかせっきりやねん」"
]
},
{
"id": 18687,
"kind": "msg",
"jp": [
"「ふーん」"
]
},
{
"id": 18688,
"kind": "msg",
"jp": [
"「応接室って入ったことあったっけ」"
]
},
{
"id": 18689,
"kind": "msg",
"jp": [
"「うん、来たときのぞいてみた。",
"何の部屋かなーと思って」"
]
},
{
"id": 18690,
"kind": "msg",
"jp": [
"「けど別に何も無かったし、",
"すぐ出たけどね」"
]
},
{
"id": 18691,
"kind": "msg",
"jp": [
"「娯楽室っていろんな物",
"置いてあるよね」"
]
},
{
"id": 18692,
"kind": "msg",
"jp": [
"「そやねぇ、",
"お姉ちゃんがなんかダーツ触りたそうに",
"しとったけど・・・」"
]
},
{
"id": 18693,
"kind": "msg",
"jp": [
"「遊んだの?」"
]
},
{
"id": 18694,
"kind": "msg",
"jp": [
"「いや、止めた。",
"お姉ちゃん実は運動神経ないから",
"変なとこに投げそうやもん」"
]
},
{
"id": 18695,
"kind": "msg",
"jp": [
"「高いもんばっかりみたいやし",
"うっかり壊したら怖いやん」"
]
},
{
"id": 18696,
"kind": "msg",
"jp": [
"「書斎の中見たことある?",
"なんかすごいよ」"
]
},
{
"id": 18697,
"kind": "msg",
"jp": [
"「あぁ、見た見た。",
"難しそうな本ばっかりやから",
"めまいしそうやったけど・・・」"
]
},
{
"id": 18698,
"kind": "msg",
"jp": [
"「よぉ見たらなんか普通の",
"週刊誌が混ざってる棚もあったわ」"
]
},
{
"id": 18699,
"kind": "msg",
"jp": [
"「他はほとんど洋書みたいだよ。",
"英語じゃなさそうだったけど」"
]
},
{
"id": 18700,
"kind": "msg",
"jp": [
"「そんなんよぉ読まへん」"
]
},
{
"id": 18701,
"kind": "msg",
"jp": [
"「僕も・・・」"
]
},
{
"id": 18702,
"kind": "msg",
"jp": [
"「物置の中ってのぞいたことある?」"
]
},
{
"id": 18703,
"kind": "msg",
"jp": [
"「お姉ちゃんがごそごそやってたから",
"止めたときにね・・・」"
]
},
{
"id": 18704,
"kind": "msg",
"jp": [
"「なんでああ、変なところに",
"入りたがるんかなあ」"
]
},
{
"id": 18705,
"kind": "msg",
"jp": [
"「・・・普段からそうなの?」"
]
},
{
"id": 18706,
"kind": "msg",
"jp": [
"「今まで何回テレビ局の美術倉庫やら",
"大道具通路やらに入り込んで迷ったか",
"わからへん」"
]
},
{
"id": 18707,
"kind": "msg",
"jp": [
"趣味なのか、変なところに潜り込むの。"
]
},
{
"id": 18708,
"kind": "msg",
"jp": [
"「この館の部屋ってみんな",
"豪華ですごいね」"
]
},
{
"id": 18709,
"kind": "msg",
"jp": [
"「すごいけど、普段から1人で",
"使うにはちょっと広すぎやね」"
]
},
{
"id": 18710,
"kind": "msg",
"jp": [
"「うちはこの半分でええわ、",
"あんまり広いと落ちつかへん」"
]
},
{
"id": 18711,
"kind": "msg",
"jp": [
"「あ、僕も・・・」"
]
},
{
"id": 18712,
"kind": "msg",
"jp": [
"「お互い貧乏性やなあ。",
"しゃあないけどさ」"
]
},
{
"id": 18713,
"kind": "msg",
"jp": [
"「2階のそっち側にひとつだけ",
"他と違う感じの部屋があるよね」"
]
},
{
"id": 18714,
"kind": "msg",
"jp": [
"「なんか開かずの間とかいうあれ?",
"この家の人が使ってはる部屋なんやろ、",
"うち入ったことないんやけど」"
]
},
{
"id": 18715,
"kind": "msg",
"jp": [
"「多分そうなんじゃないかな」"
]
},
{
"id": 18716,
"kind": "msg",
"jp": [
"「ふぅん、ほなあんまり",
"入らん方がええんちゃうかなぁ」"
]
},
{
"id": 18717,
"kind": "msg",
"jp": [
"「すぐそこに納戸があるけど",
"見たことある?」"
]
},
{
"id": 18718,
"kind": "msg",
"jp": [
"「ああ、この部屋の外にあるやつ?",
"開けて見たけど単なる物置みたい",
"やったよ」"
]
},
{
"id": 18719,
"kind": "msg",
"jp": [
"「今の騒ぎが起きる前に",
"地下室に降りたことはある?」"
]
},
{
"id": 18720,
"kind": "msg",
"jp": [
"「うん、最初の日にね。",
"ボイラーがあるからって使い方",
"教えてもろたん」"
]
},
{
"id": 18721,
"kind": "msg",
"jp": [
"「他は倉庫しかないって",
"聞いたしうろうろはしてへんけど」"
]
},
{
"id": 18722,
"kind": "msg",
"jp": [
"「そっか。",
"使い方教えてくれたのって",
"椿くん?」"
]
},
{
"id": 18723,
"kind": "msg",
"jp": [
"「うん、そう、執事さん」"
]
},
{
"id": 18724,
"kind": "msg",
"jp": [
"「地下に迷路みたいなのが",
"あったんだよ」"
]
},
{
"id": 18725,
"kind": "msg",
"jp": [
"「そんなんあるの!?",
"どんな館やねんな、ここ・・・」"
]
},
{
"id": 18726,
"kind": "msg",
"jp": [
"「なんか普通の別荘ってわけじゃ",
"なかったみたいだね」"
]
},
{
"id": 18727,
"kind": "msg",
"jp": [
"「ねえ、その地下迷路って",
"誰か隠れてたりせんやろね?」"
]
},
{
"id": 18728,
"kind": "msg",
"jp": [
"「い、一応僕の見た範囲には",
"誰も居なかったけど・・・」"
]
},
{
"id": 18729,
"kind": "msg",
"jp": [
"本当に誰かいたらどうしよう・・・。"
]
},
{
"id": 18730,
"kind": "msg",
"jp": [
"「うん、あるね。",
"井戸がどうしたん?」"
]
},
{
"id": 18731,
"kind": "msg",
"jp": [
"「あれってもう使われて",
"ないのかな」"
]
},
{
"id": 18732,
"kind": "msg",
"jp": [
"「そうなんちゃう?",
"なんか蓋してあるし」"
]
},
{
"id": 18733,
"kind": "msg",
"jp": [
"「だね・・・」"
]
},
{
"id": 18734,
"kind": "msg",
"jp": [
"「部屋の名前のこと",
"なんだけどさ」"
]
},
{
"id": 18735,
"kind": "msg",
"jp": [
"「ああ、なんか全部作家の",
"名前らしいね」"
]
},
{
"id": 18736,
"kind": "msg",
"jp": [
"「お姉ちゃんがあれこれ",
"説明してくれたけど、",
"なんかよぉわからんかった」"
]
},
{
"id": 18737,
"kind": "msg",
"jp": [
"「ふうん?",
"静奈ちゃんは詳しいんだ」"
]
},
{
"id": 18738,
"kind": "msg",
"jp": [
"「まあ、お姉ちゃん",
"推理作家は大抵知ってるからなぁ」"
]
},
{
"id": 18739,
"kind": "msg",
"jp": [
"「・・・そういや、",
"うちとお姉ちゃんの部屋の名前って",
"実は同じ人やとか言うてたな」"
]
},
{
"id": 18740,
"kind": "msg",
"jp": [
"「へ? 同じ人?」"
]
},
{
"id": 18741,
"kind": "msg",
"jp": [
"「同じ作家の別の",
"ペンネームやとかなんとか」"
]
},
{
"id": 18742,
"kind": "msg",
"jp": [
"「詳しいことはよぉわからんから",
"お姉ちゃんに聞いて。",
"自分の部屋の作家のこと教えろって」"
]
},
{
"id": 18743,
"kind": "msg",
"jp": [
"「うん、わかった。",
"ありがとう」"
]
},
{
"id": 18744,
"kind": "msg",
"jp": [
"「地下室にあった長持",
"なんだけどさ・・・」"
]
},
{
"id": 18745,
"kind": "msg",
"jp": [
"「・・・執事さんが",
"入れられてたやつ?」"
]
},
{
"id": 18746,
"kind": "msg",
"jp": [
"「あれ、事件より前に触ったり",
"開けてみたりしたことある?」"
]
},
{
"id": 18747,
"kind": "msg",
"jp": [
"「ううん、ないよ。",
"元からあそこにあったんかどうかも",
"よぉ覚えてへんわ」"
]
},
{
"id": 18748,
"kind": "msg",
"jp": [
"「那須さんが・・・",
"飲んじゃったお茶なんだけど・・」"
]
},
{
"id": 18749,
"kind": "msg",
"jp": [
"「うち、最初の日に同じの",
"飲んだ・・・」"
]
},
{
"id": 18750,
"kind": "msg",
"jp": [
"「そうだったの?」"
]
},
{
"id": 18751,
"kind": "msg",
"jp": [
"「うん、冷蔵庫にいっぱいあったから。",
"当然何とも無かったんやけどさ」"
]
},
{
"id": 18752,
"kind": "msg",
"jp": [
"「最初から冷蔵庫に変なお茶が入ってた",
"わけやないんとちゃう?",
"でないと誰が飲んでまうかわからんし」"
]
},
{
"id": 18753,
"kind": "msg",
"jp": [
"「あの、毒薬ってさ・・・」"
]
},
{
"id": 18754,
"kind": "msg",
"jp": [
"「毒は卑怯やわ!",
"そんなんどうしようもないやん?」"
]
},
{
"id": 18755,
"kind": "msg",
"jp": [
"「まあ、那須さん相手にどうにか",
"しようと思たら他に方法なかった",
"かもしれんけどさあ」"
]
},
{
"id": 18756,
"kind": "msg",
"jp": [
"「・・・他の方法・・・」"
]
},
{
"id": 18757,
"kind": "msg",
"jp": [
"「だって首しめるとか刺すとかじゃ",
"反撃されて犯人のが負けそうやん」"
]
},
{
"id": 18758,
"kind": "msg",
"jp": [
"「だろうね・・・。",
"普通に攻撃してもなんか効かない",
"ような気がするし・・・」"
]
},
{
"id": 18759,
"kind": "msg",
"jp": [
"「だからって、毒はひどいわ。",
"なんか・・・なんか悔しい・・・」"
]
},
{
"id": 18760,
"kind": "msg",
"jp": [
"「暗石さんの部屋に、",
"薔薇の絵が置いてあったんだ」"
]
},
{
"id": 18761,
"kind": "msg",
"jp": [
"「・・・置いてあったって、",
"元から部屋の壁に飾ってあった",
"やつとは違うのがあったてこと?」"
]
},
{
"id": 18762,
"kind": "msg",
"jp": [
"「うん、壁に飾ってある絵は",
"そのままだったし違う絵だった」"
]
},
{
"id": 18763,
"kind": "msg",
"jp": [
"「ふぅん・・・?",
"どこにあった絵なんやろ」"
]
},
{
"id": 18764,
"kind": "msg",
"jp": [
"「応接室じゃないかって。",
"見た覚えない?」"
]
},
{
"id": 18765,
"kind": "msg",
"jp": [
"「んー、覚えてへんわ。",
"どこにどんなんが飾ってあったか",
"そない注意して見てへんし」"
]
},
{
"id": 18766,
"kind": "msg",
"jp": [
"「あのさ・・・",
"暗石さんのときの凶器って",
"矢だったんだけどさ・・・」"
]
},
{
"id": 18767,
"kind": "msg",
"jp": [
"「・・・なんでまたそんな",
"特殊なもん{使/つこ}たんやろう?」"
]
},
{
"id": 18768,
"kind": "msg",
"jp": [
"「うち、弓なんかよう引かんで。",
"撮影で触ったことあるけど、",
"ものすごい力いるんやもん」"
]
},
{
"id": 18769,
"kind": "msg",
"jp": [
"「素人がいきなり引ける",
"もんと違うわ、あんなん」"
]
},
{
"id": 18770,
"kind": "msg",
"jp": [
"「あのてるてる坊主さ、",
"最初は2階の吹き抜けんとこに",
"あったらしいけど、見た?」"
]
},
{
"id": 18771,
"kind": "msg",
"jp": [
"「なんかそうらしいね。",
"お姉ちゃんが言うてたわ」"
]
},
{
"id": 18772,
"kind": "msg",
"jp": [
"「うちが部屋戻って寝た後の話",
"みたいやから直接は見てへんねん」"
]
},
{
"id": 18773,
"kind": "msg",
"jp": [
"「ああ、そうだよね」"
]
},
{
"id": 18774,
"kind": "msg",
"jp": [
"「御陵さんは見てんちゃう?",
"うちが部屋戻ったときちょうど",
"部屋出て行かはったんやし」"
]
},
{
"id": 18775,
"kind": "msg",
"jp": [
"「・・・あー、でも",
"トイレとかやったら見てないか」"
]
},
{
"id": 18776,
"kind": "msg",
"jp": [
"「いや、台所に降りてた",
"みたいだよ」"
]
},
{
"id": 18777,
"kind": "msg",
"jp": [
"「ふーん、そうなんや」"
]
},
{
"id": 18778,
"kind": "msg",
"jp": [
"「温室に『復讐』とか書いてある",
"紙があったけどさ、あれって",
"いつ置かれたんだろう」"
]
},
{
"id": 18779,
"kind": "msg",
"jp": [
"「うちら、来た後で館の中ちょっと",
"うろうろしてんけどさ・・・」"
]
},
{
"id": 18780,
"kind": "msg",
"jp": [
"「その時温室ものぞいてみたけど",
"あんなん無かったよ」"
]
},
{
"id": 18781,
"kind": "msg",
"jp": [
"「それって何時ごろかな?」"
]
},
{
"id": 18782,
"kind": "msg",
"jp": [
"「多分、1時くらいやったと思うよ」"
]
},
{
"id": 18783,
"kind": "msg",
"jp": [
"「他の人たちはもう来てた?」"
]
},
{
"id": 18784,
"kind": "msg",
"jp": [
"「ううん・・・",
"あ、執事さんはおったわ」"
]
},
{
"id": 18785,
"kind": "msg",
"jp": [
"「もうあの格好してて、",
"『いらっしゃいませ』て言われた」"
]
},
{
"id": 18786,
"kind": "msg",
"jp": [
"「執事として出迎えたの?」"
]
},
{
"id": 18787,
"kind": "msg",
"jp": [
"「うん、そう。",
"もうカメラ回ってんのって",
"言うたん覚えてるわ」"
]
},
{
"id": 18788,
"kind": "msg",
"jp": [
"「温室にあった黒猫の置物",
"なんだけどさ」"
]
},
{
"id": 18789,
"kind": "msg",
"jp": [
"「ああ、あれ・・・」"
]
},
{
"id": 18790,
"kind": "msg",
"jp": [
"「あれって普通は何に使うもん?",
"単なる置物?」"
]
},
{
"id": 18791,
"kind": "msg",
"jp": [
"「そうなんじゃないかな、",
"よくわかんないけど」"
]
},
{
"id": 18792,
"kind": "msg",
"jp": [
"「他に使い道ありそうにもないし",
"そうなんやろなあ」"
]
},
{
"id": 18793,
"kind": "msg",
"jp": [
"「けど、この館に元からあったに",
"しては安っぽいよね」"
]
},
{
"id": 18794,
"kind": "msg",
"jp": [
"「うん、僕もそう思う」"
]
},
{
"id": 18795,
"kind": "msg",
"jp": [
"「ここの電話って内線しか",
"使えないんだよね」"
]
},
{
"id": 18796,
"kind": "msg",
"jp": [
"「そうみたいやね。",
"まあ、いちいち隣行かんですむから",
"楽でええけど」"
]
},
{
"id": 18797,
"kind": "msg",
"jp": [
"「隣って静奈ちゃん?」"
]
},
{
"id": 18798,
"kind": "msg",
"jp": [
"「うん、携帯も通じてへんから",
"内線なかったらいちいちお姉ちゃん",
"起きるまでドア叩く羽目になってたわ」"
]
},
{
"id": 18799,
"kind": "msg",
"jp": [
"「寝起き悪いの?」"
]
},
{
"id": 18800,
"kind": "msg",
"jp": [
"「・・・なんていうか",
"日によって違う」"
]
},
{
"id": 18801,
"kind": "msg",
"jp": [
"どんな寝起きなんだ・・・。"
]
},
{
"id": 18802,
"kind": "msg",
"jp": [
"「娯楽室のラジオって",
"自分で触ったことある?」"
]
},
{
"id": 18803,
"kind": "msg",
"jp": [
"「そう言えばうち、ないわ。",
"音楽は自分のMDで聞くしなぁ」"
]
},
{
"id": 18804,
"kind": "msg",
"jp": [
"「応接室に、なんか変な仮面が",
"飾ってあるよね」"
]
},
{
"id": 18805,
"kind": "msg",
"jp": [
"「仮面?",
"あぁ、なんかあった気がするけど",
"応接室やったっけ、あれ」"
]
},
{
"id": 18806,
"kind": "msg",
"jp": [
"「うん、5つくらいある」"
]
},
{
"id": 18807,
"kind": "msg",
"jp": [
"「・・・あー、あったあった。",
"どっかの民芸品みたいなやつね」"
]
},
{
"id": 18808,
"kind": "msg",
"jp": [
"「あれがどうかしたん?」"
]
},
{
"id": 18809,
"kind": "msg",
"jp": [
"「なんか怖くない?」"
]
},
{
"id": 18810,
"kind": "msg",
"jp": [
"「・・・お兄さん、",
"怖いもん多すぎ」"
]
},
{
"id": 18811,
"kind": "msg",
"jp": [
"そうかな・・・。"
]
},
{
"id": 18812,
"kind": "msg",
"jp": [
"「玄関ホールにある",
"大時計すごいよね」"
]
},
{
"id": 18813,
"kind": "msg",
"jp": [
"「あれってどれくらい動いてんねやろ、",
"百年くらい余裕で動いてそうやんね」"
]
},
{
"id": 18814,
"kind": "msg",
"jp": [
"「アンティークみたいだから",
"動いてるかもね」"
]
},
{
"id": 18815,
"kind": "msg",
"jp": [
"「ええなあ、あれはカッコええよね。",
"けど、うちの家じゃ置くとこないわ」"
]
},
{
"id": 18816,
"kind": "msg",
"jp": [
"「僕の家も・・・」"
]
},
{
"id": 18817,
"kind": "msg",
"jp": [
"「温室に置いてあったベルって",
"何かの飾りかな」"
]
},
{
"id": 18818,
"kind": "msg",
"jp": [
"「クリスマスツリーとかに",
"飾るやつとちゃう?」"
]
},
{
"id": 18819,
"kind": "msg",
"jp": [
"「やっぱりそうだよね。",
"今の時期でも売ってるのかな」"
]
},
{
"id": 18820,
"kind": "msg",
"jp": [
"「あの手のちゃちい飾りもんって",
"百均とか行ったら転がってるで」"
]
},
{
"id": 18821,
"kind": "msg",
"jp": [
"「温室に長い釘が置いて",
"あっただろ?」"
]
},
{
"id": 18822,
"kind": "msg",
"jp": [
"「釘?",
"ああ、あれね」"
]
},
{
"id": 18823,
"kind": "msg",
"jp": [
"「五寸釘っていうやつだよね」"
]
},
{
"id": 18824,
"kind": "msg",
"jp": [
"「あんなんどこで手に入れて",
"来るんかなあ。",
"この家にはないよね、元からは」"
]
},
{
"id": 18825,
"kind": "msg",
"jp": [
"「ないんじゃないかな、多分」"
]
},
{
"id": 18826,
"kind": "msg",
"jp": [
"「温室にひらひらの長い手袋が",
"置いてあってさ・・・」"
]
},
{
"id": 18827,
"kind": "msg",
"jp": [
"「ひらひら?",
"礼装用のってこと?」"
]
},
{
"id": 18828,
"kind": "msg",
"jp": [
"「みたいなんだけど、",
"そうなのかな」"
]
},
{
"id": 18829,
"kind": "msg",
"jp": [
"「うーん、うちもそんなん",
"使うことないしわからんわ」"
]
},
{
"id": 18830,
"kind": "msg",
"jp": [
"「だよね。",
"普段使いそうなデザインじゃ",
"なかったもんな」"
]
},
{
"id": 18831,
"kind": "msg",
"jp": [
"「今度は手斧が置いてあったよ",
"温室に・・・」"
]
},
{
"id": 18832,
"kind": "msg",
"jp": [
"「斧?",
"いややわ、物騒やなぁ」"
]
},
{
"id": 18833,
"kind": "msg",
"jp": [
"「いつの間に置いてってんのかな、",
"やっぱり夜中とか?」"
]
},
{
"id": 18834,
"kind": "msg",
"jp": [
"「そうなんじゃないかな。",
"昼間は誰が見てるかわからないし」"
]
},
{
"id": 18835,
"kind": "msg",
"jp": [
"「・・・温室で見張ってたら",
"捕まえられへんやろか」"
]
},
{
"id": 18836,
"kind": "msg",
"jp": [
"「それはさすがに警戒してる",
"だろうから、見張ってたら",
"来ないんじゃないかな」"
]
},
{
"id": 18837,
"kind": "msg",
"jp": [
"「そうやろか」"
]
},
{
"id": 18838,
"kind": "msg",
"jp": [
"「だって・・・温室にこだわって",
"犯行がばれちゃったら・・・」"
]
},
{
"id": 18839,
"kind": "msg",
"jp": [
"「・・・残りが実行出来んか。",
"そやね・・・」"
]
},
{
"id": 18840,
"kind": "msg",
"jp": [
"「・・・『復讐』とか",
"言うてるくらいやもんね・・・」"
]
},
{
"id": 18841,
"kind": "msg",
"jp": [
"「温室に小さい柵が置いて",
"あったんだけどさ・・・」"
]
},
{
"id": 18842,
"kind": "msg",
"jp": [
"「柵? なんの?」"
]
},
{
"id": 18843,
"kind": "msg",
"jp": [
"「よくわからないけど、",
"何かの飾りか園芸用か、そんなの」"
]
},
{
"id": 18844,
"kind": "msg",
"jp": [
"「園芸ねえ・・・。",
"興味ないんよね、ガーデニングとか」"
]
},
{
"id": 18845,
"kind": "msg",
"jp": [
"「那須さんが持ってきた",
"ダンベル知ってる?」"
]
},
{
"id": 18846,
"kind": "msg",
"jp": [
"「あー、なんか大量にあったね」"
]
},
{
"id": 18847,
"kind": "msg",
"jp": [
"「わざわざ家から持ってくる",
"なんてすごいよね」"
]
},
{
"id": 18848,
"kind": "msg",
"jp": [
"「・・・あの人きっと",
"あれ取り上げたら死ぬんちゃう」"
]
},
{
"id": 18849,
"kind": "msg",
"jp": [
"「し、死んじゃうの?」"
]
},
{
"id": 18850,
"kind": "msg",
"jp": [
"「禁断症状とかで」"
]
},
{
"id": 18851,
"kind": "msg",
"jp": [
"・・・あり得そうだから怖い。"
]
},
{
"id": 18852,
"kind": "msg",
"jp": [
"「斑井さんの部屋にあった",
"変な形の杖知ってる?」"
]
},
{
"id": 18853,
"kind": "msg",
"jp": [
"「杖?",
"・・・ああ、知ってるわ」"
]
},
{
"id": 18854,
"kind": "msg",
"jp": [
"「お姉ちゃんが見せてもろてた。",
"別に形が変わってるだけで",
"普通の杖やったみたいやけど」"
]
},
{
"id": 18855,
"kind": "msg",
"jp": [
"「うん、使いにくそうだけどね」"
]
},
{
"id": 18856,
"kind": "msg",
"jp": [
"「実用品やないんちゃう?",
"飾るんかなんかしらんけど」"
]
},
{
"id": 18857,
"kind": "msg",
"jp": [
"「そうかもね」"
]
},
{
"id": 18858,
"kind": "msg",
"jp": [
"「この館、いっぱい絵が",
"飾ってあるよね」"
]
},
{
"id": 18859,
"kind": "msg",
"jp": [
"「そやね。",
"描いたん同じ人みたいやし",
"集めてはるんかな」"
]
},
{
"id": 18860,
"kind": "msg",
"jp": [
"「え? 全部?」"
]
},
{
"id": 18861,
"kind": "msg",
"jp": [
"「うん、すみっこの方に",
"小さく同じサイン入ってたもん」"
]
},
{
"id": 18862,
"kind": "msg",
"jp": [
"「けど、上手いけど",
"全然見たことない絵ばっかりやわ。",
"無名な人のなんかな」"
]
},
{
"id": 18863,
"kind": "msg",
"jp": [
"「そうなんじゃない?",
"きれいだけどね」"
]
},
{
"id": 18864,
"kind": "msg",
"jp": [
"「うん、うちは好きやわ」"
]
},
{
"id": 18865,
"kind": "msg",
"jp": [
"「表にある車は那須さんと",
"斑井さんのだよね」"
]
},
{
"id": 18866,
"kind": "msg",
"jp": [
"「そのはずやけど?",
"なんかえらい年季の入った方の",
"車が斑井さんのやろ」"
]
},
{
"id": 18867,
"kind": "msg",
"jp": [
"「年季・・・",
"うん、そうだね」"
]
},
{
"id": 18868,
"kind": "msg",
"jp": [
"「あれはあれですごいと思うわ。",
"実はけっこう物とか大事にしはる",
"人やったんやろか」"
]
},
{
"id": 18869,
"kind": "msg",
"jp": [
"でないと乗れないだろうしな、",
"あんなになるまで・・・。"
]
},
{
"id": 18870,
"kind": "msg",
"jp": [
"「地下にさ、蛇がいっぱい",
"いたんだよ・・・」"
]
},
{
"id": 18871,
"kind": "msg",
"jp": [
"「マジで!?」"
]
},
{
"id": 18872,
"kind": "msg",
"jp": [
"「え、なに?",
"鈴奈ちゃんも苦手なの?」"
]
},
{
"id": 18873,
"kind": "msg",
"jp": [
"「うちは苦手やけど、",
"お姉ちゃんが・・・",
"飼いたがってて困る・・・」"
]
},
{
"id": 18874,
"kind": "msg",
"jp": [
"静奈ちゃんには詳しい場所は",
"教えないようにしよう。"
]
},
{
"id": 18875,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは、",
"普段カップ麺とか食べるの?",
"ここにはたくさんあるけど」"
]
},
{
"id": 18876,
"kind": "msg",
"jp": [
"「うーん、好きやけど肌に悪いから",
"あんまり食べんようにしてる」"
]
},
{
"id": 18877,
"kind": "msg",
"jp": [
"女優さんは大変なんだな。"
]
},
{
"id": 18878,
"kind": "msg",
"jp": [
"「物置にボウガンがしまって",
"あってさあ・・・」"
]
},
{
"id": 18879,
"kind": "msg",
"jp": [
"「ボウガン?",
"なにそれ、物騒やわあ」"
]
},
{
"id": 18880,
"kind": "msg",
"jp": [
"「どっかに隠しといた方が",
"ええんやないの、それ」"
]
},
{
"id": 18881,
"kind": "msg",
"jp": [
"「だよね。",
"気をつけとくよ」"
]
},
{
"id": 18882,
"kind": "msg",
"jp": [
"「廊下に放り出されてる",
"家具があるじゃない?」"
]
},
{
"id": 18883,
"kind": "msg",
"jp": [
"「え?",
"なにそれ、そんなんあった?」"
]
},
{
"id": 18884,
"kind": "msg",
"jp": [
"「あ、知らなかったんだ」"
]
},
{
"id": 18885,
"kind": "msg",
"jp": [
"「気ぃつかんかったわ。",
"なんでそんなことになってんのん?」"
]
},
{
"id": 18886,
"kind": "msg",
"jp": [
"「那須さんがトレーニングマシン",
"持ち込むのに邪魔だからって",
"部屋から出しちゃったんだって」"
]
},
{
"id": 18887,
"kind": "msg",
"jp": [
"「・・・どんだけデカいもん",
"持ち込んでんねんな・・・」"
]
},
{
"id": 18888,
"kind": "msg",
"jp": [
"「睡眠薬って使うことある?」"
]
},
{
"id": 18889,
"kind": "msg",
"jp": [
"「前に一回だけ使ったこと",
"あるんやけどさあ・・・」"
]
},
{
"id": 18890,
"kind": "msg",
"jp": [
"「なんか効きすぎて怖かったわ。",
"うち薬効きやすいねん」"
]
},
{
"id": 18891,
"kind": "msg",
"jp": [
"「細いから普通より少なめに",
"飲まなきゃ駄目なんじゃない?」"
]
},
{
"id": 18892,
"kind": "msg",
"jp": [
"「そうやねん。",
"書いてある通りの量飲んだら",
"きついねん、困るわぁ」"
]
},
{
"id": 18893,
"kind": "msg",
"jp": [
"「なんか地下の部屋に",
"まりもが置いてあってさ」"
]
},
{
"id": 18894,
"kind": "msg",
"jp": [
"「へえ?",
"うちのお姉ちゃんが好きで",
"家でも飼うてるわ」"
]
},
{
"id": 18895,
"kind": "msg",
"jp": [
"「正直、可愛いんかどうか",
"よぉわからへんわ。",
"丸いだけやしなあ」"
]
},
{
"id": 18896,
"kind": "msg",
"jp": [
"「まあ、そうだね・・・」"
]
},
{
"id": 18897,
"kind": "msg",
"jp": [
"「むしろ、まりもに話し掛けてる",
"お姉ちゃんのがおもしろい」"
]
},
{
"id": 18898,
"kind": "msg",
"jp": [
"・・・それはちょっと見たい。"
]
},
{
"id": 18899,
"kind": "msg",
"jp": [
"「赤いカメオって知ってる・・・?」"
]
},
{
"id": 18900,
"kind": "msg",
"jp": [
"「それって怪談の方の?」"
]
},
{
"id": 18901,
"kind": "msg",
"jp": [
"「怪談じゃない方のってあるの?」"
]
},
{
"id": 18902,
"kind": "msg",
"jp": [
"「・・・まあね。",
"今はもうないと思うけど」"
]
},
{
"id": 18903,
"kind": "msg",
"jp": [
"「けど、うちそんなんくれる",
"言われても絶対いらんわ」"
]
},
{
"id": 18904,
"kind": "msg",
"jp": [
"「そりゃだって",
"呪われるんだろ?」"
]
},
{
"id": 18905,
"kind": "msg",
"jp": [
"「うーん、まあね・・・」"
]
},
{
"id": 18906,
"kind": "msg",
"jp": [
"・・・なんだか歯切れが悪いな。"
]
},
{
"id": 18907,
"kind": "msg",
"jp": [
"「温室の奥でこれ見つけたんだ」"
]
},
{
"id": 18908,
"kind": "msg",
"jp": [
"「カセット?",
"何が入ってたん?」"
]
},
{
"id": 18909,
"kind": "msg",
"jp": [
"「ガラスの割れる音」"
]
},
{
"id": 18910,
"kind": "msg",
"jp": [
"「・・・ああ、あれか。",
"ふーん、テープやったんや・・・」"
]
},
{
"id": 18911,
"kind": "msg",
"jp": [
"「けどなんでテープなんやろ。",
"MDでもCDでもなくて」"
]
},
{
"id": 18912,
"kind": "msg",
"jp": [
"「え? さあ・・・",
"なんでだろう」"
]
},
{
"id": 18913,
"kind": "msg",
"jp": [
"MDとか持ってなかったのかな。"
]
},
{
"id": 18914,
"kind": "msg",
"jp": [
"「娯楽室のデッキの中に",
"黒いカセットテープが入っててさ」"
]
},
{
"id": 18915,
"kind": "msg",
"jp": [
"「テープ?",
"何か録音されてんのん?」"
]
},
{
"id": 18916,
"kind": "msg",
"jp": [
"「崖崩れのニュースが",
"入ってた・・・」"
]
},
{
"id": 18917,
"kind": "msg",
"jp": [
"「ニュースってまさか、",
"うちらが聞いたやつ?」"
]
},
{
"id": 18918,
"kind": "msg",
"jp": [
"「ううん、それが",
"僕らが聞いたのとは内容が",
"ちょっと違うんだよ」"
]
},
{
"id": 18919,
"kind": "msg",
"jp": [
"「え? えぇ?",
"どういうこと?」"
]
},
{
"id": 18920,
"kind": "msg",
"jp": [
"「起きた現場とか",
"被害の内容とかが違うから",
"偽物じゃないかなと・・・」"
]
},
{
"id": 18921,
"kind": "msg",
"jp": [
"「ひょっとして、",
"犯人の仕業・・・てこと?」"
]
},
{
"id": 18922,
"kind": "msg",
"jp": [
"「そうじゃないかなと",
"思うんだよ」"
]
},
{
"id": 18923,
"kind": "msg",
"jp": [
"「・・・っていうか、それ以外",
"そんなもん録音したテープが",
"ある理由が思いつかへんね」"
]
},
{
"id": 18924,
"kind": "msg",
"jp": [
"「物置にあったボウガンの",
"矢だけなくなっててさ・・・」"
]
},
{
"id": 18925,
"kind": "msg",
"jp": [
"「へ? なにそれ?",
"なんかやばいんとちゃうの、それ」"
]
},
{
"id": 18926,
"kind": "msg",
"jp": [
"「僕も嫌な予感がするんだけど",
"どうすればいいのか・・・」"
]
},
{
"id": 18927,
"kind": "msg",
"jp": [
"「どうもこうも、撃ったんやったら",
"どっかに矢が刺さってるんやろうから",
"探すしかないんやないの」"
]
},
{
"id": 18928,
"kind": "msg",
"jp": [
"「物置にボウガンがあってさ、",
"矢がなくなってるんだ・・・」"
]
},
{
"id": 18929,
"kind": "msg",
"jp": [
"「・・・それって、",
"暗石さんの・・・あれ?」"
]
},
{
"id": 18930,
"kind": "msg",
"jp": [
"「だと思う。",
"他に弓矢なんて見当たらないし」"
]
},
{
"id": 18931,
"kind": "msg",
"jp": [
"「それ、元から物置にあったん?",
"犯人が持ってきて隠してたんやなくて」"
]
},
{
"id": 18932,
"kind": "msg",
"jp": [
"「額みたいなのに入ってて",
"元は飾り物だったみたいなんだよ」"
]
},
{
"id": 18933,
"kind": "msg",
"jp": [
"「・・・ほな、元からあったんかもね。",
"この家なんかあちこちに武器あるし」"
]
},
{
"id": 18934,
"kind": "msg",
"jp": [
"「これに見覚えない?」"
]
},
{
"id": 18935,
"kind": "msg",
"jp": [
"「・・・万年筆?",
"どっかで見たような気がするけど",
"どこやったかな・・・」"
]
},
{
"id": 18936,
"kind": "msg",
"jp": [
"「少なくとも、うちらのやないで。",
"お姉ちゃんの趣味とも違うし」"
]
},
{
"id": 18937,
"kind": "msg",
"jp": [
"鈴奈ちゃんは誰のものかまで",
"覚えてないようだ。"
]
},
{
"id": 18938,
"kind": "msg",
"jp": [
"「・・・なにこれ?",
"おもちゃにしてはゴツいし、",
"なんかの部品にしては雑っぽいし」"
]
},
{
"id": 18939,
"kind": "msg",
"jp": [
"「ただのがらくたちゃうの?」"
]
},
{
"id": 18940,
"kind": "msg",
"jp": [
"「そうかな」"
]
},
{
"id": 18941,
"kind": "msg",
"jp": [
"「だって何に使うか全然",
"わからへんやん」"
]
},
{
"id": 18942,
"kind": "msg",
"jp": [
"「うーん・・・",
"そうなんだよね・・・」"
]
},
{
"id": 18943,
"kind": "msg",
"jp": [
"「どれ・・?」"
]
},
{
"id": 18944,
"kind": "msg",
"jp": [
"「んー?",
"何やろ、うち花の名前とか",
"さっぱりやからなあ・・・」"
]
},
{
"id": 18945,
"kind": "msg",
"jp": [
"「やっぱり、これだけじゃ",
"わかる人少ないよね」"
]
},
{
"id": 18946,
"kind": "msg",
"jp": [
"「やと思うよ。",
"ちなみにお姉ちゃんもさっぱりやで」"
]
},
{
"id": 18947,
"kind": "msg",
"jp": [
"「けど、これなんで地面に",
"落ちてるん?」"
]
},
{
"id": 18948,
"kind": "msg",
"jp": [
"「置いてあったんだよ、",
"温室の、あの・・・」"
]
},
{
"id": 18949,
"kind": "msg",
"jp": [
"「えっ!?",
"あそこに? あの『復讐』とかの・・」"
]
},
{
"id": 18950,
"kind": "msg",
"jp": [
"「うん、そう・・・」"
]
},
{
"id": 18951,
"kind": "msg",
"jp": [
"「・・・なんか、それ聞いたら",
"急に不気味なもんに見えてくるわ」"
]
},
{
"id": 18952,
"kind": "msg",
"jp": [
"「・・・だね」"
]
},
{
"id": 18953,
"kind": "msg",
"jp": [
"「インプっていうの知ってる?",
"なんか小さい悪魔みたいなの",
"らしいんだけど」"
]
},
{
"id": 18954,
"kind": "msg",
"jp": [
"「はぁ? なにそれ?」"
]
},
{
"id": 18955,
"kind": "msg",
"jp": [
"「全然知らない?」"
]
},
{
"id": 18956,
"kind": "msg",
"jp": [
"「そんな気持ち悪そうなもん",
"知らんけど・・・」"
]
},
{
"id": 18957,
"kind": "msg",
"jp": [
"「そういうのやったら、",
"うちよりお姉ちゃんのが詳しいわ」"
]
},
{
"id": 18958,
"kind": "msg",
"jp": [
"「ただし、そういうネタ振ると",
"もれなく怖い話が山盛りついて",
"くるけどな」"
]
},
{
"id": 18959,
"kind": "msg",
"jp": [
"「・・・来なくていいのに・・・」"
]
},
{
"id": 18960,
"kind": "msg",
"jp": [
"「無理。",
"お姉ちゃん、人驚かしたり",
"怖がらせたりすんの趣味やから」"
]
},
{
"id": 18961,
"kind": "msg",
"jp": [
"「あのさ、部屋の鍵に",
"アルファベットが彫られてない?」"
]
},
{
"id": 18962,
"kind": "msg",
"jp": [
"「ああ、彫ってあるよ。",
"えーとね・・・『N』やわ」"
]
},
{
"id": 18963,
"kind": "msg",
"jp": [
"「Nだね、ありがとう」"
]
},
{
"id": 18964,
"kind": "msg",
"jp": [
"「お兄さんも暗号?」"
]
},
{
"id": 18965,
"kind": "msg",
"jp": [
"「うん、気になっちゃって。",
"鈴奈ちゃんは解けたの?」"
]
},
{
"id": 18966,
"kind": "msg",
"jp": [
"「まさか。",
"うちは全然わからんよ」"
]
},
{
"id": 18967,
"kind": "msg",
"jp": [
"「お姉ちゃんは大喜びで",
"即効解いてたけどさ」"
]
},
{
"id": 18968,
"kind": "msg",
"jp": [
"「即効・・・」"
]
},
{
"id": 18969,
"kind": "msg",
"jp": [
"「得意分野やもん。",
"まあ、お兄さんも頑張ってね」"
]
},
{
"id": 18970,
"kind": "msg",
"jp": [
"「鈴奈ちゃんの携帯ってどんなの?」"
]
},
{
"id": 18971,
"kind": "msg",
"jp": [
"「うちのん、ちょっと型古いで。",
"もう2年くらい{使/つこ}てるし」"
]
},
{
"id": 18972,
"kind": "msg",
"jp": [
"「そろそろ変えたいねんけど",
"お姉ちゃんが物持ちええからなぁ」"
]
},
{
"id": 18973,
"kind": "msg",
"jp": [
"「一緒じゃないと変えられないの?」"
]
},
{
"id": 18974,
"kind": "msg",
"jp": [
"「おそろいやなくなると",
"拗ねるねん、お姉ちゃん」"
]
},
{
"id": 18975,
"kind": "msg",
"jp": [
"ちょっと可愛いと思ってしまった。"
]
},
{
"id": 18976,
"kind": "msg",
"jp": [
"「鈴奈ちゃん達は",
"タクシーで来たんだよね?」"
]
},
{
"id": 18977,
"kind": "msg",
"jp": [
"「うん、まあね。",
"途中からやけど」"
]
},
{
"id": 18978,
"kind": "msg",
"jp": [
"「途中?」"
]
},
{
"id": 18979,
"kind": "msg",
"jp": [
"「お姉ちゃんが、",
"どうしてもロープウェイ",
"乗りたいてごねたから」"
]
},
{
"id": 18980,
"kind": "msg",
"jp": [
"「ロープウェイ・・・",
"ああ、そう言えば山道の",
"途中で駅見かけたような」"
]
},
{
"id": 18981,
"kind": "msg",
"jp": [
"「多分、うちらがタクシー",
"乗ったんそこやわ」"
]
},
{
"id": 18982,
"kind": "msg",
"jp": [
"「電話帳で近くのタクシー会社",
"調べて、呼んどいてん」"
]
},
{
"id": 18983,
"kind": "msg",
"jp": [
"「てことは、電車の駅の方で",
"誰かに会ったりはしてない?」"
]
},
{
"id": 18984,
"kind": "msg",
"jp": [
"「そやね、駅からバスで",
"ロープウェイ乗り場まで行ったし」"
]
},
{
"id": 18985,
"kind": "msg",
"jp": [
"「いや、うちはソース派。",
"お姉ちゃんがにらもうと",
"これだけは譲れん」"
]
},
{
"id": 18986,
"kind": "msg",
"jp": [
"「にらまれんの?」"
]
},
{
"id": 18987,
"kind": "msg",
"jp": [
"「お姉ちゃん出汁派やから。",
"20年戦ってこれだけは",
"譲ってないからな」"
]
},
{
"id": 18988,
"kind": "msg",
"jp": [
"ずっと戦ってるのか・・・。"
]
},
{
"id": 18989,
"kind": "msg",
"jp": [
"「手こねハンバーグって",
"作れる?」"
]
},
{
"id": 18990,
"kind": "msg",
"jp": [
"「はあ?",
"まあ、作れんことは",
"ないけど・・・」"
]
},
{
"id": 18991,
"kind": "msg",
"jp": [
"「けど、お姉ちゃんに",
"頼むんはやめた方がええで」"
]
},
{
"id": 18992,
"kind": "msg",
"jp": [
"「あんな仕込み放題の料理、",
"中に何が埋め込まれて",
"出てくるかわかったもんやない」"
]
},
{
"id": 18993,
"kind": "msg",
"jp": [
"・・・仕込み放題って。"
]
},
{
"id": 18994,
"kind": "msg",
"jp": [
"「鈴奈ちゃん、",
"揚げだし豆腐好き?」"
]
},
{
"id": 18995,
"kind": "msg",
"jp": [
"「揚げだし?",
"うーん、どっちか言うたら",
"豆腐は冷や奴がええなぁ」"
]
},
{
"id": 18996,
"kind": "msg",
"jp": [
"「・・・豆腐食べたなったやんか」"
]
},
{
"id": 18997,
"kind": "msg",
"jp": [
"「ご、ごめん。",
"無事に帰れたらいつか",
"ごちそうするから」"
]
},
{
"id": 18998,
"kind": "msg",
"jp": [
"「ほんまやね?",
"約束やで?」"
]
},
{
"id": 18999,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは",
"煙草吸わないよね」"
]
},
{
"id": 19000,
"kind": "msg",
"jp": [
"「・・・懲りた」"
]
},
{
"id": 19001,
"kind": "msg",
"jp": [
"「あれほど、お姉ちゃんが",
"いらんことしやすいアイテムも",
"ないからな・・・」"
]
},
{
"id": 19002,
"kind": "msg",
"jp": [
"「中身が全部シガレットチョコに",
"なってるんはまだマシやった」"
]
},
{
"id": 19003,
"kind": "msg",
"jp": [
"「全部、タール50ミリっていう",
"とんでもない煙草にすり替えて",
"あった時は半泣きになった・・・」"
]
},
{
"id": 19004,
"kind": "msg",
"jp": [
"「・・・えーと・・・",
"それは、静奈ちゃんとしては",
"煙草止めろってことを・・・?」"
]
},
{
"id": 19005,
"kind": "msg",
"jp": [
"「ううん、禁煙したら",
"残念がってたから違うやろね」"
]
},
{
"id": 19006,
"kind": "msg",
"jp": [
"純粋にいたずらしたかった",
"だけなのか・・・。"
]
},
{
"id": 19007,
"kind": "msg",
"jp": [
"「うん、1本もろた。",
"美味しかったよ」"
]
},
{
"id": 19008,
"kind": "msg",
"jp": [
"「・・・ほとんど",
"お姉ちゃんが飲んだけど」"
]
},
{
"id": 19009,
"kind": "msg",
"jp": [
"「あのさ・・・",
"脚立って好き?」"
]
},
{
"id": 19010,
"kind": "msg",
"jp": [
"「アンタもなん?」"
]
},
{
"id": 19011,
"kind": "msg",
"jp": [
"「お姉ちゃんが",
"大好きやねんけど・・・」"
]
},
{
"id": 19012,
"kind": "msg",
"jp": [
"「時々、うっとりながめてるけど",
"どこがええんかわからん・・・」"
]
},
{
"id": 19013,
"kind": "msg",
"jp": [
"僕にもわからない・・・。"
]
},
{
"id": 19014,
"kind": "msg",
"jp": [
"「鈴奈ちゃん、日傘って使う?」"
]
},
{
"id": 19015,
"kind": "msg",
"jp": [
"「ひ、日傘?」"
]
},
{
"id": 19016,
"kind": "msg",
"jp": [
"「えー、うちは・・・",
"あんまり使わへん、かも」"
]
},
{
"id": 19017,
"kind": "msg",
"jp": [
"「あの、なんか",
"変なこと聞いたかな・・・」"
]
},
{
"id": 19018,
"kind": "msg",
"jp": [
"「いや、わかってんねんで、",
"日焼けとか気ぃつこた方が",
"ええっていうのんは」"
]
},
{
"id": 19019,
"kind": "msg",
"jp": [
"「だから撮影ある時はなるべく",
"使ってるけど、普段からあんな",
"邪魔な・・・えー、あの・・・」"
]
},
{
"id": 19020,
"kind": "msg",
"jp": [
"「べ、別に使わないなら",
"使わないでいいと思うよ・・?」"
]
},
{
"id": 19021,
"kind": "msg",
"jp": [
"「そ、そう?",
"変じゃない?」"
]
},
{
"id": 19022,
"kind": "msg",
"jp": [
"「・・・女のくせに",
"雑すぎるとか思わへん?」"
]
},
{
"id": 19023,
"kind": "msg",
"jp": [
"「思わないよ、そんなの。",
"うちの姉ちゃんも使わないし」"
]
},
{
"id": 19024,
"kind": "msg",
"jp": [
"「なんや、そうなん?」"
]
},
{
"id": 19025,
"kind": "msg",
"jp": [
"「そうやんな、",
"使わん人だっていっぱい",
"おるやんな?」"
]
},
{
"id": 19026,
"kind": "msg",
"jp": [
"「誰かに何か言われたの?」"
]
},
{
"id": 19027,
"kind": "msg",
"jp": [
"「・・・事務所の社長が",
"うるさいねん・・・」"
]
},
{
"id": 19028,
"kind": "msg",
"jp": [
"「た、大変だね」"
]
},
{
"id": 19029,
"kind": "msg",
"jp": [
"女優さんだし、気を使えって",
"叱られたりするのかな。"
]
},
{
"id": 19030,
"kind": "msg",
"jp": [
"「台所とかで、",
"ワイングラス見た覚えない?」"
]
},
{
"id": 19031,
"kind": "msg",
"jp": [
"「ワイングラス?」"
]
},
{
"id": 19032,
"kind": "msg",
"jp": [
"「あー、なかったで。",
"探したんやけどないから",
"普通のグラス使っ・・・」"
]
},
{
"id": 19033,
"kind": "msg",
"jp": [
"「す、鈴奈ちゃん?」"
]
},
{
"id": 19034,
"kind": "msg",
"jp": [
"「・・・あの、まさか",
"どっかよそにあったん?」"
]
},
{
"id": 19035,
"kind": "msg",
"jp": [
"「うん、2階の物置に」"
]
},
{
"id": 19036,
"kind": "msg",
"jp": [
"「それは、あの、",
"すぐ見つかるようなとこ?」"
]
},
{
"id": 19037,
"kind": "msg",
"jp": [
"「ううん、棚の中で",
"箱に入ってたから",
"ぱっと見ただけじゃ・・・」"
]
},
{
"id": 19038,
"kind": "msg",
"jp": [
"「・・・微妙やな。",
"いや、でも・・・」"
]
},
{
"id": 19039,
"kind": "msg",
"jp": [
"「物置はお姉ちゃんも",
"見たはずやから・・・」"
]
},
{
"id": 19040,
"kind": "msg",
"jp": [
"「何が?",
"なんかまずいことでも?」"
]
},
{
"id": 19041,
"kind": "msg",
"jp": [
"「あるのに、なかったって",
"言うてもたから、",
"お仕置きがくるかも・・・」"
]
},
{
"id": 19042,
"kind": "msg",
"jp": [
"「・・・い、いや、ええねん。",
"気にせんとって・・・」"
]
},
{
"id": 19043,
"kind": "msg",
"jp": [
"なんだか、大変そうだ・・・。"
]
},
{
"id": 19044,
"kind": "msg",
"jp": [
"「鈴奈ちゃん、",
"日織のこと前から知ってる?」"
]
},
{
"id": 19045,
"kind": "msg",
"jp": [
"「あー・・・",
"お姉ちゃんは、何回か同じドラマ",
"出たことあるらしいねんけど」"
]
},
{
"id": 19046,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは会うの初めてなんだ」"
]
},
{
"id": 19047,
"kind": "msg",
"jp": [
"「? どうかしたの?",
"なんか変な間が・・・」"
]
},
{
"id": 19048,
"kind": "msg",
"jp": [
"「あー、いや、ほら、あの人",
"何かの時代劇で見たことあるなぁと",
"思うねんけど、思い出されへんのよ」"
]
},
{
"id": 19049,
"kind": "msg",
"jp": [
"「何やったかなぁ・・・。",
"なんかチンピラみたいな役",
"やっててんけど」"
]
},
{
"id": 19050,
"kind": "msg",
"jp": [
"「チンピラ・・・」"
]
},
{
"id": 19051,
"kind": "msg",
"jp": [
"「うん、なんかヤクザの三下いうの?",
"ああいうヤツで、同心につっかかって",
"蹴散らされてた」"
]
},
{
"id": 19052,
"kind": "msg",
"jp": [
"「そ、そう」"
]
},
{
"id": 19053,
"kind": "msg",
"jp": [
"「けどホンマもんは、",
"えらいのほほんとした人やね」"
]
},
{
"id": 19054,
"kind": "msg",
"jp": [
"「斑井さんってさ・・・」"
]
},
{
"id": 19055,
"kind": "msg",
"jp": [
"「うち、好かん」"
]
},
{
"id": 19056,
"kind": "msg",
"jp": [
"「え? あ、そう・・・?」"
]
},
{
"id": 19057,
"kind": "msg",
"jp": [
"「目つきがやらしいもん。",
"セクハラやセクハラ」"
]
},
{
"id": 19058,
"kind": "msg",
"jp": [
"相当嫌いみたいだ。"
]
},
{
"id": 19059,
"kind": "msg",
"jp": [
"「椿くんって、役柄と",
"元の性格ずいぶん違うみたいだね」"
]
},
{
"id": 19060,
"kind": "msg",
"jp": [
"「あー、珍しいんちゃう?",
"あんな堅苦しそうな役」"
]
},
{
"id": 19061,
"kind": "msg",
"jp": [
"「この前ドラマで見た時は",
"なんか学園物で不良役やったし」"
]
},
{
"id": 19062,
"kind": "msg",
"jp": [
"「ああ、似合いそう」"
]
},
{
"id": 19063,
"kind": "msg",
"jp": [
"「えーなー、ドラマ・・・」"
]
},
{
"id": 19064,
"kind": "msg",
"jp": [
"うらやましそうだ・・・。"
]
},
{
"id": 19065,
"kind": "msg",
"jp": [
"「那須さんって・・・",
"普段は普通に役者さんやってるのかな」"
]
},
{
"id": 19066,
"kind": "msg",
"jp": [
"「そら、やってんちゃうの?",
"想像つかへんけど」"
]
},
{
"id": 19067,
"kind": "msg",
"jp": [
"「やっぱり・・?」"
]
},
{
"id": 19068,
"kind": "msg",
"jp": [
"「だって、なんで役者になったんか",
"そもそも謎やん、あの人」"
]
},
{
"id": 19069,
"kind": "msg",
"jp": [
"「うちがあの体格やったら",
"迷わずプロレスラーになるのに」"
]
},
{
"id": 19070,
"kind": "msg",
"jp": [
"それが役者になってるってことは",
"やっぱり芝居が好きだからなのかな。"
]
},
{
"id": 19071,
"kind": "msg",
"jp": [
"「暗石さんってすごく",
"ベテランなの?」"
]
},
{
"id": 19072,
"kind": "msg",
"jp": [
"「そらもう、演劇界の宝やで!",
"渋いやろ～?」"
]
},
{
"id": 19073,
"kind": "msg",
"jp": [
"「す、好きなんだ」"
]
},
{
"id": 19074,
"kind": "msg",
"jp": [
"「だってかっこええやん!",
"殺陣とかすっごい上手いんやって」"
]
},
{
"id": 19075,
"kind": "msg",
"jp": [
"「ふぅん・・・",
"凄い人なんだ」"
]
},
{
"id": 19076,
"kind": "msg",
"jp": [
"「そうやで、尊敬しぃアンタも」"
]
},
{
"id": 19077,
"kind": "msg",
"jp": [
"「えーと、静奈ちゃん・・・",
"の方がお姉さんだよね?」"
]
},
{
"id": 19078,
"kind": "msg",
"jp": [
"「うん、うちの方が妹。",
"まあ年は一緒やけどさ」"
]
},
{
"id": 19079,
"kind": "msg",
"jp": [
"「双子だもんね。",
"いくつなんだっけ?」"
]
},
{
"id": 19080,
"kind": "msg",
"jp": [
"「20歳」"
]
},
{
"id": 19081,
"kind": "msg",
"jp": [
"「・・・でもなんでか",
"お姉ちゃんの方はいくつかわからんて",
"よく言われるんよね・・・」"
]
},
{
"id": 19082,
"kind": "msg",
"jp": [
"「ふうん?",
"なんでだろうね」"
]
},
{
"id": 19083,
"kind": "msg",
"jp": [
"「多分・・・趣味とか、",
"いろいろ・・・」"
]
},
{
"id": 19084,
"kind": "msg",
"jp": [
"「まあ、ちょっと変わってるけど",
"あれでも天才やねんで」"
]
},
{
"id": 19085,
"kind": "msg",
"jp": [
"「天才って演技力だよね」"
]
},
{
"id": 19086,
"kind": "msg",
"jp": [
"「そうや、あんなぽーっとした",
"顔していざ舞台となったら豹変",
"するんやから」"
]
},
{
"id": 19087,
"kind": "msg",
"jp": [
"「へぇ・・・」"
]
},
{
"id": 19088,
"kind": "msg",
"jp": [
"「言うとくけど、",
"ちょっかい掛けんといてや」"
]
},
{
"id": 19089,
"kind": "msg",
"jp": [
"「か、かけないかけない」"
]
},
{
"id": 19090,
"kind": "msg",
"jp": [
"「鈴奈ちゃん達って",
"この辺地元なの?」"
]
},
{
"id": 19091,
"kind": "msg",
"jp": [
"「んー、近いってほどやないけど",
"まあこの辺やね」"
]
},
{
"id": 19092,
"kind": "msg",
"jp": [
"「同じ県内ってくらい?」"
]
},
{
"id": 19093,
"kind": "msg",
"jp": [
"「そやね。",
"もう山ひとつ向こうやし」"
]
},
{
"id": 19094,
"kind": "msg",
"jp": [
"「だ、だいぶ遠いね・・・」"
]
},
{
"id": 19095,
"kind": "msg",
"jp": [
"「むしろ関西に近いからなぁ、",
"うちらの実家」"
]
},
{
"id": 19096,
"kind": "msg",
"jp": [
"「実際、母方の田舎は兵庫やしね」"
]
},
{
"id": 19097,
"kind": "msg",
"jp": [
"「御陵さんって",
"普段からずっとああなの?」"
]
},
{
"id": 19098,
"kind": "msg",
"jp": [
"「いつ会うてもあんな",
"感じやけど?」"
]
},
{
"id": 19099,
"kind": "msg",
"jp": [
"「そっか、地なんだ・・・」"
]
},
{
"id": 19100,
"kind": "msg",
"jp": [
"「優しいて、ええ人やん」"
]
},
{
"id": 19101,
"kind": "msg",
"jp": [
"「・・・ちょっと天然やけど」"
]
},
{
"id": 19102,
"kind": "msg",
"jp": [
"やっぱりそう思ってるんだ・・・。"
]
},
{
"id": 19103,
"kind": "msg",
"jp": [
"「南雲さんって人、",
"来ないね・・・」"
]
},
{
"id": 19104,
"kind": "msg",
"jp": [
"「・・・・お兄さんさあ」"
]
},
{
"id": 19105,
"kind": "msg",
"jp": [
"「ホンマに南雲さんやないん?」"
]
},
{
"id": 19106,
"kind": "msg",
"jp": [
"「ええっ!?",
"ち、違うよ、ほんとに!」"
]
},
{
"id": 19107,
"kind": "msg",
"jp": [
"「んー、まあ役者には",
"見えへんけど・・・」"
]
},
{
"id": 19108,
"kind": "msg",
"jp": [
"「うん、違う違う。",
"普通の大学生」"
]
},
{
"id": 19109,
"kind": "msg",
"jp": [
"「まあ、普通にも見えへんけど」"
]
},
{
"id": 19110,
"kind": "msg",
"jp": [
"「・・・あの、それは",
"どういう・・・」"
]
},
{
"id": 19111,
"kind": "msg",
"jp": [
"「アンタ自覚ないのん?」"
]
},
{
"id": 19112,
"kind": "msg",
"jp": [
"僕、普通じゃないのか・・。"
]
},
{
"id": 19113,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは帽子屋って人の",
"ことはあまり知らない?」"
]
},
{
"id": 19114,
"kind": "msg",
"jp": [
"「世間で噂になってる程度の",
"ことしか知らんわ」"
]
},
{
"id": 19115,
"kind": "msg",
"jp": [
"「けど、怪しいよなあ。",
"なんで正体隠してんねやろ」"
]
},
{
"id": 19116,
"kind": "msg",
"jp": [
"「・・・なんでだろう?」"
]
},
{
"id": 19117,
"kind": "msg",
"jp": [
"「絶対怪しいわ。",
"なんか秘密があるんやで、きっと」"
]
},
{
"id": 19118,
"kind": "msg",
"jp": [
"「秘密って?」"
]
},
{
"id": 19119,
"kind": "msg",
"jp": [
"「・・・それはわからんけど」"
]
},
{
"id": 19120,
"kind": "msg",
"jp": [
"「けど、怪しいやんかー!」"
]
},
{
"id": 19121,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは、高遠延二郎のこと",
"前から知ってた?」"
]
},
{
"id": 19122,
"kind": "msg",
"jp": [
"「名前だけはね。",
"お姉ちゃんが好きやから」"
]
},
{
"id": 19123,
"kind": "msg",
"jp": [
"「せやからうちに本あったし",
"うちの役が出てくるのんだけ",
"読んでみてんけど・・・」"
]
},
{
"id": 19124,
"kind": "msg",
"jp": [
"「なんて話?」"
]
},
{
"id": 19125,
"kind": "msg",
"jp": [
"「えー・・・と、",
"なんか『悪魔』ってついてたんしか",
"覚えてないわ」"
]
},
{
"id": 19126,
"kind": "msg",
"jp": [
"「今回の芝居とは別に",
"関係あらへんみたいやったし」"
]
},
{
"id": 19127,
"kind": "msg",
"jp": [
"「ふぅん・・・",
"元ネタになってるのは",
"名前だけってことか」"
]
},
{
"id": 19128,
"kind": "msg",
"jp": [
"「そうみたいやね」"
]
},
{
"id": 19129,
"kind": "msg",
"jp": [
"「あの、さ・・・",
"斑井さんなんだけど・・・」"
]
},
{
"id": 19130,
"kind": "msg",
"jp": [
"「部屋出てってあんなとこで",
"死んでるやなんてさ・・・」"
]
},
{
"id": 19131,
"kind": "msg",
"jp": [
"「まさか殺されるやなんて",
"夢にも思てへんかったんやろね。",
"本気で・・・」"
]
},
{
"id": 19132,
"kind": "msg",
"jp": [
"「椿くんのことで何か・・・",
"覚えてることとかない?」"
]
},
{
"id": 19133,
"kind": "msg",
"jp": [
"「・・・執事さんね」"
]
},
{
"id": 19134,
"kind": "msg",
"jp": [
"「特別これって記憶に引っかかってる",
"ようなことってないんやけど・・・」"
]
},
{
"id": 19135,
"kind": "msg",
"jp": [
"「なんで部屋から出たんやろうって",
"いうんは気になるわ」"
]
},
{
"id": 19136,
"kind": "msg",
"jp": [
"「あんな朝早くから地下室に",
"用事って変やしなぁ」"
]
},
{
"id": 19137,
"kind": "msg",
"jp": [
"「何か用があって降りたなら",
"犯人はなんで知ってたのかって",
"ことにならない?」"
]
},
{
"id": 19138,
"kind": "msg",
"jp": [
"「あ、そうか。",
"ほな呼び出された?」"
]
},
{
"id": 19139,
"kind": "msg",
"jp": [
"「どうやって呼び出せば",
"いいかわからないけどね」"
]
},
{
"id": 19140,
"kind": "msg",
"jp": [
"「うーん・・・",
"時間が時間やしなぁ」"
]
},
{
"id": 19141,
"kind": "msg",
"jp": [
"「けど、上手いこと言うたら",
"執事って立場は他の人より",
"呼び出しやすいかも」"
]
},
{
"id": 19142,
"kind": "msg",
"jp": [
"「立場?」"
]
},
{
"id": 19143,
"kind": "msg",
"jp": [
"「ボイラーが壊れたとか",
"鍵が開かへんとかって事やったら、",
"執事さんに言うのは変じゃないし」"
]
},
{
"id": 19144,
"kind": "msg",
"jp": [
"「ああ、確かに・・・。",
"そういう事態なら僕でもとりあえず",
"椿くんに言うかな」"
]
},
{
"id": 19145,
"kind": "msg",
"jp": [
"「ただ、なんでそんな早朝にって",
"疑問に思わんと部屋から出てもたんか",
"わからんけどね」"
]
},
{
"id": 19146,
"kind": "msg",
"jp": [
"「早朝だったのは眠れなかったって",
"言えば無理もない話だから別に",
"変だと思わないんじゃないかな」"
]
},
{
"id": 19147,
"kind": "msg",
"jp": [
"「どっちかって言うと、",
"鍵とかボイラーとか誘い出す口実が",
"嘘だってばれないようにする方が・・」"
]
},
{
"id": 19148,
"kind": "msg",
"jp": [
"「・・・うちらには",
"そっちの方がむしろ簡単やで」"
]
},
{
"id": 19149,
"kind": "msg",
"jp": [
"「いかにもあり得そうな",
"口実さえ思いついたら",
"あとは{芝/・}{居/・}{す/・}{れ/・}{ば/・}{え/・}{え/・}んやったら」"
]
},
{
"id": 19150,
"kind": "msg",
"jp": [
"「そっか・・・。",
"そうだよね・・・」"
]
},
{
"id": 19151,
"kind": "msg",
"jp": [
"「これだけのこと計画した",
"犯人やったら口実くらい最初から",
"考えてあったかもね」"
]
},
{
"id": 19152,
"kind": "msg",
"jp": [
"「・・・那須さんのこと",
"なんだけど・・・」"
]
},
{
"id": 19153,
"kind": "msg",
"jp": [
"「もうちょっと・・・",
"人の話聞きんさったらよかったのに」"
]
},
{
"id": 19154,
"kind": "msg",
"jp": [
"「・・・うん・・」"
]
},
{
"id": 19155,
"kind": "msg",
"jp": [
"「鍵掛けろって、みんなに",
"言われてたのにね・・・」"
]
},
{
"id": 19156,
"kind": "msg",
"jp": [
"「えっと・・・",
"暗石さんのことで・・・」"
]
},
{
"id": 19157,
"kind": "msg",
"jp": [
"「・・・気ぃ重いわ」"
]
},
{
"id": 19158,
"kind": "msg",
"jp": [
"「亡くならはったんもショック",
"やけどさ・・・なんていうか・・・」"
]
},
{
"id": 19159,
"kind": "msg",
"jp": [
"「・・・あないに警戒してても",
"あかんかったんやって・・・」"
]
},
{
"id": 19160,
"kind": "msg",
"jp": [
"（・・・そうか・・・）"
]
},
{
"id": 19161,
"kind": "msg",
"jp": [
"（一番警戒していた人があんなことに",
"なったから・・・）"
]
},
{
"id": 19162,
"kind": "msg",
"jp": [
"自分ももう、何をやっても駄目かもしれ",
"ないって気分になってしまうんだろう。"
]
},
{
"id": 19163,
"kind": "msg",
"jp": [
"（・・どうすればいいんだろう・・・）"
]
},
{
"id": 19164,
"kind": "msg",
"jp": [
"「南雲さんってさ・・・」"
]
},
{
"id": 19165,
"kind": "msg",
"jp": [
"「嫌な話やけどさ、やっぱり",
"南雲さんって怪しくない?」"
]
},
{
"id": 19166,
"kind": "msg",
"jp": [
"「・・・鈴奈ちゃんは",
"そう思うの?」"
]
},
{
"id": 19167,
"kind": "msg",
"jp": [
"「お兄さんは?」"
]
},
{
"id": 19168,
"kind": "msg",
"jp": [
"「僕は、正直言ってまだわからない。",
"ひょっとしたら井戸の中で死んでた人が",
"そうかもしれないし・・・」"
]
},
{
"id": 19169,
"kind": "msg",
"jp": [
"「ああ、そっか。",
"死んでたから来んかったって",
"いうのはあるか」"
]
},
{
"id": 19170,
"kind": "msg",
"jp": [
"「けど、そやったら駐車場のやつとか",
"あれは誰やねんって話になるしなぁ」"
]
},
{
"id": 19171,
"kind": "msg",
"jp": [
"「駐車場の方が南雲さんだったと",
"しても井戸の人は誰って事に・・・」"
]
},
{
"id": 19172,
"kind": "msg",
"jp": [
"「それこそ、お兄さんみたいに",
"迷い込んでたまたま犯人見てもうた",
"人とかちゃうのん?」"
]
},
{
"id": 19173,
"kind": "msg",
"jp": [
"「お兄さんかて、最初殴られて",
"気絶してたやんか?」"
]
},
{
"id": 19174,
"kind": "msg",
"jp": [
"「え、うん、まあ」"
]
},
{
"id": 19175,
"kind": "msg",
"jp": [
"「お兄さんの場合はさ、",
"あっさり気絶したから助かったけど",
"井戸の人は抵抗したんかもよ」"
]
},
{
"id": 19176,
"kind": "msg",
"jp": [
"「だから・・・",
"仕方なく殺された・・・?」"
]
},
{
"id": 19177,
"kind": "msg",
"jp": [
"「そんな気がする。",
"だって、実際お兄さんの方は",
"助かってるわけやん?」"
]
},
{
"id": 19178,
"kind": "msg",
"jp": [
"「だから、お兄さんが庭で",
"つまずいた人が井戸の中の人で",
"関係ない人でさ・・」"
]
},
{
"id": 19179,
"kind": "msg",
"jp": [
"「・・・南雲役の誰かさんは",
"生きててどっかに隠れてると思う」"
]
},
{
"id": 19180,
"kind": "msg",
"jp": [
"「・・・鈴奈ちゃん、あの、",
"その南雲さん役の人って・・・」"
]
},
{
"id": 19181,
"kind": "msg",
"jp": [
"鈴奈ちゃんは、一瞬はっとなって",
"気まずそうに口篭もった。"
]
},
{
"id": 19182,
"kind": "msg",
"jp": [
"「・・・南雲さんとか言うて",
"誤魔化すんは卑怯やわな」"
]
},
{
"id": 19183,
"kind": "msg",
"jp": [
"「ええねん。",
"そうや、うちが疑うてるんは",
"・・・四倉さんや」"
]
},
{
"id": 19184,
"kind": "msg",
"jp": [
"「だって・・・",
"南雲さん役ってどう考えても",
"あの人としか思えんやん?」"
]
},
{
"id": 19185,
"kind": "msg",
"jp": [
"「滝プロやし、このタイミングで",
"同じ山の中におったらしいし」"
]
},
{
"id": 19186,
"kind": "msg",
"jp": [
"「全然関係ないのにたまたま",
"同じ場所におって行方不明に",
"なったりすることあると思う?」"
]
},
{
"id": 19187,
"kind": "msg",
"jp": [
"「それは・・・",
"偶然にしてはちょっと・・・と",
"思うけど・・・」"
]
},
{
"id": 19188,
"kind": "msg",
"jp": [
"「そやろ・・・。",
"ほな、南雲さん役なんやったら",
"なんで来んさらんのって事やん」"
]
},
{
"id": 19189,
"kind": "msg",
"jp": [
"「・・・うちは、実はもう",
"とっくに来ててずっと隠れてるん",
"ちゃうかとしか思えへん・・・」"
]
},
{
"id": 19190,
"kind": "msg",
"jp": [
"鈴奈ちゃんが疑うのも無理はないし",
"あり得ることだと思う。"
]
},
{
"id": 19191,
"kind": "msg",
"jp": [
"（もし、そうだとしたら・・・）"
]
},
{
"id": 19192,
"kind": "msg",
"jp": [
"（・・・井戸の中の人は",
"なぜこんな所にいたんだ・・・?）"
]
},
{
"id": 19193,
"kind": "msg",
"jp": [
"どうしても謎が残ってしまう。"
]
},
{
"id": 19194,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは、四倉欣治さんって",
"人のこと知ってる?」"
]
},
{
"id": 19195,
"kind": "msg",
"jp": [
"「四倉さんなあ・・・",
"何回か顔は合わせてるはずやねんけど",
"あんまり話したことないんよね」"
]
},
{
"id": 19196,
"kind": "msg",
"jp": [
"「そうなんだ。",
"役者さんとしては知ってるって程度?」"
]
},
{
"id": 19197,
"kind": "msg",
"jp": [
"「・・・ていうか、お姉ちゃんが",
"会うたことあるから話だけは",
"聞いてて知ってるって感じ」"
]
},
{
"id": 19198,
"kind": "msg",
"jp": [
"「あのさ・・・",
"池内梨奈さんって知ってる?」"
]
},
{
"id": 19199,
"kind": "msg",
"jp": [
"「えっ?",
"いや、そら同じ事務所やったし",
"知ってるけど・・・」"
]
},
{
"id": 19200,
"kind": "msg",
"jp": [
"「なんでいきなり?",
"あの、一応言うとくけどもう",
"亡くなってるで?」"
]
},
{
"id": 19201,
"kind": "msg",
"jp": [
"「あ、うん、それは知ってる。",
"書斎にあった週刊誌で見たから」"
]
},
{
"id": 19202,
"kind": "msg",
"jp": [
"「・・・ああ、そういうことか」"
]
},
{
"id": 19203,
"kind": "msg",
"jp": [
"「あんね、その記事デマやで」"
]
},
{
"id": 19204,
"kind": "msg",
"jp": [
"「デマ!?",
"デマって・・・オーディションに",
"落選して自殺って話が・・・?」"
]
},
{
"id": 19205,
"kind": "msg",
"jp": [
"「ううん、そこは本当やねんけど",
"落選した理由が、帽子屋が口出した",
"せいやとかっていうところ」"
]
},
{
"id": 19206,
"kind": "msg",
"jp": [
"「あのオーディション、帽子屋なんか",
"なんも関係あらへんかったんやから」"
]
},
{
"id": 19207,
"kind": "msg",
"jp": [
"「へ・・・?",
"じゃあ何でそんな話になったの?」"
]
},
{
"id": 19208,
"kind": "msg",
"jp": [
"「帽子屋に気に入られてるってことに",
"したら注目されるからやろうね」"
]
},
{
"id": 19209,
"kind": "msg",
"jp": [
"「え? それって・・・",
"わざとデマを流したってこと?」"
]
},
{
"id": 19210,
"kind": "msg",
"jp": [
"「オーディションの主催がわざと",
"流した噂やったみたいやわ」"
]
},
{
"id": 19211,
"kind": "msg",
"jp": [
"「うちの社長がどっかから聞いた",
"みたいで怒り狂ってたん、たまたま",
"居合わせて聞いてもうたんよ」"
]
},
{
"id": 19212,
"kind": "msg",
"jp": [
