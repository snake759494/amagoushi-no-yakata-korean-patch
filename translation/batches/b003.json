]
},
{
"id": 1974,
"kind": "msg",
"jp": [
"「だから、温室に・・・」"
]
},
{
"id": 1975,
"kind": "msg",
"jp": [
"「おおい、和くん!」"
]
},
{
"id": 1976,
"kind": "msg",
"jp": [
