]
},
{
"id": 1952,
"kind": "msg",
"jp": [
"「・・・・また何かあるん?」"
]
},
{
"id": 1953,
"kind": "msg",
"jp": [
"「そう! そうなんだよ!」"
]
},
{
"id": 1954,
"kind": "msg",
"jp": [
"「えっ!?",
"また何かあったのか!?」"
]
},
{
"id": 1955,
"kind": "msg",
"jp": [
"「さっきそう言ったじゃ",
"ないですかああっ!!」"
]
},
{
"id": 1956,
"kind": "msg",
"jp": [
"「{和/なご}さん?",
"どうかしたんですかい?」"
]
},
{
"id": 1957,
"kind": "msg",
"jp": [
"「ああ、日織!",
