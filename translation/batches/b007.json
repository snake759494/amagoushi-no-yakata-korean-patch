]
},
{
"id": 4456,
"kind": "msg",
"jp": [
"（・・・・でも・・・）"
]
},
{
"id": 4457,
"kind": "msg",
"jp": [
"（間違いじゃなかった・・・）"
]
},
{
"id": 4458,
"kind": "msg",
"jp": [
