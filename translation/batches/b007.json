]
},
{
"id": 4439,
"kind": "msg",
"jp": [
"「・・・ぼくも戻ろうかなあ。",
"外に出られないと、ダンベルでも",
"上げてないと身体がなまって・・・」"
]
},
{
"id": 4440,
"kind": "msg",
"jp": [
"「動いてねえと息まで",
"止まりそうですね、那須さんは」"
]
},
{
"id": 4441,
"kind": "msg",
"jp": [
"「いやあ、本当にそうだよ。",
"息が詰まるよね」"
]
},
{
"id": 4442,
"kind": "msg",
"jp": [
"・・・なんか会話がかみ合ってない。",
"けど、その変なやり取りを聞いてると",
"少しだけ気が楽になってきた・・・。"
]
},
{
"id": 4443,
"kind": "msg",
"jp": [
"「じゃあ、ぼくも戻るよ」"
]
},
{
"id": 4444,
"kind": "msg",
"jp": [
"「・・・{和/なご}さん」"
]
},
{
"id": 4445,
"kind": "msg",
"jp": [
"「・・・そうする。",
"ちょっと休むよ・・・」"
]
},
{
"id": 4446,
"kind": "msg",
"jp": [
"「そうですか。",
"俺は書斎にいますからね、",
"それじゃあ」"
]
},
{
"id": 4447,
"kind": "msg",
"jp": [
"2人して居間を出て、僕はそのまま",
"部屋に戻った・・・。"
]
},
{
"id": 4448,
"kind": "msg",
"jp": [
"「・・・もう少し、ここにいる」"
]
},
{
"id": 4449,
"kind": "msg",
"jp": [
"「そうですかい?",
"気をつけて下さいよ」"
]
},
{
"id": 4450,
"kind": "msg",
"jp": [
"「日織は? 書斎?」"
]
},
{
"id": 4451,
"kind": "msg",
"jp": [
"「ええ、夜まで居ますから」"
]
},
{
"id": 4452,
"kind": "msg",
"jp": [
"「それじゃ、また」"
]
},
{
"id": 4453,
"kind": "msg",
"jp": [
