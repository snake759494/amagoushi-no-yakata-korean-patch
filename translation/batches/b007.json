[
{
"id": 3981,
"kind": "msg",
"jp": [
"「あ、おはよー」"
]
},
{
"id": 3982,
"kind": "msg",
"jp": [
"「おはよう、鈴奈ちゃん」"
]
},
{
"id": 3983,
"kind": "msg",
"jp": [
"「お兄さんも今起きんさったん?」"
]
},
{
"id": 3984,
"kind": "msg",
"jp": [
"「いや、椿くん呼びに来たんだけど",
"まだ寝てるみたいなんだよね」"
]
},
{
"id": 3985,
"kind": "msg",
"jp": [
"「あー、きっと疲れてはるねんで。",
"気ぃ休まる暇もあらへんもん」"
]
},
{
"id": 3986,
"kind": "msg",
"jp": [
"「だろうね。",
"あ、静奈ちゃんなら、今台所だよ」"
]
},
{
"id": 3987,
"kind": "msg",
"jp": [
"「うん、さっきご飯作る言うて",
"出て行ったから。",
"もう出来てるんかな?」"
]
},
{
"id": 3988,
"kind": "msg",
"jp": [
"「多分、そろそろ出来ると思うよ」"
]
},
{
"id": 3989,
"kind": "msg",
"jp": [
"鈴奈ちゃんと一緒に1階へ降りて",
"台所に戻る。"
]
},
{
"id": 3990,
"kind": "msg",
"jp": [
"「ただいまー。",
"呼んでみたけど、返事ないんだよ。",
"まだ寝てるみたい」"
]
},
{
"id": 3991,
"kind": "msg",
"jp": [
"「そうですかい。",
"だったら寝かしといてあげましょう」"
]
},
{
"id": 3992,
"kind": "msg",
"jp": [
"「それじゃあ・・・",
"私は失礼しますわね」"
]
},
{
"id": 3993,
"kind": "msg",
"jp": [
"「・・・うちらも部屋で食べる?」"
]
},
{
"id": 3994,
"kind": "msg",
"jp": [
"「そうやね・・・」"
]
},
{
"id": 3995,
"kind": "msg",
"jp": [
"女性陣は、出来上がった食事を持って",
"部屋に戻っていった。"
]
},
{
"id": 3996,
"kind": "msg",
"jp": [
"「お待たせー!",
"やあ、美味そうだなあ」"
]
},
{
"id": 3997,
"kind": "msg",
"jp": [
"「那須さん、どうします?",
"部屋に持ってって食います?」"
]
},
{
"id": 3998,
"kind": "msg",
"jp": [
"「そうだな、飲み物",
"部屋に置いたままだし」"
]
},
{
"id": 3999,
"kind": "msg",
"jp": [
"「じゃ、もらってくよ。",
"ありがとう!」"
]
},
{
"id": 4000,
"kind": "msg",
"jp": [
"「いえいえ、どういたしまして」"
]
},
{
"id": 4001,
"kind": "msg",
"jp": [
"「{和/なご}さん食ってくでしょ?」"
]
},
{
"id": 4002,
"kind": "msg",
"jp": [
"「んじゃ、娯楽室でラジオでも",
"つけて食いますか」"
]
},
{
"id": 4003,
"kind": "msg",
"jp": [
"ノイズの多いラジオをつけて、",
"食事を取る。"
]
},
{
"id": 4004,
"kind": "msg",
"jp": [
"「・・・天気、",
"あんまり変わらないみたいだね」"
]
},
{
"id": 4005,
"kind": "msg",
"jp": [
"「最初の日みてえな大嵐には",
"ならねえようですが、止んでくれも",
"しねえって感じですね」"
]
},
{
"id": 4006,
"kind": "msg",
"jp": [
"「早く止んでくれないと、",
"道がなおせないだろうになぁ・・・」"
]
},
{
"id": 4007,
"kind": "msg",
"jp": [
"「まあ、天気ばっかりはどうにも",
"なりませんからねぇ」"
]
},
{
"id": 4008,
"kind": "msg",
"jp": [
"窓を見てみると、いくつもの雨の筋が",
"絶え間なく上から下へと引かれていた。"
]
},
{
"id": 4009,
"kind": "msg",
"jp": [
"ちっとも、途切れそうにない・・・。"
]
},
{
"id": 4010,
"kind": "msg",
"jp": [
"（・・・早く晴れないかなぁ・・・）"
]
},
{
"id": 4011,
"kind": "msg",
"jp": [
"結局、陰気なことしか言ってくれない",
"ラジオも途中で消して、とりとめのない",
"話をしながら食事を終えた。"
]
},
{
"id": 4012,
"kind": "msg",
"jp": [
"「さてと、じゃあ俺は",
"食器片付けたら書斎にいますんで」"
]
},
{
"id": 4013,
"kind": "msg",
"jp": [
"「うん、ありがとう。",
"ごちそうさま」"
]
},
{
"id": 4014,
"kind": "msg",
"jp": [
"日織もいなくなり、娯楽室には",
"僕だけになった。"
]
},
{
"id": 4015,
"kind": "msg",
"jp": [
"ラジオはつけても、もうニュースも",
"やってなさそうだし・・・。"
]
},
{
"id": 4016,
"kind": "msg",
"jp": [
"（1人でずっと聞いてるのも",
"寂しいしなぁ・・・）"
]
},
{
"id": 4017,
"kind": "msg",
"jp": [
"・・・そう言えば、椿くんは",
"もう起きたかな。"
]
},
{
"id": 4018,
"kind": "msg",
"jp": [
"昨日はけっこう早いうちに",
"起きてきてたみたいなのに。"
]
},
{
"id": 4019,
"kind": "msg",
"jp": [
"（疲れてるんだろうし、",
"起きたってもう芝居の稽古とか",
"するわけでもないし・・・）"
]
},
{
"id": 4020,
"kind": "msg",
"jp": [
"（部屋から出たくなくなっちゃう",
"かもなぁ・・・）"
]
},
{
"id": 4021,
"kind": "msg",
"jp": [
"どうしようかな。",
"このまま、ここでじっとしてるのも",
"なんだし・・・。"
]
},
{
"id": 4022,
"kind": "msg",
"jp": [
"（とりあえず、ここ出よう・・・）"
]
},
{
"id": 4023,
"kind": "msg",
"jp": [
"・・・・・・・・。",
"・・・。"
]
},
{
"id": 4024,
"kind": "msg",
"jp": [
"「・・・さん?」"
]
},
{
"id": 4025,
"kind": "msg",
"jp": [
"「{和/なご}さん?",
"大丈夫ですかい?」"
]
},
{
"id": 4026,
"kind": "msg",
"jp": [
"「・・・・・ん・・・?」"
]
},
{
"id": 4027,
"kind": "msg",
"jp": [
"「あれ・・・日織・・・?」"
]
},
{
"id": 4028,
"kind": "msg",
"jp": [
"「あれ、じゃねえですよ。",
"こんなところで寝ちまって」"
]
},
{
"id": 4029,
"kind": "msg",
"jp": [
"ぼーっとしたまま起きあがってみる。",
"やけに身体が痛かった。"
]
},
{
"id": 4030,
"kind": "msg",
"jp": [
"「・・・え? あれ?」"
]
},
{
"id": 4031,
"kind": "msg",
"jp": [
"ずれていた眼鏡を掛けなおして",
"慌てて周りを見回す。"
]
},
{
"id": 4032,
"kind": "msg",
"jp": [
"・・・どう見ても廊下だった。"
]
},
{
"id": 4033,
"kind": "msg",
"jp": [
"「脅かさねえで下さいや、",
"てっきり先に起きてんだと思ってたのに",
"一向に姿が見えねえと思ったら・・・」"
]
},
{
"id": 4034,
"kind": "msg",
"jp": [
"「いやまあ、",
"無事ならいいんですがね」"
]
},
{
"id": 4035,
"kind": "msg",
"jp": [
"「何だってこんな所で",
"力尽きてたんですかい」"
]
},
{
"id": 4036,
"kind": "msg",
"jp": [
"（・・・なんでだっけ・・・）"
]
},
{
"id": 4037,
"kind": "msg",
"jp": [
"（夕べは確か・・・）"
]
},
{
"id": 4038,
"kind": "msg",
"jp": [
"「もしもし、{和/なご}さん?」"
]
},
{
"id": 4039,
"kind": "msg",
"jp": [
"「<fs 110>あーっ、そうだ!<fs>",
"<fs 110>椿くん! 椿くんは!?<fs>」"
]
},
{
"id": 4040,
"kind": "msg",
"jp": [
"「見張って、あの、夕べ、",
"危ないと思って、だから」"
]
},
{
"id": 4041,
"kind": "msg",
"jp": [
"「ああ、はいはい。",
"なんとなくわかりましたから",
"落ち着いて」"
]
},
{
"id": 4042,
"kind": "msg",
"jp": [
"「無事なの?",
"椿くん、どこ?」"
]
},
{
"id": 4043,
"kind": "msg",
"jp": [
"「そういや、椿さんには",
"今朝はまだ会ってませんや」"
]
},
{
"id": 4044,
"kind": "msg",
"jp": [
"「・・・部屋に、",
"いると思う・・・?」"
]
},
{
"id": 4045,
"kind": "msg",
"jp": [
"「見てきましょうか」"
]
},
{
"id": 4046,
"kind": "msg",
"jp": [
"「僕も行く!」"
]
},
{
"id": 4047,
"kind": "msg",
"jp": [
"「・・・って、うわ!」"
]
},
{
"id": 4048,
"kind": "msg",
"jp": [
"慌てて立ち上がろうとしたら",
"足がもつれてふらついた。"
]
},
{
"id": 4049,
"kind": "msg",
"jp": [
"「ああ、ほら気をつけて。",
"部屋で休んでた方が",
"よかねえですかい」"
]
},
{
"id": 4050,
"kind": "msg",
"jp": [
"「気になって寝られないよ。",
"だって・・・」"
]
},
{
"id": 4051,
"kind": "msg",
"jp": [
"・・・なんか夕べもまた殴られた",
"ような気がするし、と言いかけて",
"思いとどまった。"
]
},
{
"id": 4052,
"kind": "msg",
"jp": [
"（言ったら問答無用で",
"部屋に押し込まれそうだ・・・）"
]
},
{
"id": 4053,
"kind": "msg",
"jp": [
"「しょうがねえなあ。",
"じゃあ一緒に行きましょう」"
]
},
{
"id": 4054,
"kind": "msg",
"jp": [
"「椿さーん、起きてますかい?」"
]
},
{
"id": 4055,
"kind": "msg",
"jp": [
"「・・・椿さん?」"
]
},
{
"id": 4056,
"kind": "msg",
"jp": [
"「返事ないね・・・」"
]
},
{
"id": 4057,
"kind": "msg",
"jp": [
"「入れ違いに部屋",
"出ちまったのかもしれませんね」"
]
},
{
"id": 4058,
"kind": "msg",
"jp": [
"「だといいけど・・・」"
]
},
{
"id": 4059,
"kind": "msg",
"jp": [
"「・・・僕、ちょっと探してくる」"
]
},
{
"id": 4060,
"kind": "msg",
"jp": [
"「休まなくて大丈夫ですかい?",
"夕べは見張っててあんな変なところで",
"力尽きたんじゃあ・・・」"
]
},
{
"id": 4061,
"kind": "msg",
"jp": [
"「大丈夫、一応寝てたし」"
]
},
{
"id": 4062,
"kind": "msg",
"jp": [
"「寝たうちに入るんですかねえ。",
"飯もまだ食ってねえでしょう?」"
]
},
{
"id": 4063,
"kind": "msg",
"jp": [
"「うん、日織はもうすんだ?」"
]
},
{
"id": 4064,
"kind": "msg",
"jp": [
"「さっき適当にすませましたが、",
"何か作りましょうか?」"
]
},
{
"id": 4065,
"kind": "msg",
"jp": [
"「いや、いいよ。",
"まだあんまりお腹空いてないし」"
]
},
{
"id": 4066,
"kind": "msg",
"jp": [
"それより椿くんが気になって",
"食欲なんかわかないし・・・。"
]
},
{
"id": 4067,
"kind": "msg",
"jp": [
"「・・・娯楽室かな。",
"ラジオ聞きに行ってるのかも」"
]
},
{
"id": 4068,
"kind": "msg",
"jp": [
"「天気予報ならさっき鈴奈さんが",
"聞いてましたぜ」"
]
},
{
"id": 4069,
"kind": "msg",
"jp": [
"「昨日ほどひでえ嵐にはならねえ",
"ようですが相変わらずだそうで」"
]
},
{
"id": 4070,
"kind": "msg",
"jp": [
"天気予報も終わってるなら",
"娯楽室でもないかな。"
]
},
{
"id": 4071,
"kind": "msg",
"jp": [
"「とりあえず椿くん探してみるよ。",
"起こしてくれてありがと」"
]
},
{
"id": 4072,
"kind": "msg",
"jp": [
"「いえいえ。",
"じゃあ俺は書斎にいますから」"
]
},
{
"id": 4073,
"kind": "msg",
"jp": [
"「うん、もし椿くんが顔出したら",
"探してたって言っといて」"
]
},
{
"id": 4074,
"kind": "msg",
"jp": [
"「はい、わかりました。",
"それじゃあ」"
]
},
{
"id": 4075,
"kind": "msg",
"jp": [
"「じゃあ、また後でね」"
]
},
{
"id": 4076,
"kind": "msg",
"jp": [
"ひらひらと手を振って日織は",
"階段の方へ向かった。"
]
},
{
"id": 4077,
"kind": "msg",
"jp": [
"（椿くん、",
"どこ行ったのかな・・・）"
]
},
{
"id": 4078,
"kind": "msg",
"jp": [
"念のためにもう一度扉を叩いて",
"みたけれど反応はなかった。"
]
},
{
"id": 4079,
"kind": "msg",
"jp": [
"（やっぱり部屋には",
"いないみたいだな）"
]
},
{
"id": 4080,
"kind": "msg",
"jp": [
"（なら多分、1階かなぁ・・・）"
]
},
{
"id": 4081,
"kind": "msg",
"jp": [
"「・・・ん」"
]
},
{
"id": 4082,
"kind": "msg",
"jp": [
"しまった、寝てた・・・?",
"かすかに聞こえた扉の音に慌てて",
"顔を上げる。"
]
},
{
"id": 4083,
"kind": "msg",
"jp": [
"（那須さんの部屋の中",
"からみたいだ・・・）"
]
},
{
"id": 4084,
"kind": "msg",
"jp": [
"じゃあ、もう起きてるのかな。",
"それなら安心なんだけど。"
]
},
{
"id": 4085,
"kind": "msg",
"jp": [
"「・・いっちに、いっちに・・・」"
]
},
{
"id": 4086,
"kind": "msg",
"jp": [
"（なんか・・・",
"体操してる・・・?）"
]
},
{
"id": 4087,
"kind": "msg",
"jp": [
"何時だろうと思って腕時計を",
"見てみると、まだ朝の4時に",
"なったばかりだった。"
]
},
{
"id": 4088,
"kind": "msg",
"jp": [
"（ほっとした、けど・・・",
"なんか力も抜けるのは",
"なんでだろう・・・）"
]
},
{
"id": 4089,
"kind": "msg",
"jp": [
"こんな朝早くから起きて体操してる",
"くらいだから、もう心配しなくて",
"いいよな。"
]
},
{
"id": 4090,
"kind": "msg",
"jp": [
"戻って寝よう・・・。"
]
},
{
"id": 4091,
"kind": "msg",
"jp": [
"「・・・んー、{和/なご}さん?」"
]
},
{
"id": 4092,
"kind": "msg",
"jp": [
"「あ、ごめん起こしちゃった?",
"まだ早いから寝てていいよ」"
]
},
{
"id": 4093,
"kind": "msg",
"jp": [
"「そうですかい・・・?",
"あんた、もう起きます?」"
]
},
{
"id": 4094,
"kind": "msg",
"jp": [
"「ううん、寝る」"
]
},
{
"id": 4095,
"kind": "msg",
"jp": [
"と、いうより実は今から",
"寝るんだけど。"
]
},
{
"id": 4096,
"kind": "msg",
"jp": [
"「そーですか・・・」"
]
},
{
"id": 4097,
"kind": "msg",
"jp": [
"日織もまだ寝ぼけてるみたいだ。",
"僕はそれ以上喋らず、そっと自分の",
"ベッドに潜り込んだ。"
]
},
{
"id": 4098,
"kind": "msg",
"jp": [
"（はぁ・・やっと眠れる・・・）"
]
},
{
"id": 4099,
"kind": "msg",
"jp": [
"（・・・・ん・・・）"
]
},
{
"id": 4100,
"kind": "msg",
"jp": [
"・・・ぼんやりと意識が",
"戻ってくるのを感じる。"
]
},
{
"id": 4101,
"kind": "msg",
"jp": [
"（・・・ああ、そうか。",
"家じゃないんだった・・・）"
]
},
{
"id": 4102,
"kind": "msg",
"jp": [
"さすがにそろそろ起きた方が",
"いいかな。"
]
},
{
"id": 4103,
"kind": "msg",
"jp": [
"「・・・ふぁ」"
]
},
{
"id": 4104,
"kind": "msg",
"jp": [
"起き上がって目をこすり、",
"手探りで眼鏡を探して掛ける。"
]
},
{
"id": 4105,
"kind": "msg",
"jp": [
"ごそごそと布団から這い出して",
"身支度を整えた。"
]
},
{
"id": 4106,
"kind": "msg",
"jp": [
"「・・・え?",
"{和/なご}さん?」"
]
},
{
"id": 4107,
"kind": "msg",
"jp": [
"「ん・・・?」"
]
},
{
"id": 4108,
"kind": "msg",
"jp": [
"どう見ても部屋じゃない。",
"なんでこんな所に・・・。"
]
},
{
"id": 4109,
"kind": "msg",
"jp": [
"「脅かさねえで下さいや、",
"てっきり先に起きてんだと",
"思ったら・・・」"
]
},
{
"id": 4110,
"kind": "msg",
"jp": [
"「・・・あっ!!」"
]
},
{
"id": 4111,
"kind": "msg",
"jp": [
"「・・・そうするよ」"
]
},
{
"id": 4112,
"kind": "msg",
"jp": [
"ふらふらするし、",
"ちょっと休まないとこれは",
"駄目そうだ・・・。"
]
},
{
"id": 4113,
"kind": "msg",
"jp": [
"どうにか部屋まで戻ってくると、",
"そのままベッドに潜り込んだ。"
]
},
{
"id": 4114,
"kind": "msg",
"jp": [
"・・・・・・。"
]
},
{
"id": 4115,
"kind": "msg",
"jp": [
"・・・。"
]
},
{
"id": 4116,
"kind": "msg",
"jp": [
"（そう言えば、静奈ちゃんが",
"言ってたのってなんだっけ）"
]
},
{
"id": 4117,
"kind": "msg",
"jp": [
"猫は斑井さん――か。",
"なんか書斎に本があるとか",
