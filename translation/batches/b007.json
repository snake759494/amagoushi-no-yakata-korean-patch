"kind": "msg",
"jp": [
"「おおい、誰か・・・!!",
"誰か来てくれ・・・!!」"
]
},
{
"id": 4256,
"kind": "msg",
"jp": [
"「那須さん・・・!?」"
]
},
{
"id": 4257,
"kind": "msg",
"jp": [
"どこかから、那須さんの大声がする。",
"しかも、なんだか尋常な様子じゃない。"
]
},
{
"id": 4258,
"kind": "msg",
"jp": [
"（あんな風に慌てたりする",
"人じゃないのに・・・）"
]
},
{
"id": 4259,
"kind": "msg",
"jp": [
"妙に嫌な予感がして、",
"声のする方へ駆け出した。"
]
},
{
"id": 4260,
"kind": "msg",
"jp": [
"「那須さん?",
"そこですか?」"
]
},
{
"id": 4261,
"kind": "msg",
"jp": [
"「ああ、和くんか!",
"来てくれ、椿くんが!!」"
]
},
{
"id": 4262,
"kind": "msg",
"jp": [
"足を止める間もなく、那須さんの手で",
"地下室の奥へ押し込まれる。"
]
},
{
"id": 4263,
"kind": "msg",
"jp": [
"「・・・・・!!」"
]
},
{
"id": 4264,
"kind": "msg",
"jp": [
"最初に目についたのは、",
"いつも椿くんが着ていたのと",
"同じ上着の色だった。"
]
},
{
"id": 4265,
"kind": "msg",
"jp": [
"それは、なぜか大きな長持の中に",
"収まっていて・・・。"
]
},
{
"id": 4266,
"kind": "msg",
"jp": [
"「・・・椿、くん・・・・?」"
]
},
{
"id": 4267,
"kind": "msg",
"jp": [
"・・・嘘だ。"
]
},
{
"id": 4268,
"kind": "msg",
"jp": [
"真っ先に頭に浮かんできたのは",
"心の底からの否定の言葉だった。"
]
},
{
"id": 4269,
"kind": "msg",
"jp": [
"だけど・・・。"
]
},
{
"id": 4270,
"kind": "msg",
"jp": [
"「つ・・椿・・・くん・・・」"
]
},
{
"id": 4271,
"kind": "msg",
"jp": [
"「・・・どう、して・・・」"
]
},
{
"id": 4272,
"kind": "msg",
"jp": [
"もう、生きていないことは、",
"一目でわかった・・・。"
]
},
{
"id": 4273,
"kind": "msg",
"jp": [
"ぐらり、と風景が歪んだ瞬間、",
"背後から支えられる。"
]
},
{
"id": 4274,
"kind": "msg",
"jp": [
"「大丈夫ですかい?」"
]
},
{
"id": 4275,
"kind": "msg",
"jp": [
"「日織・・・・」"
]
},
{
"id": 4276,
"kind": "msg",
"jp": [
"「つ・・・椿くん、が」"
]
},
{
"id": 4277,
"kind": "msg",
"jp": [
"「わかってます、",
"喋らなくていいですから。",
"立ってられますかい、真っ青ですぜ」"
]
},
{
"id": 4278,
"kind": "msg",
"jp": [
"「・・・大丈夫」"
]
},
{
"id": 4279,
"kind": "msg",
"jp": [
"頷いて、真っ直ぐ前を見た途端。"
]
},
{
"id": 4280,
"kind": "msg",
"jp": [
"また、変わり果てた椿くんの姿が",
"目に飛び込んでくる・・・。"
]
},
{
"id": 4281,
"kind": "msg",
"jp": [
"背後で、きゃあ、と誰かが悲鳴を",
"上げたのがやけに遠くのことのように",
"聞こえた。"
]
},
{
"id": 4282,
"kind": "msg",
"jp": [
"頭はひどくくらくらするのに、",
"どうしても椿くんの方から目が",
"離せない・・・。"
]
},
{
"id": 4283,
"kind": "msg",
"jp": [
"「・・・誰もいないよね」"
]
},
{
"id": 4284,
"kind": "msg",
"jp": [
"温室の中は、湿気のせいかなんとなく",
"空気が重く感じられた。"
]
},
{
"id": 4285,
"kind": "msg",
"jp": [
"少しだけ奥まで入ってみて、",
"そーっと例の『復讐』の紙がある辺りを",
"のぞいてみる・・・。"
]
},
{
"id": 4286,
"kind": "msg",
"jp": [
"誰かが、入ってきてあの釘を",
"置いていったんだ・・・。"
]
},
{
"id": 4287,
"kind": "msg",
"jp": [
"（・・・猫は、斑井さん――）"
]
},
{
"id": 4288,
"kind": "msg",
"jp": [
"なぜか、静奈ちゃんの言葉が",
"頭に浮かんだ。"
]
},
{
"id": 4289,
"kind": "msg",
"jp": [
"（黒猫・・・",
"それに、ベル・・・）"
]
},
{
"id": 4290,
"kind": "msg",
"jp": [
"（なら、あの釘は・・・?）"
]
},
{
"id": 4291,
"kind": "msg",
"jp": [
"これは・・・知らせなきゃ。",
"みんなに知らせた方がいい・・・!"
]
},
{
"id": 4292,
"kind": "msg",
"jp": [
"慌てて温室を飛び出して、",
"館へと駆け戻った。"
]
},
{
"id": 4293,
"kind": "msg",
"jp": [
"「おおい、和くーん!!」"
]
},
{
"id": 4294,
"kind": "msg",
"jp": [
"「那須さん・・・?」"
]
},
{
"id": 4295,
"kind": "msg",
"jp": [
"館に飛び込んだ途端、那須さんの",
"大声が聞こえた。"
]
},
{
"id": 4296,
"kind": "msg",
"jp": [
"どうしたんだろう・・・。",
"いつもは、あんなに焦ったような",
"声を出す人じゃないのに・・・。"
]
},
{
"id": 4297,
"kind": "msg",
"jp": [
"「那須さーん?",
"どうしたんですかー?」"
]
},
{
"id": 4298,
"kind": "msg",
"jp": [
"「ああ、和くん!",
"やっと来たか!」"
]
},
{
"id": 4299,
"kind": "msg",
"jp": [
"「な、なんですか?」"
]
},
{
"id": 4300,
"kind": "msg",
"jp": [
"「いいから来てくれ!",
"みんな、もう集まってる!」"
]
},
{
"id": 4301,
"kind": "msg",
"jp": [
"「え? あの・・・」"
]
},
{
"id": 4302,
"kind": "msg",
"jp": [
"有無を言わさず、地下室へと",
"引っ張って行かれる。"
]
},
{
"id": 4303,
"kind": "msg",
"jp": [
"「ど、どうしたの?",
"みんな集まって・・・」"
]
},
{
"id": 4304,
"kind": "msg",
"jp": [
"暗く沈んだ顔をしたまま、",
"日織は僕を手招いた。"
]
},
{
"id": 4305,
"kind": "msg",
"jp": [
"身を寄せ合うようにしていた",
"双子と御陵さんは、",
"僕に道を譲るように壁際に寄る。"
]
},
{
"id": 4306,
"kind": "msg",
"jp": [
"「やられましたぜ。",
"残念ながら、ね・・・」"
]
},
{
"id": 4307,
"kind": "msg",
"jp": [
"・・・そう言えば。",
"1人、足りない。"
]
},
{
"id": 4308,
"kind": "msg",
"jp": [
"部屋から出ない、と宣言した",
"暗石さんはともかく・・・。"
]
},
{
"id": 4309,
"kind": "msg",
"jp": [
"（・・・なんで・・・）"
]
},
{
"id": 4310,
"kind": "msg",
"jp": [
"（椿くんがいないんだろう・・・）"
]
},
{
"id": 4311,
"kind": "msg",
"jp": [
"日織が、奥の方を指さす。"
]
},
{
"id": 4312,
"kind": "msg",
"jp": [
"呆然としたまま、",
"もう1歩、2歩・・・・"
]
},
{
"id": 4313,
"kind": "msg",
"jp": [
"・・・それだけは。",
"それだけは、違ってたらいいのに、と",
"思っていた光景が・・・"
]
},
{
"id": 4314,
"kind": "msg",
"jp": [
"「・・・・・椿、くん・・・」"
]
},
{
"id": 4315,
"kind": "msg",
"jp": [
"・・・容赦なく横たわっていた。"
]
},
{
"id": 4316,
"kind": "msg",
"jp": [
"（・・・椿くん・・・・）"
]
},
{
"id": 4317,
"kind": "msg",
"jp": [
"きっと・・・明け方の、あの時・・・",
"僕が廊下にいたときに・・・"
]
},
{
"id": 4318,
"kind": "msg",
"jp": [
"（あの時のが、そうだったんだ・・・）"
]
},
{
"id": 4319,
"kind": "msg",
"jp": [
"（部屋を出て、そのままここへ",
"降りて来たんだ・・・）"
]
},
{
"id": 4320,
"kind": "msg",
"jp": [
"まさか、こんな事になるなんて",
"思わなかったけど。"
]
},
{
"id": 4321,
"kind": "msg",
"jp": [
"もしも僕があの時止めるとか",
"ついて行くとかしてれば・・・。"
]
},
{
"id": 4322,
"kind": "msg",
"jp": [
"「・・・・・・・温室は?」"
]
},
{
"id": 4323,
"kind": "msg",
"jp": [
"ぽつり、と静奈ちゃんが呟いた声で",
"ようやく我に返った。"
]
},
{
"id": 4324,
"kind": "msg",
"jp": [
"「え? 温室?」"
]
},
{
"id": 4325,
"kind": "msg",
"jp": [
"「あ、そうやわ・・・。",
"また何か、変なもん増えてるん",
"やないの・・・?」"
]
},
{
"id": 4326,
"kind": "msg",
"jp": [
"「ああ、そう言えば!",
"見に行った方がいいかな」"
]
},
{
"id": 4327,
"kind": "msg",
"jp": [
"「・・・じゃあ、とにかく",
"ここから出ましょうや」"
]
},
{
"id": 4328,
"kind": "msg",
"jp": [
"「椿さんには気の毒ですがね、",
"ここには鍵掛けておいた方が",
"いいでしょう」"
]
},
{
"id": 4329,
"kind": "msg",
"jp": [
"「そう・・・ですね・・・」"
]
},
{
"id": 4330,
"kind": "msg",
"jp": [
"「しゃあない、よね・・・。",
"・・・ごめんね、執事さん」"
]
},
{
"id": 4331,
"kind": "msg",
"jp": [
"そう言って、鈴奈ちゃんは",
"椿くんの亡骸に手を合わせる。"
]
},
{
"id": 4332,
"kind": "msg",
"jp": [
"つられるように、他のみんなも",
"それにならった。"
]
},
{
"id": 4333,
"kind": "msg",
"jp": [
"「・・・じゃあな、椿くん。",
"ぼくらが帰れる時になったら",
"迎えに来るからな」"
]
},
{
"id": 4334,
"kind": "msg",
"jp": [
"「・・・・・ばいばい」"
]
},
{
"id": 4335,
"kind": "msg",
"jp": [
"双子と御陵さん、それに那須さんが",
"続いて地下室から出て行った。"
]
},
{
"id": 4336,
"kind": "msg",
"jp": [
"「・・・{和/なご}さん。",
"こんなことにばっか使わせて",
"申し訳ねえんですけどね・・・」"
]
},
{
"id": 4337,
"kind": "msg",
"jp": [
"「携帯貸して下さい」"
]
},
{
"id": 4338,
"kind": "msg",
"jp": [
"「・・・ああ、そっか」"
]
},
{
"id": 4339,
"kind": "msg",
"jp": [
"「すいませんね」"
]
},
{
"id": 4340,
"kind": "msg",
"jp": [
"「・・・だって、",
"ばらばらに撮るより僕のに",
"収めてた方が・・・・」"
]
},
{
"id": 4341,
"kind": "msg",
"jp": [
"「ええ。",
"ありがとう、{和/なご}さん」"
]
},
{
"id": 4342,
"kind": "msg",
"jp": [
"取り出した携帯を日織に渡して、",
"僕は壁にもたれるように身を預け",
"呼吸を整える。"
]
},
{
"id": 4343,
"kind": "msg",
"jp": [
"気づかない間に、ずいぶん脈が",
"早くなっていた・・・。"
]
},
{
"id": 4344,
"kind": "msg",
"jp": [
"（なんで・・・?",
"なんで、こんなことに・・・）"
]
},
{
"id": 4345,
"kind": "msg",
"jp": [
"「・・・すいません、椿さん。",
"ちょいと寂しいでしょうが、",
"待ってて下さいね」"
]
},
{
"id": 4346,
"kind": "msg",
"jp": [
"そう言って、日織は長持の蓋を",
"静かに閉めた。"
]
},
{
"id": 4347,
"kind": "msg",
"jp": [
"「はい、{和/なご}さん。",
"どうもありがとうございました」"
]
},
{
"id": 4348,
"kind": "msg",
"jp": [
"返された携帯を、機械的に",
"上着のポケットにしまう。"
]
},
{
"id": 4349,
"kind": "msg",
"jp": [
"「行きましょう」"
]
},
{
"id": 4350,
"kind": "msg",
"jp": [
"「・・・・・・・うん」"
]
},
{
"id": 4351,
"kind": "msg",
"jp": [
"（ごめん、僕・・・",
"なにも出来なくて・・・）"
]
},
{
"id": 4352,
"kind": "msg",
"jp": [
"（・・・おやすみ・・・）"
]
},
{
"id": 4353,
"kind": "msg",
"jp": [
"日織が娯楽室の鍵で地下室を封鎖し、",
"そのまま温室へ向かう。"
]
},
{
"id": 4354,
"kind": "msg",
"jp": [
"他のみんなはもう先に温室の中に",
"入っていて、例の復讐と書かれた",
"紙の前にいた。"
]
},
{
"id": 4355,
"kind": "msg",
"jp": [
"「えーと・・・",
"昨日あったのどれだっけ」"
]
},
{
"id": 4356,
"kind": "msg",
"jp": [
"「猫とベル」"
]
},
{
"id": 4357,
"kind": "msg",
"jp": [
"「じゃあ、あの釘は?」"
]
},
{
"id": 4358,
"kind": "msg",
"jp": [
"「なかった」"
]
},
{
"id": 4359,
"kind": "msg",
"jp": [
"「そうか、じゃあ釘が増えたんだな」"
]
},
{
"id": 4360,
"kind": "msg",
"jp": [
"「・・・・そやね」"
]
},
{
"id": 4361,
"kind": "msg",
"jp": [
"黒猫と、ベルの他に大きくて長い",
"釘が転がっていた。",
"五寸釘、というヤツだろう。"
]
},
{
"id": 4362,
"kind": "msg",
"jp": [
"「那須さん、相変わらず",
"覚えてねえんですね・・・」"
]
},
{
"id": 4363,
"kind": "msg",
"jp": [
"椿くんが居たら絶対、馬鹿かよって",
"怒鳴られてるところだろうな・・・。"
]
},
{
"id": 4364,
"kind": "msg",
"jp": [
"いつも呑気な那須さんもなんだか",
"神妙な顔で頭をかいている。"
]
},
{
"id": 4365,
"kind": "msg",
"jp": [
"（猫は斑井さん・・・",
"ベルは・・・椿くん・・・）"
]
},
{
"id": 4366,
"kind": "msg",
"jp": [
"「ね、もう・・・戻ろ。",
"確認したんやし・・・ね?」"
]
},
{
"id": 4367,
"kind": "msg",
"jp": [
"気味が悪そうに、",
"鈴奈ちゃんが懇願する。"
]
},
{
"id": 4368,
"kind": "msg",
"jp": [
"誰も反対する者などいるわけもなく、",
"僕らは早々に館に戻った。"
]
},
{
"id": 4369,
"kind": "msg",
"jp": [
"「あ、そうや・・・。",
"また何か、変なもん増えてるん",
"ちゃうの・・・?」"
]
},
{
"id": 4370,
"kind": "msg",
"jp": [
"「・・・・・・・・あ」"
]
},
{
"id": 4371,
"kind": "msg",
"jp": [
"「・・・あったよ・・・」"
]
},
{
"id": 4372,
"kind": "msg",
"jp": [
"「{和/なご}さん、見たんですかい?」"
]
},
{
"id": 4373,
"kind": "msg",
"jp": [
"「温室に行ってたんだよ、僕。",
"それで、みんなに知らせようと",
"思って戻ってきたら・・・」"
]
},
{
"id": 4374,
"kind": "msg",
"jp": [
"「それで那須さんの大声でも",
"なかなか現れなかったんですね」"
]
},
{
"id": 4375,
"kind": "msg",
"jp": [
"「で、今度は何です?」"
]
},
{
"id": 4376,
"kind": "msg",
"jp": [
"「釘だった」"
]
},
{
"id": 4377,
"kind": "msg",
"jp": [
"「釘?」"
]
},
{
"id": 4378,
"kind": "msg",
"jp": [
"「うん、すごく長くて大きいヤツ。",
"五寸釘っていうの? あれ」"
]
},
{
"id": 4379,
"kind": "msg",
"jp": [
"「五寸釘・・・",
"なんでそんなものが?」"
]
},
{
"id": 4380,
"kind": "msg",
"jp": [
"「わからないです、けど・・・」"
]
},
{
"id": 4381,
"kind": "msg",
"jp": [
"「・・・まだ、続くんですね」"
]
},
{
"id": 4382,
"kind": "msg",
"jp": [
"抑揚のないか細い声で、",
"御陵さんが呟いた・・・。"
]
},
{
"id": 4383,
"kind": "msg",
"jp": [
"「・・・・行こ」"
]
},
{
"id": 4384,
"kind": "msg",
"jp": [
"「執事さん、",
"寝かしといてあげよ」"
]
},
{
"id": 4385,
"kind": "msg",
"jp": [
"「・・・そうですね。",
"ちょいと寂しいでしょうが、",
"仕方ねえ」"
]
},
{
"id": 4386,
"kind": "msg",
"jp": [
"「ここは、鍵掛けて閉めときましょう」"
]
},
{
"id": 4387,
"kind": "msg",
"jp": [
"「・・・ばいばい。",
"帰れるようになったら、一緒に帰ろ」"
]
},
{
"id": 4388,
"kind": "msg",
"jp": [
"「・・・・さようなら」"
]
},
{
"id": 4389,
"kind": "msg",
"jp": [
"「・・・すいません、椿さん。",
"雨が止むまで、待ってて下さいね」"
]
},
{
"id": 4390,
"kind": "msg",
"jp": [
"「さ、{和/なご}さん。",
"ありがとうございました」"
]
},
{
"id": 4391,
"kind": "msg",
"jp": [
"返された携帯を、機械的に上着の",
"ポケットにしまう。"
]
},
{
"id": 4392,
"kind": "msg",
"jp": [
"「行きましょうや」"
]
},
{
"id": 4393,
"kind": "choice",
"jp": [
"部屋に帰って休む"
]
},
{
"id": 4394,
"kind": "choice",
"jp": [
"もう少しここにいる"
]
},
{
"id": 4395,
"kind": "choice",
"jp": [
"僕も部屋にこもる"
]
},
{
"id": 4396,
"kind": "msg",
"jp": [
"居間に戻ると、みんな重苦しく",
"黙り込んだままでそれぞれソファに",
"身を沈める・・・。"
]
},
{
"id": 4397,
"kind": "msg",
"jp": [
"・・・頭が真っ白だった。",
"何か考えようにも、何をどう考えれば",
"いいのかすら思いつかないくらい。"
]
},
{
"id": 4398,
"kind": "msg",
"jp": [
"なんとなく見回してみると、",
"他の人達も似たような状態らしくて",
"どこかぼんやりした顔つきをしている。"
]
},
{
"id": 4399,
"kind": "msg",
"jp": [
"（そりゃあ・・・そうだよな）"
]
},
{
"id": 4400,
"kind": "msg",
"jp": [
"（だって、まさか・・・）"
]
},
{
"id": 4401,
"kind": "msg",
"jp": [
"椿くんが、と思った途端、",
"目と鼻の奥の方がつんと痛くなった。"
]
},
{
"id": 4402,
"kind": "msg",
"jp": [
"（・・・なんでだろう）"
]
},
{
"id": 4403,
"kind": "msg",
"jp": [
"（まだ会ったばっかりで・・・",
"そんなにたくさん話したわけでも",
"なかったし・・・）"
]
},
{
"id": 4404,
"kind": "msg",
"jp": [
"何がそんなに悲しいのかも",
"よくわからなかった。"
]
},
{
"id": 4405,
"kind": "msg",
"jp": [
"もしかしたら、椿くんがいないことが",
"悲しいというより、自分がこんな所に",
"いるのが悲しいのかもしれない・・・。"
]
},
{
"id": 4406,
"kind": "msg",
"jp": [
"（・・・嫌だなぁ・・・）"
]
},
{
"id": 4407,
"kind": "msg",
"jp": [
"どっちも嫌だ。",
"会って間もない人のために泣きそうに",
"なっている不安定な自分も。"
]
},
{
"id": 4408,
"kind": "msg",
"jp": [
"・・・理不尽な形で死んでしまった",
"椿くんのことよりも、自分を哀れんで",
"いるような気がするのも・・・。"
]
},
{
"id": 4409,
"kind": "msg",
"jp": [
"（でも、そのどっちか",
"でしかないんだよ・・・）"
]
},
{
"id": 4410,
"kind": "msg",
"jp": [
"（なんでだろう・・・。",
"僕は・・・どうして・・・）"
]
},
{
"id": 4411,
"kind": "msg",
"jp": [
"「・・・・執事さん、",
"いつ亡くなりんさったん」"
]
},
{
"id": 4412,
"kind": "msg",
"jp": [
"ぽつり、と沈黙を破った静奈ちゃんの",
"声にはっと顔を上げる。"
]
},
{
"id": 4413,
"kind": "msg",
"jp": [
"周りもみな、一様にぽかんとした",
"顔で彼女を見つめていた。"
]
},
{
"id": 4414,
"kind": "msg",
"jp": [
"「いつ・・・?」"
]
},
{
"id": 4415,
"kind": "msg",
"jp": [
"「そら、やっぱり・・・",
"夕べ遅ぉにとちゃうの?」"
]
},
{
"id": 4416,
"kind": "msg",
"jp": [
"「いえ、今朝早くでしょう」"
]
},
{
"id": 4417,
"kind": "msg",
"jp": [
"「なんで?",
"斑井さんの時は・・・」"
]
},
{
"id": 4418,
"kind": "msg",
"jp": [
"「斑井さんの時ほど",
"時間たってへんかったんはわかった」"
]
},
{
"id": 4419,
"kind": "msg",
"jp": [
"「・・・腕時計が・・・」"
]
},
{
"id": 4420,
"kind": "msg",
"jp": [
"「ええ、壊れてましたよね。",
"5時前指したままで」"
]
},
{
"id": 4421,
"kind": "msg",
"jp": [
"「そうだったんですの?」"
]
},
{
"id": 4422,
"kind": "msg",
"jp": [
"「はい・・・。",
"僕も見ました・・・」"
]
},
{
"id": 4423,
"kind": "msg",
"jp": [
"「夕方の5時頃なら、まだ普通に",
"生きてたの確かですし・・・」"
]
},
{
"id": 4424,
"kind": "msg",
"jp": [
"「そこまで時間が経ってねえのも",
"静奈さんが言ったとおりですよ」"
]
},
{
"id": 4425,
"kind": "msg",
"jp": [
"「ええと、それはあの、",
"死斑とかそういうのんで?」"
]
},
{
"id": 4426,
"kind": "msg",
"jp": [
"「じゃあ、その腕時計が",
"止まってた時間っていうのが、",
"椿くんが亡くなった時間?」"
]
},
{
"id": 4427,
"kind": "msg",
"jp": [
"「・・・多分。",
"ただ、亡くなった瞬間ぴったりに時計が",
"壊れたかどうかははっきりしませんが」"
]
},
{
"id": 4428,
"kind": "msg",
"jp": [
"「生きてるときに壊れてりゃあ、",
"ガラスにひび入ってたし外すなり",
"なんなりするでしょうがね」"
]
},
{
"id": 4429,
"kind": "msg",
"jp": [
"「・・・そやね」"
]
},
{
"id": 4430,
"kind": "msg",
"jp": [
"「朝の5時前・・・",
"僕はまだ寝てたけど・・・」"
]
},
{
"id": 4431,
"kind": "msg",
"jp": [
"（・・・みんな、けっこう普通に",
"起きて騒いだりしてたんだ・・・）"
]
},
{
"id": 4432,
"kind": "msg",
"jp": [
"そりゃあそうだろうな。",
"まさか、こんなことになってる",
"なんて誰も思わないだろうし・・・。"
]
},
{
"id": 4433,
"kind": "msg",
"jp": [
"（誰も・・・",
"犯人以外は・・・）"
]
},
{
"id": 4434,
"kind": "msg",
"jp": [
"「・・・・お姉ちゃん、",
"どないする・・・?」"
]
},
{
"id": 4435,
"kind": "msg",
"jp": [
"「帰る」"
]
},
{
"id": 4436,
"kind": "msg",
"jp": [
"「そう・・・。",
"ほな、うちらは・・・」"
]
},
{
"id": 4437,
"kind": "msg",
"jp": [
"「私も、あまり・・・。",
"もう、部屋から出ないように",
"します・・・」"
]
},
{
"id": 4438,
"kind": "msg",
"jp": [
"すっかり気落ちしてしまった様子の",
