]
},
{
"id": 32014,
"kind": "choice",
"jp": [
"これなら大丈夫かも"
]
},
{
"id": 32015,
"kind": "choice",
"jp": [
"開かなくしよう"
]
},
{
"id": 32016,
"kind": "choice",
"jp": [
"考えを整理する"
]
},
{
"id": 32017,
"kind": "msg",
"jp": [
"「はい、お願いします。",
"きっと腹減らしてるでしょう」"
]
},
{
"id": 32018,
"kind": "msg",
"jp": [
"サンドイッチの載った皿をもらって",
"2階へ上がる。"
]
},
{
"id": 32019,
"kind": "msg",
"jp": [
"「晩ご飯持ってきたよ」"
]
},
{
"id": 32020,
"kind": "msg",
"jp": [
"「日織達が作ったんだけど",
"よかったらどうぞって」"
]
},
{
"id": 32021,
"kind": "msg",
"jp": [
"「いやー、助かったぜ",
"腹減ってたんだよなー!」"
]
},
{
"id": 32022,
"kind": "msg",
"jp": [
"「うまそうじゃん。",
"日織のやつマジで器用だな」"
]
},
{
"id": 32023,
"kind": "msg",
"jp": [
"「みなさまによろしく、",
"日織のやつ器用だなって」"
]
},
{
"id": 32024,
"kind": "msg",
"jp": [
"「俺らも部屋戻ります?」"
]
},
{
"id": 32025,
"kind": "msg",
"jp": [
"「うーん・・・",
"また降りてくるのもなあ」"
]
},
{
"id": 32026,
"kind": "msg",
"jp": [
"「じゃ、ここでさっさと",
"食っちまいましょう」"
]
},
{
"id": 32027,
"kind": "msg",
"jp": [
"手っ取り早く食べてしまって",
"風呂に入ると部屋に戻った。"
]
},
{
"id": 32028,
"kind": "msg",
"jp": [
"「御陵さんは飯どうするん",
"ですかねえ」"
]
},
{
"id": 32029,
"kind": "msg",
"jp": [
"「何か作る?」"
]
},
{
"id": 32030,
"kind": "msg",
"jp": [
"「そうですね。",
"飯が残ってますから、",
"おにぎりでも作りましょうか」"
]
},
{
"id": 32031,
"kind": "msg",
"jp": [
"「受け取ってくれるかな?」"
]
},
{
"id": 32032,
"kind": "msg",
"jp": [
"「いらねえようなら朝飯に",
"でもすりゃいいですよ」"
]
},
{
"id": 32033,
"kind": "msg",
"jp": [
"「そうだね。",
"持ってくだけ持ってってみよう」"
]
},
{
"id": 32034,
"kind": "msg",
"jp": [
"「{和/なご}さん、これ",
"持ってってくれます?」"
]
},
{
"id": 32035,
"kind": "msg",
"jp": [
"「なんか作って",
"差し入れましょうか」"
]
},
{
"id": 32036,
"kind": "msg",
"jp": [
"「飯は残ってますから、",
"おにぎりくらいなら作れますよ」"
]
},
{
"id": 32037,
"kind": "msg",
"jp": [
"「暗石さんとこ行ってみるよ」"
]
},
{
"id": 32038,
"kind": "msg",
"jp": [
"「はい、お願いします。",
"暗石さんによろしく」"
]
},
{
"id": 32039,
"kind": "msg",
"jp": [
"「しょうがねえですね。",
"そいつは朝飯にでもしましょう」"
]
},
{
"id": 32040,
"kind": "msg",
"jp": [
"手早く台所を片付けると",
"部屋に戻った・・・。"
]
},
{
"id": 32041,
"kind": "msg",
"jp": [
"日織は嬉しそうに言って",
"洗った食器を片付けていった。"
]
},
{
"id": 32042,
"kind": "msg",
"jp": [
"台所を片付けてしまうと",
"早々に部屋へ引き上げた。"
]
},
{
"id": 32043,
"kind": "msg",
"jp": [
"「お邪魔します。",
"あの、これよかったらどうぞ」"
]
},
{
"id": 32044,
"kind": "msg",
"jp": [
"「ごめんなさいね、",
"気を遣っていただいて」"
]
},
{
"id": 32045,
"kind": "msg",
"jp": [
"「いえ、あの、",
"作ったのは日織なんです、",
"僕は持ってきただけで」"
]
},
{
"id": 32046,
"kind": "msg",
"jp": [
"「気を遣って下さったのは",
"同じでしょう?」"
]
},
{
"id": 32047,
"kind": "msg",
"jp": [
"「でも、日織さんには",
"ごちそうさまとお伝え",
"下さいな」"
]
},
{
"id": 32048,
"kind": "msg",
"jp": [
"「はい、わかりました。",
"それじゃ、おやすみなさい」"
]
},
{
"id": 32049,
"kind": "msg",
"jp": [
"「お邪魔します。",
"あの、これ日織が作ったんですが",
"よかったらどうぞ」"
]
},
{
"id": 32050,
"kind": "msg",
"jp": [
"「・・・そうですか。",
"ごちそうさまです、",
"いただいておきますわ」"
]
},
{
"id": 32051,
"kind": "msg",
"jp": [
"「はい、それじゃあ・・・」"
]
},
{
"id": 32052,
"kind": "msg",
"jp": [
"「・・・おやすみなさい」"
]
},
{
"id": 32053,
"kind": "msg",
"jp": [
"「ただいま」"
]
},
{
"id": 32054,
"kind": "msg",
"jp": [
"「うん、日織に",
"ごちそうさまですって」"
]
},
{
"id": 32055,
"kind": "msg",
"jp": [
"「そうですか。",
"じゃ、俺らも",
"食っちまいましょう」"
]
},
{
"id": 32056,
"kind": "msg",
"jp": [
"手早く食事を終えて片付けると",
"部屋へと引き上げた。"
]
},
{
"id": 32057,
"kind": "msg",
"jp": [
"「窓は鍵かからないからな。",
"大丈夫かなあ・・・」"
]
},
{
"id": 32058,
"kind": "msg",
"jp": [
"「やっぱり交代で起きといた方が",
"よくない?」"
]
},
{
"id": 32059,
"kind": "msg",
"jp": [
"「俺が危ねえってんでしょ、",
"覚えてますって」"
]
},
{
"id": 32060,
"kind": "msg",
"jp": [
"「幸い、{和/なご}さんが同じ部屋に",
"いるってのは犯人にとっても",
"予定外でしょうからね」"
]
},
{
"id": 32061,
"kind": "msg",
"jp": [
"「うかつに部屋に乗り込んで",
"物音でも立てたらたちまち",
"二対一になるわけで」"
]
},
{
"id": 32062,
"kind": "msg",
"jp": [
"「いや、本当に戦えって",
"言ってんじゃねえですぜ?」"
]
},
{
"id": 32063,
"kind": "msg",
"jp": [
"「犯人だってそれは避けてえ",
"ところでしょうからね。",
"鳴子でも仕掛けときましょうや」"
]
},
{
"id": 32064,
"kind": "msg",
"jp": [
"「なるこ?」"
]
},
{
"id": 32065,
"kind": "msg",
"jp": [
"「扉と、念のため窓に、",
"ちょいとでも開けようとしたら",
"音の鳴る仕掛けをね」"
]
},
{
"id": 32066,
"kind": "msg",
"jp": [
"「ああ、なるほど。",
"何で作る?」"
]
},
{
"id": 32067,
"kind": "msg",
"jp": [
"「俺の荷物に帯の代えが",
"ありますから・・・」"
]
},
{
"id": 32068,
"kind": "msg",
"jp": [
"「それを繋いで",
"扉のノブとそこの小机の",
"足を結んどきましょうか」"
]
},
{
"id": 32069,
"kind": "msg",
"jp": [
"「扉を開けたら、",
"机がひっくり返るのか。",
"それならさすがに起きるな」"
]
},
{
"id": 32070,
"kind": "msg",
"jp": [
"「あとは窓ですね。",
"こっちはどうしますかね」"
]
},
{
"id": 32071,
"kind": "msg",
"jp": [
"「んーと・・・」"
]
},
{
"id": 32072,
"kind": "msg",
"jp": [
"「紐とか引っ掛けるところが",
"見当たらないしなあ」"
]
},
{
"id": 32073,
"kind": "msg",
"jp": [
"窓に近づいて開けてみようと",
"すると・・・"
]
},
{
"id": 32074,
"kind": "msg",
"jp": [
"「うわ、硬い」"
]
},
{
"id": 32075,
"kind": "msg",
"jp": [
"「錆びてんじゃ",
"ねえですかい?」"
]
},
{
"id": 32076,
"kind": "msg",
"jp": [
"「そうかも、",
"なんとか開くには",
"開くけど・・・」"
]
},
{
"id": 32077,
"kind": "msg",
"jp": [
"「これなら大丈夫",
"なんじゃないかな」"
]
},
{
"id": 32078,
"kind": "msg",
"jp": [
"「人が通れる広さまで",
"開けられる前に起きそうだよ」"
]
},
{
"id": 32079,
"kind": "msg",
"jp": [
"「そうみてえですね。",
"窓は大丈夫か・・・」"
]
},
{
"id": 32080,
"kind": "msg",
"jp": [
"「完全に開かないように",
"出来ないかな。",
"隙間に何か噛ませるとかで」"
]
},
{
"id": 32081,
"kind": "msg",
"jp": [
"「それがよさそうですね。",
"紙でもたたんで突っ込みますか」"
]
},
{
"id": 32082,
"kind": "msg",
"jp": [
"「だったら、",
"僕の手帳でいいかな」"
]
},
{
"id": 32083,
"kind": "msg",
"jp": [
"何枚か千切ってたたむと",
"窓の横の部分の溝に強引に",
"詰め込んだ。"
]
},
{
"id": 32084,
"kind": "msg",
"jp": [
"「ま・・窓が降りない・・・」"
]
},
{
"id": 32085,
"kind": "msg",
"jp": [
"「はいはい、",
"代わりましょう」"
]
},
{
"id": 32086,
"kind": "msg",
"jp": [
"僕の力ではまったく動かなく",
"なってしまったので日織に",
"代わってもらう。"
]
},
{
"id": 32087,
"kind": "msg",
"jp": [
"それでもかなり苦戦して",
"どうにか閉めることが出来た。"
]
},
{
"id": 32088,
"kind": "msg",
"jp": [
"「うん、",
"もう全然動かないな」"
]
},
{
"id": 32089,
"kind": "msg",
"jp": [
"かなり力をいれて開けようと",
"してみたがもう無理だ。"
]
},
{
"id": 32090,
"kind": "msg",
"jp": [
"これなら那須さんでもない",
"限りは開きそうにない。"
]
},
{
"id": 32091,
"kind": "msg",
"jp": [
"（・・・那須さんの場合",
"強引に開けようとしたら",
"窓ごと粉砕しそうだけど）"
]
},
{
"id": 32092,
"kind": "msg",
"jp": [
"「じゃ、扉の仕掛け",
"しちまって休みますか」"
]
},
{
"id": 32093,
"kind": "msg",
"jp": [
"「うん、手伝おうか?」"
]
},
{
"id": 32094,
"kind": "msg",
"jp": [
"「いいですよ、",
"結ぶだけですしね」"
]
},
{
"id": 32095,
"kind": "msg",
"jp": [
"そう言って日織は荷物から",
"帯を二本ほど取り出して",
"仕掛けにかかる。"
]
},
{
"id": 32096,
"kind": "msg",
"jp": [
"（これで大丈夫かな・・・）"
]
},
{
"id": 32097,
"kind": "msg",
"jp": [
"寝ないでいた方が",
"安全なんだろうけど。"
]
},
{
"id": 32098,
"kind": "msg",
"jp": [
"（・・・いや、",
"犯人が誰かわかればもっと",
"手っ取り早いのか・・・）"
]
},
{
"id": 32099,
"kind": "msg",
"jp": [
"（ちょっと今までわかってる",
"ことだけでも整理しておこうかな）"
]
},
{
"id": 32100,
"kind": "msg",
"jp": [
"駄目だ、もう眠いや。",
"全身が悲鳴をあげてとっとと",
"休ませろと言ってるみたいだ。"
]
},
{
"id": 32101,
"kind": "msg",
"jp": [
"「お待たせしました。",
"もう休んで大丈夫ですぜ」"
]
},
{
"id": 32102,
"kind": "msg",
"jp": [
"「仕掛けは朝には",
"忘れねえうちに取っとき",
"ますから」"
]
},
{
"id": 32103,
"kind": "msg",
"jp": [
"「うん、寝る・・・」"
]
},
{
"id": 32104,
"kind": "msg",
"jp": [
"もぞもぞとそのまま布団に",
"潜り込んで、意識を失う",
"ように眠ってしまった・・・。"
]
},
{
"id": 32105,
"kind": "msg",
"jp": [
"「さて、と。",
"例の仕掛けやっときますか」"
]
},
{
"id": 32106,
"kind": "msg",
"jp": [
"「いや、その・・・",
"今更だけど本当にあってる",
"かなって・・・」"
]
},
{
"id": 32107,
"kind": "msg",
"jp": [
"「あ、あの、ごめん",
"今言うなって自分でも",
"思うんだけど、えっと」"
]
},
{
"id": 32108,
"kind": "msg",
"jp": [
"「はいはい、",
"落ち着いて下さいって」"
]
},
{
"id": 32109,
"kind": "msg",
"jp": [
"「・・・無理もねえですよ。",
"いざ夜が来ると急に不安に",
"なって来たんでしょう」"
]
},
{
"id": 32110,
"kind": "msg",
"jp": [
"「疲れてんですよ。",
"やっぱ、ゆっくり休んだ方が",
"いいですって」"
]
},
{
"id": 32111,
"kind": "msg",
"jp": [
"「そうかな・・・」"
]
},
{
"id": 32112,
"kind": "msg",
"jp": [
"確かに、疲れがたまってて",
"思考も鈍ってる気はする。"
]
},
{
"id": 32113,
"kind": "msg",
"jp": [
"「仕掛け作っちまいますから",
"もう横になってくれてて",
"いいですぜ」"
]
},
{
"id": 32114,
"kind": "msg",
"jp": [
"・・・とは言っても、",
"不安はなかなか消えない。"
]
},
{
"id": 32115,
"kind": "msg",
"jp": [
"「・・・出来ましたぜ。",
"ほら、休んだ休んだ」"
]
},
{
"id": 32116,
"kind": "msg",
"jp": [
"ぼーっとして一瞬頭が",
"真っ白になってた。"
]
},
{
"id": 32117,
"kind": "msg",
"jp": [
"（本当にちょっと寝た方が",
"よさそうだ・・・）"
]
},
{
"id": 32118,
"kind": "msg",
"jp": [
"諦めて布団に潜り込み",
"目を閉じた・・・。"
]
},
{
"id": 32119,
"kind": "msg",
"jp": [
"部屋に戻ってくると、",
"日織は何も言わず扉の仕掛けを",
"作り始めてくれた。"
]
},
{
"id": 32120,
"kind": "msg",
"jp": [
"（また違ったらどうしよう。",
"朝になって誰か違う人が・・・）"
]
},
{
"id": 32121,
"kind": "msg",
"jp": [
"考えれば考えるほど",
"不安になってくる。"
]
},
{
"id": 32122,
"kind": "msg",
"jp": [
"（犯人・・・",
"誰が犯人かさえわかれば・・・）"
]
},
{
"id": 32123,
"kind": "msg",
"jp": [
"「・・・さん?",
"{和/なご}さん?」"
]
},
{
"id": 32124,
"kind": "msg",
"jp": [
"「大丈夫ですかい?",
"そんなに根詰めねえで",
"下さいよ」"
]
},
{
"id": 32125,
"kind": "msg",
"jp": [
"「あ・・・",
"うん、大丈夫・・・」"
]
},
{
"id": 32126,
"kind": "msg",
"jp": [
"「もう休んで下さいな」"
]
},
{
"id": 32127,
"kind": "msg",
"jp": [
"「・・・うん。",
"そうするよ・・・」"
]
},
{
"id": 32128,
"kind": "msg",
"jp": [
"もう、まともに",
"頭が働いてない。"
]
},
{
"id": 32129,
"kind": "msg",
"jp": [
"身体を引きずるように",
"布団の中へ潜り込んだ・・・。"
]
},
{
"id": 32130,
"kind": "msg",
"jp": [
"殺風景な部屋、というか空間に出た。"
]
},
{
"id": 32131,
"kind": "msg",
"jp": [
"（・・・階段だ・・・）"
]
},
{
"id": 32132,
"kind": "msg",
"jp": [
"入ってきたところ以外に扉は",
"見当たらないみたいだ。"
]
},
{
"id": 32133,
"kind": "msg",
"jp": [
"（あの階段は、",
"どこにつながってるんだろう?）"
]
},
{
"id": 32134,
"kind": "msg",
"jp": [
"おそるおそる階段を降りてみると",
"がらんとした空間に出た。"
]
},
{
"id": 32135,
"kind": "msg",
"jp": [
"（なんで温室の地下に",
"こんな場所が・・・?）"
]
},
{
"id": 32136,
"kind": "msg",
"jp": [
"扉がある・・・。",
"あの奥はどうなってるんだろう。"
]
},
{
"id": 32137,
"kind": "msg",
"jp": [
"温室の地下に降りてみた。"
]
},
{
"id": 32138,
"kind": "msg",
"jp": [
"殺風景だな・・・。"
]
},
{
"id": 32139,
"kind": "msg",
"jp": [
"温室の地下に来てみた。"
]
},
{
"id": 32140,
"kind": "msg",
"jp": [
"床はところどころ湿っている。"
]
},
{
"id": 32141,
"kind": "msg",
"jp": [
"上にあがる階段だ。"
]
},
{
"id": 32142,
"kind": "msg",
"jp": [
"扉があるのはこちら側の壁",
"だけのようだ。"
]
},
{
"id": 32143,
"kind": "msg",
"jp": [
"冷たそうな石壁だ。"
]
},
{
"id": 32144,
"kind": "msg",
"jp": [
"壁はひんやりとしていて硬い。"
]
},
{
"id": 32145,
"kind": "msg",
"jp": [
"ちょっと湿気た壁だ。"
]
},
{
"id": 32146,
"kind": "choice",
"jp": [
"来た側の壁を押す"
]
},
{
"id": 32147,
"kind": "choice",
"jp": [
"前の壁を押す"
]
},
{
"id": 32148,
"kind": "choice",
"jp": [
"地下道へ戻る"
]
},
{
"id": 32149,
"kind": "msg",
"jp": [
"（ここは・・・",
"行き止まりかな）"
]
},
{
"id": 32150,
"kind": "msg",
"jp": [
"（・・・?",
"なんか床に染みみたいなのが",
"あるような・・・）"
]
},
{
"id": 32151,
"kind": "msg",
"jp": [
"ぼんやりとした不気味な色を放つ",
"染みが壁の下から広がっている。"
]
},
{
"id": 32152,
"kind": "msg",
"jp": [
"壁の向こうから流れてきている",
"ようだった。"
]
},
{
"id": 32153,
"kind": "msg",
"jp": [
"（この壁も開くのかな・・・）"
]
},
{
"id": 32154,
"kind": "msg",
"jp": [
"でも、開けちゃうと絶対",
"跡が残るだろうな。"
]
},
{
"id": 32155,
"kind": "msg",
"jp": [
"開けたらどこに出るか",
"はっきりわからないのに",
"それはちょっと・・・。"
]
},
{
"id": 32156,
"kind": "msg",
"jp": [
"（なんか怖・・・いや、",
"危ないかもしれないから",
"やめとこう・・・）"
]
},
{
"id": 32157,
"kind": "msg",
"jp": [
"蛍光塗料が染み出してきている",
"ところまで来た。"
]
},
{
"id": 32158,
"kind": "msg",
"jp": [
"なんだあれ。",
"変な色の染みが・・・。"
]
},
{
"id": 32159,
"kind": "msg",
"jp": [
"（ペンキ?",
"蛍光塗料みたいだ・・・）"
]
},
{
"id": 32160,
"kind": "msg",
"jp": [
"しかも、あの色って・・・",
"見覚えがある・・・。"
]
},
{
"id": 32161,
"kind": "msg",
"jp": [
"「・・・行き止まり",
"なのかな・・・?」"
]
},
{
"id": 32162,
"kind": "msg",
"jp": [
"「あ・・・!!」"
]
},
{
"id": 32163,
"kind": "msg",
"jp": [
"突き当たりの壁の下に、",
"ぼんやりと不気味に広がる",
"染みがあった。"
]
},
{
"id": 32164,
"kind": "msg",
"jp": [
"「この色・・・」"
]
},
{
"id": 32165,
"kind": "msg",
"jp": [
"見覚えがある。",
"缶が倒れて流れ出していた",
"蛍光塗料の色だ。"
]
},
{
"id": 32166,
"kind": "msg",
"jp": [
"（じゃあ、",
"この壁の向こうは・・・）"
]
},
{
"id": 32167,
"kind": "msg",
"jp": [
"（・・・地下室なんだ）"
]
},
{
"id": 32168,
"kind": "msg",
"jp": [
"塗料が流れてくる隙間が",
"あるということは、",
"この壁は開いて通れるんだろう。"
]
},
{
"id": 32169,
"kind": "msg",
"jp": [
"（今は・・・",
"塗料が乱れてる部分はないから",
"誰も通ってないんだな・・・）"
]
},
{
"id": 32170,
"kind": "msg",
"jp": [
"乾く前でも後でも、壁を動かしたら",
"さすがに何かしら跡が残るだろう。"
]
},
{
"id": 32171,
"kind": "msg",
"jp": [
"よく目を凝らしてみたが、",
"そういった痕跡はなかった。"
]
},
{
"id": 32172,
"kind": "msg",
"jp": [
"（・・・開けてみたいけど）"
]
},
{
"id": 32173,
"kind": "msg",
"jp": [
"そうすると、壁を開けた跡が",
"どう頑張っても残るだろうな。"
]
},
{
"id": 32174,
"kind": "msg",
"jp": [
"ここが通れるってことも、",
"通れることを知ってる奴が他にも",
"いるってこともバレる・・・。"
]
},
{
"id": 32175,
"kind": "msg",
"jp": [
"「・・・怖いからやめよう」"
]
},
{
"id": 32176,
"kind": "msg",
"jp": [
"とりあえず、隠し通路がどこに",
"つながってるのかわかったし、",
"このままにしておこう。"
]
},
{
"id": 32177,
"kind": "msg",
"jp": [
"蛍光塗料が染み出してきている",
"ところまで来た。",
"この壁の向こうは、地下の物置だ。"
]
},
{
"id": 32178,
"kind": "msg",
"jp": [
"「・・・隠し通路だったんだ」"
]
},
{
"id": 32179,
"kind": "msg",
"jp": [
"なんでこんなのがあるんだろう。",
"薄暗いし怖いしなんか出そうだし",
"やだなぁ・・・。"
]
},
{
"id": 32180,
"kind": "msg",
"jp": [
"（薄暗いなぁ・・・）"
]
},
{
"id": 32181,
"kind": "msg",
"jp": [
"こっちは地下道だ。"
]
},
{
"id": 32182,
"kind": "msg",
"jp": [
"奥へ進んでみよう。"
]
},
{
"id": 32183,
"kind": "msg",
"jp": [
"（こっちは物置だ）"
]
},
{
"id": 32184,
"kind": "msg",
"jp": [
"室内を見回し、壁に内線電話が",
"ついているのを見てほっとする。"
]
},
{
"id": 32185,
"kind": "msg",
"jp": [
"ようやく隠し通路ではなく、",
"館の中に戻ってきた・・・。"
]
},
{
"id": 32186,
"kind": "msg",
"jp": [
"那須さんだ・・・。",
"隣で苦い顔をしてるのは椿くん。"
]
},
{
"id": 32187,
"kind": "msg",
"jp": [
"斑井さんと双子が――いなかった。"
]
},
{
"id": 32188,
"kind": "msg",
"jp": [
"「そんなもん、引きこもりの",
"オッサンが出てきてる時点で",
"わかってる」"
]
},
{
"id": 32189,
"kind": "msg",
"jp": [
"「口の減らねえガキだな。",
"わかってるなら黙ってろ」"
]
},
{
"id": 32190,
"kind": "msg",
"jp": [
"「だから、それが誰だって",
"話をしてんだろーが!!」"
]
},
{
"id": 32191,
"kind": "msg",
"jp": [
"「まあ、そんなに興奮しねえで",
"下さいよ・・・」"
]
},
{
"id": 32192,
"kind": "msg",
"jp": [
"「これが落ち着いてられっか!",
"ここまで乗り切ったってのに、",
"なんだよ、ありゃあ!?」"
]
},
{
"id": 32193,
"kind": "msg",
"jp": [
"「そうだよ、ぼくらが無事なのは",
"和くんのおかげかもしれないんだし」"
]
},
{
"id": 32194,
"kind": "msg",
"jp": [
"「あの子、いつ殺されたんだ?",
"夕べなのか?」"
]
},
{
"id": 32195,
"kind": "msg",
"jp": [
"「夕べかぁ・・・。",
"けっこう早く寝ちゃったんだよな」"
]
},
{
"id": 32196,
"kind": "msg",
"jp": [
"「もしかして時計が鳴った時も",
"寝てたのか、アンタ・・・」"
]
},
{
"id": 32197,
"kind": "msg",
"jp": [
"「和、お前は?」"
]
},
{
"id": 32198,
"kind": "msg",
"jp": [
"「・・・僕も聞いたよ。",
"日織が時計直したことは",
"僕が証言できるし・・・」"
]
},
{
"id": 32199,
"kind": "msg",
"jp": [
"「何の関係もねぇ方が",
"気味悪いじゃねーか」"
]
},
{
"id": 32200,
"kind": "msg",
"jp": [
"「その可能性は高ぇだろうな」"
]
},
{
"id": 32201,
"kind": "msg",
"jp": [
"「・・・他に部屋から出たヤツは?」"
]
},
{
"id": 32202,
"kind": "msg",
"jp": [
"「俺はずっと出てねえ」"
]
},
{
"id": 32203,
"kind": "msg",
"jp": [
"「オッサンはわかってるっつーの。",
"オレだって出てねーよ」"
]
},
{
"id": 32204,
"kind": "msg",
"jp": [
"「一番アリバイねーの、アンタだろ」"
]
},
{
"id": 32205,
"kind": "msg",
"jp": [
"「いちいちうるせぇな、てめえは。",
"・・・で、坊主」"
]
},
{
"id": 32206,
"kind": "msg",
"jp": [
"「坊主じゃねえ、",
"双子はもう1人いるだろ」"
]
},
{
"id": 32207,
"kind": "msg",
"jp": [
"「ああ・・・",
"鈴奈さんですかい」"
]
},
{
"id": 32208,
"kind": "msg",
"jp": [
"「考えたくはねーけど、",
"あれってそもそも本当に",
"鈴奈の方なのか?」"
]
},
{
"id": 32209,
"kind": "msg",
"jp": [
"「・・・ああ、そうか。",
"それもわからんな」"
]
},
{
"id": 32210,
"kind": "msg",
"jp": [
"「オレらは一回狙われてる",
"だろうがよ!?」"
]
},
{
"id": 32211,
"kind": "msg",
"jp": [
"「お前、今頃怖いこと言うなよ・・・」"
]
},
{
"id": 32212,
"kind": "msg",
"jp": [
"「南雲さん」"
]
},
{
"id": 32213,
"kind": "msg",
"jp": [
"「どこから引っ張り出してきたんだ",
"そのぶっ飛んだ記憶は!?」"
]
},
{
"id": 32214,
"kind": "msg",
"jp": [
"「和が本当に南雲じゃねえって",
"証拠もねーんだよなぁ・・・」"
]
},
{
"id": 32215,
"kind": "msg",
"jp": [
"「僕、違うって!",
"本当に違うんだってば!」"
]
},
{
"id": 32216,
"kind": "msg",
"jp": [
"「いや、疑ってんじゃなくて",
"調べようがねーことが",
"多いなって話をだな・・・」"
]
},
{
"id": 32217,
"kind": "msg",
"jp": [
"「お前だけは他の何者でも",
"ねーって見りゃわかるから喋るな」"
]
},
{
"id": 32218,
"kind": "msg",
"jp": [
"「だから、さっきから",
"その話・・・!」"
]
},
{
"id": 32219,
"kind": "msg",
"jp": [
"「鈴奈ちゃん・・・・・」"
]
},
{
"id": 32220,
"kind": "msg",
"jp": [
"「無理だろ、どう見ても!",
"おい、筋肉なんとかしろ!!」"
]
},
{
"id": 32221,
"kind": "msg",
"jp": [
"「は、運べばいい?」"
]
},
{
"id": 32222,
"kind": "msg",
"jp": [
"「無理もねえけどよ・・・」"
]
},
{
"id": 32223,
"kind": "msg",
"jp": [
"「同情はするが、",
"今んとこ俺らにしてやれる",
"ことなんかねぇだろ」"
]
},
{
"id": 32224,
"kind": "msg",
"jp": [
"「・・・わかってるよ」"
]
},
{
"id": 32225,
"kind": "msg",
"jp": [
"どうして・・・。",
"ここまで、全部上手く",
"いってたのに・・・。"
]
},
{
"id": 32226,
"kind": "msg",
"jp": [
"（なんで、静奈ちゃんだけ",
"あんな・・・・）"
]
},
{
"id": 32227,
"kind": "msg",
"jp": [
"「あーもー、辛気くせぇっ!",
"和、いくつだお前っ!?」"
]
},
{
"id": 32228,
"kind": "msg",
"jp": [
"「そんな、椿さん・・・",
"怒らないであげて下さい・・・」"
]
},
{
"id": 32229,
"kind": "msg",
"jp": [
"「うるせえな!",
"オレだって怒鳴りてぇわけじゃ",
"ねーんだよっ!!」"
]
},
{
"id": 32230,
"kind": "msg",
"jp": [
"「八つ当たりなら部屋でやれ。",
"よけいうっとうしいだろうが」"
]
},
{
"id": 32231,
"kind": "msg",
"jp": [
"「・・・・くそっ!」"
]
},
{
"id": 32232,
"kind": "msg",
"jp": [
"がん、とソファを蹴りつけて、",
"椿くんは大股に居間を出て行った。"
]
},
{
"id": 32233,
"kind": "msg",
"jp": [
"「ほらほら、{和/なご}さんも",
"落ち着いて」"
]
},
{
"id": 32234,
"kind": "msg",
"jp": [
"「う・・・うん・・・・」"
]
},
{
"id": 32235,
"kind": "msg",
"jp": [
"「・・・ったく。",
"おめえ1人で全部背負ってる",
"わけじゃねぇだろうが」"
]
},
{
"id": 32236,
"kind": "msg",
"jp": [
"「うーん・・・",
"じゃあ、ぼくも部屋にいるよ」"
]
},
{
"id": 32237,
"kind": "msg",
"jp": [
"（暗石さんと斑井さん・・・",
"それに、双子がいない・・・）"
]
},
{
"id": 32238,
"kind": "msg",
"jp": [
"・・・夢じゃないんだ。",
"やっぱりさっき見たあれは・・・。"
]
},
{
"id": 32239,
"kind": "msg",
"jp": [
"「・・・まあ、呑気に貧血",
"起こしてる場合じゃねーけどな」"
]
},
{
"id": 32240,
"kind": "msg",
"jp": [
"「なんでじゃねーだろっ!?",
"誰がやったんだ、一体!!」"
]
},
{
"id": 32241,
"kind": "msg",
"jp": [
"「なんかしくじったみてーだけど、",
"和が謝ったってしょうがねーだろ」"
]
},
{
"id": 32242,
"kind": "msg",
"jp": [
"「なぜっつーか、",
"誰がやったのか知りてぇんだけどな」"
]
},
{
"id": 32243,
"kind": "msg",
"jp": [
"「お部屋の鍵は持っておられた",
"はずで・・・あ、でも・・・」"
]
},
{
"id": 32244,
"kind": "msg",
"jp": [
"「・・・筋肉に聞いた",
"オレが馬鹿だった・・・」"
]
},
{
"id": 32245,
"kind": "msg",
"jp": [
"「あれは、3時過ぎでしたね。",
"合わせ直したんで覚えてます」"
]
},
{
"id": 32246,
"kind": "msg",
"jp": [
"「僕も聞いたし・・・",
"日織が時計直したことは",
"僕が証言できるよ・・・」"
]
},
{
"id": 32247,
"kind": "msg",
"jp": [
"「時計なんか鳴ったの?",
"でも、あれ止めたんじゃ・・・」"
]
},
{
"id": 32248,
"kind": "msg",
"jp": [
"「だから変だって",
"話をしてんだろーが!?」"
]
},
{
"id": 32249,
"kind": "msg",
"jp": [
"「あんなもん意味もなく",
"突然鳴り出すわけがねーだろ」"
]
},
{
"id": 32250,
"kind": "msg",
"jp": [
"「そこまでは、まだ・・・」"
]
},
{
"id": 32251,
"kind": "msg",
"jp": [
"「オレはずっと部屋にいたから",
"その時も前も後も出てねえ。",
"・・・他に部屋から出たヤツは?」"
]
},
{
"id": 32252,
"kind": "msg",
"jp": [
"「ぼくも寝てたよ」"
]
},
{
"id": 32253,
"kind": "msg",
"jp": [
"「筋肉はわかってるっつーに。",
"ま、アリバイなんかねえか・・・」"
]
},
{
"id": 32254,
"kind": "msg",
"jp": [
"「・・・んで、和よ」"
]
},
{
"id": 32255,
"kind": "msg",
"jp": [
"「お前の推理からいくと、",
"オレ達はここまでに狙われてる。",
"夕べは、双子の片割れだ」"
]
},
{
"id": 32256,
"kind": "msg",
"jp": [
"「じゃあ、狙われてねぇのは",
"あと3人しかいねーぞ」"
]
},
{
"id": 32257,
"kind": "msg",
"jp": [
