]
},
{
"id": 15961,
"kind": "msg",
"jp": [
"やっぱりマイナーな",
"探偵なのか・・・。"
]
},
{
"id": 15962,
"kind": "msg",
"jp": [
"「うーん、椿くんしか",
"知らないけど?」"
]
},
{
"id": 15963,
"kind": "msg",
"jp": [
"「いえ、あの、椿くんも",
"役の上だけだと思いますが・・・」"
]
},
{
"id": 15964,
"kind": "msg",
"jp": [
"「あ、そっか!",
"じゃあないなー」"
]
},
{
"id": 15965,
"kind": "msg",
"jp": [
"「ああ、いるよ。",
"兄貴がね」"
]
},
{
"id": 15966,
"kind": "msg",
"jp": [
"「じゃあ2人兄弟ですか」"
]
},
{
"id": 15967,
"kind": "msg",
"jp": [
"「いや、5人」"
]
},
{
"id": 15968,
"kind": "msg",
"jp": [
"「兄貴が4人いるんだよ」"
]
},
{
"id": 15969,
"kind": "msg",
"jp": [
"「そ・・そうですか・・・」"
]
},
{
"id": 15970,
"kind": "msg",
"jp": [
"どんな家なんだろう。",
