[
{
"id": 15598,
"kind": "msg",
"jp": [
"「えーと、最初の日から数えて",
"5日目の朝早くなんですが」"
]
},
{
"id": 15599,
"kind": "msg",
"jp": [
"「5日目・・・?",
"和くんがここで見張ってて",
"くれた日の朝だっけ」"
]
},
{
"id": 15600,
"kind": "msg",
"jp": [
"「いえ、そのもう一日",
"次の日の朝です」"
]
},
{
"id": 15601,
"kind": "msg",
"jp": [
"「ああ、そうか。",
"んー、だったらぼくは部屋から",
"出てないからなあ・・・」"
]
},
{
"id": 15602,
"kind": "msg",
"jp": [
"「まだ寝てました?」"
]
},
{
"id": 15603,
"kind": "msg",
"jp": [
"「いや、起きてはいたよ。",
"多分腹筋でもしてたんじゃないかな」"
]
},
{
"id": 15604,
"kind": "msg",
"jp": [
"「あ、あの、じゃあ隣の部屋の",
"物音とか扉の音とか・・・」"
]
},
{
"id": 15605,
"kind": "msg",
"jp": [
"「聞いた覚えないなあ」"
]
},
{
"id": 15606,
"kind": "msg",
"jp": [
"「那須さんの部屋の",
"名前ってなんでした?」"
]
},
{
"id": 15607,
"kind": "msg",
"jp": [
"「えーっと、ほらあの人。",
"主人公の探偵が奇術師で、",
"自分も奇術師の・・・」"
]
},
{
"id": 15608,
"kind": "msg",
"jp": [
"「・・・あれ、探偵の名前は",
"出てくるんだけど・・・」"
]
},
{
"id": 15609,
"kind": "msg",
"jp": [
"「自分も奇術師って",
"作者がですか?」"
]
},
{
"id": 15610,
"kind": "msg",
"jp": [
"「うん、そう。",
"作者の・・・あ、そうだ",
"ロースンだった」"
]
},
{
"id": 15611,
"kind": "msg",
"jp": [
"「ロースン、ですね」"
]
},
{
"id": 15612,
"kind": "msg",
"jp": [
"「そうだった。",
"読んだのかなり昔だなあ・・・」"
]
},
{
"id": 15613,
"kind": "msg",
"jp": [
"・・・那須さん読んだことあるんだ。",
"ちょっと意外な気がした。"
]
},
{
"id": 15614,
"kind": "msg",
"jp": [
"「え? みきちゃん?",
"うちの社長の孫の?」"
]
},
{
"id": 15615,
"kind": "msg",
"jp": [
"「・・・あれ。",
"でも藍瀬なんて苗字じゃ",
"なかったような」"
]
},
{
"id": 15616,
"kind": "msg",
"jp": [
"「あの、それ",
"同じ名前なだけでは」"
]
},
{
"id": 15617,
"kind": "msg",
"jp": [
"「うん、なんかそんな気がする」"
]
},
{
"id": 15618,
"kind": "msg",
"jp": [
"「ちなみに、そのお孫さんて",
"いくつなんですか?」"
]
},
{
"id": 15619,
"kind": "msg",
"jp": [
"「3歳だったかな」"
]
},
{
"id": 15620,
"kind": "msg",
"jp": [
"「・・・別人です」"
]
},
{
"id": 15621,
"kind": "msg",
"jp": [
"「あはは、やっぱりそうか。",
"苗字が違うはずだなあ」"
]
},
{
"id": 15622,
"kind": "msg",
"jp": [
"そこなんだろうか、問題は。",
"何かが違うような気がする・・。"
]
},
{
"id": 15623,
"kind": "msg",
"jp": [
"「如月さん?",
"ああ、知ってるよもちろん」"
]
},
{
"id": 15624,
"kind": "msg",
"jp": [
"「一度だけ、同じ時代劇に",
"出たことあるんだけどさ。",
"思いっきり笑われたなあ」"
]
},
{
"id": 15625,
"kind": "msg",
"jp": [
"「なんでですか?」"
]
},
{
"id": 15626,
"kind": "msg",
"jp": [
"「ぼく、悪役の手下の1人でさ、",
"最初の方に斬られて倒れてて、",
"そのまま寝ちゃってたんだよ」"
]
},
{
"id": 15627,
"kind": "msg",
"jp": [
"「だから、OKって言われても",
"1人だけ起きなくてね」"
]
},
{
"id": 15628,
"kind": "msg",
"jp": [
"「どうしたんだってスタッフが",
"駆け寄ってきたら寝てたらしいよ。",
"叩き起こされたけど」"
]
},
{
"id": 15629,
"kind": "msg",
"jp": [
"「豪快な子ね、って",
"如月さん大笑いしてたなあ」"
]
},
{
"id": 15630,
"kind": "msg",
"jp": [
"そりゃあ、笑うしかないだろう・・。"
]
},
{
"id": 15631,
"kind": "msg",
"jp": [
"「成瀬公康って人",
"知ってますか?」"
]
},
{
"id": 15632,
"kind": "msg",
"jp": [
"「成瀬・・・?",
"どっかで聞いた事ある",
"ような気がするけど・・・」"
]
},
{
"id": 15633,
"kind": "msg",
"jp": [
"「誰だったっけ。",
"ちょっと覚えてないや」"
]
},
{
"id": 15634,
"kind": "msg",
"jp": [
"「いや、実は僕もよくは",
"知らないんです。",
"書斎にあった本で名前見ただけで」"
]
},
{
"id": 15635,
"kind": "msg",
"jp": [
"「へえ、本に載ってる",
"ような人なんだ?」"
]
},
{
"id": 15636,
"kind": "msg",
"jp": [
"「それでなんとなく",
"聞き覚えあったのかなあ」"
]
},
{
"id": 15637,
"kind": "msg",
"jp": [
"「マリアンヌってヒロインが",
"出てくる小説知ってますか?」"
]
},
{
"id": 15638,
"kind": "msg",
"jp": [
"「ああ、あれ面白いよね。",
"何度か舞台でもやってるし」"
]
},
{
"id": 15639,
"kind": "msg",
"jp": [
"「舞台でですか?」"
]
},
{
"id": 15640,
"kind": "msg",
"jp": [
"「うん、未だにファンが多いから",
"けっこう定番の演目にしてる",
"劇団もあるんだよ」"
]
},
{
"id": 15641,
"kind": "msg",
"jp": [
"でも確かに、好きな人は",
"かなり好きそうな世界だよな。"
]
},
{
"id": 15642,
"kind": "msg",
"jp": [
"「ハリー・キッドマンっていう",
"探偵ご存じですか?」"
]
},
{
"id": 15643,
"kind": "msg",
"jp": [
"「知ってる知ってる。",
"面白いんだけど日本では",
"あんまり知られてないんだよね」"
]
},
{
"id": 15644,
"kind": "msg",
"jp": [
"「やっぱり映画とかに",
"なってないからかな」"
]
},
{
"id": 15645,
"kind": "msg",
"jp": [
"「映像化されたこと",
"ないんですか」"
]
},
{
"id": 15646,
"kind": "msg",
"jp": [
"「主役のキャスティングが",
"難しいんだと思うよ」"
]
},
{
"id": 15647,
"kind": "msg",
"jp": [
"「だっていても気付かないくらい",
"影の薄い役者さんってあんまり",
"いないと思うし」"
]
},
{
"id": 15648,
"kind": "msg",
"jp": [
"「那須さん、本物の執事って",
"会ったことあります?」"
]
},
{
"id": 15649,
"kind": "msg",
"jp": [
"「そう言えばなかったな。",
"椿くんしか知らないよ」"
]
},
{
"id": 15650,
"kind": "msg",
"jp": [
"「椿くんのは本物じゃ",
"なくて役ですが・・・」"
]
},
{
"id": 15651,
"kind": "msg",
"jp": [
"「ああ、そうか!",
"じゃあ一度もないな」"
]
},
{
"id": 15652,
"kind": "msg",
"jp": [
"「日本にはいないのかな。",
"日本人でセバスチャンて名前の人",
"見た事ないしなあ」"
]
},
{
"id": 15653,
"kind": "msg",
"jp": [
"・・・何かを激しく誤解してる",
"ような気がする。"
]
},
{
"id": 15654,
"kind": "msg",
"jp": [
"「那須さんって",
"兄弟います?」"
]
},
{
"id": 15655,
"kind": "msg",
"jp": [
"「いるよ、5人ほど」"
]
},
{
"id": 15656,
"kind": "msg",
"jp": [
"「5人!?」"
]
},
{
"id": 15657,
"kind": "msg",
"jp": [
"「全員男でさ、1人くらい",
"女の子が欲しかったらしいんだけど",
"さすがに5人目で諦めたんだって」"
]
},
{
"id": 15658,
"kind": "msg",
"jp": [
"「那須さん、何番目ですか?」"
]
},
{
"id": 15659,
"kind": "msg",
"jp": [
"「ぼく末っ子なんだ」"
]
},
{
"id": 15660,
"kind": "msg",
"jp": [
"「けど、他の兄貴は",
"みんな文系でさあ」"
]
},
{
"id": 15661,
"kind": "msg",
"jp": [
"「家中本棚だらけにして",
"よく親に怒られてたなあ、",
"床抜けるだろって」"
]
},
{
"id": 15662,
"kind": "msg",
"jp": [
"なんで那須さんだけ",
"こんな事に・・・。"
]
},
{
"id": 15663,
"kind": "msg",
"jp": [
"「いや、ちっとも気がつかなかったよ」"
]
},
{
"id": 15664,
"kind": "msg",
"jp": [
"「そりゃあ・・・",
"そうなんじゃない?」"
]
},
{
"id": 15665,
"kind": "msg",
"jp": [
"こんなこと那須さんに聞いて",
"どうするんだ、僕は・・・。"
]
},
{
"id": 15666,
"kind": "msg",
"jp": [
"「どれ?」"
]
},
{
"id": 15667,
"kind": "msg",
"jp": [
"「・・・うーん?",
"ちょっとわからないなあ」"
]
},
{
"id": 15668,
"kind": "msg",
"jp": [
"「そうだったかな・・・",
"あー、そうだった気がする」"
]
},
{
"id": 15669,
"kind": "msg",
"jp": [
"気にしてなかったのか",
"よく覚えてないらしい。"
]
},
{
"id": 15670,
"kind": "msg",
"jp": [
"「他には特に",
"何もなかったよ」"
]
},
{
"id": 15671,
"kind": "msg",
"jp": [
"「うーん・・・",
"あんまり知らないなあ」"
]
},
{
"id": 15672,
"kind": "msg",
"jp": [
"「何人か一緒に仕事したことある人",
"いるはずなんだけど、そんなに親しい",
"相手はいないし」"
]
},
{
"id": 15673,
"kind": "msg",
"jp": [
"「スポーツジムが",
"近くて便利だよ」"
]
},
{
"id": 15674,
"kind": "msg",
"jp": [
"なぜ立地の話に・・・。"
]
},
{
"id": 15675,
"kind": "msg",
"jp": [
"「仮面?",
"そんなのあるんだ?」"
]
},
{
"id": 15676,
"kind": "msg",
"jp": [
"「ふーん、でも",
"ファンは多いだろうしなあ」"
]
},
{
"id": 15677,
"kind": "msg",
"jp": [
"多いんだろうか。",
"現に愛好会があるくらいだから",
"多いのか・・・。"
]
},
{
"id": 15678,
"kind": "msg",
"jp": [
"「・・・なんだっけそれ。",
"どっかで聞いた気がするんだけど」"
]
},
{
"id": 15679,
"kind": "msg",
"jp": [
"「あー、思い出した。",
"ものすごくまずいの飲んだ",
"覚えがあるなあ」"
]
},
{
"id": 15680,
"kind": "msg",
"jp": [
"「・・・和くん、好きなの?」"
]
},
{
"id": 15681,
"kind": "msg",
"jp": [
"「い、いえっ!",
"そんなことはないです」"
]
},
{
"id": 15682,
"kind": "msg",
"jp": [
"「あはは、そうだよね。",
"まずいもんなあ」"
]
},
{
"id": 15683,
"kind": "msg",
"jp": [
"「うーん・・・",
"よくわからないなあ」"
]
},
{
"id": 15684,
"kind": "msg",
"jp": [
"「最初の場面しかないから、",
"文章のクセとかからも判断しづらいし」"
]
},
{
"id": 15685,
"kind": "msg",
"jp": [
"「さあ?",
"僕、麻雀あまりやらないから」"
]
},
{
"id": 15686,
"kind": "msg",
"jp": [
"「あー、昔読んだんだけど・・・",
"どんな話だったかよく覚えてないや」"
]
},
{
"id": 15687,
"kind": "msg",
"jp": [
"けど、読んではいるのか・・・。"
]
},
{
"id": 15688,
"kind": "msg",
"jp": [
"「いや・・・",
"知らないと思うなあ」"
]
},
{
"id": 15689,
"kind": "msg",
"jp": [
"テレビゲームとかあんまり",
"やらなさそうだもんな、那須さん。"
]
},
{
"id": 15690,
"kind": "msg",
"jp": [
"「あー、あれ10年以上前かな。",
"もう再放送もなさそうだから",
"見られないだろうなあ・・・」"
]
},
{
"id": 15691,
"kind": "msg",
"jp": [
"残念そうだった。",
"好きなドラマだったのかな。"
]
},
{
"id": 15692,
"kind": "msg",
"jp": [
"「そうだねえ、",
"掃除が大変そうだけど」"
]
},
{
"id": 15693,
"kind": "msg",
"jp": [
"「あ、確かに・・・」"
]
},
{
"id": 15694,
"kind": "msg",
"jp": [
"維持費だけでも大変なことに",
"なるんだろうな。"
]
},
{
"id": 15695,
"kind": "msg",
"jp": [
"「そうだね、こっち側の",
"部屋にはどこもないみたいだ」"
]
},
{
"id": 15696,
"kind": "msg",
"jp": [
"「ですね。",
"僕らの部屋にもないし」"
]
},
{
"id": 15697,
"kind": "msg",
"jp": [
"「そうかあ・・・」"
]
},
{
"id": 15698,
"kind": "msg",
"jp": [
"なぜかちょっと残念そうだ。",
"なんでだろう・・・。"
]
},
{
"id": 15699,
"kind": "msg",
"jp": [
"「そうだねえ。",
"うちにも、あんなの欲しいなあ」"
]
},
{
"id": 15700,
"kind": "msg",
"jp": [
"「那須さんちって",
"広いんですか?」"
]
},
{
"id": 15701,
"kind": "msg",
"jp": [
"「そうでもないよ。",
"地下室もないし」"
]
},
{
"id": 15702,
"kind": "msg",
"jp": [
"普通、無い家の方が多いだろう",
"それは・・・。"
]
},
{
"id": 15703,
"kind": "msg",
"jp": [
"「あんまり使ってないよ。",
"冷蔵庫くらいしか触らないし」"
]
},
{
"id": 15704,
"kind": "msg",
"jp": [
"「うん、あるよ。",
"普通の部屋だったけど」"
]
},
{
"id": 15705,
"kind": "msg",
"jp": [
"「そうだね。",
"でも、もうちょっと身体使う",
"ゲームがあればなあ」"
]
},
{
"id": 15706,
"kind": "msg",
"jp": [
"そういうのはああいう娯楽室には",
"置いてないような・・・。"
]
},
{
"id": 15707,
"kind": "msg",
"jp": [
"「ああ、すごいね。",
"運び込むの重労働だった",
"だろうなあ・・・」"
]
},
{
"id": 15708,
"kind": "msg",
"jp": [
"内容じゃなくて重さにまず",
"興味があるらしい・・・。"
]
},
{
"id": 15709,
"kind": "msg",
"jp": [
"「んー、最初の日に一度",
"のぞいてみたきりかな」"
]
},
{
"id": 15710,
"kind": "msg",
"jp": [
"「だと思うよ。",
"身体動かすにはちょっと狭いけど」"
]
},
{
"id": 15711,
"kind": "msg",
"jp": [
"普通、室内でやらないような",
"運動してそうだ・・・。"
]
},
{
"id": 15712,
"kind": "msg",
"jp": [
"「えーと、開かずの間",
"とかいうやつ?」"
]
},
{
"id": 15713,
"kind": "msg",
"jp": [
"「あの部屋見たことないんだよ。",
"椿くんに入るなって言われたから」"
]
},
{
"id": 15714,
"kind": "msg",
"jp": [
"なんか、うっかり物壊したり",
"しそうだとか思われたのかな。"
]
},
{
"id": 15715,
"kind": "msg",
"jp": [
"「へえ、そうなんだ?",
"気がつかなかったよ」"
]
},
{
"id": 15716,
"kind": "msg",
"jp": [
"「・・・さあ?",
"なんでだろうね」"
]
},
{
"id": 15717,
"kind": "msg",
"jp": [
"那須さんは特に気にはならない",
"ようだった。"
]
},
{
"id": 15718,
"kind": "msg",
"jp": [
"「そんなのあるの!?",
"それってどこまで通じてるのかな、",
"ここから逃げ出せるくらい?」"
]
},
{
"id": 15719,
"kind": "msg",
"jp": [
"「いや、あの、さすがに",
"それは無理だと・・・」"
]
},
{
"id": 15720,
"kind": "msg",
"jp": [
"ここから脱出できるくらいの通路って",
"何キロ掘ればいいんだ・・・。"
]
},
{
"id": 15721,
"kind": "msg",
"jp": [
"「・・・そうだっけ。",
"いや、確かあったね、うん」"
]
},
{
"id": 15722,
"kind": "msg",
"jp": [
"興味が無いのか、あまり気にとめて",
"ないみたいだ・・・。"
]
},
{
"id": 15723,
"kind": "msg",
"jp": [
"「うん、特に無いのかもなあ。",
"内装も普通だし」"
]
},
{
"id": 15724,
"kind": "msg",
"jp": [
"「あはは、ごめん。",
"気にしなくていいよ」"
]
},
{
"id": 15725,
"kind": "msg",
"jp": [
"何のことだったんだろう・・・。"
]
},
{
"id": 15726,
"kind": "msg",
"jp": [
"「・・・多分、",
"そうだと思うけど・・・」"
]
},
{
"id": 15727,
"kind": "msg",
"jp": [
"「実際どうやったかなんて",
"さっぱりだよね」"
]
},
{
"id": 15728,
"kind": "msg",
"jp": [
"「あの、斧って・・・",
"凶器に使われたやつですけど・・・」"
]
},
{
"id": 15729,
"kind": "msg",
"jp": [
"「・・・あれ、",
"壁に掛かってたやつだよね」"
]
},
{
"id": 15730,
"kind": "msg",
"jp": [
"「けっこう軽かったんだけどなあ。",
"本物だったのか・・・」"
]
},
{
"id": 15731,
"kind": "msg",
"jp": [
"持ってみたことあるんだ。",
"けど、軽いと思うのは那須さんだから",
"だと思うけどなあ・・・。"
]
},
{
"id": 15732,
"kind": "msg",
"jp": [
"「あれかぁ・・・",
"いつの間に置いたんだろう?」"
]
},
{
"id": 15733,
"kind": "msg",
"jp": [
"「昼間にはまだなかったん",
"ですよね、あんなの」"
]
},
{
"id": 15734,
"kind": "msg",
"jp": [
"「あったら誰か見つけて",
"騒いでるんじゃないかな」"
]
},
{
"id": 15735,
"kind": "msg",
"jp": [
"「うーん・・・",
"ぼくは見たこと無いなあ」"
]
},
{
"id": 15736,
"kind": "msg",
"jp": [
"「うん、まさか外に通じる",
"電話が無いとは思わなかったな」"
]
},
{
"id": 15737,
"kind": "msg",
"jp": [
"「携帯も通じませんしね」"
]
},
{
"id": 15738,
"kind": "msg",
"jp": [
"「みたいだねえ・・・」"
]
},
{
"id": 15739,
"kind": "msg",
"jp": [
"「いや、ぼくは触ってないよ」"
]
},
{
"id": 15740,
"kind": "msg",
"jp": [
"「ああ、あの大きいの",
"すごいよね」"
]
},
{
"id": 15741,
"kind": "msg",
"jp": [
"「どれくらい重いのかな・・・」"
]
},
{
"id": 15742,
"kind": "msg",
"jp": [
"すごいってそっちの話なのか・・・。"
]
},
{
"id": 15743,
"kind": "msg",
"jp": [
"「うーん・・・",
"なんでベルなんだろうね?",
"わからないなあ・・・」"
]
},
{
"id": 15744,
"kind": "msg",
"jp": [
"「温室に、長い釘が",
"置かれてたでしょう」"
]
},
{
"id": 15745,
"kind": "msg",
"jp": [
"「五寸釘っていうやつですよね」"
]
},
{
"id": 15746,
"kind": "msg",
"jp": [
"「だよねえ・・・",
"犯人が持ってきたのかなあ」"
]
},
{
"id": 15747,
"kind": "msg",
"jp": [
"「あんまり、普通の家には",
"置いてあるものじゃないですしね」"
]
},
{
"id": 15748,
"kind": "msg",
"jp": [
"「そうだね。",
"うちにもないな、五寸釘は」"
]
},
{
"id": 15749,
"kind": "msg",
"jp": [
"「僕の家にもないですよ",
"そんなの・・・」"
]
},
{
"id": 15750,
"kind": "msg",
"jp": [
"「手袋かあ・・。",
"ぼくは手袋って苦手だから",
"ほとんど使わないなあ」"
]
},
{
"id": 15751,
"kind": "msg",
"jp": [
"「なんかドレスとか着るとき",
"使いそうなひらひらのでしたよ」"
]
},
{
"id": 15752,
"kind": "msg",
"jp": [
"「ああ、そういう手袋か。",
"もっと使わないだろうなあ」"
]
},
{
"id": 15753,
"kind": "msg",
"jp": [
"そりゃそうだろう・・・。"
]
},
{
"id": 15754,
"kind": "msg",
"jp": [
"「手斧?",
"小さいの?」"
]
},
{
"id": 15755,
"kind": "msg",
"jp": [
"「ええ、これくらいの」"
]
},
{
"id": 15756,
"kind": "msg",
"jp": [
"「じゃあ武器じゃなくて",
"伐採用か何かかな」"
]
},
{
"id": 15757,
"kind": "msg",
"jp": [
"そもそも武装用に斧を家に",
"置いておく人はあまりいない",
"だろう・・・。"
]
},
{
"id": 15758,
"kind": "msg",
"jp": [
"「何に使うものなんだい、それ?」"
]
},
{
"id": 15759,
"kind": "msg",
"jp": [
"「よくわからないんです。",
"単なる飾りなのかも」"
]
},
{
"id": 15760,
"kind": "msg",
"jp": [
"「あぁ、あれ軽いよ」"
]
},
{
"id": 15761,
"kind": "msg",
"jp": [
"「軽い?」"
]
},
{
"id": 15762,
"kind": "msg",
"jp": [
"「うん、軽かった」"
]
},
{
"id": 15763,
"kind": "msg",
"jp": [
"他に感想はないらしい・・。"
]
},
{
"id": 15764,
"kind": "msg",
"jp": [
"「そうだね。",
"ここにも何か絵があるし」"
]
},
{
"id": 15765,
"kind": "msg",
"jp": [
"そう言って那須さんは壁の絵に目を",
"向けたがあまり興味はないようだった。"
]
},
{
"id": 15766,
"kind": "msg",
"jp": [
"「へえ・・・?",
"昔食べたことあるけど・・・」"
]
},
{
"id": 15767,
"kind": "msg",
"jp": [
"「外国でね」"
]
},
{
"id": 15768,
"kind": "msg",
"jp": [
"・・・食べるって発想が真っ先に",
"出てくるところがすごい・・・。"
]
},
{
"id": 15769,
"kind": "msg",
"jp": [
"「うん、インスタントは",
"食べないようにしてるんだ」"
]
},
{
"id": 15770,
"kind": "msg",
"jp": [
"やっぱりそうか・・・。"
]
},
{
"id": 15771,
"kind": "msg",
"jp": [
"「ボウガンって武器の?」"
]
},
{
"id": 15772,
"kind": "msg",
"jp": [
"「そうです、矢を射る銃の」"
]
},
{
"id": 15773,
"kind": "msg",
"jp": [
"「ふーん?」"
]
},
{
"id": 15774,
"kind": "msg",
"jp": [
"首をかしげてなにやら考え込んだ。",
"なんなんだろう・・・?"
]
},
{
"id": 15775,
"kind": "msg",
"jp": [
"「ううん、飲んだことないよ」"
]
},
{
"id": 15776,
"kind": "msg",
"jp": [
"必要なさそうだもんな。"
]
},
{
"id": 15777,
"kind": "msg",
"jp": [
"「ふぅん?",
"変わったもの飼ってるんだね」"
]
},
{
"id": 15778,
"kind": "msg",
"jp": [
"「え? 和くんこそ、",
"なんでそんなこと知ってるの?」"
]
},
{
"id": 15779,
"kind": "msg",
"jp": [
"「あ、僕は暗石さんから",
"ちらっと聞いただけなんですが」"
]
},
{
"id": 15780,
"kind": "msg",
"jp": [
"「あぁ、暗石さんかあ。",
"なるほどね・・・」"
]
},
{
"id": 15781,
"kind": "msg",
"jp": [
"「カセットテープかあ。",
"百均で売ってるやつみたいだね」"
]
},
{
"id": 15782,
"kind": "msg",
"jp": [
"「うん、見覚えあるよ」"
]
},
{
"id": 15783,
"kind": "msg",
"jp": [
"「矢が・・・?",
"なんでないんだろう」"
]
},
{
"id": 15784,
"kind": "msg",
"jp": [
"「何かに使ったのかな?」"
]
},
{
"id": 15785,
"kind": "msg",
"jp": [
"「わからないんです・・・」"
]
},
{
"id": 15786,
"kind": "msg",
"jp": [
"「そうか・・・。",
"でも、どこから撃ったんだろう・・・」"
]
},
{
"id": 15787,
"kind": "msg",
"jp": [
"「さあ? なんだろうね?」"
]
},
{
"id": 15788,
"kind": "msg",
"jp": [
"那須さんにもまったく見当が",
"つかないらしい。"
]
},
{
"id": 15789,
"kind": "msg",
"jp": [
"「ああ、あれ面白いね」"
]
},
{
"id": 15790,
"kind": "msg",
"jp": [
"「ちょっと不気味じゃないですか?」"
]
},
{
"id": 15791,
"kind": "msg",
"jp": [
"「そう?",
"ぼくは好きだよ」"
]
},
{
"id": 15792,
"kind": "msg",
"jp": [
"「・・・うーん?",
"覚えてないなあ」"
]
},
{
"id": 15793,
"kind": "msg",
"jp": [
"「ん? カセットテープ?",
"何か録音されてるの?」"
]
},
{
"id": 15794,
"kind": "msg",
"jp": [
"「崖崩れのニュースが・・・",
"でも、僕らがラジオで聞いたのとは",
"内容が違うんです」"
]
},
{
"id": 15795,
"kind": "msg",
"jp": [
"「犯人が用意してた偽物の",
"ニュースじゃないかと・・・」"
]
},
{
"id": 15796,
"kind": "msg",
"jp": [
"「・・・なんでそんな物を?」"
]
},
{
"id": 15797,
"kind": "msg",
"jp": [
"「なんでって、そりゃあまさか",
"犯人も本当に崖が崩れるとは思って",
"なかったんじゃないですか?」"
]
},
{
"id": 15798,
"kind": "msg",
"jp": [
"「でもそれ、役に立たないよね。",
"見に行っちゃったら崩れてないの",
"すぐわかるんだから」"
]
},
{
"id": 15799,
"kind": "msg",
"jp": [
"多分、なんのためらいもなく",
"歩いていく人がいるとは",
"思わなかったんじゃないかな・・・。"
]
},
{
"id": 15800,
"kind": "msg",
"jp": [
"「花?」"
]
},
{
"id": 15801,
"kind": "msg",
"jp": [
"「・・・{ 花縮紗/はなしゅくしゃ}みたいだけど」"
]
},
{
"id": 15802,
"kind": "msg",
"jp": [
"「しゅく・・え?」"
]
},
{
"id": 15803,
"kind": "msg",
"jp": [
"「いわゆるジンジャーだよ」"
]
},
{
"id": 15804,
"kind": "msg",
"jp": [
"「ジンジャー?",
"そうなんですか?」"
]
},
{
"id": 15805,
"kind": "msg",
"jp": [
"「うん、でもこれどこに",
"あったんだい?",
"なんか地面に落ちてるみたいだけど」"
]
},
{
"id": 15806,
"kind": "msg",
"jp": [
"「温室です。",
"『復讐』の紙の側に千切って",
"置いてありました」"
]
},
{
"id": 15807,
"kind": "msg",
"jp": [
"「・・・・あそこか」"
]
},
{
"id": 15808,
"kind": "msg",
"jp": [
"「ジンジャーってショウガですよね、",
"なんでこんな花を・・・」"
]
},
{
"id": 15809,
"kind": "msg",
"jp": [
"「ショウガって言っても、",
"ジンジャーっていうのはショウガ科の",
"植物の総称で・・・」"
]
},
{
"id": 15810,
"kind": "msg",
"jp": [
"「・・・ああ、まあそれは",
"どうでもいいか。",
"ショウガは関係ないだろうしなあ」"
]
},
{
"id": 15811,
"kind": "msg",
"jp": [
"「え、ええ、多分。",
"けど、他に意味ってありますかね?」"
]
},
{
"id": 15812,
"kind": "msg",
"jp": [
"「他には・・・",
"うーん、花言葉とか?」"
]
},
{
"id": 15813,
"kind": "msg",
"jp": [
"「花言葉?」"
]
},
{
"id": 15814,
"kind": "msg",
"jp": [
"「うん、『無駄なこと』って",
"いうんだけど」"
]
},
{
"id": 15815,
"kind": "msg",
"jp": [
"「それ・・あの・・・",
"犯人が僕らにそう言ってるん",
"でしょうか・・・」"
]
},
{
"id": 15816,
"kind": "msg",
"jp": [
"「え? ああ・・・",
"そうなのかもしれないなあ」"
]
},
{
"id": 15817,
"kind": "msg",
"jp": [
"「そんなことしたって無駄だって",
"言いたいのかな・・・」"
]
},
{
"id": 15818,
"kind": "msg",
"jp": [
"そんなこと・・・。",
"僕らが、どうにか班員のやることを",
"邪魔してること・・・?"
]
},
{
"id": 15819,
"kind": "msg",
"jp": [
"（それが無駄ってどういう",
"意味なんだろう・・・）"
]
},
{
"id": 15820,
"kind": "msg",
"jp": [
"「あー、ちょっと待って」"
]
},
{
"id": 15821,
"kind": "msg",
"jp": [
"そう言って那須さんはズボンの",
"ポケットから鍵を取り出した。"
]
},
{
"id": 15822,
"kind": "msg",
"jp": [
"「『C』だね」"
]
},
{
"id": 15823,
"kind": "msg",
"jp": [
"「うん、機械苦手でね」"
]
},
{
"id": 15824,
"kind": "msg",
"jp": [
"「不便じゃないですか?」"
]
},
{
"id": 15825,
"kind": "msg",
"jp": [
"「マネージャーが居るから",
"大丈夫だよ」"
]
},
{
"id": 15826,
"kind": "msg",
"jp": [
"そうか、役者さんには",
"そういう人がついてるんだっけ。"
]
},
{
"id": 15827,
"kind": "msg",
"jp": [
"「うん、ぼくは大抵",
"どこ行くにも自分の車",
"だからね」"
]
},
{
"id": 15828,
"kind": "msg",
"jp": [
"「明石焼き・・・",
"あんまり食べないかなあ」"
]
},
{
"id": 15829,
"kind": "msg",
"jp": [
"まあ、しょっちゅう食べる",
"ものでもないよなあ。"
]
},
{
"id": 15830,
"kind": "msg",
"jp": [
"「いや、そこまで凝った",
"料理は無理だなあ」"
]
},
{
"id": 15831,
"kind": "msg",
"jp": [
"「食べたいねえ、",
"ハンバーグ・・・」"
]
},
{
"id": 15832,
"kind": "msg",
"jp": [
"「うん、好きだよ。",
"・・・食べたいなあ」"
]
},
{
"id": 15833,
"kind": "msg",
"jp": [
"・・・駄目だ。",
"食べ物の話してると",
"お腹空いてくる・・・。"
]
},
{
"id": 15834,
"kind": "msg",
"jp": [
"「うん、吸ったことないな」"
]
},
{
"id": 15835,
"kind": "msg",
"jp": [
"だろうなあ・・・。"
]
},
{
"id": 15836,
"kind": "msg",
"jp": [
"「ううん、飲んでないよ。",
"ワインは元からあんまり",
"飲まないしなあ」"
]
},
{
"id": 15837,
"kind": "msg",
"jp": [
"鍛えてるし、お酒自体",
"あんまり飲まなさそうだな・・・。"
]
},
{
"id": 15838,
"kind": "msg",
"jp": [
"「・・・うーん。",
"どっちかっていうとパイプ椅子のが",
"好きかなあ」"
]
},
{
"id": 15839,
"kind": "msg",
"jp": [
"「・・・・そ、そうですか」"
]
},
{
"id": 15840,
"kind": "msg",
"jp": [
"なんでパイプ椅子・・・?"
]
},
{
"id": 15841,
"kind": "msg",
"jp": [
"「いいや、グラスは",
"借りてないよ」"
]
},
{
"id": 15842,
"kind": "msg",
"jp": [
"ひょい、と腕を曲げてポーズを",
"取ってくれた。"
]
},
{
"id": 15843,
"kind": "msg",
"jp": [
"腕まわりがどう見ても",
"僕の足より太い・・・。"
]
},
{
"id": 15844,
"kind": "msg",
"jp": [
"「御陵さんって普段からあの、",
"おっとりした感じなんですか?」"
]
},
{
"id": 15845,
"kind": "msg",
"jp": [
"「んー、多分」"
]
},
{
"id": 15846,
"kind": "msg",
"jp": [
"「多分?」"
]
},
{
"id": 15847,
"kind": "msg",
"jp": [
"「うん、よく知らないけど」"
]
},
{
"id": 15848,
"kind": "msg",
"jp": [
"「きれいな人なんだけどね。",
"・・・細いんだよなあ」"
]
},
{
"id": 15849,
"kind": "msg",
"jp": [
"筋肉がついてないって",
"意味なんだろうなあ・・・。"
]
},
{
"id": 15850,
"kind": "msg",
"jp": [
"「うん、知ってるよ。",
"映画も全部観てるし」"
]
},
{
"id": 15851,
"kind": "msg",
"jp": [
"「直接会って話したりしたことは?」"
]
},
{
"id": 15852,
"kind": "msg",
"jp": [
"「それはさすがに無理だよ」"
]
},
{
"id": 15853,
"kind": "msg",
"jp": [
"本当にまるっきり人前に",
"出てこない人なんだな・・・。"
]
},
{
"id": 15854,
"kind": "msg",
"jp": [
"「別にぼくはもうバラしても",
"いいんだけどさ・・・」"
]
},
{
"id": 15855,
"kind": "msg",
"jp": [
"「謎の脚本家の方が",
"面白いから黙っとけって",
"マネージャーが言うんだよ」"
]
},
{
"id": 15856,
"kind": "msg",
"jp": [
"もうバラしても、ってことは",
"最初は何か別の理由があったのかな。"
]
},
{
"id": 15857,
"kind": "msg",
"jp": [
"「本は読んだけど、",
"本人のことはあまり知らないかな」"
]
},
{
"id": 15858,
"kind": "msg",
"jp": [
"けど、本は読んでるっていうのが",
"ちょっと意外・・・っていうのは",
"失礼かな・・・。"
]
},
{
"id": 15859,
"kind": "msg",
"jp": [
"「いやぁ、覚えがないけどな。",
"近くにいたの?」"
]
},
{
"id": 15860,
"kind": "msg",
"jp": [
"「へえ?",
"会わなかったけどなあ」"
]
},
{
"id": 15861,
"kind": "msg",
"jp": [
"（でも、いくら斑井さんでも",
"1人で笑ってたりはしない",
"だろうから・・・）"
]
},
{
"id": 15862,
"kind": "msg",
"jp": [
"（誰かが、その場に",
"一緒にいたんだ・・・）"
]
},
{
"id": 15863,
"kind": "msg",
"jp": [
"「――あ・・・」"
]
},
{
"id": 15864,
"kind": "msg",
"jp": [
"「ん? どうしたの?」"
]
},
{
"id": 15865,
"kind": "msg",
"jp": [
"「え、あ、いえ",
"なんでもないです」"
]
},
{
"id": 15866,
"kind": "msg",
"jp": [
"・・・11時40分以降。",
"そんな時間まで部屋に戻ってないって",
"言ってるのはこの那須さんだけだ。"
]
},
{
"id": 15867,
"kind": "msg",
"jp": [
"「ああ・・・うん・・・",
"一体なんでこんなことに",
"なったんだろうね・・・」"
]
},
{
"id": 15868,
"kind": "msg",
"jp": [
"「ぼくには何がなんだか",
"さっぱりだよ・・・」"
]
},
{
"id": 15869,
"kind": "msg",
"jp": [
"「・・・驚いたよね」"
]
},
{
"id": 15870,
"kind": "msg",
"jp": [
"那須さんは普段からは想像出来ない",
"くらい悲痛な表情でうつむいた。"
]
},
{
"id": 15871,
"kind": "msg",
"jp": [
"「一体、いつ亡くなったんだろう。",
"ぼくは・・・全然気が付かなかった」"
]
},
{
"id": 15872,
"kind": "msg",
"jp": [
"「・・・僕もです・・・」"
]
},
{
"id": 15873,
"kind": "msg",
"jp": [
