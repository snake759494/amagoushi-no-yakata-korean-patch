]
},
{
"id": 16000,
"kind": "msg",
"jp": [
"「いや、なんか何度も聞いた",
"ような気がしていつだったか」"
]
},
{
"id": 16001,
"kind": "msg",
"jp": [
"「ま、いいか」"
]
},
{
"id": 16002,
"kind": "msg",
"jp": [
"「いいんですか!?」"
]
},
{
"id": 16003,
"kind": "msg",
"jp": [
"「ぼくは特に危ない目には",
"あってないから大丈夫なんじゃない?」"
]
},
{
"id": 16004,
"kind": "msg",
"jp": [
"いいのかなぁ・・・。"
]
},
{
"id": 16005,
"kind": "msg",
"jp": [
"「あ、そうだ。",
"和くんさ・・・」"
]
},
{
"id": 16006,
"kind": "msg",
"jp": [
"「なんか夕べぼくが",
"危ないって・・・あれ?」"
]
},
{
"id": 16007,
"kind": "msg",
"jp": [
"「この話前にもしたよな。",
"ごめんごめん」"
]
},
{
