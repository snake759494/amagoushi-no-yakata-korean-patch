]
},
{
"id": 15898,
"kind": "msg",
"jp": [
"やっぱり知らないか・・・。"
]
},
{
"id": 15899,
"kind": "msg",
"jp": [
"「え? 斑井さんって",
"重雄さんっていうんだ?」"
]
},
{
"id": 15900,
"kind": "msg",
"jp": [
"「いえ、小説に出てくる方の",
"斑井さんですが」"
]
},
{
"id": 15901,
"kind": "msg",
"jp": [
"「ああ、そっちか。",
"ふうん、そんな名前だっけ」"
]
},
{
"id": 15902,
"kind": "msg",
"jp": [
"読んだことはあるのかな・・・?"
]
},
{
"id": 15903,
"kind": "msg",
"jp": [
"「・・・?",
"いや、ちょっとわからないな」"
]
},
{
"id": 15904,
"kind": "msg",
"jp": [
"「えーっと、確か読んだ話に",
