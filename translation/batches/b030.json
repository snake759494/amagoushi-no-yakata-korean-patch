]
},
{
"id": 15953,
"kind": "msg",
"jp": [
"「なんの仕事ですか?」"
]
},
{
"id": 15954,
"kind": "msg",
"jp": [
"「時代劇だったよ」"
]
},
{
"id": 15955,
"kind": "msg",
"jp": [
