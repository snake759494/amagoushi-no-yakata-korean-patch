]
},
{
"id": 15957,
"kind": "msg",
"jp": [
"「あー、あれ面白いよね」"
]
},
{
"id": 15958,
"kind": "msg",
"jp": [
"「面白いよ、うん」"
]
},
{
"id": 15959,
"kind": "msg",
"jp": [
