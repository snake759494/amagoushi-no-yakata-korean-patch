[
{
"id": 22478,
"kind": "msg",
"jp": [
"「どの辺ですかい?」"
]
},
{
"id": 22479,
"kind": "msg",
"jp": [
"「うん、えっと・・・」"
]
},
{
"id": 22480,
"kind": "msg",
"jp": [
"「こうだと思うよ」"
]
},
{
"id": 22481,
"kind": "msg",
"jp": [
"「ええと・・・",
"こりゃどういう順番です?」"
]
},
{
"id": 22482,
"kind": "msg",
"jp": [
"「事件が起きた年の順だよ。",
"話の中で事件が発生した年代順」"
]
},
{
"id": 22483,
"kind": "msg",
"jp": [
"「年代順ですかい。",
"なるほど・・・」"
]
},
{
"id": 22484,
"kind": "msg",
"jp": [
"「ええと『黒猫』が昭和11年、",
"『鐘楼』が・・・昭和12年で",
"『湖畔』が同じ昭和12年の暮れか」"
]
},
{
"id": 22485,
"kind": "msg",
"jp": [
"「で、『忌まわしい花』が・・・」"
]
},
{
"id": 22486,
"kind": "msg",
"jp": [
"「あ、それは物語の始まった時期は",
"昭和35年だけどさ」"
]
},
{
"id": 22487,
"kind": "msg",
"jp": [
"「事件そのものは20年前の",
"当主の変死からだから、",
"昭和15年が始まりだよね」"
]
},
{
"id": 22488,
"kind": "msg",
"jp": [
"「? どうかしたの?」"
]
},
{
"id": 22489,
"kind": "msg",
"jp": [
"「いえね、実は『忌まわしい花』は",
"今のファンの間では最後の事件って",
"呼ばれてるんですよ」"
]
},
{
"id": 22490,
"kind": "msg",
"jp": [
"「これを最後に",
"涼介のシリーズは",
"書いてねえですから」"
]
},
{
"id": 22491,
"kind": "msg",
"jp": [
"「あれ、じゃあこの順番",
"間違ってるかな」"
]
},
{
"id": 22492,
"kind": "msg",
"jp": [
"「いや、俺はこれで",
"あってると思いますぜ」"
]
},
{
"id": 22493,
"kind": "msg",
"jp": [
"「なんせ高遠延二郎本人は",
"最後の事件のつもりなんて",
"これっぽっちもなかったんですから」"
]
},
{
"id": 22494,
"kind": "msg",
"jp": [
"「最後の事件ってアオリ文句は",
"文庫でシリーズが復刻した時に",
"帯についてた文章なんです」"
]
},
{
"id": 22495,
"kind": "msg",
"jp": [
"「その時は、高遠本人はもう",
"亡くなってましたから」"
]
},
{
"id": 22496,
"kind": "msg",
"jp": [
"「じゃあ出版社がそういう",
"アオリ文句で売っただけなんだ」"
]
},
{
"id": 22497,
"kind": "msg",
"jp": [
"「そういうことです。",
"ただ、あんまり知られてねえん",
"ですよね・・・」"
]
},
{
"id": 22498,
"kind": "msg",
"jp": [
"「書く予定でいた",
"本物の最後の事件てやつは",
"結局存在しねえんで」"
]
},
{
"id": 22499,
"kind": "msg",
"jp": [
"「書く前に亡くなったの?」"
]
},
{
"id": 22500,
"kind": "msg",
"jp": [
"「犯人は知ってるのかな、",
"その・・・高遠さん本人は",
"最後のつもりなかったって」"
]
},
{
"id": 22501,
"kind": "msg",
"jp": [
"「知ってる、と思いますぜ。",
"わざわざこのシリーズを",
"見立てのネタにするくれえだし」"
]
},
{
"id": 22502,
"kind": "msg",
"jp": [
"「じゃあ、『花』が昭和15年、",
"次が昭和24年の『悪魔』で・・・」"
]
},
{
"id": 22503,
"kind": "msg",
"jp": [
"「最後が『檻の中の女』",
"昭和30年ですね」"
]
},
{
"id": 22504,
"kind": "msg",
"jp": [
"「順番はこうだと思うんだけどな」"
]
},
{
"id": 22505,
"kind": "msg",
"jp": [
"「事件が発生した年代の",
"順番ってことですね」"
]
},
{
"id": 22506,
"kind": "msg",
"jp": [
"「こうじゃないかな」"
]
},
{
"id": 22507,
"kind": "msg",
"jp": [
"「ええと、これは・・・",
"ああ、本の発売順ってことですか」"
]
},
{
"id": 22508,
"kind": "msg",
"jp": [
"「『黒猫』が昭和12年だろ、",
"『鐘楼』が昭和14年で、",
"次の『悪魔』が昭和25年6月」"
]
},
{
"id": 22509,
"kind": "msg",
"jp": [
"「『湖畔』が同じ25年の10月、",
"『檻』が32年で『花』が38年",
"・・・ですね」"
]
},
{
"id": 22510,
"kind": "msg",
"jp": [
"「順番はこれで・・・」"
]
},
{
"id": 22511,
"kind": "msg",
"jp": [
"「発売順ってことですね」"
]
},
{
"id": 22512,
"kind": "msg",
"jp": [
"「『黒猫』の次は『鐘楼』で、",
"その次が『湖畔』、『悪魔』・・・」"
]
},
{
"id": 22513,
"kind": "msg",
"jp": [
"「・・・ああ、なるほど。",
"わかりましたよ、事件の年代順って",
"ことですね」"
]
},
{
"id": 22514,
"kind": "msg",
"jp": [
"「うん、『黒猫』の事件発生が",
"昭和11年って書いてあるだろ。",
"で、『鐘楼』が昭和12年」"
]
},
{
"id": 22515,
"kind": "msg",
"jp": [
"「『湖畔』は・・・あ、これだ。",
"『昭和12年の暮れ・・・』って",
"記述がある」"
]
},
{
"id": 22516,
"kind": "msg",
"jp": [
"「で、次が昭和24年の『悪魔』で",
"その次が『檻の中の女』昭和30年、",
"最後が昭和35年の『花』と」"
]
},
{
"id": 22517,
"kind": "msg",
"jp": [
"「そう、これであってると思う」"
]
},
{
"id": 22518,
"kind": "msg",
"jp": [
"「順番はこれでいいかな」"
]
},
{
"id": 22519,
"kind": "msg",
"jp": [
"「作中の事件の年代順ですよね」"
]
},
{
"id": 22520,
"kind": "msg",
"jp": [
"「順番はこうかな・・・」"
]
},
{
"id": 22521,
"kind": "msg",
"jp": [
"「これでいいですかい?」"
]
},
{
"id": 22522,
"kind": "msg",
"jp": [
"「うん、いいと思う」"
]
},
{
"id": 22523,
"kind": "msg",
"jp": [
"「ありゃ、ここにいる人と",
"同じ名前のキャラは出てきてない",
"本が混じってますが・・・」"
]
},
{
"id": 22524,
"kind": "msg",
"jp": [
"「・・・あ、そうか。",
"俺は出てまさぁね」"
]
},
{
"id": 22525,
"kind": "msg",
"jp": [
"「こうじゃないかなぁ?」"
]
},
{
"id": 22526,
"kind": "msg",
"jp": [
"「この順番で狙われるって",
"ことですね?」"
]
},
{
"id": 22527,
"kind": "msg",
"jp": [
"「うん、僕はそう思うんだけど」"
]
},
{
"id": 22528,
"kind": "msg",
"jp": [
"「それじゃあ、と・・・」"
]
},
{
"id": 22529,
"kind": "msg",
"jp": [
"「あれ、{和/なご}さん",
"これじゃあリストの半分しか",
"埋まってねえですぜ?」"
]
},
{
"id": 22530,
"kind": "msg",
"jp": [
"「うん、そこがわかんなくてさ。",
"誰のことを暗示してるのか・・・」"
]
},
{
"id": 22531,
"kind": "msg",
"jp": [
"「どうします?",
"もう一度考え直しますかい?」"
]
},
{
"id": 22532,
"kind": "msg",
"jp": [
"「そうだなあ・・・」"
]
},
{
"id": 22533,
"kind": "msg",
"jp": [
"「うん、そこがわかんなくてさ。",
"なんのことを暗示してるのか・・・」"
]
},
{
"id": 22534,
"kind": "msg",
"jp": [
"「それじゃあ、",
"今日狙われんのは・・・」"
]
},
{
"id": 22535,
"kind": "msg",
"jp": [
"「今日は俺ってことですかい」"
]
},
{
"id": 22536,
"kind": "msg",
"jp": [
"「そうなる、と思う。",
"だから夜は気をつけないと」"
]
},
{
"id": 22537,
"kind": "msg",
"jp": [
"「椿さんが危ねえと?」"
]
},
{
"id": 22538,
"kind": "msg",
"jp": [
"「今日は暗石さんが危ねえって",
"ことですね」"
]
},
{
"id": 22539,
"kind": "msg",
"jp": [
"「うん、そう思う・・・」"
]
},
{
"id": 22540,
"kind": "msg",
"jp": [
"「那須さんですか、今日は」"
]
},
{
"id": 22541,
"kind": "msg",
"jp": [
"「今日狙われるのは",
"御陵さんってことですね」"
]
},
{
"id": 22542,
"kind": "msg",
"jp": [
"「僕はそうなると思う」"
]
},
{
"id": 22543,
"kind": "msg",
"jp": [
"「今日は静奈さんが危ねえって",
"ことになりますね」"
]
},
{
"id": 22544,
"kind": "msg",
"jp": [
"「鈴奈さんが今日はやべえって",
"ことですかい」"
]
},
{
"id": 22545,
"kind": "msg",
"jp": [
"「そうだと思う・・・」"
]
},
{
"id": 22546,
"kind": "msg",
"jp": [
"「南雲さん・・・ですかい?」"
]
},
{
"id": 22547,
"kind": "msg",
"jp": [
"「並べるとそうなっちゃったんだよ」"
]
},
{
"id": 22548,
"kind": "msg",
"jp": [
"「で、本の方がこれ、と」"
]
},
{
"id": 22549,
"kind": "msg",
"jp": [
"「これは、見立てに使われる",
"小道具がありそうですね」"
]
},
{
"id": 22550,
"kind": "msg",
"jp": [
"「見立てに使われそうな物って",
"とにかくあるだけ全部",
"隠しちゃった方がいいよね」"
]
},
{
"id": 22551,
"kind": "msg",
"jp": [
"「隠されてたら、犯人のほうも",
"自分のやることを読まれてるって",
"わかるだろうし・・・」"
]
},
{
"id": 22552,
"kind": "msg",
"jp": [
"「・・・逆に刺激しちまう",
"ことにもなりそうですがね」"
]
},
{
"id": 22553,
"kind": "msg",
"jp": [
"「そ、そこはちょっと怖いけど",
"だからって危ないかもしれない物",
"放っておくわけにもいかないよ」"
]
},
{
"id": 22554,
"kind": "msg",
"jp": [
"「そうですね。",
"出来ることはやっとかねえと」"
]
},
{
"id": 22555,
"kind": "msg",
"jp": [
"「隠す物が見当ついたら、",
"それ探し出さないとなあ」"
]
},
{
"id": 22556,
"kind": "msg",
"jp": [
"「・・・その、",
"物探しですけどね」"
]
},
{
"id": 22557,
"kind": "msg",
"jp": [
"「うん?」"
]
},
{
"id": 22558,
"kind": "msg",
"jp": [
"「お任せ出来ますか」"
]
},
{
"id": 22559,
"kind": "msg",
"jp": [
"「・・・ああ、そうか。",
"2人してうろうろしてると",
"やっぱり1人より目立つか」"
]
},
{
"id": 22560,
"kind": "msg",
"jp": [
"「あんまり刺激しないように",
"こっそりやった方がいいもんな」"
]
},
{
"id": 22561,
"kind": "msg",
"jp": [
"「ええ、どうしても1人じゃ",
"困るって時は手伝いますから",
"すぐ呼びに来て下さい」"
]
},
{
"id": 22562,
"kind": "msg",
"jp": [
"「『鐘楼館の殺人』ってえと",
"地下室の開かずの棺から死体が",
"出てくる話ですね」"
]
},
{
"id": 22563,
"kind": "msg",
"jp": [
"「確か変な杖で殴り殺されてん",
"だったかな」"
]
},
{
"id": 22564,
"kind": "msg",
"jp": [
"「なんか魔法使いが持ってそうな",
"妙な形の木の杖でしたぜ」"
]
},
{
"id": 22565,
"kind": "msg",
"jp": [
"「じゃあ使われそうなものって",
"いうと棺と杖になるのかな」"
]
},
{
"id": 22566,
"kind": "msg",
"jp": [
"「しかし、『湖畔の館』か。",
"こりゃやっかいだなぁ」"
]
},
{
"id": 22567,
"kind": "msg",
"jp": [
"「死体の側に必ず変なものが",
"落ちてるって話なんで」"
]
},
{
"id": 22568,
"kind": "msg",
"jp": [
"「ワイングラスに角砂糖と",
"銀のマドラーが入ってたり・・・」"
]
},
{
"id": 22569,
"kind": "msg",
"jp": [
"「チェスの駒とダーツの矢が",
"暖炉の上に置いてあったり」"
]
},
{
"id": 22570,
"kind": "msg",
"jp": [
"「そう言えば、なんかいろいろ",
"書いてあったような・・・」"
]
},
{
"id": 22571,
"kind": "msg",
"jp": [
"「やたら小道具の多い話",
"なんですよね」"
]
},
{
"id": 22572,
"kind": "msg",
"jp": [
"「・・・他には?」"
]
},
{
"id": 22573,
"kind": "msg",
"jp": [
"「えーと、後は・・・",
"羽根ペンに燭台でしょ、",
"それから・・・」"
]
},
{
"id": 22574,
"kind": "msg",
"jp": [
"「革のクッションに",
"コルク抜きもあったかな」"
]
},
{
"id": 22575,
"kind": "msg",
"jp": [
"「10個くらいあるな・・・。",
"小物ばっかりで犯人が自分で",
"持ち込めそうだし・・・」"
]
},
{
"id": 22576,
"kind": "msg",
"jp": [
"「とにかく目に付いたものは",
"全部隠してみるよ」"
]
},
{
"id": 22577,
"kind": "msg",
"jp": [
"「今言ったのが全部隠せたとしても",
"油断しねえ方がいいでしょうね。",
"何せどこにでもある物ですから」"
]
},
{
"id": 22578,
"kind": "msg",
"jp": [
"「そうだね、気をつける」"
]
},
{
"id": 22579,
"kind": "msg",
"jp": [
"「『忌まわしい花』だったら",
"まずは薔薇かなあ」"
]
},
{
"id": 22580,
"kind": "msg",
"jp": [
"「ああ、あらすじに書いてあるね。",
"薔薇の花束か・・・」"
]
},
{
"id": 22581,
"kind": "msg",
"jp": [
"「あと気になるのは",
"凶器ですかね。",
"射殺なんですよね・・・」"
]
},
{
"id": 22582,
"kind": "msg",
"jp": [
"「射殺ってことは銃だよね?」"
]
},
{
"id": 22583,
"kind": "msg",
"jp": [
"「まんま拳銃じゃなくても、",
"射殺出来るような武器なら",
"どっかにあるかもしれません」"
]
},
{
"id": 22584,
"kind": "msg",
"jp": [
"「なんかいろいろ物騒なもん",
"飾ってありますからねえ」"
]
},
{
"id": 22585,
"kind": "msg",
"jp": [
"「『悪魔の花園』なら・・・",
"とにかく斧ですね」"
]
},
{
"id": 22586,
"kind": "msg",
"jp": [
"「そうだね。",
"あらすじにも思いっきり",
"書いてあるし」"
]
},
{
"id": 22587,
"kind": "msg",
"jp": [
"「『檻の中の女』だと・・・",
"白い日傘、かな?」"
]
},
{
"id": 22588,
"kind": "msg",
"jp": [
"「そうみたいだね。",
"他になんかこれってもの",
"出てくる?」"
]
},
{
"id": 22589,
"kind": "msg",
"jp": [
"「いや、印象にねえですぜ。",
"さすがにこの館にも地下牢なんて",
"もんはねえですし」"
]
},
{
"id": 22590,
"kind": "msg",
"jp": [
"「『黒猫の毒』は・・・",
"斑井さんの出てくる話ですぜ」"
]
},
{
"id": 22591,
"kind": "msg",
"jp": [
"「これがまた使われるとすりゃ、",
"使われそうなもんって何でしょうかね」"
]
},
{
"id": 22592,
"kind": "msg",
"jp": [
"「思いつかない?」"
]
},
{
"id": 22593,
"kind": "msg",
"jp": [
"「そうですねえ。",
"黒猫はもう温室に出てるし、",
"斑井さんの死体はああだったし」"
]
},
{
"id": 22594,
"kind": "msg",
"jp": [
"「同時収録の『白蛇殺人事件』の方",
"ですかね?」"
]
},
{
"id": 22595,
"kind": "msg",
"jp": [
"「・・・て、ことは蛇?」"
]
},
{
"id": 22596,
"kind": "msg",
"jp": [
"「蛇ですが、",
"真っ白いやつだけですぜ。",
"しかも双頭の」"
]
},
{
"id": 22597,
"kind": "msg",
"jp": [
"「館の中にいたら嫌だよっ!」"
]
},
{
"id": 22598,
"kind": "msg",
"jp": [
"「まあ、さすがにねぇんじゃないかな」"
]
},
{
"id": 22599,
"kind": "msg",
"jp": [
"「『忌み嫌われる秘訣』ですね。",
"これは壺かなあ」"
]
},
{
"id": 22600,
"kind": "msg",
"jp": [
"「2つ出てくるみたいだね。",
"高価な壺と、妙な形の壺?」"
]
},
{
"id": 22601,
"kind": "msg",
"jp": [
"「そうですね、その2つですかね」"
]
},
{
"id": 22602,
"kind": "msg",
"jp": [
"「『静かなる殺意』は、",
"日本刀ってことになっちまうん",
"ですかね?」"
]
},
{
"id": 22603,
"kind": "msg",
"jp": [
"「武器は色々あるけど",
"日本刀はさすがになさそう",
"だなぁ・・・」"
]
},
{
"id": 22604,
"kind": "msg",
"jp": [
"「ですよね。",
"でも、温泉ってのはもっと",
"どうしようもねえでしょう」"
]
},
{
"id": 22605,
"kind": "msg",
"jp": [
"「うーん・・・",
"使えそうなものがないかどうかは",
"探してみるよ」"
]
},
{
"id": 22606,
"kind": "msg",
"jp": [
"「『猫と初雪』だと、",
"まんま猫と雪ですかねえ」"
]
},
{
"id": 22607,
"kind": "msg",
"jp": [
"「雪は降ってないけど",
"猫ってどんな猫?」"
]
},
{
"id": 22608,
"kind": "msg",
"jp": [
"「シャム猫ですぜ、確か」"
]
},
{
"id": 22609,
"kind": "msg",
"jp": [
"「温室のは黒猫だしなぁ。",
"うーん、探してみるよ」"
]
},
{
"id": 22610,
"kind": "msg",
"jp": [
"「『灰色の仮面』はもう",
"見たまんまですね」"
]
},
{
"id": 22611,
"kind": "msg",
"jp": [
"「仮面だよね」"
]
},
{
"id": 22612,
"kind": "msg",
"jp": [
"「『死神の鎌』ってことは",
"黒いマントですかねえ」"
]
},
{
"id": 22613,
"kind": "msg",
"jp": [
"「死神ってこの館に何か",
"そういう絵とか飾りとか",
"あるかな」"
]
},
{
"id": 22614,
"kind": "msg",
"jp": [
"「そうですね、",
"あるかもしれません」"
]
},
{
"id": 22615,
"kind": "msg",
"jp": [
"「『小鳥を飼う女』ですかい。",
"これは短編集ですが・・・」"
]
},
{
"id": 22616,
"kind": "msg",
"jp": [
"「・・・ああ、でも見立てに",
"使えそうなものって表題作の",
"小鳥くらいですねぇ」"
]
},
{
"id": 22617,
"kind": "msg",
"jp": [
"「小鳥かぁ・・・。",
"見つからないかもしれないけど",
"探してみるよ」"
]
},
{
"id": 22618,
"kind": "msg",
"jp": [
"「『人形は笑う』だと、",
"日本人形ですけど・・・」"
]
},
{
"id": 22619,
"kind": "msg",
"jp": [
"「日本人形って",
"見た覚えないなあ」"
]
},
{
"id": 22620,
"kind": "msg",
"jp": [
"「現場に残されてる",
"『呪われろ』ってメッセージの方も",
"ちょいと防ぎようがねえですね」"
]
},
{
"id": 22621,
"kind": "msg",
"jp": [
"「そうだね、紙と書くものなんか",
"館中から隠しても犯人だって持って",
"そうだし・・・」"
]
},
{
"id": 22622,
"kind": "msg",
"jp": [
"「・・・あ、でも凶器は錐なんだ」"
]
},
{
"id": 22623,
"kind": "msg",
"jp": [
"「それはどっかにありそうですね」"
]
},
{
"id": 22624,
"kind": "msg",
"jp": [
"「『壺の中の謎』・・・は、",
"でっけえ壺ってことになりますか」"
]
},
{
"id": 22625,
"kind": "msg",
"jp": [
"「壺ってなんかいっぱい",
"ありそうだけど・・・",
"とりあえず大きいやつだね」"
]
},
{
"id": 22626,
"kind": "msg",
"jp": [
"「この場合どうなるんだろ。",
"『忘れじの島』って話だと」"
]
},
{
"id": 22627,
"kind": "msg",
"jp": [
"「手紙、てのは小道具としては",
"どうですかねえ」"
]
},
{
"id": 22628,
"kind": "msg",
"jp": [
"「むしろ瀬戸内海の印象が強い",
"話なんですよね」"
]
},
{
"id": 22629,
"kind": "msg",
"jp": [
"「瀬戸内海・・・って",
"絵とか写真とか?」"
]
},
{
"id": 22630,
"kind": "msg",
"jp": [
"「あと、地図とかですかね」"
]
},
{
"id": 22631,
"kind": "msg",
"jp": [
"「『蝋燭と林檎』なら",
"そのまんまですね」"
]
},
{
"id": 22632,
"kind": "msg",
"jp": [
"「蝋燭と林檎、だけでいい?」"
]
},
{
"id": 22633,
"kind": "msg",
"jp": [
"「他にこれってのは",
"出てきてねえと思いますぜ」"
]
},
{
"id": 22634,
"kind": "msg",
"jp": [
"「『7枚の絵札』なら",
"トランプでしょうね」"
]
},
{
"id": 22635,
"kind": "msg",
"jp": [
"「だろうね。",
"トランプって娯楽室に",
"あったかなあ?」"
]
},
{
"id": 22636,
"kind": "msg",
"jp": [
"「ああ、そういや",
"見た覚えねえなあ」"
]
},
{
"id": 22637,
"kind": "msg",
"jp": [
"「うーん・・・",
"でも、関連するものがあるかも",
"しれないし探してみるよ」"
]
},
{
"id": 22638,
"kind": "msg",
"jp": [
"「『桜の木の下に』ですし",
"まんま桜ってことになりますかね」"
]
},
{
"id": 22639,
"kind": "msg",
"jp": [
"「本物はさすがに咲いてないし",
"絵か何かかな?」"
]
},
{
"id": 22640,
"kind": "msg",
"jp": [
"「でしょうね。",
"もしくは桜の模様のついた",
"何かとか・・・」"
]
},
{
"id": 22641,
"kind": "msg",
"jp": [
"「・・・白骨は関係ないよね」"
]
},
{
"id": 22642,
"kind": "msg",
"jp": [
"「そんなもん館の中に",
"あったら嫌でしょう」"
]
},
{
"id": 22643,
"kind": "msg",
"jp": [
"「『絵の中の死』ですかい」"
]
},
{
"id": 22644,
"kind": "msg",
"jp": [
"「これってどういう絵なの?」"
]
},
{
"id": 22645,
"kind": "msg",
"jp": [
"「女性の生首の絵です」"
]
},
{
"id": 22646,
"kind": "msg",
"jp": [
"「・・・・そ、そんな絵",
"あるかな・・・」"
]
},
{
"id": 22647,
"kind": "msg",
"jp": [
"「この館では見たことねぇですが」"
]
},
{
"id": 22648,
"kind": "msg",
"jp": [
"あんまり探したくもないけど",
"探してみるしかないよな・・・。"
]
},
{
"id": 22649,
"kind": "msg",
"jp": [
"「『時計』ってそのまんま",
"時計でいいのかな。",
"なんかいっぱいありそうだけど」"
]
},
{
"id": 22650,
"kind": "msg",
"jp": [
"「作中に出てくるのは",
"掛け時計ですね。",
"壁に掛けるやつ」"
]
},
{
"id": 22651,
"kind": "msg",
"jp": [
"「そっか、じゃあ置時計とかは",
"関係ないんだ」"
]
},
{
"id": 22652,
"kind": "msg",
"jp": [
"「『既に死んでいた男』は",
"船の上の事件なんですよね」"
]
},
{
"id": 22653,
"kind": "msg",
"jp": [
"「船かぁ・・・」"
]
},
{
"id": 22654,
"kind": "msg",
"jp": [
"「ええと・・・",
"この本だと見立てに使われそうな",
"小道具がちょいと思いつきませんぜ」"
]
},
{
"id": 22655,
"kind": "msg",
"jp": [
"「見立て殺人じゃないかも",
"知れねえってことですかい?」"
]
},
{
"id": 22656,
"kind": "msg",
"jp": [
"「そうだと思うよ。",
"今回は死体には何も",
"しないんじゃないかな」"
]
},
{
"id": 22657,
"kind": "msg",
"jp": [
"「原作の状況に合わせてるだけなら、",
"斑井さんみたいに特殊なものじゃ",
"なければ何もしないんじゃない?」"
]
},
{
"id": 22658,
"kind": "msg",
"jp": [
"「見立て殺人がやりたいって目的でも",
"なけりゃわざわざ手間のかかることは",
"しねえか・・・」"
]
},
{
"id": 22659,
"kind": "msg",
"jp": [
"「いや、強引に見立て殺人には",
"するかもしれないけどさ」"
]
},
{
"id": 22660,
"kind": "msg",
"jp": [
"「強引にって・・・?」"
]
},
{
"id": 22661,
"kind": "msg",
"jp": [
"「必ず何か物を使ってやるとも",
"限らないんじゃないかな」"
]
},
{
"id": 22662,
"kind": "msg",
"jp": [
"「たとえば、現場が室内だとか",
"屋外だとか凶器だけ同じだとか」"
]
},
{
"id": 22663,
"kind": "msg",
"jp": [
"「ああ、それなら小道具は",
"関係ねえって話になりますね」"
]
},
{
"id": 22664,
"kind": "msg",
"jp": [
"「だろ?」"
]
},
{
"id": 22665,
"kind": "msg",
"jp": [
"「・・・あれ?",
"こりゃあ、高遠延二郎の",
"本じゃねえですぜ?」"
]
},
{
"id": 22666,
"kind": "msg",
"jp": [
"「うん、そうなんだけど",
"絶対に高遠さんの作品しか",
"使わないとも限らないだろ」"
]
},
{
"id": 22667,
"kind": "msg",
"jp": [
"「そうかもしれませんが、",
"なんでこの本なんです?」"
]
},
{
"id": 22668,
"kind": "msg",
"jp": [
"「これも推理物だしさ、",
"現場を似た状況にすることは",
"可能なんじゃないかな」"
]
},
{
"id": 22669,
"kind": "msg",
"jp": [
"「はあ、なるほど・・・」"
]
},
{
"id": 22670,
"kind": "msg",
"jp": [
"「見立てがしやすそうじゃない?」"
]
},
{
"id": 22671,
"kind": "msg",
"jp": [
"「そうですかい・・・?",
"てぇか、見立てやすいって理由で",
"関係なさそうな本使いますかね」"
]
},
{
"id": 22672,
"kind": "msg",
"jp": [
"「・・・変かな」"
]
},
{
"id": 22673,
"kind": "msg",
"jp": [
"「なんか理屈が変じゃねえですかい?」"
]
},
{
"id": 22674,
"kind": "msg",
"jp": [
"「うーん、そっか・・・」"
]
},
{
"id": 22675,
"kind": "msg",
"jp": [
"「けど、今日のところに入ってる本、",
"高遠とも推理小説とも関係なさそう",
"なんですが、これで間違いねえんで?」"
]
},
{
"id": 22676,
"kind": "msg",
"jp": [
"「うん、だって・・・」"
]
},
{
"id": 22677,
"kind": "msg",
"jp": [
"「絶対に推理小説が使われるとも",
"限らないんじゃないかな」"
]
},
{
"id": 22678,
"kind": "msg",
"jp": [
"「そりゃ、必ず推理物だって",
"証拠はねえですが・・・」"
]
},
{
"id": 22679,
"kind": "msg",
"jp": [
"「そうだろ?",
"犯人がそこにこだわってるか",
"どうかわからないわけだし」"
]
},
{
"id": 22680,
"kind": "msg",
"jp": [
"「むしろ、推理物に違いないって",
"思い込んでたらその方が危ない",
"ような気がするんだよ」"
]
},
{
"id": 22681,
"kind": "msg",
"jp": [
"「まあ、確かに」"
]
},
{
"id": 22682,
"kind": "msg",
"jp": [
"「見立ての状況は作りやすそう",
"だと思わない?」"
]
},
{
"id": 22683,
"kind": "msg",
"jp": [
"「そうですかい?",
"でもなあ・・・」"
]
},
{
"id": 22684,
"kind": "msg",
"jp": [
"「なんかおかしい?」"
]
},
{
"id": 22685,
"kind": "msg",
"jp": [
"「見立てやすいっちゃあ、",
"斑井さんのあれなんかかなり",
"手間掛かってますぜ」"
]
},
{
"id": 22686,
"kind": "msg",
"jp": [
"「見立てやすいかどうかで考えて",
"選んでるなら、まずあの話自体が",
"選ばれてねえ気がしますがね」"
]
},
{
"id": 22687,
"kind": "msg",
"jp": [
"「あ・・なるほど・・・」"
]
},
{
"id": 22688,
"kind": "msg",
"jp": [
"「なんか違いませんかね、やっぱり」"
]
},
{
"id": 22689,
"kind": "msg",
"jp": [
"「そっか、おかしいかな。",
"うーん・・・」"
]
},
{
"id": 22690,
"kind": "msg",
"jp": [
"「ところで、なんでこの本",
"なんですかい・・・?」"
]
},
{
"id": 22691,
"kind": "msg",
"jp": [
"「高遠作品でもねえし",
"関係なさそうなんですが",
"どういう根拠で?」"
]
},
{
"id": 22692,
"kind": "msg",
"jp": [
"「・・・勘」"
]
},
{
"id": 22693,
"kind": "msg",
"jp": [
"「だ、だけですかい」"
]
},
{
"id": 22694,
"kind": "msg",
"jp": [
"「だって他に入りそうな本",
"思いつかないんだもん」"
]
},
{
"id": 22695,
"kind": "msg",
"jp": [
"「いや、でもさすがに根拠も",
"何もねえのはまずいでしょう」"
]
},
{
"id": 22696,
"kind": "msg",
"jp": [
"「これで今日狙われてるかもって",
"言われても言われた相手は多分",
"納得してくれねえですぜ」"
]
},
{
"id": 22697,
"kind": "msg",
"jp": [
"「・・・そ、そうだね。",
"うーん・・・」"
]
},
{
"id": 22698,
"kind": "msg",
"jp": [
"「犯人が、絶対に高遠さんの本しか",
"使わないとは限らないだろ」"
]
},
{
"id": 22699,
"kind": "msg",
"jp": [
"「そりゃ、そこは決め付けねえ方が",
"いいかとは思いますが・・・」"
]
},
{
"id": 22700,
"kind": "msg",
"jp": [
"「わざわざこの館で事件を起こした",
"ことも関係あると思うんだよ」"
]
},
{
"id": 22701,
"kind": "msg",
"jp": [
"「だから、この書斎にある本は",
"一見まったく関係なさそうでも、",
"無視しない方がいいと思うよ」"
]
},
{
"id": 22702,
"kind": "msg",
"jp": [
"「・・・で、あの・・・",
"なんでマリアンヌなんです・・・?」"
]
},
{
"id": 22703,
"kind": "msg",
"jp": [
"「登場キャラが似てない?」"
]
},
{
"id": 22704,
"kind": "msg",
"jp": [
"「えっと・・・",
"似て、ますかね・・・?」"
]
},
{
"id": 22705,
"kind": "msg",
"jp": [
"「僕は似てると思うんだけど」"
]
},
{
"id": 22706,
"kind": "msg",
"jp": [
"なんか、ものすごく複雑な顔を",
"されてしまった・・・。"
]
},
{
"id": 22707,
"kind": "msg",
"jp": [
"「えーと、ですね。",
"似てるかどうかはともかくとして、",
"犯人が、その・・・・」"
]
},
{
"id": 22708,
"kind": "msg",
"jp": [
"「そういう理由でこんな状況に使う",
"本を選ぶとは思えねえんですが・・・」"
]
},
{
"id": 22709,
"kind": "msg",
"jp": [
"「なんでって、間違いないよ」"
]
},
{
"id": 22710,
"kind": "msg",
"jp": [
"「ね、ねえんですかい」"
]
},
{
"id": 22711,
"kind": "msg",
"jp": [
"「絶対これだって。",
"他に考えられないだろ?」"
]
},
{
"id": 22712,
"kind": "msg",
"jp": [
"「・・・そう、ですかね・・・?」"
]
},
{
"id": 22713,
"kind": "msg",
"jp": [
"「うん、絶対そう」"
]
},
{
"id": 22714,
"kind": "msg",
"jp": [
"「なんで途方に暮れたような",
"顔してんの?」"
]
},
{
"id": 22715,
"kind": "msg",
"jp": [
"「いや・・・",
"すいません、俺にはなんでこれに",
"間違いねえのか見当もつかねえんで」"
]
},
{
"id": 22716,
"kind": "msg",
"jp": [
"「・・・えーとですね、犯人がその、",
"この状況でこの本選ぶってのがどうも",
"想像つかねえっていうか・・・」"
]
},
{
"id": 22717,
"kind": "msg",
"jp": [
"「・・・変だと思いませんか」"
]
},
{
"id": 22718,
"kind": "msg",
"jp": [
"「ま、まあ・・・",
"なんとなくちょっと状況から",
"浮いてるような気はする」"
]
},
{
"id": 22719,
"kind": "msg",
"jp": [
"「ちょっとじゃねえですよ」"
]
},
{
"id": 22720,
"kind": "msg",
"jp": [
"「そうだ、これって",
"他の人達にも知らせた方が",
"いいのかな?」"
]
},
{
"id": 22721,
"kind": "msg",
"jp": [
"「いや・・・",
"誰が犯人かってのは判断出来てる",
"わけじゃねえですからね」"
]
},
{
"id": 22722,
"kind": "msg",
"jp": [
"「言うなら、今日狙われてる人に",
"危ねえって知らせるだけにした方が",
"よかねえですかい」"
]
},
{
"id": 22723,
"kind": "msg",
"jp": [
"「ああ、そうか・・・」"
]
},
{
"id": 22724,
"kind": "msg",
"jp": [
"この中に、犯人かその共犯が",
"いないとは限らないんだった・・。"
]
},
{
"id": 22725,
"kind": "msg",
"jp": [
"「それじゃ、言うなら",
"狙われてそうな人だけにしとこう」"
]
},
{
"id": 22726,
"kind": "msg",
"jp": [
"「・・・僕が言って",
"信用してもらえるかな。",
"日織のがよくない?」"
]
},
{
"id": 22727,
"kind": "msg",
"jp": [
"「いえ・・・",
"{和/なご}さんの方が",
"向いてますぜ」"
]
},
{
"id": 22728,
"kind": "msg",
"jp": [
"「俺よりはあんたのが",
"警戒されてねえでしょうから」"
]
},
{
"id": 22729,
"kind": "msg",
"jp": [
"「・・・そうかな。",
"他の人から見たら",
"大差なくない?」"
]
},
{
"id": 22730,
"kind": "msg",
"jp": [
"「いやぁ、俺は元から",
"うさん{臭/くさ}がられることが",
"多いですからねぇ」"
]
},
{
"id": 22731,
"kind": "msg",
"jp": [
"「・・・それはその、",
"格好のせいなんじゃ・・・」"
]
},
{
"id": 22732,
"kind": "msg",
"jp": [
"「かもしれませんが",
"今更思い出したように",
"着替えるのも不自然でしょ」"
]
},
{
"id": 22733,
"kind": "msg",
"jp": [
"「それもそうだね。",
"んー、じゃあ信用してもらえるか",
"わかんないけど僕が言うよ」"
]
},
{
"id": 22734,
"kind": "msg",
"jp": [
"「ええ、もし夜中じゅう見張るとか",
"いう話になったら呼んで下さいや。",
"俺もつき合いますからね」"
]
},
{
"id": 22735,
"kind": "msg",
"jp": [
"「うん、ありがと。",
"ひょっとしたら",
"つき合ってもらうかも」"
]
},
{
"id": 22736,
"kind": "msg",
"jp": [
"「ひょっとしなくても",
"いいんですってば。",
"1人で無茶しねえで下さいよ」"
]
},
{
"id": 22737,
"kind": "msg",
"jp": [
"「でも、犯人を刺激しすぎると",
"やっぱりまずいって・・・」"
]
},
{
"id": 22738,
"kind": "msg",
"jp": [
"「言ったでしょう。",
"あんただけは死なせませんて」"
]
},
{
"id": 22739,
"kind": "msg",
"jp": [
"「何があっても、",
"{和/なご}さんだけは死なせませんから。",
"もしもの時は俺が守ります」"
]
},
{
"id": 22740,
"kind": "msg",
"jp": [
"「だから{和/なご}さんは、思う存分",
"犯人の意表ついてやって下さい」"
]
},
{
"id": 22741,
"kind": "msg",
"jp": [
"「な、なんだよいきなり・・・",
"主人公の盾になって死んじゃう",
"脇役みたいなこと言うなよ!」"
]
},
{
"id": 22742,
"kind": "msg",
"jp": [
"「・・・バレましたか」"
]
},
{
"id": 22743,
"kind": "msg",
"jp": [
"「いっぺん言ってみたかったんです。",
"最終回間際で死にそうな奴の台詞」"
]
},
{
"id": 22744,
"kind": "msg",
"jp": [
"「お前なぁっ!",
"脅かすなよ、本気にするとこ",
"だったじゃないかー!!」"
]
},
{
"id": 22745,
"kind": "msg",
"jp": [
"「いいですぜ。",
"守りますってぇのは",
"嘘じゃねえですから」"
]
},
{
"id": 22746,
"kind": "msg",
"jp": [
"「ま・・守るって、だって",
"それ日織が危ない・・・」"
]
},
{
"id": 22747,
"kind": "msg",
"jp": [
"「俺はこれでも鍛えてますんで、",
"多少の{荒事/あらごと}は平気でさぁね」"
]
},
{
"id": 22748,
"kind": "msg",
"jp": [
"「信用して下さいって」"
]
},
{
"id": 22749,
"kind": "msg",
"jp": [
"「し、信じるよ。",
"どう見ても僕より強そうだし」"
]
},
{
"id": 22750,
"kind": "msg",
"jp": [
"「じゃあそれでいいじゃねえですか。",
"危なそうなら俺を呼んで下さい」"
]
},
{
"id": 22751,
"kind": "msg",
"jp": [
"「・・・わかったよ。",
"危なそうだったら言うから」"
]
},
{
"id": 22752,
"kind": "msg",
"jp": [
"「はい、お願いします」"
]
},
{
"id": 22753,
"kind": "msg",
"jp": [
"「でも、さっきのファイル",
"確認するのも手伝ってよ」"
]
},
{
"id": 22754,
"kind": "msg",
"jp": [
"「僕あんまり詳しくないし、",
"念のためにファイルは毎日ここで",
"確認することにするから」"
]
},
{
"id": 22755,
"kind": "msg",
"jp": [
"「そうですね、",
"誰が狙われてて使われる本が",
"何かってのだけは・・・」"
]
},
{
"id": 22756,
"kind": "msg",
"jp": [
"「編集しなおすにしろ",
"しないにしろ、",
"一応は確認しましょう」"
]
},
{
"id": 22757,
"kind": "msg",
"jp": [
"「その方が安全だよね」"
]
},
{
"id": 22758,
"kind": "msg",
"jp": [
"「僕、読むの遅いし",
"全部をしっかり読んでる",
"暇はないだろうしなぁ」"
]
},
{
"id": 22759,
"kind": "msg",
"jp": [
"「俺は一通り読んでますから",
"聞いてもらえりゃ答えられる事も",
"あると思いますぜ」"
]
},
{
"id": 22760,
"kind": "msg",
"jp": [
"「じゃあ、日織はそれ読んどいて」"
]
},
{
"id": 22761,
"kind": "msg",
"jp": [
"「はい、了解です」"
]
},
{
"id": 22762,
"kind": "msg",
"jp": [
"「・・・こりゃやっぱ、",
"考え直した方がよくねえですかい」"
]
},
{
"id": 22763,
"kind": "msg",
"jp": [
"「俺はともかく、狙われてる人に",
"忠告しても聞いてもらえそうに",
"ねえ気がしますし・・・」"
]
},
{
"id": 22764,
"kind": "msg",
"jp": [
"「それもそうだね・・・」"
]
},
{
"id": 22765,
"kind": "msg",
"jp": [
"「・・・・・駄目だ。",
"わかんなくなってきた」"
]
},
{
"id": 22766,
"kind": "msg",
"jp": [
"「ちょいと煮詰まってきましたかね」"
]
},
{
"id": 22767,
"kind": "msg",
"jp": [
"「うーん・・・",
"これは一旦置いて他のことから",
"やろうかな・・・」"
]
},
{
"id": 22768,
"kind": "msg",
"jp": [
"「その方がいいかも",
"しれませんね」"
]
},
{
"id": 22769,
"kind": "msg",
"jp": [
"「ごめん、じゃあちょっと",
"そうすることにする・・・」"
]
},
{
"id": 22770,
"kind": "msg",
"jp": [
"「ええ、何か用があったら",
"また来て下さい。",
"俺はずっとここにいますから」"
]
},
{
"id": 22771,
"kind": "msg",
"jp": [
"「・・・難しいな、これ」"
]
},
{
"id": 22772,
"kind": "msg",
"jp": [
"「立て続けに色々",
"考えすぎましたかねぇ」"
]
},
{
"id": 22773,
"kind": "msg",
"jp": [
"「そうなのかな。",
"それもあるけど・・・」"
]
},
{
"id": 22774,
"kind": "msg",
"jp": [
"「実際に表を作ってみたら",
"埋めるのにもうちょっと",
"判断材料が欲しい感じだよ」"
]
},
{
"id": 22775,
"kind": "msg",
"jp": [
"「ああ、そりゃ確かに",
"そうですよね」"
]
},
{
"id": 22776,
"kind": "msg",
"jp": [
"「なら一旦置いておいて",
"後で見直しますかい?」"
]
},
{
"id": 22777,
"kind": "msg",
"jp": [
"「それがいいかな」"
]
},
{
"id": 22778,
"kind": "msg",
"jp": [
"「わかりました。",
"じゃ、見直す算段がついたら",
"書斎に来て下さいな」"
]
},
{
"id": 22779,
"kind": "msg",
"jp": [
"後で、もう一度書斎・・・。",
"忘れないようにしないと。"
]
},
{
"id": 22780,
"kind": "msg",
"jp": [
"「・・・え?",
"{和/なご}さん、今日の分はどっちも",
"埋まってねえみてえですが・・・」"
]
},
{
"id": 22781,
"kind": "choice",
"jp": [
"考える"
]
},
{
"id": 22782,
"kind": "choice",
"jp": [
"見張ろう"
]
},
{
"id": 22783,
"kind": "choice",
"jp": [
"やめとこう"
]
},
{
"id": 22784,
"kind": "msg",
"jp": [
"「他の人達はどうします?",
"持ってってあげますかい」"
]
},
{
"id": 22785,
"kind": "msg",
"jp": [
"「けっこうたくさん作ったから",
"人数分あると思うけど」"
]
},
{
"id": 22786,
"kind": "msg",
"jp": [
"「おすそわけ」"
]
},
{
"id": 22787,
"kind": "msg",
"jp": [
"「じゃあ、持っていこうか。",
"僕は・・・」"
]
},
{
"id": 22788,
"kind": "msg",
"jp": [
"「椿くんも来てないんだな。",
"じゃあ、椿くんとこに行ってくる」"
]
},
{
"id": 22789,
"kind": "msg",
"jp": [
"サンドイッチの乗った皿をもらって",
"2階へ上がる。"
]
},
{
"id": 22790,
"kind": "msg",
"jp": [
"「椿くーん。",
"椿くん、いるー?」"
]
},
{
"id": 22791,
"kind": "msg",
"jp": [
"「あ、これ。",
"日織達が作ったんだけど",
"よかったらどうぞって」"
]
},
{
"id": 22792,
"kind": "msg",
"jp": [
"「これはこれは。",
"ありがとうございます」"
]
},
{
"id": 22793,
"kind": "msg",
"jp": [
"「いただきます、",
"みなさまによろしくお伝え下さい」"
]
},
{
"id": 22794,
"kind": "msg",
"jp": [
"「いや、マジ助かったぜ。",
"そろそろ腹減ったなーと思ってたんだ」"
]
},
{
"id": 22795,
"kind": "msg",
"jp": [
"「い、いきなり素に戻んないでよ",
"驚くから・・・」"
]
},
{
"id": 22796,
"kind": "msg",
"jp": [
"「や、失礼。",
"それでは」"
]
},
{
"id": 22797,
"kind": "msg",
"jp": [
"「ただいまー。",
"渡してきたよ」"
]
},
{
"id": 22798,
"kind": "msg",
"jp": [
"「ああ、どうも。",
"おかえりなさい」"
]
},
{
"id": 22799,
"kind": "msg",
"jp": [
"「みなさまによろしく、",
"マジ助かったって」"
]
},
{
"id": 22800,
"kind": "msg",
"jp": [
"「どっちモードやったの」"
]
},
{
"id": 22801,
"kind": "msg",
"jp": [
"「喜びのあまり一瞬元に",
"戻ってた」"
]
},
{
"id": 22802,
"kind": "msg",
"jp": [
"「相当お腹減ってたんやね。",
"よかったわぁ」"
]
},
{
"id": 22803,
"kind": "msg",
"jp": [
"「じゃ、俺らも食っちまいますか」"
]
},
{
"id": 22804,
"kind": "msg",
"jp": [
"「あ・・・",
"うちら、部屋で食べるわ。",
"ここは、ちょっと・・・」"
]
},
{
"id": 22805,
"kind": "msg",
"jp": [
"ちら、と閉ざされた食堂の扉を横目で",
"見ながら鈴奈ちゃんが言う。"
]
},
{
"id": 22806,
"kind": "msg",
"jp": [
"確かに、食欲の湧く場所ではないよな。"
]
},
{
"id": 22807,
"kind": "msg",
"jp": [
"「・・・・・またね」"
]
},
{
"id": 22808,
"kind": "msg",
"jp": [
"軽く会釈して、双子は部屋へ戻って",
"行った。"
]
},
{
"id": 22809,
"kind": "msg",
"jp": [
"「俺らはどうします?",
"ここでさっさと食っちまいます?」"
]
},
{
"id": 22810,
"kind": "msg",
"jp": [
"手っ取り早く食事を済ませて、",
"風呂に入ってから2階へ上がる。"
]
},
{
"id": 22811,
"kind": "msg",
"jp": [
"「よし・・と。",
"鍵閉めましたぜ」"
]
},
{
"id": 22812,
"kind": "msg",
"jp": [
"「ありがと。",
"窓もちゃんと閉まってるよ」"
]
},
{
"id": 22813,
"kind": "msg",
"jp": [
"「それじゃ、寝ますか。",
"おやすみなさい」"
]
},
{
"id": 22814,
"kind": "msg",
"jp": [
"脱いだ上着をベッドの端に引っ掛けて",
"欠伸をしながら布団に足を突っ込む。"
]
},
{
"id": 22815,
"kind": "msg",
"jp": [
"戻って来ちゃったけど、このままじゃ",
"御陵さんがなぁ・・・。"
]
},
{
"id": 22816,
"kind": "msg",
"jp": [
"（危ない、と思うんだけど。",
"どうすればいいのか・・・）"
]
},
{
"id": 22817,
"kind": "msg",
"jp": [
"（あと、出来そうな事って",
"部屋の前で寝ずに見張るくらい",
"だよなぁ・・・）"
]
},
{
"id": 22818,
"kind": "msg",
"jp": [
"（・・・よし、見張ろう）"
]
},
{
"id": 22819,
"kind": "msg",
"jp": [
"部屋の前でじっと見張ってれば、",
"誰か来てもきっと平気だ。"
]
},
{
"id": 22820,
"kind": "msg",
"jp": [
"すぐに大声出せば、",
"日織は飛んできてくれる",
"だろうし・・・。"
]
},
{
"id": 22821,
"kind": "msg",
"jp": [
"（・・・日織、もう寝たかな）"
]
},
{
"id": 22822,
"kind": "msg",
"jp": [
"どうやら寝入ってるようなので",
"こっそり部屋を抜け出した・・。"
]
},
{
"id": 22823,
"kind": "msg",
"jp": [
"（えーっと、御陵さんの部屋は",
"こっちだから・・・）"
]
},
{
"id": 22824,
"kind": "msg",
"jp": [
"とりあえず御陵さんの部屋の前まで",
"行ってみる。"
]
},
{
"id": 22825,
"kind": "msg",
"jp": [
"（・・・この辺にいようかな）"
]
},
{
"id": 22826,
"kind": "msg",
"jp": [
"壁にもたれて座ってればいいや。"
]
},
{
"id": 22827,
"kind": "msg",
"jp": [
"（・・・さすがに、一晩中",
"廊下にいるってのも・・・）"
]
},
{
"id": 22828,
"kind": "msg",
"jp": [
"誰かに見つかったら、僕の方が",
"怪しいヤツだよな。"
]
},
{
"id": 22829,
"kind": "msg",
"jp": [
"やめといた方がいいかも・・・。"
]
},
{
"id": 22830,
"kind": "msg",
"jp": [
"（・・・もう寝ようか・・・）"
]
},
{
"id": 22831,
"kind": "msg",
"jp": [
"（でも、気になるんだよな。",
"事件のことばっかり頭に浮かんで",
"来るし・・・）"
]
},
{
"id": 22832,
"kind": "msg",
"jp": [
"「・・・・ふあぁ」"
]
},
{
"id": 22833,
"kind": "msg",
"jp": [
"駄目だ、眠くて集中力が",
"なくなってきた・・・。"
]
},
{
"id": 22834,
"kind": "msg",
"jp": [
"そろそろ本当に寝なきゃ。"
]
},
{
"id": 22835,
"kind": "msg",
"jp": [
"（おやすみなさーい・・・）"
]
},
{
"id": 22836,
"kind": "msg",
"jp": [
"もぞもぞと布団にもぐり込み、",
"横になった途端に眠りに落ちて",
"いった・・・。"
]
},
{
"id": 22837,
"kind": "msg",
"jp": [
"「・・・っ!」"
]
},
{
"id": 22838,
"kind": "msg",
"jp": [
"いきなり聞こえてきた電子音に",
"驚いて叫ぶところだった・・・。"
]
},
{
"id": 22839,
"kind": "msg",
"jp": [
"（あ、ああ、そうか・・・。",
"御陵さんの携帯のアラームか）"
]
},
{
"id": 22840,
"kind": "msg",
"jp": [
"薬の時間に鳴るようにしてあるって",
"言ってたもんな。"
]
},
{
"id": 22841,
"kind": "msg",
"jp": [
"（・・・びっくりした・・・）"
]
},
{
"id": 22842,
"kind": "msg",
"jp": [
"これだけ音が聞こえるってことは",
"あんまり部屋に近くにいると御陵さんも",
"僕の気配に気付くかも。"
]
},
{
"id": 22843,
"kind": "msg",
"jp": [
"（犯人かもしれないと思われて",
"騒ぎになってもまずいよな・・・）"
]
},
{
"id": 22844,
"kind": "msg",
"jp": [
"もうちょっと手前にいようかな。",
"隣は空き部屋だから、前にいても",
"大丈夫だろうし・・・。"
]
},
{
"id": 22845,
"kind": "msg",
"jp": [
"「・・・・!?」"
]
},
{
"id": 22846,
"kind": "msg",
"jp": [
"何か聞こえた・・・。",
"扉の音だった気がするけど。"
]
},
{
"id": 22847,
"kind": "msg",
"jp": [
"思わず、腰を浮かせて身構える。",
"犯人だったらどうしよう・・・。"
]
},
{
"id": 22848,
"kind": "msg",
"jp": [
"（やっぱり・・・!",
"廊下に誰かいる・・・?）"
]
},
{
"id": 22849,
"kind": "msg",
"jp": [
"（・・・・・・・?）"
]
},
{
"id": 22850,
"kind": "msg",
"jp": [
"聞こえなくなった・・・?",
"こっちに来なかっただけかな。"
]
},
{
"id": 22851,
"kind": "msg",
"jp": [
"誰か部屋から出たみたいだけど、",
"トイレならすぐそこだからわかる",
"はずだし・・・。"
]
},
{
"id": 22852,
"kind": "msg",
"jp": [
"（てことは、台所にでも",
"降りて行ったのかな・・・?）"
]
},
{
"id": 22853,
"kind": "msg",
"jp": [
"「暗石さんはちゃんと",
"飯食ってますかねえ」"
]
},
{
"id": 22854,
"kind": "msg",
"jp": [
"「何かしら食べてはいるん",
"だろうけど・・・」"
]
},
{
"id": 22855,
"kind": "msg",
"jp": [
"「適当に食いやすいもの",
"差し入れましょうか」"
]
},
{
"id": 22856,
"kind": "msg",
"jp": [
"「飯は残ってますから、",
"おにぎりくらいなら作れますよ。",
"いらないようなら朝食えばいいし」"
]
},
{
"id": 22857,
"kind": "msg",
"jp": [
"残ったご飯で日織が",
"てきぱきとおにぎりを作る。"
]
},
{
"id": 22858,
"kind": "msg",
"jp": [
"「えーと、暗石さんだけで",
"いいんでしたっけ?」"
]
},
{
"id": 22859,
"kind": "msg",
"jp": [
"「御陵さんは?",
"食欲はないみたいだけど」"
]
},
{
"id": 22860,
"kind": "msg",
"jp": [
"「・・・でも薬飲んでるから",
"ちゃんとお腹に入れたほうが",
"いいよね」"
]
},
{
"id": 22861,
"kind": "msg",
"jp": [
"「ああ、そうか。",
"んじゃ2人前だ」"
]
},
{
"id": 22862,
"kind": "msg",
"jp": [
"「{和/なご}さん、どっちか",
"持ってってくれます?」"
]
},
{
"id": 22863,
"kind": "msg",
"jp": [
"「うん、わかった。",
"それじゃあ・・・」"
]
},
{
"id": 22864,
"kind": "msg",
"jp": [
"「適当に食いやすいもの",
"作りましょうか」"
]
},
{
"id": 22865,
"kind": "msg",
"jp": [
"「飯が残ってますから、",
"おにぎりなら作れますよ」"
]
},
{
"id": 22866,
"kind": "msg",
"jp": [
"「御陵さんはいらないかな?",
"食欲はないみたいだけど」"
]
},
{
"id": 22867,
"kind": "msg",
"jp": [
"「ついでなんで作っちゃいましょう。",
"いらないようなら朝食えばいいし」"
]
},
{
"id": 22868,
"kind": "msg",
"jp": [
"「{和/なご}さん、",
"持ってってくれます?」"
]
},
{
"id": 22869,
"kind": "msg",
"jp": [
"「暗石さんとこ行ってみる。",
"出てきてくれるか、わかんないけど」"
]
},
{
"id": 22870,
"kind": "msg",
"jp": [
"「お願いしますよ」"
]
},
{
"id": 22871,
"kind": "msg",
"jp": [
"「じゃ、俺はもうちょい握って",
"御陵さんとこに持ってきますから」"
]
},
{
"id": 22872,
"kind": "msg",
"jp": [
"台所は日織に任せて、おにぎりを持って",
"暗石さんの部屋へ向かう・・・。"
]
},
{
"id": 22873,
"kind": "msg",
"jp": [
"「暗石さーん、すみませーん」"
]
},
{
"id": 22874,
"kind": "msg",
"jp": [
"「・・・暗石さーん?」"
]
},
{
"id": 22875,
"kind": "msg",
"jp": [
"・・・返事もない。"
]
},
{
"id": 22876,
"kind": "msg",
"jp": [
"（いらないってことかな・・・）"
]
},
{
"id": 22877,
"kind": "msg",
"jp": [
"仕方ないな、戻ろう。"
]
},
{
"id": 22878,
"kind": "msg",
"jp": [
"「お帰りなさい・・・",
"ありゃ、駄目でしたか」"
]
},
{
"id": 22879,
"kind": "msg",
"jp": [
"「うん、出てきてくれなかった」"
]
},
{
"id": 22880,
"kind": "msg",
"jp": [
"「しょうがねえですね。",
"じゃ、朝飯にでもまわしますか」"
]
},
{
"id": 22881,
"kind": "msg",
"jp": [
"「・・・なんだ、坊主か?",
"何の用だ?」"
]
},
{
"id": 22882,
"kind": "msg",
"jp": [
"「あの、晩ご飯・・・",
"日織が作ってくれたんで」"
]
},
{
"id": 22883,
"kind": "msg",
"jp": [
"「いらねえっつったのに",
"律儀な奴らだな・・・」"
]
},
{
"id": 22884,
"kind": "msg",
"jp": [
"「あ、暗石さん!",
"はい、どうぞ」"
]
},
{
"id": 22885,
"kind": "msg",
"jp": [
"「わかったわかった。",
"着流しによろしくな、ありがとよ」"
]
},
{
"id": 22886,
"kind": "msg",
"jp": [
"「はい!」"
]
},
{
"id": 22887,
"kind": "msg",
"jp": [
"「あ、もらってくれましたか」"
]
},
{
"id": 22888,
"kind": "msg",
"jp": [
"「うん、日織によろしくって」"
]
},
{
"id": 22889,
"kind": "msg",
"jp": [
"「そうですかい。",
"そりゃよかった」"
]
},
{
"id": 22890,
"kind": "msg",
"jp": [
"「・・・いらねえっつっただろ。",
"食い物はあるんだ、構うな」"
]
},
{
"id": 22891,
"kind": "msg",
"jp": [
"やっぱり、駄目か。",
"仕方ないな・・・。"
]
},
{
"id": 22892,
"kind": "msg",
"jp": [
"「お帰りなさい。",
"・・・駄目ですか」"
]
},
{
"id": 22893,
"kind": "msg",
"jp": [
"「うん、いらないって」"
]
},
{
"id": 22894,
"kind": "msg",
"jp": [
"「御陵さんとこ行ってくる」"
]
},
{
"id": 22895,
"kind": "msg",
"jp": [
"「じゃ、お願いしますね」"
]
},
{
"id": 22896,
"kind": "msg",
"jp": [
"台所は日織に任せて、料理を持って",
"御陵さんの部屋へ向かう・・・。"
]
},
{
"id": 22897,
"kind": "msg",
"jp": [
"「御陵さーん」"
]
},
{
"id": 22898,
"kind": "msg",
"jp": [
"「あら、一柳さん・・・」"
]
},
{
"id": 22899,
"kind": "msg",
"jp": [
"「お邪魔します。",
"あの、これ日織が作ったんですが",
"よかったら・・・」"
]
},
{
"id": 22900,
"kind": "msg",
"jp": [
"「まあ、すみません。",
"ありがとうございます」"
]
},
{
"id": 22901,
"kind": "msg",
"jp": [
"「いえ・・・・」"
]
},
{
"id": 22902,
"kind": "msg",
"jp": [
"「・・・あの・・・。",
"さっきのお話なんですが・・・」"
]
},
{
"id": 22903,
"kind": "msg",
"jp": [
"「え、あ・・はい」"
]
},
{
"id": 22904,
"kind": "msg",
"jp": [
"「本当に私なんでしょうか。",
"何度考えても、心当たりがないん",
"ですけれど・・・」"
]
},
{
"id": 22905,
"kind": "msg",
"jp": [
"「ええと、僕もはっきりした",
"証拠とかあるワケじゃないんですが、",
"いろいろ考えてみたら・・・」"
]
},
{
"id": 22906,
"kind": "msg",
"jp": [
"「わかりました。",
"今夜は、なるべく起きて",
"注意しておきます」"
]
},
{
"id": 22907,
"kind": "msg",
"jp": [
"「ええ、そうして下さい。",
"僕も出来るだけのことはします」"
]
},
{
"id": 22908,
"kind": "msg",
"jp": [
"「すみません・・・。",
"見ず知らずの方に、そんな」"
]
},
{
"id": 22909,
"kind": "msg",
"jp": [
"「いえ、いいんです。",
"それじゃあ・・・」"
]
},
{
"id": 22910,
"kind": "msg",
"jp": [
"「はい、ありがとうございます。",
"あ、日織さんにもよろしく」"
]
},
{
"id": 22911,
"kind": "msg",
"jp": [
"「わかりました、伝えます」"
]
},
{
"id": 22912,
"kind": "msg",
"jp": [
"御陵さんに挨拶して、",
"台所へと戻る。"
]
},
{
"id": 22913,
"kind": "msg",
"jp": [
"「おかえりなさい。",
"もらってくれました?」"
]
},
{
"id": 22914,
"kind": "msg",
"jp": [
"「そうですか。",
"じゃ、俺らも食っちまいましょう」"
]
},
{
"id": 22915,
"kind": "msg",
"jp": [
"堅い廊下に座ってるので、だんだん",
"痛くなってくる・・・。"
]
},
{
"id": 22916,
"kind": "msg",
"jp": [
"音はほとんど聞こえなかったけど、",
"何か倒れたような響きが足下に",
"伝わってきた。"
]
},
{
"id": 22917,
"kind": "msg",
"jp": [
"（何かあったのか・・・?）"
]
},
{
"id": 22918,
"kind": "msg",
"jp": [
"扉の開く音がして、廊下に誰かが",
"出てきたのがわかった。"
]
},
{
"id": 22919,
"kind": "msg",
"jp": [
"「わっ・・・」"
]
},
{
"id": 22920,
"kind": "msg",
"jp": [
"何か倒れた・・・!",
"さっきより派手な音に驚いて",
"立ち上がった。"
]
},
{
"id": 22921,
"kind": "msg",
"jp": [
"「{和/なご}さん?",
"なんでそんなとこから・・・」"
]
},
{
"id": 22922,
"kind": "msg",
"jp": [
"「あ、日織!」"
]
},
{
"id": 22923,
"kind": "msg",
"jp": [
"「・・・晩飯、何だったら",
"食えそうです?」"
]
},
{
"id": 22924,
"kind": "msg",
"jp": [
"「食わねえと、本当に",
"参っちまいますぜ」"
]
},
{
"id": 22925,
"kind": "msg",
"jp": [
"台所へ来ると、日織はてきぱきした",
"手つきで食料庫から食材を取りだし、",
"調理を始める。"
]
},
{
"id": 22926,
"kind": "msg",
"jp": [
"「・・・とりあえず",
"3人前作りますから」"
]
},
{
"id": 22927,
"kind": "msg",
"jp": [
"「持ってってあげてもらえます?」"
]
},
{
"id": 22928,
"kind": "msg",
"jp": [
"ああ、そうか・・・。",
"暗石さんの分は、もういらないんだ。"
]
},
{
"id": 22929,
"kind": "msg",
"jp": [
"至近距離で聞こえた扉の音に",
"驚いて悲鳴を上げそうになる。"
]
},
{
"id": 22930,
"kind": "msg",
"jp": [
"（あ、空部屋が・・・",
"なんで・・・?）"
]
},
{
"id": 22931,
"kind": "msg",
"jp": [
"咄嗟に口元を手で押さえて声は",
"かみ殺したが、身体が金縛りに",
"あったように動かない・・・。"
]
},
{
"id": 22932,
"kind": "msg",
"jp": [
"（な・・なに・・・?）"
]
},
{
"id": 22933,
"kind": "msg",
"jp": [
"（内側から開いたのに・・・",
"誰も出て来ない・・・?）"
]
},
{
"id": 22934,
"kind": "msg",
"jp": [
"そろそろと壁に背をつけたまま",
"なんとか立ち上がった。"
]
},
{
"id": 22935,
"kind": "msg",
"jp": [
"空き部屋の扉は薄く開いているが",
"中から誰かが出てくる様子はない。"
]
},
{
"id": 22936,
"kind": "msg",
"jp": [
"（・・・・?）"
]
},
{
"id": 22937,
"kind": "msg",
"jp": [
"（僕がいるのに気付いて、",
"出て来ないのかな・・・）"
]
},
{
"id": 22938,
"kind": "msg",
"jp": [
"だとしたら、誰がいつから",
"この部屋の中に・・・。"
]
},
{
"id": 22939,
"kind": "msg",
"jp": [
"「え・・!?」"
]
},
{
"id": 22940,
"kind": "msg",
"jp": [
"突然響いてきた低い音に、",
"今度こそ思わず声を上げてしまう。"
]
},
{
"id": 22941,
"kind": "msg",
"jp": [
"（なんだ、あれ・・・?",
"時計・・・?）"
]
},
{
"id": 22942,
"kind": "msg",
"jp": [
"時計の音、みたいだ。",
"振り子時計の時報の音だと思うけど",
"なんで・・・?"
]
},
{
"id": 22943,
"kind": "msg",
"jp": [
"（玄関前のホールにある、",
"あのでっかいやつ・・・?）"
]
},
{
"id": 22944,
"kind": "msg",
"jp": [
"（なんでいきなり鳴ってるんだ・・・）"
]
},
{
"id": 22945,
"kind": "msg",
"jp": [
"確か、椿くんの話じゃ鳴らないように",
"止めたってことだったし・・・。"
]
},
{
"id": 22946,
"kind": "msg",
"jp": [
"第一、朝の8時から夜の8時までしか",
"元々鳴らないはずだったんじゃ・・・。"
]
},
{
"id": 22947,
"kind": "msg",
"jp": [
"（・・・止まった・・・）"
]
},
{
"id": 22948,
"kind": "msg",
"jp": [
"驚いたせいで、何回鳴ったかちゃんと",
"わからなかったけど、7、8回だった",
"ような気がする。"
]
},
{
"id": 22949,
"kind": "msg",
"jp": [
"（なんで突然鳴ったんだろう。",
"見に行った方がいいかな・・・）"
]
},
{
"id": 22950,
"kind": "msg",
"jp": [
"だけど、今ここを離れて御陵さんに",
"何かあったら洒落にならない。",
"逆に、じっとしてた方がいいかも。"
]
},
{
"id": 22951,
"kind": "msg",
"jp": [
"（・・・でも気になる・・・）"
]
},
{
"id": 22952,
"kind": "msg",
"jp": [
"（時計の方が事件に関係あるかも",
"しれないし・・・）"
]
},
{
"id": 22953,
"kind": "msg",
"jp": [
"そーっと出て、廊下の角まで行って",
"様子見てみようかな・・・。"
]
},
{
"id": 22954,
"kind": "msg",
"jp": [
"中途半端な位置で逡巡しながら",
"廊下を右、左とせわしなく見回す。"
]
},
{
"id": 22955,
"kind": "msg",
"jp": [
"（あ・・・誰かいる・・・!）"
]
},
{
"id": 22956,
"kind": "msg",
"jp": [
"足音が聞こえる。",
"しかも、近づいてくるような",
"気がする・・・。"
]
},
{
"id": 22957,
"kind": "msg",
"jp": [
"（ど、どうしよう?",
"誰だろう・・?）"
]
},
{
"id": 22958,
"kind": "msg",
"jp": [
"（このままじゃ鉢合わせるし",
"えーっと・・・）"
]
},
{
"id": 22959,
"kind": "msg",
"jp": [
"「・・・だ、誰!?」"
]
},
{
"id": 22960,
"kind": "msg",
"jp": [
"「{和/なご}さんですかい?」"
]
},
{
"id": 22961,
"kind": "msg",
"jp": [
"「日織・・・?」"
]
},
{
"id": 22962,
"kind": "msg",
"jp": [
"聞きなれた声に、安堵のあまり",
"全身から力が抜けた。"
]
},
{
"id": 22963,
"kind": "msg",
"jp": [
"「なんだ・・・",
"日織か・・・」"
]
},
{
"id": 22964,
"kind": "msg",
"jp": [
"「なにやってんです、",
"こんなところで?」"
]
},
{
"id": 22965,
"kind": "msg",
"jp": [
"「日織こそ・・・。",
"もしかして時計見に行ってた?」"
]
},
{
"id": 22966,
"kind": "msg",
"jp": [
"「ええ、いきなり鳴り出したんで",
"何事かと思って」"
]
},
{
"id": 22967,
"kind": "msg",
"jp": [
"「どうだったの?」"
]
},
{
"id": 22968,
"kind": "msg",
"jp": [
"「8時になってました」"
]
},
{
"id": 22969,
"kind": "msg",
"jp": [
"「時間が狂ってたんですよ。",
"針が8時指してたんです」"
]
},
{
"id": 22970,
"kind": "msg",
"jp": [
"「当然、鳴るようにしてありました。",
"時間がずれてたのは、古いから狂った",
"だけかもしれませんが・・・」"
]
},
{
"id": 22971,
"kind": "msg",
"jp": [
"「で、あんたは何をやってんです」"
]
},
{
"id": 22972,
"kind": "msg",
"jp": [
"「え、あの・・・",
"そこの・・・空き部屋の・・・」"
]
},
{
"id": 22973,
"kind": "msg",
"jp": [
"「空き部屋?",
"誰もいねえでしょう、あの部屋は」"
]
},
{
"id": 22974,
"kind": "msg",
"jp": [
"「それが、いたんだよ!",
"なんか突然中から開いて・・・」"
]
},
{
"id": 22975,
"kind": "msg",
"jp": [
"「・・・で、でも、誰も出て",
"来なかったんだけど・・・」"
]
},
{
"id": 22976,
"kind": "msg",
"jp": [
"僕の話を聞いて、日織は{怪訝/けげん}そうに",
"眉をしかめた。"
]
},
{
"id": 22977,
"kind": "msg",
"jp": [
"「{和/なご}さんがいるのに気付いて",
"部屋から出なかったってこと",
"ですかね?」"
]
},
{
"id": 22978,
"kind": "msg",
"jp": [
"「・・・かもしれない」"
]
},
{
"id": 22979,
"kind": "msg",
"jp": [
"「まあ、ちょいと見てみますか」"
]
},
{
"id": 22980,
"kind": "msg",
"jp": [
"「ええぇ!?」"
]
},
{
"id": 22981,
"kind": "msg",
"jp": [
"「だって放っとくわけにゃ",
"いかねえでしょう」"
]
},
{
"id": 22982,
"kind": "msg",
"jp": [
"「そ・・りゃ、まあ・・・」"
]
},
{
"id": 22983,
"kind": "msg",
"jp": [
"「でも危ないよ、",
"まだ誰かいるかも・・・」"
]
},
{
"id": 22984,
"kind": "msg",
"jp": [
"「なおさら放っとけねえですよ。",
"大丈夫、のぞくだけにします」"
]
},
{
"id": 22985,
"kind": "msg",
"jp": [
"「{和/なご}さんは、後ろにいて",
"誰も来ねえか見張ってて下さい」"
]
},
{
"id": 22986,
"kind": "msg",
"jp": [
"日織は壁際に身を寄せながら、",
"薄く開いた扉をそっと開いてみる。"
]
},
{
"id": 22987,
"kind": "msg",
"jp": [
"「・・・どう・・・?」"
]
},
{
"id": 22988,
"kind": "msg",
"jp": [
"「暗くてよく見えませんが、",
"どうもベランダが開いてる",
"みてえですね・・・」"
]
},
{
"id": 22989,
"kind": "msg",
"jp": [
"「ベランダ?」"
]
},
{
"id": 22990,
"kind": "msg",
"jp": [
"言われてみれば、雨や風の音が",
"やけに大きく聞こえる。"
]
},
{
"id": 22991,
"kind": "msg",
"jp": [
"「ここからじゃよく",
"見えねえなあ・・・」"
]
},
{
"id": 22992,
"kind": "msg",
"jp": [
"「は、入っちゃ駄目だって!",
"まだ誰か隠れてるかもしれないし",
"それこそベランダにいるかも・・」"
]
},
{
"id": 22993,
"kind": "msg",
"jp": [
"「・・・踏み込むのは",
"やべえですかね」"
]
},
{
"id": 22994,
"kind": "msg",
"jp": [
"「絶対危ないってば!",
"調べるなら明るくなってからのが",
"いいって!」"
]
},
{
"id": 22995,
"kind": "msg",
"jp": [
"「そうですね。",
"ここは閉めときますか」"
]
},
{
"id": 22996,
"kind": "msg",
"jp": [
"そう言って日織は身を退いて",
"空き部屋の扉を閉めた。"
]
}
]