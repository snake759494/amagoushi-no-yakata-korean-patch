[
{
"id": 21355,
"kind": "msg",
"jp": [
"「何がヒットしたの?」"
]
},
{
"id": 21356,
"kind": "msg",
"jp": [
"「山降りてから、",
"自分で検索してみろ」"
]
},
{
"id": 21357,
"kind": "msg",
"jp": [
"「椿くんって兄弟いる?」"
]
},
{
"id": 21358,
"kind": "msg",
"jp": [
"「妹ばっか、3人」"
]
},
{
"id": 21359,
"kind": "msg",
"jp": [
"「・・・にぎやかそうだね」"
]
},
{
"id": 21360,
"kind": "msg",
"jp": [
"「にぎやかなんて",
"もんじゃねーよ!」"
]
},
{
"id": 21361,
"kind": "msg",
"jp": [
"「家の中女だらけって",
"どんだけ肩身が狭いか・・・」"
]
},
{
"id": 21362,
"kind": "msg",
"jp": [
"「あ、うん。",
"うちなんか姉1人でも",
"大変だし・・・」"
]
},
{
"id": 21363,
"kind": "msg",
"jp": [
"「それが3人いるとこ",
"想像してみろ」"
]
},
{
"id": 21364,
"kind": "msg",
"jp": [
"「・・・・無理・・・」"
]
},
{
"id": 21365,
"kind": "msg",
"jp": [
"「なあ、なんか変な汗",
"かいてるぞ、お前」"
]
},
{
"id": 21366,
"kind": "msg",
"jp": [
"「3人もいたら保たない・・・",
"僕、絶対保たない・・・」"
]
},
{
"id": 21367,
"kind": "msg",
"jp": [
"「・・・わ、わかった。",
"悪かった、もういいから」"
]
},
{
"id": 21368,
"kind": "msg",
"jp": [
"「落ち着け、",
"お前の姉貴は1人だけだ」"
]
},
{
"id": 21369,
"kind": "msg",
"jp": [
"「・・・椿くん?」"
]
},
{
"id": 21370,
"kind": "msg",
"jp": [
"「ええ、やみませんね。",
"最悪の天気ですね。",
"私のせいではありませんが」"
]
},
{
"id": 21371,
"kind": "msg",
"jp": [
"「え、いや、うん」"
]
},
{
"id": 21372,
"kind": "msg",
"jp": [
"どうしたんだろう・・・。",
"やっぱり全然やまないから",
"イラついてるのかな。"
]
},
{
"id": 21373,
"kind": "msg",
"jp": [
"「・・・存じません」"
]
},
{
"id": 21374,
"kind": "msg",
"jp": [
"「こ、この天気じゃやっぱり",
"長くかかるのかな」"
]
},
{
"id": 21375,
"kind": "msg",
"jp": [
"「知らねーっつってんだろ、",
"オレのせいじゃねーよ!」"
]
},
{
"id": 21376,
"kind": "msg",
"jp": [
"「音と灯りには気が付きました。",
"怪しいので部屋から出て見に行く",
"気にはなりませんでしたが」"
]
},
{
"id": 21377,
"kind": "msg",
"jp": [
"「うん、それはその方がいいと思う。",
"うっかりつられて襲われたりしちゃ",
"意味ないし・・・」"
]
},
{
"id": 21378,
"kind": "msg",
"jp": [
"「・・・温室内には誰も?」"
]
},
{
"id": 21379,
"kind": "msg",
"jp": [
"「うん、いなかったよ」"
]
},
{
"id": 21380,
"kind": "msg",
"jp": [
"・・・本当に、なんだったんだろう",
"あれは・・・。"
]
},
{
"id": 21381,
"kind": "msg",
"jp": [
"「・・・ありませんし、",
"興味もございません」"
]
},
{
"id": 21382,
"kind": "msg",
"jp": [
"「いや、して欲しいって",
"いう話じゃないんだけど」"
]
},
{
"id": 21383,
"kind": "msg",
"jp": [
"「当たり前だっ!!",
"したけりゃ自分でしとけ!」"
]
},
{
"id": 21384,
"kind": "msg",
"jp": [
"「僕もしたくないよっ!?」"
]
},
{
"id": 21385,
"kind": "msg",
"jp": [
"・・・まあ、1人ずっとしてる人が",
"いるんだけど・・・。"
]
},
{
"id": 21386,
"kind": "msg",
"jp": [
"「あいにく外国語はさっぱり」"
]
},
{
"id": 21387,
"kind": "msg",
"jp": [
"「招待状に書かれて",
"おりました」"
]
},
{
"id": 21388,
"kind": "msg",
"jp": [
"それがどうしたという",
"口調だった・・・。"
]
},
{
"id": 21389,
"kind": "msg",
"jp": [
"「・・・おそらく偽物",
"ではないかと思います」"
]
},
{
"id": 21390,
"kind": "msg",
"jp": [
"「看板が置かれるのでしたら",
"土砂崩れの起きた向こう側かと」"
]
},
{
"id": 21391,
"kind": "msg",
"jp": [
"「芸能事務所です」"
]
},
{
"id": 21392,
"kind": "msg",
"jp": [
"「えーと、どんな・・・」"
]
},
{
"id": 21393,
"kind": "msg",
"jp": [
"「ごく一般的な芸能事務所です」"
]
},
{
"id": 21394,
"kind": "msg",
"jp": [
"「あまり詳しくは存じません。",
"斑井様の所属事務所としか」"
]
},
{
"id": 21395,
"kind": "msg",
"jp": [
"「・・・ごく一般的な",
"芸能事務所ですが」"
]
},
{
"id": 21396,
"kind": "msg",
"jp": [
"あまり話したくなさそうだ。"
]
},
{
"id": 21397,
"kind": "msg",
"jp": [
"「存じません」"
]
},
{
"id": 21398,
"kind": "msg",
"jp": [
"「私は詳しいことは",
"何も存じませんので」"
]
},
{
"id": 21399,
"kind": "msg",
"jp": [
"なんだか語りたく",
"なさそうだ・・・。"
]
},
{
"id": 21400,
"kind": "msg",
"jp": [
"「・・・っと、失礼。",
"お好きなのですか」"
]
},
{
"id": 21401,
"kind": "msg",
"jp": [
"「好き・・・というか、",
"姉ちゃんがよく買ってくるけど」"
]
},
{
"id": 21402,
"kind": "msg",
"jp": [
"「自分で買われるわけでは",
"ないのですね」"
]
},
{
"id": 21403,
"kind": "msg",
"jp": [
"「うん、まあ。",
"・・・なんで?」"
]
},
{
"id": 21404,
"kind": "msg",
"jp": [
"「いえ、別に」"
]
},
{
"id": 21405,
"kind": "msg",
"jp": [
"なんなんだろう・・・。"
]
},
{
"id": 21406,
"kind": "msg",
"jp": [
"「まだ最後まで出来上がって",
"いないようですので」"
]
},
{
"id": 21407,
"kind": "msg",
"jp": [
"「ああ、そっか・・・」"
]
},
{
"id": 21408,
"kind": "msg",
"jp": [
"「・・・よくご存知ですね。",
"確かに一場面だけ出演してますが」"
]
},
{
"id": 21409,
"kind": "msg",
"jp": [
"「ですが私は、不良グループの中の",
"1人でほんの脇役でしたよ?」"
]
},
{
"id": 21410,
"kind": "msg",
"jp": [
"「その『白夜』の打ち上げの時に、",
"今ここにいる人達が全員揃ってたって",
"話を聞いたんだけど・・・」"
]
},
{
"id": 21411,
"kind": "msg",
"jp": [
"「・・・マジで?",
"あー、いや、本当ですか?」"
]
},
{
"id": 21412,
"kind": "msg",
"jp": [
"「・・・暗石さま、御陵さまは",
"出演者ですからいらしてました」"
]
},
{
"id": 21413,
"kind": "msg",
"jp": [
"「双子の・・・おそらく鈴奈さまも",
"おられたと思います」"
]
},
{
"id": 21414,
"kind": "msg",
"jp": [
"「えーと・・・",
"ああ、おられました、確かに」"
]
},
{
"id": 21415,
"kind": "msg",
"jp": [
"「斑井さんとか那須さんは",
"いたの覚えてない?」"
]
},
{
"id": 21416,
"kind": "msg",
"jp": [
"「・・・そう言えば妙に体格の",
"いい方が混ざっていたような。",
"多分あれがそうだったのかと・・」"
]
},
{
"id": 21417,
"kind": "msg",
"jp": [
"「斑井さまは、ちょっと記憶に",
"ありませんが・・・いても不思議は",
"ない人ですから・・・」"
]
},
{
"id": 21418,
"kind": "msg",
"jp": [
"「うん、僕もそう聞いた」"
]
},
{
"id": 21419,
"kind": "msg",
"jp": [
"「なら、いらしたんでしょう」"
]
},
{
"id": 21420,
"kind": "msg",
"jp": [
"「・・・あったんですね。",
"このメンバーが一堂に会したことが",
"以前にも・・・」"
]
},
{
"id": 21421,
"kind": "msg",
"jp": [
"「いえ、存じませんが」"
]
},
{
"id": 21422,
"kind": "msg",
"jp": [
"「全然?」"
]
},
{
"id": 21423,
"kind": "msg",
"jp": [
"「放映当時、私はまだ",
"生まれておりませんので」"
]
},
{
"id": 21424,
"kind": "msg",
"jp": [
"「あ、そっか・・・」"
]
},
{
"id": 21425,
"kind": "msg",
"jp": [
"「・・・いえ、存じません」"
]
},
{
"id": 21426,
"kind": "msg",
"jp": [
"「・・・いいえ?",
"存じませんが・・・」"
]
},
{
"id": 21427,
"kind": "msg",
"jp": [
"「あ、高遠ね・・・",
"残念ながら未読でございます」"
]
},
{
"id": 21428,
"kind": "msg",
"jp": [
"「・・・ご存じなんですか?」"
]
},
{
"id": 21429,
"kind": "msg",
"jp": [
"「ううん、ゲームらしいって",
"ことくらいしか・・・」"
]
},
{
"id": 21430,
"kind": "msg",
"jp": [
"「わかる人にしか",
"わからない名作です」"
]
},
{
"id": 21431,
"kind": "msg",
"jp": [
"「そ、そうなの・・・?」"
]
},
{
"id": 21432,
"kind": "msg",
"jp": [
"「中古ショップでもなかなか",
"出回っておりませんので",
"入手は困難ですが」"
]
},
{
"id": 21433,
"kind": "msg",
"jp": [
"「・・・触れてはならない話と",
"うかがっております」"
]
},
{
"id": 21434,
"kind": "msg",
"jp": [
"「業界には禁忌という",
"ものがあるのです」"
]
},
{
"id": 21435,
"kind": "msg",
"jp": [
"「左様ですね」"
]
},
{
"id": 21436,
"kind": "msg",
"jp": [
"会話が続かない・・・。"
]
},
{
"id": 21437,
"kind": "msg",
"jp": [
"「まさか・・・",
"入りません、もちろん」"
]
},
{
"id": 21438,
"kind": "msg",
"jp": [
"「左様ですか。",
"私は2日目以降行っておりませんが」"
]
},
{
"id": 21439,
"kind": "msg",
"jp": [
"「ああ、あれが最後だったの?」"
]
},
{
"id": 21440,
"kind": "msg",
"jp": [
"「ずっと部屋におりますので」"
]
},
{
"id": 21441,
"kind": "msg",
"jp": [
"「はい、使用されておりません",
"でしたので」"
]
},
{
"id": 21442,
"kind": "msg",
"jp": [
"「ベランダは女性陣のいらっしゃる",
"あちら側にしかございません」"
]
},
{
"id": 21443,
"kind": "msg",
"jp": [
"「なんでだろうね」"
]
},
{
"id": 21444,
"kind": "msg",
"jp": [
"「そこまでは存じません」"
]
},
{
"id": 21445,
"kind": "msg",
"jp": [
"「・・・現在、一部本来の調度品で",
"ないものが含まれておりますが」"
]
},
{
"id": 21446,
"kind": "msg",
"jp": [
"「あの巨大さはいかがなものかと」"
]
},
{
"id": 21447,
"kind": "msg",
"jp": [
"「ああ、てるてる坊主?",
"でもまあ、効き目あるかもしれないし」"
]
},
{
"id": 21448,
"kind": "msg",
"jp": [
"「・・・あまり期待出来ません」"
]
},
{
"id": 21449,
"kind": "msg",
"jp": [
"「まあ、やんでないけど・・・」"
]
},
{
"id": 21450,
"kind": "msg",
"jp": [
"「あんれは後から建て増された",
"ものだそうです」"
]
},
{
"id": 21451,
"kind": "msg",
"jp": [
"「はい、そのようにうかがって",
"おります」"
]
},
{
"id": 21452,
"kind": "msg",
"jp": [
"「あまり入りませんので",
"よく存じませんが」"
]
},
{
"id": 21453,
"kind": "msg",
"jp": [
"「・・・あ、そうなの」"
]
},
{
"id": 21454,
"kind": "msg",
"jp": [
"まあ、本当の執事でもないわけだし",
"そんなもんかな・・・。"
]
},
{
"id": 21455,
"kind": "msg",
"jp": [
"「使用しておりません」"
]
},
{
"id": 21456,
"kind": "msg",
"jp": [
"まあ、そうだよな・・・。"
]
},
{
"id": 21457,
"kind": "msg",
"jp": [
"「みだりに触って壊さないように",
"して下さい」"
]
},
{
"id": 21458,
"kind": "msg",
"jp": [
"「え、高いの?」"
]
},
{
"id": 21459,
"kind": "msg",
"jp": [
"「おそらく」"
]
},
{
"id": 21460,
"kind": "msg",
"jp": [
"「当主の趣味です」"
]
},
{
"id": 21461,
"kind": "msg",
"jp": [
"ずいぶん読書家なんだなあ。"
]
},
{
"id": 21462,
"kind": "msg",
"jp": [
"「あまり漁らないで下さい」"
]
},
{
"id": 21463,
"kind": "msg",
"jp": [
"「・・私に部屋は本来",
"当主の寝室でございます」"
]
},
{
"id": 21464,
"kind": "msg",
"jp": [
"「客間の方はほぼ同じ内装ですが。",
"・・・ああ、一柳さま方の",
"部屋は別ですが」"
]
},
{
"id": 21465,
"kind": "msg",
"jp": [
"「別って?」"
]
},
{
"id": 21466,
"kind": "msg",
"jp": [
"「海外にあった頃は使用人部屋",
"として使用されていたそうです」"
]
},
{
"id": 21467,
"kind": "msg",
"jp": [
"「あれは当主の部屋です」"
]
},
{
"id": 21468,
"kind": "msg",
"jp": [
"「ああ、やっぱり。",
"なんで開かずの間って・・・」"
]
},
{
"id": 21469,
"kind": "msg",
"jp": [
"「・・・かつて封印されていたそうで」"
]
},
{
"id": 21470,
"kind": "msg",
"jp": [
"「何かあったのでしょうね。",
"詳しくは存じませんが」"
]
},
{
"id": 21471,
"kind": "msg",
"jp": [
"「あまりお入りになりませんように」"
]
},
{
"id": 21472,
"kind": "msg",
"jp": [
"「う、うん、わかった・・・」"
]
},
{
"id": 21473,
"kind": "msg",
"jp": [
"「納戸・・・",
"ああ、ございます」"
]
},
{
"id": 21474,
"kind": "msg",
"jp": [
"「大したものは置いて",
"ありませんが」"
]
},
{
"id": 21475,
"kind": "msg",
"jp": [
"「倉庫とボイラーがあるだけで",
"大して広くもありません」"
]
},
{
"id": 21476,
"kind": "msg",
"jp": [
"「なんか迷路みたいに",
"なってるやつ」"
]
},
{
"id": 21477,
"kind": "msg",
"jp": [
"「・・・それは・・・",
"私も存じませんでしたが・・・」"
]
},
{
"id": 21478,
"kind": "msg",
"jp": [
"「使用されておりません」"
]
},
{
"id": 21479,
"kind": "msg",
"jp": [
"やっぱり使われてないのか。",
"蓋閉まってたもんな。"
]
},
{
"id": 21480,
"kind": "msg",
"jp": [
"「すべて海外の推理作家の",
"名前ですがなにか」"
]
},
{
"id": 21481,
"kind": "msg",
"jp": [
"「あいにく、ございません」"
]
},
{
"id": 21482,
"kind": "msg",
"jp": [
"「日織さまには、",
"国名シリーズというのが有名だと",
"勧められましたが・・・」"
]
},
{
"id": 21483,
"kind": "msg",
"jp": [
"「あんまり好きじゃない",
"ような内容だったの?」"
]
},
{
"id": 21484,
"kind": "msg",
"jp": [
"「翻訳物は苦手なんです」"
]
},
{
"id": 21485,
"kind": "msg",
"jp": [
"内容以前にとっつきにくいと",
"いうことらしい。"
]
},
{
"id": 21486,
"kind": "msg",
"jp": [
"「・・・冷蔵庫にございました」"
]
},
{
"id": 21487,
"kind": "msg",
"jp": [
"「う、うん、それ」"
]
},
{
"id": 21488,
"kind": "msg",
"jp": [
"なんか話したくなさそうだ・・・。"
]
},
{
"id": 21489,
"kind": "msg",
"jp": [
"「わかりません。",
"そのような知識はありません」"
]
},
{
"id": 21490,
"kind": "msg",
"jp": [
"「・・・私には意図がわかりません」"
]
},
{
"id": 21491,
"kind": "msg",
"jp": [
"「ただ・・・",
"薔薇の絵画は応接室で見たような",
"気がします」"
]
},
{
"id": 21492,
"kind": "msg",
"jp": [
"「・・・この館にあったかどうか",
"わかんない?」"
]
},
{
"id": 21493,
"kind": "msg",
"jp": [
"「把握しておりません」"
]
},
{
"id": 21494,
"kind": "msg",
"jp": [
"「・・・おそらく」"
]
},
{
"id": 21495,
"kind": "msg",
"jp": [
"「いつ持ち出されたんだろう」"
]
},
{
"id": 21496,
"kind": "msg",
"jp": [
"「オレに聞かれても知らねえよ!」"
]
},
{
"id": 21497,
"kind": "msg",
"jp": [
"「あれが何か?」"
]
},
{
"id": 21498,
"kind": "msg",
"jp": [
"「・・・私が昼頃に到着した",
"ときにはまだありませんでした」"
]
},
{
"id": 21499,
"kind": "msg",
"jp": [
"「・・・記憶にありません」"
]
},
{
"id": 21500,
"kind": "msg",
"jp": [
"「そっか、じゃあ違うのかな」"
]
},
{
"id": 21501,
"kind": "msg",
"jp": [
"「さようでございます。",
"外線に通じている電話は",
"ございません」"
]
},
{
"id": 21502,
"kind": "msg",
"jp": [
"「なんでないの?」"
]
},
{
"id": 21503,
"kind": "msg",
"jp": [
"「ノイズがひどいのは",
"雨のせいかと」"
]
},
{
"id": 21504,
"kind": "msg",
"jp": [
"「じゃあ、元はあそこまで",
"ひどくはない?」"
]
},
{
"id": 21505,
"kind": "msg",
"jp": [
"「・・・あれよりはマシです」"
]
},
{
"id": 21506,
"kind": "msg",
"jp": [
"マシって程度なのか・・・。"
]
},
{
"id": 21507,
"kind": "msg",
"jp": [
"「1階にある大時計ってさ、",
"音が鳴らないようにとか調節",
"したのは椿くんなの?」"
]
},
{
"id": 21508,
"kind": "msg",
"jp": [
"「はい、それが何か?」"
]
},
{
"id": 21509,
"kind": "msg",
"jp": [
"「・・・えーと、その調節の",
"仕方って元から知ってたの?」"
]
},
{
"id": 21510,
"kind": "msg",
"jp": [
"「調節のためのツマミが時計の",
"側面にありますから、見れば誰でも",
"出来ることかと」"
]
},
{
"id": 21511,
"kind": "msg",
"jp": [
"「・・・みだりに触らない",
"ようにして下さい」"
]
},
{
"id": 21512,
"kind": "msg",
"jp": [
"「まったくございません。",
"当家の物ではないようです」"
]
},
{
"id": 21513,
"kind": "msg",
"jp": [
"「温室にさ、長い釘が置いて",
"あったんだけど・・・」"
]
},
{
"id": 21514,
"kind": "msg",
"jp": [
"「釘とは、どのような?」"
]
},
{
"id": 21515,
"kind": "msg",
"jp": [
"「五寸釘。",
"こんな大きいやつ」"
]
},
{
"id": 21516,
"kind": "msg",
"jp": [
"「・・・当家にはそのような",
"物は保管しておりません」"
]
},
{
"id": 21517,
"kind": "msg",
"jp": [
"「そっか・・・。",
"じゃあ犯人が持ち込んだんだ」"
]
},
{
"id": 21518,
"kind": "msg",
"jp": [
"「婦人用の、という意味ですか」"
]
},
{
"id": 21519,
"kind": "msg",
"jp": [
"「うん、そうだと思う。",
"この館にあったものかな?」"
]
},
{
"id": 21520,
"kind": "msg",
"jp": [
"じゃあ犯人が持ってきたもの",
"なのかな・・・。"
]
},
{
"id": 21521,
"kind": "msg",
"jp": [
"「手斧、ですか・・・。",
"当家では使用していないものと",
"存じますが」"
]
},
{
"id": 21522,
"kind": "msg",
"jp": [
"「なかったんだ?",
"じゃあ、犯人が持って来たのか」"
]
},
{
"id": 21523,
"kind": "msg",
"jp": [
"「・・・そのようなもの",
"私は存じませんが」"
]
},
{
"id": 21524,
"kind": "msg",
"jp": [
"「当家の備品ではございません」"
]
},
{
"id": 21525,
"kind": "msg",
"jp": [
"「・・・そりゃそうだろうね」"
]
},
{
"id": 21526,
"kind": "msg",
"jp": [
"「見せてはいただきましたが",
"どういう物かは存じません」"
]
},
{
"id": 21527,
"kind": "msg",
"jp": [
"「何枚くらいあるの?」"
]
},
{
"id": 21528,
"kind": "msg",
"jp": [
"「そこまでは覚えておりません」"
]
},
{
"id": 21529,
"kind": "msg",
"jp": [
"「はい、私は事務所に送って",
"もらいました」"
]
},
{
"id": 21530,
"kind": "msg",
"jp": [
"「山の中ですから蛇くらい",
"いても不思議はありません」"
]
},
{
"id": 21531,
"kind": "msg",
"jp": [
"「・・・そうなんだけど」"
]
},
{
"id": 21532,
"kind": "msg",
"jp": [
"「毒はないでしょうから",
"近寄らなければ大丈夫です」"
]
},
{
"id": 21533,
"kind": "msg",
"jp": [
"「・・・それなりには」"
]
},
{
"id": 21534,
"kind": "msg",
"jp": [
"「召し上がりたいなら",
"台所にございます」"
]
},
{
"id": 21535,
"kind": "msg",
"jp": [
"「あ、うん、ありがとう」"
]
},
{
"id": 21536,
"kind": "msg",
"jp": [
"「あれは・・・",
"装飾品でしたが額縁が",
"破損しておりますので」"
]
},
{
"id": 21537,
"kind": "msg",
"jp": [
"「じゃあ、元はどこかに",
"飾ってあったんだ?」"
]
},
{
"id": 21538,
"kind": "msg",
"jp": [
"「娯楽室に」"
]
},
{
"id": 21539,
"kind": "msg",
"jp": [
"「・・・そのようなことを",
"しでかしそうな人は1人しか",
"おられませんね・・・」"
]
},
{
"id": 21540,
"kind": "msg",
"jp": [
"さすが、よくわかってる。"
]
},
{
"id": 21541,
"kind": "msg",
"jp": [
"「いえ、ございません」"
]
},
{
"id": 21542,
"kind": "msg",
"jp": [
"「・・・さようです」"
]
},
{
"id": 21543,
"kind": "msg",
"jp": [
"「気がすんだら元あった場所に",
"戻しておいて下さい」"
]
},
{
"id": 21544,
"kind": "msg",
"jp": [
"「あ、うん、ごめん」"
]
},
{
"id": 21545,
"kind": "msg",
"jp": [
"「いえ・・・",
"存じませんが」"
]
},
{
"id": 21546,
"kind": "msg",
"jp": [
"芸能人なら誰でも知ってるって",
"わけじゃないんだな。"
]
},
{
"id": 21547,
"kind": "msg",
"jp": [
"「・・・当家では見覚えは",
"ないようですが・・・」"
]
},
{
"id": 21548,
"kind": "msg",
"jp": [
"「あ、やっぱりそう?」"
]
},
{
"id": 21549,
"kind": "msg",
"jp": [
"「何が入ってるんです?」"
]
},
{
"id": 21550,
"kind": "msg",
"jp": [
"「・・・ふざけんな、くそ」"
]
},
{
"id": 21551,
"kind": "msg",
"jp": [
"むかついたらしい・・・。"
]
},
{
"id": 21552,
"kind": "msg",
"jp": [
"「なんだとぉ!?",
"あ、いや・・・」"
]
},
{
"id": 21553,
"kind": "msg",
"jp": [
"「・・・それは、撃ってなくなった",
"ものなんでしょうか」"
]
},
{
"id": 21554,
"kind": "msg",
"jp": [
"「わかんないけど、矢だけ持って",
"行ってもしょうがないんじゃ・・・」"
]
},
{
"id": 21555,
"kind": "msg",
"jp": [
"あまり想像したくないけど・・・。"
]
},
{
"id": 21556,
"kind": "msg",
"jp": [
"「・・・・・それは・・",
"以前は娯楽室に飾られていた",
"品ではないかと・・・」"
]
},
{
"id": 21557,
"kind": "msg",
"jp": [
"「飾りじゃなかったみたいだね・・」"
]
},
{
"id": 21558,
"kind": "msg",
"jp": [
"「万年筆ですか・・・?」"
]
},
{
"id": 21559,
"kind": "msg",
"jp": [
"「・・・どこかで見た気も",
"しますが覚えておりません」"
]
},
{
"id": 21560,
"kind": "msg",
"jp": [
"「・・・私は存じませんが」"
]
},
{
"id": 21561,
"kind": "msg",
"jp": [
"「・・・当主が大事になさっている",
"品ですので触られませんように」"
]
},
{
"id": 21562,
"kind": "msg",
"jp": [
"なんか不気味だし、触りたいわけじゃ",
"なかったんだけど・・・。"
]
},
{
"id": 21563,
"kind": "msg",
"jp": [
"「ああ・・・",
"あのデッキは以前から不具合が",
"ございましたので」"
]
},
{
"id": 21564,
"kind": "msg",
"jp": [
"「時々、取り出しボタンがきかなく",
"なることがありました。",
"それは何のテープですか?」"
]
},
{
"id": 21565,
"kind": "msg",
"jp": [
"「・・・崖崩れのニュースが",
"録音してあるんだけど」"
]
},
{
"id": 21566,
"kind": "msg",
"jp": [
"「なんだそりゃ!?",
"またどっかで崩れ・・・あ、いや」"
]
},
{
"id": 21567,
"kind": "msg",
"jp": [
"「えー、なぜそのようなものを",
"わざわざ録音して・・・」"
]
},
{
"id": 21568,
"kind": "msg",
"jp": [
"「・・・一柳さま。",
"そのニュースは・・・もしかして",
"本物ではない・・・?」"
]
},
{
"id": 21569,
"kind": "msg",
"jp": [
"「僕も、偽物のような気がする」"
]
},
{
"id": 21570,
"kind": "msg",
"jp": [
"「・・・そうですか。",
"なるほど・・・」"
]
},
{
"id": 21571,
"kind": "msg",
"jp": [
"「・・・つまり犯人の当初の予定では",
"それで我々をここに足止めしておく",
"つもりだったと・・・」"
]
},
{
"id": 21572,
"kind": "msg",
"jp": [
"「多分、そうじゃないかな」"
]
},
{
"id": 21573,
"kind": "msg",
"jp": [
"椿くんは、難しい顔で黙り込んだ・・。"
]
},
{
"id": 21574,
"kind": "msg",
"jp": [
"「・・・あいにくですが、",
"植物にはうといもので」"
]
},
{
"id": 21575,
"kind": "msg",
"jp": [
"まあ、花の名前に詳しそうな",
"感じはしないもんな・・・。"
]
},
{
"id": 21576,
"kind": "msg",
"jp": [
"「・・・なぜ突然そんなことを?」"
]
},
{
"id": 21577,
"kind": "msg",
"jp": [
"「那須さんが、山道の途中で見た",
"車の中にそれの飾りみたいなのが",
"吊ってあったって言ってて・・・」"
]
},
{
"id": 21578,
"kind": "msg",
"jp": [
"「ずいぶんな趣味の車ですね」"
]
},
{
"id": 21579,
"kind": "msg",
"jp": [
"「・・・そういうの好きそうな人に",
"心当たりってない?」"
]
},
{
"id": 21580,
"kind": "msg",
"jp": [
"「そのような特殊な趣味の",
"知人はおりません」"
]
},
{
"id": 21581,
"kind": "msg",
"jp": [
"「一柳さまもですか」"
]
},
{
"id": 21582,
"kind": "msg",
"jp": [
"「少々お待ちを」"
]
},
{
"id": 21583,
"kind": "msg",
"jp": [
"椿くんは上着の内ポケットに",
"手を突っ込みメモを取り出した。"
]
},
{
"id": 21584,
"kind": "msg",
"jp": [
"「読み上げますので、",
"ご自分でお控えください」"
]
},
{
"id": 21585,
"kind": "msg",
"jp": [
"「え?",
"あ、ま、待って」"
]
},
{
"id": 21586,
"kind": "msg",
"jp": [
"慌てて手帳を引っ張り出す。",
"ペンを持つと椿くんはすぐに",
"メモを読み上げる。"
]
},
{
"id": 21587,
"kind": "msg",
"jp": [
"「・・・以上でございます」"
]
},
{
"id": 21588,
"kind": "msg",
"jp": [
"「あの、それ、何・・・?」"
]
},
{
"id": 21589,
"kind": "msg",
"jp": [
"「ヒントだそうで。",
"正しいアルファベットを正しい順に",
"並べれば何か言葉になるのだとか」"
]
},
{
"id": 21590,
"kind": "msg",
"jp": [
"「まあ・・・",
"現当主のほんの余興でございますが」"
]
},
{
"id": 21591,
"kind": "msg",
"jp": [
"「なるほど、",
"そういう暗号なんだ・・・」"
]
},
{
"id": 21592,
"kind": "msg",
"jp": [
"「正しいアルファベットって",
"ことは正しくないのもあるの?」"
]
},
{
"id": 21593,
"kind": "msg",
"jp": [
"「必要なのは8文字だけで",
"あとはフェイクだそうです」"
]
},
{
"id": 21594,
"kind": "msg",
"jp": [
"「8文字だね、ありがと」"
]
},
{
"id": 21595,
"kind": "msg",
"jp": [
"「・・・けど、このヒント",
"何が何だかさっぱり・・・」"
]
},
{
"id": 21596,
"kind": "msg",
"jp": [
"「ええ、もう、私も",
"未だにわかりませんから」"
]
},
{
"id": 21597,
"kind": "msg",
"jp": [
"「部屋の名前がどういう意味か",
"知っていれば簡単だそうですがね。",
"知るかってんだよ、んなもん」"
]
},
{
"id": 21598,
"kind": "msg",
"jp": [
"「・・・椿くん、地が」"
]
},
{
"id": 21599,
"kind": "msg",
"jp": [
"「あー、失礼。",
"えーと、それとですね・・・」"
]
},
{
"id": 21600,
"kind": "msg",
"jp": [
"「アルファベットが彫ってある鍵は",
"2階のものだけでございます」"
]
},
{
"id": 21601,
"kind": "msg",
"jp": [
"「2階だけ、うん」"
]
},
{
"id": 21602,
"kind": "msg",
"jp": [
"「ただし、2階でも",
"収納の鍵には文字はございません」"
]
},
{
"id": 21603,
"kind": "msg",
"jp": [
"「てことは、えーと・・・",
"人の使う部屋だけってことかな。",
"客間とか・・・」"
]
},
{
"id": 21604,
"kind": "msg",
"jp": [
"「あ、あと、椿くんの",
"部屋の鍵に彫ってある文字は?」"
]
},
{
"id": 21605,
"kind": "msg",
"jp": [
"「私の部屋は『T』でございます」"
]
},
{
"id": 21606,
"kind": "msg",
"jp": [
"「Tか、ありがとう。",
"頑張ってみるよ」"
]
},
{
"id": 21607,
"kind": "msg",
"jp": [
"「・・・もし解けても",
"私には教えないで下さい」"
]
},
{
"id": 21608,
"kind": "msg",
"jp": [
"「一応、まだ諦めてませんので」"
]
},
{
"id": 21609,
"kind": "msg",
"jp": [
"「一柳さまがお持ちのものと",
"そう大差ないかと」"
]
},
{
"id": 21610,
"kind": "msg",
"jp": [
"「・・・どのみち、",
"それであれ電波は通じて",
"おりませんし」"
]
},
{
"id": 21611,
"kind": "msg",
"jp": [
"「さようでございます」"
]
},
{
"id": 21612,
"kind": "msg",
"jp": [
"「皆様より早めに参りましたので",
"あいにくお会いしておりません」"
]
},
{
"id": 21613,
"kind": "msg",
"jp": [
"「それなりには」"
]
},
{
"id": 21614,
"kind": "msg",
"jp": [
"なんで目を逸らすんだろう・・・。"
]
},
{
"id": 21615,
"kind": "msg",
"jp": [
"「無理です」"
]
},
{
"id": 21616,
"kind": "msg",
"jp": [
"「あ、いや、",
"特に意味はないんだけど」"
]
},
{
"id": 21617,
"kind": "msg",
"jp": [
"「・・・ええ、まあ。",
"嫌いではありませんが」"
]
},
{
"id": 21618,
"kind": "msg",
"jp": [
"{怪訝/けげん}な顔をされてしまった。"
]
},
{
"id": 21619,
"kind": "msg",
"jp": [
"「未成年ですので」"
]
},
{
"id": 21620,
"kind": "msg",
"jp": [
"「詳しくは存じませんが",
"赤ばかりではなかったかと",
"記憶しております」"
]
},
{
"id": 21621,
"kind": "msg",
"jp": [
"「ございません」"
]
},
{
"id": 21622,
"kind": "msg",
"jp": [
"「この館には置いて",
"ございません」"
]
},
{
"id": 21623,
"kind": "msg",
"jp": [
"なんであんなに焦ったような",
"顔して言うんだろう・・・?"
]
},
{
"id": 21624,
"kind": "msg",
"jp": [
"「・・・使っているものなら",
"納戸には置かないのではないかと」"
]
},
{
"id": 21625,
"kind": "msg",
"jp": [
"「・・・台所にないよう",
"でしたら、そうではないかと」"
]
},
{
"id": 21626,
"kind": "msg",
"jp": [
"「あのさ、椿くんって日織のこと",
"ここで会う前から知ってる?」"
]
},
{
"id": 21627,
"kind": "msg",
"jp": [
"「知らねーよ、いちいち覚えてねえ」"
]
},
{
"id": 21628,
"kind": "msg",
"jp": [
"「ほっとけ」"
]
},
{
"id": 21629,
"kind": "msg",
"jp": [
"「調子にのせるとウザいから。",
"適当に聞き流してほっとけ」"
]
},
{
"id": 21630,
"kind": "msg",
"jp": [
"「・・・という対応を",
"おすすめいたします」"
]
},
{
"id": 21631,
"kind": "msg",
"jp": [
"「は、何か?」"
]
},
{
"id": 21632,
"kind": "msg",
"jp": [
"「普段は学生さんなの?」"
]
},
{
"id": 21633,
"kind": "msg",
"jp": [
"「私は執事ですが」"
]
},
{
"id": 21634,
"kind": "msg",
"jp": [
"「えっと、役じゃなくて普段・・・」"
]
},
{
"id": 21635,
"kind": "msg",
"jp": [
"「私は当家の執事です。",
"それ以外の何者でもございません」"
]
},
{
"id": 21636,
"kind": "msg",
"jp": [
"普通に答えてはくれないみたいだ・・・。"
]
},
{
"id": 21637,
"kind": "msg",
"jp": [
"「あのさ、那須さんって",
"いつもあんな感じなの?」"
]
},
{
"id": 21638,
"kind": "msg",
"jp": [
"・・・目を逸らしたまま",
"沈黙されてしまった。"
]
},
{
"id": 21639,
"kind": "msg",
"jp": [
"「妹さんの方です」"
]
},
{
"id": 21640,
"kind": "msg",
"jp": [
"「え、う、うん」"
]
},
{
"id": 21641,
"kind": "msg",
"jp": [
"それは知ってるんだけどなあ。"
]
},
{
"id": 21642,
"kind": "msg",
"jp": [
"「静奈ちゃんって・・・」"
]
},
{
"id": 21643,
"kind": "msg",
"jp": [
"「大変、才能ある方です」"
