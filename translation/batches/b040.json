]
},
{
"id": 21777,
"kind": "msg",
"jp": [
"「う、うん、ごめん・・・」"
]
},
{
"id": 21778,
"kind": "choice",
"jp": [
"まだ寝ない"
]
},
{
"id": 21779,
"kind": "choice",
"jp": [
"見張る"
]
},
{
"id": 21780,
"kind": "choice",
"jp": [
"やめとく"
]
},
{
"id": 21781,
"kind": "choice",
"jp": [
"寝る"
]
},
{
"id": 21782,
"kind": "msg",
"jp": [
"「さてと・・・",
"出来ましたぜ」"
]
},
{
"id": 21783,
"kind": "msg",
"jp": [
"「・・・暗石さん達は",
