[
{
"id": 31133,
"kind": "msg",
"jp": [
"（・・・そんなのイヤだ・・・）"
]
},
{
"id": 31134,
"kind": "msg",
"jp": [
"無茶苦茶怖いけど、もうこれ以上",
"人が死ぬのはもっとイヤだ。"
]
},
{
"id": 31135,
"kind": "msg",
"jp": [
"出来るだけ音を立てないように、",
"もう少しだけ扉から離れて膝を抱える。"
]
},
{
"id": 31136,
"kind": "msg",
"jp": [
"（・・・・・神様）"
]
},
{
"id": 31137,
"kind": "msg",
"jp": [
"（もう、何も来ませんように・・・）"
]
},
{
"id": 31138,
"kind": "msg",
"jp": [
"「・・・んで、誰から寝る?",
"オレはどこでもいいぜ」"
]
},
{
"id": 31139,
"kind": "msg",
"jp": [
"「{和/なご}さん怪我人ですからね。",
"真ん中は辛いでしょう」"
]
},
{
"id": 31140,
"kind": "msg",
"jp": [
"「別に平気だけど・・・」"
]
},
{
"id": 31141,
"kind": "msg",
"jp": [
"「途中で起こされんのはキツいですよ。",
"俺が真ん中行きますから、椿さん先に",
"休んで下さいな」"
]
},
{
"id": 31142,
"kind": "msg",
"jp": [
"「ん、わかった。",
"じゃあ和が最後だな」"
]
},
{
"id": 31143,
"kind": "msg",
"jp": [
"「ええ、それで行きましょう」"
]
},
{
"id": 31144,
"kind": "msg",
"jp": [
"「日織だって、夕べあんまり",
"寝てないクセに・・・」"
]
},
{
"id": 31145,
"kind": "msg",
"jp": [
"「俺は怪我人じゃねえんですから、",
"大丈夫ですって」"
]
},
{
"id": 31146,
"kind": "msg",
"jp": [
"「んじゃ、ちゃんと起こしてくれよ」"
]
},
{
"id": 31147,
"kind": "msg",
"jp": [
"「はいはい、お休みなさい」"
]
},
{
"id": 31148,
"kind": "msg",
"jp": [
"「んー、お休みー」"
]
},
{
"id": 31149,
"kind": "msg",
"jp": [
"ひらひらと手を振って、",
"椿くんはベッドにもぐり込んだ。"
]
},
{
"id": 31150,
"kind": "msg",
"jp": [
"僕らはなるべくベッドから離れた",
"床の上に腰を下ろす。"
]
},
{
"id": 31151,
"kind": "msg",
"jp": [
"「{和/なご}さん、辛かったら",
"寝てていいですぜ」"
]
},
{
"id": 31152,
"kind": "msg",
"jp": [
"「そんなわけにいかないよ。",
"何のために一緒についてるか",
"わかんないじゃん」"
]
},
{
"id": 31153,
"kind": "msg",
"jp": [
"「何かあったらすぐ起こしますから」"
]
},
{
"id": 31154,
"kind": "msg",
"jp": [
"「大丈夫だってば。",
"もう頭も何ともないし」"
]
},
{
"id": 31155,
"kind": "msg",
"jp": [
"「そうですかい?",
"じゃあ、ちょいとつき合って",
"もらいやしょうかね」"
]
},
{
"id": 31156,
"kind": "msg",
"jp": [
"「何すんの?」"
]
},
{
"id": 31157,
"kind": "msg",
"jp": [
"「あんまり喋ってるわけにも",
"いかねえでしょうから、これで」"
]
},
{
"id": 31158,
"kind": "msg",
"jp": [
"そう言いながら、日織は袂から",
"何か取りだして見せる。"
]
},
{
"id": 31159,
"kind": "msg",
"jp": [
"「・・・・・・花札?」"
]
},
{
"id": 31160,
"kind": "msg",
"jp": [
"「ルール知ってます?」"
]
},
{
"id": 31161,
"kind": "msg",
"jp": [
"「まあ、一応・・・。",
"大学の先輩に教わったことある」"
]
},
{
"id": 31162,
"kind": "msg",
"jp": [
"「声出さなくても出来るでしょ。",
"じゃ、配りますぜ」"
]
},
{
"id": 31163,
"kind": "msg",
"jp": [
"いつの間に用意してたんだか。",
"でも、じーっと黙って座ってるよりは",
"気が紛れそうだし、いいか。"
]
},
{
"id": 31164,
"kind": "msg",
"jp": [
"そのまま、無言で数時間札をめくり合う。",
"端から見たら、異様な光景だろうなぁ。"
]
},
{
"id": 31165,
"kind": "msg",
"jp": [
"（・・・・強い・・・・）"
]
},
{
"id": 31166,
"kind": "msg",
"jp": [
"僕が弱すぎるのかもしれないけど、",
"万が一金がかかってたら、完璧に",
"破産しそうな勢いで負け続ける・・・。"
]
},
{
"id": 31167,
"kind": "msg",
"jp": [
"「・・・・なぁ、日織。",
"そろそろ交代した方が良くない?」"
]
},
{
"id": 31168,
"kind": "msg",
"jp": [
"「ああ、もうそんな時間ですかい。",
"けっこう暇つぶれましたね」"
]
},
{
"id": 31169,
"kind": "msg",
"jp": [
"そりゃあ、あれだけ勝てれば",
"時間も忘れるだろうよ。"
]
},
{
"id": 31170,
"kind": "msg",
"jp": [
"「じゃ、椿さんに起きて",
"もらいますかね」"
]
},
{
"id": 31171,
"kind": "msg",
"jp": [
"そう言って腰を上げると、",
"日織は椿くんを揺り起こす。"
]
},
{
"id": 31172,
"kind": "msg",
"jp": [
"「んー・・・交代かぁ?」"
]
},
{
"id": 31173,
"kind": "msg",
"jp": [
"「・・・って、何やってんだお前ら」"
]
},
{
"id": 31174,
"kind": "msg",
"jp": [
"「はい、続きお願いしますね」"
]
},
{
"id": 31175,
"kind": "msg",
"jp": [
"「花札ぁ?",
"何か賭けてんの?」"
]
},
{
"id": 31176,
"kind": "msg",
"jp": [
"「か、賭けてない賭けてない!",
"単なる暇つぶしだから!」"
]
},
{
"id": 31177,
"kind": "msg",
"jp": [
"「なんだ、つまんねえ」"
]
},
{
"id": 31178,
"kind": "msg",
"jp": [
"「じゃ、後はよろしくー」"
]
},
{
"id": 31179,
"kind": "msg",
"jp": [
"「おう、おやすみ」"
]
},
{
"id": 31180,
"kind": "msg",
"jp": [
"「よし、じゃあやるか!」"
]
},
{
"id": 31181,
"kind": "msg",
"jp": [
"「・・・お手柔らかに」"
]
},
{
"id": 31182,
"kind": "msg",
"jp": [
"ものすごく嫌な予感はしたけど。"
]
},
{
"id": 31183,
"kind": "msg",
"jp": [
"（・・・・やっぱり・・・）"
]
},
{
"id": 31184,
"kind": "msg",
"jp": [
"（僕が弱いんだな・・・・）"
]
},
{
"id": 31185,
"kind": "msg",
"jp": [
"日織の時ほどじゃなかったが、",
"やっぱり勝てなかった・・・。"
]
},
{
"id": 31186,
"kind": "msg",
"jp": [
"泣きそうになってきた頃、",
"ようやく時計の針が僕の眠る時間を",
"指してくれる。"
]
},
{
"id": 31187,
"kind": "msg",
"jp": [
"「・・・・椿くん・・・",
"日織、起こしていい・・・?」"
]
},
{
"id": 31188,
"kind": "msg",
"jp": [
"「おお、そろそろいい時間だな」"
]
},
{
"id": 31189,
"kind": "msg",
"jp": [
"「じゃあ、起こすね!",
"日織ー、起きてー」"
]
},
{
"id": 31190,
"kind": "msg",
"jp": [
"逃げるように札を置いて、",
"日織を叩き起こす。"
]
},
{
"id": 31191,
"kind": "msg",
"jp": [
"「・・・・はいはい」"
]
},
{
"id": 31192,
"kind": "msg",
"jp": [
"「どしたんです、{和/なご}さん?",
"なんか半泣きですけど」"
]
},
{
"id": 31193,
"kind": "msg",
"jp": [
"「わはは、悪いなー。",
"和、弱ぇーんだもんよ」"
]
},
{
"id": 31194,
"kind": "msg",
"jp": [
"「負けっ放しだったんですかい」"
]
},
{
"id": 31195,
"kind": "msg",
"jp": [
"「仇取っといて・・・」"
]
},
{
"id": 31196,
"kind": "msg",
"jp": [
"「お任せを」"
]
},
{
"id": 31197,
"kind": "msg",
"jp": [
"「お、言ってくれるじゃねーか!",
"よっしゃ、来い!」"
]
},
{
"id": 31198,
"kind": "msg",
"jp": [
"「・・・おやすみ・・・」"
]
},
{
"id": 31199,
"kind": "msg",
"jp": [
"ベッドにもぐり込んで布団を頭から",
"かぶった途端、ぐるぐると意識が",
"落ちていくのを感じた。"
]
},
{
"id": 31200,
"kind": "msg",
"jp": [
"（ああ、やっぱり疲れてたんだ・・・）"
]
},
{
"id": 31201,
"kind": "msg",
"jp": [
"ぼんやりと、そんなことを考える。",
"ぱしん、という札を叩きつける硬い音が",
"何度か聞こえた気がするけど・・・。"
]
},
{
"id": 31202,
"kind": "msg",
"jp": [
"・・・それも、だんだんと遠ざかって",
"消えていった。"
]
},
{
"id": 31203,
"kind": "msg",
"jp": [
"「御陵さんとこに",
"持っていってくるよ」"
]
},
{
"id": 31204,
"kind": "msg",
"jp": [
"「あの、晩ご飯持ってきたんですが",
"いりませんか?」"
]
},
{
"id": 31205,
"kind": "msg",
"jp": [
"「ごめんなさい、あの、",
"食欲がなくて・・・」"
]
},
{
"id": 31206,
"kind": "msg",
"jp": [
"「すみません、",
"わざわざ来ていただいたのに」"
]
},
{
"id": 31207,
"kind": "msg",
"jp": [
"「いえ・・・",
"それじゃあ」"
]
},
{
"id": 31208,
"kind": "msg",
"jp": [
"「ごめん、御陵さん",
"食欲ないって」"
]
},
{
"id": 31209,
"kind": "msg",
"jp": [
"「そうですか・・・。",
"ま、無理もねえですね」"
]
},
{
"id": 31210,
"kind": "msg",
"jp": [
"「とにかく俺らは",
"食っちまいましょう」"
]
},
{
"id": 31211,
"kind": "msg",
"jp": [
"「暗石さん・・・",
"出てきてくれるかな」"
]
},
{
"id": 31212,
"kind": "msg",
"jp": [
"「うーん、まあ一応",
"持ってってみますかい」"
]
},
{
"id": 31213,
"kind": "msg",
"jp": [
"「そうだね。",
"行ってみるよ」"
]
},
{
"id": 31214,
"kind": "msg",
"jp": [
"「なんか用か」"
]
},
{
"id": 31215,
"kind": "msg",
"jp": [
"「・・・いらねえっつったのに",
"おせっかいな奴らだな・・・」"
]
},
{
"id": 31216,
"kind": "msg",
"jp": [
"「あ、はい!」"
]
},
{
"id": 31217,
"kind": "msg",
"jp": [
"「ただいまー、",
"渡してきたよ」"
]
},
{
"id": 31218,
"kind": "msg",
"jp": [
"「もらってくれましたか。",
"そりゃよかった」"
]
},
{
"id": 31219,
"kind": "msg",
"jp": [
"「じゃ、俺らも",
"すませちまいましょう」"
]
},
{
"id": 31220,
"kind": "msg",
"jp": [
"「暗石さんに持っていってみる」"
]
},
{
"id": 31221,
"kind": "msg",
"jp": [
"「はい、",
"お願いします」"
]
},
{
"id": 31222,
"kind": "msg",
"jp": [
"「暗石さーん、",
"食事持って来たんですけどー」"
]
},
{
"id": 31223,
"kind": "msg",
"jp": [
"「あ、これ、どうぞ」"
]
},
{
"id": 31224,
"kind": "msg",
"jp": [
"「律儀な坊主だな、まったく。",
"ありがとよ、着流しにも言っとけ」"
]
},
{
"id": 31225,
"kind": "msg",
"jp": [
"「ただいまー、",
"ありがとよって言ってたよ」"
]
},
{
"id": 31226,
"kind": "msg",
"jp": [
"「そうですかい、",
"そりゃよかった」"
]
},
{
"id": 31227,
"kind": "msg",
"jp": [
"「じゃ、俺らも",
"すませちまいますか」"
]
},
{
"id": 31228,
"kind": "msg",
"jp": [
"「暗石さん、あの・・・?」"
]
},
{
"id": 31229,
"kind": "msg",
"jp": [
"「うるせえな、寝てんだよ!」"
]
},
{
"id": 31230,
"kind": "msg",
"jp": [
"「あ、す、すみません」"
]
},
{
"id": 31231,
"kind": "msg",
"jp": [
"「ごめん、暗石さん",
"今、寝たとこみたい」"
]
},
{
"id": 31232,
"kind": "msg",
"jp": [
"「そうですかい、",
"じゃ、置いといて俺らは",
"食っちまいましょう」"
]
},
{
"id": 31233,
"kind": "msg",
"jp": [
"「那須さんとこ行って来る」"
]
},
{
"id": 31234,
"kind": "msg",
"jp": [
"「那須さーん」"
]
},
{
"id": 31235,
"kind": "msg",
"jp": [
"「やあ、和くん」"
]
},
{
"id": 31236,
"kind": "msg",
"jp": [
"「晩ご飯持ってきたんですけど」"
]
},
{
"id": 31237,
"kind": "msg",
"jp": [
"「おお、ありがとう!",
"いただきます!」"
]
},
{
"id": 31238,
"kind": "msg",
"jp": [
"「ただいま、渡してきたよ」"
]
},
{
"id": 31239,
"kind": "msg",
"jp": [
"「それじゃ俺らも",
"食っちまいましょう」"
]
},
{
"id": 31240,
"kind": "msg",
"jp": [
"「椿くんとこ行ってくるよ」"
]
},
{
"id": 31241,
"kind": "msg",
"jp": [
"「あー?」"
]
},
{
"id": 31242,
"kind": "msg",
"jp": [
"「なんだよ、寝てたのに・・・」"
]
},
{
"id": 31243,
"kind": "msg",
"jp": [
"「あ、ごめん。",
"あの、晩ご飯・・・」"
]
},
{
"id": 31244,
"kind": "msg",
"jp": [
"「あー、そっか。",
"サンキュ・・・」"
]
},
{
"id": 31245,
"kind": "msg",
"jp": [
"「起きたら食うわ。",
"ごちそーさん」"
]
},
{
"id": 31246,
"kind": "msg",
"jp": [
"「椿くんに渡してくるよ」"
]
},
{
"id": 31247,
"kind": "msg",
"jp": [
"「椿くーん。",
"ご飯持ってきたけどー」"
]
},
{
"id": 31248,
"kind": "msg",
"jp": [
"「あー、待て!",
"今開ける!」"
]
},
{
"id": 31249,
"kind": "msg",
"jp": [
"「・・・っと、",
"これはどうもありがとうございます」"
]
},
{
"id": 31250,
"kind": "msg",
"jp": [
"「級に元に戻らなくても」"
]
},
{
"id": 31251,
"kind": "msg",
"jp": [
"「気にするな。",
"んじゃ、サンキュ」"
]
},
{
"id": 31252,
"kind": "msg",
"jp": [
"「椿くんとこに",
"持って行って来る」"
]
},
{
"id": 31253,
"kind": "msg",
"jp": [
"「ん? 飯か?」"
]
},
{
"id": 31254,
"kind": "msg",
"jp": [
"「そうだよー」"
]
},
{
"id": 31255,
"kind": "msg",
"jp": [
"「はいはいっと。",
"毎度ありがとうございます」"
]
},
{
"id": 31256,
"kind": "msg",
"jp": [
"「サンキュ、じゃーなー」"
]
},
{
"id": 31257,
"kind": "choice",
"jp": [
"続く気がする"
]
},
{
"id": 31258,
"kind": "choice",
"jp": [
"あれ一回だけだと思う"
]
},
{
"id": 31259,
"kind": "choice",
"jp": [
"それもそうだ"
]
},
{
"id": 31260,
"kind": "msg",
"jp": [
"「・・・まあ、座りましょうや」"
]
},
{
"id": 31261,
"kind": "msg",
"jp": [
"書斎に入ると、日織はつとめて",
"気軽な口調でソファへと",
"うながしてくれる。"
]
},
{
"id": 31262,
"kind": "msg",
"jp": [
"それでも、さっきまでの衝撃から",
"まだ立ち直れていない僕は、",
"重苦しい返事しか出来なかった。"
]
},
{
"id": 31263,
"kind": "msg",
"jp": [
"「・・{和/なご}さん」"
]
},
{
"id": 31264,
"kind": "msg",
"jp": [
"「すみませんね、",
"変なことに巻き込んじまって」"
]
},
{
"id": 31265,
"kind": "msg",
"jp": [
"「え、いや、",
"そんなの日織のせいじゃ・・・」"
]
},
{
"id": 31266,
"kind": "msg",
"jp": [
"「あんたに泊まってもらおうって",
"言い出したの俺ですぜ」"
]
},
{
"id": 31267,
"kind": "msg",
"jp": [
"「そんなの親切で",
"言ってくれたことだろ」"
]
},
{
"id": 31268,
"kind": "msg",
"jp": [
"「だって僕、もしあのまま",
"追い出されてたら遭難してるよ」"
]
},
{
"id": 31269,
"kind": "msg",
"jp": [
"「・・・けど、",
"俺の部屋に泊まるように",
"言いましたから」"
]
},
{
"id": 31270,
"kind": "msg",
"jp": [
"「? それだって",
"僕が怪我してたからだろ?」"
]
},
{
"id": 31271,
"kind": "msg",
"jp": [
"「ええ、もちろんそうです。",
"そうだったんですがね・・・」"
]
},
{
"id": 31272,
"kind": "msg",
"jp": [
"「だった・・って?」"
]
},
{
"id": 31273,
"kind": "msg",
"jp": [
"「そのせいで、",
"かえってヤバいことに",
"なっちまったでしょう」"
]
},
{
"id": 31274,
"kind": "msg",
"jp": [
"「ヤバい・・・?」"
]
},
{
"id": 31275,
"kind": "msg",
"jp": [
"「俺らだけでしょう。",
"夕べのアリバイが完全にあるのって」"
]
},
{
"id": 31276,
"kind": "msg",
"jp": [
"「ああ、そりゃあ・・・",
"他の人はみんな個室だしね」"
]
},
{
"id": 31277,
"kind": "msg",
"jp": [
"「それがなんでヤバいの?",
"僕は、日織だけは犯人じゃないって",
"わかってるから安心だけど」"
]
},
{
"id": 31278,
"kind": "msg",
"jp": [
"「そりゃ、俺だってそうですよ。",
"あんたがいなかったら・・・」"
]
},
{
"id": 31279,
"kind": "msg",
"jp": [
"「でも、他の人からして見たら、",
"俺らの方が怪しく見えると",
"思いませんか?」"
]
},
{
"id": 31280,
"kind": "msg",
"jp": [
"「だって、こんな事件があった夜に",
"偶然アリバイがあるんですぜ」"
]
},
{
"id": 31281,
"kind": "msg",
"jp": [
"「実は俺らが最初からつるんでて、",
"お互いに都合良く証言し合ってると",
"思われてねえかと・・・」"
]
},
{
"id": 31282,
"kind": "msg",
"jp": [
"「それ・・・もしかして、食堂で",
"暗石さんが言ってた・・・?」"
]
},
{
"id": 31283,
"kind": "msg",
"jp": [
"「そうです。",
"俺らだけが斑井さんが死んだ時刻",
"お互いのアリバイを証言出来る」"
]
},
{
"id": 31284,
"kind": "msg",
"jp": [
"「・・・こんな不測の事態に",
"不自然だと思いたくなるでしょう。",
"他の人にしてみれば」"
]
},
{
"id": 31285,
"kind": "msg",
"jp": [
"「そりゃあ・・・",
"僕が迷い込んできたこと自体が",
"すごい偶然なんだから・・・」"
]
},
{
"id": 31286,
"kind": "msg",
"jp": [
"「・・・他の人達からしたら",
"それは、僕らだけ異常に都合が",
"良すぎるように見える・・・?」"
]
},
{
"id": 31287,
"kind": "msg",
"jp": [
"「だと思いませんか」"
]
},
{
"id": 31288,
"kind": "msg",
"jp": [
"あり得ない話じゃない。",
"いや、それどころか暗石さんはもう",
"既に疑って・・・。"
]
},
{
"id": 31289,
"kind": "msg",
"jp": [
"（・・・!",
"違う、暗石さんだけじゃない!）"
]
},
{
"id": 31290,
"kind": "msg",
"jp": [
"「そう言や、夕べこの坊主",
"部屋に引き取るって",
"{言/・}{い/・}{出/・}{し/・}{た/・}{の/・}{も/・}{お/・}{前/・}だったな」"
]
},
{
"id": 31291,
"kind": "msg",
"jp": [
"あの、奇妙で居心地の悪い沈黙。",
"あれは日織の言い分を信じていいのか",
"どうか判断しかねてたんだ・・・。"
]
},
{
"id": 31292,
"kind": "msg",
"jp": [
"あり得ない話じゃない・・・。"
]
},
{
"id": 31293,
"kind": "msg",
"jp": [
"（いや、実際あの時",
"僕らにしかアリバイがないって",
"誰かが口にしてた・・・）"
]
},
{
"id": 31294,
"kind": "msg",
"jp": [
"疑われてても、不思議はないんだ。"
]
},
{
"id": 31295,
"kind": "msg",
"jp": [
"「・・・本当ですよ」"
]
},
{
"id": 31296,
"kind": "msg",
"jp": [
"「俺の部屋にって言ったのは",
"あんたが怪我人だったからで・・」"
]
},
{
"id": 31297,
"kind": "msg",
"jp": [
"「あ、あ、僕は疑ってないよ?",
"疑ったから黙ったわけじゃないよ?」"
]
},
{
"id": 31298,
"kind": "msg",
"jp": [
"「本当だって!」"
]
},
{
"id": 31299,
"kind": "msg",
"jp": [
"「ああ、すいません。",
"俺も信じられねえから",
"黙ったわけじゃねえですよ」"
]
},
{
"id": 31300,
"kind": "msg",
"jp": [
"「・・・ちょっと驚いただけです」"
]
},
{
"id": 31301,
"kind": "msg",
"jp": [
"「驚くって?」"
]
},
{
"id": 31302,
"kind": "msg",
"jp": [
"「だってあんた、",
"本気で俺のこと疑って",
"ねえでしょう」"
]
},
{
"id": 31303,
"kind": "msg",
"jp": [
"「疑ってないってば。",
"だって僕は日織が夕べ部屋を",
"出てないの知ってるんだから」"
]
},
{
"id": 31304,
"kind": "msg",
"jp": [
"「・・・{和/なご}さんは",
"いい人ですね」"
]
},
{
"id": 31305,
"kind": "msg",
"jp": [
"「本当に俺が犯人で、",
"あんたのこと騙してるとは",
"思わねえんですね」"
]
},
{
"id": 31306,
"kind": "msg",
"jp": [
"「ええっ!?",
"やだよそんなの",
"怖いじゃないか!」"
]
},
{
"id": 31307,
"kind": "msg",
"jp": [
"「え、だって、もし日織が",
"嘘ついてたら本当に誰も",
"信じられる人いなくなるし」"
]
},
{
"id": 31308,
"kind": "msg",
"jp": [
"「いや、まあ、",
"そりゃそうですが」"
]
},
{
"id": 31309,
"kind": "msg",
"jp": [
"「嘘ついてないんだろ?」"
]
},
{
"id": 31310,
"kind": "msg",
"jp": [
"「ついてませんよ」"
]
},
{
"id": 31311,
"kind": "msg",
"jp": [
"「だったら信じるよ。",
"夕べ日織は部屋から出てないし、",
"僕も出てない」"
]
},
{
"id": 31312,
"kind": "msg",
"jp": [
"「・・・俺も信じます。",
"ありがとう、{和/なご}さん」"
]
},
{
"id": 31313,
"kind": "msg",
"jp": [
"「お、お互いさまだろ?」"
]
},
{
"id": 31314,
"kind": "msg",
"jp": [
"「でも、残念ながら",
"他の人はこのままじゃ信じて",
"くれねえでしょうが・・・」"
]
},
{
"id": 31315,
"kind": "msg",
"jp": [
"「今の時点でみんなもう",
"かなり神経が参ってるでしょう」"
]
},
{
"id": 31316,
"kind": "msg",
"jp": [
"「暗石さんが部屋にこもるって",
"言い出したのも、そのせいでも",
"あるでしょうから」"
]
},
{
"id": 31317,
"kind": "msg",
"jp": [
"「暗石さんが?」"
]
},
{
"id": 31318,
"kind": "msg",
"jp": [
"「誰も信用出来ねえ、なんて",
"言ってましたし、それだって",
"本音かもしれませんがね・・」"
]
},
{
"id": 31319,
"kind": "msg",
"jp": [
"「それだけでもねえだろうと",
"思うんですよ」"
]
},
{
"id": 31320,
"kind": "msg",
"jp": [
"「・・・疑ったり、疑われたり",
"そういうのが嫌だから・・?」"
]
},
{
"id": 31321,
"kind": "msg",
"jp": [
"「ええ、顔つきあわせてりゃ",
"どうしたって、相手が嘘ついてねえか",
"実は犯人じゃねえか、なんて・・・」"
]
},
{
"id": 31322,
"kind": "msg",
"jp": [
"「・・・嫌なこと考えながら、",
"腹のさぐり合いになっちまう。",
"そりゃあ疲れますよね」"
]
},
{
"id": 31323,
"kind": "msg",
"jp": [
"「ひょっとして暗石さん、",
"僕らの話聞こえてたのかな」"
]
},
{
"id": 31324,
"kind": "msg",
"jp": [
"「断片的には",
"聞こえてたかもしれません」"
]
},
{
"id": 31325,
"kind": "msg",
"jp": [
"「みんな似たようなこと",
"考えてたでしょうし」"
]
},
{
"id": 31326,
"kind": "msg",
"jp": [
"「あ、そう言えば",
"手帳見てなんか変な顔してたけど",
"なんだったの?」"
]
},
{
"id": 31327,
"kind": "msg",
"jp": [
"「アリバイですよ。",
"やっぱり俺らにしかねえ",
"みてえだと思ってたんです」"
]
},
{
"id": 31328,
"kind": "msg",
"jp": [
"「あ・・・そっか。",
"本当にないのかな、",
"僕ら以外、まるっきり」"
]
},
{
"id": 31329,
"kind": "msg",
"jp": [
"「今、さっと表にしてみて",
"確かめてみますかい」"
]
},
{
"id": 31330,
"kind": "msg",
"jp": [
"「俺も居間で多少は",
"話聞いてますから」"
]
},
{
"id": 31331,
"kind": "msg",
"jp": [
"「うん、じゃあ",
"僕の聞いたことと合わせて",
"書き出してみようか」"
]
},
{
"id": 31332,
"kind": "msg",
"jp": [
"それぞれに聞いた事を総合して",
"夕べのみんなの行動を一覧表に",
"してみる。"
]
},
{
"id": 31333,
"kind": "msg",
"jp": [
"「何時何分とか正確にわかんない",
"部分が多いんだけど・・・」"
]
},
{
"id": 31334,
"kind": "msg",
"jp": [
"「そこはまあ、仕方ねえでしょう。",
"人間そこまで正確に分刻みで",
"自分の行動覚えちゃいませんし」"
]
},
{
"id": 31335,
"kind": "msg",
"jp": [
"「じゃあ、何時くらいを",
"支点にするのがいいのかな」"
]
},
{
"id": 31336,
"kind": "msg",
"jp": [
"「そうですねぇ、",
"時間で言うとはっきりしねえ",
"事の方が多いですから」"
]
},
{
"id": 31337,
"kind": "msg",
"jp": [
"「なんか証言の中で",
"具体的でわかりやすい話を",
"軸にしたらどうですかね」"
]
},
{
"id": 31338,
"kind": "msg",
"jp": [
"「てことは・・・」"
]
},
{
"id": 31339,
"kind": "msg",
"jp": [
"「斑井さんの死亡推定時刻?」"
]
},
{
"id": 31340,
"kind": "msg",
"jp": [
"「それ、",
"一番正確じゃねえですぜ」"
]
},
{
"id": 31341,
"kind": "msg",
"jp": [
"「あれ?",
"そうか、じゃあ・・・」"
]
},
{
"id": 31342,
"kind": "msg",
"jp": [
"「みんなが部屋に引き上げた",
"くらいの時間?」"
]
},
{
"id": 31343,
"kind": "msg",
"jp": [
"「そりゃ11時過ぎって",
"はっきりしてますが・・・」"
]
},
{
"id": 31344,
"kind": "msg",
"jp": [
"「問題が起きたのは",
"それから後の話ですからねえ」"
]
},
{
"id": 31345,
"kind": "msg",
"jp": [
"「あ、そっか。",
"じゃあ・・・」"
]
},
{
"id": 31346,
"kind": "msg",
"jp": [
"「椿くんが時計を見たって",
"言ってるよね。",
"11時20分頃だっけ」"
]
},
{
"id": 31347,
"kind": "msg",
"jp": [
"「ああ、それが一番",
"よさそうですね」"
]
},
{
"id": 31348,
"kind": "msg",
"jp": [
"「椿さんが吹き抜けで",
"てるてる坊主見つけて驚いたって",
"言ってたやつですよね」"
]
},
{
"id": 31349,
"kind": "msg",
"jp": [
"「うん、それ。",
"那須さんに会って話したりも",
"してるから間違いないだろうし」"
]
},
{
"id": 31350,
"kind": "msg",
"jp": [
"「斑井さんが亡くなった時刻",
"なんて俺の素人見解ですから、",
"正確じゃねえですからね」"
]
},
{
"id": 31351,
"kind": "msg",
"jp": [
"「確かその辺りって他の人も",
"部屋から出てうろうろしてたって",
"話してるしそれがいいでしょう」"
]
},
{
"id": 31352,
"kind": "msg",
"jp": [
"「じゃあその辺りを軸に",
"えーと、5分単位くらいで",
"区切ってみていいかな」"
]
},
{
"id": 31353,
"kind": "msg",
"jp": [
"「それ以上細けぇ時間は",
"誰も覚えてねえでしょうから",
"いいんじゃねえですかい」"
]
},
{
"id": 31354,
"kind": "msg",
"jp": [
"「だよね・・・",
"じゃあ、こんなとこかな?」"
]
},
{
"id": 31355,
"kind": "msg",
"jp": [
"「ところどころで",
"顔合わせてる人はいるん",
"ですけどねぇ」"
]
},
{
"id": 31356,
"kind": "msg",
"jp": [
"「23時5分頃のところで、",
"鈴奈ちゃんと御陵さんが",
"部屋の前で会ってて・・・」"
]
},
{
"id": 31357,
"kind": "msg",
"jp": [
"「鈴奈ちゃんは静奈ちゃんの部屋に",
"そのまま23時30分頃までいた」"
]
},
{
"id": 31358,
"kind": "msg",
"jp": [
"「御陵さんは台所に降りてるけど",
"他の人には会ってないのか」"
]
},
{
"id": 31359,
"kind": "msg",
"jp": [
"「御陵さんは、23時10分頃に",
"居間の方へ向かってた暗石さんを",
"見たそうですが会っちゃいませんね」"
]
},
{
"id": 31360,
"kind": "msg",
"jp": [
"「那須さんが最初に廊下に",
"出た15分頃は側には誰も",
"いないしなあ」"
]
},
{
"id": 31361,
"kind": "msg",
"jp": [
"「ただ、1階ホールを",
"斑井さんらしい人が歩いてくのを",
"見たって話でしたから・・・」"
]
},
{
"id": 31362,
"kind": "msg",
"jp": [
"「うん、だから斑井さんが",
"亡くなった時刻はそれより少し",
"後だろうって事にしてある」"
]
},
{
"id": 31363,
"kind": "msg",
"jp": [
"「そうですね、これより早いと",
"まだ御陵さんが近くにいますし」"
]
},
{
"id": 31364,
"kind": "msg",
"jp": [
"「その後、椿くんが",
"那須さんの部屋に行って",
"ちょっと話してるんだね」"
]
},
{
"id": 31365,
"kind": "msg",
"jp": [
"「それが25分頃で、",
"御陵さんはその時台所出て",
"部屋に向かったところか」"
]
},
{
"id": 31366,
"kind": "msg",
"jp": [
"「30分頃には那須さんが",
"廊下に出てきてその時には",
"静奈さんに会ってますね」"
]
},
{
"id": 31367,
"kind": "msg",
"jp": [
"「でも・・・",
"そこから後は誰も他の人に",
"会ってないんだね」"
]
},
{
"id": 31368,
"kind": "msg",
"jp": [
"「暗石さんが部屋に戻ろうとした",
"35分頃那須さんが1階に降りてん",
"ですけどね・・・」"
]
},
{
"id": 31369,
"kind": "msg",
"jp": [
"「どちらも会ったとか",
"見かけたとか言っちゃ",
"いませんでしたね」"
]
},
{
"id": 31370,
"kind": "msg",
"jp": [
"「表では同じ欄になってるけど",
"実際は5分も幅があるからなあ。",
"ちょうど行き違ったのかな」"
]
},
{
"id": 31371,
"kind": "msg",
"jp": [
"「・・・ただ、那須さんですからね。",
"単に覚えてねえって可能性も・・・」"
]
},
{
"id": 31372,
"kind": "msg",
"jp": [
"「あ、後でもう一回",
"聞いてみた方がいいかもね」"
]
},
{
"id": 31373,
"kind": "msg",
"jp": [
"「居間で聞いた範囲でわかるのは",
"これくらいですか」"
]
},
{
"id": 31374,
"kind": "msg",
"jp": [
"本当に、僕と日織だけが",
"見事に完璧なアリバイを",
"持ってるんだ。"
]
},
{
"id": 31375,
"kind": "msg",
"jp": [
"「斑井さんが殺された時刻って",
"今より正確にはわかんないよね」"
]
},
{
"id": 31376,
"kind": "msg",
"jp": [
"「・・・無理でしょうね。",
"死体の状態から推測するのは",
"俺らにゃあれが限界ですから」"
]
},
{
"id": 31377,
"kind": "msg",
"jp": [
"「那須さんが姿を見たって",
"言ってる時刻よりちょい後の",
"23時半以降・・・」"
]
},
{
"id": 31378,
"kind": "msg",
"jp": [
"「0時から2時間前後ってことは",
"23時半から1時頃までか」"
]
},
{
"id": 31379,
"kind": "msg",
"jp": [
"「その間ならいつだって",
"可能性はありますね」"
]
},
{
"id": 31380,
"kind": "msg",
"jp": [
"「つまり、この場合斑井さんの",
"死亡推定時刻ってぇのはこだわっても",
"あんまり{意/・}{味/・}{が/・}{ね/・}{え/・}って事です」"
]
},
{
"id": 31381,
"kind": "msg",
"jp": [
"「意味がない・・・",
"そうだよね、特定のしようが",
"ないんだから・・・」"
]
},
{
"id": 31382,
"kind": "msg",
"jp": [
"「・・・参りましたね。",
"どうにか証明出来ねえかなぁ」"
]
},
{
"id": 31383,
"kind": "msg",
"jp": [
"「証明?」"
]
},
{
"id": 31384,
"kind": "msg",
"jp": [
"「俺らは犯人じゃねえって事です。",
"このまま疑われっぱなしは",
"どう考えてもまずいでしょう」"
]
},
{
"id": 31385,
"kind": "msg",
"jp": [
"「また何か起きたら、",
"多分真っ先に疑われちまう",
"でしょうから」"
]
},
{
"id": 31386,
"kind": "msg",
"jp": [
"「そ・・それってあの、",
"やっぱり・・・」"
]
},
{
"id": 31387,
"kind": "msg",
"jp": [
"「一番怪しい奴をどっかに",
"閉じ込めとこうとかそういう",
"話になったり・・・」"
]
},
{
"id": 31388,
"kind": "msg",
"jp": [
"「・・・正直、",
"それが怖ぇんです」"
]
},
{
"id": 31389,
"kind": "msg",
"jp": [
"「もちろん、みなさん",
"普段はそんなこと言い出す人じゃ",
"ねえんですがね」"
]
},
{
"id": 31390,
"kind": "msg",
"jp": [
"「けど今はこんな状況でしょう。",
"正常な判断力ってやつが",
"どこまで続くかまでは・・・」"
]
},
{
"id": 31391,
"kind": "msg",
"jp": [
"閉じ込めておこう、で済めば",
"いいけどその保証もないんだ。"
]
},
{
"id": 31392,
"kind": "msg",
"jp": [
"多分、日織が一番心配してるのは",
"そっちの方だろう。"
]
},
{
"id": 31393,
"kind": "msg",
"jp": [
"（・・・さっきだって",
"僕と椿くんと鈴奈ちゃんが",
"怒鳴りあいになったくらいだし）"
]
},
{
"id": 31394,
"kind": "msg",
"jp": [
"（あんな異常な緊張状態が",
"この先も続いたら・・・）"
]
},
{
"id": 31395,
"kind": "msg",
"jp": [
"「・・・その表も",
"ひとまず隠しといた方が",
"いいでしょうね」"
]
},
{
"id": 31396,
"kind": "msg",
"jp": [
"「隠す?」"
]
},
{
"id": 31397,
"kind": "msg",
"jp": [
"「あ、ああ、そうか。",
"僕らにしかアリバイがないって",
"モロに書いてあるしね」"
]
},
{
"id": 31398,
"kind": "msg",
"jp": [
"「ええ、それもありますが」"
]
},
{
"id": 31399,
"kind": "msg",
"jp": [
"「他にも何かあるの?」"
]
},
{
"id": 31400,
"kind": "msg",
"jp": [
"「もしも、ですぜ。",
"俺もそんな人はここには",
"いねえと思いてえですが」"
]
},
{
"id": 31401,
"kind": "msg",
"jp": [
"「万が一、犯人や",
"その協力者がそんなもの",
"目に留めたら・・・」"
]
},
{
"id": 31402,
"kind": "msg",
"jp": [
"「・・・危険、ってこと?",
"でも、誰を疑ってるかなんて",
"この表からはわからないよ」"
]
},
{
"id": 31403,
"kind": "msg",
"jp": [
"「時間表記だってアバウトだし",
"犯人が見たとしてもそんなに",
"危ない物って思うかな?」"
]
},
{
"id": 31404,
"kind": "msg",
"jp": [
"「きちんと記録を残してる奴が",
"いるってだけで犯人にとっちゃあ",
"相当嫌なもんじゃねえですかね」"
]
},
{
"id": 31405,
"kind": "msg",
"jp": [
"「逆に言や、ひょっとすると",
"真相がわかった時にはけっこうな",
"武器になるかもしれませんが」"
]
},
{
"id": 31406,
"kind": "msg",
"jp": [
"「書き残されてるなんて",
"思わないだろうから?」"
]
},
{
"id": 31407,
"kind": "msg",
"jp": [
"「ええ。",
"ただし書いてあることが",
"正しけりゃですけどね」"
]
},
{
"id": 31408,
"kind": "msg",
"jp": [
"「もし誰か嘘をついてたとして、",
"{そ/・}{こ/・}{を/・}{正/・}{確/・}{に/・}{指/・}{摘/・}出来ればって",
"意味ですが」"
]
},
{
"id": 31409,
"kind": "msg",
"jp": [
"「嘘をついてる、",
"その個所・・・」"
]
},
{
"id": 31410,
"kind": "msg",
"jp": [
"「嘘の証言をしてるってことは",
"そこに何か隠してえ事があるって",
"ことでしょう」"
]
},
{
"id": 31411,
"kind": "msg",
"jp": [
"「とにかく、そいつは",
"毒にも薬にもなるシロモノかも",
"しれませんから気をつけて下さい」"
]
},
{
"id": 31412,
"kind": "msg",
"jp": [
"「何か確認してえ事があったら",
"俺に聞いてくれりゃつきあいますし」"
]
},
{
"id": 31413,
"kind": "msg",
"jp": [
"「さっきの表の・・・てぇか、",
"<co 0f0>斑井さんの死亡<co>の件で、って」"
]
},
{
"id": 31414,
"kind": "msg",
"jp": [
"「うん、わかった。",
"それは他の人にも確認した方が",
"いいだろうし・・・」"
]
},
{
"id": 31415,
"kind": "msg",
"jp": [
"「もし何か見直さなきゃ",
"ならないような事聞いちゃったら",
"<co 0f0>自分の部屋<co>でやった方がいいよね」"
]
},
{
"id": 31416,
"kind": "msg",
"jp": [
"「それがいいでしょうね。",
"部屋から出さなきゃ俺ら以外",
"見る{事/こた}ぁねえわけだし」"
]
},
{
"id": 31417,
"kind": "msg",
"jp": [
"（・・・でも、本当は・・・）"
]
},
{
"id": 31418,
"kind": "msg",
"jp": [
"書き直さなきゃならない事",
"なんてなければ",
"一番いいんだけど・・・。"
]
},
{
"id": 31419,
"kind": "msg",
"jp": [
"「日織はさ・・・",
"僕らが疑われるんじゃないかって",
"気にしてただろ?」"
]
},
{
"id": 31420,
"kind": "msg",
"jp": [
"「・・・ええ。",
"どうにも浮いてますからね",
"アリバイの件とか・・・」"
]
},
{
"id": 31421,
"kind": "msg",
"jp": [
"「・・・でも、",
"どうすればいいのかわからないよ」"
]
},
{
"id": 31422,
"kind": "msg",
"jp": [
"「せめてこれ以上",
"疑われないように大人しく",
"してるくらいしか・・・」"
]
},
{
"id": 31423,
"kind": "msg",
"jp": [
"「・・・{和/なご}さんもですかい。",
"俺もさっぱりなんですがね」"
]
},
{
"id": 31424,
"kind": "msg",
"jp": [
"「俺はね、正直ちゃんと頭が",
"働いてねえんだと思うんですよ、",
"妙なことばっかり浮かんでくるし」"
]
},
{
"id": 31425,
"kind": "msg",
"jp": [
"「妙なこと?」"
]
},
{
"id": 31426,
"kind": "msg",
"jp": [
"そう言って日織はふと本棚の方へ",
"視線を向けた。"
]
},
{
"id": 31427,
"kind": "msg",
"jp": [
"「・・・?",
"どうしたの?」"
]
},
{
"id": 31428,
"kind": "msg",
"jp": [
"そう言って日織は力なく首を振り",
"ため息をついた。"
]
},
{
"id": 31429,
"kind": "msg",
"jp": [
"なんとなく僕も無言になり、",
"しばらく会話が途切れる。"
]
},
{
"id": 31430,
"kind": "msg",
"jp": [
"（なんで今、",
"本の事なんか・・・?）"
]
},
{
"id": 31431,
"kind": "msg",
"jp": [
"（・・・ここの本って",
"言ったら・・・）"
]
},
{
"id": 31432,
"kind": "msg",
"jp": [
"――猫は、斑井さん。"
]
},
{
"id": 31433,
"kind": "msg",
"jp": [
"（え・・・）"
]
},
{
"id": 31434,
"kind": "msg",
"jp": [
"（な、なんで今そんなこと",
"思い出すんだ、僕は。",
"怖いじゃないか・・・）"
]
},
{
"id": 31435,
"kind": "msg",
"jp": [
"「・・・{和/なご}さん、",
"ここの本なんか読みました?」"
]
},
{
"id": 31436,
"kind": "msg",
"jp": [
"「え? なんで?",
"読んだことないけど」"
]
},
{
"id": 31437,
"kind": "msg",
"jp": [
"「そうですかい。",
"いや、ならいいんです」"
]
},
{
"id": 31438,
"kind": "msg",
"jp": [
"「・・・?",
"何かあるの?」"
]
},
{
"id": 31439,
"kind": "msg",
"jp": [
"「まあ、多分考えすぎだと",
"思うんですがね・・・」"
]
},
{
"id": 31440,
"kind": "msg",
"jp": [
"「もし、読んでみてあんたも",
"何か気になるようならちょいと",
"声かけて見て下さいや」"
]
},
{
"id": 31441,
"kind": "msg",
"jp": [
"「? うん、わかった」"
]
},
{
"id": 31442,
"kind": "msg",
"jp": [
"（あ・・・",
"また本棚の方見てる）"
]
},
{
"id": 31443,
"kind": "msg",
"jp": [
"（何か気になることが",
"あるのかも・・・）"
]
},
{
"id": 31444,
"kind": "msg",
"jp": [
"もしかして、しばらく席を外した方が",
"いいかもしれない。"
]
},
{
"id": 31445,
"kind": "msg",
"jp": [
"「・・・日織、僕ちょっと",
"出てくるから・・・」"
]
},
{
"id": 31446,
"kind": "msg",
"jp": [
"「え? ああ、そうですかい?」"
]
},
{
"id": 31447,
"kind": "msg",
"jp": [
"「うん、じゃあ・・・」"
]
},
{
"id": 31448,
"kind": "msg",
"jp": [
"「はい、お気をつけて」"
]
},
{
"id": 31449,
"kind": "msg",
"jp": [
"ソファから立ち上がって、",
"書斎を出る・・・。"
]
},
{
"id": 31450,
"kind": "msg",
"jp": [
"そこまで話して、日織は少し",
"疲れたように小さくため息を",
"もらした。"
]
},
{
"id": 31451,
"kind": "msg",
"jp": [
"「どうかしたの?」"
]
},
{
"id": 31452,
"kind": "msg",
"jp": [
"「・・・ねえ、{和/なご}さん」"
]
},
{
"id": 31453,
"kind": "msg",
"jp": [
"「やっぱ、この事件って",
"高遠延二郎の書いた本と何か",
"関係あるんですかね」"
]
},
{
"id": 31454,
"kind": "msg",
"jp": [
"「そこへ持ってきて、",
"黒猫が出た途端に斑井さんが",
"あのザマですからね・・・」"
]
},
{
"id": 31455,
"kind": "msg",
"jp": [
"「――猫は、斑井さん・・・」"
]
},
{
"id": 31456,
"kind": "msg",
"jp": [
"「日織もそう思うの?",
"静奈ちゃんの言う通り、",
"猫は斑井さんで・・・」"
]
},
{
"id": 31457,
"kind": "msg",
"jp": [
"「・・・ベルも",
"次の誰かを・・・」"
]
},
{
"id": 31458,
"kind": "msg",
"jp": [
"「・・・ベルだけですかね」"
]
},
{
"id": 31459,
"kind": "msg",
"jp": [
"「斑井さんの格好、",
"普通じゃねえでしょう」"
]
},
{
"id": 31460,
"kind": "msg",
"jp": [
"「そりゃ、ぜんぜん普通じゃ",
"なかったけど・・・」"
]
},
{
"id": 31461,
"kind": "msg",
"jp": [
"「なんであんなことに",
"なってんだろうってずっと",
"思ってたんですよ」"
]
},
{
"id": 31462,
"kind": "msg",
"jp": [
"「黒猫が置いてあって、",
"『黒猫の毒』って話に出てくる奴の",
"名前がついた人が殺された・・・」"
]
},
{
"id": 31463,
"kind": "msg",
"jp": [
"「でも、なんであんな格好で?」"
]
},
{
"id": 31464,
"kind": "msg",
"jp": [
"「なんで・・・って・・・」"
]
},
{
"id": 31465,
"kind": "msg",
"jp": [
"「・・・なんでだと思うの?」"
]
},
{
"id": 31466,
"kind": "msg",
"jp": [
"「・・・斑井さんのあの格好",
"見たときにね・・・」"
]
},
{
"id": 31467,
"kind": "msg",
"jp": [
"「なんかふっと思い出したんです。",
"あれ、どっかで見たことあるって」"
]
},
{
"id": 31468,
"kind": "msg",
"jp": [
"「ど、どこで!?」"
]
},
{
"id": 31469,
"kind": "msg",
"jp": [
"「今、確認しました。",
"あの格好にそっくりな状態の",
"死体がね、出てくるんですよ」"
]
},
{
"id": 31470,
"kind": "msg",
"jp": [
"「・・・これに」"
]
},
{
"id": 31471,
"kind": "msg",
"jp": [
"そう言って日織は手にしていた本の",
"表紙を僕に見せる。"
]
},
{
"id": 31472,
"kind": "msg",
"jp": [
"「・・・『黒猫の毒』・・・」"
]
},
{
"id": 31473,
"kind": "msg",
"jp": [
"「・・・そんな・・・それって、",
"一体どういう・・・」"
]
},
{
"id": 31474,
"kind": "msg",
"jp": [
"「な・・・なんで、そんな・・・",
"そんなことする奴が・・・ここに・・」"
]
},
{
"id": 31475,
"kind": "msg",
"jp": [
"「いや・・・",
"気のせいかもしれませんがね」"
]
},
{
"id": 31476,
"kind": "msg",
"jp": [
"「推理小説じゃ定番ですが",
"現実にはそんな事件、",
"滅多に起きるもんじゃねえですから」"
]
},
{
"id": 31477,
"kind": "msg",
"jp": [
"「はっきり言って今の俺は",
"自分が正気なのかどうかも",
"わからねえくらいで・・・」"
]
},
{
"id": 31478,
"kind": "msg",
"jp": [
"「で・・でも・・・!",
"もし気のせいじゃなかったら?」"
]
},
{
"id": 31479,
"kind": "msg",
"jp": [
"「あの死体の格好も関係あって",
"犯人が何か暗示してるんだったら、",
"この先もまだ・・・」"
]
},
{
"id": 31480,
"kind": "msg",
"jp": [
"「・・・続くっていうの?",
"こんな・・・ことが・・・」"
]
},
{
"id": 31481,
"kind": "msg",
"jp": [
"「・・・やっぱ、",
"そう思いますかい」"
]
},
{
"id": 31482,
"kind": "msg",
"jp": [
"「・・・続く気がする。",
"そんなの嫌だけど・・・」"
]
},
{
"id": 31483,
"kind": "msg",
"jp": [
"「でも、何事もないんだったら",
"温室に物が増えてた意味が",
"わからないし・・・」"
]
},
{
"id": 31484,
"kind": "msg",
"jp": [
"「そんなこと・・・!",
"そんなことないよ、",
"続いたりしないと思う」"
]
},
{
"id": 31485,
"kind": "msg",
"jp": [
"「だって、本気で続けるつもり",
"だったらわざわざ温室に物を置いて",
"僕らに知らせたりしないだろ」"
]
},
{
"id": 31486,
"kind": "msg",
"jp": [
"「かえって警戒されてやりにくく",
"なるだけじゃないか。",
"現に暗石さん部屋にこもっちゃったし」"
]
},
{
"id": 31487,
"kind": "msg",
"jp": [
"「そりゃまあそうですが、",
"それなら斑井さんの時から温室に",
"変なもの置いたりしねえんじゃ?」"
]
},
{
"id": 31488,
"kind": "msg",
"jp": [
"「でもさ、斑井さんの時はまだ",
"誰もこんなことになるとは",
"思ってなかったじゃないか」"
]
},
{
"id": 31489,
"kind": "msg",
"jp": [
"「あれっきりだからこそ",
"犯人も大胆なことが出来たんじゃ",
"ないかと思うんだけど」"
]
},
{
"id": 31490,
"kind": "msg",
"jp": [
"「・・・なるほど。",
"確かにそう言われりゃそんな",
"気もしますね」"
]
},
{
"id": 31491,
"kind": "msg",
"jp": [
"「だってさ、どっちみちもう",
"続けようったって無理だよ」"
]
},
{
"id": 31492,
"kind": "msg",
"jp": [
"「そうですね、1人殺されちまって",
"ますから全員警戒してますからね」"
]
},
{
"id": 31493,
"kind": "msg",
"jp": [
"「うん、犯人だってそれくらい",
"予想してるだろうし・・・」"
]
},
{
"id": 31494,
"kind": "msg",
"jp": [
"「やっぱり、続かないし",
"続けられないと思うよ」"
]
},
{
"id": 31495,
"kind": "msg",
"jp": [
"「・・・かも知れませんね」"
]
},
{
"id": 31496,
"kind": "msg",
"jp": [
"「あ・・・",
"それもそうか・・・」"
]
},
{
"id": 31497,
"kind": "msg",
"jp": [
"「黙ってやるなら最初から",
"そうすればいいんだもんな」"
]
},
{
"id": 31498,
"kind": "msg",
"jp": [
"「もし温室に何も増えてなくても",
"最初があれじゃあ今となっては",
"警戒する人はしますぜ」"
]
},
{
"id": 31499,
"kind": "msg",
"jp": [
"暗石さんはひょっとしたら、温室に",
"変なものがなくても斑井さんが死んだ",
"時点で部屋にこもると言い出したかも。"
]
},
{
"id": 31500,
"kind": "msg",
"jp": [
"「最初からあれだけこれ見よがし",
"だったんですから、やっぱ続くんじゃ",
"ねえかなあ・・・」"
]
},
{
"id": 31501,
"kind": "msg",
"jp": [
"「だけど、もし・・・」"
]
},
{
"id": 31502,
"kind": "msg",
"jp": [
"「犯人がそんなふうに怖がらせようと",
"わざと次を暗示するようなことを",
"してるんだったら・・・」"
]
},
{
"id": 31503,
"kind": "msg",
"jp": [
"「・・・もう、",
"死人は見たくねえですね・・」"
]
},
{
"id": 31504,
"kind": "msg",
"jp": [
"「他の人は一作こっきりの",
"ゲストキャラなんですよ」"
]
},
{
"id": 31505,
"kind": "msg",
"jp": [
"「でも、だからって",
"放っておいてどんどん殺され",
"ちゃったら困るから・・・」"
]
},
{
"id": 31506,
"kind": "msg",
"jp": [
"「次に誰を狙うかっていう",
"順番は、何か理由があって",
"決めてんのかな、と」"
]
},
{
"id": 31507,
"kind": "msg",
"jp": [
"「ただ、表記が曖昧なせいもあって",
"ファンの間で解釈が違ってたり",
"するものあるんですが」"
]
},
{
"id": 31508,
"kind": "msg",
"jp": [
"「{和/なご}さんは抜くとして",
"ここにいるのは8人ですが、",
"人数分なんですかね?」"
]
},
{
"id": 31509,
"kind": "msg",
"jp": [
"「・・・どうだろう。",
"あ、静奈ちゃん達は双子だし、",
"1人1冊じゃないかも」"
]
},
{
"id": 31510,
"kind": "msg",
"jp": [
"「そうか、確か双子の姉妹が",
"出てくる話ありましたぜ」"
]
},
{
"id": 31511,
"kind": "msg",
"jp": [
"「本当?",
"だったら7冊かな・・・」"
]
},
{
"id": 31512,
"kind": "msg",
"jp": [
"「・・・いや、",
"それでも1冊多いのか・・・?」"
]
},
{
"id": 31513,
"kind": "msg",
"jp": [
"「それを過ぎちまったら、",
"もう誰も逃がしちゃくれねえでしょう」"
]
},
{
"id": 31514,
"kind": "msg",
"jp": [
"「まあ、でも・・・",
"それで犯人だと特定出来る",
"わけでもありませんから」"
]
},
{
"id": 31515,
"kind": "msg",
"jp": [
"「そうだね。",
"考え込んでてもしょうがないし、",
"それで一度やってみよう」"
]
},
{
"id": 31516,
"kind": "msg",
"jp": [
"「・・・まあ、ここで煮詰まってても",
"どうにもならねえし、ちょいと息抜き",
"して来ちゃあどうです?」"
]
},
{
"id": 31517,
"kind": "msg",
"jp": [
"「そうしようかな。",
"日織はここにいる?」"
]
},
{
"id": 31518,
"kind": "msg",
"jp": [
"「ええ、俺はずっとここに",
"いますから何かありゃ",
"声かけて下さいな」"
]
},
{
"id": 31519,
"kind": "msg",
"jp": [
"本棚の前を離れ、少し強ばった",
"肩を回しながら書斎を出た。"
]
},
{
"id": 31520,
"kind": "msg",
"jp": [
"「坊主か?",
"何か用か?」"
]
},
{
"id": 31521,
"kind": "msg",
"jp": [
"「あの、犯人・・・の、",
"ことなんですけど・・・」"
]
},
{
"id": 31522,
"kind": "msg",
"jp": [
"「犯人・・・?」"
]
},
{
"id": 31523,
"kind": "msg",
"jp": [
"「何かわかったのか、お前」"
]
},
{
"id": 31524,
"kind": "msg",
"jp": [
"「ちょっと待て」"
]
},
{
"id": 31525,
"kind": "msg",
"jp": [
"扉が開き、暗石さんが顔を出して",
"僕の肩越しに廊下を見回す。"
]
},
{
"id": 31526,
"kind": "msg",
"jp": [
"「お前1人だな」"
]
},
{
"id": 31527,
"kind": "msg",
"jp": [
"背筋に冷たい物が走る。",
"僕は1人で犯人かも知れない人と",
"対面してる・・・。"
]
},
{
"id": 31528,
"kind": "msg",
"jp": [
"「で、犯人がどうしたって?」"
]
},
{
"id": 31529,
"kind": "msg",
"jp": [
"「・・・・わ、わかった、",
"ような気がします・・・」"
]
},
{
"id": 31530,
"kind": "msg",
"jp": [
"暗石さんの表情が険しくなる。",
"思わず後ずさりそうになった。"
]
},
{
"id": 31531,
"kind": "msg",
"jp": [
"「誰だと思うんだ」"
]
},
{
"id": 31532,
"kind": "msg",
"jp": [
"「・・・く、暗石さん・・・」"
]
},
{
"id": 31533,
"kind": "msg",
"jp": [
"・・・何も言ってくれない。"
]
},
{
"id": 31534,
"kind": "msg",
"jp": [
"間違ってて怒ってるのかも、",
"当たってて否定しないのかも",
"わからなかった。"
]
},
{
"id": 31535,
"kind": "msg",
"jp": [
"「・・・俺が、部屋に引きこもってる",
"ふりして実はいろいろと動き回ってると",
"思ってるのか?」"
]
},
{
"id": 31536,
"kind": "msg",
"jp": [
"怖くて、頷くのが精一杯だった。",
"暗石さんの表情は変わらない。"
]
},
{
"id": 31537,
"kind": "msg",
"jp": [
"「しょうがねえ坊主だな」"
]
},
{
"id": 31538,
"kind": "msg",
"jp": [
"「ま、こんなことやってりゃ",
"アリバイがないのは俺だけだなんて",
"話にはいずれなるだろうと思ったが」"
]
},
{
"id": 31539,
"kind": "msg",
"jp": [
"「あ、あの、じゃあ・・・」"
]
},
{
"id": 31540,
"kind": "msg",
"jp": [
"「俺じゃねえよ」"
]
},
{
"id": 31541,
"kind": "msg",
"jp": [
"「もうちっと頼りになるかと",
"思ったんだが見当違いか・・・」"
]
},
{
"id": 31542,
"kind": "msg",
"jp": [
"「じゃあな、もう来るなよ」"
]
},
{
"id": 31543,
"kind": "msg",
"jp": [
"（怒るっていうより、",
"呆れてたような・・・）"
]
},
{
"id": 31544,
"kind": "msg",
"jp": [
"どうしよう。",
"多分、もう一度ノックしてももう",
"開けてくれないだろうな・・・。"
]
},
{
"id": 31545,
"kind": "msg",
"jp": [
"「暗石さん、すみません。",
"ちょっとだけ開けてもらえませんか?」"
]
},
{
"id": 31546,
"kind": "msg",
"jp": [
"扉を叩きながら声を掛けてみるが",
"中からは何の返事もない。"
]
},
{
"id": 31547,
"kind": "msg",
"jp": [
"「お願いします、暗石さん!",
"暗石さーん」"
]
},
{
"id": 31548,
"kind": "msg",
"jp": [
"そっと扉にくっついて",
"聞き耳を立ててみるが、",
"何も聞こえなかった。"
]
},
{
"id": 31549,
"kind": "msg",
"jp": [
"「・・・暗石さん。",
"あの、僕・・・犯人・・・」"
]
},
{
"id": 31550,
"kind": "msg",
"jp": [
"「この事件の犯人、",
"わかったと思うんです」"
]
},
{
"id": 31551,
"kind": "msg",
"jp": [
"「聞いてもらえないですか?",
"僕の推理が間違ってないか・・・」"
]
},
{
"id": 31552,
"kind": "msg",
"jp": [
"・・・扉越しに話してみるが、",
"やっぱり反応はなかった。"
]
},
{
"id": 31553,
"kind": "msg",
"jp": [
"「・・・・・駄目か」"
]
},
{
"id": 31554,
"kind": "msg",
"jp": [
"どうしようかな。",
"本人と話せないんじゃ、もうやめて",
"下さいって説得も出来ない・・・。"
]
},
{
"id": 31555,
"kind": "msg",
"jp": [
"・・・しばらく廊下で",
"うろうろしていたが",
"身体が冷えてきてしまった。"
]
},
{
"id": 31556,
"kind": "msg",
"jp": [
"（こんなところで悩んでても",
"どうしようもないし・・・）"
]
},
{
"id": 31557,
"kind": "msg",
"jp": [
"どうすればちゃんと話を",
"聞いてもらえるのかな・・・。"
]
},
{
"id": 31558,
"kind": "msg",
"jp": [
"コーヒー飲んだら部屋に戻って・・"
]
},
{
"id": 31559,
"kind": "msg",
"jp": [
"扉を叩くとすぐに返事があって",
"那須さんが顔を出した。"
]
},
{
"id": 31560,
"kind": "msg",
"jp": [
"「やあ、和くんか。",
"どうぞ」"
]
},
{
"id": 31561,
"kind": "msg",
"jp": [
"・・・相変わらず鍵掛けて",
"ないんだな、那須さん。"
]
},
{
"id": 31562,
"kind": "msg",
"jp": [
"（そりゃあ・・・",
"犯人だったら鍵なんか掛けて",
"なくても大丈夫だろうけど・・・）"
]
},
{
"id": 31563,
"kind": "msg",
"jp": [
"でも普通、一応警戒してるふりくらい",
"するもんだろうに。"
]
},
{
"id": 31564,
"kind": "msg",
"jp": [
"「ん? どうしたの難しい顔して」"
]
},
{
"id": 31565,
"kind": "msg",
"jp": [
"部屋の中には踏み込んだものの、",
"後ろ手にドアノブを持ったまま",
"閉める気にはなれない。"
]
},
{
"id": 31566,
"kind": "msg",
"jp": [
"この人に捕まったら僕なんか",
"逃げる暇もないだろうし・・・。"
]
},
{
"id": 31567,
"kind": "msg",
"jp": [
"「・・・もしかして、",
"また何かあった?」"
]
},
{
"id": 31568,
"kind": "msg",
"jp": [
"「そうじゃなくて、あの・・・」"
]
},
{
"id": 31569,
"kind": "msg",
"jp": [
"「・・・犯人、",
"わかったと、思います」"
]
},
{
"id": 31570,
"kind": "msg",
"jp": [
"「ええっ!?",
"本当にわかったのか!?」"
]
},
{
"id": 31571,
"kind": "msg",
"jp": [
"「すごいなあ、和くん!",
"僕も一応考えてはみたんだけど",
"全然わからなかったよ!」"
]
},
{
"id": 31572,
"kind": "msg",
"jp": [
"「じゃあもう、後は救助が来るの",
"待ってればいいんだよね。",
"早く来るといいねえ」"
]
},
{
"id": 31573,
"kind": "msg",
"jp": [
"「いえ、あの、",
"その犯人なんですけど・・・」"
]
},
{
"id": 31574,
"kind": "msg",
"jp": [
"「ああ、そう言えばどうしてるんだい?",
"どこかに捕まえてあるの?」"
]
},
{
"id": 31575,
"kind": "msg",
"jp": [
"「え・・・いえ、まだ・・・」"
]
},
{
"id": 31576,
"kind": "msg",
"jp": [
"目の前で笑ってます。",
"・・・って、なんだこの状況。"
]
},
{
"id": 31577,
"kind": "msg",
"jp": [
"「あれ、もしかして",
"逃げちゃったのかな?」"
]
},
{
"id": 31578,
"kind": "msg",
"jp": [
"「そうか、捕まえにいくのか!",
"そういうのは得意だよ、任せてくれ」"
]
},
{
"id": 31579,
"kind": "msg",
"jp": [
"「そ、そうじゃなくてっ・・・」"
]
},
{
"id": 31580,
"kind": "msg",
"jp": [
"もう、どこまで本気で言ってるのか",
"わからない・・・。"
]
},
{
"id": 31581,
"kind": "msg",
"jp": [
"とぼけてるだけにしては、あまりにも",
"朗らかすぎるというか。"
]
},
{
"id": 31582,
"kind": "msg",
"jp": [
"「逃げたわけじゃないの?」"
]
},
{
"id": 31583,
"kind": "msg",
"jp": [
"「違うんです、",
"捕まえたわけでも逃げたわけでも",
"なくてですね・・・」"
]
},
{
"id": 31584,
"kind": "msg",
"jp": [
"「あ・・・",
"ひょっとして死んじゃった、とか」"
]
},
{
"id": 31585,
"kind": "msg",
"jp": [
"「いえ、生きてます」"
]
},
{
"id": 31586,
"kind": "msg",
"jp": [
"「ん? じゃあどうして",
"捕まえないんだい?」"
]
},
{
"id": 31587,
"kind": "msg",
"jp": [
"「ま、まだ犯人ですよねって",
"確かめてなくて」"
]
},
{
"id": 31588,
"kind": "msg",
"jp": [
"「ああ、なんだ!",
"そういうことかぁ」"
]
},
{
"id": 31589,
"kind": "msg",
"jp": [
"「そ、そうです・・・」"
]
},
{
"id": 31590,
"kind": "msg",
"jp": [
"「そうかそうか、",
"今から行くのかぁ」"
]
},
{
"id": 31591,
"kind": "msg",
"jp": [
"「・・・で、誰なんだい?」"
]
},
{
"id": 31592,
"kind": "msg",
"jp": [
"「・・・・・・な、",
"那須さん・・・」"
]
},
{
"id": 31593,
"kind": "msg",
"jp": [
"「・・・は、犯人じゃあ・・・」"
]
},
{
"id": 31594,
"kind": "msg",
"jp": [
"「ああ、僕は違うよ。",
"うん、大丈夫」"
]
},
{
"id": 31595,
"kind": "msg",
"jp": [
"「それで、誰なの?",
"一緒に行って捕まえようか?」"
]
},
{
"id": 31596,
"kind": "msg",
"jp": [
"「えーと、あの・・・また来ます」"
]
},
{
"id": 31597,
"kind": "msg",
"jp": [
"「そう?",
"大変そうだったら",
"いつでも呼んでくれよ」"
]
},
{
"id": 31598,
"kind": "msg",
"jp": [
"「はい、お邪魔しました・・・」"
]
},
{
"id": 31599,
"kind": "msg",
"jp": [
"・・・あれは・・・。",
"本当に犯人じゃないのか、",
"ものすごく手ごわいのか。"
]
},
{
"id": 31600,
"kind": "msg",
"jp": [
"（もう、どっちなんだか",
"わけわかんなくなってきた・・・）"
]
},
{
"id": 31601,
"kind": "msg",
"jp": [
"何がまずかったんだろう。",
"話の切り出し方・・・とか、そういう",
"問題じゃないような気がするし。"
]
},
{
"id": 31602,
"kind": "msg",
"jp": [
"（あー、もう、こんなとこで",
"途方に暮れててもしょうがない）"
]
},
{
"id": 31603,
"kind": "msg",
"jp": [
"とぼとぼ歩きながら、さっきの",
"短い会話を頭の中で思い返す。"
]
},
{
"id": 31604,
"kind": "msg",
"jp": [
"「・・・静奈ちゃん、いる?」"
]
},
{
"id": 31605,
"kind": "msg",
"jp": [
"小さく返事が聞こえて、",
"そっと扉が開いた。"
]
},
{
"id": 31606,
"kind": "msg",
"jp": [
"「あ、えっと・・・",
"ちょっといいかな」"
]
},
{
"id": 31607,
"kind": "msg",
"jp": [
"こくんと頷いて、僕の言葉を",
"待つようにじっと見つめてくる。"
]
},
{
"id": 31608,
"kind": "msg",
"jp": [
"（・・・何て言おう）"
]
},
{
"id": 31609,
"kind": "msg",
"jp": [
"どう切り出そうか考えてなかった",
"ということに、今更気が付いた。"
]
},
{
"id": 31610,
"kind": "msg",
"jp": [
"事が事だけに、下手な言い方は",
"出来ないし・・・。"
]
},
{
"id": 31611,
"kind": "msg",
"jp": [
"「あ・・・あのさ・・・」"
]
},
{
"id": 31612,
"kind": "msg",
"jp": [
"「この事件の、犯人・・・」"
]
},
{
"id": 31613,
"kind": "msg",
"jp": [
"「うちやないよ」"
]
},
{
"id": 31614,
"kind": "msg",
"jp": [
"「え・・・えっ?」"
]
},
{
"id": 31615,
"kind": "msg",
"jp": [
"核心に触れる前に、ずばりと",
"否定されて僕の方がうろたえて",
"しまった。"
]
},
{
"id": 31616,
"kind": "msg",
"jp": [
"「疑うてるでしょ」"
]
},
{
"id": 31617,
"kind": "msg",
"jp": [
"「・・・な、なんで・・・」"
]
},
{
"id": 31618,
"kind": "msg",
"jp": [
"「そんな改まった顔して、",
"言いにくそうにしてたらわかる」"
]
},
{
"id": 31619,
"kind": "msg",
"jp": [
"・・・参った。",
"そんなに顔に出てたのかな。"
]
},
{
"id": 31620,
"kind": "msg",
"jp": [
"「けど、うち違う」"
]
},
{
"id": 31621,
"kind": "msg",
"jp": [
"「・・・えっと、でも」"
]
},
{
"id": 31622,
"kind": "msg",
"jp": [
"「うちが犯人やったら、",
"あんなこと言わんよ」"
]
},
{
"id": 31623,
"kind": "msg",
"jp": [
"「あんなこと?」"
]
},
{
"id": 31624,
"kind": "msg",
"jp": [
"「猫・・・?」"
]
},
{
"id": 31625,
"kind": "msg",
"jp": [
"「『猫は斑井さん』って。",
"わざわざ教えたりせんし」"
]
},
{
"id": 31626,
"kind": "msg",
"jp": [
"「あと、斑井さんが死んでるの",
"知ってたら朝1人で台所におるなんて",
"怪しいこともせんと思う」"
]
},
{
"id": 31627,
"kind": "msg",
"jp": [
"「それに、うちがもし",
"どうしても誰か殺したいと思たらね」"
]
},
{
"id": 31628,
"kind": "msg",
"jp": [
"「・・・鈴奈だけはつれて来ぇへん」"
]
},
{
"id": 31629,
"kind": "msg",
"jp": [
"何も言い返せなかった・・・。"
]
},
{
"id": 31630,
"kind": "msg",
"jp": [
"閉ざされた扉の前で、",
"しばし呆然と立ち尽くす。"
]
},
{
"id": 31631,
"kind": "msg",
"jp": [
"（・・・猫のことも、",
"台所にいたことも・・・）"
]
},
{
"id": 31632,
"kind": "msg",
"jp": [
"何もかも、こうして疑われたときに",
"言い返すためにわざとやっていたこと",
"かもしれないのに・・・。"
]
},
{
"id": 31633,
"kind": "msg",
"jp": [
"（なんか、今の様子だと",
"そう言い返してみても・・・）"
]
}
]