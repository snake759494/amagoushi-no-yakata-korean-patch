[
{
"id": 20334,
"kind": "msg",
"jp": [
"「・・・シビアなんだね」"
]
},
{
"id": 20335,
"kind": "msg",
"jp": [
"「あと、最後の方のイベントで",
"その時点で一番レベル高いキャラが",
"強制的に死ぬ設定がきついな」"
]
},
{
"id": 20336,
"kind": "msg",
"jp": [
"「最初ランダムかと思って",
"たんだけどなー」"
]
},
{
"id": 20337,
"kind": "msg",
"jp": [
"「あとで攻略本みたら最高レベルの",
"キャラがアメフラシに飲み込まれます",
"とか書いてあってびびったよ」"
]
},
{
"id": 20338,
"kind": "msg",
"jp": [
"「・・・それ、主人公が",
"一番強かったらどうなるの?」"
]
},
{
"id": 20339,
"kind": "msg",
"jp": [
"「うん、オレそれで初回の",
"プレイの時ゲームオーバーになった」"
]
},
{
"id": 20340,
"kind": "msg",
"jp": [
"「あ、あのな、でもな、",
"一回ハマるとやみつきに",
"なるんだって、マジで!」"
]
},
{
"id": 20341,
"kind": "msg",
"jp": [
"なんとなく、数限りない困難を",
"乗り越えて変な脳内麻薬が出るんじゃ",
"ないかって気がするけど・・・。"
]
},
{
"id": 20342,
"kind": "msg",
"jp": [
"「あかつきの白いバラっていう",
"ドラマ知ってる?」"
]
},
{
"id": 20343,
"kind": "msg",
"jp": [
"「・・・なんか、",
"異常に運の悪い不吉な話だろ?」"
]
},
{
"id": 20344,
"kind": "msg",
"jp": [
"「業界の先輩もさ、",
"妙に話したがらねーんだよな、",
"あのドラマのことだけは」"
]
},
{
"id": 20345,
"kind": "msg",
"jp": [
"「ああ、古いらしいぜ」"
]
},
{
"id": 20346,
"kind": "msg",
"jp": [
"「あー、明治時代に",
"海外から解体して持ち込まれた",
"ものだそうでございます」"
]
},
{
"id": 20347,
"kind": "msg",
"jp": [
"「海外から?",
"昔は外国に建ってたんだ」"
]
},
{
"id": 20348,
"kind": "msg",
"jp": [
"「さようでございます。",
"書斎に、その辺りのことが書かれた",
"本もございます」"
]
},
{
"id": 20349,
"kind": "msg",
"jp": [
"「・・・ただなぁ」"
]
},
{
"id": 20350,
"kind": "msg",
"jp": [
"「ちょっと気になってる",
"ことがあってな」"
]
},
{
"id": 20351,
"kind": "msg",
"jp": [
"「全部の部屋じゃねーんだけど",
"部屋の隅に変な穴が開いてる",
"とこがあるんだけどよ」"
]
},
{
"id": 20352,
"kind": "msg",
"jp": [
"「穴じゃなくて模様がついてる",
"だけだった気がするんだよな、元は」"
]
},
{
"id": 20353,
"kind": "msg",
"jp": [
"「なんか、真ん中だけぽっかり",
"なくなったみてーになってんだよ。",
"縁だけ残ってて空洞なの」"
]
},
{
"id": 20354,
"kind": "msg",
"jp": [
"「何が入ってたの?」"
]
},
{
"id": 20355,
"kind": "msg",
"jp": [
"「オレも知らねーよ。",
"模様だと思ってたし真ん中だけ",
"取れるなんて知らねーもん」"
]
},
{
"id": 20356,
"kind": "msg",
"jp": [
"「それって、椿くんが",
"来たときから?」"
]
},
{
"id": 20357,
"kind": "msg",
"jp": [
"「ああ、オレが着いてすぐ",
"館の中見て回った時にはもう",
"そうなってた」"
]
},
{
"id": 20358,
"kind": "msg",
"jp": [
"「ふーん・・・",
"何が入ってたんだろう」"
]
},
{
"id": 20359,
"kind": "msg",
"jp": [
"「わかんねーな。",
"妙なガラクタは大抵物置に放り込んで",
"あると思って捜したんだが・・・」"
]
},
{
"id": 20360,
"kind": "msg",
"jp": [
"「なかったの?」"
]
},
{
"id": 20361,
"kind": "msg",
"jp": [
"「それっぽいもんは",
"見当たらなかったな」"
]
},
{
"id": 20362,
"kind": "msg",
"jp": [
"「あとはあるとすりゃ",
"地下室かなぁ・・・?",
"そっちは見てねーけどよ」"
]
},
{
"id": 20363,
"kind": "msg",
"jp": [
"「地下・・・」"
]
},
{
"id": 20364,
"kind": "msg",
"jp": [
"「まあ、別になくても",
"外まで穴が突き抜けてるって",
"わけでもねーみてえだし」"
]
},
{
"id": 20365,
"kind": "msg",
"jp": [
"「じゃあ別に心配はないのかな」"
]
},
{
"id": 20366,
"kind": "msg",
"jp": [
"「だと思うぜ。",
"まあ、ちょっと",
"気になっただけだ」"
]
},
{
"id": 20367,
"kind": "msg",
"jp": [
"「あのさ、鍵閉めた後",
"食堂に入ったことある?」"
]
},
{
"id": 20368,
"kind": "msg",
"jp": [
"「ねえよ、んなもん。",
"何しに入るんだ」"
]
},
{
"id": 20369,
"kind": "msg",
"jp": [
"「あの後、娯楽室は鍵閉めて",
"あるんだけどさ・・・」"
]
},
{
"id": 20370,
"kind": "msg",
"jp": [
"「娯楽室なあ・・・",
"オレが最後に入ったのって",
"2日目の夜だからなあ」"
]
},
{
"id": 20371,
"kind": "msg",
"jp": [
"「あれが最後?」"
]
},
{
"id": 20372,
"kind": "msg",
"jp": [
"「ああ、あれっきりだな」"
]
},
{
"id": 20373,
"kind": "msg",
"jp": [
"「あのさ、井戸って",
"一応蓋閉まってたんだよね?」"
]
},
{
"id": 20374,
"kind": "msg",
"jp": [
"「そのはずだけどな。",
"けど釘とか錆びてたからな・・・」"
]
},
{
"id": 20375,
"kind": "msg",
"jp": [
"「蓋はあんまり役になってなかった",
"かもしれない?」"
]
},
{
"id": 20376,
"kind": "msg",
"jp": [
"「だと思うぜ。",
"簡単に開いたんじゃねえかな」"
]
},
{
"id": 20377,
"kind": "msg",
"jp": [
"「椿くんの部屋はベランダないんだね」"
]
},
{
"id": 20378,
"kind": "msg",
"jp": [
"「ああ、ベランダがあるのは",
"あっち側・・・女性陣がいる方の",
"部屋だけだよ」"
]
},
{
"id": 20379,
"kind": "msg",
"jp": [
"「なんでそういう構造なんだろう?」"
]
},
{
"id": 20380,
"kind": "msg",
"jp": [
"「そこまで知らねえよ、オレも」"
]
},
{
"id": 20381,
"kind": "msg",
"jp": [
"「ただ、この館って元は海外に",
"建ってた城らしいからな」"
]
},
{
"id": 20382,
"kind": "msg",
"jp": [
"「こっち側にはベランダがあっても",
"意味ないような場所に建ってたの",
"かもしれねえけど」"
]
},
{
"id": 20383,
"kind": "msg",
"jp": [
"「そっか、ここみたいに四方が",
"見渡せる環境じゃなかったのかもね」"
]
},
{
"id": 20384,
"kind": "msg",
"jp": [
"「居間にあるテラスって",
"晴れてたら気持ちよさそうな感じだね」"
]
},
{
"id": 20385,
"kind": "msg",
"jp": [
"「今はちょっと、アレのせいで",
"天気がどうだろうと不気味な景観に",
"なってるけどな」"
]
},
{
"id": 20386,
"kind": "msg",
"jp": [
"「アレ?」"
]
},
{
"id": 20387,
"kind": "msg",
"jp": [
"「てるてる坊主だよ。",
"でかすぎるだろ」"
]
},
{
"id": 20388,
"kind": "msg",
"jp": [
"「あ・・・",
"う、うん、まあね」"
]
},
{
"id": 20389,
"kind": "msg",
"jp": [
"でも外せとは言わない辺り、やっぱり",
"効き目あるといいなと思ってるのかな。"
]
},
{
"id": 20390,
"kind": "msg",
"jp": [
"「ここの温室ってすごいね」"
]
},
{
"id": 20391,
"kind": "msg",
"jp": [
"「ああ、なんかあれは後から",
"建て増しされたらしいぜ」"
]
},
{
"id": 20392,
"kind": "msg",
"jp": [
"「そう聞いてるけどな。",
"別に温室じゃなくても",
"よかったらしいけど」"
]
},
{
"id": 20393,
"kind": "msg",
"jp": [
"「え? どういうこと?」"
]
},
{
"id": 20394,
"kind": "msg",
"jp": [
"「なんだか知らねえけど、",
"あの場所に何か建てたかったんだと」"
]
},
{
"id": 20395,
"kind": "msg",
"jp": [
"「ふうん・・・。",
"なんでだろうね」"
]
},
{
"id": 20396,
"kind": "msg",
"jp": [
"「さあな。",
"館がこんな形だからぽっかり庭が",
"空いてんのが嫌だったんじゃねえの」"
]
},
{
"id": 20397,
"kind": "msg",
"jp": [
"そうなのかな・・・。",
"だったら建物じゃなくて花壇とか",
"でもいいような気がするけど。"
]
},
{
"id": 20398,
"kind": "msg",
"jp": [
"「あのさ、台所って・・・」"
]
},
{
"id": 20399,
"kind": "msg",
"jp": [
"「あー、なんか嫌だよな",
"台所は・・・」"
]
},
{
"id": 20400,
"kind": "msg",
"jp": [
"「嫌って何が?」"
]
},
{
"id": 20401,
"kind": "msg",
"jp": [
"「だって凶器になりそうなもん",
"山ほどあるじゃん」"
]
},
{
"id": 20402,
"kind": "msg",
"jp": [
"「ああ、なるほどね。",
"それはそうだね」"
]
},
{
"id": 20403,
"kind": "msg",
"jp": [
"「応接室って今は使ってないの?」"
]
},
{
"id": 20404,
"kind": "msg",
"jp": [
"「ないだろ。",
"だってオレらしかいねーのに",
"使い道ねえじゃん」"
]
},
{
"id": 20405,
"kind": "msg",
"jp": [
"「娯楽室に置いてあるものって",
"この館の人の趣味なのかな」"
]
},
{
"id": 20406,
"kind": "msg",
"jp": [
"「いや、あれも元から館に",
"ついてたらしいぜ。",
"海外から持ち込んだときのままだとさ」"
]
},
{
"id": 20407,
"kind": "msg",
"jp": [
"「そうなの?",
"じゃあけっこう高いものだったり",
"するのかな・・・」"
]
},
{
"id": 20408,
"kind": "msg",
"jp": [
"「よくわかんねーけど、",
"高いかもな」"
]
},
{
"id": 20409,
"kind": "msg",
"jp": [
"「あんま触りまくって壊すなよ」"
]
},
{
"id": 20410,
"kind": "msg",
"jp": [
"「書斎の本棚すごいね。",
"なんか洋書とかもあるし」"
]
},
{
"id": 20411,
"kind": "msg",
"jp": [
"「洋書の方は元からあった",
"らしいぜ」"
]
},
{
"id": 20412,
"kind": "msg",
"jp": [
"「・・・日本語の本は今の",
"当主の趣味だけど」"
]
},
{
"id": 20413,
"kind": "msg",
"jp": [
"「へえ、じゃあ今の当主の人は",
"高遠さんのファンなんだ」"
]
},
{
"id": 20414,
"kind": "msg",
"jp": [
"「・・・うん、まあ一応」"
]
},
{
"id": 20415,
"kind": "msg",
"jp": [
"「いや、なんでもない」"
]
},
{
"id": 20416,
"kind": "msg",
"jp": [
"「何? どうしたの?」"
]
},
{
"id": 20417,
"kind": "msg",
"jp": [
"「いいから気にすんな!",
"なんでも・・・」"
]
},
{
"id": 20418,
"kind": "msg",
"jp": [
"「椿くん?」"
]
},
{
"id": 20419,
"kind": "msg",
"jp": [
"「・・・和」"
]
},
{
"id": 20420,
"kind": "msg",
"jp": [
"「あれは、この館の当主の趣味で",
"あってオレは一切関係ないからな」"
]
},
{
"id": 20421,
"kind": "msg",
"jp": [
"「へ? あれって・・・?」"
]
},
{
"id": 20422,
"kind": "msg",
"jp": [
"「あれとか、あれとか、",
"本棚にあるああいうのだよ!」"
]
},
{
"id": 20423,
"kind": "msg",
"jp": [
"「・・・よ、よくわからないけど",
"ここの当主って・・・その・・・」"
]
},
{
"id": 20424,
"kind": "msg",
"jp": [
"「・・・ちょっと、変わった人?」"
]
},
{
"id": 20425,
"kind": "msg",
"jp": [
"「ちょっとじゃな・・・あ、いや、",
"まあとにかくオレには関係ないぞ」"
]
},
{
"id": 20426,
"kind": "msg",
"jp": [
"「・・・うん、わかった・・・」"
]
},
{
"id": 20427,
"kind": "msg",
"jp": [
"ものすごく複雑な顔してるけど、",
"どれのことを言ってるんだろう・・。"
]
},
{
"id": 20428,
"kind": "msg",
"jp": [
"「物置の中にもなんだか",
"いろいろ入ってるね」"
]
},
{
"id": 20429,
"kind": "msg",
"jp": [
"「お前は那須と同レベルか」"
]
},
{
"id": 20430,
"kind": "msg",
"jp": [
"「あいつもおもしろがって",
"のぞいてたけど、ガラクタしか",
"ねーだろ」"
]
},
{
"id": 20431,
"kind": "msg",
"jp": [
"「・・・那須さん、何かしたの?」"
]
},
{
"id": 20432,
"kind": "msg",
"jp": [
"「とりあえず、目に付いたもの",
"片っ端から持ち上げてみねーと",
"気がすまんらしい」"
]
},
{
"id": 20433,
"kind": "msg",
"jp": [
"もしかしてあの人の基準って",
"自分の腕力で持ち上がるかどうか",
"なんだろうか・・・。"
]
},
{
"id": 20434,
"kind": "msg",
"jp": [
"「椿くんの部屋も",
"他と同じ客室なの?」"
]
},
{
"id": 20435,
"kind": "msg",
"jp": [
"「いや、オレんとこは実は",
"当主の部屋なんだよ」"
]
},
{
"id": 20436,
"kind": "msg",
"jp": [
"「なんで執事なのに",
"当主の部屋なんだろうとは",
"思ったけどさ」"
]
},
{
"id": 20437,
"kind": "msg",
"jp": [
"「執事部屋っていうのは",
"ないんだ」"
]
},
{
"id": 20438,
"kind": "msg",
"jp": [
"「それはねーけど、",
"お前らの部屋は元は使用人部屋",
"なんだけどな」"
]
},
{
"id": 20439,
"kind": "msg",
"jp": [
"「そっか。",
"でも、普段から本当に",
"使用人とかいるの?」"
]
},
{
"id": 20440,
"kind": "msg",
"jp": [
"「さすがにいねーよ。",
"家具なんかも元からついてたの",
"そのまんまなだけだよ」"
]
},
{
"id": 20441,
"kind": "msg",
"jp": [
"「布団だのカーテンだのは",
"新しいけど」"
]
},
{
"id": 20442,
"kind": "msg",
"jp": [
"「2階に1部屋だけ他となんか",
"違う部屋があるけど、あれって・・・」"
]
},
{
"id": 20443,
"kind": "msg",
"jp": [
"「あー・・・",
"あれは当主の部屋だ」"
]
},
{
"id": 20444,
"kind": "msg",
"jp": [
"「やっぱりそうなんだ?",
"じゃあ、なんで開かずの間なんて",
"呼ばれてんの?」"
]
},
{
"id": 20445,
"kind": "msg",
"jp": [
"「本人がここに来ると",
"あの部屋から出て来なくなるんだよ」"
]
},
{
"id": 20446,
"kind": "msg",
"jp": [
"「あはは、そういう意味だったんだ」"
]
},
{
"id": 20447,
"kind": "msg",
"jp": [
"「・・・今はな」"
]
},
{
"id": 20448,
"kind": "msg",
"jp": [
"「今は・・・?」"
]
},
{
"id": 20449,
"kind": "msg",
"jp": [
"「昔、この館が外国の元あった",
"場所に建ってた頃は、本来の意味",
"だったらしいけど」"
]
},
{
"id": 20450,
"kind": "msg",
"jp": [
"「ほ・・・本来の意味って・・・」"
]
},
{
"id": 20451,
"kind": "msg",
"jp": [
"「封印されてたらしいぜ。",
"誰も入らねーように」"
]
},
{
"id": 20452,
"kind": "msg",
"jp": [
"「さあ・・・?",
"オレはそこまで知らねーけど」"
]
},
{
"id": 20453,
"kind": "msg",
"jp": [
"「・・・でも、まあ封印される",
"くらいだからそれなりに嫌なことが",
"あったんじゃねーの?」"
]
},
{
"id": 20454,
"kind": "msg",
"jp": [
"「2階にも奥のほうに納戸が",
"あるんだね」"
]
},
{
"id": 20455,
"kind": "msg",
"jp": [
"「ああ、そういやあったな」"
]
},
{
"id": 20456,
"kind": "msg",
"jp": [
"「予備の家具やらカーテンやらが",
"しまってあるだけだろ」"
]
},
{
"id": 20457,
"kind": "msg",
"jp": [
"「地下室まであるってすごいね」"
]
},
{
"id": 20458,
"kind": "msg",
"jp": [
"「つってもボイラーと倉庫が",
"あるだけだからなあ」"
]
},
{
"id": 20459,
"kind": "msg",
"jp": [
"「昔の海外のお屋敷なんて",
"あれくらい普通なんじゃねえの」"
]
},
{
"id": 20460,
"kind": "msg",
"jp": [
"「あのさ、地下に迷路みたいなのが",
"あったんだけど・・・」"
]
},
{
"id": 20461,
"kind": "msg",
"jp": [
"「はぁ!? なんだそりゃ!?」"
]
},
{
"id": 20462,
"kind": "msg",
"jp": [
"「あ、椿くんも知らなかったんだ」"
]
},
{
"id": 20463,
"kind": "msg",
"jp": [
"「全然知らねーよ、そんなの。",
"マジであんのか、そんなもん」"
]
},
{
"id": 20464,
"kind": "msg",
"jp": [
"「うん、隠し通路とか",
"そんな感じだった」"
]
},
{
"id": 20465,
"kind": "msg",
"jp": [
"「・・・なんであるんだ",
"そんなもん・・・」"
]
},
{
"id": 20466,
"kind": "msg",
"jp": [
"「・・・知ってんのかな」"
]
},
{
"id": 20467,
"kind": "msg",
"jp": [
"「え? 誰が? 犯人?」"
]
},
{
"id": 20468,
"kind": "msg",
"jp": [
"「じゃねーよ、ここの今の当主は",
"そのこと・・・ああ、そうか。",
"犯人の方も問題だな」"
]
},
{
"id": 20469,
"kind": "msg",
"jp": [
"「大問題だよ」"
]
},
{
"id": 20470,
"kind": "msg",
"jp": [
"「・・・そこに隠れてたり",
"しねーかな」"
]
},
{
"id": 20471,
"kind": "msg",
"jp": [
"「ぼ、僕が見た限りでは",
"誰もいなかったけど」"
]
},
{
"id": 20472,
"kind": "msg",
"jp": [
"「そうか・・・。",
"でも、なんか気味悪ぃな」"
]
},
{
"id": 20473,
"kind": "msg",
"jp": [
"「誰か隠れてるんじゃなくても、",
"なんか物隠すにしたって",
"絶好の場所っぽいじゃん」"
]
},
{
"id": 20474,
"kind": "msg",
"jp": [
"「ああ、うん。",
"それはそうだね・・・」"
]
},
{
"id": 20475,
"kind": "msg",
"jp": [
"うっかり危険な物見逃してたり",
"したら大変だな・・・。"
]
},
{
"id": 20476,
"kind": "msg",
"jp": [
"「裏庭の井戸って元から",
"使ってなかったの?」"
]
},
{
"id": 20477,
"kind": "msg",
"jp": [
"「使ってねえはずだぜ。",
"蓋閉まってただろ」"
]
},
{
"id": 20478,
"kind": "msg",
"jp": [
"「うん、閉まってた」"
]
},
{
"id": 20479,
"kind": "msg",
"jp": [
"そっか、普段からもう使われて",
"ない井戸なのか。"
]
},
{
"id": 20480,
"kind": "msg",
"jp": [
"「名前?",
"ああ、全部海外の作家の",
"名前だけどどうかしたか?」"
]
},
{
"id": 20481,
"kind": "msg",
"jp": [
"「椿くんはその人達の",
"小説読んだことある?」"
]
},
{
"id": 20482,
"kind": "msg",
"jp": [
"「あー、なんか国名シリーズ",
"てのが有名だからとかなんとか",
"説明されたけどさ、日織に」"
]
},
{
"id": 20483,
"kind": "msg",
"jp": [
"「翻訳物って苦手なんだよ。",
"文章カタくて読みにくくねえ?」"
]
},
{
"id": 20484,
"kind": "msg",
"jp": [
"「ああ、国内のよりは",
"ちょっとかたいかもね」"
]
},
{
"id": 20485,
"kind": "msg",
"jp": [
"「だよなぁ?",
"日織とか静奈とかは、",
"慣れたら平気だとか言ってたけど」"
]
},
{
"id": 20486,
"kind": "msg",
"jp": [
"「ようするに慣れるほど",
"読まなきゃ駄目ってことだよね」"
]
},
{
"id": 20487,
"kind": "msg",
"jp": [
"「勘弁してくれ・・・」"
]
},
{
"id": 20488,
"kind": "msg",
"jp": [
"「あのさ・・・",
"那須さんが飲んだお茶なんだけどさ」"
]
},
{
"id": 20489,
"kind": "msg",
"jp": [
"「・・・あれな。",
"台所にあったやつだろ」"
]
},
{
"id": 20490,
"kind": "msg",
"jp": [
"「うん、冷蔵庫に」"
]
},
{
"id": 20491,
"kind": "msg",
"jp": [
"「箱で置いてあったやつ",
"オレが冷蔵庫に突っ込んだんだよ」"
]
},
{
"id": 20492,
"kind": "msg",
"jp": [
"「初日にな。",
"来てすぐだよ」"
]
},
{
"id": 20493,
"kind": "msg",
"jp": [
"「そうだったんだ・・・",
"それまでは箱に入ってたんだ?」"
]
},
{
"id": 20494,
"kind": "msg",
"jp": [
"「ああ、オレが開けたんだよ」"
]
},
{
"id": 20495,
"kind": "msg",
"jp": [
"だったら、それ以前に毒が",
"入れられてたなんてことは",
"まずないな・・・。"
]
},
{
"id": 20496,
"kind": "msg",
"jp": [
"「・・・あのさ。",
"毒薬ってさ・・・」"
]
},
{
"id": 20497,
"kind": "msg",
"jp": [
"「あれな・・・",
"変だと思わね?」"
]
},
{
"id": 20498,
"kind": "msg",
"jp": [
"「なんで最初から全員に",
"毒盛らねえんだ?」"
]
},
{
"id": 20499,
"kind": "msg",
"jp": [
"「毒なんか持ってたんなら",
"こんな手間暇掛ける必要ねえじゃん」"
]
},
{
"id": 20500,
"kind": "msg",
"jp": [
"多分、犯人は・・・。",
"単に全員を殺したいだけじゃなくて",
"別に意図があるんだろうな・・・。"
]
},
{
"id": 20501,
"kind": "msg",
"jp": [
"「暗石さんの部屋に薔薇の絵が",
"置いてあったんだけどさ・・・」"
]
},
{
"id": 20502,
"kind": "msg",
"jp": [
"「薔薇の絵?」"
]
},
{
"id": 20503,
"kind": "msg",
"jp": [
"「うん、暗石さんの部屋の",
"壁には別の絵がかかってたから",
"他から持ってきておいたみたい」"
]
},
{
"id": 20504,
"kind": "msg",
"jp": [
"「薔薇ってーと・・・",
"応接室にあったやつか」"
]
},
{
"id": 20505,
"kind": "msg",
"jp": [
"「応接室・・・」"
]
},
{
"id": 20506,
"kind": "msg",
"jp": [
"「いや、はっきり断言できねーけど",
"確かそうだった気がする」"
]
},
{
"id": 20507,
"kind": "msg",
"jp": [
"「そっか、ありがと」"
]
},
{
"id": 20508,
"kind": "msg",
"jp": [
"「あの・・・",
"暗石さんが撃たれた矢ってさ・・・」"
]
},
{
"id": 20509,
"kind": "msg",
"jp": [
"「・・・この館、あちこちに",
"武器あるからな・・・」"
]
},
{
"id": 20510,
"kind": "msg",
"jp": [
"「大半は飾りだと思うんだが",
"どっかに実際撃てる弓矢も",
"あったのかもな・・・」"
]
},
{
"id": 20511,
"kind": "msg",
"jp": [
"「館の中にあったっていう",
"可能性はあるんだ」"
]
},
{
"id": 20512,
"kind": "msg",
"jp": [
"「あると思うぜ」"
]
},
{
"id": 20513,
"kind": "msg",
"jp": [
"「あの・・・斧ってさ、",
"壁に飾られてたやつだよね」"
]
},
{
"id": 20514,
"kind": "msg",
"jp": [
"「確かに飾ってあったな・・・。",
"それは覚えてるんだが、いつの間に",
"持ち出されてたんだかわかんねえよ」"
]
},
{
"id": 20515,
"kind": "msg",
"jp": [
"「あのてるてる坊主、",
"効き目あるかな」"
]
},
{
"id": 20516,
"kind": "msg",
"jp": [
"「さあな・・・",
"作ったヤツが脳天気だから",
"あるかもな」"
]
},
{
"id": 20517,
"kind": "msg",
"jp": [
"「そういう問題なの?」"
]
},
{
"id": 20518,
"kind": "msg",
"jp": [
"「無駄にでかいしな。",
"まあ、変な場所に吊るしてないだけ",
"いいけどよ・・・」"
]
},
{
"id": 20519,
"kind": "msg",
"jp": [
"「あの馬鹿、最初あれ2階の吹き抜けに",
"吊るしてやがったんだからな」"
]
},
{
"id": 20520,
"kind": "msg",
"jp": [
"「トイレ行こうとして部屋出たら",
"なんか人影っぽいのが見えて",
"めちゃめちゃびびったっつーの」"
]
},
{
"id": 20521,
"kind": "msg",
"jp": [
"「まあ・・・",
"夜中にそれは怖いよね」"
]
},
{
"id": 20522,
"kind": "msg",
"jp": [
"「夜中っつーほどじゃねえけど",
"11時は過ぎてたからな」"
]
},
{
"id": 20523,
"kind": "msg",
"jp": [
"「11時半・・・いや、20分か",
"そこらだったかなあ」"
]
},
{
"id": 20524,
"kind": "msg",
"jp": [
"「十分怖いよ・・・」"
]
},
{
"id": 20525,
"kind": "msg",
"jp": [
"「温室にあった『復讐』って",
"書いてある紙のことなんだけど」"
]
},
{
"id": 20526,
"kind": "msg",
"jp": [
"「ああ、あれがどうした?」"
]
},
{
"id": 20527,
"kind": "msg",
"jp": [
"「いつ置かれたのかなと思って。",
"椿くん館に着いてから昼の間に",
"温室に入った?」"
]
},
{
"id": 20528,
"kind": "msg",
"jp": [
"「・・・そういや、館にはオレが",
"一番最初に着いたんだが・・・」"
]
},
{
"id": 20529,
"kind": "msg",
"jp": [
"「来てすぐに館の中一通り",
"見て回ったときにはなかったな」"
]
},
{
"id": 20530,
"kind": "msg",
"jp": [
"「本当?",
"それって何時ごろ?」"
]
},
{
"id": 20531,
"kind": "msg",
"jp": [
"「昼ちょっと過ぎ・・・",
"ああ、着いてすぐ大時計が鳴ったから",
"1時だな」"
]
},
{
"id": 20532,
"kind": "msg",
"jp": [
"「温室にあった猫の置物って",
"元からこの館にあったのかな?」"
]
},
{
"id": 20533,
"kind": "msg",
"jp": [
"「いや、あれは違うんじゃねえか。",
"この館変なものいっぱいあるけど、",
"あれは見覚えねえし・・・」"
]
},
{
"id": 20534,
"kind": "msg",
"jp": [
"「そっか。",
"なんとなく他の置物とかとも",
"雰囲気違うもんね」"
]
},
{
"id": 20535,
"kind": "msg",
"jp": [
"「つーか、その辺でいくらでも",
"売ってそうじゃん、あれ」"
]
},
{
"id": 20536,
"kind": "msg",
"jp": [
"「ここの電話って内線だけ",
"なんだよね、どの部屋も」"
]
},
{
"id": 20537,
"kind": "msg",
"jp": [
"「ああ、外に通じてくれてりゃ",
"楽だったんだがなあ・・・」"
]
},
{
"id": 20538,
"kind": "msg",
"jp": [
"「・・・そういや・・・」"
]
},
{
"id": 20539,
"kind": "msg",
"jp": [
"「なんか斑井のオッサンの部屋で",
"電話が鳴ってたな・・・」"
]
},
{
"id": 20540,
"kind": "msg",
"jp": [
"「えっ? それいつ?」"
]
},
{
"id": 20541,
"kind": "msg",
"jp": [
"「死ぬ前だよ、もちろん。",
"最初の日の夜だ」"
]
},
{
"id": 20542,
"kind": "msg",
"jp": [
"「確かオレが部屋出てトイレ",
"行くより前だったと思う」"
]
},
{
"id": 20543,
"kind": "msg",
"jp": [
"「・・・それって、誰から",
"だったんだろう・・・」"
]
},
{
"id": 20544,
"kind": "msg",
"jp": [
"「誰ってそりゃあ、",
"あの夜オッサンと電話で話したなんて",
"誰も言い出さないってことは・・・」"
]
},
{
"id": 20545,
"kind": "msg",
"jp": [
"「・・・・犯人?」"
]
},
{
"id": 20546,
"kind": "msg",
"jp": [
"「なんじゃねえの」"
]
},
{
"id": 20547,
"kind": "msg",
"jp": [
"斑井さんはその内線電話で呼び出されて",
"食堂へ行った、のかな・・・。"
]
},
{
"id": 20548,
"kind": "msg",
"jp": [
"「え、ちょっと待って。",
"内線って館の中のじゃないと",
"つながらないよね?」"
]
},
{
"id": 20549,
"kind": "msg",
"jp": [
"「そりゃお前、この館には",
"そもそも外から電話は通じな・・・」"
]
},
{
"id": 20550,
"kind": "msg",
"jp": [
"「じゃあ・・あの・・・",
"やっぱり館の中に誰か・・・」"
]
},
{
"id": 20551,
"kind": "msg",
"jp": [
"「くそ、そういうことに",
"なっちまうのか・・・」"
]
},
{
"id": 20552,
"kind": "msg",
"jp": [
"・・・犯人なのか、その仲間なのか",
"わからないけど誰か嘘をついてる人が",
"やっぱりいるんだ・・・。"
]
},
{
"id": 20553,
"kind": "msg",
"jp": [
"「ああ、そうだぜ」"
]
},
{
"id": 20554,
"kind": "msg",
"jp": [
"「トイレだろうが地下だろうが",
"館の中ならどこにでもついてる」"
]
},
{
"id": 20555,
"kind": "msg",
"jp": [
"「・・・ついてなかった頃",
"地下室に半日閉じ込められた",
"当主がいたもんでな」"
]
},
{
"id": 20556,
"kind": "msg",
"jp": [
"「そうだったんだ・・・」"
]
},
{
"id": 20557,
"kind": "msg",
"jp": [
"「娯楽室のラジオって",
"元からあんなに音悪いの?」"
]
},
{
"id": 20558,
"kind": "msg",
"jp": [
"「元からひでえけど、",
"この雨のせいで最悪だな」"
]
},
{
"id": 20559,
"kind": "msg",
"jp": [
"「まあ、こんな山奥だからな」"
]
},
{
"id": 20560,
"kind": "msg",
"jp": [
"「ひょっとしてテレビは",
"あっても映らないのかな」"
]
},
{
"id": 20561,
"kind": "msg",
"jp": [
"「そうかもなぁ。",
"テレビは元からねーから、",
"わかんねーけど」"
]
},
{
"id": 20562,
"kind": "msg",
"jp": [
"「1階にある大時計ってさ、",
"音が鳴らないようにとか",
"調節したのは椿くん?」"
]
},
{
"id": 20563,
"kind": "msg",
"jp": [
"「ああ、斑井のオッサンが",
"うるせえって騒いだからな」"
]
},
{
"id": 20564,
"kind": "msg",
"jp": [
"「勝手にびびったくせに、",
"嫌なら自分で止めりゃいいのにさ」"
]
},
{
"id": 20565,
"kind": "msg",
"jp": [
"「勝手に調節出来るんだ?」"
]
},
{
"id": 20566,
"kind": "msg",
"jp": [
"「誰でも出来るさ。",
"時計の側面についてるツマミ",
"いじるだけだからな」"
]
},
{
"id": 20567,
"kind": "msg",
"jp": [
"「・・・いじるなよ」"
]
},
{
"id": 20568,
"kind": "msg",
"jp": [
"「いじらないいじらない」"
]
},
{
"id": 20569,
"kind": "msg",
"jp": [
"「温室に置いてあったベルなんだけど、",
"椿くん見覚えない?」"
]
},
{
"id": 20570,
"kind": "msg",
"jp": [
"「ねーよ、あんなもん。",
"この館にあったもんじゃないだろ」"
]
},
{
"id": 20571,
"kind": "msg",
"jp": [
"「だよね、なんか安っぽいし」"
]
},
{
"id": 20572,
"kind": "msg",
"jp": [
"「どう見ても玩具だしな。",
"犯人が持ってきたんだろ、",
"用意のいいこった」"
]
},
{
"id": 20573,
"kind": "msg",
"jp": [
"「温室にさ、長い釘が置いて",
"あったけど・・・」"
]
},
{
"id": 20574,
"kind": "msg",
"jp": [
"「釘ぃ?」"
]
},
{
"id": 20575,
"kind": "msg",
"jp": [
"「なんか、こんなでっかいの。",
"五寸釘ってやつだと思う」"
]
},
{
"id": 20576,
"kind": "msg",
"jp": [
"「・・・わら人形は?」"
]
},
{
"id": 20577,
"kind": "msg",
"jp": [
"「そ、それはなかった」"
]
},
{
"id": 20578,
"kind": "msg",
"jp": [
"「ふーん?",
"なんで釘だけなんだろうな。",
"十分気味悪いけどさ」"
]
},
{
"id": 20579,
"kind": "msg",
"jp": [
"「温室に、白い手袋があったんだ。",
"長くてひらひらしたの」"
]
},
{
"id": 20580,
"kind": "msg",
"jp": [
"「長くてひらひらってなんだよ?",
"レースでもついてんのか?」"
]
},
{
"id": 20581,
"kind": "msg",
"jp": [
"「なんか、そんな感じのやつ。",
"女の人のだと思うけど」"
]
},
{
"id": 20582,
"kind": "msg",
"jp": [
"「ふーん・・・?",
"ウェディングドレスとか着るときに",
"はめてるようなのか?」"
]
},
{
"id": 20583,
"kind": "msg",
"jp": [
"「ああ、そうそう」"
]
},
{
"id": 20584,
"kind": "msg",
"jp": [
"「・・・そんなのだったら",
"ひょっとしたら物置のどっかに",
"あったのかもなあ・・・」"
]
},
{
"id": 20585,
"kind": "msg",
"jp": [
"「え? この館にあったの?」"
]
},
{
"id": 20586,
"kind": "msg",
"jp": [
"「礼服って何着かクローゼットの中に",
"入ったままだったのがあったらしいん",
"だけどさ・・・」"
]
},
{
"id": 20587,
"kind": "msg",
"jp": [
"「・・・普段着ねーし、客が来たとき",
"邪魔だからって物置にしまい込んだ",
"とか聞いたことあるんだよな」"
]
},
{
"id": 20588,
"kind": "msg",
"jp": [
"「あ、でも、温室にあった手袋",
"かなり新しかったような・・・」"
]
},
{
"id": 20589,
"kind": "msg",
"jp": [
"「あ? じゃあ違うかな」"
]
},
{
"id": 20590,
"kind": "msg",
"jp": [
"やっぱり犯人が持ってきた",
"ものかな・・・。"
]
},
{
"id": 20591,
"kind": "msg",
"jp": [
"「温室に斧があったよ・・・。",
"これくらいの手斧だけど」"
]
},
{
"id": 20592,
"kind": "msg",
"jp": [
"「手斧ってまた、物騒だな。",
"まあ、娯楽室のアレも十分物騒だけど」"
]
},
{
"id": 20593,
"kind": "msg",
"jp": [
"「あ、あんなに大きくはなかったよ」"
]
},
{
"id": 20594,
"kind": "msg",
"jp": [
"「そりゃそうだろう。",
"あんなもん担いでいくだけでも",
"重労働だぞ」"
]
},
{
"id": 20595,
"kind": "msg",
"jp": [
"「だよね・・・。",
"あの、小型の斧っていうのは",
"元からこの館にあった?」"
]
},
{
"id": 20596,
"kind": "msg",
"jp": [
"「いや・・・",
"オレは見た覚えねえし、",
"この家のもんじゃねーだろ」"
]
},
{
"id": 20597,
"kind": "msg",
"jp": [
"「温室にさ、これくらいの",
"小さい柵が置いてあったんだけど」"
]
},
{
"id": 20598,
"kind": "msg",
"jp": [
"「よくわからないんだけど、",
"なんかの飾りかな?」"
]
},
{
"id": 20599,
"kind": "msg",
"jp": [
"「飾りって何を飾るんだよ。",
"柵ってからには何か囲むんだろ」"
]
},
{
"id": 20600,
"kind": "msg",
"jp": [
"「何を囲むの?」"
]
},
{
"id": 20601,
"kind": "msg",
"jp": [
"「そりゃあ・・・えーと・・・",
"ハムスターとか・・・?」"
]
},
{
"id": 20602,
"kind": "msg",
"jp": [
"「ハムスターじゃ隙間から",
"出入りし放題だと思うよ・・・」"
]
},
{
"id": 20603,
"kind": "msg",
"jp": [
"「えー? じゃあ何だ?",
"そのサイズじゃ犬とか猫には小さすぎ",
"なんじゃねえの?」"
]
},
{
"id": 20604,
"kind": "msg",
"jp": [
"「動物用じゃないんじゃない?」"
]
},
{
"id": 20605,
"kind": "msg",
"jp": [
"「じゃあ何だよ、",
"動物じゃなけりゃ植物か?」"
]
},
{
"id": 20606,
"kind": "msg",
"jp": [
"「・・・ああ、そうか!",
"花壇とかにあるやつだろ、それ」"
]
},
{
"id": 20607,
"kind": "msg",
"jp": [
"「園芸用?」"
]
},
{
"id": 20608,
"kind": "msg",
"jp": [
"「多分そうだろ。",
"だとしたら、元から温室にあった",
"やつかなぁ・・・」"
]
},
{
"id": 20609,
"kind": "msg",
"jp": [
"「ううん、違うと思う。",
"ここの温室の花壇にあるやつなら",
"園芸用ってすぐわかるよ」"
]
},
{
"id": 20610,
"kind": "msg",
"jp": [
"「そりゃそうだな。",
"じゃあわざわざ持ってきたのか」"
]
},
{
"id": 20611,
"kind": "msg",
"jp": [
"「あのさ・・・",
"那須さんの持ってるダンベルって・・」"
]
},
{
"id": 20612,
"kind": "msg",
"jp": [
"「あれは筋肉の私物だっ!」"
]
},
{
"id": 20613,
"kind": "msg",
"jp": [
"「あ、うん、そりゃあ・・・」"
]
},
{
"id": 20614,
"kind": "msg",
"jp": [
"「ここの備品じゃねーからな?",
"ダンベルもバーベルも鉄アレイも",
"常備してねーからな」"
]
},
{
"id": 20615,
"kind": "msg",
"jp": [
"「・・・ないか聞かれたの?」"
]
},
{
"id": 20616,
"kind": "msg",
"jp": [
"「いいや、逆だ。",
"大抵の所にないからここにもない",
"だろうと思って持ってきたとさ」"
]
},
{
"id": 20617,
"kind": "msg",
"jp": [
"「よ、よかったじゃない。",
"自前で用意しててくれて」"
]
},
{
"id": 20618,
"kind": "msg",
"jp": [
"「そうまでしてダンベルが手放せない",
"変な生き物だって事実はどうでも",
"いいのか、お前は」"
]
},
{
"id": 20619,
"kind": "msg",
"jp": [
"「や、だって、あの・・・",
"悪い人じゃないし・・・」"
]
},
{
"id": 20620,
"kind": "msg",
"jp": [
"「・・・わかってるよ、んなこたぁ!」"
]
},
{
"id": 20621,
"kind": "msg",
"jp": [
"「オレだってなー、",
"もっと鍛えりゃあれくらい・・・」"
]
},
{
"id": 20622,
"kind": "msg",
"jp": [
"「へ? あの・・・」"
]
},
{
"id": 20623,
"kind": "msg",
"jp": [
"「ちょっと腹筋八つに割れてっからって",
"調子こいてんじゃねーよ、くそっ」"
]
},
{
"id": 20624,
"kind": "msg",
"jp": [
"「あの、椿くん・・・もしかして、",
"身体鍛えたいの・・・?」"
]
},
{
"id": 20625,
"kind": "msg",
"jp": [
"「・・・うっ、",
"うらやましいわけじゃねーぞ!?」"
]
},
{
"id": 20626,
"kind": "msg",
"jp": [
"「いくらなんでも脳まで筋肉になるほど",
"鍛えたいわけじゃねーからな!?」"
]
},
{
"id": 20627,
"kind": "msg",
"jp": [
"「しかも持久筋じゃなくて瞬発筋だろ、",
"あいつの脳みそ。",
"あれは行き過ぎだ、あれは」"
]
},
{
"id": 20628,
"kind": "msg",
"jp": [
"「だ、だから・・・",
"なんだよ、その顔は!?」"
]
},
{
"id": 20629,
"kind": "msg",
"jp": [
"「うらやましいわけじゃ",
"ねーっつってるだろ!?」"
]
},
{
"id": 20630,
"kind": "msg",
"jp": [
"「お・・お前だってその、",
"どうせなら貧弱よりちょっとくらい",
"ガタイいい方がいいだろ」"
]
},
{
"id": 20631,
"kind": "msg",
"jp": [
"「そりゃ、まあ・・・」"
]
},
{
"id": 20632,
"kind": "msg",
"jp": [
"「そうだろ、男なら普通だ。",
"那須は行き過ぎだけどな」"
]
},
{
"id": 20633,
"kind": "msg",
"jp": [
"・・・なんか、やけに那須さんに",
"つっかかると思ったら。",
"複雑なものがあったらしい・・・。"
]
},
{
"id": 20634,
"kind": "msg",
"jp": [
"「斑井さんの部屋に、",
"変な杖があったんだけど」"
]
},
{
"id": 20635,
"kind": "msg",
"jp": [
"「杖? あーあの、魔法使いの",
"持ってるみたいな変な形のか?」"
]
},
{
"id": 20636,
"kind": "msg",
"jp": [
"「なんかダラダラ自慢しようと",
"してたけどオレはよく聞いて",
"なかったんだよな」"
]
},
{
"id": 20637,
"kind": "msg",
"jp": [
"「あ、そうなの・・・」"
]
},
{
"id": 20638,
"kind": "msg",
"jp": [
"「この館ってすごくたくさん",
"絵が飾ってあるね」"
]
},
{
"id": 20639,
"kind": "msg",
"jp": [
"「元からあったらしいぜ。",
"家具もほとんどそうだけど、",
"絵も館についてたんだと」"
]
},
{
"id": 20640,
"kind": "msg",
"jp": [
"「そうだったんだ、",
"じゃあすごく古いのかな」"
]
},
{
"id": 20641,
"kind": "msg",
"jp": [
"「みてーだな。",
"でも別に有名な画家の作品とかじゃ",
"ねーらしいけど」"
]
},
{
"id": 20642,
"kind": "msg",
"jp": [
"「椿くんはここに来たの",
"自分の車じゃなかったよね?」"
]
},
{
"id": 20643,
"kind": "msg",
"jp": [
"「ああ、事務所の車で来たよ。",
"免許は取ってんだけどな、さすがに",
"ここまで遠距離はなあ」"
]
},
{
"id": 20644,
"kind": "msg",
"jp": [
"「そっか。",
"着いた時、那須さんとか斑井さんの",
"車ってもう着いてた?」"
]
},
{
"id": 20645,
"kind": "msg",
"jp": [
"「いや、オレが一番先だった。",
"他の連中が来る前にと思って",
"早めに来たし・・・」"
]
},
{
"id": 20646,
"kind": "msg",
"jp": [
"「? どうしたの?」"
]
},
{
"id": 20647,
"kind": "msg",
"jp": [
"「いや、そう言えば・・・",
"おかしいな、オレ来るときなんか",
"山降りてくる車とすれ違ったぞ」"
]
},
{
"id": 20648,
"kind": "msg",
"jp": [
"「もう、この先はこの館しか",
"ねえって道に入ってたから・・」"
]
},
{
"id": 20649,
"kind": "msg",
"jp": [
"「・・・てっきり先に誰か着いて",
"たのかと思って来たらまだ誰も",
"いなかったんだよな」"
]
},
{
"id": 20650,
"kind": "msg",
"jp": [
"「じゃあ、その降りてった車って",
"なんでこんなところに・・・?」"
]
},
{
"id": 20651,
"kind": "msg",
"jp": [
"「わかんねえよ。",
"行き止まりになるって表示は",
"途中にあるんだけどな・・・」"
]
},
{
"id": 20652,
"kind": "msg",
"jp": [
"「たまに、見落として迷い込んで",
"引き返す奴がいないわけじゃねえ",
"らしいけど」"
]
},
{
"id": 20653,
"kind": "msg",
"jp": [
"「・・・じゃあ、単に道を",
"間違えただけの人だったかも",
"しれないんだ?」"
]
},
{
"id": 20654,
"kind": "msg",
"jp": [
"「いや、多分そうだろ。",
"だって駐車場に残ってたならともかく",
"降りてったんだから・・・」"
]
},
{
"id": 20655,
"kind": "msg",
"jp": [
"でも、もし・・・。",
"関係なく迷い込んで引き返しただけの",
"車じゃなかったら・・・。"
]
},
{
"id": 20656,
"kind": "msg",
"jp": [
"（何しに来てたんだろう・・・?）"
]
},
{
"id": 20657,
"kind": "msg",
"jp": [
"「地下にさ、蛇がたくさん",
"いるんだけど・・・」"
]
},
{
"id": 20658,
"kind": "msg",
"jp": [
"「蛇くらい出るだろ、",
"山ん中なんだから」"
]
},
{
"id": 20659,
"kind": "msg",
"jp": [
"「で、でも、すごく多いんだよ?」"
]
},
{
"id": 20660,
"kind": "msg",
"jp": [
"「んなもんでびびるなよ。",
"うちなんか事務所の社長が3匹も",
"飼ってんだぞ」"
]
},
{
"id": 20661,
"kind": "msg",
"jp": [
"「・・・それ、事務所にいるの?」"
]
},
{
"id": 20662,
"kind": "msg",
"jp": [
"「いや、家でだけど",
"写真は飾ってある」"
]
},
{
"id": 20663,
"kind": "msg",
"jp": [
"「椿くん、カップ麺って",
"よく食べる?」"
]
},
{
"id": 20664,
"kind": "msg",
"jp": [
"「まあ、わりと」"
]
},
{
"id": 20665,
"kind": "msg",
"jp": [
"「けどな、カップ麺はラーメンより",
"焼きそばの方が好きなんだよな」"
]
},
{
"id": 20666,
"kind": "msg",
"jp": [
"「そう、それも塩」"
]
},
{
"id": 20667,
"kind": "msg",
"jp": [
"「塩? 塩焼きそば?」"
]
},
{
"id": 20668,
"kind": "msg",
"jp": [
"「最近種類が増えてきて",
"くれたから助かるぜ。",
"昔はほとんどなくてさあ」"
]
},
{
"id": 20669,
"kind": "msg",
"jp": [
"「ふーん・・・",
"インスタントの塩味のは",
"食べたことないけど・・・」"
]
},
{
"id": 20670,
"kind": "msg",
"jp": [
"「食ってみろ、美味いから」"
]
},
{
"id": 20671,
"kind": "msg",
"jp": [
"「うん、じゃあ今度",
"ためしに買ってみる」"
]
},
{
"id": 20672,
"kind": "msg",
"jp": [
"「物置にさ、ボウガンが",
"あったんだけど・・・」"
]
},
{
"id": 20673,
"kind": "msg",
"jp": [
"「ああ、あれな。",
"ちょっと前まで娯楽室に飾って",
"あったんだけどさ・・・」"
]
},
{
"id": 20674,
"kind": "msg",
"jp": [
"「壊れたから外してんだよな。",
"額縁のガラスがひび入ってたろ」"
]
},
{
"id": 20675,
"kind": "msg",
"jp": [
"「うん。",
"そっか、飾りなんだ」"
]
},
{
"id": 20676,
"kind": "msg",
"jp": [
"「だと思うぜ?",
"実際撃てるのかもしれねーけど」"
]
},
{
"id": 20677,
"kind": "msg",
"jp": [
"「撃てるの!?」"
]
},
{
"id": 20678,
"kind": "msg",
"jp": [
"「わかんねーよ、",
"オレもそこまで知らねーもん」"
]
},
{
"id": 20679,
"kind": "msg",
"jp": [
"「あのさ、廊下に1つだけ",
"家具が出してあるけど・・・」"
]
},
{
"id": 20680,
"kind": "msg",
"jp": [
"「那須だろ」"
]
},
{
"id": 20681,
"kind": "msg",
"jp": [
"「やっぱりな。",
"んなことすんのは那須しかいねーよ」"
]
},
{
"id": 20682,
"kind": "msg",
"jp": [
"・・・まあ、1人であの家具動かせる",
"人って那須さんくらいだもんな。"
]
},
{
"id": 20683,
"kind": "msg",
"jp": [
"「椿くん、睡眠薬って",
"使ったことある?」"
]
},
{
"id": 20684,
"kind": "msg",
"jp": [
"「いや、ねえよ。",
"薬って嫌いなんだよな、",
"病院も嫌いだし」"
]
},
{
"id": 20685,
"kind": "msg",
"jp": [
"「病院の匂いってあるじゃん、",
"薬品の匂いっつーの?」"
]
},
{
"id": 20686,
"kind": "msg",
"jp": [
"「あれがどーしても",
"苦手でさあ・・・」"
]
},
{
"id": 20687,
"kind": "msg",
"jp": [
"「ねえ、これってここの人が",
"飼ってるのかな?」"
]
},
{
"id": 20688,
"kind": "msg",
"jp": [
"「・・・ああ、マリアンヌか。",
"そうだよ、当主が飼ってんだ」"
]
},
{
"id": 20689,
"kind": "msg",
"jp": [
"「やっぱり、その・・・それって",
"このまりもの名前なんだよね?」"
]
},
{
"id": 20690,
"kind": "msg",
"jp": [
"「深く追求するな。",
"オレもそれはどうかと思ってるんだ」"
]
},
{
"id": 20691,
"kind": "msg",
"jp": [
"「後で元あったとこに",
"戻しといてやってくれよ」"
]
},
{
"id": 20692,
"kind": "msg",
"jp": [
"「なんか地下室の奥に",
"あったけどいいの?」"
]
},
{
"id": 20693,
"kind": "msg",
"jp": [
"「なんで地下に!?",
"普段は開かずの間にある",
"はずなんだが・・・」"
]
},
{
"id": 20694,
"kind": "msg",
"jp": [
"「持ち歩いてて",
"置き忘れやがったのか?」"
]
},
{
"id": 20695,
"kind": "msg",
"jp": [
"「そ、そうかも」"
]
},
{
"id": 20696,
"kind": "msg",
"jp": [
"「・・・後で居間にでも",
"置いといてやってくれ」"
]
},
{
"id": 20697,
"kind": "msg",
"jp": [
"「赤いカメオって聞いたことある?」"
]
},
{
"id": 20698,
"kind": "msg",
"jp": [
"「・・・なんだそれ?」"
]
},
{
"id": 20699,
"kind": "msg",
"jp": [
"「知らない?",
"なんかね、持ってると呪われる",
"らしいんだけど・・・」"
]
},
{
"id": 20700,
"kind": "msg",
"jp": [
"「なんだそりゃ、都市伝説か?",
"ここの当主は好きそうだけどなあ」"
]
},
{
"id": 20701,
"kind": "msg",
"jp": [
"「好きこのんで、こんな不気味な",
"別荘持ってるようなやつだぞ」"
]
},
{
"id": 20702,
"kind": "msg",
"jp": [
"「温室の奥にさあ、",
"これがあったんだよ」"
]
},
{
"id": 20703,
"kind": "msg",
"jp": [
"「なんだ?",
"テレコじゃん、何が入ってんだ?」"
]
},
{
"id": 20704,
"kind": "msg",
"jp": [
"「・・・レスラーでも入場すんのか」"
]
},
{
"id": 20705,
"kind": "msg",
"jp": [
"「じゃ、じゃなくて、ほら、",
"最初の夜に僕らが聞いた・・・」"
]
},
{
"id": 20706,
"kind": "msg",
"jp": [
"「わかってるっつーの!",
"くそっ、なんだその適当なトリック",
"馬鹿にしてんのか」"
]
},
{
"id": 20707,
"kind": "msg",
"jp": [
"「えーと、念のために聞くけど",
"これ、この家のじゃないよね」"
]
},
{
"id": 20708,
"kind": "msg",
"jp": [
"「カセットもテレコも",
"この家のじゃねーよ」"
]
},
{
"id": 20709,
"kind": "msg",
"jp": [
"「そっか、やっぱりね・・・」"
]
},
{
"id": 20710,
"kind": "msg",
"jp": [
"「物置にさ、額に入った",
"ボウガンがあるけど矢がなくなって",
"るんだよ・・・」"
]
},
{
"id": 20711,
"kind": "msg",
"jp": [
"「なんだとぉ!?",
"あれ、撃てたのかマジで・・・」"
]
},
{
"id": 20712,
"kind": "msg",
"jp": [
"「ひょっとしたら撃てるのかも",
"しれねーけど、十中八九飾りだと",
"思ってたのに・・・」"
]
},
{
"id": 20713,
"kind": "msg",
"jp": [
"「威力って・・・",
"どれくらいなんだろう」"
]
},
{
"id": 20714,
"kind": "msg",
"jp": [
"「・・・飾りじゃねえとしたら",
"弓の貫通力って半端じゃねーぞ」"
]
},
{
"id": 20715,
"kind": "msg",
"jp": [
"やっぱり、そうなんだ・・・。",
"何に使ったのか、あんまり想像したく",
"ないな・・・。"
]
},
{
"id": 20716,
"kind": "msg",
"jp": [
"「物置にボウガンがあってさ・・",
"矢がなくなってた・・・」"
]
},
{
"id": 20717,
"kind": "msg",
"jp": [
"「・・・あれか」"
]
},
{
"id": 20718,
"kind": "msg",
"jp": [
"「ちょっと前まで娯楽室に",
"飾ってあったやつだ・・・」"
]
},
{
"id": 20719,
"kind": "msg",
"jp": [
"「しまわれたのって",
"最近のことなの?」"
]
},
{
"id": 20720,
"kind": "msg",
"jp": [
"「かなりな。",
"今年に入ってからじゃねえかな」"
]
},
{
"id": 20721,
"kind": "msg",
"jp": [
"「くそっ・・・",
"あんな物騒なもんとっとと処分",
"しときゃよかったんだ」"
]
},
{
"id": 20722,
"kind": "msg",
"jp": [
"「これ、見たことない?」"
]
},
{
"id": 20723,
"kind": "msg",
"jp": [
"「・・・万年筆か?",
"どっかで見たな・・・」"
]
},
{
"id": 20724,
"kind": "msg",
"jp": [
"「どこだっけ、",
"あかずの間じゃねえしな。",
"どこから持ってきたんだ?」"
]
},
{
"id": 20725,
"kind": "msg",
"jp": [
"「裏庭に落ちてたんだよ」"
]
},
{
"id": 20726,
"kind": "msg",
"jp": [
"「裏庭ぁ?",
"なんでそんなとこに・・・」"
]
},
{
"id": 20727,
"kind": "msg",
"jp": [
"「・・・暗石さんの部屋の",
"真下辺りだったんだけど」"
]
},
{
"id": 20728,
"kind": "msg",
"jp": [
"「・・・そういや、あのオッサン",
"胸ポケットになんか刺してたな。",
"細いライターかと思ってたんだが」"
]
},
{
"id": 20729,
"kind": "msg",
"jp": [
"「でも、なんで落ちたんだろう」"
]
},
{
"id": 20730,
"kind": "msg",
"jp": [
"「普通に歩いてる時には",
"落ちねえだろうな・・・」"
]
},
{
"id": 20731,
"kind": "msg",
"jp": [
"「これなんだろう?",
"地下にあったんだけど」"
]
},
{
"id": 20732,
"kind": "msg",
"jp": [
"「・・・なんだこりゃ?",
"でかいおみくじみてーだな」"
]
},
{
"id": 20733,
"kind": "msg",
"jp": [
"「おみくじ・・・",
"じゃないような気がする」"
]
},
{
"id": 20734,
"kind": "msg",
"jp": [
"「オレも違うとは思うけどよ。",
"まあ、この家なんに使うのか",
"よくわからんガラクタ多いんだ」"
]
},
{
"id": 20735,
"kind": "msg",
"jp": [
"「あのさ、応接室に飾ってある",
"仮面って・・・」"
]
},
{
"id": 20736,
"kind": "msg",
"jp": [
"「あー、あれなぁ。",
"どっかの部族が祭りか何かに",
"使ってたらしいけどさ」"
]
},
{
"id": 20737,
"kind": "msg",
"jp": [
"「飾りじゃないの、あれ!?」"
]
},
{
"id": 20738,
"kind": "msg",
"jp": [
"「いや、今は飾りだぜ。",
"だってかぶれねえもん」"
]
},
{
"id": 20739,
"kind": "msg",
"jp": [
"「どう見たって顔に引っかかるところも",
"紐か何かついてたような跡もねえし",
"どうやってかぶってたんだかなあ」"
]
},
{
"id": 20740,
"kind": "msg",
"jp": [
"「・・・て言うか、椿くん、",
"かぶろうとしてみたことあるんだ」"
]
},
{
"id": 20741,
"kind": "msg",
"jp": [
"「い、いや、だってお前、実際使ってた",
"とか言われたらちょっと試してみたく",
"なるだろ、普通!?」"
]
},
{
"id": 20742,
"kind": "msg",
"jp": [
"「・・・そうかな・・・」"
]
},
{
"id": 20743,
"kind": "msg",
"jp": [
"「なるんだよ、男なら!」"
]
},
{
"id": 20744,
"kind": "msg",
"jp": [
"「あ、いや、でも試すなよ?",
"あれ一応ここの当主のお気に入り",
"コレクションだからな」"
]
},
{
"id": 20745,
"kind": "msg",
"jp": [
"当主の人の趣味って一体・・・。"
]
},
{
"id": 20746,
"kind": "msg",
"jp": [
"「娯楽室のデッキに、",
"このテープが入ったままに",
"なってたんだよ」"
]
},
{
"id": 20747,
"kind": "msg",
"jp": [
"「あー、あれなあ。",
"前から調子悪くてよくテープが",
"出てこなくなるんだよな」"
]
},
{
"id": 20748,
"kind": "msg",
"jp": [
"「再生とかは普通に出来るんだけどな。",
"そのテープ、何か入ってんのか?」"
]
},
{
"id": 20749,
"kind": "msg",
"jp": [
"「・・・崖崩れのニュースが」"
]
},
{
"id": 20750,
"kind": "msg",
"jp": [
"「でも、僕らがラジオで聞いた",
"ニュースとなんか内容が違うんだよ。",
"場所とか、被害状況とか・・・」"
]
},
{
"id": 20751,
"kind": "msg",
"jp": [
"「・・・なんでだ?",
"また別の場所で起きたのか?」"
]
},
{
"id": 20752,
"kind": "msg",
"jp": [
"「でもなんで、わざわざ録音なんか",
"してあるん・・・・」"
]
},
{
"id": 20753,
"kind": "msg",
"jp": [
"「・・・おい、もしかして",
"そのニュース・・・偽物か?」"
]
},
{
"id": 20754,
"kind": "msg",
"jp": [
"「多分・・・」"
]
},
{
"id": 20755,
"kind": "msg",
"jp": [
"「そうか、そうだよな。",
"崖崩れなんか自力で起こせるわけ",
"ねーんだから・・・」"
]
},
{
"id": 20756,
"kind": "msg",
"jp": [
"「なんか、その代わりにオレ達を",
"足止めする方法を用意したはずだよな」"
]
},
{
"id": 20757,
"kind": "msg",
"jp": [
"「うん、僕もこれがそうだと思う」"
]
},
{
"id": 20758,
"kind": "msg",
"jp": [
"「・・・分が悪ぃな、オレ達」"
]
},
{
"id": 20759,
"kind": "msg",
"jp": [
"「だって、犯人の方がツイてんじゃん。",
"マジで崖が崩れるなんてよ・・・」"
]
},
{
"id": 20760,
"kind": "msg",
"jp": [
"「この花、なんだかわかる?」"
]
},
{
"id": 20761,
"kind": "msg",
"jp": [
"「あ? 花?」"
]
},
{
"id": 20762,
"kind": "msg",
"jp": [
"「多分、温室にある花の",
"どれかだと思うんだけど・・・」"
]
},
{
"id": 20763,
"kind": "msg",
"jp": [
"「・・・ああ。",
"見たことあるような気はする」"
]
},
{
"id": 20764,
"kind": "msg",
"jp": [
"「・・・だけ?」"
]
},
{
"id": 20765,
"kind": "msg",
"jp": [
"「オレが花なんかいちいち",
"覚えてるように見えるのか」"
]
},
{
"id": 20766,
"kind": "msg",
"jp": [
"「・・・見えない・・・」"
]
},
{
"id": 20767,
"kind": "msg",
"jp": [
"「他あたれ、他。",
"自慢じゃないがオレが見ただけで",
"名前がわかる花はひまわりくらいだ」"
]
},
{
"id": 20768,
"kind": "msg",
"jp": [
"「・・・うん。",
"まあ、僕も似たようなもんだけど」"
]
},
{
"id": 20769,
"kind": "msg",
"jp": [
"「あのさ、インプって知ってる?」"
]
},
{
"id": 20770,
"kind": "msg",
"jp": [
"「は?",
"あの、ゲームとかに出てくる",
"雑魚のモンスターこと?」"
]
},
{
"id": 20771,
"kind": "msg",
"jp": [
"「・・・そうだっけ」"
]
},
{
"id": 20772,
"kind": "msg",
"jp": [
"「RPGとかやらねーの?」"
]
},
{
"id": 20773,
"kind": "msg",
"jp": [
"「最近はあんまりやってないや。",
"その、3Dの画面って・・・酔うから」"
]
},
{
"id": 20774,
"kind": "msg",
"jp": [
"「酔うのかよっ!?",
"迷うって言い出すのかとは思ったけど」"
]
},
{
"id": 20775,
"kind": "msg",
"jp": [
"「ああ、うん。",
"迷ってるうちにどんどん",
"酔ってきちゃってますます・・・」"
]
},
{
"id": 20776,
"kind": "msg",
"jp": [
"「わかった、もういい。",
"お前はポリゴンの世界に向いてない」"
]
},
{
"id": 20777,
"kind": "msg",
"jp": [
"「・・・で、インプがどうしたって?」"
]
},
{
"id": 20778,
"kind": "msg",
"jp": [
"「那須さんが、山道の途中に",
"停めてあった変な車の中にそれの",
"飾りが吊ってあったって・・・」"
]
},
{
"id": 20779,
"kind": "msg",
"jp": [
"「飾りぃ?",
"ふーん、飾りなんかあるのか」"
]
},
{
"id": 20780,
"kind": "msg",
"jp": [
"「あんま趣味がいい飾りとは",
"思えねーけどなあ」"
]
},
{
"id": 20781,
"kind": "msg",
"jp": [
"「そういうの好きそうな人って",
"心当たりある?」"
]
},
{
"id": 20782,
"kind": "msg",
"jp": [
"「んー、そうだな・・・。",
"オレは嫌いじゃねーけど飾るほどじゃ",
"ねえしなあ・・・」"
]
},
{
"id": 20783,
"kind": "msg",
"jp": [
"「けど、そんなん飾ってるって",
"若い奴じゃねーの?",
"オッサン飾らんだろ、普通」"
]
},
{
"id": 20784,
"kind": "msg",
"jp": [
"「まあ、若くても女はあんまり",
"飾らんとは思うけどよ」"
]
},
{
"id": 20785,
"kind": "msg",
"jp": [
"「インプなんか特別好きだなんて奴",
"知り合いにもいねーしなあ」"
]
},
{
"id": 20786,
"kind": "msg",
"jp": [
"「まあ、僕の知り合いにも",
"いないけどね・・・」"
]
},
{
"id": 20787,
"kind": "msg",
"jp": [
"「あのさ、部屋の鍵に",
"アルファベットが彫ってある",
"みたいなんだけど・・・」"
]
},
{
"id": 20788,
"kind": "msg",
"jp": [
"「なんだ、お前もやりてえの?」"
]
},
{
"id": 20789,
"kind": "msg",
"jp": [
"「知ってて言ったんじゃねーのか?",
"あれ、今の当主がお遊びで作った",
"暗号になってんだよ」"
]
},
{
"id": 20790,
"kind": "msg",
"jp": [
"「暗号ってどんな?」"
]
},
{
"id": 20791,
"kind": "msg",
"jp": [
"「なんか、正しい文字を",
"正しい順番に並べたら",
"意味のある言葉になるんだと」"
]
},
{
"id": 20792,
"kind": "msg",
"jp": [
"「正しい・・順番はともかく",
"正しい文字って・・・?」"
]
},
{
"id": 20793,
"kind": "msg",
"jp": [
"「関係あるのは8文字だけなんだと。",
"フェイクが混ざってるってこった」"
]
},
{
"id": 20794,
"kind": "msg",
"jp": [
"「8文字選ばなきゃ駄目なんだ」"
]
},
{
"id": 20795,
"kind": "msg",
"jp": [
"「そうらしいな。",
"えーとな、ちょっと待て",
"解くのにヒントがあるから」"
]
},
{
"id": 20796,
"kind": "msg",
"jp": [
"そう言って椿くんは上着の",
"内ポケットをまさぐった。"
]
},
{
"id": 20797,
"kind": "msg",
"jp": [
"「椿くんはもう解いたの?」"
]
},
{
"id": 20798,
"kind": "msg",
"jp": [
"「悔しいから答えも聞いてないし",
"オレに聞かれてもわからんからな」"
]
},
{
"id": 20799,
"kind": "msg",
"jp": [
"「ああ、これだこれだ。",
"読んでやるから解きたいなら",
"メモとっとけよ」"
]
},
{
"id": 20800,
"kind": "msg",
"jp": [
"「あ、待って」"
]
},
{
"id": 20801,
"kind": "msg",
"jp": [
"慌てて手帳を引っ張り出して",
"ペンを構える。"
]
},
{
"id": 20802,
"kind": "msg",
"jp": [
"「いいか、読むぞ?」"
]
},
{
"id": 20803,
"kind": "msg",
"jp": [
"「鍵にひそむ獣を探せ」"
]
},
{
"id": 20804,
"kind": "msg",
"jp": [
"「その名は女王に始まり女王に終わる」"
]
},
{
"id": 20805,
"kind": "msg",
"jp": [
"「二人で一人は悲劇を捨てよ",
"本当は一人なら博士を選べ」"
]
},
{
"id": 20806,
"kind": "msg",
"jp": [
"「奇術師と創始者を追うのは僧正」"
]
},
{
"id": 20807,
"kind": "msg",
"jp": [
"「世界で最も有名な男は",
"世界で最も有名な熊の後ろにいる」"
]
},
{
"id": 20808,
"kind": "msg",
"jp": [
"「・・・以上だ」"
]
},
{
"id": 20809,
"kind": "msg",
"jp": [
"「全然わからない・・・」"
]
},
{
"id": 20810,
"kind": "msg",
"jp": [
"「そーだろ!?",
"やっぱそうだよなあ!?」"
]
},
{
"id": 20811,
"kind": "msg",
"jp": [
"「けど、なんか・・・",
"部屋の名前の意味がわかれば",
"すげえ簡単らしいぜ」"
]
},
{
"id": 20812,
"kind": "msg",
"jp": [
"「少なくともあっさり解いた",
"奴らはそう言ってる」"
]
},
{
"id": 20813,
"kind": "msg",
"jp": [
"「・・・簡単ねえ・・・」"
]
},
{
"id": 20814,
"kind": "msg",
"jp": [
"「ああ、そうだ。",
"それとな、鍵にアルファベットが",
"彫られてるのは2階の鍵だけだぜ」"
]
},
{
"id": 20815,
"kind": "msg",
"jp": [
"「ただし2階でも物置の鍵には",
"彫られてないから関係あるのは",
"人の部屋のだけなんだろうな」"
]
},
{
"id": 20816,
"kind": "msg",
"jp": [
"「ありがとう。",
"2階の、人の部屋だけだね」"
]
},
{
"id": 20817,
"kind": "msg",
"jp": [
"「おう、頑張れよ。",
"あー、でも解けても教えるなよ?",
"オレだってまだ考えてんだから」"
]
},
{
"id": 20818,
"kind": "msg",
"jp": [
"「・・・あ、そうだ。",
"椿くんの部屋の鍵の文字は?」"
]
},
{
"id": 20819,
"kind": "msg",
"jp": [
"「おっと、すまん。",
"忘れるとこだったぜ」"
]
},
{
"id": 20820,
"kind": "msg",
"jp": [
"「オレのは『T』だな」"
]
},
{
"id": 20821,
"kind": "msg",
"jp": [
"「Tだね、ありがと」"
]
},
{
"id": 20822,
"kind": "msg",
"jp": [
"「椿くんの携帯どんなの?」"
]
},
{
"id": 20823,
"kind": "msg",
"jp": [
"「んー、買い換えたばっかで",
"まだ使い方ちゃんと覚えて",
"ねーんだよな」"
]
},
{
"id": 20824,
"kind": "msg",
"jp": [
"「前のやつ、うっかり落として",
"ディスプレイ割っちまってさ」"
]
},
{
"id": 20825,
"kind": "msg",
"jp": [
"「じゃあ、最新のなんだ?」"
]
},
{
"id": 20826,
"kind": "msg",
"jp": [
"「んな高いもん買うかよ。",
"ポイントでタダになる",
"一世代前のやつだ」"
]
},
{
"id": 20827,
"kind": "msg",
"jp": [
"「ああ、そう言えば",
"僕も機種変更した時そうだった」"
]
},
{
"id": 20828,
"kind": "msg",
"jp": [
"「んでも、最新のだろうが",
"なんだろうが電波が届かなきゃ",
"意味ねーんだよなあ・・・」"
]
},
{
"id": 20829,
"kind": "msg",
"jp": [
"「椿くんはここまで",
"タクシーだったっけ」"
]
},
{
"id": 20830,
"kind": "msg",
"jp": [
"「そーだけど?」"
]
},
{
"id": 20831,
"kind": "msg",
"jp": [
"「駅で誰かに会ったりは",
"しなかったの?",
"タクシー待ってる時とか」"
]
},
{
"id": 20832,
"kind": "msg",
"jp": [
"「あー、オレちょっと",
"早めに来たからな」"
]
},
{
"id": 20833,
"kind": "msg",
"jp": [
"「着いたのも最初だし",
"誰にも会ってねーや」"
]
},
{
"id": 20834,
"kind": "msg",
"jp": [
"「なんで目逸らすの?」"
]
},
{
"id": 20835,
"kind": "msg",
"jp": [
"「異常に・・・」"
]
}
]