"max_cells": 10
},
{
"off": "0x10c7f4",
"jp": "【Ａｃｔｉｏｎ　Ｇａｕｇｅ】を",
"ko": "【Action Gauge】를",
"max_cells": 15
},
{
"off": "0x10c834",
"jp": "見てください。",
"ko": "봐 주세요.",
"max_cells": 7
},
{
"off": "0x10c980",
"jp": "時間のようなものを示しています。",
"ko": "시간 같은 것을 나타냅니다.",
"max_cells": 16
},
{
"off": "0x10c9c0",
"jp": "つまり、何か行動する度にゲージの",
"ko": "즉, 무언가 행동할 때마다 게이지",
"max_cells": 16
},
{
"off": "0x10ca00",
"jp": "残量が減っていきます。",
"ko": "잔량이 줄어듭니다.",
"max_cells": 11
},
{
"off": "0x10ca40",
"jp": "自由に行動できる時間が、どれくらい",
"ko": "자유롭게 행동할 시간이 얼마나",
"max_cells": 17
},
{
"off": "0x10ca80",
"jp": "残っているのか注意してください。",
"ko": "남았는지 주의해 주세요.",
"max_cells": 16
},
{
"off": "0x10cb4c",
"jp": "移動してみましょう。",
"ko": "이동해 봅시다.",
"max_cells": 10
},
{
"off": "0x10cd18",
"jp": "まずは居間に向かってください。",
"ko": "우선 거실로 향해 주세요.",
"max_cells": 15
},
{
"off": "0x10cee4",
"jp": "それでは、メニューから『調べる』を",
"ko": "그럼 메뉴에서 『조사한다』를",
"max_cells": 17
},
{
"off": "0x10cf24",
"jp": "選択してみましょう。",
"ko": "선택해 봅시다.",
"max_cells": 10
},
{
"off": "0x10d0b0",
"jp": "『調べる』を選んでください。",
"ko": "『조사한다』를 골라 주세요.",
"max_cells": 14
},
{
"off": "0x10d27c",
"jp": "何かを選択して行動を起こすと、",
"ko": "무언가를 선택해 행동하면",
"max_cells": 15
},
{
"off": "0x10d2bc",
"jp": "その行動に応じた『コスト』が",
"ko": "그 행동에 따른 『코스트』가",
"max_cells": 14
},
{
"off": "0x10d2fc",
"jp": "発生します。",
"ko": "발생합니다.",
"max_cells": 6
},
{
"off": "0x10d448",
"jp": "この『コスト』が０になると",
"ko": "이 『코스트』가 0이 되면",
"max_cells": 13
},
{
"off": "0x10d488",
"jp": "自由に移動できる時間が終了します。",
"ko": "자유 이동 시간이 끝납니다.",
"max_cells": 17
},
{
"off": "0x10d4c8",
"jp": "自分が後どれくらい行動できるのかは",
"ko": "앞으로 얼마나 행동할 수 있는지는",
"max_cells": 17
},
{
"off": "0x10d508",
"jp": "【Ａｃｔｉｏｎ　Ｇａｕｇｅ】を目安に",
"ko": "【Action Gauge】를 기준으로",
"max_cells": 17
},
{
"off": "0x10d548",
"jp": "してください。",
"ko": "해 주세요.",
"max_cells": 7
},
{
"off": "0x10d614",
"jp": "それでは、次は【ロースン】へ",
"ko": "그럼 다음은 【로슨】으로",
"max_cells": 14
},
{
"off": "0x10d654",
"jp": "移動してみましょう。",
"ko": "이동해 봅시다.",
"max_cells": 10
},
{
"off": "0x10d694",
"jp": "もう一度移動を押してください。",
"ko": "다시 한 번 이동을 눌러 주세요.",
"max_cells": 15
},
{
"off": "0x10d7e0",
"jp": "部屋の中に人が在室の時には、",
"ko": "방 안에 사람이 있을 때는",
"max_cells": 14
},
{
"off": "0x10d820",
"jp": "その人と話をすることができます。",
"ko": "그 사람과 이야기할 수 있습니다.",
"max_cells": 16
},
{
"off": "0x10d860",
"jp": "また初対面の印象が良ければ",
"ko": "또 첫 대면 인상이 좋으면",
"max_cells": 13
},
{
"off": "0x10d8a0",
"jp": "個人に割り当てられた部屋の中",
"ko": "개인에게 배정된 방 안에서도",
"max_cells": 14
},
{
"off": "0x10d8e0",
"jp": "でも調べることができます。",
"ko": "조사할 수 있습니다.",
"max_cells": 13
},
{
"off": "0x10d9ac",
"jp": "それではメニューより『話す』を",
"ko": "그럼 메뉴에서 『말한다』를",
"max_cells": 15
},
{
"off": "0x10d9ec",
"jp": "選択してください。",
"ko": "선택해 주세요.",
"max_cells": 9
},
{
"off": "0x10db78",
"jp": "『話す』を選択してください。",
"ko": "『말한다』를 선택해 주세요.",
"max_cells": 14
},
{
"off": "0x10dd44",
"jp": "人のいる部屋から、退室したい時は",
"ko": "사람이 있는 방에서 나가고 싶을 때는",
"max_cells": 16
},
{
"off": "0x10dd84",
"jp": "『移動』コマンドを実行します。",
"ko": "『이동』 커맨드를 실행합니다.",
"max_cells": 15
},
{
"off": "0x10ddc4",
"jp": "『移動』コマンドを選択してください。",
"ko": "『이동』 커맨드를 선택해 주세요.",
"max_cells": 17
},
{
"off": "0x10df10",
"jp": "１Ｆのホールへ移動してください。",
"ko": "1층 홀로 이동해 주세요.",
"max_cells": 16
},
{
"off": "0x10df50",
"jp": "【Ａｃｔｉｏｎ　Ｇａｕｇｅ】の減りに注目",
"ko": "【Action Gauge】가 줄어드는 것에 주목",
"max_cells": 17
},
{
"off": "0x10df90",
"jp": "してください。",
"ko": "해 주세요.",
"max_cells": 7
},
{
"off": "0x10e0dc",
"jp": "続いて書斎へ移動してください。",
"ko": "이어서 서재로 이동해 주세요.",
"max_cells": 15
},
{
"off": "0x10e11c",
"jp": "【Ａｃｔｉｏｎ　Ｇａｕｇｅ】の減りに注目",
"ko": "【Action Gauge】가 줄어드는 것에 주목",
"max_cells": 17
},
{
"off": "0x10e15c",
"jp": "してください。",
"ko": "해 주세요.",
"max_cells": 7
},
{
"off": "0x10e2a8",
"jp": "書斎にも様々な情報があります。",
"ko": "서재에도 다양한 정보가 있습니다.",
"max_cells": 15
},
{
"off": "0x10e2e8",
"jp": "本が沢山あり、本からでしか得ら",
"ko": "책이 많이 있고, 책에서만 얻을",
"max_cells": 15
},
{
"off": "0x10e328",
"jp": "れない情報もあります。",
"ko": "수 있는 정보도 있습니다.",
"max_cells": 11
},
{
"off": "0x10e368",
"jp": "本を読むには、『調べる』で読み",
"ko": "책을 읽으려면 『조사한다』로 읽고",
"max_cells": 15
},
{
"off": "0x10e3a8",
"jp": "たい本のある書棚を選択します。",
"ko": "싶은 책이 있는 서가를 선택합니다.",
"max_cells": 15
},
{
"off": "0x10e474",
"jp": "書棚を選んでください。",
"ko": "서가를 골라 주세요.",
"max_cells": 11
},
{
"off": "0x10e640",
"jp": "本を一冊選んでみてください。",
"ko": "책을 한 권 골라 보세요.",
"max_cells": 14
},
{
"off": "0x10e80c",
"jp": "『調べる』を終了してください。",
"ko": "『조사한다』를 종료해 주세요.",
"max_cells": 15
},
{
"off": "0x10e9d8",
"jp": "書斎（ノックス）には多くの本があり、",
"ko": "서재(녹스)에는 많은 책이 있어",
"max_cells": 17
},
{
"off": "0x10ea18",
"jp": "重要な手がかりや情報が紛れている",
"ko": "중요한 단서나 정보가 섞여 있는",
"max_cells": 16
},
{
"off": "0x10ea58",
"jp": "ことがあります。",
"ko": "경우가 있습니다.",
"max_cells": 8
},
{
"off": "0x10eba4",
"jp": "メニューから『情報』を選択して",
"ko": "메뉴에서 『정보』를 선택해",
"max_cells": 15
},
{
"off": "0x10ebe4",
"jp": "ください。",
"ko": "주세요.",
"max_cells": 5
},
{
"off": "0x10ed70",
"jp": "情報を×ボタンでキャンセルして",
"ko": "정보를 X버튼으로 취소해",
"max_cells": 15
},
{
"off": "0x10edb0",
"jp": "ください。",
"ko": "주세요.",
"max_cells": 5
},
{
"off": "0x10ef3c",
"jp": "『移動』を選択してください。",
"ko": "『이동』을 선택해 주세요.",
"max_cells": 14
},
{
"off": "0x10f108",
"jp": "これで任意移動のガイドは終了",
"ko": "이것으로 자유 이동 가이드를 마칩",
"max_cells": 14
},
{
"off": "0x10f148",
"jp": "します。",
"ko": "니다.",
"max_cells": 4
},
{
"off": "0x10f188",
"jp": "この後は自由に動き回って",
"ko": "이후에는 자유롭게 돌아다녀",
"max_cells": 12
},
{
"off": "0x10f1c8",
"jp": "みましょう。",
"ko": "봅시다.",
"max_cells": 6
},
{
"off": "0x10f2d4",
"jp": "もし何から、手をつければいいのか",
"ko": "무엇부터 손대야 할지",
"max_cells": 16
},
{
"off": "0x10f314",
"jp": "判らないのであれば、昨晩起った",
"ko": "모르겠다면, 어젯밤 일어난",
"max_cells": 15
},
{
"off": "0x10f354",
"jp": "事件の現場（井戸や駐車場など）を",
"ko": "사건 현장(우물이나 주차장 등)을",
"max_cells": 16
},
{
"off": "0x10f394",
"jp": "順番に回ってみるといいかもしれません。",
"ko": "차례로 돌아보면 좋을지도 모릅니다.",
"max_cells": 17
},
{
"off": "0x10f4a0",
"jp": "また今後の状況の進展次第では",
"ko": "또 앞으로 상황 진전에 따라",
"max_cells": 14
},
{
"off": "0x10f4e0",
"jp": "出来る行動も増えていきます。",
"ko": "할 수 있는 행동도 늘어납니다.",
"max_cells": 14
},
{
"off": "0x10f66c",
"jp": "通常の任意行動中では、約２５回～",
"ko": "보통 자유 행동 중에는 약 25회~",
"max_cells": 16
},
{
"off": "0x10f6ac",
"jp": "１００回程度、物品を調べることの",
"ko": "100회 정도 물건을 조사할 수",
"max_cells": 16
},
{
"off": "0x10f6ec",
"jp": "できる最大行動量がありますが、",
"ko": "있는 최대 행동량이 있지만,",
"max_cells": 15
},
{
"off": "0x10f72c",
"jp": "移動の行動量が判りやすいように",
"ko": "이동의 행동량을 알기 쉽도록",
"max_cells": 15
},
{
"off": "0x10f76c",
"jp": "５回分くらいに減らしてみます。",
"ko": "5회분 정도로 줄여 보겠습니다.",
"max_cells": 15
},
{
"off": "0x10f838",
"jp": "【Ａｃｔｉｏｎ　Ｇａｕｇｅ】の減りに",
"ko": "【Action Gauge】가 줄어드는 것에",
"max_cells": 17
},
{
"off": "0x10f878",
"jp": "注目してください。",
"ko": "주목해 주세요.",
"max_cells": 9
},
{
"off": "0x10fa04",
"jp": "では【Ａｃｔｉｏｎ　Ｇａｕｇｅ】を元の最大",
"ko": "그럼 【Action Gauge】를 원래 최대",
"max_cells": 17
},
{
"off": "0x10fa44",
"jp": "行動量に戻します。",
"ko": "행동량으로 되돌립니다.",
"max_cells": 9
},
{
"off": "0x10fbd0",
"jp": "【ＥＡＳＹ　ＭＯＤＥ】において、重要な",
"ko": "【EASY MODE】에서는 중요한",
"max_cells": 17
},
{
"off": "0x10fc10",
"jp": "証言やヒントなどを得た時に、このように",
"ko": "증언이나 힌트 등을 얻었을 때 이렇게",
"max_cells": 17
},
{
"off": "0x10fc50",
"jp": "効果音がなることがあります。",
"ko": "효과음이 울리는 경우가 있습니다.",
"max_cells": 14
}
]